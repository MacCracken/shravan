    store64(_celt_cacheIdx + 48 * 8, 41); store64(_celt_cacheIdx + 49 * 8, 41); store64(_celt_cacheIdx + 50 * 8, 123); store64(_celt_cacheIdx + 51 * 8, 123); store64(_celt_cacheIdx + 52 * 8, 123); store64(_celt_cacheIdx + 53 * 8, 123);
    store64(_celt_cacheIdx + 54 * 8, 240); store64(_celt_cacheIdx + 55 * 8, 240); store64(_celt_cacheIdx + 56 * 8, 240); store64(_celt_cacheIdx + 57 * 8, 266); store64(_celt_cacheIdx + 58 * 8, 266); store64(_celt_cacheIdx + 59 * 8, 305);
    store64(_celt_cacheIdx + 60 * 8, 318); store64(_celt_cacheIdx + 61 * 8, 328); store64(_celt_cacheIdx + 62 * 8, 336); store64(_celt_cacheIdx + 63 * 8, 123); store64(_celt_cacheIdx + 64 * 8, 123); store64(_celt_cacheIdx + 65 * 8, 123);
