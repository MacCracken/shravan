# shravan.cyr -- bundled distribution
# Version: 2.12.6
# Generated by: cyrius distlib
# Do not edit -- rebuild with: cyrius distlib

# Requires (compile-verified; the leaves of dist/shravan.deps):
include "lib/ganita.cyr"
include "lib/assert.cyr"
include "lib/syscalls.cyr"

# --- shravan.cyr ---

# shravan — audio codecs for AGNOS (Cyrius port)
# Ported from ~10K lines of Rust to Cyrius.
#
# Phase 1: error, format, pcm, codec, wav
#
# Design decisions:
#   - All audio samples are f64 internally (Cyrius native, more precision than f32)
#   - Packed Result: Ok returns value >= 0, Err sets bit 63 (value < 0)
#   - Buffers are raw byte pointers + length
#   - Vec used for dynamic sample arrays (stores f64 bit patterns as i64)
#   - Error codes are integer enums, error messages via helper functions

# Stdlib modules resolved via cyrius.toml [deps] stdlib.

# ================================================================
# Constants — f64 bit patterns for common values
# ================================================================

# f64 constants — initialized at startup via shravan_init_constants()
var F64_ZERO       = 0;
var F64_NEG_HALF   = 0;
var F64_NEG_ONE    = 0;
# F64_ONE, F64_TWO, and F64_HALF are provided by math.cyr (stdlib)

# PCM normalization constants (divisors and reciprocals). Every global here shares
# one namespace with the consumer's stdlib and other bundles, so a name some other
# module defines must not be used: `F64_255` (never read) was deleted in 2.9.4
# because the stdlib's mabda declares it `const`, a hard compile error beside it.
# scripts/check-collisions.sh holds this.
var F64_128        = 0;
var F64_32768      = 0;
var F64_32767      = 0;
var F64_8388608    = 0;
var F64_8388607    = 0;
var F64_2147483648 = 0;
var F64_2147483647 = 0;

# Pre-computed reciprocals for PCM conversion (mul instead of div)
var F64_RCP_128        = 0;
var F64_RCP_32768      = 0;
var F64_RCP_8388608    = 0;
var F64_RCP_2147483648 = 0;

# Pre-computed power for f32 denormal conversion
var F64_2_NEG_149  = 0;
var F64_2_NEG_150  = 0;

fn shravan_init_constants() {
    F64_ZERO       = f64_from(0);
    F64_NEG_HALF   = f64_neg(F64_HALF);  # F64_HALF from math.cyr
    F64_NEG_ONE    = f64_neg(F64_ONE);
    F64_128        = f64_from(128);
    F64_32768      = f64_from(32768);
    F64_32767      = f64_from(32767);
    F64_8388608    = f64_from(8388608);
    F64_8388607    = f64_from(8388607);
    F64_2147483648 = f64_mul(f64_from(32768), f64_from(65536));
    F64_2147483647 = f64_sub(F64_2147483648, F64_ONE);

    # Reciprocals for PCM hot paths (mul is ~3x faster than div)
    F64_RCP_128        = f64_div(F64_ONE, F64_128);
    F64_RCP_32768      = f64_div(F64_ONE, F64_32768);
    F64_RCP_8388608    = f64_div(F64_ONE, F64_8388608);
    F64_RCP_2147483648 = f64_div(F64_ONE, F64_2147483648);

    # f32 denormal: 2^-149 and 2^-150
    F64_2_NEG_149 = f64_pow(F64_TWO, f64_from(0 - 149));
    F64_2_NEG_150 = f64_pow(F64_TWO, f64_from(0 - 150));
    return 0;
}

# ================================================================
# Error module
# ================================================================

enum ShravanErr {
    ERR_NONE              = 0;
    ERR_UNSUPPORTED_FMT   = 1;
    ERR_INVALID_HEADER    = 2;
    ERR_DECODE            = 3;
    ERR_ENCODE            = 4;
    ERR_END_OF_STREAM     = 5;
    ERR_INVALID_RATE      = 6;
    ERR_INVALID_CHANNELS  = 7;
    ERR_TOO_LARGE         = 8;    # over the one-shot sample ceiling (shravan_set_max_samples)
}

# Pack an error code into a negative result (bit 63 set)
fn err(code) {
    return 0 - code;
}

# is_err(r) and err_code(r) come from the stdlib (syscalls, pulled via io):
# they are byte-identical to shravan's packed-Result convention
# (is_err = r < 0, err_code = 0 - r). Only res_ok is shravan's own — the
# stdlib's res_ok (result.cyr) operates on tagged Result structs, not the
# packed >=0/<0 integer results the codecs use.
fn res_ok(r) {
    if (r >= 0) { return 1; }
    return 0;
}

# Print error message to stderr
fn err_print(code) {
    if (code == ERR_UNSUPPORTED_FMT)  { syscall(1, 2, "unsupported format\n", 19); }
    if (code == ERR_INVALID_HEADER)   { syscall(1, 2, "invalid header\n", 15); }
    if (code == ERR_DECODE)           { syscall(1, 2, "decode error\n", 13); }
    if (code == ERR_ENCODE)           { syscall(1, 2, "encode error\n", 13); }
    if (code == ERR_END_OF_STREAM)    { syscall(1, 2, "end of stream\n", 14); }
    if (code == ERR_INVALID_RATE)     { syscall(1, 2, "invalid sample rate\n", 20); }
    if (code == ERR_INVALID_CHANNELS) { syscall(1, 2, "invalid channel count\n", 22); }
    if (code == ERR_TOO_LARGE)        { syscall(1, 2, "too long for a one-shot decode\n", 31); }
    return 0;
}

# ---- the one-shot sample ceiling ---------------------------------------------
# A whole-file decode returns every sample at once, and alloc() never frees, so
# without a ceiling a few KB of crafted FLAC or AAC can mint gigabytes (SEC-023,
# 027, 029). Every one-shot decoder sizes its output once, from the declared
# length or a cheap header count, and returns ERR_TOO_LARGE rather than allocate
# past the ceiling. The default, 2^26 interleaved samples (512 MB of f64), is
# about 12.7 minutes of 44.1 kHz stereo. Until 2.9.3 it was 2^25 (6.3 minutes),
# fixed, and reported as ERR_DECODE; outputs grew by doubling, so peak memory ran
# two to four times the payload.
var _shravan_max_samples = 67108864;

# Set the ceiling on interleaved samples a one-shot decode may return
# (codec_open, decode_file and each codec's _decode). Returns the previous value.
# n is clamped to [1, 2^28], the stdlib vector limit. A consumer that trusts its
# input, or decodes long files, raises it; streaming avoids it.
fn shravan_set_max_samples(n) {
    var prev = _shravan_max_samples;
    if (n < 1) { n = 1; }
    if (n > 268435456) { n = 268435456; }
    _shravan_max_samples = n;
    return prev;
}

fn shravan_max_samples() { return _shravan_max_samples; }

# Gapless decoding: drop what the container or the encoder marks as not part of
# the audio, as ffmpeg does by default. For MP4 that is the sample table's
# durations, the edit list and iTunes' iTunSMPB (the encoder's priming and the
# last frame's padding); for MP3, the delay and padding in a LAME/Xing tag. On by
# default since 2.10.2. Off, MP4 and MP3 decode every frame whole, as before.
var _shravan_gapless = 1;

fn shravan_set_gapless(on) {
    var prev = _shravan_gapless;
    _shravan_gapless = 0;
    if (on != 0) { _shravan_gapless = 1; }
    return prev;
}

fn shravan_gapless() { return _shravan_gapless; }

# Keep frames [start, start + n) of a vec of interleaved samples, `ch` to a frame,
# clamped to what it holds. In place: the data pointer moves, nothing is copied.
fn _vec_keep_frames(v, ch, start, n) {
    if (ch < 1) { return 0; }
    var frames = vec_len(v) / ch;
    if (start < 0) { start = 0; }
    if (start > frames) { start = frames; }
    if (n < 0) { n = 0; }
    if (n > frames - start) { n = frames - start; }
    store64(v, load64(v) + start * ch * 8);
    store64(v + 16, load64(v + 16) - start * ch);
    store64(v + 8, n * ch);
    return n;
}

# A decode result's sample count and duration, after its samples were trimmed.
fn _dr_refresh_total(dr) {
    var fi = decode_result_info(dr);
    var ch = fmtinfo_channels(fi);
    if (ch < 1) { return 0; }
    var total = vec_len(decode_result_samples(dr)) / ch;
    store64(fi + 40, total);
    var rate = fmtinfo_sample_rate(fi);
    if (rate > 0) { store64(fi + 32, f64_div(f64_from(total), f64_from(rate))); }
    return total;
}

# ================================================================
# Format module
# ================================================================

enum AudioFormat {
    FMT_WAV    = 0;
    FMT_FLAC   = 1;
    FMT_RAW    = 2;
    FMT_OGG    = 3;
    FMT_AIFF   = 4;
    FMT_MP3    = 5;
    FMT_OPUS   = 6;
    FMT_AAC    = 7;
    FMT_ALAC   = 8;
    FMT_MP4    = 9;
}

fn format_name(fmt) {
    if (fmt == FMT_WAV)  { return "WAV"; }
    if (fmt == FMT_FLAC) { return "FLAC"; }
    if (fmt == FMT_RAW)  { return "Raw PCM"; }
    if (fmt == FMT_OGG)  { return "Ogg"; }
    if (fmt == FMT_AIFF) { return "AIFF"; }
    if (fmt == FMT_MP3)  { return "MP3"; }
    if (fmt == FMT_OPUS) { return "Opus"; }
    if (fmt == FMT_AAC)  { return "AAC"; }
    if (fmt == FMT_ALAC) { return "ALAC"; }
    if (fmt == FMT_MP4)  { return "MP4/M4A"; }
    return "Unknown";
}

# Struct size constants
var FMTINFO_SIZE       = 48;
var DECODE_RESULT_SIZE = 16;
var BITREADER_SIZE     = 32;

# FormatInfo — heap-allocated struct
# Layout (48 bytes):
#   +0:  format        (i64, AudioFormat enum)
#   +8:  sample_rate   (i64, Hz)
#   +16: channels      (i64)
#   +24: bit_depth     (i64)
#   +32: duration_secs (f64 bit pattern)
#   +40: total_samples (i64)

fn fmtinfo_new(format, sample_rate, channels, bit_depth, duration_secs, total_samples) {
    var fi = alloc(48);
    store64(fi,      format);
    store64(fi + 8,  sample_rate);
    store64(fi + 16, channels);
    store64(fi + 24, bit_depth);
    store64(fi + 32, duration_secs);
    store64(fi + 40, total_samples);
    return fi;
}

fn fmtinfo_format(fi)       { return load64(fi); }
fn fmtinfo_sample_rate(fi)  { return load64(fi + 8); }
fn fmtinfo_channels(fi)     { return load64(fi + 16); }
fn fmtinfo_bit_depth(fi)    { return load64(fi + 24); }
fn fmtinfo_duration(fi)     { return load64(fi + 32); }
fn fmtinfo_total_samples(fi){ return load64(fi + 40); }

# Detect audio format from header bytes.
# data: pointer to byte buffer, len: buffer length
# Returns AudioFormat enum value on success, negative error on failure.
fn shravan_detect_format(data, len) {
    if (len < 4) { return err(ERR_INVALID_HEADER); }

    # WAV: "RIFF"
    if (load8(data) == 0x52) {
        if (load8(data+1) == 0x49) {
            if (load8(data+2) == 0x46) {
                if (load8(data+3) == 0x46) {
                    return FMT_WAV;
                }
            }
        }
    }

    # FLAC: "fLaC"
    if (load8(data) == 0x66) {
        if (load8(data+1) == 0x4C) {
            if (load8(data+2) == 0x61) {
                if (load8(data+3) == 0x43) {
                    return FMT_FLAC;
                }
            }
        }
    }

    # Ogg: "OggS"
    if (load8(data) == 0x4F) {
        if (load8(data+1) == 0x67) {
            if (load8(data+2) == 0x67) {
                if (load8(data+3) == 0x53) {
                    return FMT_OGG;
                }
            }
        }
    }

    # AIFF/AIFC: "FORM" + offset 8 = "AIFF" or "AIFC"
    if (load8(data) == 0x46) {
        if (load8(data+1) == 0x4F) {
            if (load8(data+2) == 0x52) {
                if (load8(data+3) == 0x4D) {
                    if (len >= 12) {
                        # Check for "AIFF" at offset 8
                        if (load8(data+8) == 0x41) {
                            if (load8(data+9) == 0x49) {
                                if (load8(data+10) == 0x46) {
                                    if (load8(data+11) == 0x46) { return FMT_AIFF; }
                                    if (load8(data+11) == 0x43) { return FMT_AIFF; }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    # MP3: ID3v2 tag "ID3"
    if (load8(data) == 0x49) {
        if (load8(data+1) == 0x44) {
            if (load8(data+2) == 0x33) {
                return FMT_MP3;
            }
        }
    }

    # MPEG sync: 0xFF 0xE0 mask
    if (load8(data) == 0xFF) {
        var b1 = load8(data + 1);
        if ((b1 & 0xE0) == 0xE0) {
            # Distinguish ADTS (AAC) from MP3
            # ADTS: 0xFFF sync + layer=0 → (b1 & 0xF6) == 0xF0
            if ((b1 & 0xF6) == 0xF0) {
                return FMT_AAC;
            }
            return FMT_MP3;
        }
    }

    # MP4/M4A: "ftyp" box at offset 4 (ISO base media file format)
    if (len >= 8) {
        if (load8(data+4) == 0x66) {
            if (load8(data+5) == 0x74) {
                if (load8(data+6) == 0x79) {
                    if (load8(data+7) == 0x70) {
                        return FMT_MP4;
                    }
                }
            }
        }
    }

    # MPEG audio after leading junk or silence padding (the ISO sin1k0db stream
    # opens with 215 bytes before its first frame; ffmpeg and mpg123 scan for it).
    # Two consecutive valid headers with matching version, layer and rate are
    # required, so a stray 0xFFE sync in another format is not taken for MP3.
    if (_mp3_find_stream(data, len) >= 0) { return FMT_MP3; }

    return err(ERR_UNSUPPORTED_FMT);
}

# Offset of the first MPEG audio frame that is followed by a second matching one,
# within the first 64 KiB, or -1.
fn _mp3_find_stream(data, len) {
    if (mp3_bitrate_v1_l3 == 0) { mp3_init(); }
    var lim = len - 4;
    if (lim > 65536) { lim = 65536; }
    var p = 0;
    while (p < lim) {
        if (load8(data + p) == 0xFF) {
            if ((load8(data + p + 1) & 0xE0) == 0xE0) {
                var h = mp3_parse_frame_header(data, p);
                if (res_ok(h) == 1) {
                    var fs = mp3_frame_size(h);
                    if (fs > 0) {
                        if (p + fs + 4 <= len) {
                            var h2 = mp3_parse_frame_header(data, p + fs);
                            if (res_ok(h2) == 1) {
                                if ((mp3_frame_version(h2) == mp3_frame_version(h)) & (mp3_frame_layer(h2) == mp3_frame_layer(h)) & (mp3_frame_sample_rate(h2) == mp3_frame_sample_rate(h))) {
                                    return p;
                                }
                            }
                        }
                    }
                }
            }
        }
        p = p + 1;
    }
    return 0 - 1;
}

# sankoch also defines detect_format(src, src_len), for compression formats, and
# both bundles land in one namespace where the last definition wins. Everything
# in shravan calls shravan_detect_format so that order cannot reroute codec_open
# into sankoch's version. This name stays for compatibility until 3.0.
fn detect_format(data, len) {
    return shravan_detect_format(data, len);
}

# ================================================================
# PCM module — sample format conversions
# ================================================================

enum PcmFormat {
    PCM_I8  = 0;
    PCM_I16 = 1;
    PCM_I24 = 2;
    PCM_I32 = 3;
    PCM_F32 = 4;
    PCM_F64 = 5;
}

fn pcm_bytes_per_sample(fmt) {
    if (fmt == PCM_I8)  { return 1; }
    if (fmt == PCM_I16) { return 2; }
    if (fmt == PCM_I24) { return 3; }
    if (fmt == PCM_I32) { return 4; }
    if (fmt == PCM_F32) { return 4; }
    if (fmt == PCM_F64) { return 8; }
    return 0;
}

fn pcm_bit_depth(fmt) {
    if (fmt == PCM_I8)  { return 8; }
    if (fmt == PCM_I16) { return 16; }
    if (fmt == PCM_I24) { return 24; }
    if (fmt == PCM_I32) { return 32; }
    if (fmt == PCM_F32) { return 32; }
    if (fmt == PCM_F64) { return 64; }
    return 0;
}

# Read a little-endian u16 from buffer at offset
fn read_u16_le(data, off) {
    return load8(data + off) | (load8(data + off + 1) << 8);
}

# Read a little-endian u32 from buffer at offset
fn read_u32_le(data, off) {
    return load8(data + off) | (load8(data + off + 1) << 8) | (load8(data + off + 2) << 16) | (load8(data + off + 3) << 24);
}

# Write a little-endian u16 to buffer at offset
fn write_u16_le(buf, off, val) {
    store8(buf + off, val & 0xFF);
    store8(buf + off + 1, (val >> 8) & 0xFF);
    return 0;
}

# Write a little-endian u32 to buffer at offset
fn write_u32_le(buf, off, val) {
    store8(buf + off, val & 0xFF);
    store8(buf + off + 1, (val >> 8) & 0xFF);
    store8(buf + off + 2, (val >> 16) & 0xFF);
    store8(buf + off + 3, (val >> 24) & 0xFF);
    return 0;
}

# Sign-extend a value from N bits to 64 bits
# Uses conditional subtraction since >> is logical (unsigned) in Cyrius
fn sign_extend(val, bits) {
    var half = 1 << (bits - 1);
    if (val >= half) {
        return val - (1 << bits);
    }
    return val;
}

# Clamp an f64 to [-1.0, 1.0]
fn f64_clamp_sample(x) {
    return f64_clamp(x, F64_NEG_ONE, F64_ONE);
}

# SEC-017: Overflow-checked allocation for a*b bytes.
# Returns pointer on success, or negative error if a*b would overflow
# or exceed 256MB safety cap.
var _ALLOC_MAX = 268435456;  # 256MB

fn _safe_alloc_mul(a, b) {
    if (a <= 0) { return err(ERR_DECODE); }
    if (b <= 0) { return err(ERR_DECODE); }
    if (a > _ALLOC_MAX / b) { return err(ERR_DECODE); }
    return alloc(a * b);
}

# Allocate a vec with pre-set capacity (avoids growth in hot loops)
#
# SEC-025: alloc() returns 0 — not a negative error — when a request is
# oversized or mmap fails. This published that 0 as the vec's data pointer
# alongside a non-zero capacity, so the first vec_push wrote through NULL.
# Verified: a 300 MiB WAV drove count to 157,286,400, alloc(1,258,291,200)
# returned 0, and the decode SIGSEGV'd (exit 139). n * 8 could overflow too.
# Now every failure path returns a packed error for the caller to propagate.
fn _vec_new_cap(n) {
    if (n < 0) { return err(ERR_DECODE); }
    if (n > _shravan_max_samples) { return err(ERR_TOO_LARGE); }
    return _vec_alloc(n);
}

# A vec with room for exactly n samples, outside the one-shot ceiling: the
# streaming decoders' output, whose size the decoder bounds (one chunk or frame).
fn _vec_alloc(n) {
    if (n < 0) { return err(ERR_DECODE); }
    # A zero-length conversion is legitimate (empty audio) — hand back a normal
    # growable vec rather than a zero-capacity one with a NULL buffer.
    if (n == 0) { return vec_new(); }
    if (n > 268435456) { return err(ERR_TOO_LARGE); }   # the stdlib's VEC_CAP_MAX

    var v = alloc(24);
    if (v == 0) { return err(ERR_DECODE); }
    var data = alloc(n * 8);
    if (data == 0) { return err(ERR_DECODE); }

    store64(v, data);
    store64(v + 8, 0);
    store64(v + 16, n);
    return v;
}

# ---- PCM sample layouts ----
# Every integer and float layout the WAV and AIFF decoders read. _pcm_into does
# the conversion for all of them; the public converters below wrap it with a
# ceiling-checked vec, the streaming decoders with an unbounded one.
var _PL_U8    = 1;     # WAV 8-bit: unsigned, centre 128
var _PL_S8    = 2;     # AIFF 8-bit: signed
var _PL_S16LE = 3;
var _PL_S16BE = 4;
var _PL_S24LE = 5;
var _PL_S24BE = 6;
var _PL_S32LE = 7;
var _PL_S32BE = 8;
var _PL_F32LE = 9;
var _PL_F32BE = 10;
var _PL_F64LE = 11;
var _PL_F64BE = 12;

fn _pl_bytes(pl) {
    if (pl <= _PL_S8) { return 1; }
    if (pl <= _PL_S16BE) { return 2; }
    if (pl <= _PL_S24BE) { return 3; }
    if (pl <= _PL_F32BE) { return 4; }
    return 8;
}

# An IEEE single as the double of the same value. A normal number moves its
# exponent from bias 127 to bias 1023 and its 23-bit fraction to the top of the
# 52-bit one, which is exact; a subnormal is fraction * 2^-149. Infinity and NaN
# decode as zero. This replaced an f64_pow per sample.
fn _f32_bits_to_f64(bits) {
    var exp = (bits >> 23) & 0xFF;
    var mant = bits & 0x7FFFFF;
    var f = F64_ZERO;
    if (exp == 0) {
        if (mant != 0) { f = f64_mul(f64_from(mant), F64_2_NEG_149); }
    } else {
        if (exp != 0xFF) { f = ((exp + 896) << 52) | (mant << 29); }
    }
    if (((bits >> 31) & 1) == 1) { f = f64_neg(f); }
    return f;
}

# Append count samples of layout pl, read from src, to v, which must have room
# for them. Integers scale by 1 / 2^(bits-1) (a power of two, so exact); doubles
# are stored as they are. Writes the vec's buffer directly: vec_push per sample
# cost a capacity check and a call each.
fn _pcm_into(v, pl, src, count) {
    var n0 = load64(v + 8);
    var out = load64(v) + n0 * 8;
    var i = 0;
    if (pl == _PL_U8) {
        while (i < count) {
            store64(out + i * 8, f64_mul(f64_from(load8(src + i) - 128), F64_RCP_128));
            i = i + 1;
        }
    }
    if (pl == _PL_S8) {
        while (i < count) {
            var b = load8(src + i);
            if (b >= 128) { b = b - 256; }
            store64(out + i * 8, f64_mul(f64_from(b), F64_RCP_128));
            i = i + 1;
        }
    }
    if (pl == _PL_S16LE) {
        while (i < count) {
            var p = src + i * 2;
            var x = load8(p) | (load8(p + 1) << 8);
            if (x >= 32768) { x = x - 65536; }
            store64(out + i * 8, f64_mul(f64_from(x), F64_RCP_32768));
            i = i + 1;
        }
    }
    if (pl == _PL_S16BE) {
        while (i < count) {
            var p = src + i * 2;
            var x = (load8(p) << 8) | load8(p + 1);
            if (x >= 32768) { x = x - 65536; }
            store64(out + i * 8, f64_mul(f64_from(x), F64_RCP_32768));
            i = i + 1;
        }
    }
    if (pl == _PL_S24LE) {
        while (i < count) {
            var p = src + i * 3;
            var x = load8(p) | (load8(p + 1) << 8) | (load8(p + 2) << 16);
            if (x >= 8388608) { x = x - 16777216; }
            store64(out + i * 8, f64_mul(f64_from(x), F64_RCP_8388608));
            i = i + 1;
        }
    }
    if (pl == _PL_S24BE) {
        while (i < count) {
            var p = src + i * 3;
            var x = (load8(p) << 16) | (load8(p + 1) << 8) | load8(p + 2);
            if (x >= 8388608) { x = x - 16777216; }
            store64(out + i * 8, f64_mul(f64_from(x), F64_RCP_8388608));
            i = i + 1;
        }
    }
    if (pl == _PL_S32LE) {
        while (i < count) {
            var p = src + i * 4;
            var x = load8(p) | (load8(p + 1) << 8) | (load8(p + 2) << 16) | (load8(p + 3) << 24);
            if (x >= 2147483648) { x = x - 4294967296; }
            store64(out + i * 8, f64_mul(f64_from(x), F64_RCP_2147483648));
            i = i + 1;
        }
    }
    if (pl == _PL_S32BE) {
        while (i < count) {
            var p = src + i * 4;
            var x = (load8(p) << 24) | (load8(p + 1) << 16) | (load8(p + 2) << 8) | load8(p + 3);
            if (x >= 2147483648) { x = x - 4294967296; }
            store64(out + i * 8, f64_mul(f64_from(x), F64_RCP_2147483648));
            i = i + 1;
        }
    }
    if (pl == _PL_F32LE) {
        while (i < count) {
            var p = src + i * 4;
            store64(out + i * 8, _f32_bits_to_f64(load8(p) | (load8(p + 1) << 8) | (load8(p + 2) << 16) | (load8(p + 3) << 24)));
            i = i + 1;
        }
    }
    if (pl == _PL_F32BE) {
        while (i < count) {
            var p = src + i * 4;
            store64(out + i * 8, _f32_bits_to_f64((load8(p) << 24) | (load8(p + 1) << 16) | (load8(p + 2) << 8) | load8(p + 3)));
            i = i + 1;
        }
    }
    if (pl == _PL_F64LE) {
        while (i < count) {
            store64(out + i * 8, load64(src + i * 8));
            i = i + 1;
        }
    }
    if (pl == _PL_F64BE) {
        while (i < count) {
            var p = src + i * 8;
            var hi = (load8(p) << 24) | (load8(p + 1) << 16) | (load8(p + 2) << 8) | load8(p + 3);
            var lo = (load8(p + 4) << 24) | (load8(p + 5) << 16) | (load8(p + 6) << 8) | load8(p + 7);
            store64(out + i * 8, (hi << 32) | lo);
            i = i + 1;
        }
    }
    store64(v + 8, n0 + count);
    return v;
}

# count samples of layout pl as a new vec, under the one-shot ceiling.
fn _pcm_conv(pl, src, count) {
    var v = _vec_new_cap(count);
    if (is_err(v) == 1) { return v; }
    return _pcm_into(v, pl, src, count);
}

# Convert signed 16-bit samples to f64 vec.
# src: pointer to i16 LE samples, count: number of samples
# Returns: vec of f64 bit patterns
fn i16_to_f64(src, count) { return _pcm_conv(_PL_S16LE, src, count); }

# The PCM quantiser every integer encoder uses: clamp to [-1, 1], scale by
# 2^(bits-1), round half to even (lrint, as ffmpeg does), clamp to the type's
# range. It is the exact inverse of the decoders' division by 2^(bits-1), so a
# decode then re-encode hands every sample back. Until 2.9.3 the encoders scaled
# by 2^(bits-1) - 1 and truncated, which moved most samples of a "lossless"
# transcode by one LSB.
fn _pcm_quant(x, scale, lo, hi) {
    var v = f64_to(f64_round(f64_mul(f64_clamp_sample(x), scale)));
    if (v > hi) { v = hi; }
    if (v < lo) { v = lo; }
    return v;
}

# Convert f64 vec to signed 16-bit samples.
# samples: vec of f64, out: buffer to write i16 LE
# Returns: number of bytes written
fn f64_to_i16(samples, out) {
    var len = vec_len(samples);
    var sd = load64(samples);
    for (var i = 0; i < len; i = i + 1) {
        var val = _pcm_quant(load64(sd + i * 8), F64_32768, 0 - 32768, 32767);
        write_u16_le(out, i * 2, val & 0xFFFF);
    }
    return len * 2;
}

# Convert signed 32-bit samples to f64 vec.
fn i32_to_f64(src, count) { return _pcm_conv(_PL_S32LE, src, count); }

# Convert f64 vec to signed 32-bit samples.
fn f64_to_i32(samples, out) {
    var len = vec_len(samples);
    var sd = load64(samples);
    for (var i = 0; i < len; i = i + 1) {
        var val = _pcm_quant(load64(sd + i * 8), F64_2147483648, 0 - 2147483648, 2147483647);
        write_u32_le(out, i * 4, val);
    }
    return len * 4;
}

# Convert 24-bit packed LE samples (3 bytes each) to f64 vec.
fn i24_packed_to_f64(src, count) { return _pcm_conv(_PL_S24LE, src, count); }

# Convert f64 vec to 24-bit packed LE samples.
fn f64_to_i24_packed(samples, out) {
    var len = vec_len(samples);
    var sd = load64(samples);
    for (var i = 0; i < len; i = i + 1) {
        var val = _pcm_quant(load64(sd + i * 8), F64_8388608, 0 - 8388608, 8388607);
        var off = i * 3;
        store8(out + off, val & 0xFF);
        store8(out + off + 1, (val >> 8) & 0xFF);
        store8(out + off + 2, (val >> 16) & 0xFF);
    }
    return len * 3;
}

# Convert signed 24-bit integers (stored as i64, lower 24 bits) to f64 vec.
# src: pointer to i64 values, count: number of samples
# Returns: vec of f64 bit patterns
fn i24_to_f64(src, count) {
    var v = _vec_new_cap(count);
    if (is_err(v) == 1) { return v; }
    var scale = F64_RCP_8388608;
    for (var i = 0; i < count; i = i + 1) {
        var raw = load64(src + i * 8) & 0xFFFFFF;
        var signed = sign_extend(raw, 24);
        vec_push(v, f64_mul(f64_from(signed), scale));
    }
    return v;
}

# Convert f64 vec to signed 24-bit integers (stored as i64).
# samples: vec of f64, out: pointer to i64 buffer
# Returns: number of samples written
fn f64_to_i24(samples, out) {
    var len = vec_len(samples);
    var sd = load64(samples);
    for (var i = 0; i < len; i = i + 1) {
        var val = _pcm_quant(load64(sd + i * 8), F64_8388608, 0 - 8388608, 8388607);
        store64(out + i * 8, val & 0xFFFFFF);
    }
    return len;
}

# Convert unsigned 8-bit PCM (center=128) to f64 vec.
fn u8_to_f64(src, count) { return _pcm_conv(_PL_U8, src, count); }

# Convert f64 vec to unsigned 8-bit PCM.
fn f64_to_u8(samples, out) {
    var len = vec_len(samples);
    var sd = load64(samples);
    for (var i = 0; i < len; i = i + 1) {
        var val = _pcm_quant(load64(sd + i * 8), F64_128, 0 - 128, 127) + 128;
        store8(out + i, val);
    }
    return len;
}

# Read little-endian IEEE 754 doubles into a vec: the samples are stored as-is.
fn f64le_to_f64_vec(src, count) { return _pcm_conv(_PL_F64LE, src, count); }

# Big-endian IEEE 754 doubles (AIFF-C fl64), stored as-is.
fn f64be_to_f64_vec(src, count) { return _pcm_conv(_PL_F64BE, src, count); }

# Little-endian IEEE singles (WAV format 3) to f64.
fn f32_to_f64_vec(src, count) { return _pcm_conv(_PL_F32LE, src, count); }

# Big-endian IEEE singles (AIFF-C fl32) to f64.
fn f32be_to_f64_vec(src, count) { return _pcm_conv(_PL_F32BE, src, count); }

# Interleave channel buffers into a single vec.
# channels: vec of vecs (each is a channel), ch_count: number of channels
# Returns: interleaved vec
fn interleave(channels, ch_count) {
    if (ch_count == 0) { return vec_new(); }
    var ch0 = vec_get(channels, 0);
    var frames = vec_len(ch0);
    var out = vec_new();
    for (var fr = 0; fr < frames; fr = fr + 1) {
        for (var c = 0; c < ch_count; c = c + 1) {
            var ch = vec_get(channels, c);
            if (fr < vec_len(ch)) {
                vec_push(out, vec_get(ch, fr));
            }
        }
    }
    return out;
}

# Deinterleave into separate channel vecs.
# samples: interleaved vec, ch_count: number of channels
# Returns: vec of vecs
fn deinterleave(samples, ch_count) {
    if (ch_count == 0) { return vec_new(); }
    var total = vec_len(samples);
    var frames = total / ch_count;
    var out = vec_new();
    for (var c = 0; c < ch_count; c = c + 1) {
        var ch = vec_new();
        for (var fr = 0; fr < frames; fr = fr + 1) {
            vec_push(ch, vec_get(samples, fr * ch_count + c));
        }
        vec_push(out, ch);
    }
    return out;
}

# ================================================================
# WAV module — RIFF WAVE encode/decode
# ================================================================

# WAV format codes
enum WavFmt {
    WAV_FMT_PCM        = 1;
    WAV_FMT_IEEE_FLOAT = 3;
    WAV_FMT_EXTENSIBLE = 65534;
}

# Decode result — returned as a tagged pair: {fmtinfo_ptr, samples_vec}
# Layout (16 bytes):
#   +0: fmtinfo pointer
#   +8: samples vec pointer
fn decode_result_new(fi, samples) {
    var dr = alloc(16);
    store64(dr, fi);
    store64(dr + 8, samples);
    return dr;
}
fn decode_result_info(dr)    { return load64(dr); }
fn decode_result_samples(dr) { return load64(dr + 8); }

# What a WAV header says, as _wav_header fills it (7 slots of 8 bytes):
#   +0  format code (an EXTENSIBLE header's subformat)   +8  channels
#   +16 sample rate          +24 container bits (wBitsPerSample)
#   +32 valid bits (EXTENSIBLE wValidBitsPerSample; 0 = not stated)
#   +40 offset of the audio  +48 declared audio bytes (0xFFFFFFFF from a pipe)
#
# Returns 1 once `fmt ` and `data` have both been read, 0 when the buffer ends
# before they have, or an error. A one-shot decode treats 0 as a bad header; the
# streaming decoder waits for more bytes.
fn _wav_header(data, len, h) {
    if (len < 12) { return 0; }

    # Validate RIFF magic ("RIFF" = 0x46464952 LE)
    if (read_u32_le(data, 0) != 0x46464952) { return err(ERR_INVALID_HEADER); }

    # Validate WAVE identifier ("WAVE" = 0x45564157 LE)
    if (read_u32_le(data, 8) != 0x45564157) { return err(ERR_INVALID_HEADER); }

    # Scan for fmt and data chunks
    var pos = 12;
    var fmt_code = 0;
    var fmt_ch = 0;
    var fmt_rate = 0;
    var fmt_bps = 0;
    var fmt_valid_bits = 0;   # EXTENSIBLE wValidBitsPerSample (0 = not present)
    var fmt_found = 0;
    var dat_start = 0;
    var dat_size = 0;
    var dat_found = 0;

    while (pos + 8 <= len) {
        var chunk_id = read_u32_le(data, pos);
        var ck_size = read_u32_le(data, pos + 4);

        # "fmt " = 0x20746D66 LE
        if (chunk_id == 0x20746D66) {
            if (ck_size < 16) { return err(ERR_INVALID_HEADER); }
            # SEC-022: the loop guard only proves the 8-byte chunk HEADER is in
            # the buffer (pos + 8 <= len). The reads below reach pos + 23, so a
            # `fmt ` header sitting at the very end of the buffer read up to 16
            # bytes past it. ck_size is the DECLARED size and proves nothing
            # about what is actually present. Demonstrated: a 44-byte WAV whose
            # `fmt ` header ends at byte 44 decoded successfully, reporting
            # rate/channels/depth taken entirely from beyond the buffer.
            if (pos + 24 > len) { return 0; }
            fmt_code = read_u16_le(data, pos + 8);
            fmt_ch   = read_u16_le(data, pos + 10);
            fmt_rate = read_u32_le(data, pos + 12);
            # skip byte_rate(4) + block_align(2)
            fmt_bps  = read_u16_le(data, pos + 22);

            # WAVE_FORMAT_EXTENSIBLE
            if (fmt_code == WAV_FMT_EXTENSIBLE) {
                if (ck_size >= 40) {
                    if (pos + 34 > len) { return 0; }
                    # wValidBitsPerSample says how many bits carry signal;
                    # wBitsPerSample (read above into fmt_bps) is the
                    # CONTAINER size and is what strides the sample data.
                    # Overwriting fmt_bps with valid_bits mis-strode every
                    # 24-in-32 file — the common "24-bit in a 32-bit
                    # container" layout — reading 3-byte samples out of a
                    # 4-byte grid and desynchronising after the first one.
                    # (This is the roadmap's "wav WAVE_FORMAT_EXTENSIBLE
                    # 24-in-32" item.) Keep them separate: stride by the
                    # container, report the valid bits.
                    var valid_bits = read_u16_le(data, pos + 26);
                    if (valid_bits > 0) {
                        if (valid_bits <= fmt_bps) { fmt_valid_bits = valid_bits; }
                    }
                    fmt_code = read_u16_le(data, pos + 32);
                }
            }
            fmt_found = 1;
        }

        # "data" = 0x61746164 LE
        if (chunk_id == 0x61746164) {
            dat_start = pos + 8;
            dat_size = ck_size;
            dat_found = 1;
        }

        # Advance to next chunk (pad to even), with overflow guard
        if (ck_size > len - pos - 8) { pos = len + 1; }
        else {
            var padded = ck_size + (ck_size & 1);
            pos = pos + padded + 8;
        }

        if (fmt_found == 1) {
            if (dat_found == 1) {
                # Break: we use a high pos to exit
                pos = len + 1;
            }
        }
    }

    if (fmt_found == 0) { return 0; }
    if (dat_found == 0) { return 0; }
    if (fmt_ch == 0)    { return err(ERR_INVALID_CHANNELS); }
    if (fmt_rate == 0)  { return err(ERR_INVALID_RATE); }

    store64(h, fmt_code);
    store64(h + 8, fmt_ch);
    store64(h + 16, fmt_rate);
    store64(h + 24, fmt_bps);
    store64(h + 32, fmt_valid_bits);
    store64(h + 40, dat_start);
    store64(h + 48, dat_size);
    return 1;
}

# The sample layout of a WAV format shravan decodes, or 0 for one it does not.
# Integer PCM rounds the declared depth up to whole bytes, as ffmpeg does: the
# samples are left-justified in that container, so a 12-bit file decodes as
# 16-bit.
fn _wav_layout(code, bps) {
    if (code == WAV_FMT_PCM) {
        if (bps >= 1) {
            if (bps <= 8)  { return _PL_U8; }
            if (bps <= 16) { return _PL_S16LE; }
            if (bps <= 24) { return _PL_S24LE; }
            if (bps <= 32) { return _PL_S32LE; }
        }
    }
    if (code == WAV_FMT_IEEE_FLOAT) {
        if (bps == 32) { return _PL_F32LE; }
        if (bps == 64) { return _PL_F64LE; }
    }
    return 0;
}

var _wav_h = 0;

# Decode WAV data from a byte buffer.
# data: pointer to WAV bytes, len: total byte length
# Returns: decode_result pointer on success, negative error on failure
fn wav_decode(data, len) {
    if (len < 44) { return err(ERR_INVALID_HEADER); }
    if (_wav_h == 0) { _wav_h = alloc(56); }
    var h = _wav_h;
    var r = _wav_header(data, len, h);
    if (is_err(r) == 1) { return r; }
    if (r == 0) { return err(ERR_INVALID_HEADER); }

    var fmt_code = load64(h);
    var fmt_ch = load64(h + 8);
    var fmt_rate = load64(h + 16);
    var fmt_bps = load64(h + 24);
    var fmt_valid_bits = load64(h + 32);
    var dat_start = load64(h + 40);
    var dat_size = load64(h + 48);

    # Clamp data_size to available bytes
    var avail = len - dat_start;
    if (dat_size > avail) { dat_size = avail; }

    var samples = vec_new();
    var pl = _wav_layout(fmt_code, fmt_bps);
    if (pl != 0) { samples = _pcm_conv(pl, data + dat_start, dat_size / _pl_bytes(pl)); }

    # SEC-025: the converters can now return a packed error (oversized or
    # failed allocation). vec_len() on a negative pointer segfaults, so the
    # error has to be caught before it is treated as a vec — this is exactly
    # how a 300 MiB WAV reached exit 139.
    if (is_err(samples) == 1) { return samples; }

    var sample_count = vec_len(samples);
    if (sample_count == 0) {
        if (dat_size > 0) {
            return err(ERR_DECODE);
        }
    }

    var total_frames = sample_count / fmt_ch;
    var dur = f64_div(f64_from(total_frames), f64_from(fmt_rate));

    # Report the meaningful bit depth (valid bits when EXTENSIBLE declared them,
    # otherwise the container size) — decoding above already strode by the
    # container.
    var report_bps = fmt_bps;
    if (fmt_valid_bits > 0) { report_bps = fmt_valid_bits; }

    var fi = fmtinfo_new(FMT_WAV, fmt_rate, fmt_ch, report_bps, dur, total_frames);
    return decode_result_new(fi, samples);
}

# Encode interleaved f64 samples as WAV byte stream.
# samples: vec of f64 bit patterns
# sample_rate, channels: integers
# pcm_fmt: PcmFormat enum
# out: buffer to write WAV data into (must be large enough)
# Returns: total bytes written, or negative error
fn wav_encode(samples, sample_rate, channels, pcm_fmt, out) {
    if (channels == 0)    { return err(ERR_INVALID_CHANNELS); }
    if (sample_rate == 0) { return err(ERR_INVALID_RATE); }

    var fmt_code = WAV_FMT_PCM;
    if (pcm_fmt == PCM_F32) { fmt_code = WAV_FMT_IEEE_FLOAT; }
    if (pcm_fmt == PCM_F64) { fmt_code = WAV_FMT_IEEE_FLOAT; }

    var bps = pcm_bit_depth(pcm_fmt);
    var bytes_ps = pcm_bytes_per_sample(pcm_fmt);
    var block_align = channels * bytes_ps;
    var byte_rate = block_align * sample_rate;

    var sample_count = vec_len(samples);

    # Encode raw sample data into a temp buffer after the header
    var header_size = 44;
    var raw_data = out + header_size;
    var raw_size = 0;

    if (pcm_fmt == PCM_I8) {
        raw_size = f64_to_u8(samples, raw_data);
    }
    if (pcm_fmt == PCM_I16) {
        raw_size = f64_to_i16(samples, raw_data);
    }
    if (pcm_fmt == PCM_I24) {
        raw_size = f64_to_i24_packed(samples, raw_data);
    }
    if (pcm_fmt == PCM_I32) {
        raw_size = f64_to_i32(samples, raw_data);
    }
    if (pcm_fmt == PCM_F32) {
        # Convert f64 back to f32 IEEE 754 LE
        raw_size = f64_to_f32_bytes(samples, raw_data);
    }
    if (pcm_fmt == PCM_F64) {
        # f64 samples are already IEEE 754 doubles, so this is a straight copy.
        var f64_count = vec_len(samples);
        for (var fi = 0; fi < f64_count; fi = fi + 1) {
            store64(raw_data + fi * 8, vec_get(samples, fi));
        }
        raw_size = f64_count * 8;
    }

    var data_size = raw_size;
    var file_size = 4 + 24 + 8 + data_size;

    # RIFF header
    store8(out, 0x52); store8(out+1, 0x49); store8(out+2, 0x46); store8(out+3, 0x46);
    write_u32_le(out, 4, file_size);
    store8(out+8, 0x57); store8(out+9, 0x41); store8(out+10, 0x56); store8(out+11, 0x45);

    # fmt chunk
    store8(out+12, 0x66); store8(out+13, 0x6D); store8(out+14, 0x74); store8(out+15, 0x20);
    write_u32_le(out, 16, 16);
    write_u16_le(out, 20, fmt_code);
    write_u16_le(out, 22, channels);
    write_u32_le(out, 24, sample_rate);
    write_u32_le(out, 28, byte_rate);
    write_u16_le(out, 32, block_align);
    write_u16_le(out, 34, bps);

    # data chunk header
    store8(out+36, 0x64); store8(out+37, 0x61); store8(out+38, 0x74); store8(out+39, 0x61);
    write_u32_le(out, 40, data_size);

    # raw_data is already written at out + 44
    return header_size + data_size;
}

# Convert f64 vec to IEEE 754 float32 LE bytes
fn f64_to_f32_bytes(samples, out) {
    var len = vec_len(samples);
    var sd = load64(samples);
    for (var i = 0; i < len; i = i + 1) {
        var bits = f64_to_f32_bits(load64(sd + i * 8));
        var p = out + i * 4;
        store8(p, bits & 0xFF);
        store8(p + 1, (bits >> 8) & 0xFF);
        store8(p + 2, (bits >> 16) & 0xFF);
        store8(p + 3, (bits >> 24) & 0xFF);
    }
    return len * 4;
}

# An f64 bit pattern as the nearest f32 (round half to even), as C's (float) and
# ffmpeg's float conversion give it: subnormal results kept, overflow to infinity,
# NaN quiet. Until 2.9.3 this truncated the fraction, pulling every sample that is
# not already a float toward zero by up to one f32 step, and flushed f32
# subnormals to zero.
fn f64_to_f32_bits(f) {
    # f64: sign(1) | exp(11) | mantissa(52)
    # f32: sign(1) | exp(8)  | mantissa(23)
    var f32_sign = ((f >> 63) & 1) << 31;
    var exp = (f >> 52) & 0x7FF;
    var mant = f & 0xFFFFFFFFFFFFF;

    if (exp == 0x7FF) {
        if (mant == 0) { return f32_sign | 0x7F800000; }    # infinity
        return f32_sign | 0x7FC00000;                       # NaN
    }
    if (exp == 0) { return f32_sign; }      # zero, or an f64 subnormal (far below f32's range)

    var unbiased = exp - 1023;
    if (unbiased > 127) { return f32_sign | 0x7F800000; }
    if (unbiased < (0 - 150)) { return f32_sign; }

    # Keep `keep` bits of the 53-bit significand and round on the rest. A normal
    # f32 keeps 24 (the leading one implicit); a subnormal f32, whose unit is
    # 2^-149, keeps fewer.
    var sig = mant | (1 << 52);
    var drop = 29;
    if (unbiased < (0 - 126)) { drop = 29 + ((0 - 126) - unbiased); }   # 30..53
    var q = sig >> drop;
    var rem = sig & ((1 << drop) - 1);
    var half = 1 << (drop - 1);
    if (rem > half) { q = q + 1; }
    if (rem == half) { q = q + (q & 1); }

    if (unbiased < (0 - 126)) {
        # Subnormal: q is the fraction field; rounding up to 2^23 is exactly the
        # smallest normal, whose encoding is the same bits.
        return f32_sign | q;
    }
    var e32 = unbiased + 127;
    if (q == 16777216) { q = 8388608; e32 = e32 + 1; }      # rounded up to the next power of two
    if (e32 >= 255) { return f32_sign | 0x7F800000; }
    return f32_sign | (e32 << 23) | (q & 0x7FFFFF);
}

# ================================================================
# AIFF module — Audio Interchange File Format encode/decode
# ================================================================

# Big-endian read helpers
fn read_u16_be(data, off) {
    return (load8(data + off) << 8) | load8(data + off + 1);
}

fn read_u32_be(data, off) {
    return (load8(data+off) << 24) | (load8(data+off+1) << 16) | (load8(data+off+2) << 8) | load8(data+off+3);
}

fn write_u16_be(buf, off, val) {
    store8(buf + off, (val >> 8) & 0xFF);
    store8(buf + off + 1, val & 0xFF);
    return 0;
}

fn write_u32_be(buf, off, val) {
    store8(buf+off, (val >> 24) & 0xFF);
    store8(buf+off+1, (val >> 16) & 0xFF);
    store8(buf+off+2, (val >> 8) & 0xFF);
    store8(buf+off+3, val & 0xFF);
    return 0;
}

# Convert 80-bit IEEE 754 extended float to integer (for sample rate)
# ext: pointer to 10 bytes
# Returns the integer value (sufficient for sample rates)
fn extended_to_f64(ext) {
    var b0 = load8(ext);
    var exponent = ((b0 & 0x7F) << 8) | load8(ext + 1);

    # Read 64-bit mantissa (big-endian) — but we only need top bits for integer rates
    # mantissa has explicit integer bit at position 63
    # value = mantissa >> (63 - (exponent - 16383))
    var unbiased = exponent - 16383;

    # Read mantissa as integer, handling potential overflow by reading in parts
    # For sample rates up to ~192000, we only need the top ~18 bits of mantissa
    # Read top 4 bytes (32 bits) — sufficient for all practical sample rates
    var mant_hi = (load8(ext+2) << 24) | (load8(ext+3) << 16) | (load8(ext+4) << 8) | load8(ext+5);

    # mantissa_hi represents bits 63..32 of the mantissa
    # value = mant_hi >> (31 - unbiased) when unbiased <= 31
    # value = mant_hi << (unbiased - 31) when unbiased > 31
    # SEC-028: bound every shift count to 0..31 before shifting.
    #
    # `exponent` is a 15-bit field, so `unbiased` spans -16383..+16384 and both
    # branches below computed shift counts far outside the 0..63 a shift may
    # legally take. Two reachable cases, both from AIFF COMM bytes:
    #   * exponent 0x403F -> unbiased 64 -> shift 33 -> `32 - shift` = -1,
    #     a NEGATIVE shift count;
    #   * a small exponent -> `31 - unbiased` in the thousands.
    # A sample rate is a positive integer, so anything outside that is a
    # malformed rate: return 0, which every caller already rejects.
    if (unbiased < 0)  { return F64_ZERO; }   # value < 1 Hz
    if (unbiased > 62) { return F64_ZERO; }   # far past any real sample rate

    var result = 0;
    if (unbiased <= 31) {
        result = mant_hi >> (31 - unbiased);       # shift 0..31
    } else {
        # Need lower mantissa bits too
        var mant_lo = (load8(ext+6) << 24) | (load8(ext+7) << 16) | (load8(ext+8) << 8) | load8(ext+9);
        var shift = unbiased - 31;                 # 1..31
        result = (mant_hi << shift) | (mant_lo >> (32 - shift));
    }

    # Return as f64 for consistency with FormatInfo duration calculations
    return f64_from(result);
}

# Convert a positive integer to 80-bit IEEE 754 extended float
# For sample rates (always positive integers like 44100, 48000)
# val: integer value, ext: pointer to 10-byte output buffer
fn f64_to_extended(val, ext) {
    if (val == 0) {
        for (var i = 0; i < 10; i = i + 1) { store8(ext + i, 0); }
        return 0;
    }

    # Find highest set bit position (0-based from LSB)
    var n = val;
    var p = 0;
    while (n > 1) { n = n >> 1; p = p + 1; }

    var biased = p + 16383;
    # mantissa = val << (63 - p), with explicit integer bit
    var mantissa = val << (63 - p);

    store8(ext, (biased >> 8) & 0x7F);
    store8(ext + 1, biased & 0xFF);
    for (var i = 0; i < 8; i = i + 1) {
        store8(ext + 2 + i, (mantissa >> (56 - i * 8)) & 0xFF);
    }
    return 0;
}

# Endianness constants
enum Endian { ENDIAN_BIG = 0; ENDIAN_LITTLE = 1; }

# Decode signed big-endian 16-bit samples to f64 vec
fn i16be_to_f64(src, count) { return _pcm_conv(_PL_S16BE, src, count); }

# Decode signed big-endian 24-bit samples to f64 vec
fn i24be_to_f64(src, count) { return _pcm_conv(_PL_S24BE, src, count); }

# Decode signed big-endian 32-bit samples to f64 vec
fn i32be_to_f64(src, count) { return _pcm_conv(_PL_S32BE, src, count); }

# Decode signed 8-bit AIFF samples (signed, not unsigned like WAV)
fn i8_to_f64(src, count) { return _pcm_conv(_PL_S8, src, count); }

# Integer AIFF audio to f64. sampleSize may be any depth from 1 to 32 bits: the
# samples sit left-justified in whole bytes, so they decode at the container size,
# as ffmpeg decodes them (until 2.9.3 anything but 8/16/24/32 came back empty).
fn aiff_decode_pcm(audio, audio_len, bits, endian) {
    var pl = _aiff_int_layout(bits, endian);
    if (pl == 0) { return vec_new(); }
    return _pcm_conv(pl, audio, audio_len / _pl_bytes(pl));
}

# The layout of integer AIFF samples of the given depth: 1 to 32 bits, held
# left-justified in whole bytes, so they decode at the container size. 0 = none.
fn _aiff_int_layout(bits, endian) {
    if (bits < 1) { return 0; }
    if (bits > 32) { return 0; }
    var w = (bits + 7) / 8;
    if (w == 1) { return _PL_S8; }
    if (endian == ENDIAN_BIG) {
        if (w == 2) { return _PL_S16BE; }
        if (w == 3) { return _PL_S24BE; }
        return _PL_S32BE;
    }
    if (w == 2) { return _PL_S16LE; }
    if (w == 3) { return _PL_S24LE; }
    return _PL_S32LE;
}

# What an AIFF / AIFF-C header says, as _aiff_header fills it (7 slots):
#   +0  channels   +8  sample size in bits (32 or 64 for float)   +16 sample rate
#   +24 endian (ENDIAN_BIG, or ENDIAN_LITTLE for sowt)
#   +32 float width (32 = fl32, 64 = fl64, 0 = integer PCM)
#   +40 offset of the audio   +48 declared audio bytes
#
# Returns 1 once COMM and SSND have both been read, 0 when the buffer ends
# before they have, or an error (a one-shot decode treats 0 as a bad header; the
# streaming decoder waits for more bytes).
fn _aiff_header(data, len, h) {
    if (len < 12) { return 0; }

    # Check "FORM" magic
    if (load8(data) != 0x46)   { return err(ERR_INVALID_HEADER); }
    if (load8(data+1) != 0x4F) { return err(ERR_INVALID_HEADER); }
    if (load8(data+2) != 0x52) { return err(ERR_INVALID_HEADER); }
    if (load8(data+3) != 0x4D) { return err(ERR_INVALID_HEADER); }

    # Check AIFF or AIFC at offset 8
    var is_aifc = 0;
    if (load8(data+8)==0x41) {
        if (load8(data+9)==0x49) {
            if (load8(data+10)==0x46) {
                if (load8(data+11)==0x46) { is_aifc = 0; }
                if (load8(data+11)==0x43) { is_aifc = 1; }
            }
        }
    }

    var pos = 12;
    var channels = 0;
    var sample_size = 0;
    var sample_rate_f = F64_ZERO;
    var comm_found = 0;
    var ssnd_start = 0;
    var ssnd_len = 0;
    var ssnd_found = 0;
    var endian = ENDIAN_BIG;
    var aifc_float = 0;     # AIFF-C fl32 (32) or fl64 (64): big-endian IEEE float

    while (pos + 8 <= len) {
        var ck0 = load8(data+pos);
        var ck1 = load8(data+pos+1);
        var ck2 = load8(data+pos+2);
        var ck3 = load8(data+pos+3);
        var ck_size = read_u32_be(data, pos + 4);

        # "COMM" = 0x43 0x4F 0x4D 0x4D
        if (ck0==0x43) { if (ck1==0x4F) { if (ck2==0x4D) { if (ck3==0x4D) {
                        var base = pos + 8;
                        # SEC-022: the loop only proves the 8-byte chunk header is present
                        # (pos + 8 <= len). The COMM body is 18 bytes — 2 channels,
                        # 4 numSampleFrames, 2 sampleSize, 10 extended sampleRate — so the
                        # reads below reach pos + 25. Unlike WAV this path did not even
                        # check the declared ck_size, so a COMM header at the end of the
                        # buffer read 18 bytes past it, including the 10-byte extended
                        # float handed to extended_to_f64.
                        if (ck_size < 18)     { return err(ERR_INVALID_HEADER); }
                        if (pos + 26 > len)   { return 0; }
                        channels = read_u16_be(data, base);
                        # num_sample_frames at base+2 (4 bytes), skip
                        sample_size = read_u16_be(data, base + 6);

                        # 10-byte extended float sample rate at base+8
                        sample_rate_f = extended_to_f64(data + base + 8);

                        if (is_aifc == 1) {
                            # Compression type at base+18 (4 bytes)
                            if (base + 22 > len) { return 0; }
                            var c0 = load8(data+base+18);
                            var c1 = load8(data+base+19);
                            var c2 = load8(data+base+20);
                            var c3 = load8(data+base+21);
                            # Only uncompressed PCM is decodable: NONE and twos (big-endian
                            # integers), sowt (little-endian), fl32/FL32 and fl64/FL64
                            # (big-endian IEEE float). Anything else -- alaw, ulaw, ima4 --
                            # used to be read as PCM and came out as noise.
                            var ctype = (c0 << 24) | (c1 << 16) | (c2 << 8) | c3;
                            var known = 0;
                            if ((ctype == 0x4E4F4E45) | (ctype == 0x74776F73)) { endian = ENDIAN_BIG; known = 1; }
                            if (ctype == 0x736F7774) { endian = ENDIAN_LITTLE; known = 1; }
                            if ((ctype == 0x666C3332) | (ctype == 0x464C3332)) { aifc_float = 32; known = 1; }
                            if ((ctype == 0x666C3634) | (ctype == 0x464C3634)) { aifc_float = 64; known = 1; }
                            if (known == 0) { return err(ERR_UNSUPPORTED_FMT); }
                        }
                        comm_found = 1;
                    }}}}

        # "SSND" = 0x53 0x53 0x4E 0x44
        if (ck0==0x53) { if (ck1==0x53) { if (ck2==0x4E) { if (ck3==0x44) {
                        if (ck_size >= 8) {
                            # SEC-022: ck_size is the DECLARED size; the 4-byte offset
                            # field at pos+8..pos+11 still has to be inside the buffer.
                            if (pos + 12 > len) { return 0; }
                            var ssnd_offset = read_u32_be(data, pos + 8);
                            # Guard against underflow: ssnd_offset must fit within chunk
                            if (ssnd_offset <= ck_size - 8) {
                                var pcm_start = pos + 8 + 8 + ssnd_offset;
                                if (pcm_start > len) { return 0; }
                                ssnd_len = ck_size - 8 - ssnd_offset;
                                ssnd_start = pcm_start;
                                ssnd_found = 1;
                            }
                        }
                    }}}}

        # Advance to next chunk with overflow guard
        if (ck_size > len - pos - 8) { pos = len + 1; }
        else { pos = pos + 8 + ck_size + (ck_size & 1); }
        if (comm_found == 1) { if (ssnd_found == 1) { pos = len + 1; } }
    }

    if (comm_found == 0) { return 0; }
    if (ssnd_found == 0) { return 0; }
    if (channels == 0)   { return err(ERR_INVALID_CHANNELS); }

    # SEC-028: validate the COMM fields as ranges, not just against zero.
    # channels and sampleSize are 16-bit fields, and only `== 0` was rejected,
    # so 65535 channels or a 65535-bit sample depth reached the PCM converters
    # and the frame-count division below.
    if (channels > 256)     { return err(ERR_INVALID_CHANNELS); }
    if (aifc_float != 0) { sample_size = aifc_float; }
    if (sample_size <= 0)   { return err(ERR_INVALID_HEADER); }
    if ((sample_size > 32) & (aifc_float != 64)) { return err(ERR_INVALID_HEADER); }

    var sample_rate = f64_to(sample_rate_f);
    if (sample_rate <= 0)       { return err(ERR_INVALID_RATE); }
    if (sample_rate > 4000000)  { return err(ERR_INVALID_RATE); }

    store64(h, channels);
    store64(h + 8, sample_size);
    store64(h + 16, sample_rate);
    store64(h + 24, endian);
    store64(h + 32, aifc_float);
    store64(h + 40, ssnd_start);
    store64(h + 48, ssnd_len);
    return 1;
}

# The sample layout of the format _aiff_header found (never 0: the header
# parser has already refused depths outside 1..32 and 64-bit float).
fn _aiff_layout(h) {
    var fl = load64(h + 32);
    if (fl == 32) { return _PL_F32BE; }
    if (fl == 64) { return _PL_F64BE; }
    return _aiff_int_layout(load64(h + 8), load64(h + 24));
}

var _aiff_h = 0;

# Decode AIFF/AIFF-C data
# data: pointer to AIFF bytes, len: total byte length
# Returns: decode_result pointer, or negative error
fn aiff_decode(data, len) {
    if (len < 12) { return err(ERR_INVALID_HEADER); }
    if (_aiff_h == 0) { _aiff_h = alloc(56); }
    var h = _aiff_h;
    var r = _aiff_header(data, len, h);
    if (is_err(r) == 1) { return r; }
    if (r == 0) { return err(ERR_INVALID_HEADER); }

    var channels = load64(h);
    var sample_rate = load64(h + 16);
    var ssnd_start = load64(h + 40);
    var ssnd_len = load64(h + 48);
    var avail = len - ssnd_start;
    if (ssnd_len > avail) { ssnd_len = avail; }

    var pl = _aiff_layout(h);
    var samples = _pcm_conv(pl, data + ssnd_start, ssnd_len / _pl_bytes(pl));
    # SEC-025: same as wav_decode — the converters can return a packed error,
    # and vec_len() on it would segfault.
    if (is_err(samples) == 1) { return samples; }
    var sc = vec_len(samples);
    var tf = sc / channels;
    var dur = f64_div(f64_from(tf), f64_from(sample_rate));

    return decode_result_new(
      fmtinfo_new(FMT_AIFF, sample_rate, channels, load64(h + 8), dur, tf),
      samples
      );
}

# Encode f64 samples to big-endian PCM bytes
fn f64_to_i16_be(samples, out) {
    var len = vec_len(samples);
    var sd = load64(samples);
    for (var i = 0; i < len; i = i + 1) {
        var val = _pcm_quant(load64(sd + i * 8), F64_32768, 0 - 32768, 32767);
        write_u16_be(out, i * 2, val & 0xFFFF);
    }
    return len * 2;
}

fn f64_to_i24_be(samples, out) {
    var len = vec_len(samples);
    var sd = load64(samples);
    for (var i = 0; i < len; i = i + 1) {
        var val = _pcm_quant(load64(sd + i * 8), F64_8388608, 0 - 8388608, 8388607);
        var off = i * 3;
        store8(out+off, (val >> 16) & 0xFF);
        store8(out+off+1, (val >> 8) & 0xFF);
        store8(out+off+2, val & 0xFF);
    }
    return len * 3;
}

fn f64_to_i32_be(samples, out) {
    var len = vec_len(samples);
    var sd = load64(samples);
    for (var i = 0; i < len; i = i + 1) {
        var val = _pcm_quant(load64(sd + i * 8), F64_2147483648, 0 - 2147483648, 2147483647);
        write_u32_be(out, i * 4, val);
    }
    return len * 4;
}

fn f64_to_i8_signed(samples, out) {
    var len = vec_len(samples);
    var sd = load64(samples);
    for (var i = 0; i < len; i = i + 1) {
        var val = _pcm_quant(load64(sd + i * 8), F64_128, 0 - 128, 127);
        store8(out + i, val & 0xFF);
    }
    return len;
}

# Encode interleaved f64 samples as AIFF byte stream (big-endian PCM)
# samples: vec, sample_rate: Hz, channels: count, bits: 8/16/24/32
# out: buffer to write AIFF data into
# Returns: total bytes written, or negative error
fn aiff_encode(samples, sample_rate, channels, bits, out) {
    if (channels == 0)    { return err(ERR_INVALID_CHANNELS); }
    if (sample_rate == 0) { return err(ERR_INVALID_RATE); }
    if (bits != 8) { if (bits != 16) { if (bits != 24) { if (bits != 32) {
                    return err(ERR_ENCODE);
                }}}}

    var num_frames = vec_len(samples) / channels;

    # Encode raw PCM to temp area after header space
    # Header: FORM(12) + COMM(8+18) + SSND(8+8) = 54 bytes
    var header_size = 54;
    var raw_data = out + header_size;
    var raw_size = 0;

    if (bits == 8)  { raw_size = f64_to_i8_signed(samples, raw_data); }
    if (bits == 16) { raw_size = f64_to_i16_be(samples, raw_data); }
    if (bits == 24) { raw_size = f64_to_i24_be(samples, raw_data); }
    if (bits == 32) { raw_size = f64_to_i32_be(samples, raw_data); }

    var ssnd_data_size = 8 + raw_size;
    var comm_size = 18;
    var form_payload = 4 + 8 + comm_size + 8 + ssnd_data_size;

    # FORM header
    store8(out, 0x46); store8(out+1, 0x4F); store8(out+2, 0x52); store8(out+3, 0x4D);
    write_u32_be(out, 4, form_payload);
    store8(out+8, 0x41); store8(out+9, 0x49); store8(out+10, 0x46); store8(out+11, 0x46);

    # COMM chunk
    store8(out+12, 0x43); store8(out+13, 0x4F); store8(out+14, 0x4D); store8(out+15, 0x4D);
    write_u32_be(out, 16, comm_size);
    write_u16_be(out, 20, channels);
    write_u32_be(out, 22, num_frames);
    write_u16_be(out, 26, bits);
    # 10-byte extended float sample rate at offset 28
    f64_to_extended(sample_rate, out + 28);

    # SSND chunk
    store8(out+38, 0x53); store8(out+39, 0x53); store8(out+40, 0x4E); store8(out+41, 0x44);
    write_u32_be(out, 42, ssnd_data_size);
    write_u32_be(out, 46, 0);  # offset
    write_u32_be(out, 50, 0);  # blockSize

    return header_size + raw_size;
}

# ================================================================
# ALAC module — Apple Lossless Audio Codec decoder
# ================================================================

# ALAC constants
var ALAC_MAX_COEFS = 32;
var ALAC_MAX_FRAME = 16384;

# ALAC element tags
enum AlacTag { ID_SCE = 0; ID_CPE = 1; ID_LFE = 3; ID_END = 7; }

# ALACSpecificConfig — parsed from 24 bytes
# Layout (80 bytes):
#   +0:  frame_length (i64)
#   +8:  bit_depth (i64)
#   +16: pb (i64)
#   +24: mb (i64)
#   +32: kb (i64)
#   +40: num_channels (i64)
#   +48: max_run (i64)
#   +56: max_frame_bytes (i64)
#   +64: avg_bit_rate (i64)
#   +72: sample_rate (i64)
fn alac_config_new() {
    return alloc(80);
}
fn alac_config_set(cfg, idx, val) { store64(cfg + idx * 8, val); return 0; }
fn alac_config_get(cfg, idx) { return load64(cfg + idx * 8); }

fn alac_parse_config(data, len) {
    if (len < 24) { return err(ERR_INVALID_HEADER); }

    var frame_length = read_u32_be(data, 0);
    var version = load8(data + 4);
    if (version != 0) { return err(ERR_INVALID_HEADER); }

    var bit_depth = load8(data + 5);
    if (bit_depth != 16) { if (bit_depth != 20) { if (bit_depth != 24) { if (bit_depth != 32) {
                    return err(ERR_INVALID_HEADER);
                }}}}

    var pb = load8(data + 6);
    var mb = load8(data + 7);
    var kb = load8(data + 8);
    var num_ch = load8(data + 9);
    if (num_ch == 0) { return err(ERR_INVALID_CHANNELS); }
    if (num_ch > 8)  { return err(ERR_INVALID_CHANNELS); }

    var max_run = read_u16_be(data, 10);
    var max_frame_bytes = read_u32_be(data, 12);
    var avg_bit_rate = read_u32_be(data, 16);
    var sample_rate = read_u32_be(data, 20);
    if (sample_rate == 0) { return err(ERR_INVALID_RATE); }

    var cfg = alac_config_new();
    alac_config_set(cfg, 0, frame_length);
    alac_config_set(cfg, 1, bit_depth);
    alac_config_set(cfg, 2, pb);
    alac_config_set(cfg, 3, mb);
    alac_config_set(cfg, 4, kb);
    alac_config_set(cfg, 5, num_ch);
    alac_config_set(cfg, 6, max_run);
    alac_config_set(cfg, 7, max_frame_bytes);
    alac_config_set(cfg, 8, avg_bit_rate);
    alac_config_set(cfg, 9, sample_rate);
    return cfg;
}

# MSB-first bit reader for ALAC
# Layout (24 bytes): +0: data_ptr, +8: byte_pos, +16: bit_pos
fn bitreader_new(data, len) {
    var br = alloc(32);
    store64(br, data);
    store64(br + 8, 0);
    store64(br + 16, 0);
    store64(br + 24, len);
    return br;
}

fn bitreader_read(br, bits) {
    if (bits == 0) { return 0; }
    # SEC-016: reject negative or oversized bit requests
    if (bits < 0) { return err(ERR_DECODE); }
    if (bits > 64) { return err(ERR_DECODE); }
    var data = load64(br);
    var bpos = load64(br + 8);
    var bbit = load64(br + 16);
    var dlen = load64(br + 24);
    var result = 0;
    var remaining = bits;

    while (remaining > 0) {
        if (bpos >= dlen) { return err(ERR_END_OF_STREAM); }
        var avail = 8 - bbit;
        var take = remaining;
        if (take > avail) { take = avail; }
        var shift = avail - take;
        # take is at most 8 (capped by avail), so 1 << take is safe
        var mask = ((1 << take) - 1) << shift;
        var val = (load8(data + bpos) & mask) >> shift;
        result = (result << take) | val;
        remaining = remaining - take;
        bbit = bbit + take;
        if (bbit >= 8) { bbit = 0; bpos = bpos + 1; }
    }

    store64(br + 8, bpos);
    store64(br + 16, bbit);
    return result;
}

fn bitreader_read_bit(br) {
    return bitreader_read(br, 1);
}

# floor(log2(x)), and 0 for x <= 1: the format relies on log2(0) being 0.
fn _alac_log2(x) {
    var r = 0;
    while (x > 1) { x = x >> 1; r = r + 1; }
    return r;
}

# Wrap to a signed `bits`-wide value. ALAC's arithmetic is 32-bit and wraps.
fn _alac_wrap(v, bits) {
    var u = v & ((1 << bits) - 1);
    if (u >= (1 << (bits - 1))) { return u - (1 << bits); }
    return u;
}

# Sign of a value: -1, 0 or 1.
fn _alac_sign(v) {
    if (v > 0) { return 1; }
    if (v < 0) { return 0 - 1; }
    return 0;
}

# Read one adaptive Golomb-Rice value. Leading ones give the prefix; nine of them
# mean the value follows raw in `bps` bits. The prefix counts in units of 2^k - 1,
# and the k-bit suffix is one bit shorter when its top k-1 bits are all zero.
fn alac_rice_scalar(br, k, bps) {
    var x = 0;
    var more = 1;
    while (more == 1) {
        var b = bitreader_read_bit(br);
        if (is_err(b) == 1) { return b; }
        if (b == 0) {
            more = 0;
        } else {
            x = x + 1;
            if (x == 9) { more = 0; }
        }
    }
    if (x == 9) { return bitreader_read(br, bps); }
    if (k <= 1) { return x; }

    var hi = bitreader_read(br, k - 1);
    if (is_err(hi) == 1) { return hi; }
    var val = (x << k) - x;
    if (hi == 0) { return val; }
    var lo = bitreader_read_bit(br);
    if (is_err(lo) == 1) { return lo; }
    return val + ((hi << 1) | lo) - 1;
}

# Decode a block of Rice-coded residuals. The parameter k follows a running
# history of the signal's magnitude, and when the history falls low enough the
# stream carries a run of zeros instead. `mult` is the channel's history rate.
fn alac_rice_decode_block(br, output, num_samples, bps, mult, mb, kb) {
    var history = mb;
    var sign_mod = 0;
    var i = 0;

    while (i < num_samples) {
        var k = _alac_log2((history >> 9) + 3);
        if (k > kb) { k = kb; }
        var x = alac_rice_scalar(br, k, bps);
        if (is_err(x) == 1) { return x; }
        x = x + sign_mod;
        sign_mod = 0;

        # Unsigned to signed: 0,1,2,3,4 -> 0,-1,1,-2,2
        store64(output + i * 8, (x >> 1) ^ (0 - (x & 1)));

        if (x > 0xFFFF) {
            history = 0xFFFF;
        } else {
            history = history + x * mult - ((history * mult) >> 9);
        }

        if (history < 128) {
            if (i + 1 < num_samples) {
                k = 7 - _alac_log2(history) + ((history + 16) >> 6);
                if (k > kb) { k = kb; }
                var run = alac_rice_scalar(br, k, 16);
                if (is_err(run) == 1) { return run; }
                if (run > 0) {
                    if (run >= num_samples - i) { run = num_samples - i - 1; }
                    var z = 1;
                    while (z <= run) {
                        store64(output + (i + z) * 8, 0);
                        z = z + 1;
                    }
                    i = i + run;
                }
                if (run <= 0xFFFF) { sign_mod = 1; }
                history = 0;
            }
        }
        i = i + 1;
    }
    return 0;
}

# Inverse adaptive LPC. Each sample is predicted from the previous `order` samples
# relative to an older base sample, oldest sample first, and the coefficients are
# nudged after every sample by the sign of the error, so `coefs` is updated in
# place. Order 31 is the special first-order case, which can run with
# err_buf == out.
fn _alac_lpc(err_buf, out, n, bps, coefs, order, quant) {
    if (n <= 0) { return 0; }
    store64(out, load64(err_buf));
    if (n == 1) { return 0; }

    var i = 1;
    if (order == 0) {
        while (i < n) {
            store64(out + i * 8, load64(err_buf + i * 8));
            i = i + 1;
        }
        return 0;
    }
    if (order == 31) {
        while (i < n) {
            store64(out + i * 8, _alac_wrap(load64(out + (i - 1) * 8) + load64(err_buf + i * 8), bps));
            i = i + 1;
        }
        return 0;
    }

    # Warm-up: the first `order` samples are first-order.
    while (i <= order && i < n) {
        store64(out + i * 8, _alac_wrap(load64(out + (i - 1) * 8) + load64(err_buf + i * 8), bps));
        i = i + 1;
    }

    var half = 1 << (quant - 1);
    while (i < n) {
        var d = load64(out + (i - order - 1) * 8);
        var val = 0;
        var j = 0;
        while (j < order) {
            val = val + (load64(out + (i - order + j) * 8) - d) * load64(coefs + j * 8);
            j = j + 1;
        }
        val = sar(_alac_wrap(val, 32) + half, quant);
        var error_val = load64(err_buf + i * 8);
        store64(out + i * 8, _alac_wrap(val + d + error_val, bps));

        var error_sign = _alac_sign(error_val);
        if (error_sign != 0) {
            j = 0;
            while (j < order && _alac_wrap(error_val * error_sign, 32) > 0) {
                var v = d - load64(out + (i - order + j) * 8);
                var sn = _alac_sign(v) * error_sign;
                store64(coefs + j * 8, _alac_wrap(load64(coefs + j * 8) - sn, 16));
                error_val = error_val - sar(v * sn, quant) * (j + 1);
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

# Stereo de-matrixing (unmix)
fn alac_unmix_stereo(u_buf, v_buf, out_l, out_r, num_samples, mix_bits, mix_res) {
    for (var i = 0; i < num_samples; i = i + 1) {
        var u = load64(u_buf + i * 8);
        var v = load64(v_buf + i * 8);
        if (mix_res != 0) {
            var left = u + v - sar(mix_res * v, mix_bits);
            var right = left - v;
            store64(out_l + i * 8, left);
            store64(out_r + i * 8, right);
        } else {
            store64(out_l + i * 8, u);
            store64(out_r + i * 8, v);
        }
    }
    return 0;
}

# Scratch for one decode. The allocator never frees, so these are made once and
# reused: a fresh set per frame would cost about 200 KB a frame, or 380 MB for a
# three-minute stereo track.
#   +0:  residuals, per channel of an element (2 ptrs)
#   +16: samples, per channel of an element (2 ptrs)
#   +32: shifted-out low bits, per channel of an element (2 ptrs)
#   +48: LPC coefficients, per channel of an element (2 ptrs)
#   +64: one frame of samples across all channels, interleaved (ptr)
#   +72: 1 / 2^(bit_depth - 1)
fn _alac_state_new(cfg) {
    var n = alac_config_get(cfg, 0);
    if (n <= 0) { return err(ERR_DECODE); }
    if (n > ALAC_MAX_FRAME) { return err(ERR_DECODE); }
    var st = alloc(80);
    if (st == 0) { return err(ERR_DECODE); }
    var i = 0;
    while (i < 6) {
        var buf = alloc(n * 8);
        if (buf == 0) { return err(ERR_DECODE); }
        store64(st + i * 8, buf);
        i = i + 1;
    }
    var c0 = alloc(ALAC_MAX_COEFS * 8);
    var c1 = alloc(ALAC_MAX_COEFS * 8);
    var fb = alloc(n * alac_config_get(cfg, 5) * 8);
    if (c0 == 0 || c1 == 0 || fb == 0) { return err(ERR_DECODE); }
    store64(st + 48, c0);
    store64(st + 56, c1);
    store64(st + 64, fb);
    store64(st + 72, f64_div(F64_ONE, f64_from(1 << (alac_config_get(cfg, 1) - 1))));
    return st;
}

# Decode a single element (mono or stereo) into the state's sample buffers.
# Returns its sample count.
fn alac_decode_element(br, cfg, st, channels, max_bits) {
    var unused = bitreader_read(br, 12);
    if (is_err(unused) == 1) { return unused; }
    var partial = bitreader_read_bit(br);
    var bytes_shifted = bitreader_read(br, 2);
    var escape_flag = bitreader_read_bit(br);
    if (is_err(escape_flag) == 1) { return escape_flag; }

    # Low bytes are stored raw, so what remains is narrower. A stereo pair needs
    # one bit more, because its mid channel holds a sum.
    var shifted_bits = bytes_shifted * 8;
    var bps = max_bits - shifted_bits + channels - 1;
    if (bps < 1) { return err(ERR_DECODE); }
    if (bps > 32) { return err(ERR_DECODE); }

    var frame_length = alac_config_get(cfg, 0);
    var num_samples = frame_length;
    if (partial == 1) {
        var hi = bitreader_read(br, 16);
        var lo = bitreader_read(br, 16);
        if (is_err(lo) == 1) { return lo; }
        num_samples = (hi << 16) | lo;
    }
    if (num_samples == 0) { return 0; }
    if (num_samples > frame_length) { return err(ERR_DECODE); }

    if (escape_flag == 1) {
        # Uncompressed: raw samples, interleaved within the element.
        for (var i = 0; i < num_samples; i = i + 1) {
            for (var ch = 0; ch < channels; ch = ch + 1) {
                var raw = bitreader_read(br, max_bits);
                if (is_err(raw) == 1) { return raw; }
                store64(load64(st + 16 + ch * 8) + i * 8, sign_extend(raw, max_bits));
            }
        }
        return num_samples;
    }

    var kb = alac_config_get(cfg, 4);
    if (kb == 0) { return err(ERR_DECODE); }
    var mix_bits = bitreader_read(br, 8);
    var mix_res = bitreader_read(br, 8);
    if (is_err(mix_res) == 1) { return mix_res; }
    mix_res = sign_extend(mix_res, 8);
    if (channels == 2 && mix_res != 0 && mix_bits > 31) { return err(ERR_DECODE); }

    # Predictor header per channel. The coefficients are stored last to first.
    var mode0 = 0; var mode1 = 0;
    var quant0 = 0; var quant1 = 0;
    var pbf0 = 0; var pbf1 = 0;
    var order0 = 0; var order1 = 0;
    for (var ch = 0; ch < channels; ch = ch + 1) {
        var mode = bitreader_read(br, 4);
        var quant = bitreader_read(br, 4);
        var pbf = bitreader_read(br, 3);
        var order = bitreader_read(br, 5);
        if (is_err(order) == 1) { return order; }
        if (order >= frame_length) { return err(ERR_DECODE); }
        if (quant == 0) { return err(ERR_DECODE); }
        var coefs = load64(st + 48 + ch * 8);
        var c = order - 1;
        while (c >= 0) {
            var rc = bitreader_read(br, 16);
            if (is_err(rc) == 1) { return rc; }
            store64(coefs + c * 8, sign_extend(rc, 16));
            c = c - 1;
        }
        if (ch == 0) { mode0 = mode; quant0 = quant; pbf0 = pbf; order0 = order; }
        else         { mode1 = mode; quant1 = quant; pbf1 = pbf; order1 = order; }
    }

    # The shifted-out low bits sit raw between the headers and the residuals.
    if (shifted_bits > 0) {
        for (var i = 0; i < num_samples; i = i + 1) {
            for (var ch = 0; ch < channels; ch = ch + 1) {
                var low = bitreader_read(br, shifted_bits);
                if (is_err(low) == 1) { return low; }
                store64(load64(st + 32 + ch * 8) + i * 8, low);
            }
        }
    }

    var pb = alac_config_get(cfg, 2);
    var mb = alac_config_get(cfg, 3);
    for (var ch = 0; ch < channels; ch = ch + 1) {
        var mode = mode0; var quant = quant0; var pbf = pbf0; var order = order0;
        if (ch == 1) { mode = mode1; quant = quant1; pbf = pbf1; order = order1; }
        var res = load64(st + ch * 8);
        var out = load64(st + 16 + ch * 8);
        var coefs = load64(st + 48 + ch * 8);
        var rc = alac_rice_decode_block(br, res, num_samples, bps, (pb * pbf) / 4, mb, kb);
        if (is_err(rc) == 1) { return rc; }
        # A non-zero mode runs a first-order pass before the coded predictor.
        if (mode != 0) { _alac_lpc(res, res, num_samples, bps, coefs, 31, 0); }
        _alac_lpc(res, out, num_samples, bps, coefs, order, quant);
    }

    if (channels == 2) {
        if (mix_res != 0) {
            var u_buf = load64(st + 16);
            var v_buf = load64(st + 24);
            alac_unmix_stereo(u_buf, v_buf, u_buf, v_buf, num_samples, mix_bits, mix_res);
        }
    }

    # The low bits rejoin after the stereo step.
    if (shifted_bits > 0) {
        for (var ch = 0; ch < channels; ch = ch + 1) {
            var out = load64(st + 16 + ch * 8);
            var ext = load64(st + 32 + ch * 8);
            for (var i = 0; i < num_samples; i = i + 1) {
                store64(out + i * 8, (load64(out + i * 8) << shifted_bits) | load64(ext + i * 8));
            }
        }
    }
    return num_samples;
}

# Where the i-th channel of the stream goes in the output. ALAC stores surround
# with centre first; output follows the usual L R C order. Each nibble is a slot.
fn _alac_channel_slot(num_ch, i) {
    var t = 0x76543210;
    if (num_ch == 3) { t = 0x102; }
    if (num_ch == 4) { t = 0x3102; }
    if (num_ch == 5) { t = 0x43102; }
    if (num_ch == 6) { t = 0x354102; }
    if (num_ch == 7) { t = 0x3654102; }
    if (num_ch == 8) { t = 0x35410762; }
    return (t >> (i * 4)) & 15;
}

# Decode one frame's elements, up to ID_END, and append its samples to `out`
# interleaved. Returns the frame's sample count per channel.
fn _alac_decode_frame(br, cfg, st, out) {
    var num_ch = alac_config_get(cfg, 5);
    var max_bits = alac_config_get(cfg, 1);
    var fb = load64(st + 64);
    var scale = load64(st + 72);
    var slot = 0;
    var nframes = 0 - 1;
    var done = 0;

    while (done == 0) {
        var tag = bitreader_read(br, 3);
        if (is_err(tag) == 1) { done = 1; }
        else {
            if (tag == ID_END) { done = 1; }
            else {
                var channels = 1;
                if (tag == ID_CPE) { channels = 2; }
                if (tag != ID_SCE && tag != ID_CPE && tag != ID_LFE) { return err(ERR_DECODE); }
                var inst = bitreader_read(br, 4);
                if (is_err(inst) == 1) { return inst; }
                if (slot + channels > num_ch) { return err(ERR_DECODE); }
                var n = alac_decode_element(br, cfg, st, channels, max_bits);
                if (is_err(n) == 1) { return n; }
                if (nframes < 0) { nframes = n; }
                if (n != nframes) { return err(ERR_DECODE); }
                for (var c = 0; c < channels; c = c + 1) {
                    var dest = _alac_channel_slot(num_ch, slot + c);
                    var src = load64(st + 16 + c * 8);
                    for (var i = 0; i < n; i = i + 1) {
                        store64(fb + (i * num_ch + dest) * 8, load64(src + i * 8));
                    }
                }
                slot = slot + channels;
            }
        }
    }

    if (nframes <= 0) { return 0; }
    if (slot != num_ch) { return err(ERR_DECODE); }

    # SEC-029: bound cumulative decoded samples. An element mints a full frame
    # from a few bytes, and alloc() never reclaims. Same one-shot ceiling (_shravan_max_samples) as
    # FLAC (SEC-023) and AAC (SEC-027).
    var total = nframes * num_ch;
    if (vec_len(out) + total > _shravan_max_samples) { return err(ERR_TOO_LARGE); }
    for (var i = 0; i < total; i = i + 1) {
        vec_push(out, f64_mul(f64_from(load64(fb + i * 8)), scale));
    }
    return nframes;
}

fn _alac_result(cfg, out) {
    var num_ch = alac_config_get(cfg, 5);
    var bit_depth = alac_config_get(cfg, 1);
    var sample_rate = alac_config_get(cfg, 9);
    var total_frames = vec_len(out) / num_ch;
    var dur = f64_div(f64_from(total_frames), f64_from(sample_rate));
    return decode_result_new(
      fmtinfo_new(FMT_ALAC, sample_rate, num_ch, bit_depth, dur, total_frames),
      out
      );
}

# Decode a 24-byte ALACSpecificConfig followed by one frame.
fn alac_decode(data, len) {
    if (len < 24) { return err(ERR_INVALID_HEADER); }
    var cfg = alac_parse_config(data, 24);
    if (is_err(cfg) == 1) { return cfg; }
    var st = _alac_state_new(cfg);
    if (is_err(st) == 1) { return st; }
    var out = vec_new();
    var rc = _alac_decode_frame(bitreader_new(data + 24, len - 24), cfg, st, out);
    if (is_err(rc) == 1) { return rc; }
    return _alac_result(cfg, out);
}

# Decode `count` frames, each at its own offset and size within data. This is how
# a container holds ALAC: every frame is a separate, byte-aligned sample. `cookie`
# is the 24-byte ALACSpecificConfig.
fn alac_decode_frames(cookie, data, len, offsets, sizes, count) {
    var cfg = alac_parse_config(cookie, 24);
    if (is_err(cfg) == 1) { return cfg; }
    var st = _alac_state_new(cfg);
    if (is_err(st) == 1) { return st; }
    # Sized once: every frame holds at most frame_length samples per channel.
    var out = _vec_new_cap(count * alac_config_get(cfg, 0) * alac_config_get(cfg, 5));
    if (is_err(out) == 1) { return out; }
    var br = bitreader_new(data, 0);
    var i = 0;
    while (i < count) {
        var off = load64(offsets + i * 8);
        var sz = load64(sizes + i * 8);
        # Untrusted offset and size: off > len, then sz > len - off, to avoid
        # overflowing off + sz.
        if (off < 0 || sz < 0) { return err(ERR_DECODE); }
        if (off > len) { return err(ERR_DECODE); }
        if (sz > len - off) { return err(ERR_DECODE); }
        store64(br, data + off);
        store64(br + 8, 0);
        store64(br + 16, 0);
        store64(br + 24, sz);
        var rc = _alac_decode_frame(br, cfg, st, out);
        if (is_err(rc) == 1) { return rc; }
        i = i + 1;
    }
    return _alac_result(cfg, out);
}

# ================================================================
# Codec module — auto-detect and dispatch
# ================================================================

# Auto-detect format and decode.
# data: pointer to audio bytes, len: total length
# Returns: decode_result pointer, or negative error
fn codec_open(data, len) {
    var fmt = shravan_detect_format(data, len);
    if (is_err(fmt) == 1) { return fmt; }

    if (fmt == FMT_WAV)  { return wav_decode(data, len); }
    if (fmt == FMT_AIFF) { return aiff_decode(data, len); }
    if (fmt == FMT_FLAC) { return flac_decode(data, len); }
    if (fmt == FMT_OGG)  { return ogg_decode(data, len); }
    if (fmt == FMT_MP3)  { return mp3_decode(data, len); }
    if (fmt == FMT_AAC)  { return aac_decode(data, len); }
    if (fmt == FMT_ALAC) { return alac_decode(data, len); }
    if (fmt == FMT_OPUS) { return ogg_decode(data, len); }
    if (fmt == FMT_MP4)  { return mp4_decode(data, len); }

    return err(ERR_UNSUPPORTED_FMT);
}

# ================================================================
# Convenience helpers: decode_file / decode_reader
# ================================================================

# Decode an audio file from a filesystem path.
# path: null-terminated C string path
# Returns: decode_result pointer, or negative error
fn decode_file(path) {
    var fd = file_open(path, 0, 0);  # O_RDONLY = 0, mode unused (6.x file_open(path, flags, mode))
    if (fd < 0) { return err(ERR_DECODE); }

    # Read entire file into buffer
    var buf_cap = 1048576;  # 1MB initial
    var buf = alloc(buf_cap);
    var total = 0;

    var reading = 1;
    while (reading == 1) {
        var avail = buf_cap - total;
        if (avail <= 0) {
            # Grow buffer (double, cap at 256MB)
            if (buf_cap >= 268435456) {
                file_close(fd);
                return err(ERR_DECODE);
            }
            var new_cap = buf_cap * 2;
            var new_buf = alloc(new_cap);
            memcpy(new_buf, buf, total);
            buf = new_buf;
            buf_cap = new_cap;
            avail = buf_cap - total;
        }
        var n = file_read(fd, buf + total, avail);
        if (n <= 0) { reading = 0; }
        else { total = total + n; }
    }

    file_close(fd);

    if (total == 0) { return err(ERR_DECODE); }

    return codec_open(buf, total);
}

# Streaming decode: feed chunks of data, receive events (see stream.cyr).
# Returns a stream decoder; wav/flac/aiff is detected from the first 12 bytes,
# however they are split across feeds. Any other format gets one ERROR event.
# chunk_frames: frames per SAMPLES event for WAV/AIFF (0 = 4096); FLAC emits one
# SAMPLES event per FLAC frame.
fn decode_reader(chunk_frames) {
    # Layout (40 bytes):
    #   +0:  state (0=detecting, 1=wav, 2=flac, 3=aiff, 4=refused)
    #   +8:  inner stream handle
    #   +16: chunk_frames
    #   +24: detection buffer (the stream's first bytes, until 12 have arrived)
    #   +32: bytes held in the detection buffer
    var dr = alloc(40);
    store64(dr, 0);
    store64(dr + 8, 0);
    store64(dr + 16, chunk_frames);
    store64(dr + 24, alloc(16));
    store64(dr + 32, 0);
    return dr;
}

fn _decode_reader_inner(state, inner, data, len) {
    if (state == 1) { return wav_stream_feed(inner, data, len); }
    if (state == 2) { return flac_stream_feed(inner, data, len); }
    if (state == 3) { return aiff_stream_feed(inner, data, len); }
    return vec_new();
}

fn decode_reader_feed(dr, data, len) {
    var state = load64(dr);
    if (state == 0) {
        var hb = load64(dr + 24);
        var hl = load64(dr + 32);
        if (len <= 0) { return vec_new(); }
        if (hl + len < 12) {
            # Not enough to detect yet: hold the bytes (until 2.9.3 they were dropped).
            memcpy(hb + hl, data, len);
            store64(dr + 32, hl + len);
            return vec_new();
        }
        var take = 12 - hl;
        memcpy(hb + hl, data, take);
        var fmt = shravan_detect_format(hb, 12);
        var chunk_frames = load64(dr + 16);
        if (chunk_frames == 0) { chunk_frames = 4096; }
        var s = 0;
        if (fmt == FMT_WAV)  { s = wav_stream_new(chunk_frames); state = 1; }
        if (fmt == FMT_FLAC) { s = flac_stream_new(); state = 2; }
        if (fmt == FMT_AIFF) { s = aiff_stream_new(chunk_frames); state = 3; }
        if (state == 0) {
            store64(dr, 4);
            var refused = vec_new();
            var e = err(ERR_UNSUPPORTED_FMT);
            if (is_err(fmt) == 1) { e = fmt; }
            vec_push(refused, stream_evt_error(e));
            return refused;
        }
        store64(dr, state);
        store64(dr + 8, s);
        # The held-back bytes first, then this call's.
        var events = vec_new();
        if (hl > 0) { events = _decode_reader_inner(state, s, hb, hl); }
        var more = _decode_reader_inner(state, s, data, len);
        var n = vec_len(more);
        for (var i = 0; i < n; i = i + 1) { vec_push(events, vec_get(more, i)); }
        return events;
    }
    return _decode_reader_inner(state, load64(dr + 8), data, len);
}

fn decode_reader_flush(dr) {
    var state = load64(dr);
    var inner = load64(dr + 8);
    if (state == 1) { return wav_stream_flush(inner); }
    if (state == 2) { return flac_stream_flush(inner); }
    if (state == 3) { return aiff_stream_flush(inner); }
    var events = vec_new();
    if (state == 0) {
        # Fewer than 12 bytes ever arrived: too short to be any of the formats.
        if (load64(dr + 32) > 0) { vec_push(events, stream_evt_error(err(ERR_INVALID_HEADER))); }
    }
    store64(dr, 4);
    vec_push(events, stream_evt_end());
    return events;
}

# --- flac.cyr ---

# ================================================================
# FLAC — Free Lossless Audio Codec (decoder + encoder)
# ================================================================
#
# Decoder: STREAMINFO, frame sync, CRC-8/16, subframes (CONSTANT,
#          VERBATIM, FIXED 0-4, LPC 1-32), Rice/Rice2, channel
#          decorrelation (independent, left-side, right-side, mid-side).
#
# Encoder: levels 0-8, the levels of `flac -0` to `flac -8` (block size, LPC to
#          order 12 over tukey and subdivide_tukey windows, fixed predictors,
#          partitioned Rice/Rice2, left/right/mid/side stereo, CONSTANT and
#          VERBATIM subframes, wasted bits), CRC-8/16, MD5, a seek table every
#          10 seconds. See "Encoder: LPC, partitioned Rice" below.
#
# All samples stored as f64 bit patterns in vec (matches the rest of shravan).

# Channel assignment codes
var FLAC_CH_LEFT_SIDE  = 8;
var FLAC_CH_RIGHT_SIDE = 9;
var FLAC_CH_MID_SIDE   = 10;

# Decorrelation modes
var FLAC_DECOR_INDEPENDENT = 0;
var FLAC_DECOR_LEFT_SIDE   = 1;
var FLAC_DECOR_RIGHT_SIDE  = 2;
var FLAC_DECOR_MID_SIDE    = 3;

# ================================================================
# CRC-8 (polynomial 0x07, init 0)
# ================================================================

var flac_crc8_table = 0;

fn flac_crc8_init() {
    flac_crc8_table = alloc(256);
    var i = 0;
    while (i < 256) {
        var crc = i;
        var bit = 0;
        while (bit < 8) {
            if ((crc & 0x80) != 0) {
                crc = ((crc << 1) ^ 0x07) & 0xFF;
            } else {
                crc = (crc << 1) & 0xFF;
            }
            bit = bit + 1;
        }
        store8(flac_crc8_table + i, crc);
        i = i + 1;
    }
    return 0;
}

fn flac_crc8(data, len) {
    if (flac_crc8_table == 0) { flac_crc8_init(); }
    var crc = 0;
    var i = 0;
    while (i < len) {
        crc = load8(flac_crc8_table + ((crc ^ load8(data + i)) & 0xFF));
        i = i + 1;
    }
    return crc;
}

# ================================================================
# CRC-16 (polynomial 0x8005, init 0)
# ================================================================

var flac_crc16_table = 0;

fn flac_crc16_init() {
    flac_crc16_table = alloc(256 * 8);
    var i = 0;
    while (i < 256) {
        var crc = i << 8;
        var bit = 0;
        while (bit < 8) {
            if ((crc & 0x8000) != 0) {
                crc = ((crc << 1) ^ 0x8005) & 0xFFFF;
            } else {
                crc = (crc << 1) & 0xFFFF;
            }
            bit = bit + 1;
        }
        store64(flac_crc16_table + i * 8, crc);
        i = i + 1;
    }
    return 0;
}

fn flac_crc16(data, len) {
    if (flac_crc16_table == 0) { flac_crc16_init(); }
    var crc = 0;
    var i = 0;
    while (i < len) {
        var idx = ((crc >> 8) ^ load8(data + i)) & 0xFF;
        crc = ((crc << 8) ^ load64(flac_crc16_table + idx * 8)) & 0xFFFF;
        i = i + 1;
    }
    return crc;
}

# ================================================================
# FLAC bitreader extensions (reuses bitreader_new / bitreader_read)
# ================================================================

# Read unary: count zero-bits before first 1-bit
# SEC-008: bound reduced from 1M to 32768 (max realistic: 65535 * 32bps Rice residual)
fn flac_br_read_unary(br) {
    var count = 0;
    while (1) {
        var b = bitreader_read_bit(br);
        if (is_err(b) == 1) { return b; }
        if (b == 1) { return count; }
        count = count + 1;
        if (count > 32768) { return err(ERR_DECODE); }
    }
    return count;
}

# Read UTF-8-like coded number (FLAC frame/sample number)
fn flac_br_read_utf8_u64(br) {
    var first = bitreader_read(br, 8);
    if (is_err(first) == 1) { return first; }
    if (first < 0x80) { return first; }

    # Count leading ones
    var leading = 0;
    var tmp = first;
    while ((tmp & 0x80) != 0) {
        leading = leading + 1;
        tmp = (tmp << 1) & 0xFF;
    }
    if (leading > 7) { return err(ERR_DECODE); }

    var mask = (1 << (7 - leading)) - 1;
    var value = first & mask;
    var j = 1;
    while (j < leading) {
        var b = bitreader_read(br, 8);
        if (is_err(b) == 1) { return b; }
        if ((b & 0xC0) != 0x80) { return err(ERR_DECODE); }
        value = (value << 6) | (b & 0x3F);
        j = j + 1;
    }
    return value;
}

# Align to byte boundary
fn flac_br_align(br) {
    var bbit = load64(br + 16);
    if (bbit != 0) {
        store64(br + 16, 0);
        store64(br + 8, load64(br + 8) + 1);
    }
    return 0;
}

# Get current byte position
fn flac_br_byte_pos(br) {
    return load64(br + 8);
}

# Set byte position (and reset bit pos to 0)
fn flac_br_set_pos(br, pos) {
    store64(br + 8, pos);
    store64(br + 16, 0);
    return 0;
}

# ================================================================
# STREAMINFO parsing
# ================================================================

# STREAMINFO struct layout (64 bytes):
#   +0:  min_block_size  (i64)
#   +8:  max_block_size  (i64)
#   +16: sample_rate     (i64)
#   +24: channels        (i64)
#   +32: bits_per_sample (i64)
#   +40: total_samples   (i64)
#   +48: audio_start     (i64) — byte offset where frames begin
#   +56: seek_table      (vec pointer) — vec of SeekPoint structs (24 bytes each)

fn flac_parse_streaminfo(data, offset) {
    var d = data + offset;
    var min_bs = (load8(d) << 8) | load8(d + 1);
    var max_bs = (load8(d + 2) << 8) | load8(d + 3);
    # bytes 4..9: min/max frame size (skipped)
    # bytes 10..13: sr(20) | ch-1(3) | bps-1(5) | total_hi(4)
    var sr = (load8(d + 10) << 12) | (load8(d + 11) << 4) | (load8(d + 12) >> 4);
    var ch = ((load8(d + 12) >> 1) & 0x07) + 1;
    var bps_hi = load8(d + 12) & 0x01;
    var bps = (bps_hi << 4) | (load8(d + 13) >> 4);
    bps = bps + 1;
    var ts_hi = (load8(d + 13) & 0x0F) << 32;
    var ts_lo = (load8(d + 14) << 24) | (load8(d + 15) << 16) | (load8(d + 16) << 8) | load8(d + 17);
    var total_samples = ts_hi | ts_lo;

    var si = alloc(64);
    store64(si,      min_bs);
    store64(si + 8,  max_bs);
    store64(si + 16, sr);
    store64(si + 24, ch);
    store64(si + 32, bps);
    store64(si + 40, total_samples);
    store64(si + 48, 0);
    store64(si + 56, 0);
    return si;
}

fn _flac_read_u64_be(data, off) {
    var v = load8(data + off) << 56;
    v = v | (load8(data + off + 1) << 48);
    v = v | (load8(data + off + 2) << 40);
    v = v | (load8(data + off + 3) << 32);
    v = v | (load8(data + off + 4) << 24);
    v = v | (load8(data + off + 5) << 16);
    v = v | (load8(data + off + 6) << 8);
    v = v | load8(data + off + 7);
    return v;
}

# Parse metadata blocks, return STREAMINFO struct with audio_start and seek_table
fn flac_parse_metadata(data, len) {
    if (len < 8) { return err(ERR_INVALID_HEADER); }
    if (load8(data) != 0x66) { return err(ERR_INVALID_HEADER); }
    if (load8(data + 1) != 0x4C) { return err(ERR_INVALID_HEADER); }
    if (load8(data + 2) != 0x61) { return err(ERR_INVALID_HEADER); }
    if (load8(data + 3) != 0x43) { return err(ERR_INVALID_HEADER); }

    var pos = 4;
    var si = 0;
    var seek_table = vec_new();
    var done = 0;

    while (done == 0) {
        if (pos + 4 > len) { return err(ERR_END_OF_STREAM); }
        var hdr_byte = load8(data + pos);
        var is_last = (hdr_byte & 0x80) != 0;
        var block_type = hdr_byte & 0x7F;
        var block_size = (load8(data + pos + 1) << 16) | (load8(data + pos + 2) << 8) | load8(data + pos + 3);
        pos = pos + 4;

        if (block_type == 0) {
            if (pos + 34 > len) { return err(ERR_INVALID_HEADER); }
            si = flac_parse_streaminfo(data, pos);
        }
        if (block_type == 3) {
            var num_points = block_size / 18;
            # SEC-012: cap seek points to prevent DoS from crafted SEEKTABLE
            if (num_points > 1024) { num_points = 1024; }
            var sp_pos = pos;
            for (var i = 0; i < num_points; i = i + 1) {
                if (sp_pos + 18 > len) { break; }
                var sample_number = _flac_read_u64_be(data, sp_pos);
                if (sample_number != (0 - 1)) {
                    var byte_offset = _flac_read_u64_be(data, sp_pos + 8);
                    var num_samples = (load8(data + sp_pos + 16) << 8) | load8(data + sp_pos + 17);
                    var sp = alloc(24);
                    store64(sp, sample_number);
                    store64(sp + 8, byte_offset);
                    store64(sp + 16, num_samples);
                    vec_push(seek_table, sp);
                }
                sp_pos = sp_pos + 18;
            }
        }

        if (pos + block_size > len) { return err(ERR_INVALID_HEADER); }
        pos = pos + block_size;
        if (is_last) { done = 1; }
    }

    if (si == 0) { return err(ERR_INVALID_HEADER); }
    store64(si + 48, pos);
    store64(si + 56, seek_table);
    return si;
}

# ================================================================
# Frame sync and header decoding
# ================================================================

# Find next frame sync (0xFFF8 or 0xFFF9). Returns sync byte position or error.
# Also advances br past the sync code.
fn flac_find_sync(br, data, data_len) {
    flac_br_align(br);
    var bpos = flac_br_byte_pos(br);
    while (bpos + 1 < data_len) {
        if (load8(data + bpos) == 0xFF) {
            var next = load8(data + bpos + 1);
            if (next == 0xF8) {
                flac_br_set_pos(br, bpos + 2);
                return bpos;
            }
            if (next == 0xF9) {
                flac_br_set_pos(br, bpos + 2);
                return bpos;
            }
        }
        bpos = bpos + 1;
    }
    return err(ERR_END_OF_STREAM);
}

# Decode block size from 4-bit code
fn flac_decode_block_size(code, br) {
    if (code == 0) { return err(ERR_DECODE); }
    if (code == 1) { return 192; }
    if (code >= 2) { if (code <= 5) { return 576 << (code - 2); } }
    if (code == 6) {
        var v = bitreader_read(br, 8);
        if (is_err(v) == 1) { return v; }
        return v + 1;
    }
    if (code == 7) {
        var v = bitreader_read(br, 16);
        if (is_err(v) == 1) { return v; }
        if (v + 1 > 65535) { return err(ERR_DECODE); }
        return v + 1;
    }
    if (code >= 8) { if (code <= 15) { return 256 << (code - 8); } }
    return err(ERR_DECODE);
}

# Decode sample rate from 4-bit code
fn flac_decode_sample_rate(code, br, si_rate) {
    if (code == 0)  { return si_rate; }
    if (code == 1)  { return 88200; }
    if (code == 2)  { return 176400; }
    if (code == 3)  { return 192000; }
    if (code == 4)  { return 8000; }
    if (code == 5)  { return 16000; }
    if (code == 6)  { return 22050; }
    if (code == 7)  { return 24000; }
    if (code == 8)  { return 32000; }
    if (code == 9)  { return 44100; }
    if (code == 10) { return 48000; }
    if (code == 11) { return 96000; }
    if (code == 12) {
        var v = bitreader_read(br, 8);
        if (is_err(v) == 1) { return v; }
        return v * 1000;
    }
    if (code == 13) {
        var v = bitreader_read(br, 16);
        if (is_err(v) == 1) { return v; }
        return v;
    }
    if (code == 14) {
        var v = bitreader_read(br, 16);
        if (is_err(v) == 1) { return v; }
        return v * 10;
    }
    return err(ERR_DECODE);
}

# Decode bits per sample from 3-bit code
fn flac_decode_bps(code, si_bps) {
    if (code == 0) { return si_bps; }
    if (code == 1) { return 8; }
    if (code == 2) { return 12; }
    if (code == 3) { return err(ERR_DECODE); }
    if (code == 4) { return 16; }
    if (code == 5) { return 20; }
    if (code == 6) { return 24; }
    if (code == 7) { return 32; }      # RFC 9639 9.1.4 (reserved before it)
    return err(ERR_DECODE);
}

# ================================================================
# Rice residual decoding
# ================================================================

# Decode Rice-coded residuals into a pre-allocated buffer.
# Returns number of residuals or error.
fn flac_decode_residual(br, buf, block_size, pred_order) {
    var coding = bitreader_read(br, 2);
    if (is_err(coding) == 1) { return coding; }
    var rice_bits = 0;
    if (coding == 0) { rice_bits = 4; }
    else { if (coding == 1) { rice_bits = 5; }
        else { return err(ERR_DECODE); } }

    var part_order = bitreader_read(br, 4);
    if (is_err(part_order) == 1) { return part_order; }
    # The block must split into 2^order equal partitions, and the first must hold
    # the predictor's warm-up samples. libFLAC refuses a frame that breaks either
    # rule. Until 2.10.0 the first partition's count went negative and was
    # skipped while the rest were still read, so (2^order - 1) * (block >> order)
    # residuals went into a buffer of block - predictor order: past its end (a
    # partition order of 9 behind an order-12 predictor wrote 32 bytes past).
    if ((block_size >> part_order) < pred_order) { return err(ERR_DECODE); }
    if (((block_size >> part_order) << part_order) != block_size) { return err(ERR_DECODE); }
    var num_parts = 1 << part_order;
    var total = block_size - pred_order;
    var idx = 0;
    var part = 0;

    while (part < num_parts) {
        var count = 0;
        if (part_order == 0) {
            count = block_size - pred_order;
        } else {
            if (part == 0) {
                count = (block_size >> part_order) - pred_order;
            } else {
                count = block_size >> part_order;
            }
        }

        var rparam = bitreader_read(br, rice_bits);
        if (is_err(rparam) == 1) { return rparam; }
        var escape_val = 15;
        if (rice_bits == 5) { escape_val = 31; }

        if (rparam == escape_val) {
            # Escape: raw bits per sample
            var raw_bits = bitreader_read(br, 5);
            if (is_err(raw_bits) == 1) { return raw_bits; }
            var k = 0;
            while (k < count) {
                var raw = bitreader_read(br, raw_bits);
                if (is_err(raw) == 1) { return raw; }
                store64(buf + idx * 8, sign_extend(raw, raw_bits));
                idx = idx + 1;
                k = k + 1;
            }
        } else {
            # Rice-coded
            var k = 0;
            while (k < count) {
                var q = flac_br_read_unary(br);
                if (is_err(q) == 1) { return q; }
                var rem = 0;
                if (rparam > 0) {
                    rem = bitreader_read(br, rparam);
                    if (is_err(rem) == 1) { return rem; }
                }
                var uval = (q << rparam) | rem;
                # Zigzag decode
                var sval = 0;
                if ((uval & 1) == 0) {
                    sval = uval >> 1;
                } else {
                    sval = 0 - (uval >> 1) - 1;
                }
                store64(buf + idx * 8, sval);
                idx = idx + 1;
                k = k + 1;
            }
        }
        part = part + 1;
    }
    return total;
}

# ================================================================
# Subframe decoding
# ================================================================

# Decode CONSTANT subframe -> alloc buffer of block_size samples
fn flac_decode_constant(br, block_size, bps) {
    var raw = bitreader_read(br, bps);
    if (is_err(raw) == 1) { return raw; }
    var val = sign_extend(raw, bps);
    var buf = _flac_take_buf(block_size);
    if (is_err(buf) == 1) { return buf; }
    var i = 0;
    while (i < block_size) {
        store64(buf + i * 8, val);
        i = i + 1;
    }
    return buf;
}

# Decode VERBATIM subframe
fn flac_decode_verbatim(br, block_size, bps) {
    var buf = _flac_take_buf(block_size);
    if (is_err(buf) == 1) { return buf; }
    var i = 0;
    while (i < block_size) {
        var raw = bitreader_read(br, bps);
        if (is_err(raw) == 1) { return raw; }
        store64(buf + i * 8, sign_extend(raw, bps));
        i = i + 1;
    }
    return buf;
}

# Decode FIXED subframe (order 0-4)
fn flac_decode_fixed(br, block_size, bps, order) {
    # SEC-024: the predictor order must be strictly less than the block size.
    # FLAC requires blocksize > order (there must be residuals to predict), and
    # without the check the warm-up loop below writes `order` 8-byte samples
    # into an alloc(block_size * 8) buffer. Block-size code 6 yields sizes down
    # to 1 and LPC sf_type 63 yields order 32, so a crafted subframe wrote 256
    # bytes into an 8-byte allocation — a 248-byte heap overflow whose contents
    # are raw bits from the file. It also made num_res negative, handing
    # alloc() a negative size.
    if (block_size <= 0)     { return err(ERR_DECODE); }
    if (order < 0)           { return err(ERR_DECODE); }
    if (order >= block_size) { return err(ERR_DECODE); }

    var buf = _flac_take_buf(block_size);
    if (is_err(buf) == 1) { return buf; }
    # Read warm-up samples
    var i = 0;
    while (i < order) {
        var raw = bitreader_read(br, bps);
        if (is_err(raw) == 1) { return raw; }
        store64(buf + i * 8, sign_extend(raw, bps));
        i = i + 1;
    }

    # Read residuals into temp buffer
    var num_res = block_size - order;
    var res = _flac_take_res(num_res);
    if (is_err(res) == 1) { return res; }
    var rc = flac_decode_residual(br, res, block_size, order);
    if (is_err(rc) == 1) { return rc; }

    # Apply fixed prediction
    var ri = 0;
    while (ri < num_res) {
        var n = order + ri;
        var residual = load64(res + ri * 8);
        var predicted = 0;
        if (order == 0) {
            predicted = residual;
        }
        if (order == 1) {
            predicted = load64(buf + (n - 1) * 8) + residual;
        }
        if (order == 2) {
            predicted = 2 * load64(buf + (n - 1) * 8) - load64(buf + (n - 2) * 8) + residual;
        }
        if (order == 3) {
            predicted = 3 * load64(buf + (n - 1) * 8) - 3 * load64(buf + (n - 2) * 8) + load64(buf + (n - 3) * 8) + residual;
        }
        if (order == 4) {
            predicted = 4 * load64(buf + (n - 1) * 8) - 6 * load64(buf + (n - 2) * 8) + 4 * load64(buf + (n - 3) * 8) - load64(buf + (n - 4) * 8) + residual;
        }
        store64(buf + n * 8, predicted);
        ri = ri + 1;
    }
    return buf;
}

# Decode LPC subframe (order 1-32)
fn flac_decode_lpc(br, block_size, bps, order) {
    # SEC-024: the predictor order must be strictly less than the block size.
    # FLAC requires blocksize > order (there must be residuals to predict), and
    # without the check the warm-up loop below writes `order` 8-byte samples
    # into an alloc(block_size * 8) buffer. Block-size code 6 yields sizes down
    # to 1 and LPC sf_type 63 yields order 32, so a crafted subframe wrote 256
    # bytes into an 8-byte allocation — a 248-byte heap overflow whose contents
    # are raw bits from the file. It also made num_res negative, handing
    # alloc() a negative size.
    if (block_size <= 0)     { return err(ERR_DECODE); }
    if (order < 0)           { return err(ERR_DECODE); }
    if (order >= block_size) { return err(ERR_DECODE); }

    var buf = _flac_take_buf(block_size);
    if (is_err(buf) == 1) { return buf; }
    # Read warm-up samples
    var i = 0;
    while (i < order) {
        var raw = bitreader_read(br, bps);
        if (is_err(raw) == 1) { return raw; }
        store64(buf + i * 8, sign_extend(raw, bps));
        i = i + 1;
    }

    # QLP coefficient precision (4 bits)
    var prec_raw = bitreader_read(br, 4);
    if (is_err(prec_raw) == 1) { return prec_raw; }
    if (prec_raw == 15) { return err(ERR_DECODE); }
    var qlp_prec = prec_raw + 1;

    # QLP shift (5 bits, signed)
    var shift_raw = bitreader_read(br, 5);
    if (is_err(shift_raw) == 1) { return shift_raw; }
    var qlp_shift = sign_extend(shift_raw, 5);

    # Read coefficients
    if (_flac_coef == 0) { _flac_frame_start(); }
    var coeffs = _flac_coef;
    var ci = 0;
    while (ci < order) {
        var raw = bitreader_read(br, qlp_prec);
        if (is_err(raw) == 1) { return raw; }
        store64(coeffs + ci * 8, sign_extend(raw, qlp_prec));
        ci = ci + 1;
    }

    # Read residuals
    var num_res = block_size - order;
    var res = _flac_take_res(num_res);
    if (is_err(res) == 1) { return res; }
    var rc = flac_decode_residual(br, res, block_size, order);
    if (is_err(rc) == 1) { return rc; }

    # Apply LPC prediction
    var ri = 0;
    while (ri < num_res) {
        var n = order + ri;
        var acc = 0;
        var j = 0;
        while (j < order) {
            acc = acc + load64(coeffs + j * 8) * load64(buf + (n - 1 - j) * 8);
            j = j + 1;
        }
        # acc >> qlp_shift must round down, as an arithmetic shift does: rounding
        # toward zero is off by one on every negative prediction, and the error
        # feeds back through the filter until the audio is unrecognisable.
        var predicted = 0;
        if (qlp_shift >= 0) {
            predicted = sar(acc, qlp_shift);
        } else {
            predicted = acc << (0 - qlp_shift);
        }
        store64(buf + n * 8, predicted + load64(res + ri * 8));
        ri = ri + 1;
    }
    return buf;
}

# Decode a single subframe, returns pointer to sample buffer or error
# ---- per-frame scratch ----
# alloc() never frees, and each subframe used to allocate its own sample and
# residual buffers, so a decode allocated about three times its output (an hour
# of stereo at the one-shot ceiling would have cost 1.5 GB more than its samples).
# Subframe buffers now come from a ring of eight slots, one per channel, reset at
# each frame and grown only when a larger block arrives; the residual and LPC
# coefficient buffers are shared scratch.
var _flac_ring = 0;
var _flac_ring_buf = 0;    # [8] buffer pointers
var _flac_ring_cap = 0;    # [8] capacities in samples
var _flac_res = 0;
var _flac_res_cap = 0;
var _flac_coef = 0;        # [32]
var _flac_chbufs = 0;      # [8] per-frame channel buffer table

fn _flac_frame_start() {
    if (_flac_ring_buf == 0) {
        _flac_ring_buf = alloc(8 * 8); memset(_flac_ring_buf, 0, 64);
        _flac_ring_cap = alloc(8 * 8); memset(_flac_ring_cap, 0, 64);
        _flac_coef = alloc(32 * 8);
        _flac_chbufs = alloc(8 * 8);
    }
    _flac_ring = 0;
    return _flac_chbufs;
}

# A subframe's sample buffer: the next ring slot, at least n samples.
fn _flac_take_buf(n) {
    if (_flac_ring_buf == 0) { _flac_frame_start(); }
    var k = _flac_ring & 7;
    _flac_ring = _flac_ring + 1;
    if (load64(_flac_ring_cap + k * 8) < n) {
        var b = alloc(n * 8);
        if (b == 0) { return err(ERR_DECODE); }
        store64(_flac_ring_buf + k * 8, b);
        store64(_flac_ring_cap + k * 8, n);
    }
    return load64(_flac_ring_buf + k * 8);
}

fn _flac_take_res(n) {
    if (_flac_res_cap < n) {
        var b = alloc(n * 8);
        if (b == 0) { return err(ERR_DECODE); }
        _flac_res = b;
        _flac_res_cap = n;
    }
    return _flac_res;
}

fn flac_decode_subframe(br, block_size, bps) {
    # Subframe header: 1 zero bit + 6-bit type + wasted-bits flag
    var zero = bitreader_read(br, 1);
    if (is_err(zero) == 1) { return zero; }
    if (zero != 0) { return err(ERR_DECODE); }

    var sf_type = bitreader_read(br, 6);
    if (is_err(sf_type) == 1) { return sf_type; }

    var has_wasted = bitreader_read(br, 1);
    if (is_err(has_wasted) == 1) { return has_wasted; }

    var wasted = 0;
    if (has_wasted == 1) {
        wasted = flac_br_read_unary(br);
        if (is_err(wasted) == 1) { return wasted; }
        wasted = wasted + 1;
    }

    var eff_bps = bps - wasted;
    var buf = 0;

    if (sf_type == 0) {
        buf = flac_decode_constant(br, block_size, eff_bps);
    } else { if (sf_type == 1) {
            buf = flac_decode_verbatim(br, block_size, eff_bps);
        } else { if (sf_type >= 8) { if (sf_type <= 12) {
                    var order = sf_type - 8;
                    if (order > 4) { return err(ERR_DECODE); }
                    buf = flac_decode_fixed(br, block_size, eff_bps, order);
                } else { if (sf_type >= 32) { if (sf_type <= 63) {
                            var order = sf_type - 31;
                            buf = flac_decode_lpc(br, block_size, eff_bps, order);
                        } else {
                            return err(ERR_DECODE);
                        } } else {
                        return err(ERR_DECODE);
                    } } } else {
                return err(ERR_DECODE);
            } } }

    if (is_err(buf) == 1) { return buf; }

    # Apply wasted bits shift
    if (wasted > 0) {
        var wi = 0;
        while (wi < block_size) {
            store64(buf + wi * 8, load64(buf + wi * 8) << wasted);
            wi = wi + 1;
        }
    }
    return buf;
}

# ================================================================
# Channel decorrelation
# ================================================================

fn flac_apply_decorrelation(ch0, ch1, block_size, mode) {
    if (mode == FLAC_DECOR_INDEPENDENT) { return 0; }
    var i = 0;
    if (mode == FLAC_DECOR_LEFT_SIDE) {
        # ch0=left, ch1=side -> right = left - side
        while (i < block_size) {
            var l = load64(ch0 + i * 8);
            var s = load64(ch1 + i * 8);
            store64(ch1 + i * 8, l - s);
            i = i + 1;
        }
    }
    if (mode == FLAC_DECOR_RIGHT_SIDE) {
        # ch0=side, ch1=right -> left = side + right
        while (i < block_size) {
            var s = load64(ch0 + i * 8);
            var r = load64(ch1 + i * 8);
            store64(ch0 + i * 8, s + r);
            i = i + 1;
        }
    }
    if (mode == FLAC_DECOR_MID_SIDE) {
        while (i < block_size) {
            var m = load64(ch0 + i * 8);
            var s = load64(ch1 + i * 8);
            var mid = (m << 1) | (s & 1);
            # Arithmetic right shift for (mid + side) >> 1 and (mid - side) >> 1
            var lv = mid + s;
            var rv = mid - s;
            # These are guaranteed even so >> 1 is safe
            if (lv < 0) { lv = 0 - ((0 - lv) >> 1); } else { lv = lv >> 1; }
            if (rv < 0) { rv = 0 - ((0 - rv) >> 1); } else { rv = rv >> 1; }
            store64(ch0 + i * 8, lv);
            store64(ch1 + i * 8, rv);
            i = i + 1;
        }
    }
    return 0;
}

# ================================================================
# Frame decode
# ================================================================

# Facts about the frame _flac_frame last decoded.
var _flac_f_ch  = 0;    # channels
var _flac_f_bps = 0;    # bits per sample
var _flac_f_num = 0;    # frame number, or first sample number when _flac_f_var is 1
var _flac_f_var = 0;    # 1 = variable-blocksize stream
var _flac_f_crc = 0;    # 1 = the CRC-16 footer was in the buffer and matched

# Decode the next frame from the reader's position (searching forward for its
# sync code) into the per-frame channel buffers, _flac_chbufs. The one-shot, range
# and streaming decoders all go through here.
#
# Returns the block size, 0 when no sync code is left in the buffer, or an error.
# ERR_END_OF_STREAM means the buffer ends inside the frame, which a stream answers
# by waiting for more bytes; any other error means the frame is corrupt. A frame
# whose channel count disagrees with STREAMINFO is refused, as libFLAC (the flac
# CLI) refuses it; before 2.9.3 the samples came back interleaved for the wrong
# channel count. (ffmpeg follows the frames instead.)
fn _flac_frame(br, data, len, si_rate, si_bps, si_ch) {
    var sync_pos = flac_find_sync(br, data, len);
    if (is_err(sync_pos) == 1) { return 0; }
    var frame_start = sync_pos;
    var blocking = load8(data + sync_pos + 1) & 1;

    var bs_code = bitreader_read(br, 4);
    if (is_err(bs_code) == 1) { return bs_code; }
    var sr_code = bitreader_read(br, 4);
    if (is_err(sr_code) == 1) { return sr_code; }
    var ch_assign = bitreader_read(br, 4);
    if (is_err(ch_assign) == 1) { return ch_assign; }
    var ss_code = bitreader_read(br, 3);
    if (is_err(ss_code) == 1) { return ss_code; }
    var _reserved = bitreader_read(br, 1);
    if (is_err(_reserved) == 1) { return _reserved; }

    var num = flac_br_read_utf8_u64(br);
    if (is_err(num) == 1) { return num; }
    var block_size = flac_decode_block_size(bs_code, br);
    if (is_err(block_size) == 1) { return block_size; }
    var _frame_sr = flac_decode_sample_rate(sr_code, br, si_rate);
    if (is_err(_frame_sr) == 1) { return _frame_sr; }
    var frame_bps = flac_decode_bps(ss_code, si_bps);
    if (is_err(frame_bps) == 1) { return frame_bps; }

    # CRC-8 over the header
    flac_br_align(br);
    var crc8_pos = flac_br_byte_pos(br);
    var expected_crc8 = bitreader_read(br, 8);
    if (is_err(expected_crc8) == 1) { return expected_crc8; }
    if (flac_crc8(data + frame_start, crc8_pos - frame_start) != expected_crc8) { return err(ERR_DECODE); }

    # Channel count and decorrelation mode
    var ch_count = 0;
    var decor = FLAC_DECOR_INDEPENDENT;
    if (ch_assign < FLAC_CH_LEFT_SIDE) {
        ch_count = ch_assign + 1;
    } else {
        ch_count = 2;
        if (ch_assign == FLAC_CH_LEFT_SIDE) { decor = FLAC_DECOR_LEFT_SIDE; }
        if (ch_assign == FLAC_CH_RIGHT_SIDE) { decor = FLAC_DECOR_RIGHT_SIDE; }
        if (ch_assign == FLAC_CH_MID_SIDE) { decor = FLAC_DECOR_MID_SIDE; }
        if (ch_assign > FLAC_CH_MID_SIDE) { return err(ERR_DECODE); }
    }
    if (si_ch > 0) { if (ch_count != si_ch) { return err(ERR_DECODE); } }

    var ch_bufs = _flac_frame_start();
    var ch = 0;
    while (ch < ch_count) {
        var eff_bps = frame_bps;
        if (decor == FLAC_DECOR_LEFT_SIDE) { if (ch == 1) { eff_bps = frame_bps + 1; } }
        if (decor == FLAC_DECOR_RIGHT_SIDE) { if (ch == 0) { eff_bps = frame_bps + 1; } }
        if (decor == FLAC_DECOR_MID_SIDE) { if (ch == 1) { eff_bps = frame_bps + 1; } }
        var sf_buf = flac_decode_subframe(br, block_size, eff_bps);
        if (is_err(sf_buf) == 1) { return sf_buf; }
        store64(ch_bufs + ch * 8, sf_buf);
        ch = ch + 1;
    }
    if (ch_count == 2) {
        flac_apply_decorrelation(load64(ch_bufs), load64(ch_bufs + 8), block_size, decor);
    }

    # CRC-16 footer. The last frame of a truncated file may lack it, which a
    # one-shot decode tolerates; a stream reads _flac_f_crc to tell a complete
    # frame from one still arriving.
    flac_br_align(br);
    var crc16_end = flac_br_byte_pos(br);
    _flac_f_crc = 0;
    if (crc16_end + 2 <= len) {
        var expected_crc16 = bitreader_read(br, 16);
        if (is_err(expected_crc16) == 1) { return expected_crc16; }
        if (flac_crc16(data + frame_start, crc16_end - frame_start) != expected_crc16) { return err(ERR_DECODE); }
        _flac_f_crc = 1;
    }

    _flac_f_var = blocking;
    _flac_f_num = num;
    _flac_f_ch = ch_count;
    _flac_f_bps = frame_bps;
    return block_size;
}

# Append samples [from, to) of the frame _flac_frame just decoded to out,
# interleaved and scaled by 1 / 2^(bps-1). A presized vec (the one-shot decode
# sized from STREAMINFO, a stream's per-frame vec) is written in place.
fn _flac_emit(out, from, to) {
    var ch_count = _flac_f_ch;
    var scale = f64_div(F64_ONE, f64_from(1 << (_flac_f_bps - 1)));
    var need = (to - from) * ch_count;
    if (need <= 0) { return 0; }
    var len = load64(out + 8);
    if (load64(out + 16) - len >= need) {
        var c = 0;
        while (c < ch_count) {
            var src = load64(_flac_chbufs + c * 8);
            var dst = load64(out) + (len + c) * 8;
            var step = ch_count * 8;
            var i = from;
            while (i < to) {
                store64(dst, f64_mul(f64_from(load64(src + i * 8)), scale));
                dst = dst + step;
                i = i + 1;
            }
            c = c + 1;
        }
        store64(out + 8, len + need);
        return 0;
    }
    var j = from;
    while (j < to) {
        var k = 0;
        while (k < ch_count) {
            var ival = load64(load64(_flac_chbufs + k * 8) + j * 8);
            vec_push(out, f64_mul(f64_from(ival), scale));
            k = k + 1;
        }
        j = j + 1;
    }
    return 0;
}

# ================================================================
# Main FLAC decoder
# ================================================================

fn flac_decode(data, len) {
    var si = flac_parse_metadata(data, len);
    if (is_err(si) == 1) { return si; }

    var si_rate = load64(si + 16);
    var si_ch   = load64(si + 24);
    var si_bps  = load64(si + 32);
    var si_total = load64(si + 40);
    var audio_start = load64(si + 48);

    if (si_rate == 0) { return err(ERR_INVALID_RATE); }

    # SEC-023: bound total decoded samples.
    #
    # Nothing capped accumulation across frames. A frame header declaring
    # block_size 65535 plus a CONSTANT subframe fits in 13 bytes and mints
    # 65535 samples per channel, so a crafted stream expanded ~122,000x:
    # measured, a 26 KB input drove peak RSS to 3.0 GB (and alloc() never
    # frees). CRC-8 per frame does not bound it — the attacker just computes
    # the CRC.
    #
    # Two bounds, in order of authority:
    #  1. STREAMINFO total_samples, when non-zero, is the stream's own
    #     statement of its length. Frames beyond it contradict the header, so
    #     stopping there is correct decoding, not just defence.
    #  2. Otherwise the one-shot ceiling, _shravan_max_samples (2^26 interleaved
    #     samples by default, settable with shravan_set_max_samples). Past it the
    #     decode returns ERR_TOO_LARGE; the streaming decoder has no ceiling.
    var sample_limit = _shravan_max_samples;
    var declared = 0;
    if (si_total > 0) {
        if (si_ch > 0) {
            declared = si_total * si_ch;
            if (declared > sample_limit) { return err(ERR_TOO_LARGE); }
            if (declared > 0) { sample_limit = declared; }
        }
    }

    # Sized once from STREAMINFO when it states the length (nearly always), so peak
    # memory is the payload; growth by doubling held two to four times it.
    var all_samples = vec_new();
    if (declared > 0) {
        all_samples = _vec_new_cap(declared);
        if (is_err(all_samples) == 1) { return all_samples; }
    }
    var br = bitreader_new(data, len);
    flac_br_set_pos(br, audio_start);

    var bs = _flac_frame(br, data, len, si_rate, si_bps, si_ch);
    while (bs > 0) {
        # SEC-023: refuse the frame that would breach the limit rather
        # than truncating, so a caller never receives silently short audio.
        if (vec_len(all_samples) + bs * _flac_f_ch > sample_limit) {
            if (sample_limit == declared) { return err(ERR_DECODE); }   # contradicts STREAMINFO
            return err(ERR_TOO_LARGE);
        }
        _flac_emit(all_samples, 0, bs);
        bs = _flac_frame(br, data, len, si_rate, si_bps, si_ch);
    }
    if (is_err(bs) == 1) { return bs; }

    # Build FormatInfo
    var total_interleaved = vec_len(all_samples);
    var total_frames = 0;
    if (si_ch > 0) { total_frames = total_interleaved / si_ch; }
    var dur = f64_div(f64_from(total_frames), f64_from(si_rate));

    var fi = fmtinfo_new(FMT_FLAC, si_rate, si_ch, si_bps, dur, total_frames);
    return decode_result_new(fi, all_samples);
}

# ================================================================
# Range decoder — decode a sample range with SEEKTABLE seeking
# ================================================================

fn flac_decode_range(data, len, start_sample, num_samples) {
    var si = flac_parse_metadata(data, len);
    if (is_err(si) == 1) { return si; }

    var si_max_bs = load64(si + 8);
    var si_rate = load64(si + 16);
    var si_ch   = load64(si + 24);
    var si_bps  = load64(si + 32);
    var si_total = load64(si + 40);
    var audio_start = load64(si + 48);
    var seek_table  = load64(si + 56);

    if (si_rate == 0) { return err(ERR_INVALID_RATE); }

    var end_sample = 0;
    var has_end = 0;
    if (num_samples > 0) {
        end_sample = start_sample + num_samples;
        has_end = 1;
    }

    var start_byte = audio_start;
    if (start_sample > 0) {
        if (seek_table != 0) {
            var st_len = vec_len(seek_table);
            var i = 0;
            while (i < st_len) {
                var sp = vec_get(seek_table, i);
                var sp_sample = load64(sp);
                if (sp_sample <= start_sample) {
                    # SEC-031: the seek point's byte offset is a 64-bit value
                    # straight out of the SEEKTABLE and was never validated.
                    # flac_br_set_pos() would then anchor the bitreader at an
                    # arbitrary — possibly negative or past-the-end — position
                    # and every subsequent read would be out of bounds. (This is
                    # the roadmap's "flac seek anchor" item.) Ignore a seek
                    # point that does not land inside the audio region; the scan
                    # simply starts from an earlier valid anchor.
                    var sp_off = load64(sp + 8);
                    if (sp_off >= 0) {
                        var cand = audio_start + sp_off;
                        if (cand >= audio_start) {
                            if (cand < len) { start_byte = cand; }
                        }
                    }
                } else {
                    i = st_len;
                }
                i = i + 1;
            }
        }
    }

    # Sized from STREAMINFO when it states the length; the one-shot ceiling
    # applies to the range as it does to a whole-file decode.
    var all_samples = vec_new();
    if (si_total > 0) {
        var want = si_total - start_sample;
        if (has_end == 1) { if (num_samples < want) { want = num_samples; } }
        if (want > 0) {
            if (want > _shravan_max_samples / si_ch) { return err(ERR_TOO_LARGE); }
            all_samples = _vec_new_cap(want * si_ch);
            if (is_err(all_samples) == 1) { return all_samples; }
        }
    }

    var br = bitreader_new(data, len);
    flac_br_set_pos(br, start_byte);

    # The first frame decoded fixes the position: a fixed-blocksize frame header
    # carries its frame number, which counts STREAMINFO-size blocks (only the last
    # block may be shorter), and a variable-blocksize one carries its first sample.
    var current_sample = 0;
    var known = 0;
    if (start_sample == 0) { known = 1; }

    var done = 0;
    while (done == 0) {
        if (known == 1) { if (has_end == 1) { if (current_sample >= end_sample) { done = 1; } } }
        if (done == 0) {
            var bs = _flac_frame(br, data, len, si_rate, si_bps, si_ch);
            if (bs == 0) { done = 1; }
            if (done == 0) {
                if (is_err(bs) == 1) { return bs; }
                if (known == 0) {
                    current_sample = _flac_f_num;
                    if (_flac_f_var == 0) { current_sample = _flac_f_num * si_max_bs; }
                    known = 1;
                    if (has_end == 1) { if (current_sample >= end_sample) { done = 1; } }
                }
            }
            if (done == 0) {
                var skip = 0;
                if (current_sample < start_sample) { skip = start_sample - current_sample; }
                var take = bs;
                if (has_end == 1) { if (current_sample + bs > end_sample) { take = end_sample - current_sample; } }
                if (take > skip) {
                    if (vec_len(all_samples) + (take - skip) * _flac_f_ch > _shravan_max_samples) {
                        return err(ERR_TOO_LARGE);
                    }
                    _flac_emit(all_samples, skip, take);
                }
                current_sample = current_sample + bs;
            }
        }
    }

    var total_interleaved = vec_len(all_samples);
    var total_frames = 0;
    if (si_ch > 0) { total_frames = total_interleaved / si_ch; }
    var dur = f64_div(f64_from(total_frames), f64_from(si_rate));

    var fi = fmtinfo_new(FMT_FLAC, si_rate, si_ch, si_bps, dur, total_frames);
    return decode_result_new(fi, all_samples);
}

# ================================================================
# BitWriter (MSB-first) for encoder
# ================================================================
# Layout (32 bytes):
#   +0:  buf_ptr    (pointer to output byte buffer)
#   +8:  buf_cap    (capacity)
#   +16: buf_len    (current byte count, excluding partial)
#   +24: cur_byte   (current partial byte)
#   +32: bit_pos    (bits written in current byte, 0..8)

fn flac_bw_new(cap) {
    var bw = alloc(40);
    store64(bw, alloc(cap));
    store64(bw + 8, cap);
    store64(bw + 16, 0);
    store64(bw + 24, 0);
    store64(bw + 32, 0);
    return bw;
}

fn flac_bw_write_bits(bw, value, n) {
    if (n == 0) { return 0; }
    var remaining = n;
    var val = value;
    var buf = load64(bw);
    var cap = load64(bw + 8);
    var blen = load64(bw + 16);
    var cur = load64(bw + 24);
    var bpos = load64(bw + 32);

    while (remaining > 0) {
        var avail = 8 - bpos;
        var to_write = remaining;
        if (to_write > avail) { to_write = avail; }
        var bits = (val >> (remaining - to_write)) & ((1 << to_write) - 1);
        cur = cur | (bits << (avail - to_write));
        remaining = remaining - to_write;
        bpos = bpos + to_write;
        if (bpos >= 8) {
            # Grow buffer if at capacity
            if (blen >= cap) {
                var new_cap = cap * 2;
                var new_buf = alloc(new_cap);
                memcpy(new_buf, buf, cap);
                buf = new_buf;
                cap = new_cap;
                store64(bw, buf);
                store64(bw + 8, cap);
            }
            store8(buf + blen, cur);
            blen = blen + 1;
            cur = 0;
            bpos = 0;
        }
    }

    store64(bw + 16, blen);
    store64(bw + 24, cur);
    store64(bw + 32, bpos);
    return 0;
}

fn flac_bw_write_bit(bw, b) {
    return flac_bw_write_bits(bw, b, 1);
}

fn flac_bw_write_unary(bw, val) {
    var i = 0;
    while (i < val) {
        flac_bw_write_bit(bw, 0);
        i = i + 1;
    }
    flac_bw_write_bit(bw, 1);
    return 0;
}

fn flac_bw_align(bw) {
    var bpos = load64(bw + 32);
    if (bpos != 0) {
        var buf = load64(bw);
        var blen = load64(bw + 16);
        var cur = load64(bw + 24);
        store8(buf + blen, cur);
        store64(bw + 16, blen + 1);
        store64(bw + 24, 0);
        store64(bw + 32, 0);
    }
    return 0;
}

fn flac_bw_len(bw) {
    return load64(bw + 16);
}

fn flac_bw_buf(bw) {
    return load64(bw);
}

# Flush and return length (flushes partial byte)
fn flac_bw_finish(bw) {
    flac_bw_align(bw);
    return flac_bw_len(bw);
}

# Write UTF-8-like coded frame number
fn flac_bw_write_utf8_u64(bw, value) {
    if (value < 0x80) {
        flac_bw_write_bits(bw, value, 8);
    } else { if (value < 0x800) {
            flac_bw_write_bits(bw, 0xC0 | (value >> 6), 8);
            flac_bw_write_bits(bw, 0x80 | (value & 0x3F), 8);
        } else { if (value < 0x10000) {
                flac_bw_write_bits(bw, 0xE0 | (value >> 12), 8);
                flac_bw_write_bits(bw, 0x80 | ((value >> 6) & 0x3F), 8);
                flac_bw_write_bits(bw, 0x80 | (value & 0x3F), 8);
            } else { if (value < 0x200000) {
                    flac_bw_write_bits(bw, 0xF0 | (value >> 18), 8);
                    flac_bw_write_bits(bw, 0x80 | ((value >> 12) & 0x3F), 8);
                    flac_bw_write_bits(bw, 0x80 | ((value >> 6) & 0x3F), 8);
                    flac_bw_write_bits(bw, 0x80 | (value & 0x3F), 8);
                } else { if (value < 0x4000000) {
                        flac_bw_write_bits(bw, 0xF8 | (value >> 24), 8);
                        flac_bw_write_bits(bw, 0x80 | ((value >> 18) & 0x3F), 8);
                        flac_bw_write_bits(bw, 0x80 | ((value >> 12) & 0x3F), 8);
                        flac_bw_write_bits(bw, 0x80 | ((value >> 6) & 0x3F), 8);
                        flac_bw_write_bits(bw, 0x80 | (value & 0x3F), 8);
                    } else { if (value < 0x80000000) {
                            flac_bw_write_bits(bw, 0xFC | (value >> 30), 8);
                            flac_bw_write_bits(bw, 0x80 | ((value >> 24) & 0x3F), 8);
                            flac_bw_write_bits(bw, 0x80 | ((value >> 18) & 0x3F), 8);
                            flac_bw_write_bits(bw, 0x80 | ((value >> 12) & 0x3F), 8);
                            flac_bw_write_bits(bw, 0x80 | ((value >> 6) & 0x3F), 8);
                            flac_bw_write_bits(bw, 0x80 | (value & 0x3F), 8);
                        } else {
                            flac_bw_write_bits(bw, 0xFE, 8);
                            flac_bw_write_bits(bw, 0x80 | ((value >> 30) & 0x3F), 8);
                            flac_bw_write_bits(bw, 0x80 | ((value >> 24) & 0x3F), 8);
                            flac_bw_write_bits(bw, 0x80 | ((value >> 18) & 0x3F), 8);
                            flac_bw_write_bits(bw, 0x80 | ((value >> 12) & 0x3F), 8);
                            flac_bw_write_bits(bw, 0x80 | ((value >> 6) & 0x3F), 8);
                            flac_bw_write_bits(bw, 0x80 | (value & 0x3F), 8);
                        } } } } } }
    return 0;
}

# ================================================================
# Encoder helpers
# ================================================================
# The fixed-prediction helpers below are the 2.9.x encoder's, kept public for
# compatibility; flac_encode no longer uses them (see "Encoder: LPC" further on).

# Zigzag encode: signed -> unsigned for Rice coding
fn flac_zigzag(val) {
    if (val >= 0) { return val << 1; }
    return ((0 - val) << 1) - 1;
}

# Count bits needed: floor(log2(x)) for x > 0, 0 for x == 0
fn flac_ilog2(x) {
    if (x == 0) { return 0; }
    var r = 0;
    var v = x;
    while (v > 1) { v = v >> 1; r = r + 1; }
    return r;
}

# Optimal Rice parameter for a partition
# residuals in buf[start..start+count], each an i64 at buf + i*8
fn flac_optimal_rice(buf, start, count) {
    if (count == 0) { return 0; }
    var sum = 0;
    var i = 0;
    while (i < count) {
        sum = sum + flac_zigzag(load64(buf + (start + i) * 8));
        i = i + 1;
    }
    var mean = sum / count;
    if (mean == 0) { return 0; }
    var p = flac_ilog2(mean);
    if (p > 14) { p = 14; }
    return p;
}

# Estimate bit cost of Rice-encoding residuals with given param
fn flac_rice_bit_cost(buf, start, count, param) {
    var cost = 0;
    var i = 0;
    while (i < count) {
        var u = flac_zigzag(load64(buf + (start + i) * 8));
        cost = cost + (u >> param) + 1 + param;
        i = i + 1;
    }
    return cost;
}

# Encode Rice-coded residuals into BitWriter
fn flac_encode_residual(bw, res_buf, num_res, block_size, order) {
    # Coding method 0 (RICE, 4-bit params), partition order 0
    flac_bw_write_bits(bw, 0, 2);
    flac_bw_write_bits(bw, 0, 4);

    var rice_param = flac_optimal_rice(res_buf, 0, num_res);
    flac_bw_write_bits(bw, rice_param, 4);

    var i = 0;
    while (i < num_res) {
        var uval = flac_zigzag(load64(res_buf + i * 8));
        var q = uval >> rice_param;
        var rem = uval & ((1 << rice_param) - 1);
        flac_bw_write_unary(bw, q);
        if (rice_param > 0) {
            flac_bw_write_bits(bw, rem, rice_param);
        }
        i = i + 1;
    }
    return 0;
}

# Compute fixed prediction residuals
# samples: raw buffer, order: 0-4
# Writes residuals into res_buf starting at index 0
fn flac_compute_fixed_residuals(samples, count, order, res_buf) {
    var i = order;
    var ri = 0;
    while (i < count) {
        var predicted = 0;
        if (order == 0) { predicted = 0; }
        if (order == 1) { predicted = load64(samples + (i - 1) * 8); }
        if (order == 2) { predicted = 2 * load64(samples + (i - 1) * 8) - load64(samples + (i - 2) * 8); }
        if (order == 3) { predicted = 3 * load64(samples + (i - 1) * 8) - 3 * load64(samples + (i - 2) * 8) + load64(samples + (i - 3) * 8); }
        if (order == 4) { predicted = 4 * load64(samples + (i - 1) * 8) - 6 * load64(samples + (i - 2) * 8) + 4 * load64(samples + (i - 3) * 8) - load64(samples + (i - 4) * 8); }
        store64(res_buf + ri * 8, load64(samples + i * 8) - predicted);
        ri = ri + 1;
        i = i + 1;
    }
    return ri;
}

# Find best fixed order for a sample buffer. Returns best_order.
# Writes the cost into cost_ptr (a 1-element buffer).
fn flac_best_fixed_order(samples, count, bps, cost_ptr) {
    var best_order = 0;
    var best_cost = 9999999999;
    var res_buf = alloc(count * 8);

    var order = 0;
    while (order <= 4) {
        if (order <= count) {
            var nres = flac_compute_fixed_residuals(samples, count, order, res_buf);
            var param = flac_optimal_rice(res_buf, 0, nres);
            # Cost: 8 header + order*bps warmup + 6 residual header + rice cost
            var cost = 8 + bps * order + 6 + flac_rice_bit_cost(res_buf, 0, nres, param);
            if (cost < best_cost) {
                best_cost = cost;
                best_order = order;
            }
        }
        order = order + 1;
    }

    store64(cost_ptr, best_cost);
    return best_order;
}

# Encode a single subframe into BitWriter
fn flac_encode_subframe(bw, samples, count, bps) {
    # Verbatim cost: 8 + bps * count
    var verbatim_cost = 8 + bps * count;

    var cost_ptr = alloc(8);
    var fixed_order = flac_best_fixed_order(samples, count, bps, cost_ptr);
    var fixed_cost = load64(cost_ptr);

    if (verbatim_cost <= fixed_cost) {
        # Verbatim
        flac_bw_write_bit(bw, 0);
        flac_bw_write_bits(bw, 1, 6);
        flac_bw_write_bit(bw, 0);
        var i = 0;
        while (i < count) {
            flac_bw_write_bits(bw, load64(samples + i * 8) & ((1 << bps) - 1), bps);
            i = i + 1;
        }
    } else {
        # Fixed
        flac_bw_write_bit(bw, 0);
        flac_bw_write_bits(bw, 8 + fixed_order, 6);
        flac_bw_write_bit(bw, 0);

        # Warm-up samples
        var i = 0;
        while (i < fixed_order) {
            flac_bw_write_bits(bw, load64(samples + i * 8) & ((1 << bps) - 1), bps);
            i = i + 1;
        }

        # Residuals
        var nres = count - fixed_order;
        var res_buf = alloc(nres * 8);
        flac_compute_fixed_residuals(samples, count, fixed_order, res_buf);
        flac_encode_residual(bw, res_buf, nres, count, fixed_order);
    }
    return 0;
}

# Mid-side encoding for stereo
# left, right: raw sample buffers; count: number of samples
# Writes mid into mid_buf, side into side_buf
fn flac_apply_mid_side(left, right, count, mid_buf, side_buf) {
    var i = 0;
    while (i < count) {
        var l = load64(left + i * 8);
        var r = load64(right + i * 8);
        store64(side_buf + i * 8, l - r);
        # (l + r) >> 1 has to round down. The decoder rebuilds the dropped bit from
        # side, so rounding an odd negative sum toward zero loses a sample value.
        store64(mid_buf + i * 8, sar(l + r, 1));
        i = i + 1;
    }
    return 0;
}

# Block size -> 4-bit code (returns code; tail_bits and tail_val via pointers)
fn flac_block_size_code(block_size, tail_bits_ptr, tail_val_ptr) {
    store64(tail_bits_ptr, 0);
    store64(tail_val_ptr, 0);
    if (block_size == 192) { return 1; }
    if (block_size == 576)  { return 2; }
    if (block_size == 1152) { return 3; }
    if (block_size == 2304) { return 4; }
    if (block_size == 4608) { return 5; }
    if (block_size == 256)  { return 8; }
    if (block_size == 512)  { return 9; }
    if (block_size == 1024) { return 10; }
    if (block_size == 2048) { return 11; }
    if (block_size == 4096) { return 12; }
    if (block_size == 8192) { return 13; }
    if (block_size == 16384) { return 14; }
    if (block_size == 32768) { return 15; }
    if (block_size <= 256) {
        store64(tail_bits_ptr, 8);
        store64(tail_val_ptr, block_size - 1);
        return 6;
    }
    store64(tail_bits_ptr, 16);
    store64(tail_val_ptr, block_size - 1);
    return 7;
}

# Sample rate -> 4-bit code
fn flac_sample_rate_code(rate, tail_bits_ptr, tail_val_ptr) {
    store64(tail_bits_ptr, 0);
    store64(tail_val_ptr, 0);
    if (rate == 88200)  { return 1; }
    if (rate == 176400) { return 2; }
    if (rate == 192000) { return 3; }
    if (rate == 8000)   { return 4; }
    if (rate == 16000)  { return 5; }
    if (rate == 22050)  { return 6; }
    if (rate == 24000)  { return 7; }
    if (rate == 32000)  { return 8; }
    if (rate == 44100)  { return 9; }
    if (rate == 48000)  { return 10; }
    if (rate == 96000)  { return 11; }
    if ((rate % 1000) == 0) {
        if (rate / 1000 <= 255) {
            store64(tail_bits_ptr, 8);
            store64(tail_val_ptr, rate / 1000);
            return 12;
        }
    }
    if (rate <= 65535) {
        store64(tail_bits_ptr, 16);
        store64(tail_val_ptr, rate);
        return 13;
    }
    if ((rate % 10) == 0) {
        if (rate / 10 <= 65535) {
            store64(tail_bits_ptr, 16);
            store64(tail_val_ptr, rate / 10);
            return 14;
        }
    }
    return 0;
}

# Bits per sample -> 3-bit code
fn flac_bps_code(bps) {
    if (bps == 8)  { return 1; }
    if (bps == 12) { return 2; }
    if (bps == 16) { return 4; }
    if (bps == 20) { return 5; }
    if (bps == 24) { return 6; }
    return 0;
}

# ================================================================
# MD5 computation (RFC 1321)
# ================================================================

# MD5 S table (64 entries, stored at init)
var flac_md5_s = 0;
# MD5 K table (64 entries)
var flac_md5_k = 0;

fn flac_md5_init() {
    flac_md5_s = alloc(64 * 8);
    var s_vals = alloc(64);
    # Round 1
    store8(s_vals + 0, 7); store8(s_vals + 1, 12); store8(s_vals + 2, 17); store8(s_vals + 3, 22);
    store8(s_vals + 4, 7); store8(s_vals + 5, 12); store8(s_vals + 6, 17); store8(s_vals + 7, 22);
    store8(s_vals + 8, 7); store8(s_vals + 9, 12); store8(s_vals + 10, 17); store8(s_vals + 11, 22);
    store8(s_vals + 12, 7); store8(s_vals + 13, 12); store8(s_vals + 14, 17); store8(s_vals + 15, 22);
    # Round 2
    store8(s_vals + 16, 5); store8(s_vals + 17, 9); store8(s_vals + 18, 14); store8(s_vals + 19, 20);
    store8(s_vals + 20, 5); store8(s_vals + 21, 9); store8(s_vals + 22, 14); store8(s_vals + 23, 20);
    store8(s_vals + 24, 5); store8(s_vals + 25, 9); store8(s_vals + 26, 14); store8(s_vals + 27, 20);
    store8(s_vals + 28, 5); store8(s_vals + 29, 9); store8(s_vals + 30, 14); store8(s_vals + 31, 20);
    # Round 3
    store8(s_vals + 32, 4); store8(s_vals + 33, 11); store8(s_vals + 34, 16); store8(s_vals + 35, 23);
    store8(s_vals + 36, 4); store8(s_vals + 37, 11); store8(s_vals + 38, 16); store8(s_vals + 39, 23);
    store8(s_vals + 40, 4); store8(s_vals + 41, 11); store8(s_vals + 42, 16); store8(s_vals + 43, 23);
    store8(s_vals + 44, 4); store8(s_vals + 45, 11); store8(s_vals + 46, 16); store8(s_vals + 47, 23);
    # Round 4
    store8(s_vals + 48, 6); store8(s_vals + 49, 10); store8(s_vals + 50, 15); store8(s_vals + 51, 21);
    store8(s_vals + 52, 6); store8(s_vals + 53, 10); store8(s_vals + 54, 15); store8(s_vals + 55, 21);
    store8(s_vals + 56, 6); store8(s_vals + 57, 10); store8(s_vals + 58, 15); store8(s_vals + 59, 21);
    store8(s_vals + 60, 6); store8(s_vals + 61, 10); store8(s_vals + 62, 15); store8(s_vals + 63, 21);
    var si = 0;
    while (si < 64) {
        store64(flac_md5_s + si * 8, load8(s_vals + si));
        si = si + 1;
    }

    # K table — pre-computed floor(2^32 * abs(sin(i+1)))
    flac_md5_k = alloc(64 * 8);
    store64(flac_md5_k + 0 * 8,  0xd76aa478); store64(flac_md5_k + 1 * 8,  0xe8c7b756);
    store64(flac_md5_k + 2 * 8,  0x242070db); store64(flac_md5_k + 3 * 8,  0xc1bdceee);
    store64(flac_md5_k + 4 * 8,  0xf57c0faf); store64(flac_md5_k + 5 * 8,  0x4787c62a);
    store64(flac_md5_k + 6 * 8,  0xa8304613); store64(flac_md5_k + 7 * 8,  0xfd469501);
    store64(flac_md5_k + 8 * 8,  0x698098d8); store64(flac_md5_k + 9 * 8,  0x8b44f7af);
    store64(flac_md5_k + 10 * 8, 0xffff5bb1); store64(flac_md5_k + 11 * 8, 0x895cd7be);
    store64(flac_md5_k + 12 * 8, 0x6b901122); store64(flac_md5_k + 13 * 8, 0xfd987193);
    store64(flac_md5_k + 14 * 8, 0xa679438e); store64(flac_md5_k + 15 * 8, 0x49b40821);
    store64(flac_md5_k + 16 * 8, 0xf61e2562); store64(flac_md5_k + 17 * 8, 0xc040b340);
    store64(flac_md5_k + 18 * 8, 0x265e5a51); store64(flac_md5_k + 19 * 8, 0xe9b6c7aa);
    store64(flac_md5_k + 20 * 8, 0xd62f105d); store64(flac_md5_k + 21 * 8, 0x02441453);
    store64(flac_md5_k + 22 * 8, 0xd8a1e681); store64(flac_md5_k + 23 * 8, 0xe7d3fbc8);
    store64(flac_md5_k + 24 * 8, 0x21e1cde6); store64(flac_md5_k + 25 * 8, 0xc33707d6);
    store64(flac_md5_k + 26 * 8, 0xf4d50d87); store64(flac_md5_k + 27 * 8, 0x455a14ed);
    store64(flac_md5_k + 28 * 8, 0xa9e3e905); store64(flac_md5_k + 29 * 8, 0xfcefa3f8);
    store64(flac_md5_k + 30 * 8, 0x676f02d9); store64(flac_md5_k + 31 * 8, 0x8d2a4c8a);
    store64(flac_md5_k + 32 * 8, 0xfffa3942); store64(flac_md5_k + 33 * 8, 0x8771f681);
    store64(flac_md5_k + 34 * 8, 0x6d9d6122); store64(flac_md5_k + 35 * 8, 0xfde5380c);
    store64(flac_md5_k + 36 * 8, 0xa4beea44); store64(flac_md5_k + 37 * 8, 0x4bdecfa9);
    store64(flac_md5_k + 38 * 8, 0xf6bb4b60); store64(flac_md5_k + 39 * 8, 0xbebfbc70);
    store64(flac_md5_k + 40 * 8, 0x289b7ec6); store64(flac_md5_k + 41 * 8, 0xeaa127fa);
    store64(flac_md5_k + 42 * 8, 0xd4ef3085); store64(flac_md5_k + 43 * 8, 0x04881d05);
    store64(flac_md5_k + 44 * 8, 0xd9d4d039); store64(flac_md5_k + 45 * 8, 0xe6db99e5);
    store64(flac_md5_k + 46 * 8, 0x1fa27cf8); store64(flac_md5_k + 47 * 8, 0xc4ac5665);
    store64(flac_md5_k + 48 * 8, 0xf4292244); store64(flac_md5_k + 49 * 8, 0x432aff97);
    store64(flac_md5_k + 50 * 8, 0xab9423a7); store64(flac_md5_k + 51 * 8, 0xfc93a039);
    store64(flac_md5_k + 52 * 8, 0x655b59c3); store64(flac_md5_k + 53 * 8, 0x8f0ccc92);
    store64(flac_md5_k + 54 * 8, 0xffeff47d); store64(flac_md5_k + 55 * 8, 0x85845dd1);
    store64(flac_md5_k + 56 * 8, 0x6fa87e4f); store64(flac_md5_k + 57 * 8, 0xfe2ce6e0);
    store64(flac_md5_k + 58 * 8, 0xa3014314); store64(flac_md5_k + 59 * 8, 0x4e0811a1);
    store64(flac_md5_k + 60 * 8, 0xf7537e82); store64(flac_md5_k + 61 * 8, 0xbd3af235);
    store64(flac_md5_k + 62 * 8, 0x2ad7d2bb); store64(flac_md5_k + 63 * 8, 0xeb86d391);
    return 0;
}

# 32-bit unsigned helpers for MD5 (Cyrius is i64, we mask to 32 bits)
fn u32_add(a, b) { return (a + b) & 0xFFFFFFFF; }
fn u32_not(a)    { return (a ^ 0xFFFFFFFF) & 0xFFFFFFFF; }
fn u32_rotl(val, n) {
    return ((val << n) | (val >> (32 - n))) & 0xFFFFFFFF;
}

# Incremental MD5. The encoder hashes each frame's samples as it writes the frame,
# so nothing proportional to the stream is held for the signature.
# Context (64 bytes):
#   +0 a   +8 b   +16 c   +24 d   +32 bytes hashed   +40 bytes held (0..63)
#   +48 the unfinished block [64]   +56 message words [16]
fn flac_md5_new() {
    if (flac_md5_s == 0) { flac_md5_init(); }
    var ctx = alloc(64);
    store64(ctx, 0x67452301);
    store64(ctx + 8, 0xefcdab89);
    store64(ctx + 16, 0x98badcfe);
    store64(ctx + 24, 0x10325476);
    store64(ctx + 32, 0);
    store64(ctx + 40, 0);
    store64(ctx + 48, alloc(64));
    store64(ctx + 56, alloc(16 * 8));
    return ctx;
}

# One 64-byte block into the context's state. The round functions are in their
# two-operation forms: F = d ^ (b & (c ^ d)), G = c ^ (d & (b ^ c)).
fn _flac_md5_block(ctx, p) {
    var m = load64(ctx + 56);
    var wi = 0;
    while (wi < 16) {
        var off = wi * 4;
        store64(m + wi * 8, load8(p + off) | (load8(p + off + 1) << 8) | (load8(p + off + 2) << 16) | (load8(p + off + 3) << 24));
        wi = wi + 1;
    }
    var a = load64(ctx);
    var b = load64(ctx + 8);
    var c = load64(ctx + 16);
    var d = load64(ctx + 24);
    var i = 0;
    while (i < 64) {
        var f = 0;
        var g = 0;
        if (i < 16) {
            f = d ^ (b & (c ^ d));
            g = i;
        } elif (i < 32) {
            f = c ^ (d & (b ^ c));
            g = (5 * i + 1) & 15;
        } elif (i < 48) {
            f = b ^ c ^ d;
            g = (3 * i + 5) & 15;
        } else {
            f = c ^ (b | (d ^ 0xFFFFFFFF));
            g = (7 * i) & 15;
        }
        var t = (a + f + load64(flac_md5_k + i * 8) + load64(m + g * 8)) & 0xFFFFFFFF;
        var sh = load64(flac_md5_s + i * 8);
        t = ((t << sh) | (t >> (32 - sh))) & 0xFFFFFFFF;
        a = d;
        d = c;
        c = b;
        b = (b + t) & 0xFFFFFFFF;
        i = i + 1;
    }
    store64(ctx, (load64(ctx) + a) & 0xFFFFFFFF);
    store64(ctx + 8, (load64(ctx + 8) + b) & 0xFFFFFFFF);
    store64(ctx + 16, (load64(ctx + 16) + c) & 0xFFFFFFFF);
    store64(ctx + 24, (load64(ctx + 24) + d) & 0xFFFFFFFF);
    return 0;
}

fn flac_md5_update(ctx, data, len) {
    store64(ctx + 32, load64(ctx + 32) + len);
    var held = load64(ctx + 40);
    var blk = load64(ctx + 48);
    var i = 0;
    if (held > 0) {
        while (held < 64 && i < len) {
            store8(blk + held, load8(data + i));
            held = held + 1;
            i = i + 1;
        }
        if (held < 64) {
            store64(ctx + 40, held);
            return 0;
        }
        _flac_md5_block(ctx, blk);
        held = 0;
    }
    while (len - i >= 64) {
        _flac_md5_block(ctx, data + i);
        i = i + 64;
    }
    while (i < len) {
        store8(blk + held, load8(data + i));
        held = held + 1;
        i = i + 1;
    }
    store64(ctx + 40, held);
    return 0;
}

# Pads, hashes the length, and returns the 16-byte digest.
fn flac_md5_final(ctx) {
    var bits = load64(ctx + 32) * 8;
    var held = load64(ctx + 40);
    var padlen = 56 - held;
    if (held >= 56) { padlen = 120 - held; }
    var pad = alloc(128);
    memset(pad, 0, 128);
    store8(pad, 0x80);
    var k = 0;
    while (k < 8) {
        store8(pad + padlen + k, (bits >> (k * 8)) & 0xFF);
        k = k + 1;
    }
    flac_md5_update(ctx, pad, padlen + 8);
    var result = alloc(16);
    var w = 0;
    while (w < 4) {
        var v = load64(ctx + w * 8);
        store8(result + w * 4, v & 0xFF);
        store8(result + w * 4 + 1, (v >> 8) & 0xFF);
        store8(result + w * 4 + 2, (v >> 16) & 0xFF);
        store8(result + w * 4 + 3, (v >> 24) & 0xFF);
        w = w + 1;
    }
    return result;
}

# Compute MD5 digest. data: pointer, dlen: byte length.
# Returns pointer to 16-byte digest buffer.
fn flac_md5_compute(data, dlen) {
    var ctx = flac_md5_new();
    flac_md5_update(ctx, data, dlen);
    return flac_md5_final(ctx);
}

# ================================================================
# Encoder: LPC, partitioned Rice, stereo decorrelation, seek table
# ================================================================
# Modelled on libFLAC 1.5.0, the encoder behind the `flac` tool, so the levels
# mean what `flac -0` to `flac -8` mean (flac --help):
#
#   level  block  stereo       max LPC order  max partition order  windows
#   0      1152   independent  0 (fixed)      3
#   1      1152   estimated    0              3
#   2      1152   exhaustive   0              3
#   3      4096   independent  6              4                    tukey(0.5)
#   4      4096   estimated    8              4                    tukey(0.5)
#   5      4096   exhaustive   8              5                    tukey(0.5)
#   6      4096   exhaustive   8              6                    subdivide_tukey(2)
#   7      4096   exhaustive   12             6                    subdivide_tukey(2)
#   8      4096   exhaustive   12             6                    subdivide_tukey(3)
#
# Each subframe starts from verbatim. A constant signal becomes a CONSTANT
# subframe; trailing zero bits common to every sample are removed (wasted bits).
# The fixed predictor whose residual has the smallest absolute sum is tried,
# then, per analysis window: the windowed autocorrelation, Levinson-Durbin, the
# order libFLAC's estimate prefers, coefficients quantised with error feedback,
# and the residual. Every candidate gets its Rice partition order chosen from
# partition sums and its parameters refined exactly, and the smallest wins.
# Stereo: "exhaustive" encodes left, right, mid and side and keeps the cheapest
# pair; "estimated" picks the pair from fixed-predictor residual sums first.
#
# Where this differs from libFLAC, it differs to spend more: the Rice
# parameters are chosen by exact count, and punchout autocorrelations subtract
# every lag. Output is a valid stream whatever the choices.

var _fe_bs = 4096;      # block size
var _fe_stereo = 2;     # 0 independent, 1 estimated, 2 exhaustive
var _fe_lpc = 8;        # max LPC order; 0 = fixed predictors only
var _fe_po = 5;         # max Rice partition order
var _fe_div = 1;        # 1: tukey(0.5); P >= 2: subdivide_tukey(P)
var _fe_prec = 12;      # quantised coefficient precision, libFLAC's default
var _fe_rlim = 15;      # Rice escape code: 15, or 31 (5-bit parameters) above 16 bits

# Scratch, sized for _fe_cap samples and kept across calls.
var _fe_cap = 0;
var _fe_sd = 0;         # [4] subframe descriptors
var _fe_mid = 0;        # [cap] mid channel
var _fe_side = 0;       # [cap] side channel
var _fe_chb = 0;        # [8] channel buffers [cap] for one frame
var _fe_md5b = 0;       # [cap * 8 * 4] one frame's samples as bytes, for the MD5
var _fe_xw = 0;         # [cap] f64 windowed signal
var _fe_win = 0;        # [cap] f64 window
var _fe_win_n = 0;      # length the window was built for
var _fe_win_div = 0;    # _fe_div it was built for
var _fe_autoc = 0;      # [33] f64
var _fe_root = 0;       # [33] f64: the full window's autocorrelation (punchouts)
var _fe_lp = 0;         # [32 * 32] f64 predictor coefficients per order
var _fe_lpt = 0;        # [32] f64 Levinson-Durbin working coefficients
var _fe_lerr = 0;       # [32] f64 prediction error per order
var _fe_qlp = 0;        # [32] quantised coefficients of the candidate
var _fe_sum = 0;        # [256] Rice partition sums
var _fe_kc = 0;         # [256] Rice parameters at one partition order
var _fe_kc2 = 0;        # [256] Rice parameters of the candidate under test
var _fe_tb = 0;         # [1] header code tail: bits
var _fe_tv = 0;         # [1] header code tail: value

# The candidate _fe_rice just costed.
var _fe_c_po = 0;       # partition order
var _fe_c_kw = 4;       # parameter width: 4, or 5 (RICE2)

# Output: a bit accumulator over the caller's buffer.
var _fe_out = 0;
var _fe_pos = 0;
var _fe_acc = 0;
var _fe_nacc = 0;

# Subframe descriptor offsets.
var _FE_SD_TYPE = 0;        # 0 constant, 1 verbatim, 2 fixed, 3 LPC
var _FE_SD_BITS = 8;        # exact size in bits
var _FE_SD_WASTED = 16;
var _FE_SD_SBPS = 24;       # bits per sample once the wasted bits are gone
var _FE_SD_ORDER = 32;
var _FE_SD_PREC = 40;
var _FE_SD_SHIFT = 48;
var _FE_SD_PO = 56;         # partition order
var _FE_SD_KW = 64;         # Rice parameter width
var _FE_SD_X = 72;          # [cap] samples, wasted bits removed
var _FE_SD_RES = 80;        # [cap] residual of the best candidate
var _FE_SD_CRES = 88;       # [cap] residual of the candidate under test
var _FE_SD_QLP = 96;        # [32] coefficients of the best candidate
var _FE_SD_K = 104;         # [256] Rice parameters of the best candidate
var _FE_SD_CONST = 112;     # constant value

fn _fe_settings(level, bps) {
    _fe_bs = 4096;
    _fe_stereo = 2;
    _fe_lpc = 8;
    _fe_po = 5;
    _fe_div = 1;
    if (level <= 2) {
        _fe_bs = 1152;
        _fe_lpc = 0;
        _fe_po = 3;
        _fe_stereo = level;
    }
    if (level == 3) { _fe_lpc = 6; _fe_po = 4; _fe_stereo = 0; }
    if (level == 4) { _fe_po = 4; _fe_stereo = 1; }
    if (level >= 6) { _fe_po = 6; _fe_div = 2; }
    if (level >= 7) { _fe_lpc = 12; }
    if (level == 8) { _fe_div = 3; }

    # libFLAC's default coefficient precision (stream_encoder.c).
    var bs = _fe_bs;
    if (bps < 16) {
        _fe_prec = 2 + bps / 2;
        if (_fe_prec < 5) { _fe_prec = 5; }
    } else { if (bps == 16) {
            _fe_prec = 13;
            if (bs <= 4608) { _fe_prec = 12; }
            if (bs <= 2304) { _fe_prec = 11; }
            if (bs <= 1152) { _fe_prec = 10; }
            if (bs <= 576) { _fe_prec = 9; }
            if (bs <= 384) { _fe_prec = 8; }
            if (bs <= 192) { _fe_prec = 7; }
        } else {
            _fe_prec = 15;
            if (bs <= 1152) { _fe_prec = 14; }
            if (bs <= 384) { _fe_prec = 13; }
        } }
    # libFLAC uses 5-bit Rice parameters only for streams over 16 bits.
    _fe_rlim = 15;
    if (bps > 16) { _fe_rlim = 31; }
    return 0;
}

fn _fe_scratch(n) {
    if (n <= _fe_cap) { return 0; }
    _fe_cap = n;
    _fe_sd = alloc(4 * 8);
    var i = 0;
    while (i < 4) {
        var sd = alloc(128);
        memset(sd, 0, 128);
        store64(sd + _FE_SD_X, alloc(n * 8));
        store64(sd + _FE_SD_RES, alloc(n * 8));
        store64(sd + _FE_SD_CRES, alloc(n * 8));
        store64(sd + _FE_SD_QLP, alloc(32 * 8));
        store64(_fe_sd + i * 8, sd);
        i = i + 1;
    }
    _fe_mid = alloc(n * 8);
    _fe_side = alloc(n * 8);
    _fe_chb = alloc(8 * 8);
    i = 0;
    while (i < 8) {
        store64(_fe_chb + i * 8, alloc(n * 8));
        i = i + 1;
    }
    _fe_md5b = alloc(n * 8 * 4);
    _fe_xw = alloc(n * 8);
    _fe_win = alloc(n * 8);
    _fe_win_n = 0;
    if (_fe_autoc == 0) {
        _fe_autoc = alloc(33 * 8);
        _fe_root = alloc(33 * 8);
        _fe_lp = alloc(32 * 32 * 8);
        _fe_lpt = alloc(32 * 8);
        _fe_lerr = alloc(32 * 8);
        _fe_qlp = alloc(32 * 8);
        _fe_sum = alloc(256 * 8);
        _fe_kc = alloc(256 * 8);
        _fe_kc2 = alloc(256 * 8);
        _fe_tb = alloc(8);
        _fe_tv = alloc(8);
    }
    # Rice parameters live per descriptor; 256 partitions is order 8.
    i = 0;
    while (i < 4) {
        var sd2 = load64(_fe_sd + i * 8);
        store64(sd2 + _FE_SD_K, alloc(256 * 8));
        i = i + 1;
    }
    return 0;
}

# ---------------------------------------------------------------- bits out

fn _fe_put(v, nb) {
    _fe_acc = (_fe_acc << nb) | (v & ((1 << nb) - 1));
    _fe_nacc = _fe_nacc + nb;
    while (_fe_nacc >= 8) {
        _fe_nacc = _fe_nacc - 8;
        store8(_fe_out + _fe_pos, (_fe_acc >> _fe_nacc) & 0xFF);
        _fe_pos = _fe_pos + 1;
    }
    return 0;
}

# Zero bits up to the next byte boundary.
fn _fe_align() {
    if (_fe_nacc > 0) { _fe_put(0, 8 - _fe_nacc); }
    return 0;
}

# The frame or sample number, in FLAC's UTF-8-like coding.
fn _fe_utf8(v) {
    if (v < 0x80) { _fe_put(v, 8); return 0; }
    var nb = 2;
    if (v >= 0x800) { nb = 3; }
    if (v >= 0x10000) { nb = 4; }
    if (v >= 0x200000) { nb = 5; }
    if (v >= 0x4000000) { nb = 6; }
    if (v >= 0x80000000) { nb = 7; }
    var lead = (0xFF00 >> nb) & 0xFF;
    if (nb == 7) { lead = 0xFE; }
    _fe_put(lead | ((v >> (6 * (nb - 1))) & (0xFF >> (nb + 1))), 8);
    var k = nb - 2;
    while (k >= 0) {
        _fe_put(0x80 | ((v >> (6 * k)) & 0x3F), 8);
        k = k - 1;
    }
    return 0;
}

# ---------------------------------------------------------------- analysis

# Residual buffers hold residuals already folded for Rice coding:
# r >= 0 -> 2r, r < 0 -> -2r - 1, written as (r << 1) ^ (sign mask).
fn _fe_zz(r) {
    return (r << 1) ^ (0 - (r >> 63));
}

fn _fe_ilog2(x) {
    var r = 0;
    while (x > 1) {
        x = x >> 1;
        r = r + 1;
    }
    return r;
}

# floor(log2(|x|)) of a nonzero f64 from its exponent field: frexp's exponent
# minus one, as libFLAC computes it.
fn _fe_f64_log2i(x) {
    return ((x >> 52) & 0x7FF) - 1023;
}

# tukey(0.5 / _fe_div) over n samples (libFLAC's FLAC__window_tukey). For
# subdivide_tukey(P) this one window serves every part: a part takes the
# window's first and last halves, as FLAC__lpc_window_data_partial does.
fn _fe_window(n) {
    if (n == _fe_win_n && _fe_div == _fe_win_div) { return 0; }
    _fe_win_n = n;
    _fe_win_div = _fe_div;
    var i = 0;
    while (i < n) {
        store64(_fe_win + i * 8, F64_ONE);
        i = i + 1;
    }
    var np = n / (4 * _fe_div) - 1;
    if (np > 0) {
        var k = 0;
        while (k <= np) {
            var a = f64_sub(F64_HALF, f64_mul(F64_HALF, f64_cos(f64_div(f64_mul(F64_PI, f64_from(k)), f64_from(np)))));
            store64(_fe_win + k * 8, a);
            var b = f64_sub(F64_HALF, f64_mul(F64_HALF, f64_cos(f64_div(f64_mul(F64_PI, f64_from(k + np)), f64_from(np)))));
            store64(_fe_win + (n - np - 1 + k) * 8, b);
            k = k + 1;
        }
    }
    return 0;
}

# autoc[0..lags] of _fe_xw[0..m). Up to 12 lags (every level's maximum) in one
# pass with the last twelve values and the sums in locals.
fn _fe_autocorr(m, lags) {
    if (lags <= 12) { return _fe_autocorr12(m, lags); }
    var l = 0;
    while (l <= lags) {
        var s = 0;
        var i = l;
        while (i < m) {
            s = f64_add(s, f64_mul(load64(_fe_xw + i * 8), load64(_fe_xw + (i - l) * 8)));
            i = i + 1;
        }
        store64(_fe_autoc + l * 8, s);
        l = l + 1;
    }
    return 0;
}

fn _fe_autocorr12(m, lags) {
    var a0 = 0; var a1 = 0; var a2 = 0; var a3 = 0; var a4 = 0; var a5 = 0; var a6 = 0;
    var a7 = 0; var a8 = 0; var a9 = 0; var a10 = 0; var a11 = 0; var a12 = 0;
    var w1 = 0; var w2 = 0; var w3 = 0; var w4 = 0; var w5 = 0; var w6 = 0;
    var w7 = 0; var w8 = 0; var w9 = 0; var w10 = 0; var w11 = 0; var w12 = 0;
    var p = _fe_xw;
    var e = _fe_xw + m * 8;
    if (lags <= 8) {
        while (p < e) {
            var v = load64(p);
            a0 = f64_add(a0, f64_mul(v, v));
            a1 = f64_add(a1, f64_mul(v, w1));
            a2 = f64_add(a2, f64_mul(v, w2));
            a3 = f64_add(a3, f64_mul(v, w3));
            a4 = f64_add(a4, f64_mul(v, w4));
            a5 = f64_add(a5, f64_mul(v, w5));
            a6 = f64_add(a6, f64_mul(v, w6));
            a7 = f64_add(a7, f64_mul(v, w7));
            a8 = f64_add(a8, f64_mul(v, w8));
            w8 = w7; w7 = w6; w6 = w5; w5 = w4; w4 = w3; w3 = w2; w2 = w1; w1 = v;
            p = p + 8;
        }
    } else {
        while (p < e) {
            var u = load64(p);
            a0 = f64_add(a0, f64_mul(u, u));
            a1 = f64_add(a1, f64_mul(u, w1));
            a2 = f64_add(a2, f64_mul(u, w2));
            a3 = f64_add(a3, f64_mul(u, w3));
            a4 = f64_add(a4, f64_mul(u, w4));
            a5 = f64_add(a5, f64_mul(u, w5));
            a6 = f64_add(a6, f64_mul(u, w6));
            a7 = f64_add(a7, f64_mul(u, w7));
            a8 = f64_add(a8, f64_mul(u, w8));
            a9 = f64_add(a9, f64_mul(u, w9));
            a10 = f64_add(a10, f64_mul(u, w10));
            a11 = f64_add(a11, f64_mul(u, w11));
            a12 = f64_add(a12, f64_mul(u, w12));
            w12 = w11; w11 = w10; w10 = w9; w9 = w8; w8 = w7; w7 = w6; w6 = w5; w5 = w4; w4 = w3; w3 = w2; w2 = w1; w1 = u;
            p = p + 8;
        }
    }
    var o = _fe_autoc;
    store64(o, a0); store64(o + 8, a1); store64(o + 16, a2); store64(o + 24, a3);
    store64(o + 32, a4); store64(o + 40, a5); store64(o + 48, a6); store64(o + 56, a7);
    store64(o + 64, a8); store64(o + 72, a9); store64(o + 80, a10); store64(o + 88, a11);
    store64(o + 96, a12);
    return 0;
}

# The whole block under the window.
fn _fe_autoc_full(x, n, lags) {
    var i = 0;
    while (i < n) {
        store64(_fe_xw + i * 8, f64_mul(f64_from(load64(x + i * 8)), load64(_fe_win + i * 8)));
        i = i + 1;
    }
    _fe_autocorr(n, lags);
    return 0;
}

# Part c of b: n / b samples from (c * n) / b, under the window's two halves.
fn _fe_autoc_part(x, n, b, c, lags) {
    var m = n / b;
    var half = m / 2;
    var shift = (c * n) / b;
    var i = 0;
    while (i < half) {
        store64(_fe_xw + i * 8, f64_mul(f64_from(load64(x + (shift + i) * 8)), load64(_fe_win + i * 8)));
        i = i + 1;
    }
    var j = n - half;
    while (j < n) {
        store64(_fe_xw + i * 8, f64_mul(f64_from(load64(x + (shift + i) * 8)), load64(_fe_win + j * 8)));
        i = i + 1;
        j = j + 1;
    }
    while (i < m) {
        store64(_fe_xw + i * 8, 0);
        i = i + 1;
    }
    _fe_autocorr(m, lags);
    return 0;
}

# Levinson-Durbin over _fe_autoc (libFLAC's FLAC__lpc_compute_lp_coefficients).
# Predictor coefficients for order k + 1 go to row k of _fe_lp, its error to
# _fe_lerr[k]. Returns the highest order computed.
fn _fe_levinson(max_order) {
    var err = load64(_fe_autoc);
    var i = 0;
    while (i < max_order) {
        var r = f64_neg(load64(_fe_autoc + (i + 1) * 8));
        var j = 0;
        while (j < i) {
            r = f64_sub(r, f64_mul(load64(_fe_lpt + j * 8), load64(_fe_autoc + (i - j) * 8)));
            j = j + 1;
        }
        r = f64_div(r, err);
        store64(_fe_lpt + i * 8, r);
        j = 0;
        while (j < (i >> 1)) {
            var tmp = load64(_fe_lpt + j * 8);
            store64(_fe_lpt + j * 8, f64_add(tmp, f64_mul(r, load64(_fe_lpt + (i - 1 - j) * 8))));
            store64(_fe_lpt + (i - 1 - j) * 8, f64_add(load64(_fe_lpt + (i - 1 - j) * 8), f64_mul(r, tmp)));
            j = j + 1;
        }
        if ((i & 1) == 1) {
            var t2 = load64(_fe_lpt + j * 8);
            store64(_fe_lpt + j * 8, f64_add(t2, f64_mul(t2, r)));
        }
        err = f64_mul(err, f64_sub(F64_ONE, f64_mul(r, r)));
        j = 0;
        while (j <= i) {
            store64(_fe_lp + (i * 32 + j) * 8, f64_neg(load64(_fe_lpt + j * 8)));
            j = j + 1;
        }
        store64(_fe_lerr + i * 8, err);
        if (err == 0) { return i + 1; }
        i = i + 1;
    }
    return max_order;
}

# Expected bits per residual sample from a prediction error
# (FLAC__lpc_compute_expected_bits_per_residual_sample_with_error_scale).
fn _fe_ebits(lerr, scale) {
    if (f64_gt(lerr, 0) == 1) {
        var b = f64_mul(F64_HALF, f64_log2(f64_mul(scale, lerr)));
        if (f64_lt(b, 0) == 1) { return 0; }
        return b;
    }
    if (f64_lt(lerr, 0) == 1) { return f64_from(1 << 40); }
    return 0;
}

# The order libFLAC's FLAC__lpc_compute_best_order picks.
fn _fe_guess_order(max_order, n, overhead) {
    var scale = f64_div(F64_HALF, f64_from(n));
    var best = 1;
    var best_bits = f64_from(1 << 62);
    var k = 0;
    while (k < max_order) {
        var order = k + 1;
        var bits = f64_add(f64_mul(_fe_ebits(load64(_fe_lerr + k * 8), scale), f64_from(n - order)), f64_from(order * overhead));
        if (f64_lt(bits, best_bits) == 1) {
            best = order;
            best_bits = bits;
        }
        k = k + 1;
    }
    return best;
}

# Quantises row order-1 of _fe_lp to prec bits into _fe_qlp, with error
# feedback (FLAC__lpc_quantize_coefficients). Returns the shift, or -1 when
# the coefficients cannot be represented.
fn _fe_quantize(order, prec) {
    var row = _fe_lp + (order - 1) * 32 * 8;
    var p = prec - 1;
    var qmax = (1 << p) - 1;
    var qmin = 0 - (1 << p);
    var cmax = 0;
    var i = 0;
    while (i < order) {
        var d = f64_abs(load64(row + i * 8));
        if (f64_gt(d, cmax) == 1) { cmax = d; }
        i = i + 1;
    }
    if (f64_gt(cmax, 0) == 0) { return 0 - 1; }
    var shift = p - _fe_f64_log2i(cmax) - 1;
    if (shift > 15) { shift = 15; }
    if (shift < 0 - 16) { return 0 - 1; }
    var scale = F64_ONE;
    if (shift >= 0) {
        scale = f64_from(1 << shift);
    } else {
        scale = f64_div(F64_ONE, f64_from(1 << (0 - shift)));
    }
    var error = 0;
    i = 0;
    while (i < order) {
        error = f64_add(error, f64_mul(load64(row + i * 8), scale));
        var q = f64_to(f64_round(error));
        if (q > qmax) { q = qmax; }
        if (q < qmin) { q = qmin; }
        error = f64_sub(error, f64_from(q));
        store64(_fe_qlp + i * 8, q);
        i = i + 1;
    }
    if (shift < 0) { shift = 0; }
    return shift;
}

# A residual must fit a signed 32-bit integer (RFC 9639 section 9.2.6);
# libFLAC's encoder also keeps clear of -2^31.
fn _fe_res_ok(r) {
    if (r > 2147483647) { return 0; }
    if (r < 0 - 2147483647) { return 0; }
    return 1;
}

# Fixed predictor residual for x[order..n), folded, into res. 0 if a residual
# is out of range.
fn _fe_fixed_res(x, n, order, res) {
    var i = order;
    while (i < n) {
        var s = load64(x + i * 8);
        var r = s;
        if (order == 1) { r = s - load64(x + (i - 1) * 8); }
        if (order == 2) { r = s - 2 * load64(x + (i - 1) * 8) + load64(x + (i - 2) * 8); }
        if (order == 3) { r = s - 3 * load64(x + (i - 1) * 8) + 3 * load64(x + (i - 2) * 8) - load64(x + (i - 3) * 8); }
        if (order == 4) { r = s - 4 * load64(x + (i - 1) * 8) + 6 * load64(x + (i - 2) * 8) - 4 * load64(x + (i - 3) * 8) + load64(x + (i - 4) * 8); }
        if (r > 2147483647) { return 0; }
        if (r < 0 - 2147483647) { return 0; }
        store64(res + (i - order) * 8, (r << 1) ^ (0 - (r >> 63)));
        i = i + 1;
    }
    return 1;
}

# LPC residual with _fe_qlp for x[order..n), folded, into res. 0 if a residual
# is out of range. Orders up to 12 (every level's maximum) keep the coefficients
# and the last samples in locals; the arithmetic shift of a negative sum is
# -((-sum - 1) >> shift) - 1.
fn _fe_lpc_res(x, n, order, shift, res) {
    if (order > 12) { return _fe_lpc_res_any(x, n, order, shift, res); }
    var q = _fe_qlp;
    var c0 = 0; var c1 = 0; var c2 = 0; var c3 = 0; var c4 = 0; var c5 = 0;
    var c6 = 0; var c7 = 0; var c8 = 0; var c9 = 0; var c10 = 0; var c11 = 0;
    if (order > 0) { c0 = load64(q); }
    if (order > 1) { c1 = load64(q + 8); }
    if (order > 2) { c2 = load64(q + 16); }
    if (order > 3) { c3 = load64(q + 24); }
    if (order > 4) { c4 = load64(q + 32); }
    if (order > 5) { c5 = load64(q + 40); }
    if (order > 6) { c6 = load64(q + 48); }
    if (order > 7) { c7 = load64(q + 56); }
    if (order > 8) { c8 = load64(q + 64); }
    if (order > 9) { c9 = load64(q + 72); }
    if (order > 10) { c10 = load64(q + 80); }
    if (order > 11) { c11 = load64(q + 88); }
    # x1 = x[i - 1] ... x12 = x[i - 12], zero before the block.
    var x1 = 0; var x2 = 0; var x3 = 0; var x4 = 0; var x5 = 0; var x6 = 0;
    var x7 = 0; var x8 = 0; var x9 = 0; var x10 = 0; var x11 = 0; var x12 = 0;
    if (order >= 1) { x1 = load64(x + (order - 1) * 8); }
    if (order >= 2) { x2 = load64(x + (order - 2) * 8); }
    if (order >= 3) { x3 = load64(x + (order - 3) * 8); }
    if (order >= 4) { x4 = load64(x + (order - 4) * 8); }
    if (order >= 5) { x5 = load64(x + (order - 5) * 8); }
    if (order >= 6) { x6 = load64(x + (order - 6) * 8); }
    if (order >= 7) { x7 = load64(x + (order - 7) * 8); }
    if (order >= 8) { x8 = load64(x + (order - 8) * 8); }
    if (order >= 9) { x9 = load64(x + (order - 9) * 8); }
    if (order >= 10) { x10 = load64(x + (order - 10) * 8); }
    if (order >= 11) { x11 = load64(x + (order - 11) * 8); }
    if (order >= 12) { x12 = load64(x + (order - 12) * 8); }
    var out = res;
    var i = order;
    if (order <= 8) {
        while (i < n) {
            var sum = c0 * x1 + c1 * x2 + c2 * x3 + c3 * x4 + c4 * x5 + c5 * x6 + c6 * x7 + c7 * x8;
            var s = load64(x + i * 8);
            var r = 0;
            if (sum < 0) { r = s + ((0 - sum - 1) >> shift) + 1; } else { r = s - (sum >> shift); }
            if (r > 2147483647) { return 0; }
            if (r < 0 - 2147483647) { return 0; }
            store64(out, (r << 1) ^ (0 - (r >> 63)));
            out = out + 8;
            x8 = x7; x7 = x6; x6 = x5; x5 = x4; x4 = x3; x3 = x2; x2 = x1; x1 = s;
            i = i + 1;
        }
        return 1;
    }
    while (i < n) {
        var sum2 = c0 * x1 + c1 * x2 + c2 * x3 + c3 * x4 + c4 * x5 + c5 * x6 + c6 * x7 + c7 * x8 + c8 * x9 + c9 * x10 + c10 * x11 + c11 * x12;
        var s2 = load64(x + i * 8);
        var r2 = 0;
        if (sum2 < 0) { r2 = s2 + ((0 - sum2 - 1) >> shift) + 1; } else { r2 = s2 - (sum2 >> shift); }
        if (r2 > 2147483647) { return 0; }
        if (r2 < 0 - 2147483647) { return 0; }
        store64(out, (r2 << 1) ^ (0 - (r2 >> 63)));
        out = out + 8;
        x12 = x11; x11 = x10; x10 = x9; x9 = x8; x8 = x7; x7 = x6; x6 = x5; x5 = x4; x4 = x3; x3 = x2; x2 = x1; x1 = s2;
        i = i + 1;
    }
    return 1;
}

fn _fe_lpc_res_any(x, n, order, shift, res) {
    var i = order;
    while (i < n) {
        var sum = 0;
        var j = 0;
        var xp = x + (i - 1) * 8;
        while (j < order) {
            sum = sum + load64(_fe_qlp + j * 8) * load64(xp - j * 8);
            j = j + 1;
        }
        var r = load64(x + i * 8) - sar(sum, shift);
        if (_fe_res_ok(r) == 0) { return 0; }
        store64(res + (i - order) * 8, _fe_zz(r));
        i = i + 1;
    }
    return 1;
}

# Absolute residual sums of the five fixed predictors over x[4..n), the
# smallest wins (FLAC__fixed_compute_best_predictor). Returns the order; its
# sum goes to _fe_fsum.
var _fe_fsum = 0;

fn _fe_fixed_guess(x, n) {
    var x0 = load64(x);
    var x1 = load64(x + 8);
    var x2 = load64(x + 16);
    var x3 = load64(x + 24);
    var e0 = x3;
    var e1 = x3 - x2;
    var e2 = e1 - (x2 - x1);
    var e3 = e2 - (x2 - 2 * x1 + x0);
    var t0 = 0;
    var t1 = 0;
    var t2 = 0;
    var t3 = 0;
    var t4 = 0;
    var i = 4;
    while (i < n) {
        var a0 = load64(x + i * 8);
        var a1 = a0 - e0;
        var a2 = a1 - e1;
        var a3 = a2 - e2;
        var a4 = a3 - e3;
        if (a0 < 0) { t0 = t0 - a0; } else { t0 = t0 + a0; }
        if (a1 < 0) { t1 = t1 - a1; } else { t1 = t1 + a1; }
        if (a2 < 0) { t2 = t2 - a2; } else { t2 = t2 + a2; }
        if (a3 < 0) { t3 = t3 - a3; } else { t3 = t3 + a3; }
        if (a4 < 0) { t4 = t4 - a4; } else { t4 = t4 + a4; }
        e0 = a0;
        e1 = a1;
        e2 = a2;
        e3 = a3;
        i = i + 1;
    }
    var order = 0;
    var best = t0;
    if (t1 < best) { order = 1; best = t1; }
    if (t2 < best) { order = 2; best = t2; }
    if (t3 < best) { order = 3; best = t3; }
    if (t4 < best) { order = 4; best = t4; }
    _fe_fsum = best;
    return order;
}

# The Rice parameter minimising n * (k + 1) + (sum >> k), an estimate of the
# coded size of n folded residuals summing to sum.
fn _fe_rice_k(n, sum) {
    if (n <= 0) { return 0; }
    var k0 = 0;
    if (sum > n) { k0 = _fe_ilog2(sum / n); }
    var best = 0;
    var best_bits = 0x7FFFFFFFFFFFFFFF;
    var k = k0 - 1;
    if (k < 0) { k = 0; }
    while (k <= k0 + 1) {
        if (k < _fe_rlim) {
            var bits = n * (k + 1) + (sum >> k);
            if (bits < best_bits) {
                best = k;
                best_bits = bits;
            }
        }
        k = k + 1;
    }
    return best;
}

# Codes nres residuals of a block of n samples behind a predictor of the given
# order. Chooses the partition order from partition sums, refines each
# parameter by exact count, writes the parameters to kout, and returns the
# exact size of the residual section in bits. _fe_c_po and _fe_c_kw say how.
fn _fe_rice(res, n, order, kout) {
    var maxp = 0;
    while (maxp < _fe_po && ((n >> (maxp + 1)) << (maxp + 1)) == n) { maxp = maxp + 1; }
    while (maxp > 0 && (n >> maxp) <= order) { maxp = maxp - 1; }

    # Partition sums at the finest order.
    var parts = 1 << maxp;
    var ps = n >> maxp;
    var j = 0;
    var r = 0;
    while (j < parts) {
        var end = (j + 1) * ps - order;
        var s = 0;
        while (r < end) {
            s = s + load64(res + r * 8);
            r = r + 1;
        }
        store64(_fe_sum + j * 8, s);
        j = j + 1;
    }

    # Coarsen one order at a time, keeping the cheapest estimate.
    var best_bits = 0x7FFFFFFFFFFFFFFF;
    var best_po = 0;
    var p = maxp;
    while (p >= 0) {
        parts = 1 << p;
        ps = n >> p;
        var bits = 6;
        j = 0;
        while (j < parts) {
            var cnt = ps;
            if (j == 0) { cnt = ps - order; }
            var sum = load64(_fe_sum + j * 8);
            var k = _fe_rice_k(cnt, sum);
            store64(_fe_kc + j * 8, k);
            bits = bits + 4 + cnt * (k + 1) + (sum >> k);
            j = j + 1;
        }
        if (bits < best_bits) {
            best_bits = bits;
            best_po = p;
            memcpy(kout, _fe_kc, parts * 8);
        }
        if (p > 0) {
            j = 0;
            while (j < parts / 2) {
                store64(_fe_sum + j * 8, load64(_fe_sum + (2 * j) * 8) + load64(_fe_sum + (2 * j + 1) * 8));
                j = j + 1;
            }
        }
        p = p - 1;
    }

    # Exact counts at k - 1, k, k + 1 for the chosen partitioning.
    parts = 1 << best_po;
    ps = n >> best_po;
    var total = 6;
    var kw = 4;
    r = 0;
    j = 0;
    while (j < parts) {
        var cnt2 = ps;
        if (j == 0) { cnt2 = ps - order; }
        var kb = load64(kout + j * 8);
        var klo = kb - 1;
        if (klo < 0) { klo = 0; }
        var khi = kb + 1;
        if (khi >= _fe_rlim) { khi = _fe_rlim - 1; }
        var q0 = 0;
        var q1 = 0;
        var q2 = 0;
        var e2 = r + cnt2;
        while (r < e2) {
            var u = load64(res + r * 8);
            q0 = q0 + (u >> klo);
            q1 = q1 + (u >> kb);
            q2 = q2 + (u >> khi);
            r = r + 1;
        }
        var c0 = q0 + cnt2 * (klo + 1);
        var c1 = q1 + cnt2 * (kb + 1);
        var c2 = q2 + cnt2 * (khi + 1);
        var kbest = kb;
        var cbest = c1;
        if (c0 < cbest) { kbest = klo; cbest = c0; }
        if (c2 < cbest) { kbest = khi; cbest = c2; }
        store64(kout + j * 8, kbest);
        if (kbest >= 15) { kw = 5; }
        total = total + cbest;
        j = j + 1;
    }
    total = total + parts * kw;
    _fe_c_po = best_po;
    _fe_c_kw = kw;
    return total;
}

# Make the candidate in _FE_SD_CRES the subframe's best.
fn _fe_take(sd, type, bits, order) {
    var t = load64(sd + _FE_SD_RES);
    store64(sd + _FE_SD_RES, load64(sd + _FE_SD_CRES));
    store64(sd + _FE_SD_CRES, t);
    store64(sd + _FE_SD_TYPE, type);
    store64(sd + _FE_SD_BITS, bits);
    store64(sd + _FE_SD_ORDER, order);
    store64(sd + _FE_SD_PO, _fe_c_po);
    store64(sd + _FE_SD_KW, _fe_c_kw);
    memcpy(load64(sd + _FE_SD_K), _fe_kc2, (1 << _fe_c_po) * 8);
    return 0;
}

# One LPC candidate from the coefficients Levinson-Durbin left for this window.
fn _fe_try_lpc(sd, n, sbps, hdr, max_order) {
    var order = _fe_guess_order(max_order, n, sbps + _fe_prec);
    var ebits = _fe_ebits(load64(_fe_lerr + (order - 1) * 8), f64_div(F64_HALF, f64_from(n - order)));
    if (f64_lt(ebits, f64_from(sbps)) == 0) { return 0; }
    var prec = _fe_prec;
    # Keep a decoder's prediction within 32 bits for streams up to 16 bits (the
    # side channel 17), as libFLAC does.
    if (sbps <= 17) {
        var cap = 32 - sbps - _fe_ilog2(order);
        if (cap < prec) { prec = cap; }
    }
    if (prec < 2) { return 0; }
    var shift = _fe_quantize(order, prec);
    if (shift < 0) { return 0; }
    var x = load64(sd + _FE_SD_X);
    var cres = load64(sd + _FE_SD_CRES);
    if (_fe_lpc_res(x, n, order, shift, cres) == 0) { return 0; }
    var rb = _fe_rice(cres, n, order, _fe_kc2);
    var bits = hdr + order * sbps + 4 + 5 + order * prec + rb;
    if (bits < load64(sd + _FE_SD_BITS)) {
        _fe_take(sd, 3, bits, order);
        store64(sd + _FE_SD_PREC, prec);
        store64(sd + _FE_SD_SHIFT, shift);
        memcpy(load64(sd + _FE_SD_QLP), _fe_qlp, order * 8);
    }
    return 0;
}

# Chooses the subframe for n samples of x at bps bits into sd.
fn _fe_analyze(sd, x, n, bps) {
    store64(sd + _FE_SD_WASTED, 0);
    store64(sd + _FE_SD_SBPS, bps);

    # CONSTANT
    var v0 = load64(x);
    var all = 1;
    var orv = 0;
    var i = 0;
    while (i < n) {
        var v = load64(x + i * 8);
        if (v != v0) { all = 0; }
        orv = orv | v;
        i = i + 1;
    }
    if (all == 1) {
        store64(sd + _FE_SD_TYPE, 0);
        store64(sd + _FE_SD_CONST, v0);
        store64(sd + _FE_SD_BITS, 8 + bps);
        return 0;
    }

    # Wasted bits: trailing zeros every sample shares.
    var w = 0;
    while ((orv & 1) == 0 && w < bps - 1) {
        orv = orv >> 1;
        w = w + 1;
    }
    var sbps = bps - w;
    var xs = load64(sd + _FE_SD_X);
    if (w == 0) {
        memcpy(xs, x, n * 8);
    } else {
        # Exact: every sample is a multiple of 2^w.
        i = 0;
        while (i < n) {
            store64(xs + i * 8, load64(x + i * 8) / (1 << w));
            i = i + 1;
        }
    }
    store64(sd + _FE_SD_WASTED, w);
    store64(sd + _FE_SD_SBPS, sbps);
    var hdr = 8 + w;

    # VERBATIM is the baseline.
    store64(sd + _FE_SD_TYPE, 1);
    store64(sd + _FE_SD_BITS, hdr + n * sbps);
    if (n <= 4) { return 0; }

    # FIXED: the order with the smallest absolute residual sum.
    var fo = _fe_fixed_guess(xs, n);
    var fbits_ok = 1;
    if (_fe_fsum > 0) {
        # libFLAC skips an order expected to cost a full sample per residual.
        var rbps = f64_log2(f64_div(f64_mul(f64_ln(f64_from(2)), f64_from(_fe_fsum)), f64_from(n - 4)));
        if (f64_lt(rbps, f64_from(sbps)) == 0) { fbits_ok = 0; }
    }
    if (fbits_ok == 1) {
        var cres = load64(sd + _FE_SD_CRES);
        if (_fe_fixed_res(xs, n, fo, cres) == 1) {
            var rb = _fe_rice(cres, n, fo, _fe_kc2);
            var bits = hdr + fo * sbps + rb;
            if (bits < load64(sd + _FE_SD_BITS)) { _fe_take(sd, 2, bits, fo); }
        }
    }

    # LPC, one candidate per analysis window.
    if (_fe_lpc == 0) { return 0; }
    var maxo = _fe_lpc;
    if (maxo >= n) { maxo = n - 1; }
    _fe_window(n);
    _fe_autoc_full(xs, n, maxo);
    var m0 = 0;
    if (f64_gt(load64(_fe_autoc), 0) == 1) {
        m0 = _fe_levinson(maxo);
        _fe_try_lpc(sd, n, sbps, hdr, m0);
    }
    if (_fe_div < 2) { return 0; }
    memcpy(_fe_root, _fe_autoc, (maxo + 1) * 8);
    var b = 2;
    while (b <= _fe_div) {
        if (n / b > 32) {
            var c = 0;
            while (c < b) {
                _fe_autoc_part(xs, n, b, c, maxo);
                if (f64_gt(load64(_fe_autoc), 0) == 1) {
                    m0 = _fe_levinson(maxo);
                    _fe_try_lpc(sd, n, sbps, hdr, m0);
                }
                # From depth 3, the block without this part too (libFLAC's
                # subdivide_tukey: at depth 2 it nearly repeats the other half).
                if (b >= 3) {
                    var l = 0;
                    while (l <= maxo) {
                        store64(_fe_autoc + l * 8, f64_sub(load64(_fe_root + l * 8), load64(_fe_autoc + l * 8)));
                        l = l + 1;
                    }
                    if (f64_gt(load64(_fe_autoc), 0) == 1) {
                        m0 = _fe_levinson(maxo);
                        _fe_try_lpc(sd, n, sbps, hdr, m0);
                    }
                }
                c = c + 1;
            }
        }
        b = b + 1;
    }
    return 0;
}

# A quick size estimate for stereo selection: the best fixed predictor's
# absolute residual sum.
fn _fe_estimate(x, n) {
    if (n <= 4) { return 0; }
    _fe_fixed_guess(x, n);
    return _fe_fsum;
}

# ---------------------------------------------------------------- writing

fn _fe_write_sub(sd, n) {
    var type = load64(sd + _FE_SD_TYPE);
    var w = load64(sd + _FE_SD_WASTED);
    var sbps = load64(sd + _FE_SD_SBPS);
    if (type == 0) {
        _fe_put(0, 8);
        _fe_put(load64(sd + _FE_SD_CONST), sbps);
        return 0;
    }
    var order = load64(sd + _FE_SD_ORDER);
    var code = 1;
    if (type == 2) { code = 8 + order; }
    if (type == 3) { code = 32 + order - 1; }
    # Zero pad bit, type, wasted-bits flag; then w - 1 zeros and a one.
    if (w > 0) {
        _fe_put((code << 1) | 1, 8);
        _fe_put(1, w);
    } else {
        _fe_put(code << 1, 8);
    }
    var x = load64(sd + _FE_SD_X);
    if (type == 1) {
        var i = 0;
        while (i < n) {
            _fe_put(load64(x + i * 8), sbps);
            i = i + 1;
        }
        return 0;
    }
    var k = 0;
    while (k < order) {
        _fe_put(load64(x + k * 8), sbps);
        k = k + 1;
    }
    if (type == 3) {
        var prec = load64(sd + _FE_SD_PREC);
        _fe_put(prec - 1, 4);
        _fe_put(load64(sd + _FE_SD_SHIFT), 5);
        var qlp = load64(sd + _FE_SD_QLP);
        k = 0;
        while (k < order) {
            _fe_put(load64(qlp + k * 8), prec);
            k = k + 1;
        }
    }
    # Residual: method, partition order, then each partition.
    var kw = load64(sd + _FE_SD_KW);
    var po = load64(sd + _FE_SD_PO);
    _fe_put(kw - 4, 2);
    _fe_put(po, 4);
    var res = load64(sd + _FE_SD_RES);
    var kp = load64(sd + _FE_SD_K);
    var parts = 1 << po;
    var ps = n >> po;
    var r = 0;
    var j = 0;
    while (j < parts) {
        var cnt = ps;
        if (j == 0) { cnt = ps - order; }
        var rk = load64(kp + j * 8);
        _fe_put(rk, kw);
        var low = (1 << rk) - 1;
        var e = r + cnt;
        while (r < e) {
            var u = load64(res + r * 8);
            var q = u >> rk;
            if (q + 1 + rk <= 56) {
                _fe_put((1 << rk) | (u & low), q + 1 + rk);
            } else {
                while (q > 32) {
                    _fe_put(0, 32);
                    q = q - 32;
                }
                _fe_put(0, q);
                _fe_put((1 << rk) | (u & low), rk + 1);
            }
            r = r + 1;
        }
        j = j + 1;
    }
    return 0;
}

# Encodes one frame of n samples per channel from the channel buffers in chtab
# at _fe_out + _fe_pos. Returns its size in bytes.
fn _fe_frame(chtab, ch, bps, rate, n, fnum) {
    var start = _fe_pos;
    _fe_acc = 0;
    _fe_nacc = 0;

    # Choose the subframes.
    var assign = ch - 1;
    var s0 = load64(_fe_sd);
    var s1 = load64(_fe_sd + 8);
    var s2 = load64(_fe_sd + 16);
    var s3 = load64(_fe_sd + 24);
    if (ch == 2 && _fe_stereo > 0) {
        var left = load64(chtab);
        var right = load64(chtab + 8);
        var i = 0;
        while (i < n) {
            var l = load64(left + i * 8);
            var rr = load64(right + i * 8);
            store64(_fe_side + i * 8, l - rr);
            # floor((l + r) / 2): a logical shift with the sign bit put back.
            var t = l + rr;
            store64(_fe_mid + i * 8, (t >> 1) | (t & 0x8000000000000000));
            i = i + 1;
        }
        var bl = 0;
        var br = 0;
        var bm = 0;
        var bsd = 0;
        if (_fe_stereo == 2) {
            _fe_analyze(s0, left, n, bps);
            _fe_analyze(s1, right, n, bps);
            _fe_analyze(s2, _fe_mid, n, bps);
            _fe_analyze(s3, _fe_side, n, bps + 1);
            bl = load64(s0 + _FE_SD_BITS);
            br = load64(s1 + _FE_SD_BITS);
            bm = load64(s2 + _FE_SD_BITS);
            bsd = load64(s3 + _FE_SD_BITS);
        } else {
            bl = _fe_estimate(left, n);
            br = _fe_estimate(right, n);
            bm = _fe_estimate(_fe_mid, n);
            bsd = _fe_estimate(_fe_side, n);
        }
        # libFLAC's order of preference: independent, left/side, right/side, mid/side.
        var best = bl + br;
        assign = 1;
        if (bl + bsd < best) { best = bl + bsd; assign = FLAC_CH_LEFT_SIDE; }
        if (bsd + br < best) { best = bsd + br; assign = FLAC_CH_RIGHT_SIDE; }
        if (bm + bsd < best) { best = bm + bsd; assign = FLAC_CH_MID_SIDE; }
        if (_fe_stereo == 1) {
            if (assign == 1 || assign == FLAC_CH_LEFT_SIDE) { _fe_analyze(s0, left, n, bps); }
            if (assign == 1 || assign == FLAC_CH_RIGHT_SIDE) { _fe_analyze(s1, right, n, bps); }
            if (assign == FLAC_CH_MID_SIDE) { _fe_analyze(s2, _fe_mid, n, bps); }
            if (assign != 1) { _fe_analyze(s3, _fe_side, n, bps + 1); }
        }
    }

    # Header.
    var bs_code = flac_block_size_code(n, _fe_tb, _fe_tv);
    var bs_tb = load64(_fe_tb);
    var bs_tv = load64(_fe_tv);
    var sr_code = flac_sample_rate_code(rate, _fe_tb, _fe_tv);
    var sr_tb = load64(_fe_tb);
    var sr_tv = load64(_fe_tv);
    _fe_put(0x3FFE, 14);
    _fe_put(0, 2);
    _fe_put(bs_code, 4);
    _fe_put(sr_code, 4);
    _fe_put(assign, 4);
    _fe_put(flac_bps_code(bps), 3);
    _fe_put(0, 1);
    _fe_utf8(fnum);
    if (bs_tb > 0) { _fe_put(bs_tv, bs_tb); }
    if (sr_tb > 0) { _fe_put(sr_tv, sr_tb); }
    _fe_put(flac_crc8(_fe_out + start, _fe_pos - start), 8);

    # Subframes.
    if (assign == 1 && ch == 2 && _fe_stereo > 0) {
        _fe_write_sub(s0, n);
        _fe_write_sub(s1, n);
    } else { if (assign == FLAC_CH_LEFT_SIDE) {
            _fe_write_sub(s0, n);
            _fe_write_sub(s3, n);
        } else { if (assign == FLAC_CH_RIGHT_SIDE) {
                _fe_write_sub(s3, n);
                _fe_write_sub(s1, n);
            } else { if (assign == FLAC_CH_MID_SIDE) {
                    _fe_write_sub(s2, n);
                    _fe_write_sub(s3, n);
                } else {
                    var c = 0;
                    while (c < ch) {
                        _fe_analyze(s0, load64(chtab + c * 8), n, bps);
                        _fe_write_sub(s0, n);
                        c = c + 1;
                    }
                } } } }

    _fe_align();
    var crc = flac_crc16(_fe_out + start, _fe_pos - start);
    _fe_put(crc, 16);
    return _fe_pos - start;
}

# The largest stream flac_encode_level can write for this input: every frame
# verbatim, plus headers and the seek table.
fn flac_encode_bound(frames, channels, bits_per_sample) {
    var bs = 1152;
    var nblocks = (frames + bs - 1) / bs;
    var frame_bytes = (channels * (8 + 1 + bits_per_sample * bs) + 7) / 8 + 18;
    return 4 + 38 + 4 + 18 * (nblocks + 1) + nblocks * frame_bytes + 64;
}

# Encodes f64 samples (interleaved, in [-1, 1]) to FLAC at a level from 0 (fast)
# to 8 (smallest), the levels of `flac -0` to `flac -8`. out_buf must hold
# flac_encode_bound(frames, channels, bits_per_sample) bytes. Returns the
# stream's size, or an error.
fn flac_encode_level(samples_vec, sample_rate, channels, bits_per_sample, level, out_buf) {
    if (channels < 1) { return err(ERR_INVALID_CHANNELS); }
    if (channels > 8) { return err(ERR_INVALID_CHANNELS); }
    if (sample_rate < 1) { return err(ERR_INVALID_RATE); }
    if (sample_rate > 1048575) { return err(ERR_INVALID_RATE); }
    if (bits_per_sample < 4) { return err(ERR_ENCODE); }
    if (bits_per_sample > 32) { return err(ERR_ENCODE); }
    if (level < 0) { return err(ERR_ENCODE); }
    if (level > 8) { return err(ERR_ENCODE); }

    var ch = channels;
    var bps = bits_per_sample;
    var total = vec_len(samples_vec) / ch;
    _fe_settings(level, bps);
    var bs = _fe_bs;
    _fe_scratch(bs);

    _fe_out = out_buf;
    _fe_pos = 0;
    _fe_acc = 0;
    _fe_nacc = 0;

    # Seek points every 10 seconds, each at the frame holding it, as `flac` writes
    # them by default. Planned now so the table can precede the frames.
    var spacing = sample_rate * 10;
    var npts = 0;
    var last = 0 - 1;
    var t = 0;
    while (t < total) {
        if (t / bs != last) {
            last = t / bs;
            npts = npts + 1;
        }
        t = t + spacing;
    }
    var pts = alloc(npts * 8 + 8);
    npts = 0;
    last = 0 - 1;
    t = 0;
    while (t < total) {
        if (t / bs != last) {
            last = t / bs;
            store64(pts + npts * 8, last);
            npts = npts + 1;
        }
        t = t + spacing;
    }

    # fLaC, STREAMINFO, SEEKTABLE.
    _fe_put(0x664C6143, 32);
    var last_flag = 0;
    if (npts == 0) { last_flag = 1; }
    _fe_put(last_flag, 1);
    _fe_put(0, 7);
    _fe_put(34, 24);
    var si = _fe_pos;
    # The configured block size, whatever the stream's length, as libFLAC writes
    # it: RFC 9639 wants at least 16, and ffmpeg refuses a stream that says less.
    _fe_put(bs, 16);
    _fe_put(bs, 16);
    _fe_put(0, 24);
    _fe_put(0, 24);
    _fe_put(sample_rate, 20);
    _fe_put(ch - 1, 3);
    _fe_put(bps - 1, 5);
    _fe_put(total >> 32, 4);
    _fe_put(total & 0xFFFFFFFF, 32);
    var md5_at = _fe_pos;
    var z = 0;
    while (z < 16) {
        _fe_put(0, 8);
        z = z + 1;
    }
    var st = 0;
    if (npts > 0) {
        _fe_put(0x83, 8);
        _fe_put(18 * npts, 24);
        st = _fe_pos;
        z = 0;
        while (z < 18 * npts) {
            _fe_put(0, 8);
            z = z + 1;
        }
    }

    var first = _fe_pos;
    var md5 = flac_md5_new();
    var bytes = (bps + 7) / 8;
    var f64_scale = f64_from(1 << (bps - 1));
    var q_hi = (1 << (bps - 1)) - 1;
    var q_lo = 0 - (1 << (bps - 1));
    var data = load64(samples_vec);
    var min_fs = 0x7FFFFFFF;
    var max_fs = 0;
    var next_pt = 0;
    var fi = 0;
    var s = 0;
    while (s < total) {
        var n = total - s;
        if (n > bs) { n = bs; }
        # Quantise this frame's samples, and hash them as signed little-endian
        # whole bytes, interleaved.
        var mb = 0;
        var i = 0;
        while (i < n) {
            var c = 0;
            while (c < ch) {
                var v = _pcm_quant(load64(data + ((s + i) * ch + c) * 8), f64_scale, q_lo, q_hi);
                store64(load64(_fe_chb + c * 8) + i * 8, v);
                var b = 0;
                while (b < bytes) {
                    store8(_fe_md5b + mb, (v >> (8 * b)) & 0xFF);
                    mb = mb + 1;
                    b = b + 1;
                }
                c = c + 1;
            }
            i = i + 1;
        }
        flac_md5_update(md5, _fe_md5b, mb);

        if (next_pt < npts) {
            if (load64(pts + next_pt * 8) == fi) {
                var e = st + next_pt * 18;
                var off = _fe_pos - first;
                var k = 0;
                while (k < 8) {
                    store8(out_buf + e + k, (s >> (56 - 8 * k)) & 0xFF);
                    store8(out_buf + e + 8 + k, (off >> (56 - 8 * k)) & 0xFF);
                    k = k + 1;
                }
                store8(out_buf + e + 16, (n >> 8) & 0xFF);
                store8(out_buf + e + 17, n & 0xFF);
                next_pt = next_pt + 1;
            }
        }

        var fsz = _fe_frame(_fe_chb, ch, bps, sample_rate, n, fi);
        if (fsz < min_fs) { min_fs = fsz; }
        if (fsz > max_fs) { max_fs = fsz; }
        s = s + n;
        fi = fi + 1;
    }

    # Back-fill the frame sizes and the signature.
    if (max_fs > 0) {
        var fsp = si + 4;
        store8(out_buf + fsp, (min_fs >> 16) & 0xFF);
        store8(out_buf + fsp + 1, (min_fs >> 8) & 0xFF);
        store8(out_buf + fsp + 2, min_fs & 0xFF);
        store8(out_buf + fsp + 3, (max_fs >> 16) & 0xFF);
        store8(out_buf + fsp + 4, (max_fs >> 8) & 0xFF);
        store8(out_buf + fsp + 5, max_fs & 0xFF);
    }
    memcpy(out_buf + md5_at, flac_md5_final(md5), 16);
    return _fe_pos;
}

# Encodes at level 5, `flac`'s default.
fn flac_encode(samples_vec, sample_rate, channels, bits_per_sample, out_buf) {
    return flac_encode_level(samples_vec, sample_rate, channels, bits_per_sample, 5, out_buf);
}

# Encodes one frame of integer samples into out_buf at out_pos with level 5's
# settings. ch_bufs: channel buffer pointers, each holding this_block_size samples.
# Returns bytes written.
fn flac_encode_frame(out_buf, out_pos, ch_bufs, channels, bps, sample_rate, frame_number, this_block_size) {
    _fe_settings(5, bps);
    var cap = _fe_bs;
    if (this_block_size > cap) { cap = this_block_size; }
    _fe_scratch(cap);
    _fe_out = out_buf;
    _fe_pos = out_pos;
    return _fe_frame(ch_bufs, channels, bps, sample_rate, this_block_size, frame_number);
}

# ================================================================
# FLAC module init (call before any encode/decode)
# ================================================================

# Check a FLAC stream against the MD5 of the audio stored in its STREAMINFO.
#
# Returns 0 if the decoded audio matches, 1 if the file stores no signature (an
# all-zero field means the encoder did not compute one), or a negative error if
# the stream will not decode or the audio does not match (ERR_DECODE).
#
# This is separate from flac_decode because hashing costs as much again as the
# decode, and most callers already trust their files.
fn flac_verify(data, len) {
    if (len < 42) { return err(ERR_INVALID_HEADER); }
    if (read_u32_be(data, 0) != 0x664C6143) { return err(ERR_INVALID_HEADER); }   # "fLaC"
    if ((load8(data + 4) & 0x7F) != 0) { return err(ERR_INVALID_HEADER); }        # STREAMINFO first

    # The signature is the last 16 bytes of the 34-byte STREAMINFO body.
    var stored = data + 26;
    var has_sig = 0;
    var i = 0;
    while (i < 16) {
        if (load8(stored + i) != 0) { has_sig = 1; }
        i = i + 1;
    }
    if (has_sig == 0) { return 1; }

    var dr = flac_decode(data, len);
    if (is_err(dr) == 1) { return dr; }
    var samples = decode_result_samples(dr);
    var bps = fmtinfo_bit_depth(decode_result_info(dr));
    var bytes_per = (bps + 7) / 8;
    var count = vec_len(samples);
    if (count > 268435456 / bytes_per) { return err(ERR_DECODE); }

    # flac_decode scaled by a power of two, so scaling back is exact. The hash
    # covers signed little-endian samples in whole bytes.
    var pcm = alloc(count * bytes_per + 1);
    if (pcm == 0) { return err(ERR_DECODE); }
    var scale = f64_from(1 << (bps - 1));
    var pos = 0;
    i = 0;
    while (i < count) {
        var s = f64_to(f64_mul(vec_get(samples, i), scale));
        var b = 0;
        while (b < bytes_per) {
            store8(pcm + pos, (s >> (b * 8)) & 0xFF);
            pos = pos + 1;
            b = b + 1;
        }
        i = i + 1;
    }

    var md5 = flac_md5_compute(pcm, pos);
    i = 0;
    while (i < 16) {
        if (load8(md5 + i) != load8(stored + i)) { return err(ERR_DECODE); }
        i = i + 1;
    }
    return 0;
}

fn flac_init() {
    flac_crc8_init();
    flac_crc16_init();
    flac_md5_init();
    return 0;
}

# ================================================================
# Tests
# ================================================================

fn test_flac_crc() {
    syscall(1, 1, "test: flac crc-8/16\n", 20);

    # CRC-8 of empty = 0
    var empty = alloc(1);
    assert_eq(flac_crc8(empty, 0), 0, "flac crc8 empty");

    # CRC-8 of single zero = 0
    store8(empty, 0);
    assert_eq(flac_crc8(empty, 1), 0, "flac crc8 zero");

    # CRC-8 of "123456789" = 0xF4
    var test9 = alloc(9);
    store8(test9, 0x31); store8(test9 + 1, 0x32); store8(test9 + 2, 0x33);
    store8(test9 + 3, 0x34); store8(test9 + 4, 0x35); store8(test9 + 5, 0x36);
    store8(test9 + 6, 0x37); store8(test9 + 7, 0x38); store8(test9 + 8, 0x39);
    assert_eq(flac_crc8(test9, 9), 0xF4, "flac crc8 123456789");

    # CRC-16 of empty = 0
    assert_eq(flac_crc16(empty, 0), 0, "flac crc16 empty");

    # CRC-16 of single zero = 0
    assert_eq(flac_crc16(empty, 1), 0, "flac crc16 zero");

    # CRC-16 consistency: non-trivial data should give non-zero
    var test_data = alloc(10);
    store8(test_data, 0x68); store8(test_data + 1, 0x65); store8(test_data + 2, 0x6C);
    store8(test_data + 3, 0x6C); store8(test_data + 4, 0x6F); store8(test_data + 5, 0x20);
    store8(test_data + 6, 0x46); store8(test_data + 7, 0x4C); store8(test_data + 8, 0x41);
    store8(test_data + 9, 0x43);
    var crc_val = flac_crc16(test_data, 10);
    assert(crc_val != 0, "flac crc16 non-zero for hello FLAC");

    # Corruption changes CRC
    store8(test_data, load8(test_data) ^ 1);
    var crc_val2 = flac_crc16(test_data, 10);
    assert(crc_val != crc_val2, "flac crc16 changes on corruption");

    return 0;
}

fn test_flac_bitwriter() {
    syscall(1, 1, "test: flac bitwriter\n", 21);

    # Write two full bytes
    var bw = flac_bw_new(16);
    flac_bw_write_bits(bw, 0xFF, 8);
    flac_bw_write_bits(bw, 0xAB, 8);
    var blen = flac_bw_finish(bw);
    assert_eq(blen, 2, "bw two bytes len");
    var buf = flac_bw_buf(bw);
    assert_eq(load8(buf), 0xFF, "bw byte 0");
    assert_eq(load8(buf + 1), 0xAB, "bw byte 1");

    # Write partial nibbles
    var bw2 = flac_bw_new(16);
    flac_bw_write_bits(bw2, 0x0A, 4);
    flac_bw_write_bits(bw2, 0x06, 4);
    var blen2 = flac_bw_finish(bw2);
    assert_eq(blen2, 1, "bw nibbles len");
    assert_eq(load8(flac_bw_buf(bw2)), 0xA6, "bw nibbles val");

    return 0;
}

fn test_flac_zigzag() {
    syscall(1, 1, "test: flac zigzag\n", 18);
    assert_eq(flac_zigzag(0), 0, "zz 0");
    assert_eq(flac_zigzag(1), 2, "zz 1");
    assert_eq(flac_zigzag(0 - 1), 1, "zz -1");
    assert_eq(flac_zigzag(2), 4, "zz 2");
    assert_eq(flac_zigzag(0 - 2), 3, "zz -2");
    return 0;
}

fn test_flac_md5() {
    syscall(1, 1, "test: flac md5\n", 15);

    # MD5 of empty string = d41d8cd98f00b204e9800998ecf8427e
    var md5_empty = flac_md5_compute(alloc(1), 0);
    assert_eq(load8(md5_empty), 0xd4, "md5 empty[0]");
    assert_eq(load8(md5_empty + 1), 0x1d, "md5 empty[1]");
    assert_eq(load8(md5_empty + 2), 0x8c, "md5 empty[2]");
    assert_eq(load8(md5_empty + 3), 0xd9, "md5 empty[3]");
    assert_eq(load8(md5_empty + 15), 0x7e, "md5 empty[15]");

    # MD5 of "abc" = 900150983cd24fb0d6963f7d28e17f72
    var abc = alloc(3);
    store8(abc, 0x61); store8(abc + 1, 0x62); store8(abc + 2, 0x63);
    var md5_abc = flac_md5_compute(abc, 3);
    assert_eq(load8(md5_abc), 0x90, "md5 abc[0]");
    assert_eq(load8(md5_abc + 1), 0x01, "md5 abc[1]");
    assert_eq(load8(md5_abc + 2), 0x50, "md5 abc[2]");
    assert_eq(load8(md5_abc + 15), 0x72, "md5 abc[15]");

    return 0;
}

fn test_flac_utf8_roundtrip() {
    syscall(1, 1, "test: flac utf8 roundtrip\n", 26);

    var test_vals = alloc(9 * 8);
    store64(test_vals, 0);
    store64(test_vals + 8, 1);
    store64(test_vals + 16, 127);
    store64(test_vals + 24, 128);
    store64(test_vals + 32, 255);
    store64(test_vals + 40, 256);
    store64(test_vals + 48, 1000);
    store64(test_vals + 56, 65535);
    store64(test_vals + 64, 100000);

    var ti = 0;
    while (ti < 9) {
        var val = load64(test_vals + ti * 8);
        var bw = flac_bw_new(16);
        flac_bw_write_utf8_u64(bw, val);
        var blen = flac_bw_finish(bw);
        var buf = flac_bw_buf(bw);
        var br = bitreader_new(buf, blen);
        var decoded = flac_br_read_utf8_u64(br);
        assert_eq(decoded, val, "utf8 roundtrip");
        ti = ti + 1;
    }
    return 0;
}

fn test_flac_encode_decode_silence() {
    syscall(1, 1, "test: flac encode/decode silence\n", 33);

    var num_samples = 256;
    var samples = vec_new();
    var i = 0;
    while (i < num_samples) {
        vec_push(samples, F64_ZERO);
        i = i + 1;
    }

    var out_buf = alloc(num_samples * 8 + 4096);
    var bytes_written = flac_encode(samples, 44100, 1, 16, out_buf);
    assert(res_ok(bytes_written) == 1, "flac silence encode ok");
    assert(bytes_written > 0, "flac silence bytes > 0");

    # Check magic
    assert_eq(load8(out_buf), 0x66, "flac magic f");
    assert_eq(load8(out_buf + 1), 0x4C, "flac magic L");
    assert_eq(load8(out_buf + 2), 0x61, "flac magic a");
    assert_eq(load8(out_buf + 3), 0x43, "flac magic C");

    # Decode
    var result = flac_decode(out_buf, bytes_written);
    assert(res_ok(result) == 1, "flac silence decode ok");

    var fi = decode_result_info(result);
    assert_eq(fmtinfo_format(fi), FMT_FLAC, "flac silence format");
    assert_eq(fmtinfo_sample_rate(fi), 44100, "flac silence rate");
    assert_eq(fmtinfo_channels(fi), 1, "flac silence ch");
    assert_eq(fmtinfo_bit_depth(fi), 16, "flac silence bps");

    var dec_samples = decode_result_samples(result);
    assert_eq(vec_len(dec_samples), num_samples, "flac silence sample count");

    # All samples should be ~0 (multiply by 32768, check int is 0)
    var all_zero = 1;
    i = 0;
    while (i < vec_len(dec_samples)) {
        var v = f64_to(f64_mul(vec_get(dec_samples, i), F64_32768));
        if (v > 1) { all_zero = 0; }
        if (v < (0 - 1)) { all_zero = 0; }
        i = i + 1;
    }
    assert_eq(all_zero, 1, "flac silence all zero");

    return 0;
}

fn test_flac_encode_decode_sine() {
    syscall(1, 1, "test: flac encode/decode sine\n", 30);

    # Generate a sine wave using integer approximation
    # sin(x) approx via quadratic: 4x(1-x)/1 for x in [0,1] mapped to [0, pi]
    # We generate 256 samples of a simple pattern instead
    var num_samples = 256;
    var samples = vec_new();
    var i = 0;
    while (i < num_samples) {
        # Triangular wave: goes from 0 to 1 to 0 to -1 to 0
        var phase = (i * 4) % num_samples;
        var quarter = num_samples / 4;
        var val = 0;
        if (phase < quarter) {
            val = f64_div(f64_from(phase), f64_from(quarter));
        } else { if (phase < quarter * 2) {
                val = f64_div(f64_from(quarter * 2 - phase), f64_from(quarter));
            } else { if (phase < quarter * 3) {
                    val = f64_neg(f64_div(f64_from(phase - quarter * 2), f64_from(quarter)));
                } else {
                    val = f64_neg(f64_div(f64_from(num_samples - phase), f64_from(quarter)));
                } } }
        # Scale to 0.9 to avoid clipping edge
        val = f64_mul(val, f64_div(f64_from(9), f64_from(10)));
        vec_push(samples, val);
        i = i + 1;
    }

    var out_buf = alloc(num_samples * 8 + 8192);
    var bytes_written = flac_encode(samples, 44100, 1, 16, out_buf);
    assert(res_ok(bytes_written) == 1, "flac sine encode ok");

    var result = flac_decode(out_buf, bytes_written);
    assert(res_ok(result) == 1, "flac sine decode ok");

    var dec = decode_result_samples(result);
    assert_eq(vec_len(dec), num_samples, "flac sine count");

    # Check roundtrip within 16-bit tolerance
    # Multiply both by 32768, compare integer parts
    var ok = 1;
    i = 0;
    while (i < num_samples) {
        var orig_scaled = f64_to(f64_mul(vec_get(samples, i), F64_32768));
        var dec_scaled = f64_to(f64_mul(vec_get(dec, i), F64_32768));
        var d = orig_scaled - dec_scaled;
        if (d < 0) { d = 0 - d; }
        if (d > 2) { ok = 0; }
        i = i + 1;
    }
    assert_eq(ok, 1, "flac sine roundtrip within tolerance");

    return 0;
}

# flac_verify recomputes the audio's MD5, so these are checked against the stored
# signature. The 8-bit case matters: its samples are one byte, and the sign has to
# survive packing.
fn test_flac_verify() {
    syscall(1, 1, "test: flac md5 verify\n", 22);
    var samples = vec_new();
    for (var i = 0; i < 2048; i = i + 1) {
        vec_push(samples, f64_div(f64_from((i % 200) - 100), f64_from(128)));
    }
    var buf = alloc(262144);

    var n = flac_encode(samples, 44100, 2, 16, buf);
    assert_eq(flac_verify(buf, n), 0, "flac verify 16-bit stereo");
    n = flac_encode(samples, 48000, 1, 24, buf);
    assert_eq(flac_verify(buf, n), 0, "flac verify 24-bit mono");
    n = flac_encode(samples, 22050, 1, 8, buf);
    assert_eq(flac_verify(buf, n), 0, "flac verify 8-bit mono");

    # A wrong signature is an error, not a pass.
    var kept = load8(buf + 30);
    store8(buf + 30, kept ^ 0xFF);
    var bad = flac_verify(buf, n);
    assert(is_err(bad) == 1, "flac verify rejects a wrong signature");
    assert_eq(bad, err(ERR_DECODE), "flac verify mismatch is ERR_DECODE");
    store8(buf + 30, kept);

    # An all-zero signature means none was stored.
    for (var z = 0; z < 16; z = z + 1) { store8(buf + 26 + z, 0); }
    assert_eq(flac_verify(buf, n), 1, "flac verify reports no signature");

    assert(is_err(flac_verify(buf, 10)) == 1, "flac verify rejects a short buffer");
    store8(buf, 0);
    assert(is_err(flac_verify(buf, n)) == 1, "flac verify rejects bad magic");
    return 0;
}

fn test_flac_encode_decode_stereo() {
    syscall(1, 1, "test: flac encode/decode stereo\n", 32);

    var num_frames = 128;
    var samples = vec_new();
    var i = 0;
    while (i < num_frames) {
        # Left: ramp up
        var left = f64_div(f64_from(i), f64_from(num_frames));
        left = f64_sub(f64_mul(left, F64_TWO), F64_ONE);
        left = f64_mul(left, f64_div(f64_from(9), f64_from(10)));
        # Right: ramp down
        var right = f64_div(f64_from(num_frames - 1 - i), f64_from(num_frames));
        right = f64_sub(f64_mul(right, F64_TWO), F64_ONE);
        right = f64_mul(right, f64_div(f64_from(9), f64_from(10)));
        vec_push(samples, left);
        vec_push(samples, right);
        i = i + 1;
    }

    var out_buf = alloc(num_frames * 16 + 8192);
    var bytes_written = flac_encode(samples, 44100, 2, 16, out_buf);
    assert(res_ok(bytes_written) == 1, "flac stereo encode ok");

    var result = flac_decode(out_buf, bytes_written);
    assert(res_ok(result) == 1, "flac stereo decode ok");

    var fi = decode_result_info(result);
    assert_eq(fmtinfo_channels(fi), 2, "flac stereo channels");

    var dec = decode_result_samples(result);
    assert_eq(vec_len(dec), num_frames * 2, "flac stereo count");

    return 0;
}

fn test_flac_encode_decode_8bit() {
    syscall(1, 1, "test: flac encode/decode 8-bit\n", 31);

    var num_samples = 64;
    var samples = vec_new();
    var i = 0;
    while (i < num_samples) {
        var val = f64_sub(f64_div(f64_from(i), f64_from(32)), F64_ONE);
        vec_push(samples, val);
        i = i + 1;
    }

    var out_buf = alloc(num_samples * 4 + 4096);
    var bytes_written = flac_encode(samples, 44100, 1, 8, out_buf);
    assert(res_ok(bytes_written) == 1, "flac 8bit encode ok");

    var result = flac_decode(out_buf, bytes_written);
    assert(res_ok(result) == 1, "flac 8bit decode ok");

    var fi = decode_result_info(result);
    assert_eq(fmtinfo_bit_depth(fi), 8, "flac 8bit depth");

    return 0;
}

fn test_flac_encode_decode_24bit() {
    syscall(1, 1, "test: flac encode/decode 24-bit\n", 32);

    var num_samples = 64;
    var samples = vec_new();
    var i = 0;
    while (i < num_samples) {
        var val = f64_sub(f64_div(f64_from(i), f64_from(32)), F64_ONE);
        val = f64_mul(val, f64_div(f64_from(9), f64_from(10)));
        vec_push(samples, val);
        i = i + 1;
    }

    var out_buf = alloc(num_samples * 12 + 8192);
    var bytes_written = flac_encode(samples, 48000, 1, 24, out_buf);
    assert(res_ok(bytes_written) == 1, "flac 24bit encode ok");

    var result = flac_decode(out_buf, bytes_written);
    assert(res_ok(result) == 1, "flac 24bit decode ok");

    var fi = decode_result_info(result);
    assert_eq(fmtinfo_bit_depth(fi), 24, "flac 24bit depth");
    assert_eq(fmtinfo_sample_rate(fi), 48000, "flac 24bit rate");

    return 0;
}

fn test_flac_reject_invalid() {
    syscall(1, 1, "test: flac reject invalid\n", 26);

    # Not FLAC data
    var bad = alloc(12);
    store8(bad, 0x52); store8(bad + 1, 0x49); store8(bad + 2, 0x46); store8(bad + 3, 0x46);
    assert(is_err(flac_decode(bad, 12)) == 1, "flac rejects non-flac");

    # Too short
    var short = alloc(3);
    store8(short, 0x66); store8(short + 1, 0x4C); store8(short + 2, 0x61);
    assert(is_err(flac_decode(short, 3)) == 1, "flac rejects too short");

    # Encoder rejects bad params
    var empty = vec_new();
    var tmp = alloc(1024);
    assert(is_err(flac_encode(empty, 44100, 0, 16, tmp)) == 1, "flac encode 0 ch");
    assert(is_err(flac_encode(empty, 0, 1, 16, tmp)) == 1, "flac encode 0 rate");
    assert(is_err(flac_encode(empty, 44100, 1, 0, tmp)) == 1, "flac encode 0 bps");
    assert(is_err(flac_encode(empty, 44100, 1, 33, tmp)) == 1, "flac encode 33 bps");

    return 0;
}

fn test_flac_block_size_codes() {
    syscall(1, 1, "test: flac block size codes\n", 28);

    var tb = alloc(8);
    var tv = alloc(8);
    assert_eq(flac_block_size_code(192, tb, tv), 1, "bs 192");
    assert_eq(flac_block_size_code(4096, tb, tv), 12, "bs 4096");
    assert_eq(flac_block_size_code(100, tb, tv), 6, "bs 100 -> code 6");
    assert_eq(load64(tb), 8, "bs 100 tail_bits 8");
    assert_eq(load64(tv), 99, "bs 100 tail_val 99");

    return 0;
}

# ---------------------------------------------------------------- encoder tests

# A deterministic test signal on the integer grid at bps bits, so a lossless
# round trip must return every value exactly. kind: 0 sine + noise, 1 full-scale
# noise, 2 alternating extremes, 3 noise at 12 bits shifted to the container's
# top (wasted bits), 4 constant, 5 noise whose level jumps 256-fold halfway
# through every 4096 samples.
fn _flac_t_signal(frames, ch, bps, kind) {
    var v = vec_new();
    var hi = (1 << (bps - 1)) - 1;
    var lo = 0 - (1 << (bps - 1));
    var scale = f64_from(1 << (bps - 1));
    var seed = 0x2545F4914F6CDD1D;
    var w = f64_div(f64_mul(F64_TWO, F64_PI), f64_from(97));
    var i = 0;
    while (i < frames) {
        var c = 0;
        while (c < ch) {
            seed = seed * 6364136223846793005 + 1442695040888963407;
            var rnd = (seed >> 11) & 0xFFFFFFFF;
            var s = 0;
            if (kind == 0) {
                var a = f64_mul(f64_from(hi / 2), f64_sin(f64_mul(w, f64_from(i * (c + 1)))));
                s = f64_to(f64_round(a)) + ((rnd & 255) - 128) * (hi / 32768 + 1) / 8;
            }
            if (kind == 1) { s = lo + (rnd % (hi - lo + 1)); }
            if (kind == 2) {
                s = lo;
                if (((i + c) & 1) == 1) { s = hi; }
            }
            if (kind == 3) { s = ((rnd & 4095) - 2048) << (bps - 12); }
            if (kind == 4) { s = hi / 3; }
            if (kind == 5) {
                s = (rnd & 31) - 16;
                if ((i & 4095) >= 2048) { s = (rnd & 8191) - 4096; }
            }
            if (s > hi) { s = hi; }
            if (s < lo) { s = lo; }
            vec_push(v, f64_div(f64_from(s), scale));
            c = c + 1;
        }
        i = i + 1;
    }
    return v;
}

# Offset of the first frame: past "fLaC" and every metadata block.
fn _flac_t_frames_at(buf, len) {
    var pos = 4;
    while (pos + 4 <= len) {
        var hdr = load8(buf + pos);
        pos = pos + 4 + ((load8(buf + pos + 1) << 16) | (load8(buf + pos + 2) << 8) | load8(buf + pos + 3));
        if ((hdr & 0x80) != 0) { return pos; }
    }
    return pos;
}

# 1 when the stream decodes to exactly the samples in v.
fn _flac_t_exact(buf, len, v) {
    var r = flac_decode(buf, len);
    if (is_err(r) == 1) { return 0; }
    var d = decode_result_samples(r);
    if (vec_len(d) != vec_len(v)) { return 0; }
    var i = 0;
    while (i < vec_len(v)) {
        if (vec_get(d, i) != vec_get(v, i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Every level from flac -0 to flac -8 is lossless and carries a signature that
# matches what it decodes to.
fn test_flac_encode_levels() {
    syscall(1, 1, "test: flac encoder levels 0-8\n", 30);
    var v = _flac_t_signal(10000, 2, 16, 0);
    var buf = alloc(flac_encode_bound(10000, 2, 16));
    var sizes = alloc(9 * 8);
    var level = 0;
    while (level <= 8) {
        var n = flac_encode_level(v, 44100, 2, 16, level, buf);
        assert(res_ok(n) == 1, "level encodes");
        store64(sizes + level * 8, n);
        assert_eq(_flac_t_exact(buf, n, v), 1, "level decodes exactly");
        assert_eq(flac_verify(buf, n), 0, "level signature matches");
        level = level + 1;
    }
    # LPC (level 3 up) beats fixed prediction (levels 0-2) on a tone.
    assert(load64(sizes + 5 * 8) < load64(sizes), "level 5 smaller than level 0");
    assert(load64(sizes + 8 * 8) < load64(sizes + 2 * 8), "level 8 smaller than level 2");
    return 0;
}

fn test_flac_encode_edges() {
    syscall(1, 1, "test: flac encoder edge cases\n", 30);
    var empty = vec_new();
    var tmp = alloc(256);
    assert(is_err(flac_encode(empty, 44100, 9, 16, tmp)) == 1, "9 channels refused");
    assert(is_err(flac_encode(empty, 44100, 1, 3, tmp)) == 1, "3 bits refused");
    assert(is_err(flac_encode(empty, 1048576, 1, 16, tmp)) == 1, "rate past 20 bits refused");
    assert(is_err(flac_encode_level(empty, 44100, 1, 16, 9, tmp)) == 1, "level 9 refused");
    assert(is_err(flac_encode_level(empty, 44100, 1, 16, 0 - 1, tmp)) == 1, "level -1 refused");

    # No samples: STREAMINFO alone, marked last.
    assert_eq(flac_encode(empty, 44100, 2, 16, tmp), 42, "empty stream is 42 bytes");
    assert_eq(load8(tmp + 4), 0x80, "empty stream: STREAMINFO is the last block");

    # Fewer samples than a block: STREAMINFO still says the configured block
    # size (RFC 9639 wants at least 16; ffmpeg refuses less).
    var k = 0;
    while (k < 3) {
        var n = 1;
        if (k == 1) { n = 5; }
        if (k == 2) { n = 15; }
        var v = _flac_t_signal(n, 2, 16, 0);
        var buf = alloc(flac_encode_bound(n, 2, 16));
        var len = flac_encode(v, 44100, 2, 16, buf);
        assert_eq((load8(buf + 10) << 8) | load8(buf + 11), 4096, "short stream: max block size");
        assert_eq(_flac_t_exact(buf, len, v), 1, "short stream decodes exactly");
        k = k + 1;
    }

    # 32 bits at alternating extremes: the side channel needs 33 bits and every
    # predictor's residual leaves the 32-bit range, so verbatim must take over.
    var x = _flac_t_signal(5000, 2, 32, 2);
    var xb = alloc(flac_encode_bound(5000, 2, 32));
    var xn = flac_encode_level(x, 44100, 2, 32, 8, xb);
    assert_eq(_flac_t_exact(xb, xn, x), 1, "32-bit extremes decode exactly");

    # 12-bit noise in a 24-bit container: incompressible except for the 12
    # wasted bits, so only wasted-bit removal brings it under 12 bits a sample.
    var wv = _flac_t_signal(5000, 2, 24, 3);
    var wb = alloc(flac_encode_bound(5000, 2, 24));
    var wn = flac_encode(wv, 48000, 2, 24, wb);
    assert_eq(_flac_t_exact(wb, wn, wv), 1, "wasted bits decode exactly");
    assert(wn < 5000 * 2 * 12 / 8 + 1024, "wasted bits removed");

    # A constant signal costs a few bytes a frame.
    var cv = _flac_t_signal(10000, 2, 16, 4);
    var cb = alloc(flac_encode_bound(10000, 2, 16));
    var cn = flac_encode(cv, 44100, 2, 16, cb);
    assert_eq(_flac_t_exact(cb, cn, cv), 1, "constant decodes exactly");
    assert(cn < 200, "constant subframes");

    # Eight channels at 20 bits.
    var mv = _flac_t_signal(3000, 8, 20, 0);
    var mb = alloc(flac_encode_bound(3000, 8, 20));
    var mn = flac_encode(mv, 192000, 8, 20, mb);
    assert_eq(_flac_t_exact(mb, mn, mv), 1, "8 channels at 20 bits decode exactly");

    # Incompressible input stays inside flac_encode_bound.
    var nv = _flac_t_signal(2000, 8, 32, 1);
    var nbound = flac_encode_bound(2000, 8, 32);
    var nb = alloc(nbound);
    var nn = flac_encode_level(nv, 96000, 8, 32, 8, nb);
    assert(nn <= nbound, "full-scale noise within flac_encode_bound");
    assert_eq(_flac_t_exact(nb, nn, nv), 1, "full-scale noise decodes exactly");

    # Rice partitions: noise that is quiet for half of each block and 256 times
    # louder for the rest. One parameter for the whole block spends the loud
    # half's 13 bits on every quiet sample (about 13.3 bits a sample); two
    # partitions spend about 9.6.
    var pv = _flac_t_signal(8192, 1, 16, 5);
    var pb = alloc(flac_encode_bound(8192, 1, 16));
    var pn = flac_encode(pv, 44100, 1, 16, pb);
    assert_eq(_flac_t_exact(pb, pn, pv), 1, "partitioned residual decodes exactly");
    assert(pn < 8192 * 11 / 8, "rice partitions follow the residual's level");

    # Incremental MD5 over uneven pieces equals the one-shot digest.
    var msg = alloc(300);
    var i = 0;
    while (i < 300) {
        store8(msg + i, (i * 37 + 11) & 0xFF);
        i = i + 1;
    }
    var one = flac_md5_compute(msg, 300);
    var ctx = flac_md5_new();
    flac_md5_update(ctx, msg, 1);
    flac_md5_update(ctx, msg + 1, 63);
    flac_md5_update(ctx, msg + 64, 72);
    flac_md5_update(ctx, msg + 136, 164);
    var two = flac_md5_final(ctx);
    var same = 1;
    i = 0;
    while (i < 16) {
        if (load8(one + i) != load8(two + i)) { same = 0; }
        i = i + 1;
    }
    assert_eq(same, 1, "md5 in pieces equals one-shot");
    return 0;
}

# A seek point every 10 seconds, at the frame holding it, as `flac` writes them.
fn test_flac_encode_seektable() {
    syscall(1, 1, "test: flac encoder seek table\n", 30);
    var n = 200000;
    var v = _flac_t_signal(n, 1, 16, 0);
    var buf = alloc(flac_encode_bound(n, 1, 16));
    var len = flac_encode_level(v, 8000, 1, 16, 0, buf);
    assert_eq(load8(buf + 4), 0, "STREAMINFO is not the last block");
    var st = 4 + 4 + 34;
    assert_eq(load8(buf + st), 0x83, "SEEKTABLE follows, last");
    assert_eq((load8(buf + st + 2) << 8) | load8(buf + st + 3), 3 * 18, "three seek points");
    var first = _flac_t_frames_at(buf, len);
    var want = alloc(3 * 8);
    store64(want, 0);
    store64(want + 8, (80000 / 1152) * 1152);
    store64(want + 16, (160000 / 1152) * 1152);
    var p = 0;
    while (p < 3) {
        var e = buf + st + 4 + p * 18;
        assert_eq(_flac_read_u64_be(e, 0), load64(want + p * 8), "seek point sample");
        var off = _flac_read_u64_be(e, 8);
        assert_eq(load8(buf + first + off), 0xFF, "seek point offset lands on a frame");
        assert_eq(load8(buf + first + off + 1), 0xF8, "seek point offset lands on a frame");
        assert_eq((load8(e + 16) << 8) | load8(e + 17), 1152, "seek point frame samples");
        p = p + 1;
    }
    # A range decode through the table matches the whole decode.
    var r = flac_decode_range(buf, len, 100000, 1000);
    assert(res_ok(r) == 1, "range decode");
    if (res_ok(r) == 1) {
        var d = decode_result_samples(r);
        assert_eq(vec_len(d), 1000, "range decode length");
        var same = 1;
        var i = 0;
        while (i < 1000) {
            if (vec_get(d, i) != vec_get(v, 100000 + i)) { same = 0; }
            i = i + 1;
        }
        assert_eq(same, 1, "range decode matches the input");
    }
    return 0;
}

# A residual section whose first partition is smaller than the predictor order:
# block 4096, LPC order 12, partition order 9 (eight samples a partition).
# Until 2.10.0 the first partition's negative count was skipped and the other
# 511 were read, 4088 residuals into the 4084 the buffer holds. Also a block
# that 2^order does not divide. Both are refused, as libFLAC refuses them.
fn test_flac_residual_partition_bounds() {
    syscall(1, 1, "test: flac residual partition bounds\n", 37);
    var bw = flac_bw_new(4096);
    flac_bw_write_bits(bw, 0, 2);       # RICE, 4-bit parameters
    flac_bw_write_bits(bw, 9, 4);       # partition order 9
    # Laid out as the old reader read it: partition 0 is its parameter alone (its
    # count was negative), then 511 partitions of a parameter and eight zeros.
    flac_bw_write_bits(bw, 0, 4);
    var p = 1;
    while (p < 512) {
        flac_bw_write_bits(bw, 0, 4);   # parameter 0
        var k = 0;
        while (k < 8) {
            flac_bw_write_bit(bw, 1);   # residual 0
            k = k + 1;
        }
        p = p + 1;
    }
    var len = flac_bw_finish(bw);
    var res = alloc((4084 + 4) * 8);
    memset(res, 0, 4084 * 8);
    var i = 0;
    while (i < 4) {
        store64(res + (4084 + i) * 8, 0x5A5A5A5A5A5A5A5A);
        i = i + 1;
    }
    var br = bitreader_new(flac_bw_buf(bw), len);
    assert_eq(flac_decode_residual(br, res, 4096, 12), err(ERR_DECODE), "first partition below the predictor order refused");
    var intact = 1;
    i = 0;
    while (i < 4) {
        if (load64(res + (4084 + i) * 8) != 0x5A5A5A5A5A5A5A5A) { intact = 0; }
        i = i + 1;
    }
    assert_eq(intact, 1, "nothing written past the residual buffer");

    var bw2 = flac_bw_new(64);
    flac_bw_write_bits(bw2, 0, 2);
    flac_bw_write_bits(bw2, 1, 4);      # partition order 1 over an odd block
    flac_bw_write_bits(bw2, 0, 32);
    var len2 = flac_bw_finish(bw2);
    var res2 = alloc(4095 * 8);
    var br2 = bitreader_new(flac_bw_buf(bw2), len2);
    assert_eq(flac_decode_residual(br2, res2, 4095, 2), err(ERR_DECODE), "partitions that do not divide the block refused");
    return 0;
}

# --- ogg.cyr ---

# ================================================================
# ogg.cyr — Ogg container parser and muxer
# ================================================================
#
# Parses Ogg pages, extracts packets, builds pages, muxes packets.
# CRC-32 with polynomial 0x04C11DB7 (direct, no reflection).
#
# Requires: alloc, vec, string, assert helpers from main.cyr

# ================================================================
# CRC-32 table (polynomial 0x04C11DB7, init 0, no reflection)
# ================================================================

var ogg_crc32_table = 0;

fn ogg_init() {
    ogg_crc32_table = alloc(256 * 8);
    var i = 0;
    while (i < 256) {
        var crc = (i << 24) & 0xFFFFFFFF;
        var bit = 0;
        while (bit < 8) {
            if ((crc & 0x80000000) != 0) {
                crc = ((crc << 1) ^ 0x04C11DB7) & 0xFFFFFFFF;
            } else {
                crc = (crc << 1) & 0xFFFFFFFF;
            }
            bit = bit + 1;
        }
        store64(ogg_crc32_table + i * 8, crc & 0xFFFFFFFF);
        i = i + 1;
    }
    return 0;
}

# Compute CRC-32 over a raw byte buffer
fn ogg_crc32(data, len) {
    if (ogg_crc32_table == 0) { ogg_init(); }
    var crc = 0;
    var i = 0;
    while (i < len) {
        var idx = ((crc >> 24) ^ load8(data + i)) & 0xFF;
        crc = ((crc << 8) ^ load64(ogg_crc32_table + idx * 8)) & 0xFFFFFFFF;
        i = i + 1;
    }
    return crc;
}

# Compute CRC-32 over a page, treating bytes 22..25 (CRC field) as zero
fn ogg_crc32_page(data, len) {
    if (ogg_crc32_table == 0) { ogg_init(); }
    var crc = 0;
    var i = 0;
    while (i < len) {
        var byte = load8(data + i);
        if (i >= 22) {
            if (i <= 25) {
                byte = 0;
            }
        }
        var idx = ((crc >> 24) ^ byte) & 0xFF;
        crc = ((crc << 8) ^ load64(ogg_crc32_table + idx * 8)) & 0xFFFFFFFF;
        i = i + 1;
    }
    return crc;
}

# ================================================================
# Read helpers (little-endian i64 for granule position)
# ================================================================

fn ogg_read_i64_le(data, off) {
    var lo = read_u32_le(data, off);
    var hi = read_u32_le(data, off + 4);
    return lo | (hi << 32);
}

fn ogg_write_i64_le(buf, off, val) {
    write_u32_le(buf, off, val & 0xFFFFFFFF);
    write_u32_le(buf, off + 4, (val >> 32) & 0xFFFFFFFF);
    return 0;
}

# ================================================================
# OggPage — heap-allocated struct
# ================================================================
# Layout (40 bytes + segment table buffer + body buffer):
#   +0:  header_type     (i64)
#   +8:  granule_position (i64)
#   +16: serial           (i64)
#   +24: page_seq         (i64)
#   +32: num_segments     (i64)
#   +40: segments_ptr     (pointer to byte buffer)
#   +48: body_ptr         (pointer to byte buffer)
#   +56: body_size        (i64)

fn ogg_page_new() {
    var p = alloc(64);
    memset(p, 0, 64);
    return p;
}

fn ogg_page_header_type(p)  { return load64(p); }
fn ogg_page_granule(p)      { return load64(p + 8); }
fn ogg_page_serial(p)       { return load64(p + 16); }
fn ogg_page_seq(p)          { return load64(p + 24); }
fn ogg_page_num_segments(p) { return load64(p + 32); }
fn ogg_page_segments(p)     { return load64(p + 40); }
fn ogg_page_body(p)         { return load64(p + 48); }
fn ogg_page_body_size(p)    { return load64(p + 56); }

# ================================================================
# Page parsing
# ================================================================

# Parse a single Ogg page starting at data[pos].
# Returns page pointer on success, or err() on failure.
# Also stores the end offset at *out_end.
fn ogg_parse_page(data, len, pos, out_end) {
    # Minimum page header: 27 bytes
    if (pos + 27 > len) { return err(ERR_END_OF_STREAM); }

    # Check "OggS" magic
    if (load8(data + pos) != 0x4F)     { return err(ERR_INVALID_HEADER); }
    if (load8(data + pos + 1) != 0x67) { return err(ERR_INVALID_HEADER); }
    if (load8(data + pos + 2) != 0x67) { return err(ERR_INVALID_HEADER); }
    if (load8(data + pos + 3) != 0x53) { return err(ERR_INVALID_HEADER); }

    # Version must be 0
    var version = load8(data + pos + 4);
    if (version != 0) { return err(ERR_INVALID_HEADER); }

    var header_type = load8(data + pos + 5);
    var granule = ogg_read_i64_le(data, pos + 6);
    var serial = read_u32_le(data, pos + 14);
    var page_seq = read_u32_le(data, pos + 18);
    var expected_crc = read_u32_le(data, pos + 22);
    var num_segments = load8(data + pos + 26);

    var seg_table_start = pos + 27;
    if (seg_table_start + num_segments > len) { return err(ERR_END_OF_STREAM); }

    # Copy segment table
    var segments = alloc(num_segments + 1);
    var body_size = 0;
    var si = 0;
    while (si < num_segments) {
        var lv = load8(data + seg_table_start + si);
        store8(segments + si, lv);
        body_size = body_size + lv;
        si = si + 1;
    }

    var body_start = seg_table_start + num_segments;
    if (body_start + body_size > len) { return err(ERR_END_OF_STREAM); }

    # Copy body
    var body = alloc(body_size + 1);
    memcpy(body, data + body_start, body_size);

    # CRC verification
    var page_end = body_start + body_size;
    var computed_crc = ogg_crc32_page(data + pos, page_end - pos);
    if (computed_crc != (expected_crc & 0xFFFFFFFF)) {
        return err(ERR_DECODE);
    }

    # Build page struct
    var page = ogg_page_new();
    store64(page,      header_type);
    store64(page + 8,  granule);
    store64(page + 16, serial);
    store64(page + 24, page_seq);
    store64(page + 32, num_segments);
    store64(page + 40, segments);
    store64(page + 48, body);
    store64(page + 56, body_size);

    store64(out_end, page_end);
    return page;
}

# Parse all pages from data, returns vec of page pointers
fn ogg_parse_pages(data, len) {
    var pages = vec_new();
    var pos = 0;
    var end_buf = alloc(8);

    while (pos + 4 <= len) {
        # Check for OggS magic
        if (load8(data + pos) != 0x4F) { break; }
        if (load8(data + pos + 1) != 0x67) { break; }
        if (load8(data + pos + 2) != 0x67) { break; }
        if (load8(data + pos + 3) != 0x53) { break; }

        var page = ogg_parse_page(data, len, pos, end_buf);
        if (is_err(page) == 1) { return page; }
        vec_push(pages, page);
        pos = load64(end_buf);
    }

    return pages;
}

# ================================================================
# Packet extraction
# ================================================================

# Extract logical packets from Ogg pages.
# Returns a vec of vecs (each inner vec holds raw byte pointers + lengths).
# Actually: returns a vec of Str objects (data+len pairs).
fn ogg_extract_packets(data, len) {
    var pages_result = ogg_parse_pages(data, len);
    if (is_err(pages_result) == 1) { return pages_result; }
    var pages = pages_result;

    var packets = vec_new();

    # Current packet accumulator: use a builder approach
    var cur_buf = alloc(65536);
    var cur_len = 0;
    var cur_cap = 65536;

    var pi = 0;
    var num_pages = vec_len(pages);

    # SEC-032: confine reassembly to ONE logical bitstream.
    #
    # An Ogg physical stream may carry several logical streams, distinguished
    # by the 32-bit serial number in each page header — either multiplexed, or
    # chained end-to-end, which is exactly what `cat a.opus b.opus` produces and
    # is legal per RFC 7845 Sec. 3. The serial was never consulted, so pages from
    # different streams were spliced into one packet sequence and handed to the
    # decoder as though they belonged together.
    #
    # Latch the serial from the FIRST page rather than from a BOS flag: a
    # truncated or headerless capture may have no BOS at all, and an attacker
    # controls the flag byte either way.
    var stream_serial = 0;
    var have_serial = 0;

    while (pi < num_pages) {
        var page = vec_get(pages, pi);
        var ht = ogg_page_header_type(page);

        var pserial = ogg_page_serial(page);
        if (have_serial == 0) {
            stream_serial = pserial;
            have_serial = 1;
        }
        if (pserial != stream_serial) {
            # A different logical stream: stop here. Any partially accumulated
            # packet belongs to the stream we were following, so flush it below
            # rather than letting it absorb foreign bytes.
            pi = num_pages;
            continue;
        }

        # If NOT a continuation page and we have accumulated data, flush it
        if ((ht & 0x01) == 0) {
            if (cur_len > 0) {
                var pkt = alloc(cur_len);
                memcpy(pkt, cur_buf, cur_len);
                vec_push(packets, str_new(pkt, cur_len));
                cur_len = 0;
            }
        }

        var segments = ogg_page_segments(page);
        var nseg = ogg_page_num_segments(page);
        var body = ogg_page_body(page);
        var body_offset = 0;

        var sj = 0;
        while (sj < nseg) {
            var lacing_value = load8(segments + sj);

            if (body_offset + lacing_value > ogg_page_body_size(page)) {
                return err(ERR_DECODE);
            }

            # Ensure capacity (with overflow guard on accumulated length)
            if (cur_len + lacing_value < cur_len) { return err(ERR_DECODE); }
            if (cur_len + lacing_value > 16777216) { return err(ERR_DECODE); }
            if (cur_len + lacing_value > cur_cap) {
                var new_cap = cur_cap * 2;
                if (new_cap < cur_len + lacing_value) {
                    new_cap = cur_len + lacing_value + 65536;
                }
                var new_buf = alloc(new_cap);
                memcpy(new_buf, cur_buf, cur_len);
                cur_buf = new_buf;
                cur_cap = new_cap;
            }

            memcpy(cur_buf + cur_len, body + body_offset, lacing_value);
            cur_len = cur_len + lacing_value;
            body_offset = body_offset + lacing_value;

            if (lacing_value < 255) {
                # Packet boundary. SEC-019: only emit a packet with content.
                # A lacing value of 0 legitimately terminates a packet whose
                # length is a multiple of 255 (cur_len > 0 there), but a 0 with
                # nothing accumulated denotes a zero-length packet, which no
                # audio codec can use. Emitting them let a page carrying 255
                # zero lacing values in 282 bytes mint 255 packets, each costing
                # an alloc + str_new + vec slot: ~43 bytes of heap per input
                # byte, measured, and alloc() never frees. Skipping them costs
                # nothing real and bounds the amplification.
                if (cur_len > 0) {
                    var pkt = alloc(cur_len + 1);
                    memcpy(pkt, cur_buf, cur_len);
                    vec_push(packets, str_new(pkt, cur_len));
                    cur_len = 0;
                }
            }

            sj = sj + 1;
        }

        pi = pi + 1;
    }

    # Flush remaining data
    if (cur_len > 0) {
        var pkt = alloc(cur_len);
        memcpy(pkt, cur_buf, cur_len);
        vec_push(packets, str_new(pkt, cur_len));
    }

    return packets;
}

# ================================================================
# Page building / muxing
# ================================================================

# Header type flags
var OGG_FLAG_CONTINUATION = 0x01;
var OGG_FLAG_BOS          = 0x02;
var OGG_FLAG_EOS          = 0x04;

# Build a single Ogg page from a payload buffer.
# Returns a Str (pointer + length) for the page bytes.
fn ogg_build_page(header_type, granule, serial, page_seq, payload, payload_len) {
    # Compute lacing values
    var segments = alloc(256);
    var num_segments = 0;
    var remaining = payload_len;

    while (remaining >= 255) {
        store8(segments + num_segments, 255);
        num_segments = num_segments + 1;
        remaining = remaining - 255;
        if (num_segments >= 255) { break; }
    }
    if (num_segments < 255) {
        store8(segments + num_segments, remaining);
        num_segments = num_segments + 1;
    }

    # Clamp to 255 segments max
    if (num_segments > 255) { num_segments = 255; }

    # Calculate actual payload covered
    var actual_payload = 0;
    var si = 0;
    while (si < num_segments) {
        actual_payload = actual_payload + load8(segments + si);
        si = si + 1;
    }

    var page_size = 27 + num_segments + actual_payload;
    var page = alloc(page_size);
    memset(page, 0, page_size);

    # Capture pattern: "OggS"
    store8(page, 0x4F);
    store8(page + 1, 0x67);
    store8(page + 2, 0x67);
    store8(page + 3, 0x53);

    # Version
    store8(page + 4, 0);

    # Header type
    store8(page + 5, header_type);

    # Granule position (i64 LE)
    ogg_write_i64_le(page, 6, granule);

    # Serial number (u32 LE)
    write_u32_le(page, 14, serial);

    # Page sequence number (u32 LE)
    write_u32_le(page, 18, page_seq);

    # CRC placeholder (zeroed)
    write_u32_le(page, 22, 0);

    # Number of segments
    store8(page + 26, num_segments);

    # Segment table
    var ti = 0;
    while (ti < num_segments) {
        store8(page + 27 + ti, load8(segments + ti));
        ti = ti + 1;
    }

    # Body
    memcpy(page + 27 + num_segments, payload, actual_payload);

    # Compute and fill CRC
    var crc = ogg_crc32_page(page, page_size);
    write_u32_le(page, 22, crc);

    return str_new(page, page_size);
}

# Mux packets into a complete Ogg bitstream.
# packets: vec of Str (data+len), granules: pointer to i64 array,
# serial: serial number, num_packets: count
# Returns a Str (data+len) for the whole bitstream.
fn ogg_mux_packets(packets, granules, serial, num_packets) {
    # First pass: compute total output size (upper bound)
    var total = 0;
    var mi = 0;
    while (mi < num_packets) {
        var pkt = vec_get(packets, mi);
        var plen = str_len(pkt);
        # page overhead: 27 + ceil(plen/255) + 1
        total = total + 27 + (plen / 255) + 1 + plen + 256;
        mi = mi + 1;
    }

    var out = alloc(total);
    var out_pos = 0;

    mi = 0;
    while (mi < num_packets) {
        var pkt = vec_get(packets, mi);
        var pdata = str_data(pkt);
        var plen = str_len(pkt);
        var granule = load64(granules + mi * 8);

        var flags = 0;
        if (mi == 0) {
            flags = flags | OGG_FLAG_BOS;
        }
        if (mi == num_packets - 1) {
            flags = flags | OGG_FLAG_EOS;
        }

        var page_str = ogg_build_page(flags, granule, serial, mi, pdata, plen);
        var page_data = str_data(page_str);
        var page_len = str_len(page_str);

        memcpy(out + out_pos, page_data, page_len);
        out_pos = out_pos + page_len;

        mi = mi + 1;
    }

    return str_new(out, out_pos);
}

# ================================================================
# ogg_decode — extract packets and dispatch to codec
# ================================================================

fn ogg_decode(data, len) {
    # Lazy-init the CRC table so consumers that call decode_file() without running
    # the full init sequence don't dereference a null table in ogg_crc32_page.
    if (ogg_crc32_table == 0) { ogg_init(); }
    var packets = ogg_extract_packets(data, len);
    if (is_err(packets) == 1) { return packets; }
    if (vec_len(packets) == 0) { return err(ERR_END_OF_STREAM); }

    # Check first packet for OpusHead and delegate
    var pkt0 = vec_get(packets, 0);
    var pkt0_data = str_data(pkt0);
    var pkt0_len = str_len(pkt0);
    if (pkt0_len >= 8) {
        if (load8(pkt0_data) == 0x4F) {
            if (load8(pkt0_data + 1) == 0x70) {
                if (load8(pkt0_data + 2) == 0x75) {
                    if (load8(pkt0_data + 3) == 0x73) {
                        if (load8(pkt0_data + 4) == 0x48) {
                            if (load8(pkt0_data + 5) == 0x65) {
                                if (load8(pkt0_data + 6) == 0x61) {
                                    if (load8(pkt0_data + 7) == 0x64) {
                                        return opus_decode_from_packets(packets, data, len);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    return err(ERR_UNSUPPORTED_FMT);
}

# ================================================================
# Tests
# ================================================================

# Helper: build a test Ogg page with given params (raw bytes)
fn _test_build_ogg_page(header_type, granule, serial, page_seq, lacing, num_lacing, body, body_len) {
    var page_size = 27 + num_lacing + body_len;
    var page = alloc(page_size);
    memset(page, 0, page_size);

    # OggS
    store8(page, 0x4F);
    store8(page + 1, 0x67);
    store8(page + 2, 0x67);
    store8(page + 3, 0x53);
    # Version 0
    store8(page + 4, 0);
    # Header type
    store8(page + 5, header_type);
    # Granule
    ogg_write_i64_le(page, 6, granule);
    # Serial
    write_u32_le(page, 14, serial);
    # Page seq
    write_u32_le(page, 18, page_seq);
    # CRC placeholder
    write_u32_le(page, 22, 0);
    # Num segments
    store8(page + 26, num_lacing);
    # Segment table
    var li = 0;
    while (li < num_lacing) {
        store8(page + 27 + li, load8(lacing + li));
        li = li + 1;
    }
    # Body
    memcpy(page + 27 + num_lacing, body, body_len);

    # Compute and fill CRC
    var crc = ogg_crc32_page(page, page_size);
    write_u32_le(page, 22, crc);

    return str_new(page, page_size);
}

fn test_ogg_crc32_known_vectors() {
    test_group("ogg: crc32 known vectors");

    # CRC of empty data should be 0
    var empty = alloc(1);
    assert_eq(ogg_crc32(empty, 0), 0, "crc32 empty is 0");

    # CRC of "OggS" should be deterministic and non-zero
    var oggs = alloc(4);
    store8(oggs, 0x4F); store8(oggs+1, 0x67); store8(oggs+2, 0x67); store8(oggs+3, 0x53);
    var crc1 = ogg_crc32(oggs, 4);
    var crc2 = ogg_crc32(oggs, 4);
    assert_eq(crc1, crc2, "crc32 deterministic");
    assert_neq(crc1, 0, "crc32 OggS non-zero");

    # CRC of single zero byte
    var z = alloc(1);
    store8(z, 0);
    var crc3 = ogg_crc32(z, 1);
    assert_eq(crc3, ogg_crc32(z, 1), "crc32 single zero deterministic");

    return 0;
}

fn test_ogg_page_parse_roundtrip() {
    test_group("ogg: page parse roundtrip");

    # Build a page via the build function
    var payload = alloc(15);
    memcpy(payload, "hello_ogg_muxer", 15);

    var page_str = ogg_build_page(OGG_FLAG_BOS, 0, 42, 0, payload, 15);
    var page_data = str_data(page_str);
    var page_len = str_len(page_str);

    # Parse it back
    var end_buf = alloc(8);
    var page = ogg_parse_page(page_data, page_len, 0, end_buf);
    assert(res_ok(page) == 1, "parse built page ok");

    var end = load64(end_buf);
    assert_eq(end, page_len, "parse consumed all bytes");
    assert_eq(ogg_page_header_type(page), OGG_FLAG_BOS, "header type BOS");
    assert_eq(ogg_page_granule(page), 0, "granule 0");
    assert_eq(ogg_page_serial(page), 42, "serial 42");
    assert_eq(ogg_page_seq(page), 0, "page_seq 0");
    assert_eq(ogg_page_body_size(page), 15, "body size 15");

    # Verify body content
    var body = ogg_page_body(page);
    assert(memeq(body, "hello_ogg_muxer", 15) == 1, "body matches");

    return 0;
}

fn test_ogg_reject_invalid_magic() {
    test_group("ogg: reject invalid magic");
    var bad = alloc(32);
    memcpy(bad, "NotOggData1234567890123456789012", 31);
    var end_buf = alloc(8);
    var result = ogg_parse_page(bad, 32, 0, end_buf);
    assert(is_err(result) == 1, "reject bad magic");
    return 0;
}

fn test_ogg_reject_short_data() {
    test_group("ogg: reject short data");
    var short = alloc(4);
    store8(short, 0x4F); store8(short+1, 0x67); store8(short+2, 0x67); store8(short+3, 0x53);
    var end_buf = alloc(8);
    var result = ogg_parse_page(short, 4, 0, end_buf);
    assert(is_err(result) == 1, "reject short data");
    return 0;
}

fn test_ogg_extract_single_packet() {
    test_group("ogg: extract single packet");

    var body = alloc(11);
    memcpy(body, "packet_data", 11);
    var lacing = alloc(1);
    store8(lacing, 11);
    var page_str = _test_build_ogg_page(0x02, 100, 1, 0, lacing, 1, body, 11);
    var pd = str_data(page_str);
    var pl = str_len(page_str);

    var packets = ogg_extract_packets(pd, pl);
    assert(res_ok(packets) == 1, "extract ok");
    assert_eq(vec_len(packets), 1, "1 packet");

    var pkt0 = vec_get(packets, 0);
    assert_eq(str_len(pkt0), 11, "packet len 11");
    assert(memeq(str_data(pkt0), "packet_data", 11) == 1, "packet content");

    return 0;
}

fn test_ogg_extract_multi_packet() {
    test_group("ogg: extract multi packets in one page");

    # Two packets: "aaa" (3 bytes) and "bb" (2 bytes)
    var body = alloc(5);
    memcpy(body, "aaabb", 5);
    var lacing = alloc(2);
    store8(lacing, 3);
    store8(lacing + 1, 2);
    var page_str = _test_build_ogg_page(0x02, 100, 1, 0, lacing, 2, body, 5);
    var pd = str_data(page_str);
    var pl = str_len(page_str);

    var packets = ogg_extract_packets(pd, pl);
    assert(res_ok(packets) == 1, "multi extract ok");
    assert_eq(vec_len(packets), 2, "2 packets");

    var p0 = vec_get(packets, 0);
    assert_eq(str_len(p0), 3, "pkt0 len 3");
    assert(memeq(str_data(p0), "aaa", 3) == 1, "pkt0 = aaa");

    var p1 = vec_get(packets, 1);
    assert_eq(str_len(p1), 2, "pkt1 len 2");
    assert(memeq(str_data(p1), "bb", 2) == 1, "pkt1 = bb");

    return 0;
}

fn test_ogg_continuation_pages() {
    test_group("ogg: continuation across pages");

    # Page 1: 255 bytes of 0xAA, lacing [255] (continued)
    var body1 = alloc(255);
    memset(body1, 0xAA, 255);
    var lacing1 = alloc(1);
    store8(lacing1, 255);
    var p1_str = _test_build_ogg_page(0x02, 0, 1, 0, lacing1, 1, body1, 255);

    # Page 2: 10 bytes of 0xBB, continuation flag 0x01, lacing [10]
    var body2 = alloc(10);
    memset(body2, 0xBB, 10);
    var lacing2 = alloc(1);
    store8(lacing2, 10);
    var p2_str = _test_build_ogg_page(0x01, 100, 1, 1, lacing2, 1, body2, 10);

    # Concatenate pages
    var total_len = str_len(p1_str) + str_len(p2_str);
    var combined = alloc(total_len);
    memcpy(combined, str_data(p1_str), str_len(p1_str));
    memcpy(combined + str_len(p1_str), str_data(p2_str), str_len(p2_str));

    var packets = ogg_extract_packets(combined, total_len);
    assert(res_ok(packets) == 1, "continuation extract ok");
    assert_eq(vec_len(packets), 1, "1 continued packet");

    var pkt = vec_get(packets, 0);
    assert_eq(str_len(pkt), 265, "continued packet len 265");

    # Check first 255 bytes are 0xAA
    var pdata = str_data(pkt);
    var all_aa = 1;
    var ci = 0;
    while (ci < 255) {
        if (load8(pdata + ci) != 0xAA) { all_aa = 0; }
        ci = ci + 1;
    }
    assert(all_aa == 1, "first 255 bytes 0xAA");

    # Check last 10 bytes are 0xBB
    var all_bb = 1;
    ci = 255;
    while (ci < 265) {
        if (load8(pdata + ci) != 0xBB) { all_bb = 0; }
        ci = ci + 1;
    }
    assert(all_bb == 1, "last 10 bytes 0xBB");

    return 0;
}

fn test_ogg_large_packet_lacing() {
    test_group("ogg: large packet lacing roundtrip");

    # A 600-byte packet
    var big = alloc(600);
    memset(big, 0xAA, 600);

    var packets = vec_new();
    vec_push(packets, str_new(big, 600));

    var granules = alloc(8);
    store64(granules, 0);

    var stream = ogg_mux_packets(packets, granules, 1, 1);
    var extracted = ogg_extract_packets(str_data(stream), str_len(stream));
    assert(res_ok(extracted) == 1, "large packet extract ok");
    assert_eq(vec_len(extracted), 1, "1 large packet");

    var pkt = vec_get(extracted, 0);
    assert_eq(str_len(pkt), 600, "large packet len 600");
    assert(memeq(str_data(pkt), big, 600) == 1, "large packet content matches");

    return 0;
}

fn test_ogg_mux_roundtrip() {
    test_group("ogg: mux/demux roundtrip");

    var packets = vec_new();
    var p1 = alloc(12); memcpy(p1, "first_packet", 12);
    var p2 = alloc(13); memcpy(p2, "second_packet", 13);
    var p3 = alloc(12); memcpy(p3, "third_packet", 12);
    vec_push(packets, str_new(p1, 12));
    vec_push(packets, str_new(p2, 13));
    vec_push(packets, str_new(p3, 12));

    var granules = alloc(24);
    store64(granules, 0);
    store64(granules + 8, 960);
    store64(granules + 16, 1920);

    var stream = ogg_mux_packets(packets, granules, 1, 3);
    var extracted = ogg_extract_packets(str_data(stream), str_len(stream));
    assert(res_ok(extracted) == 1, "mux roundtrip extract ok");
    assert_eq(vec_len(extracted), 3, "3 packets");

    var e0 = vec_get(extracted, 0);
    assert_eq(str_len(e0), 12, "pkt0 len");
    assert(memeq(str_data(e0), "first_packet", 12) == 1, "pkt0 content");

    var e1 = vec_get(extracted, 1);
    assert_eq(str_len(e1), 13, "pkt1 len");
    assert(memeq(str_data(e1), "second_packet", 13) == 1, "pkt1 content");

    var e2 = vec_get(extracted, 2);
    assert_eq(str_len(e2), 12, "pkt2 len");
    assert(memeq(str_data(e2), "third_packet", 12) == 1, "pkt2 content");

    return 0;
}

fn test_ogg_mux_single_has_bos_eos() {
    test_group("ogg: single packet BOS+EOS");

    var packets = vec_new();
    var p1 = alloc(11); memcpy(p1, "only_packet", 11);
    vec_push(packets, str_new(p1, 11));

    var granules = alloc(8);
    store64(granules, 0);

    var stream = ogg_mux_packets(packets, granules, 1, 1);

    # Parse the single page and check flags
    var end_buf = alloc(8);
    var page = ogg_parse_page(str_data(stream), str_len(stream), 0, end_buf);
    assert(res_ok(page) == 1, "single page parse ok");

    var ht = ogg_page_header_type(page);
    assert_neq(ht & OGG_FLAG_BOS, 0, "has BOS");
    assert_neq(ht & OGG_FLAG_EOS, 0, "has EOS");

    return 0;
}

fn test_ogg_crc_mismatch() {
    test_group("ogg: CRC mismatch detection");

    var body = alloc(5);
    memcpy(body, "hello", 5);
    var lacing = alloc(1);
    store8(lacing, 5);
    var page_str = _test_build_ogg_page(0x02, 0, 1, 0, lacing, 1, body, 5);
    var pd = str_data(page_str);
    var pl = str_len(page_str);

    # Corrupt last byte
    store8(pd + pl - 1, load8(pd + pl - 1) ^ 0xFF);

    var end_buf = alloc(8);
    var result = ogg_parse_page(pd, pl, 0, end_buf);
    assert(is_err(result) == 1, "CRC mismatch detected");

    return 0;
}

fn test_ogg_multiple_pages() {
    test_group("ogg: multiple pages");

    var body1 = alloc(3); memcpy(body1, "abc", 3);
    var lacing1 = alloc(1); store8(lacing1, 3);
    var p1_str = _test_build_ogg_page(0x02, 0, 1, 0, lacing1, 1, body1, 3);

    var body2 = alloc(2); memcpy(body2, "de", 2);
    var lacing2 = alloc(1); store8(lacing2, 2);
    var p2_str = _test_build_ogg_page(0x00, 100, 1, 1, lacing2, 1, body2, 2);

    var total_len = str_len(p1_str) + str_len(p2_str);
    var combined = alloc(total_len);
    memcpy(combined, str_data(p1_str), str_len(p1_str));
    memcpy(combined + str_len(p1_str), str_data(p2_str), str_len(p2_str));

    var packets = ogg_extract_packets(combined, total_len);
    assert(res_ok(packets) == 1, "multi page extract ok");
    assert_eq(vec_len(packets), 2, "2 packets from 2 pages");

    var pk0 = vec_get(packets, 0);
    assert_eq(str_len(pk0), 3, "pkt0 len 3");
    assert(memeq(str_data(pk0), "abc", 3) == 1, "pkt0 = abc");

    var pk1 = vec_get(packets, 1);
    assert_eq(str_len(pk1), 2, "pkt1 len 2");
    assert(memeq(str_data(pk1), "de", 2) == 1, "pkt1 = de");

    return 0;
}

fn test_ogg_decode_unsupported() {
    test_group("ogg: decode returns unsupported");

    var body = alloc(8);
    memcpy(body, "NotOpus!", 8);
    var lacing = alloc(1);
    store8(lacing, 8);
    var page_str = _test_build_ogg_page(0x02, 0, 1, 0, lacing, 1, body, 8);

    var result = ogg_decode(str_data(page_str), str_len(page_str));
    assert(is_err(result) == 1, "ogg_decode unsupported codec");

    return 0;
}

# --- mp3.cyr ---

# ================================================================
# mp3.cyr — MP3 frame header parser (no audio decoding)
# ================================================================
#
# Parses MPEG audio frame headers: sync word detection, version/layer/
# bitrate/sample-rate extraction, ID3v2 tag skipping, frame scanning.
# Does NOT produce decoded audio samples.
#
# Requires: alloc, vec, string, assert helpers from main.cyr

# ================================================================
# Bitrate and sample rate tables (initialized in mp3_init)
# ================================================================

var mp3_bitrate_v1_l3 = 0;    # 16 entries
var mp3_bitrate_v2_l3 = 0;    # 16 entries (also V2/V2.5 Layer II)
var mp3_bitrate_v1_l1 = 0;    # 16 entries
var mp3_bitrate_v1_l2 = 0;    # 16 entries
var mp3_bitrate_v2_l1 = 0;    # 16 entries
var mp3_sr_v1  = 0;            # 3 entries
var mp3_sr_v2  = 0;            # 3 entries
var mp3_sr_v25 = 0;            # 3 entries

fn mp3_init() {
    # V1 Layer III bitrates (kbps): 0,32,40,48,56,64,80,96,112,128,160,192,224,256,320,0
    mp3_bitrate_v1_l3 = alloc(16 * 8);
    store64(mp3_bitrate_v1_l3 + 0 * 8, 0);
    store64(mp3_bitrate_v1_l3 + 1 * 8, 32);
    store64(mp3_bitrate_v1_l3 + 2 * 8, 40);
    store64(mp3_bitrate_v1_l3 + 3 * 8, 48);
    store64(mp3_bitrate_v1_l3 + 4 * 8, 56);
    store64(mp3_bitrate_v1_l3 + 5 * 8, 64);
    store64(mp3_bitrate_v1_l3 + 6 * 8, 80);
    store64(mp3_bitrate_v1_l3 + 7 * 8, 96);
    store64(mp3_bitrate_v1_l3 + 8 * 8, 112);
    store64(mp3_bitrate_v1_l3 + 9 * 8, 128);
    store64(mp3_bitrate_v1_l3 + 10 * 8, 160);
    store64(mp3_bitrate_v1_l3 + 11 * 8, 192);
    store64(mp3_bitrate_v1_l3 + 12 * 8, 224);
    store64(mp3_bitrate_v1_l3 + 13 * 8, 256);
    store64(mp3_bitrate_v1_l3 + 14 * 8, 320);
    store64(mp3_bitrate_v1_l3 + 15 * 8, 0);

    # V2/V2.5 Layer III bitrates (kbps): 0,8,16,24,32,40,48,56,64,80,96,112,128,144,160,0
    mp3_bitrate_v2_l3 = alloc(16 * 8);
    store64(mp3_bitrate_v2_l3 + 0 * 8, 0);
    store64(mp3_bitrate_v2_l3 + 1 * 8, 8);
    store64(mp3_bitrate_v2_l3 + 2 * 8, 16);
    store64(mp3_bitrate_v2_l3 + 3 * 8, 24);
    store64(mp3_bitrate_v2_l3 + 4 * 8, 32);
    store64(mp3_bitrate_v2_l3 + 5 * 8, 40);
    store64(mp3_bitrate_v2_l3 + 6 * 8, 48);
    store64(mp3_bitrate_v2_l3 + 7 * 8, 56);
    store64(mp3_bitrate_v2_l3 + 8 * 8, 64);
    store64(mp3_bitrate_v2_l3 + 9 * 8, 80);
    store64(mp3_bitrate_v2_l3 + 10 * 8, 96);
    store64(mp3_bitrate_v2_l3 + 11 * 8, 112);
    store64(mp3_bitrate_v2_l3 + 12 * 8, 128);
    store64(mp3_bitrate_v2_l3 + 13 * 8, 144);
    store64(mp3_bitrate_v2_l3 + 14 * 8, 160);
    store64(mp3_bitrate_v2_l3 + 15 * 8, 0);

    # MPEG1 Layer I bitrate table (kbps): {free,32,64,96,...,448,bad}
    mp3_bitrate_v1_l1 = alloc(16 * 8);
    store64(mp3_bitrate_v1_l1 + 0 * 8, 0);   store64(mp3_bitrate_v1_l1 + 1 * 8, 32);
    store64(mp3_bitrate_v1_l1 + 2 * 8, 64);  store64(mp3_bitrate_v1_l1 + 3 * 8, 96);
    store64(mp3_bitrate_v1_l1 + 4 * 8, 128); store64(mp3_bitrate_v1_l1 + 5 * 8, 160);
    store64(mp3_bitrate_v1_l1 + 6 * 8, 192); store64(mp3_bitrate_v1_l1 + 7 * 8, 224);
    store64(mp3_bitrate_v1_l1 + 8 * 8, 256); store64(mp3_bitrate_v1_l1 + 9 * 8, 288);
    store64(mp3_bitrate_v1_l1 + 10 * 8, 320); store64(mp3_bitrate_v1_l1 + 11 * 8, 352);
    store64(mp3_bitrate_v1_l1 + 12 * 8, 384); store64(mp3_bitrate_v1_l1 + 13 * 8, 416);
    store64(mp3_bitrate_v1_l1 + 14 * 8, 448); store64(mp3_bitrate_v1_l1 + 15 * 8, 0);

    # MPEG1 Layer II bitrate table (kbps)
    mp3_bitrate_v1_l2 = alloc(16 * 8);
    store64(mp3_bitrate_v1_l2 + 0 * 8, 0);   store64(mp3_bitrate_v1_l2 + 1 * 8, 32);
    store64(mp3_bitrate_v1_l2 + 2 * 8, 48);  store64(mp3_bitrate_v1_l2 + 3 * 8, 56);
    store64(mp3_bitrate_v1_l2 + 4 * 8, 64);  store64(mp3_bitrate_v1_l2 + 5 * 8, 80);
    store64(mp3_bitrate_v1_l2 + 6 * 8, 96);  store64(mp3_bitrate_v1_l2 + 7 * 8, 112);
    store64(mp3_bitrate_v1_l2 + 8 * 8, 128); store64(mp3_bitrate_v1_l2 + 9 * 8, 160);
    store64(mp3_bitrate_v1_l2 + 10 * 8, 192); store64(mp3_bitrate_v1_l2 + 11 * 8, 224);
    store64(mp3_bitrate_v1_l2 + 12 * 8, 256); store64(mp3_bitrate_v1_l2 + 13 * 8, 320);
    store64(mp3_bitrate_v1_l2 + 14 * 8, 384); store64(mp3_bitrate_v1_l2 + 15 * 8, 0);

    # MPEG2/2.5 Layer I bitrate table (kbps)
    mp3_bitrate_v2_l1 = alloc(16 * 8);
    store64(mp3_bitrate_v2_l1 + 0 * 8, 0);   store64(mp3_bitrate_v2_l1 + 1 * 8, 32);
    store64(mp3_bitrate_v2_l1 + 2 * 8, 48);  store64(mp3_bitrate_v2_l1 + 3 * 8, 56);
    store64(mp3_bitrate_v2_l1 + 4 * 8, 64);  store64(mp3_bitrate_v2_l1 + 5 * 8, 80);
    store64(mp3_bitrate_v2_l1 + 6 * 8, 96);  store64(mp3_bitrate_v2_l1 + 7 * 8, 112);
    store64(mp3_bitrate_v2_l1 + 8 * 8, 128); store64(mp3_bitrate_v2_l1 + 9 * 8, 144);
    store64(mp3_bitrate_v2_l1 + 10 * 8, 160); store64(mp3_bitrate_v2_l1 + 11 * 8, 176);
    store64(mp3_bitrate_v2_l1 + 12 * 8, 192); store64(mp3_bitrate_v2_l1 + 13 * 8, 224);
    store64(mp3_bitrate_v2_l1 + 14 * 8, 256); store64(mp3_bitrate_v2_l1 + 15 * 8, 0);

    # MPEG1 sample rates: 44100, 48000, 32000
    mp3_sr_v1 = alloc(3 * 8);
    store64(mp3_sr_v1 + 0 * 8, 44100);
    store64(mp3_sr_v1 + 1 * 8, 48000);
    store64(mp3_sr_v1 + 2 * 8, 32000);

    # MPEG2 sample rates: 22050, 24000, 16000
    mp3_sr_v2 = alloc(3 * 8);
    store64(mp3_sr_v2 + 0 * 8, 22050);
    store64(mp3_sr_v2 + 1 * 8, 24000);
    store64(mp3_sr_v2 + 2 * 8, 16000);

    # MPEG2.5 sample rates: 11025, 12000, 8000
    mp3_sr_v25 = alloc(3 * 8);
    store64(mp3_sr_v25 + 0 * 8, 11025);
    store64(mp3_sr_v25 + 1 * 8, 12000);
    store64(mp3_sr_v25 + 2 * 8, 8000);

    return 0;
}

# ================================================================
# MPEG version/layer/channel mode integer enums
# ================================================================

var MP3_VERSION_V1  = 1;
var MP3_VERSION_V2  = 2;
var MP3_VERSION_V25 = 3;

var MP3_LAYER_I   = 1;
var MP3_LAYER_II  = 2;
var MP3_LAYER_III = 3;

var MP3_CHANNEL_STEREO       = 0;
var MP3_CHANNEL_JOINT_STEREO = 1;
var MP3_CHANNEL_DUAL         = 2;
var MP3_CHANNEL_MONO         = 3;

# ================================================================
# MP3 frame info struct (heap-allocated)
# ================================================================
# Layout (72 bytes):
#   +0:  version          (i64)
#   +8:  layer            (i64)
#   +16: bitrate          (i64, kbps)
#   +24: sample_rate      (i64, Hz)
#   +32: channel_mode     (i64)
#   +40: frame_size       (i64, bytes)
#   +48: samples_per_frame (i64)
#   +56: padding          (i64, 0 or 1)

fn mp3_frame_new() {
    var f = alloc(64);
    memset(f, 0, 64);
    return f;
}

fn mp3_frame_version(f)        { return load64(f); }
fn mp3_frame_layer(f)          { return load64(f + 8); }
fn mp3_frame_bitrate(f)        { return load64(f + 16); }
fn mp3_frame_sample_rate(f)    { return load64(f + 24); }
fn mp3_frame_channel_mode(f)   { return load64(f + 32); }
fn mp3_frame_size(f)           { return load64(f + 40); }
fn mp3_frame_samples_per_frame(f) { return load64(f + 48); }
fn mp3_frame_padding(f)        { return load64(f + 56); }

# ================================================================
# Syncsafe integer (4 bytes, 7 bits each)
# ================================================================

fn mp3_syncsafe_to_u32(data, off) {
    return ((load8(data + off) & 0x7F) << 21)
    | ((load8(data + off + 1) & 0x7F) << 14)
    | ((load8(data + off + 2) & 0x7F) << 7)
    | (load8(data + off + 3) & 0x7F);
}

# ================================================================
# ID3v2 tag skip
# ================================================================

fn mp3_id3v2_skip(data, len) {
    if (len < 10) { return 0; }
    # Check for "ID3"
    if (load8(data) != 0x49)     { return 0; }
    if (load8(data + 1) != 0x44) { return 0; }
    if (load8(data + 2) != 0x33) { return 0; }
    var size = mp3_syncsafe_to_u32(data, 6);
    return 10 + size;
}

# ================================================================
# Frame header parsing
# ================================================================

# Parse a 4-byte MPEG audio frame header at data[off].
# Returns heap-allocated frame info, or err() on invalid.
var _mp3_free_bytes = 0;    # free-format frame length without padding, once learnt

# minimp3 hdr_compare: same version and layer, same sample rate, both free format
# or both not.
fn _mp3_hdr_match(data, a, b) {
    if (((load8(data + a + 1) ^ load8(data + b + 1)) & 0xFE) != 0) { return 0; }
    if (((load8(data + a + 2) ^ load8(data + b + 2)) & 0x0C) != 0) { return 0; }
    var fa = 0;
    if ((load8(data + a + 2) >> 4) == 0) { fa = 1; }
    var fb = 0;
    if ((load8(data + b + 2) >> 4) == 0) { fb = 1; }
    if (fa != fb) { return 0; }
    return 1;
}

# Learn the free-format frame length at `pos`: the first later sync whose header
# matches, confirmed by a third matching header one frame further on (or the end
# of the data). Returns 1 if learnt.
fn _mp3_learn_free(data, len, pos) {
    var layer1 = 0;
    if (((load8(data + pos + 1) >> 1) & 3) == 3) { layer1 = 1; }
    var pad0 = (load8(data + pos + 2) >> 1) & 1;
    if (layer1 == 1) { pad0 = pad0 * 4; }
    var q = pos + 4;
    var lim = pos + 4096;
    if (lim > len - 4) { lim = len - 4; }
    while (q < lim) {
        if (load8(data + q) == 0xFF) {
            if ((load8(data + q + 1) & 0xE0) == 0xE0) {
                if (_mp3_hdr_match(data, pos, q) == 1) {
                    var fb = q - pos - pad0;
                    var pad1 = (load8(data + q + 2) >> 1) & 1;
                    if (layer1 == 1) { pad1 = pad1 * 4; }
                    var r = q + fb + pad1;
                    var ok = 0;
                    if (r + 4 > len) { ok = 1; }
                    else {
                        if (load8(data + r) == 0xFF) { if (_mp3_hdr_match(data, pos, r) == 1) { ok = 1; } }
                    }
                    if ((ok == 1) & (fb > 0)) { _mp3_free_bytes = fb; return 1; }
                }
            }
        }
        q = q + 1;
    }
    return 0;
}

# A Xing/Info (LAME) or VBRI tag in a Layer III frame: an index for seeking, not
# audio. Decoders skip the frame (minimp3, mpg123, ffmpeg).
fn _mp3_is_info_frame(data, pos, fs) {
    var b1 = load8(data + pos + 1);
    var mpeg1 = 0;
    if (((b1 >> 3) & 3) == 3) { mpeg1 = 1; }
    var mono = 0;
    if (((load8(data + pos + 3) >> 6) & 3) == 3) { mono = 1; }
    var si = 17;
    if (mpeg1 == 1) { si = 32; if (mono == 1) { si = 17; } }
    else { if (mono == 1) { si = 9; } }
    # Right after the side information. LAME writes it there even in a frame whose
    # header announces a CRC (lame -p), and that is where ffmpeg looks; until 2.10.2
    # shravan looked 2 bytes on, missed the tag and decoded the frame as 1152 samples
    # of audio. After the CRC is tried as well.
    var off = pos + 4 + si;
    var tries = 1;
    if ((b1 & 1) == 0) { tries = 2; }
    var k = 0;
    while (k < tries) {
        var o = off + k * 2;
        if (o + 4 <= pos + fs) {
            var t0 = load8(data + o); var t1 = load8(data + o + 1);
            var t2 = load8(data + o + 2); var t3 = load8(data + o + 3);
            if ((t0 == 0x58) & (t1 == 0x69) & (t2 == 0x6E) & (t3 == 0x67)) { return 1; }   # Xing
            if ((t0 == 0x49) & (t1 == 0x6E) & (t2 == 0x66) & (t3 == 0x6F)) { return 1; }   # Info
        }
        k = k + 1;
    }
    if (pos + 36 + 4 <= pos + fs) {
        if ((load8(data + pos + 36) == 0x56) & (load8(data + pos + 37) == 0x42) & (load8(data + pos + 38) == 0x52) & (load8(data + pos + 39) == 0x49)) { return 1; }  # VBRI
    }
    return 0;
}

# Gapless playback from a LAME/Xing tag, as ffmpeg reads it (libavformat/mp3dec.c).
# The tag sits where the side information would, at an offset ffmpeg takes from
# the version and channel mode alone, and from the encoder string's "LAME",
# "Lavf" or "Lavc" on it carries the encoder's delay and padding in 12 bits each.
# The decoder's own delay is 529 samples (the 528-sample synthesis lag plus one),
# so of the frames' samples, [delay + 529, frames * spf - padding + 529) is the
# audio, frames being the tag's count (not counting the tag's frame). Without a
# count only the start is trimmed; samples past frames * spf (a longer file than
# the tag says) are kept, as ffmpeg keeps them. -1 when there is no such tag.
var _mp3_gl_start = 0 - 1;
var _mp3_gl_first = 0 - 1;    # first discarded sample at the end, or -1
var _mp3_gl_last = 0 - 1;     # one past the last discarded

fn _mp3_lame_gapless(data, len, pos, fs, info) {
    _mp3_gl_start = 0 - 1;
    _mp3_gl_first = 0 - 1;
    _mp3_gl_last = 0 - 1;
    var end = pos + fs;
    if (end > len) { end = len; }
    var b1 = load8(data + pos + 1);
    var lsf = 1;
    if (((b1 >> 3) & 3) == 3) { lsf = 0; }
    var mono = 0;
    if (((load8(data + pos + 3) >> 6) & 3) == 3) { mono = 1; }
    var off = 32;
    if (lsf == 0 && mono == 1) { off = 17; }
    if (lsf == 1 && mono == 0) { off = 17; }
    if (lsf == 1 && mono == 1) { off = 9; }
    var x = pos + 4 + off;
    if (x + 8 > end) { return 0; }
    var tag = read_u32_be(data, x);
    if (tag != 0x58696E67 && tag != 0x496E666F) { return 0; }   # "Xing", "Info"
    var flags = read_u32_be(data, x + 4);
    var q = x + 8;
    var frames = 0;
    var bytes = 0;
    if ((flags & 1) != 0) {
        if (q + 4 > end) { return 0; }
        frames = read_u32_be(data, q);
        q = q + 4;
    }
    if ((flags & 2) != 0) {
        if (q + 4 > end) { return 0; }
        bytes = read_u32_be(data, q);
        q = q + 4;
    }
    if ((flags & 4) != 0) { q = q + 100; }
    if ((flags & 8) != 0) { q = q + 4; }
    # version string (9), revision, lowpass, peak (4), two gains (2 + 2), flags,
    # bitrate: the delay and padding follow, 21 bytes in
    if (q + 24 > end) { return 0; }
    var enc = read_u32_be(data, q);
    if (enc != 0x4C414D45 && enc != 0x4C617666 && enc != 0x4C617663) { return 0; }   # LAME Lavf Lavc
    var v = (load8(data + q + 21) << 16) | (load8(data + q + 22) << 8) | load8(data + q + 23);
    var delay = v >> 12;
    var padding = v & 4095;
    # A file well past the size the tag records is a concatenation: its frame count
    # is not the file's, so ffmpeg drops it and trims only the start.
    if (bytes > 0) {
        var fsz = len - (pos + 4);
        if (fsz > bytes && fsz - bytes > bytes / 16) { frames = 0; }
    }
    var spf = mp3_frame_samples_per_frame(info);
    _mp3_gl_start = delay + 529;
    if (frames > 0) {
        _mp3_gl_first = frames * spf - padding + 529;
        _mp3_gl_last = frames * spf;
    }
    return 1;
}

# The samples a LAME/Xing tag marks as audio, out of `samples` (out_ch channels).
fn _mp3_apply_gapless(samples, out_ch) {
    if (_shravan_gapless == 0 || _mp3_gl_start < 0) { return samples; }
    var frames = vec_len(samples) / out_ch;
    var a = _mp3_gl_start;
    var b = frames;
    if (_mp3_gl_first >= 0 && _mp3_gl_first < b) { b = _mp3_gl_first; }
    if (b < a) { b = a; }
    var tail = 0;
    if (_mp3_gl_last >= 0 && frames > _mp3_gl_last && _mp3_gl_first < _mp3_gl_last) { tail = frames - _mp3_gl_last; }
    if (tail == 0) {
        _vec_keep_frames(samples, out_ch, a, b - a);
        return samples;
    }
    # samples past the tag's count stay, after the trimmed range
    var keep = b - a;
    if (a > frames) { keep = 0; }
    var out = _vec_new_cap((keep + tail) * out_ch);
    if (is_err(out) == 1) { return out; }
    var i = 0;
    while (i < keep * out_ch) { vec_push(out, vec_get(samples, a * out_ch + i)); i = i + 1; }
    i = 0;
    while (i < tail * out_ch) { vec_push(out, vec_get(samples, _mp3_gl_last * out_ch + i)); i = i + 1; }
    return out;
}

fn mp3_parse_frame_header(data, off) {
    # Sync word: first 11 bits must be 1
    if (load8(data + off) != 0xFF) { return err(ERR_INVALID_HEADER); }
    var b1 = load8(data + off + 1);
    if ((b1 & 0xE0) != 0xE0) { return err(ERR_INVALID_HEADER); }

    # Version: bits 4-3 of byte 1
    var version_bits = (b1 >> 3) & 0x03;
    var version = 0;
    if (version_bits == 0) { version = MP3_VERSION_V25; }
    if (version_bits == 2) { version = MP3_VERSION_V2; }
    if (version_bits == 3) { version = MP3_VERSION_V1; }
    if (version_bits == 1) { return err(ERR_INVALID_HEADER); }  # reserved
    if (version == 0)      { return err(ERR_INVALID_HEADER); }

    # Layer: bits 2-1 of byte 1
    var layer_bits = (b1 >> 1) & 0x03;
    var layer = 0;
    if (layer_bits == 1) { layer = MP3_LAYER_III; }
    if (layer_bits == 2) { layer = MP3_LAYER_II; }
    if (layer_bits == 3) { layer = MP3_LAYER_I; }
    if (layer_bits == 0) { return err(ERR_INVALID_HEADER); }  # reserved
    if (layer == 0)      { return err(ERR_INVALID_HEADER); }

    # Bitrate: bits 7-4 of byte 2
    var b2 = load8(data + off + 2);
    var bitrate_index = (b2 >> 4) & 0x0F;

    # Each MPEG version + layer has its OWN bitrate table (Layer I and II differ from
    # Layer III — the old code used the Layer III table for all layers, giving wrong
    # frame sizes / durations / frame scanning for Layer I/II).
    var bitrate = 0;
    if (version == MP3_VERSION_V1) {
        if (layer == MP3_LAYER_I)   { bitrate = load64(mp3_bitrate_v1_l1 + bitrate_index * 8); }
        if (layer == MP3_LAYER_II)  { bitrate = load64(mp3_bitrate_v1_l2 + bitrate_index * 8); }
        if (layer == MP3_LAYER_III) { bitrate = load64(mp3_bitrate_v1_l3 + bitrate_index * 8); }
    } else {
        # MPEG2 / MPEG2.5 — Layer II and III share a table (mp3_bitrate_v2_l3).
        if (layer == MP3_LAYER_I)   { bitrate = load64(mp3_bitrate_v2_l1 + bitrate_index * 8); }
        if (layer == MP3_LAYER_II)  { bitrate = load64(mp3_bitrate_v2_l3 + bitrate_index * 8); }
        if (layer == MP3_LAYER_III) { bitrate = load64(mp3_bitrate_v2_l3 + bitrate_index * 8); }
    }
    # Free format (bitrate index 0): the frame length is fixed for the stream but not
    # in the header. The decoder learns it (_mp3_free_bytes, padding excluded) from
    # the distance to the next frame; until then the header is not usable.
    var free_fmt = 0;
    if (bitrate_index == 0) {
        if (_mp3_free_bytes <= 0) { return err(ERR_INVALID_HEADER); }
        free_fmt = 1;
    } else {
        if (bitrate == 0) { return err(ERR_INVALID_HEADER); }
    }

    # Sample rate: bits 3-2 of byte 2
    var sr_index = (b2 >> 2) & 0x03;
    if (sr_index >= 3) { return err(ERR_INVALID_HEADER); }

    var sample_rate = 0;
    if (version == MP3_VERSION_V1) {
        sample_rate = load64(mp3_sr_v1 + sr_index * 8);
    }
    if (version == MP3_VERSION_V2) {
        sample_rate = load64(mp3_sr_v2 + sr_index * 8);
    }
    if (version == MP3_VERSION_V25) {
        sample_rate = load64(mp3_sr_v25 + sr_index * 8);
    }

    # Padding: bit 1 of byte 2
    var padding = (b2 >> 1) & 0x01;

    # Channel mode: bits 7-6 of byte 3
    var b3 = load8(data + off + 3);
    var channel_mode = (b3 >> 6) & 0x03;

    # Samples per frame
    var samples_per_frame = 0;
    if (version == MP3_VERSION_V1) {
        if (layer == MP3_LAYER_I) { samples_per_frame = 384; }
        if (layer == MP3_LAYER_II) { samples_per_frame = 1152; }
        if (layer == MP3_LAYER_III) { samples_per_frame = 1152; }
    } else {
        # V2 / V2.5
        if (layer == MP3_LAYER_I) { samples_per_frame = 384; }
        if (layer == MP3_LAYER_II) { samples_per_frame = 1152; }
        if (layer == MP3_LAYER_III) { samples_per_frame = 576; }
    }

    # Frame size calculation
    var padding_bytes = padding;
    var frame_size = 0;

    if (free_fmt == 1) {
        frame_size = _mp3_free_bytes + padding_bytes;
        if (layer == MP3_LAYER_I) { frame_size = _mp3_free_bytes + padding_bytes * 4; }
    } else {
        if (layer == MP3_LAYER_I) {
            frame_size = (12 * bitrate * 1000 / sample_rate + padding_bytes) * 4;
        } else {
            # Layer II / III
            var spf = 1152;
            if (layer == MP3_LAYER_III) {
                if (version == MP3_VERSION_V2) { spf = 576; }
                if (version == MP3_VERSION_V25) { spf = 576; }
            }
            frame_size = spf * bitrate * 1000 / (8 * sample_rate) + padding_bytes;
        }
    }

    # Build frame info struct
    var f = mp3_frame_new();
    store64(f,      version);
    store64(f + 8,  layer);
    store64(f + 16, bitrate);
    store64(f + 24, sample_rate);
    store64(f + 32, channel_mode);
    store64(f + 40, frame_size);
    store64(f + 48, samples_per_frame);
    store64(f + 56, padding);

    return f;
}

# ================================================================
# Frame scanning
# ================================================================

# Scan data for all valid MP3 frame headers.
# Returns a vec of frame info pointers.
fn mp3_scan_frames(data, len) {
    var skip = mp3_id3v2_skip(data, len);
    var pos = skip;
    var frames = vec_new();

    while (pos + 4 <= len) {
        if (load8(data + pos) == 0xFF) {
            if ((load8(data + pos + 1) & 0xE0) == 0xE0) {
                var info = mp3_parse_frame_header(data, pos);
                if (res_ok(info) == 1) {
                    var fs = mp3_frame_size(info);
                    if (fs > 0) {
                        # SEC-010: guard against frame_size pointing past buffer
                        if (pos + fs > len) { break; }
                        vec_push(frames, info);
                        pos = pos + fs;
                    } else {
                        pos = pos + 1;
                    }
                } else {
                    pos = pos + 1;
                }
            } else {
                pos = pos + 1;
            }
        } else {
            pos = pos + 1;
        }
    }

    return frames;
}

# ================================================================
# mp3_decode — the PCM decode; a FormatInfo with no samples only for a stream
# with no decodable frame at all
# ================================================================

fn mp3_decode(data, len) {
    if (mp3_bitrate_v1_l3 == 0) { mp3_init(); }
    # MPEG-1 Layer III: full decode to real PCM (2.5.11).
    var pcm = mp3_decode_pcm(data, len);
    if (res_ok(pcm) == 1) { return pcm; }

    # Fallback: Layer I/II, MPEG-2/2.5, or no decodable L3 frame — metadata only,
    # empty sample vector (behaviour prior to 2.5.11).
    var frames = mp3_scan_frames(data, len);
    if (vec_len(frames) == 0) { return err(ERR_INVALID_HEADER); }

    var first = vec_get(frames, 0);

    # Sum total samples across all frames
    var total_samples = 0;
    var fi = 0;
    var nframes = vec_len(frames);
    while (fi < nframes) {
        var f = vec_get(frames, fi);
        total_samples = total_samples + mp3_frame_samples_per_frame(f);
        fi = fi + 1;
    }

    var sr = mp3_frame_sample_rate(first);
    var dur = f64_div(f64_from(total_samples), f64_from(sr));

    var channels = 2;
    if (mp3_frame_channel_mode(first) == MP3_CHANNEL_MONO) {
        channels = 1;
    }

    var info = fmtinfo_new(FMT_MP3, sr, channels, 16, dur, total_samples);
    return decode_result_new(info, vec_new());
}

# ================================================================
# Tests
# ================================================================

# Helper: build a valid MPEG1 Layer III header
# 128kbps, 44100 Hz, stereo, no padding => [0xFF, 0xFB, 0x90, 0x00]
fn _mp3_make_valid_header(buf) {
    store8(buf, 0xFF);
    store8(buf + 1, 0xFB);
    store8(buf + 2, 0x90);
    store8(buf + 3, 0x00);
    return 0;
}

fn test_mp3_valid_header_parse() {
    test_group("mp3: valid header parse");

    var hdr = alloc(4);
    _mp3_make_valid_header(hdr);

    var info = mp3_parse_frame_header(hdr, 0);
    assert(res_ok(info) == 1, "parse ok");
    assert_eq(mp3_frame_version(info), MP3_VERSION_V1, "version V1");
    assert_eq(mp3_frame_layer(info), MP3_LAYER_III, "layer III");
    assert_eq(mp3_frame_bitrate(info), 128, "bitrate 128");
    assert_eq(mp3_frame_sample_rate(info), 44100, "sample rate 44100");
    assert_eq(mp3_frame_channel_mode(info), MP3_CHANNEL_STEREO, "stereo");
    assert_eq(mp3_frame_samples_per_frame(info), 1152, "1152 spf");
    assert_eq(mp3_frame_padding(info), 0, "no padding");
    # Frame size = 1152 * 128000 / (8 * 44100) = 417
    assert_eq(mp3_frame_size(info), 417, "frame size 417");

    return 0;
}

# 2.5.11: Layer I/II must use their own bitrate tables (the old code used Layer III's).
fn test_mp3_layer2_bitrate() {
    test_group("mp3: layer II uses its own bitrate table");
    var hdr = alloc(4);
    store8(hdr, 0xFF);
    store8(hdr + 1, 0xFD);   # sync + V1 + Layer II + no CRC
    store8(hdr + 2, 0xE0);   # bitrate_index=14, sr_index=0 (44100), no padding
    store8(hdr + 3, 0x00);   # stereo
    var info = mp3_parse_frame_header(hdr, 0);
    assert(res_ok(info) == 1, "parse ok");
    assert_eq(mp3_frame_layer(info), MP3_LAYER_II, "layer II");
    # V1 Layer II index 14 = 384 kbps (Layer III index 14 = 320 — the old bug value).
    assert_eq(mp3_frame_bitrate(info), 384, "L2 bitrate 384 (not L3's 320)");
    assert_eq(mp3_frame_samples_per_frame(info), 1152, "1152 spf");
    # 1152 * 384000 / (8 * 44100) = 1253 (integer division)
    assert_eq(mp3_frame_size(info), 1253, "L2 frame size 1253");
    return 0;
}

fn test_mp3_reject_bad_sync() {
    test_group("mp3: reject bad sync");

    var hdr = alloc(4);
    store8(hdr, 0x00); store8(hdr+1, 0x00); store8(hdr+2, 0x90); store8(hdr+3, 0x00);
    var result = mp3_parse_frame_header(hdr, 0);
    assert(is_err(result) == 1, "bad sync rejected");

    return 0;
}

fn test_mp3_reject_reserved_version() {
    test_group("mp3: reject reserved version");

    # version bits = 01 -> reserved
    # 0xE9 = 1110_1001 -> sync ok, version=01
    var hdr = alloc(4);
    store8(hdr, 0xFF); store8(hdr+1, 0xE9); store8(hdr+2, 0x90); store8(hdr+3, 0x00);
    var result = mp3_parse_frame_header(hdr, 0);
    assert(is_err(result) == 1, "reserved version rejected");

    return 0;
}

fn test_mp3_reject_reserved_layer() {
    test_group("mp3: reject reserved layer");

    # layer bits = 00 -> reserved
    # 0xF1 = 1111_0001 -> layer=00
    var hdr = alloc(4);
    store8(hdr, 0xFF); store8(hdr+1, 0xF1); store8(hdr+2, 0x90); store8(hdr+3, 0x00);
    var result = mp3_parse_frame_header(hdr, 0);
    assert(is_err(result) == 1, "reserved layer rejected");

    return 0;
}

fn test_mp3_reject_zero_bitrate() {
    test_group("mp3: reject zero bitrate");

    # bitrate index 0 -> free format (0 kbps, rejected)
    var hdr = alloc(4);
    store8(hdr, 0xFF); store8(hdr+1, 0xFB); store8(hdr+2, 0x00); store8(hdr+3, 0x00);
    var result = mp3_parse_frame_header(hdr, 0);
    assert(is_err(result) == 1, "zero bitrate rejected");

    return 0;
}

fn test_mp3_reject_reserved_sample_rate() {
    test_group("mp3: reject reserved sample rate");

    # sr index 3 -> reserved: byte2 bits 3-2 = 11
    # 0x9C = 1001_11_0_0
    var hdr = alloc(4);
    store8(hdr, 0xFF); store8(hdr+1, 0xFB); store8(hdr+2, 0x9C); store8(hdr+3, 0x00);
    var result = mp3_parse_frame_header(hdr, 0);
    assert(is_err(result) == 1, "reserved sample rate rejected");

    return 0;
}

fn test_mp3_id3v2_skip_no_tag() {
    test_group("mp3: id3v2 skip no tag");

    var data = alloc(4);
    store8(data, 0xFF); store8(data+1, 0xFB); store8(data+2, 0x90); store8(data+3, 0x00);
    assert_eq(mp3_id3v2_skip(data, 4), 0, "no tag skip 0");

    return 0;
}

fn test_mp3_id3v2_skip_with_tag() {
    test_group("mp3: id3v2 skip with tag");

    var data = alloc(210);
    memset(data, 0, 210);
    # "ID3"
    store8(data, 0x49);
    store8(data + 1, 0x44);
    store8(data + 2, 0x33);
    store8(data + 3, 4);     # version major
    store8(data + 4, 0);     # version minor
    store8(data + 5, 0);     # flags
    # syncsafe size = 100 -> [0, 0, 0, 100]
    store8(data + 6, 0);
    store8(data + 7, 0);
    store8(data + 8, 0);
    store8(data + 9, 100);

    assert_eq(mp3_id3v2_skip(data, 210), 110, "id3v2 skip 110");

    return 0;
}

fn test_mp3_frame_size_with_padding() {
    test_group("mp3: frame size with padding");

    # Same header but padding bit set: 0x92 = 1001_00_1_0
    var hdr = alloc(4);
    store8(hdr, 0xFF); store8(hdr+1, 0xFB); store8(hdr+2, 0x92); store8(hdr+3, 0x00);
    var info = mp3_parse_frame_header(hdr, 0);
    assert(res_ok(info) == 1, "padded parse ok");
    assert_eq(mp3_frame_padding(info), 1, "has padding");
    assert_eq(mp3_frame_size(info), 418, "frame size 418");

    return 0;
}

fn test_mp3_scan_multiple_frames() {
    test_group("mp3: scan multiple frames");

    var hdr = alloc(4);
    _mp3_make_valid_header(hdr);

    # Parse to get frame size
    var info = mp3_parse_frame_header(hdr, 0);
    var frame_size = mp3_frame_size(info);

    # Build data with 3 frames
    var total = frame_size * 3;
    var data = alloc(total);
    memset(data, 0, total);

    var fi = 0;
    while (fi < 3) {
        memcpy(data + fi * frame_size, hdr, 4);
        fi = fi + 1;
    }

    var frames = mp3_scan_frames(data, total);
    assert_eq(vec_len(frames), 3, "3 frames found");

    return 0;
}

fn test_mp3_scan_no_frames() {
    test_group("mp3: scan no frames");

    var data = alloc(100);
    memset(data, 0, 100);
    var frames = mp3_scan_frames(data, 100);
    assert_eq(vec_len(frames), 0, "no frames found");

    return 0;
}

fn test_mp3_mono_channel() {
    test_group("mp3: mono channel mode");

    # channel mode = 11 -> mono: byte3 = 0xC0
    var hdr = alloc(4);
    store8(hdr, 0xFF); store8(hdr+1, 0xFB); store8(hdr+2, 0x90); store8(hdr+3, 0xC0);
    var info = mp3_parse_frame_header(hdr, 0);
    assert(res_ok(info) == 1, "mono parse ok");
    assert_eq(mp3_frame_channel_mode(info), MP3_CHANNEL_MONO, "mono mode");

    return 0;
}

fn test_mp3_syncsafe() {
    test_group("mp3: syncsafe decode");

    var buf = alloc(4);

    # [0x00, 0x00, 0x02, 0x01] -> 257
    store8(buf, 0x00); store8(buf+1, 0x00); store8(buf+2, 0x02); store8(buf+3, 0x01);
    assert_eq(mp3_syncsafe_to_u32(buf, 0), 257, "syncsafe 257");

    # [0x00, 0x00, 0x00, 0x00] -> 0
    store8(buf, 0x00); store8(buf+1, 0x00); store8(buf+2, 0x00); store8(buf+3, 0x00);
    assert_eq(mp3_syncsafe_to_u32(buf, 0), 0, "syncsafe 0");

    # [0x7F, 0x7F, 0x7F, 0x7F] -> 0x0FFFFFFF = 268435455
    store8(buf, 0x7F); store8(buf+1, 0x7F); store8(buf+2, 0x7F); store8(buf+3, 0x7F);
    assert_eq(mp3_syncsafe_to_u32(buf, 0), 268435455, "syncsafe max");

    return 0;
}

fn test_mp3_decode_produces_info() {
    test_group("mp3: decode produces format info");

    var hdr = alloc(4);
    _mp3_make_valid_header(hdr);

    var info = mp3_parse_frame_header(hdr, 0);
    var frame_size = mp3_frame_size(info);

    # Build data with 10 frames
    var total = frame_size * 10;
    var data = alloc(total);
    memset(data, 0, total);

    var fi = 0;
    while (fi < 10) {
        memcpy(data + fi * frame_size, hdr, 4);
        fi = fi + 1;
    }

    var result = mp3_decode(data, total);
    assert(res_ok(result) == 1, "decode ok");

    var finfo = load64(result);
    assert_eq(fmtinfo_format(finfo), FMT_MP3, "format MP3");
    assert_eq(fmtinfo_sample_rate(finfo), 44100, "sr 44100");
    assert_eq(fmtinfo_channels(finfo), 2, "2 channels");

    return 0;
}

# ================================================================
# MPEG-1 Layer III full decode to PCM (2.5.11)
# Ported from pdmp3 (Krister Lagerström, public domain) + ISO/IEC 11172-3.
# Big tables (Huffman tree, 512-tap synthesis window) are CSV string
# literals generated from pdmp3.c; trig tables are derived at init.
