    store64(_celt_tfsel + 24 * 8, 0); store64(_celt_tfsel + 25 * 8, 0 - 2); store64(_celt_tfsel + 26 * 8, 0); store64(_celt_tfsel + 27 * 8, 0 - 3); store64(_celt_tfsel + 28 * 8, 3); store64(_celt_tfsel + 29 * 8, 0); store64(_celt_tfsel + 30 * 8, 1); store64(_celt_tfsel + 31 * 8, 0 - 1);
    _celt_log2frac = alloc(24 * 8);
