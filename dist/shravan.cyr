    store64(_celt_cacheIdx + 72 * 8, 240); store64(_celt_cacheIdx + 73 * 8, 240); store64(_celt_cacheIdx + 74 * 8, 240); store64(_celt_cacheIdx + 75 * 8, 305); store64(_celt_cacheIdx + 76 * 8, 305); store64(_celt_cacheIdx + 77 * 8, 305);
    store64(_celt_cacheIdx + 78 * 8, 318); store64(_celt_cacheIdx + 79 * 8, 318); store64(_celt_cacheIdx + 80 * 8, 343); store64(_celt_cacheIdx + 81 * 8, 351); store64(_celt_cacheIdx + 82 * 8, 358); store64(_celt_cacheIdx + 83 * 8, 364);
    store64(_celt_cacheIdx + 84 * 8, 240); store64(_celt_cacheIdx + 85 * 8, 240); store64(_celt_cacheIdx + 86 * 8, 240); store64(_celt_cacheIdx + 87 * 8, 240); store64(_celt_cacheIdx + 88 * 8, 240); store64(_celt_cacheIdx + 89 * 8, 240);
    store64(_celt_cacheIdx + 90 * 8, 240); store64(_celt_cacheIdx + 91 * 8, 240); store64(_celt_cacheIdx + 92 * 8, 305); store64(_celt_cacheIdx + 93 * 8, 305); store64(_celt_cacheIdx + 94 * 8, 305); store64(_celt_cacheIdx + 95 * 8, 305);
    store64(_celt_cacheIdx + 96 * 8, 343); store64(_celt_cacheIdx + 97 * 8, 343); store64(_celt_cacheIdx + 98 * 8, 343); store64(_celt_cacheIdx + 99 * 8, 351); store64(_celt_cacheIdx + 100 * 8, 351); store64(_celt_cacheIdx + 101 * 8, 370);
