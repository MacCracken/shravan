# Fuzz: full-library decode entry points.
#
# Complements fuzz/fuzz_codecs.cyr, which stubs a minimal library and can only
# reach flac_parse_metadata / ogg_parse_page / mp3_scan_frames / tag_read_id3v2.
# That harness's "WAV/AIFF/ALAC require main.cyr library (deferred to library
# factoring)" note is obsolete: src/shravan.cyr IS the library now, so this
# harness includes it for real and fuzzes the entry points consumers actually
# call on untrusted bytes.
#
# Invariants:
#   - No decode entry point crashes on any input.
#   - Every one returns a packed error code (negative) rather than aborting.
#
# Coverage added here: codec_open (unified dispatch), wav_decode, aiff_decode,
# alac_decode, flac_decode + flac_decode_range, mp3_decode + mp3_decode_pcm,
# ogg_decode, mp4_decode, aac_decode, tag_read_vorbis; since 2.9.3 also
# opus_decode_from_packets on libopus packets, the streaming decoders (through
# decode_reader, split at random), and tag_read_id3v2 on compressed frames, which
# reaches sankoch's inflate; the FLAC, AAC and SILK encoders on hostile input,
# (2.12.3) opus_encode with every ctl in and out of its bounds, and (2.12.4) the
# CELT encoder with every ctl, the hybrid's pre-written range coder and hostile input.
#
# Under `-D CYRIUS_POISON` (cyrius's poison mode: redzones around every alloc) a
# redzone hit exits 86 at once, and the run ends with a full sweep.
#
# Two input strategies per target:
#   (a) random bytes behind the format's magic  — reaches header validation
#   (b) VALID seed file with N bytes corrupted  — reaches deep decode paths that
#       random data never survives long enough to touch
#
# Usage: ./build/fuzz_decode [iters] [seed]   (default: 2000, seed 1)
#
# The seed is explicit because alloc() is a bump allocator that never frees, so
# a single process cannot run unboundedly (2000 iters ~= 34K calls ~= 230 MB
# RSS). fuzz/run.sh therefore sweeps seeds across several short processes to
# reach a high call count in bounded memory; a fixed seed keeps any failure
# reproducible.

include "src/shravan.cyr"
include "src/flac.cyr"
include "src/ogg.cyr"
include "src/mp3.cyr"
include "src/tag.cyr"
include "src/fft.cyr"
include "src/opus.cyr"
include "src/silk.cyr"
include "src/silk_enc.cyr"
include "src/opus_enc.cyr"
include "src/celt_enc_tables.cyr"
include "src/celt_enc.cyr"
include "src/aac.cyr"
include "src/mp4.cyr"
include "src/resample.cyr"
include "src/dither.cyr"
include "src/simd.cyr"
include "src/stream.cyr"
include "src/interop_fixtures.cyr"

# ================================================================
# PRNG (SplitMix-ish LCG; deterministic so failures reproduce)
# ================================================================

var _fz_state = 88172645463325252;

fn _fz_rand() {
    _fz_state = _fz_state * 6364136223846793005 + 1442695040888963407;
    return _fz_state;
}

fn _fz_u(m) {
    if (m <= 0) { return 0; }
    var r = _fz_rand();
    if (r < 0) { r = 0 - r; }
    if (r < 0) { r = 0; }          # INT64_MIN negates to itself
    return r % m;
}

fn _fz_fill(buf, len) {
    var i = 0;
    while (i < len) { store8(buf + i, _fz_u(256)); i = i + 1; }
    return 0;
}

# Copy an mlen-byte magic to the head, random bytes after it.
fn _fz_fill_magic(buf, len, magic, mlen) {
    var i = 0;
    while (i < mlen) { if (i < len) { store8(buf + i, load8(magic + i)); } i = i + 1; }
    while (i < len) { store8(buf + i, _fz_u(256)); i = i + 1; }
    return 0;
}

# Copy `seed` (slen bytes) into buf, then corrupt `nmut` random byte positions.
# This is what reaches the deep decode paths.
fn _fz_mutate(buf, seed, slen, nmut) {
    var i = 0;
    while (i < slen) { store8(buf + i, load8(seed + i)); i = i + 1; }
    var m = 0;
    while (m < nmut) {
        var pos = _fz_u(slen);
        store8(buf + pos, _fz_u(256));
        m = m + 1;
    }
    return slen;
}

# ================================================================
# Seed builders — real, valid files produced by shravan's own encoders
# ================================================================

fn _fz_make_samples(n) {
    var v = vec_new();
    var i = 0;
    while (i < n) {
        # alternating +/- 0.5 with a slow ramp; non-trivial but bounded
        if ((i / 16) % 2 == 0) { vec_push(v, F64_HALF); } else { vec_push(v, F64_NEG_HALF); }
        i = i + 1;
    }
    return v;
}

# ================================================================
# Main
# ================================================================

# Only what the consumer contract requires (docs/architecture/overview.md). Calling
# every module's init here hid that mp4_decode crashed without aac_init() and FLAC
# without flac_init(): each codec must initialise its own tables.
alloc_init();
shravan_init_constants();
#ifdef CYRIUS_POISON
poison_trap_set(1);
#endif

var iters = 2000;
args_init();
if (argc() > 1) {
    iters = atoi(argv(1));
    if (iters <= 0) { iters = 2000; }
}
if (argc() > 2) {
    var sd = atoi(argv(2));
    if (sd > 0) {
        # Mix the seed in rather than assigning it, so a small seed still
        # starts the LCG in a well-distributed state.
        _fz_state = _fz_state + sd * 6364136223846793005;
        _fz_rand();
    }
}

var max_size = 4096;
var buf = alloc(max_size);
var total = 0;

# --- magics ---
var m_riff = alloc(4);
store8(m_riff, 0x52); store8(m_riff+1, 0x49); store8(m_riff+2, 0x46); store8(m_riff+3, 0x46);
var m_form = alloc(4);
store8(m_form, 0x46); store8(m_form+1, 0x4F); store8(m_form+2, 0x52); store8(m_form+3, 0x4D);
var m_flac = alloc(4);
store8(m_flac, 0x66); store8(m_flac+1, 0x4C); store8(m_flac+2, 0x61); store8(m_flac+3, 0x43);
var m_ogg = alloc(4);
store8(m_ogg, 0x4F); store8(m_ogg+1, 0x67); store8(m_ogg+2, 0x67); store8(m_ogg+3, 0x53);
var m_adts = alloc(2);
store8(m_adts, 0xFF); store8(m_adts+1, 0xF1);
var m_mp3 = alloc(2);
store8(m_mp3, 0xFF); store8(m_mp3+1, 0xFB);
# ....ftyp  (mp4 box header at offset 4)
var m_ftyp = alloc(8);
store8(m_ftyp, 0); store8(m_ftyp+1, 0); store8(m_ftyp+2, 0); store8(m_ftyp+3, 0x18);
store8(m_ftyp+4, 0x66); store8(m_ftyp+5, 0x74); store8(m_ftyp+6, 0x79); store8(m_ftyp+7, 0x70);

syscall(1, 1, "fuzz_decode: ", 13);
fmt_int(iters);
syscall(1, 1, " iterations per target, stream ", 31);
# Digest of the PRNG state: proves the seed actually re-aims the byte stream,
# and is the handle for reproducing a failing run.
fmt_int(_fz_u(1000000));
syscall(1, 1, "\n", 1);

# ================================================================
# Build valid seed files with shravan's own encoders
# ================================================================

var seed_pcm = _fz_make_samples(256);

var wav_seed = alloc(8192);
var wav_len = wav_encode(seed_pcm, 44100, 1, PCM_I16, wav_seed);
if (is_err(wav_len) == 1) { wav_len = 0; }

var aiff_seed = alloc(8192);
var aiff_len = aiff_encode(seed_pcm, 44100, 1, 16, aiff_seed);
if (is_err(aiff_len) == 1) { aiff_len = 0; }

var flac_seed = alloc(16384);
var flac_len = flac_encode(seed_pcm, 44100, 1, 16, flac_seed);
if (is_err(flac_len) == 1) { flac_len = 0; }

var aac_seed = alloc(16384);
var aac_len = aac_encode(seed_pcm, 44100, 1, 64000, aac_seed);
if (is_err(aac_len) == 1) { aac_len = 0; }

syscall(1, 1, "  seeds: wav=", 13); fmt_int(wav_len);
syscall(1, 1, " aiff=", 6); fmt_int(aiff_len);
syscall(1, 1, " flac=", 6); fmt_int(flac_len);
syscall(1, 1, " aac=", 5); fmt_int(aac_len);
syscall(1, 1, " bytes\n", 7);

# ================================================================
# Target: codec_open — the unified dispatch, the real attack surface
# ================================================================
syscall(1, 1, "  codec_open (random+magic)... ", 31);
var fi = 0;
while (fi < iters) {
    var sz = _fz_u(max_size - 16) + 16;
    var which = _fz_u(7);
    if (which == 0) { _fz_fill_magic(buf, sz, m_riff, 4); }
    if (which == 1) { _fz_fill_magic(buf, sz, m_form, 4); }
    if (which == 2) { _fz_fill_magic(buf, sz, m_flac, 4); }
    if (which == 3) { _fz_fill_magic(buf, sz, m_ogg,  4); }
    if (which == 4) { _fz_fill_magic(buf, sz, m_adts, 2); }
    if (which == 5) { _fz_fill_magic(buf, sz, m_ftyp, 8); }
    if (which == 6) { _fz_fill(buf, sz); }
    codec_open(buf, sz);
    fi = fi + 1; total = total + 1;
}
syscall(1, 1, "ok\n", 3);

# ================================================================
# Target: WAV — random-behind-magic, then valid-seed mutation
# ================================================================
syscall(1, 1, "  wav_decode... ", 16);
fi = 0;
while (fi < iters) {
    var sz = _fz_u(max_size - 44) + 44;
    _fz_fill_magic(buf, sz, m_riff, 4);
    wav_decode(buf, sz);
    fi = fi + 1; total = total + 1;
}
if (wav_len > 0) {
    fi = 0;
    while (fi < iters) {
        var n = _fz_mutate(buf, wav_seed, wav_len, _fz_u(6) + 1);
        wav_decode(buf, n);
        fi = fi + 1; total = total + 1;
    }
}
syscall(1, 1, "ok\n", 3);

# ================================================================
# Target: AIFF
# ================================================================
syscall(1, 1, "  aiff_decode... ", 17);
fi = 0;
while (fi < iters) {
    var sz = _fz_u(max_size - 54) + 54;
    _fz_fill_magic(buf, sz, m_form, 4);
    aiff_decode(buf, sz);
    fi = fi + 1; total = total + 1;
}
if (aiff_len > 0) {
    fi = 0;
    while (fi < iters) {
        var n = _fz_mutate(buf, aiff_seed, aiff_len, _fz_u(6) + 1);
        aiff_decode(buf, n);
        fi = fi + 1; total = total + 1;
    }
}
syscall(1, 1, "ok\n", 3);

# ================================================================
# Target: FLAC full decode (not just metadata) + range decode
# ================================================================
syscall(1, 1, "  flac_decode... ", 17);
fi = 0;
while (fi < iters) {
    var sz = _fz_u(max_size - 42) + 42;
    _fz_fill_magic(buf, sz, m_flac, 4);
    flac_decode(buf, sz);
    fi = fi + 1; total = total + 1;
}
if (flac_len > 0) {
    fi = 0;
    while (fi < iters) {
        var n = _fz_mutate(buf, flac_seed, flac_len, _fz_u(6) + 1);
        flac_decode(buf, n);
        flac_decode_range(buf, n, _fz_u(512), _fz_u(512) + 1);
        fi = fi + 1; total = total + 2;
    }
}
syscall(1, 1, "ok\n", 3);

# ================================================================
# Target: FLAC encoder. Random lengths, levels, depths, channel counts and rates
# over hostile f64 input (NaN, infinities, values past full scale, constants,
# coarse steps that leave wasted bits); shravan's decoder must hand back exactly
# the quantised input. A mismatch exits 87.
# ================================================================
syscall(1, 1, "  flac_encode... ", 17);
var fe_out = alloc(flac_encode_bound(1200, 8, 32));
var fe_iters = iters / 8;
if (fe_iters < 1) { fe_iters = 1; }
fi = 0;
while (fi < fe_iters) {
    var fe_frames = _fz_u(1200);
    var fe_ch = _fz_u(8) + 1;
    var fe_bps = _fz_u(29) + 4;
    var fe_level = _fz_u(9);
    var fe_rate = _fz_u(1048575) + 1;
    var fe_shape = _fz_u(4);
    var fe_v = vec_new();
    var fe_w = f64_div(F64_ONE, f64_from(_fz_u(200) + 2));
    var k = 0;
    while (k < fe_frames * fe_ch) {
        var x = f64_div(f64_from(_fz_u(2000001) - 1000000), f64_from(1000000));
        if (fe_shape == 1) { x = f64_mul(f64_from(_fz_u(3) - 1), f64_sin(f64_mul(fe_w, f64_from(k / fe_ch)))); }
        if (fe_shape == 2) { x = f64_div(F64_ONE, f64_from(3)); }
        if (fe_shape == 3) { x = f64_div(f64_from(_fz_u(64) - 32), f64_from(64)); }
        var sp = _fz_u(200);
        if (sp == 0) { x = 0x7FF8000000000000; }
        if (sp == 1) { x = 0x7FF0000000000000; }
        if (sp == 2) { x = 0 - 0x10000000000000; }
        if (sp == 3) { x = f64_from(1000000); }
        if (sp == 4) { x = f64_from(0 - 1000000); }
        vec_push(fe_v, x);
        k = k + 1;
    }
    var fe_n = flac_encode_level(fe_v, fe_rate, fe_ch, fe_bps, fe_level, fe_out);
    var fe_bad = 0;
    if (is_err(fe_n) == 1) { fe_bad = 1; }
    if (fe_bad == 0) {
        var fe_r = flac_decode(fe_out, fe_n);
        if (is_err(fe_r) == 1) {
            fe_bad = 2;
        } else {
            var fe_d = decode_result_samples(fe_r);
            if (vec_len(fe_d) != vec_len(fe_v)) { fe_bad = 3; }
            var fe_scale = f64_from(1 << (fe_bps - 1));
            var fe_hi = (1 << (fe_bps - 1)) - 1;
            var fe_lo = 0 - (1 << (fe_bps - 1));
            var q = 0;
            while (fe_bad == 0 && q < vec_len(fe_v)) {
                var want = f64_div(f64_from(_pcm_quant(vec_get(fe_v, q), fe_scale, fe_lo, fe_hi)), fe_scale);
                if (vec_get(fe_d, q) != want) { fe_bad = 4; }
                q = q + 1;
            }
        }
    }
    if (fe_bad != 0) {
        syscall(1, 1, "flac encode round trip failed: ", 31);
        fmt_int(fe_bad);
        syscall(1, 1, " level ", 7);
        fmt_int(fe_level);
        syscall(1, 1, " bps ", 5);
        fmt_int(fe_bps);
        syscall(1, 1, " ch ", 4);
        fmt_int(fe_ch);
        syscall(1, 1, " frames ", 8);
        fmt_int(fe_frames);
        syscall(1, 1, "\n", 1);
        syscall(60, 87);
    }
    fi = fi + 1; total = total + 2;
}
syscall(1, 1, "ok\n", 3);

# ================================================================
# Target: AAC encoder. Random rates (valid and not), channel counts, bit rates
# and lengths over hostile f64 input (NaN, infinities, values past full scale,
# constants, silence, clicks that switch windows). Invalid parameters must be
# refused; otherwise the stream must fit aac_encode_bound, hold one ADTS frame
# per 1024 samples plus the priming frame, keep each frame within AAC-LC's 6144
# bits a channel, and decode in shravan to that many finite samples. A violation
# exits 88.
# ================================================================
syscall(1, 1, "  aac_encode... ", 16);
var ae_rates = alloc(13 * 8);
store64(ae_rates, 96000); store64(ae_rates + 8, 88200); store64(ae_rates + 16, 64000);
store64(ae_rates + 24, 48000); store64(ae_rates + 32, 44100); store64(ae_rates + 40, 32000);
store64(ae_rates + 48, 24000); store64(ae_rates + 56, 22050); store64(ae_rates + 64, 16000);
store64(ae_rates + 72, 12000); store64(ae_rates + 80, 11025); store64(ae_rates + 88, 8000);
store64(ae_rates + 96, 7350);
var ae_max = 6000;
var ae_out = alloc(aac_encode_bound(ae_max, 2));
var ae_iters = iters / 4;
if (ae_iters < 1) { ae_iters = 1; }
fi = 0;
while (fi < ae_iters) {
    var ae_n = _fz_u(ae_max);
    var ae_ch = _fz_u(2) + 1;
    if (_fz_u(50) == 0) { ae_ch = _fz_u(2) * 3; }          # 0 or 3: refused
    var ae_rate = load64(ae_rates + _fz_u(13) * 8);
    if (_fz_u(50) == 0) { ae_rate = _fz_u(200000); }
    var ae_br = _fz_u(600000) + 1;
    if (_fz_u(50) == 0) { ae_br = 0 - _fz_u(2); }
    var ae_ok = 0;
    var ri = 0;
    while (ri < 13) { if (load64(ae_rates + ri * 8) == ae_rate) { ae_ok = 1; } ri = ri + 1; }
    if (ae_ch < 1 || ae_ch > 2 || ae_br <= 0) { ae_ok = 0; }
    var ae_shape = _fz_u(5);
    var ae_amp = f64_div(f64_from(_fz_u(2001)), f64_from(1000));
    var ae_w = f64_div(F64_ONE, f64_from(_fz_u(200) + 2));
    var ae_v = vec_new();
    var k2 = 0;
    while (k2 < ae_n * ae_ch) {
        var x2 = f64_mul(ae_amp, f64_div(f64_from(_fz_u(2000001) - 1000000), f64_from(1000000)));
        if (ae_shape == 1) { x2 = f64_mul(ae_amp, f64_sin(f64_mul(ae_w, f64_from(k2 / ae_ch)))); }
        if (ae_shape == 2) { x2 = f64_div(ae_amp, f64_from(3)); }
        if (ae_shape == 3) { x2 = 0; }
        if (ae_shape == 4) {
            x2 = 0;
            if ((k2 / ae_ch) % 3000 < 8) { x2 = f64_mul(ae_amp, f64_div(f64_from(_fz_u(2001) - 1000), f64_from(1000))); }
        }
        var sp2 = _fz_u(200);
        if (sp2 == 0) { x2 = 0x7FF8000000000000; }
        if (sp2 == 1) { x2 = 0x7FF0000000000000; }
        if (sp2 == 2) { x2 = 0 - 0x10000000000000; }
        if (sp2 == 3) { x2 = f64_from(1000000); }
        if (sp2 == 4) { x2 = f64_from(0 - 1000000); }
        vec_push(ae_v, x2);
        k2 = k2 + 1;
    }
    var ae_len = aac_encode(ae_v, ae_rate, ae_ch, ae_br, ae_out);
    var ae_bad = 0;
    if (ae_ok == 0) {
        if (is_err(ae_len) == 0) { ae_bad = 1; }
    } else {
        if (is_err(ae_len) == 1) { ae_bad = 2; }
        if (ae_bad == 0 && ae_len > aac_encode_bound(ae_n, ae_ch)) { ae_bad = 3; }
        var ae_frames = 0;
        var ae_pos = 0;
        while (ae_bad == 0 && ae_pos + 7 <= ae_len) {
            if (load8(ae_out + ae_pos) != 0xFF || (load8(ae_out + ae_pos + 1) & 0xF0) != 0xF0) { ae_bad = 4; }
            var flen = ((load8(ae_out + ae_pos + 3) & 3) << 11) | (load8(ae_out + ae_pos + 4) << 3) | (load8(ae_out + ae_pos + 5) >> 5);
            if (flen < 8 || (flen - 7) * 8 > 6144 * ae_ch) { ae_bad = 5; }
            ae_pos = ae_pos + flen;
            ae_frames = ae_frames + 1;
        }
        if (ae_bad == 0 && ae_pos != ae_len) { ae_bad = 6; }
        if (ae_bad == 0 && ae_frames != (ae_n + 1023) / 1024 + 1) { ae_bad = 7; }
        if (ae_bad == 0) {
            var ae_r = aac_decode(ae_out, ae_len);
            if (is_err(ae_r) == 1) {
                ae_bad = 8;
            } else {
                var ae_d = decode_result_samples(ae_r);
                if (vec_len(ae_d) != ae_frames * 1024 * ae_ch) { ae_bad = 9; }
                var q2 = 0;
                var four = f64_from(4);
                while (ae_bad == 0 && q2 < vec_len(ae_d)) {
                    var y2 = vec_get(ae_d, q2);
                    if (((y2 >> 52) & 0x7FF) == 0x7FF || f64_gt(f64_abs(y2), four) == 1) { ae_bad = 10; }
                    q2 = q2 + 1;
                }
            }
        }
    }
    if (ae_bad != 0) {
        syscall(1, 1, "aac encode check failed: ", 25);
        fmt_int(ae_bad);
        syscall(1, 1, " rate ", 6);
        fmt_int(ae_rate);
        syscall(1, 1, " ch ", 4);
        fmt_int(ae_ch);
        syscall(1, 1, " br ", 4);
        fmt_int(ae_br);
        syscall(1, 1, " n ", 3);
        fmt_int(ae_n);
        syscall(1, 1, " shape ", 7);
        fmt_int(ae_shape);
        syscall(1, 1, "\n", 1);
        syscall(60, 88);
    }
    fi = fi + 1; total = total + 2;
}
syscall(1, 1, "ok\n", 3);

# ================================================================
# Target: SILK encoder. Random internal rates and packet lengths (valid and
# not), bit rates, complexities, CBR, packet loss settings (2.12.0, valid and
# not), input rates, FEC and DTX (2.12.1, valid and not; a DTX payload may be
# empty, and its Opus packet the TOC alone, under CBR too), stereo input
# (2.12.2: 1 or 2 channels and the odd invalid count; the coded channels,
# toMono and the bit rate changing packet by packet, valid and not; a stereo
# packet's TOC carries the stereo bit), buffers from none
# to plenty, over hostile f64 input (NaN, infinities,
# values past full scale, silence, constants, square waves, noise, and periodic
# input for the voiced path: impulse trains and squares at lags in and out of
# the pitch range). Bad parameters must be refused, and only those; a payload must
# fit its buffer or be refused, with nothing written past it; an Opus packet
# must fit (a buffer of 1 byte holds the TOC alone), carry the configured TOC
# and, under CBR, be the configured size; and
# shravan's Opus decoder must take the packets, giving their length of audio. A
# violation exits 89.
# ================================================================
syscall(1, 1, "  silk_encode... ", 17);
var se_pcm = alloc(5760 * 8);
var se_buf = alloc(1400);
var se_head = alloc(19);
memset(se_head, 0, 19);
memcpy(se_head, "OpusHead", 8);
store8(se_head + 8, 1);
store8(se_head + 9, 1);
write_u32_le(se_head, 12, 48000);
var se_tags = alloc(16);
memset(se_tags, 0, 16);
memcpy(se_tags, "OpusTags", 8);
var se_iters = iters / 8;
if (se_iters < 1) { se_iters = 1; }
fi = 0;
while (fi < se_iters) {
    var se_rate = 16000;
    var rs = _fz_u(6);
    if (rs == 1) { se_rate = 8000; }
    if (rs == 2) { se_rate = 12000; }
    if (rs == 3) { se_rate = 48000; }
    if (rs == 4) { se_rate = _fz_u(20000); }
    var se_ms = 20;
    var mss = _fz_u(6);
    if (mss == 1) { se_ms = 10; }
    if (mss == 2) { se_ms = 40; }
