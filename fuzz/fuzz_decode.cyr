# Fuzz: full-library decode entry points.
#
# Complements fuzz/fuzz_codecs.cyr, which stubs a minimal library and can only
# reach flac_parse_metadata / ogg_parse_page / mp3_scan_frames / tag_read_id3v2.
# That harness's "WAV/AIFF/ALAC require main.cyr library (deferred to library
# factoring)" note is obsolete: src/shravan.cyr IS the library now, so this
# harness includes it for real and fuzzes the entry points consumers actually
# call on untrusted bytes.
#
# Invariants:
#   - No decode entry point crashes on any input.
#   - Every one returns a packed error code (negative) rather than aborting.
#
# Coverage added here: codec_open (unified dispatch), wav_decode, aiff_decode,
# alac_decode, flac_decode + flac_decode_range, mp3_decode + mp3_decode_pcm,
# ogg_decode, mp4_decode, aac_decode, tag_read_vorbis; since 2.9.3 also
# opus_decode_from_packets on libopus packets, the streaming decoders (through
# decode_reader, split at random), and tag_read_id3v2 on compressed frames, which
# reaches sankoch's inflate.
#
# Under `-D CYRIUS_POISON` (cyrius's poison mode: redzones around every alloc) a
# redzone hit exits 86 at once, and the run ends with a full sweep.
#
# Two input strategies per target:
#   (a) random bytes behind the format's magic  — reaches header validation
#   (b) VALID seed file with N bytes corrupted  — reaches deep decode paths that
#       random data never survives long enough to touch
#
# Usage: ./build/fuzz_decode [iters] [seed]   (default: 2000, seed 1)
#
# The seed is explicit because alloc() is a bump allocator that never frees, so
# a single process cannot run unboundedly (2000 iters ~= 34K calls ~= 230 MB
# RSS). fuzz/run.sh therefore sweeps seeds across several short processes to
# reach a high call count in bounded memory; a fixed seed keeps any failure
# reproducible.

include "src/shravan.cyr"
include "src/flac.cyr"
include "src/ogg.cyr"
include "src/mp3.cyr"
include "src/tag.cyr"
include "src/fft.cyr"
include "src/opus.cyr"
include "src/silk.cyr"
include "src/aac.cyr"
include "src/mp4.cyr"
include "src/resample.cyr"
include "src/dither.cyr"
include "src/simd.cyr"
include "src/stream.cyr"
include "src/interop_fixtures.cyr"

# ================================================================
# PRNG (SplitMix-ish LCG; deterministic so failures reproduce)
# ================================================================

var _fz_state = 88172645463325252;

fn _fz_rand() {
    _fz_state = _fz_state * 6364136223846793005 + 1442695040888963407;
    return _fz_state;
}

fn _fz_u(m) {
    if (m <= 0) { return 0; }
    var r = _fz_rand();
    if (r < 0) { r = 0 - r; }
    if (r < 0) { r = 0; }          # INT64_MIN negates to itself
    return r % m;
}

fn _fz_fill(buf, len) {
    var i = 0;
    while (i < len) { store8(buf + i, _fz_u(256)); i = i + 1; }
    return 0;
}

# Copy an mlen-byte magic to the head, random bytes after it.
fn _fz_fill_magic(buf, len, magic, mlen) {
    var i = 0;
    while (i < mlen) { if (i < len) { store8(buf + i, load8(magic + i)); } i = i + 1; }
    while (i < len) { store8(buf + i, _fz_u(256)); i = i + 1; }
    return 0;
}

# Copy `seed` (slen bytes) into buf, then corrupt `nmut` random byte positions.
# This is what reaches the deep decode paths.
fn _fz_mutate(buf, seed, slen, nmut) {
    var i = 0;
    while (i < slen) { store8(buf + i, load8(seed + i)); i = i + 1; }
    var m = 0;
    while (m < nmut) {
        var pos = _fz_u(slen);
        store8(buf + pos, _fz_u(256));
        m = m + 1;
    }
    return slen;
}

# ================================================================
# Seed builders — real, valid files produced by shravan's own encoders
# ================================================================

fn _fz_make_samples(n) {
    var v = vec_new();
    var i = 0;
    while (i < n) {
        # alternating +/- 0.5 with a slow ramp; non-trivial but bounded
        if ((i / 16) % 2 == 0) { vec_push(v, F64_HALF); } else { vec_push(v, F64_NEG_HALF); }
        i = i + 1;
    }
    return v;
}

# ================================================================
# Main
# ================================================================

# Only what the consumer contract requires (docs/architecture/overview.md). Calling
# every module's init here hid that mp4_decode crashed without aac_init() and FLAC
# without flac_init(): each codec must initialise its own tables.
alloc_init();
shravan_init_constants();
#ifdef CYRIUS_POISON
poison_trap_set(1);
#endif

var iters = 2000;
args_init();
if (argc() > 1) {
    iters = atoi(argv(1));
    if (iters <= 0) { iters = 2000; }
}
if (argc() > 2) {
    var sd = atoi(argv(2));
    if (sd > 0) {
        # Mix the seed in rather than assigning it, so a small seed still
        # starts the LCG in a well-distributed state.
        _fz_state = _fz_state + sd * 6364136223846793005;
        _fz_rand();
    }
}

var max_size = 4096;
var buf = alloc(max_size);
var total = 0;

# --- magics ---
var m_riff = alloc(4);
store8(m_riff, 0x52); store8(m_riff+1, 0x49); store8(m_riff+2, 0x46); store8(m_riff+3, 0x46);
var m_form = alloc(4);
store8(m_form, 0x46); store8(m_form+1, 0x4F); store8(m_form+2, 0x52); store8(m_form+3, 0x4D);
var m_flac = alloc(4);
store8(m_flac, 0x66); store8(m_flac+1, 0x4C); store8(m_flac+2, 0x61); store8(m_flac+3, 0x43);
var m_ogg = alloc(4);
store8(m_ogg, 0x4F); store8(m_ogg+1, 0x67); store8(m_ogg+2, 0x67); store8(m_ogg+3, 0x53);
var m_adts = alloc(2);
store8(m_adts, 0xFF); store8(m_adts+1, 0xF1);
var m_mp3 = alloc(2);
store8(m_mp3, 0xFF); store8(m_mp3+1, 0xFB);
# ....ftyp  (mp4 box header at offset 4)
var m_ftyp = alloc(8);
store8(m_ftyp, 0); store8(m_ftyp+1, 0); store8(m_ftyp+2, 0); store8(m_ftyp+3, 0x18);
store8(m_ftyp+4, 0x66); store8(m_ftyp+5, 0x74); store8(m_ftyp+6, 0x79); store8(m_ftyp+7, 0x70);

syscall(1, 1, "fuzz_decode: ", 13);
fmt_int(iters);
syscall(1, 1, " iterations per target, stream ", 31);
# Digest of the PRNG state: proves the seed actually re-aims the byte stream,
# and is the handle for reproducing a failing run.
fmt_int(_fz_u(1000000));
syscall(1, 1, "\n", 1);

# ================================================================
# Build valid seed files with shravan's own encoders
# ================================================================

var seed_pcm = _fz_make_samples(256);

var wav_seed = alloc(8192);
var wav_len = wav_encode(seed_pcm, 44100, 1, PCM_I16, wav_seed);
if (is_err(wav_len) == 1) { wav_len = 0; }

var aiff_seed = alloc(8192);
var aiff_len = aiff_encode(seed_pcm, 44100, 1, 16, aiff_seed);
if (is_err(aiff_len) == 1) { aiff_len = 0; }

var flac_seed = alloc(16384);
var flac_len = flac_encode(seed_pcm, 44100, 1, 16, flac_seed);
if (is_err(flac_len) == 1) { flac_len = 0; }

var aac_seed = alloc(16384);
var aac_len = aac_encode(seed_pcm, 44100, 1, 64000, aac_seed);
if (is_err(aac_len) == 1) { aac_len = 0; }

syscall(1, 1, "  seeds: wav=", 13); fmt_int(wav_len);
syscall(1, 1, " aiff=", 6); fmt_int(aiff_len);
syscall(1, 1, " flac=", 6); fmt_int(flac_len);
syscall(1, 1, " aac=", 5); fmt_int(aac_len);
syscall(1, 1, " bytes\n", 7);

# ================================================================
# Target: codec_open — the unified dispatch, the real attack surface
# ================================================================
syscall(1, 1, "  codec_open (random+magic)... ", 31);
var fi = 0;
while (fi < iters) {
    var sz = _fz_u(max_size - 16) + 16;
    var which = _fz_u(7);
    if (which == 0) { _fz_fill_magic(buf, sz, m_riff, 4); }
    if (which == 1) { _fz_fill_magic(buf, sz, m_form, 4); }
    if (which == 2) { _fz_fill_magic(buf, sz, m_flac, 4); }
    if (which == 3) { _fz_fill_magic(buf, sz, m_ogg,  4); }
    if (which == 4) { _fz_fill_magic(buf, sz, m_adts, 2); }
    if (which == 5) { _fz_fill_magic(buf, sz, m_ftyp, 8); }
    if (which == 6) { _fz_fill(buf, sz); }
    codec_open(buf, sz);
    fi = fi + 1; total = total + 1;
}
syscall(1, 1, "ok\n", 3);

# ================================================================
# Target: WAV — random-behind-magic, then valid-seed mutation
# ================================================================
syscall(1, 1, "  wav_decode... ", 16);
fi = 0;
while (fi < iters) {
    var sz = _fz_u(max_size - 44) + 44;
    _fz_fill_magic(buf, sz, m_riff, 4);
    wav_decode(buf, sz);
    fi = fi + 1; total = total + 1;
}
if (wav_len > 0) {
    fi = 0;
    while (fi < iters) {
        var n = _fz_mutate(buf, wav_seed, wav_len, _fz_u(6) + 1);
        wav_decode(buf, n);
        fi = fi + 1; total = total + 1;
    }
}
syscall(1, 1, "ok\n", 3);

# ================================================================
# Target: AIFF
# ================================================================
syscall(1, 1, "  aiff_decode... ", 17);
fi = 0;
while (fi < iters) {
    var sz = _fz_u(max_size - 54) + 54;
    _fz_fill_magic(buf, sz, m_form, 4);
    aiff_decode(buf, sz);
    fi = fi + 1; total = total + 1;
}
if (aiff_len > 0) {
    fi = 0;
    while (fi < iters) {
        var n = _fz_mutate(buf, aiff_seed, aiff_len, _fz_u(6) + 1);
        aiff_decode(buf, n);
        fi = fi + 1; total = total + 1;
    }
}
syscall(1, 1, "ok\n", 3);

# ================================================================
# Target: FLAC full decode (not just metadata) + range decode
# ================================================================
syscall(1, 1, "  flac_decode... ", 17);
fi = 0;
while (fi < iters) {
    var sz = _fz_u(max_size - 42) + 42;
    _fz_fill_magic(buf, sz, m_flac, 4);
    flac_decode(buf, sz);
    fi = fi + 1; total = total + 1;
}
if (flac_len > 0) {
    fi = 0;
    while (fi < iters) {
        var n = _fz_mutate(buf, flac_seed, flac_len, _fz_u(6) + 1);
        flac_decode(buf, n);
        flac_decode_range(buf, n, _fz_u(512), _fz_u(512) + 1);
        fi = fi + 1; total = total + 2;
    }
}
syscall(1, 1, "ok\n", 3);

# ================================================================
# Target: ALAC (roadmap says the decoder is unreachable via dispatch —
# fuzz it directly so it is hardened before it is wired up)
# ================================================================
syscall(1, 1, "  alac_decode... ", 17);
fi = 0;
while (fi < iters) {
    var sz = _fz_u(max_size - 16) + 16;
    _fz_fill(buf, sz);
    alac_decode(buf, sz);
    fi = fi + 1; total = total + 1;
}
syscall(1, 1, "ok\n", 3);

# ================================================================
# Target: MP3 full decode
# ================================================================
syscall(1, 1, "  mp3_decode... ", 16);
fi = 0;
while (fi < iters) {
    var sz = _fz_u(max_size - 4) + 4;
    _fz_fill_magic(buf, sz, m_mp3, 2);
    mp3_decode(buf, sz);
    mp3_decode_pcm(buf, sz);
    fi = fi + 1; total = total + 2;
}
syscall(1, 1, "ok\n", 3);

# ================================================================
# Target: Ogg full decode (drives the Opus packet path)
# ================================================================
syscall(1, 1, "  ogg_decode... ", 16);
fi = 0;
while (fi < iters) {
    var sz = _fz_u(max_size - 27) + 27;
    _fz_fill_magic(buf, sz, m_ogg, 4);
    ogg_decode(buf, sz);
    fi = fi + 1; total = total + 1;
}
syscall(1, 1, "ok\n", 3);

# ================================================================
# Target: MP4 demux + decode (box-tree walk on hostile sizes)
# ================================================================
syscall(1, 1, "  mp4_decode... ", 16);
fi = 0;
while (fi < iters) {
    var sz = _fz_u(max_size - 16) + 16;
    _fz_fill_magic(buf, sz, m_ftyp, 8);
    mp4_demux(buf, sz);
    mp4_decode(buf, sz);
    fi = fi + 1; total = total + 2;
}
syscall(1, 1, "ok\n", 3);

# ================================================================
# Target: AAC (ADTS)
# ================================================================
syscall(1, 1, "  aac_decode... ", 16);
fi = 0;
while (fi < iters) {
    var sz = _fz_u(max_size - 7) + 7;
    _fz_fill_magic(buf, sz, m_adts, 2);
    aac_decode(buf, sz);
    fi = fi + 1; total = total + 1;
}
if (aac_len > 0) {
    fi = 0;
    while (fi < iters) {
        var n = _fz_mutate(buf, aac_seed, aac_len, _fz_u(6) + 1);
        aac_decode(buf, n);
        fi = fi + 1; total = total + 1;
    }
}
syscall(1, 1, "ok\n", 3);

# ================================================================
# Target: real encoder output
# ================================================================
# Every seed above comes from shravan's own encoders, which never write FLAC LPC,
# ALAC, TNS, short blocks or an esds, so mutating them cannot reach those paths.
# These seeds are ffmpeg, flac and lame output. A decode here costs far more than the
# targets above in time and in memory that alloc() never frees, so each runs once
# per `every` iterations (a power of two). AAC runs least: about 0.1 s a frame.
var real_buf = alloc(65536);

# Feed n bytes to decode_reader in random pieces (1..512 bytes, so headers, frames
# and samples split everywhere) with a random chunk size, then flush.
fn _fz_stream(data, n) {
    var dr = decode_reader(_fz_u(300));
    var pos = 0;
    while (pos < n) {
        var take = _fz_u(512) + 1;
        if (take > n - pos) { take = n - pos; }
        decode_reader_feed(dr, data + pos, take);
        pos = pos + take;
    }
    decode_reader_flush(dr);
    return 0;
}

# Opus: a fixture's libopus packets (u32le length each) behind a synthesized
# OpusHead, then damaged: bytes flipped, packets cut short, emptied (a loss),
# dropped or repeated, the TOC byte replaced. Mono or stereo at random.
var _fz_opus_pk = 0;
var _fz_opus_n = 0;
fn _fz_opus_load(b64) {
    var raw = alloc(strlen(b64) + 16);
    var len = _mp3_b64_decode(b64, raw);
    _fz_opus_pk = vec_new();
    var pos = 0;
    while (pos + 4 <= len) {
        var n = read_u32_le(raw, pos);
        pos = pos + 4;
        if (pos + n > len) { pos = len; }
        else {
            if (vec_len(_fz_opus_pk) < 24) { vec_push(_fz_opus_pk, str_from_buf(raw + pos, n)); }
            pos = pos + n;
        }
    }
    _fz_opus_n = vec_len(_fz_opus_pk);
    return 0;
}

fn _fz_opus_once() {
    var channels = _fz_u(2) + 1;
    var head = alloc(19);
    memset(head, 0, 19);
    memcpy(head, "OpusHead", 8);
    store8(head + 8, 1);
    store8(head + 9, channels);
    write_u32_le(head, 10, _fz_u(400));
    write_u32_le(head, 12, 48000);
    var tags = alloc(16);
    memset(tags, 0, 16);
    memcpy(tags, "OpusTags", 8);
    var pk = vec_new();
    vec_push(pk, str_from_buf(head, 19));
    vec_push(pk, str_from_buf(tags, 16));
    var i = 0;
    while (i < _fz_opus_n) {
        var src = vec_get(_fz_opus_pk, i);
        var n = str_len(src);
        var what = _fz_u(16);
        if (what == 0) { n = 0; }                       # lost
        if (what == 1) { n = _fz_u(n + 1); }            # cut short
        if (what == 2) { i = i + 1; }                   # dropped (next one skipped too)
        var b = alloc(n + 4);
        if (n > 0) { memcpy(b, str_data(src), n); }
        if (what == 3) { if (n > 0) { store8(b, _fz_u(256)); } }   # TOC replaced
        if (what >= 4) {
            if (what < 8) {
                var k = _fz_u(4) + 1;
                while (k > 0) { if (n > 0) { store8(b + _fz_u(n), _fz_u(256)); } k = k - 1; }
            }
        }
        vec_push(pk, str_from_buf(b, n));
        if (what == 9) { vec_push(pk, str_from_buf(b, n)); }       # repeated
        i = i + 1;
    }
    opus_decode_from_packets(pk, 0, 0);
    return 0;
}

fn _fz_opus(b64, every) {
    _fz_opus_load(b64);
    var i = 0;
    var calls = 0;
    while (i < iters) {
        if ((i & (every - 1)) == 0) { _fz_opus_once(); calls = calls + 1; }
        i = i + 1;
    }
    return calls;
}

fn _fz_real(b64, kind, every, max_len) {
    var seed = alloc(strlen(b64) + 16);
    var slen = _mp3_b64_decode(b64, seed);
    if (max_len > 0) { if (slen > max_len) { slen = max_len; } }
    if (slen > 65536) { return 0; }
    var i = 0;
    var calls = 0;
    while (i < iters) {
        if ((i & (every - 1)) == 0) {
            var n = _fz_mutate(real_buf, seed, slen, _fz_u(6) + 1);
            if (kind == 0) { codec_open(real_buf, n); }
            if (kind == 1) { aac_decode(real_buf, n); }
            if (kind == 2) { mp3_decode_pcm(real_buf, n); }
            if (kind == 3) { flac_verify(real_buf, n); }
            if (kind == 4) { flac_decode_range(real_buf, n, _fz_u(20000), _fz_u(20000)); }
            if (kind == 5) { tag_read_id3v2(real_buf, n); }
            if (kind == 6) { _fz_stream(real_buf, n); }
            calls = calls + 1;
        }
        i = i + 1;
    }
    return calls;
}
syscall(1, 1, "  real encoder seeds... ", 24);
total = total + _fz_real(_FX_FLAC16_B64, 0, 4, 0);
total = total + _fz_real(_FX_FLAC16_B64, 3, 4, 0);
total = total + _fz_real(_FX_FLAC8_B64, 0, 4, 0);
total = total + _fz_real(_FX_ALAC16_B64, 0, 4, 0);
total = total + _fz_real(_FX_ALAC24_B64, 0, 4, 0);
total = total + _fz_real(_FX_ALACMOV_B64, 0, 4, 0);
# AAC ran every 32nd iteration on 700 bytes while it decoded at about real time;
# since 2.9.3's transforms it is some fifty times faster and runs like the rest.
total = total + _fz_real(_FX_AAC22_B64, 1, 4, 0);
total = total + _fz_real(_FX_AAC96_B64, 0, 4, 0);
total = total + _fz_real(_FX_MP38_B64, 2, 4, 0);
total = total + _fz_real(_FX_MP344_B64, 2, 4, 0);
# 2.9.3's fixtures: WAV/AIFF as ffmpeg writes them, FLAC at 32 bits and with a
# seek table (also through flac_decode_range), the ISO MPEG conformance excerpts,
# a LAME Info frame, Ogg Opus with an output gain.
total = total + _fz_real(_FX_WAV24_B64, 0, 2, 0);
total = total + _fz_real(_FX_WAVF32_B64, 0, 2, 0);
total = total + _fz_real(_FX_WAVEXT_B64, 0, 2, 0);
total = total + _fz_real(_FX_WAVPIPE_B64, 0, 2, 0);
total = total + _fz_real(_FX_WAV12_B64, 0, 2, 0);
total = total + _fz_real(_FX_AIFF16_B64, 0, 2, 0);
total = total + _fz_real(_FX_AIFF12_B64, 0, 2, 0);
total = total + _fz_real(_FX_AIFCF32_B64, 0, 2, 0);
total = total + _fz_real(_FX_FLAC32_B64, 0, 4, 0);
total = total + _fz_real(_FX_FLACSEEK_B64, 0, 4, 0);
total = total + _fz_real(_FX_FLACSEEK_B64, 4, 4, 0);
total = total + _fz_real(_FX_ISOL1JS_B64, 0, 8, 0);
total = total + _fz_real(_FX_ISOL2JS_B64, 0, 8, 0);
total = total + _fz_real(_FX_ISOLSFIS_B64, 0, 8, 0);
total = total + _fz_real(_FX_ISOFREE_B64, 0, 8, 0);
total = total + _fz_real(_FX_MP3INFO_B64, 0, 8, 0);
total = total + _fz_real(_FX_OGGGAIN_B64, 0, 8, 0);
syscall(1, 1, "ok\n", 3);

# ================================================================
# Target: streaming decoders (decode_reader, random splits)
# ================================================================
syscall(1, 1, "  streams... ", 13);
total = total + _fz_real(_FX_WAV24_B64, 6, 2, 0);
total = total + _fz_real(_FX_WAVPIPE_B64, 6, 2, 0);
total = total + _fz_real(_FX_AIFF16_B64, 6, 2, 0);
total = total + _fz_real(_FX_AIFCF32_B64, 6, 2, 0);
total = total + _fz_real(_FX_FLAC16_B64, 6, 4, 0);
total = total + _fz_real(_FX_FLACSEEK_B64, 6, 4, 0);
syscall(1, 1, "ok\n", 3);

# ================================================================
# Target: ID3v2 with compressed, grouped and encrypted frames (sankoch inflate)
# ================================================================
syscall(1, 1, "  tag_read_id3v2 compressed... ", 31);
total = total + _fz_real(_FX_ID3V23Z_B64, 5, 1, 0);
total = total + _fz_real(_FX_ID3V24Z_B64, 5, 1, 0);
syscall(1, 1, "ok\n", 3);

# ================================================================
# Target: Opus on libopus packets
# ================================================================
# Sequences of 24 packets, for the mode, bandwidth and loss transitions; the many
# short calls are fuzz/fuzz_opus.cyr's.
syscall(1, 1, "  opus packets... ", 18);
total = total + _fz_opus(_FX_OPUS25_B64, 16);
total = total + _fz_opus(_FX_OPUSFEC_B64, 16);
total = total + _fz_opus(_FX_OPUSHFEC_B64, 16);
total = total + _fz_opus(_FX_OPUSSW_B64, 16);
total = total + _fz_opus(_FX_OPUSPLC_B64, 16);
total = total + _fz_opus(_FX_OPUSDTX_B64, 16);
total = total + _fz_opus(_FX_OPUSC2S_B64, 16);
syscall(1, 1, "ok\n", 3);

# ================================================================
# Target: Vorbis comment (attacker-controlled length vector)
# ================================================================
syscall(1, 1, "  tag_read_vorbis... ", 21);
fi = 0;
while (fi < iters) {
    var sz = _fz_u(max_size - 8) + 8;
    _fz_fill(buf, sz);
    tag_read_vorbis(buf, sz);
    fi = fi + 1; total = total + 1;
}
syscall(1, 1, "ok\n", 3);

