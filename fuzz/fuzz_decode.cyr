                var cfg = toc >> 3;
                var fd = 0;
                if (cfg < 12) { fd = load64(_sk_ints("480,960,1920,2880", 4) + (cfg & 3) * 8); }
                else {
                    if (cfg < 16) { fd = 480 << (cfg & 1); }
                    else { fd = 120 << (cfg & 3); }
                }
                var cnt = 1;
                if ((toc & 3) == 1 || (toc & 3) == 2) { cnt = 2; }
                if ((toc & 3) == 3) {
                    if (r < 2) { oe_bad = 37; }
                    else { cnt = load8(oe_buf + 1) & 0x3F; }
                }
                # the frame coded: the TOC says the selected duration
                if (cnt * fd != oe_sel * 48000 / oe_fs) { oe_bad = 38; }
                oe_dur = oe_dur + cnt * fd;
                vec_push(oe_pk, str_from_buf(oe_buf, r));
            }
            p = p + 1;
        }
        if (oe_bad == 0 && vec_len(oe_pk) > 2) {
            var oe_r = opus_decode_from_packets(oe_pk, 0, 0);
            if (is_err(oe_r) == 1) { oe_bad = 39; }
            else {
                var oe_d = decode_result_samples(oe_r);
                if (vec_len(oe_d) != oe_dur * oe_ch) { oe_bad = 40; }
                var q2 = 0;
                while (oe_bad == 0 && q2 < vec_len(oe_d)) {
                    var dv = vec_get(oe_d, q2);
                    if (f64_eq(dv, dv) == 0) { oe_bad = 41; }
                    q2 = q2 + 1;
                }
            }
        }
    }
    if (oe_bad != 0) {
        syscall(1, 1, "opus encode failed: ", 20);
        fmt_int(oe_bad);
        syscall(1, 1, " fs ", 4);
        fmt_int(oe_fs);
        syscall(1, 1, " ch ", 4);
        fmt_int(oe_ch);
        syscall(1, 1, " app ", 5);
        fmt_int(oe_app);
        syscall(1, 1, "\n", 1);
        syscall(60, 89);
    }
    fi = fi + 1; total = total + 2;
}
syscall(1, 1, "ok\n", 3);

# ================================================================
# Target: the CELT encoder (2.12.4, libopus's celt_encode_with_ec): any rate
# and channel count (refused but at the five rates and one or two channels);
# every ctl now and then, in and out of its bounds (refused exactly outside
# them); frames of every size the encoder takes, and others (refused); buffers
# from none to past 1,275 bytes; the hybrid's start band after random bits in
# the range coder; the tonality analysis's info, the surround energy mask,
# resets; hostile input (NaN, infinities, huge, denormal, full-scale square
# and pulses, clipping). Every frame within its buffer (at most 1,275 bytes),
# nothing written past it, and the fullband frames played back through
# shravan's Opus decoder as libopus would (a CELT-only TOC). Since 2.12.5:
# analysis info with a float not finite in single precision (refused), a start
# band at or past the end band (the frame refused), the caller's coder larger
# than max (shrunk to it) or smaller (refused), no samples (refused). A
# violation exits 90.
# ================================================================
syscall(1, 1, "  celt_encode... ", 17);
var ce_info = alloc(_CEA_SIZE);

var ce_mask = alloc(42 * 8);
var ce_iters = iters / 8;
if (ce_iters < 1) { ce_iters = 1; }
fi = 0;
while (fi < ce_iters) {
    var ce_fs = 48000;
    var cfs = _fz_u(7);
    if (cfs == 1) { ce_fs = 8000; }
    if (cfs == 2) { ce_fs = 12000; }
    if (cfs == 3) { ce_fs = 16000; }
    if (cfs == 4) { ce_fs = 24000; }
    if (cfs == 5 && _fz_u(4) == 0) { ce_fs = _fz_u(100000); }
    var ce_ch = 1 + _fz_u(2);
    if (_fz_u(20) == 0) { ce_ch = _fz_u(2) * 3; }
    var ce_valid = 1;
    if (ce_fs != 8000 && ce_fs != 12000 && ce_fs != 16000 && ce_fs != 24000 && ce_fs != 48000) { ce_valid = 0; }
    if (ce_ch != 1 && ce_ch != 2) { ce_valid = 0; }
    var ce_e = celt_encoder_new(ce_fs, ce_ch);
    var ce_bad = 0;
    if ((is_err(ce_e) == 1) != (ce_valid == 0)) { ce_bad = 1; }
    if (ce_bad == 0 && ce_valid == 1) {
        var ce_up = 48000 / ce_fs;
        var ce_pk = vec_new();
        store8(se_head + 9, ce_ch);
        vec_push(ce_pk, str_from_buf(se_head, 19));
        vec_push(ce_pk, str_from_buf(se_tags, 16));
        var ce_dur = 0;
        var ce_c = ce_ch;
        var ce_start = 0;
        var ce_end = 21;
        var ce_lm = 3;
        var ce_shape = _fz_u(9);
        var p = 0;
        var np = 1 + _fz_u(4);
        while (p < np && ce_bad == 0) {
            var ck = _fz_u(16);
            if (ck == 0) {
                var v = _fz_u(14) - 2;
                if ((is_err(celt_encoder_set_complexity(ce_e, v)) == 1) != (v < 0 || v > 10)) { ce_bad = 2; }
            }
            if (ck == 1) {
                var v = _fz_u(24) - 2;
                if (_fz_u(3) == 0) { v = 0; }
                if ((is_err(celt_encoder_set_start_band(ce_e, v)) == 1) != (v < 0 || v >= 21)) { ce_bad = 3; }
                if (v >= 0 && v < 21) { ce_start = v; }
            }
            if (ck == 2) {
                var v = _fz_u(24) - 1;
                if (_fz_u(2) == 0) { v = 21; }
                if ((is_err(celt_encoder_set_end_band(ce_e, v)) == 1) != (v < 1 || v > 21)) { ce_bad = 4; }
                if (v >= 1 && v <= 21) { ce_end = v; }
            }
            if (ck == 3) {
                var v = _fz_u(5) - 1;
                if ((is_err(celt_encoder_set_prediction(ce_e, v)) == 1) != (v < 0 || v > 2)) { ce_bad = 5; }
            }
            if (ck == 4) {
                var v = _fz_u(110) - 3;
                if ((is_err(celt_encoder_set_packet_loss(ce_e, v)) == 1) != (v < 0 || v > 100)) { ce_bad = 6; }
            }
            if (ck == 5) { celt_encoder_set_vbr(ce_e, _fz_u(2)); celt_encoder_set_vbr_constraint(ce_e, _fz_u(2)); }
            if (ck == 6) {
                var v = _fz_u(600000) - 2;
                if (_fz_u(4) == 0) { v = 0 - 1; }
                if ((is_err(celt_encoder_set_bitrate(ce_e, v)) == 1) != (v <= 500 && v != 0 - 1)) { ce_bad = 7; }
            }
            if (ck == 7) {
                var v = _fz_u(4);
                if ((is_err(celt_encoder_set_channels(ce_e, v)) == 1) != (v < 1 || v > ce_ch)) { ce_bad = 8; }
                if (v >= 1 && v <= ce_ch) { ce_c = v; }
            }
            if (ck == 8) {
                var v = _fz_u(20) + 6;
                if ((is_err(celt_encoder_set_lsb_depth(ce_e, v)) == 1) != (v < 8 || v > 24)) { ce_bad = 9; }
            }
            if (ck == 9) {
                var v = _fz_u(4) - 1;
                if ((is_err(celt_encoder_set_phase_inversion_disabled(ce_e, v)) == 1) != (v < 0 || v > 1)) { ce_bad = 10; }
            }
            if (ck == 10) { celt_encoder_set_lfe(ce_e, _fz_u(2)); }
            if (ck == 11) {
                memset(ce_info, 0, _CEA_SIZE);
                store64(ce_info + _CEA_VALID, _fz_u(2));
                var ak = _CEA_TONALITY;
                while (ak <= _CEA_MAX_PITCH_RATIO) { store64(ce_info + ak, f64_div(f64_from(_fz_u(2001) - 1000), f64_from(500))); ak = ak + 8; }
                store64(ce_info + _CEA_BANDWIDTH, _fz_u(25) - 2);
                var lb = 0;
                while (lb < 19) { store64(ce_info + _CEA_LEAK_BOOST + lb * 8, _fz_u(256)); lb = lb + 1; }
                # now and then a float that is not finite in single precision: refused (2.12.5)
                var ce_nf = 0;
                if (_fz_u(4) == 0) {
                    var fk = _CEA_TONALITY + 8 * _fz_u(10);
                    if (fk == _CEA_BANDWIDTH) { fk = _CEA_MAX_PITCH_RATIO; }
                    var fv = _fz_u(4);
                    var bits = 0x7FF8000000000000;
                    if (fv == 1) { bits = 0x7FF0000000000000; }
                    if (fv == 2) { bits = 0xFFF0000000000000; }
                    if (fv == 3) { bits = 0x7E37E43C8800759C; }
                    store64(ce_info + fk, bits);
                    ce_nf = 1;
                }
                if ((is_err(celt_encoder_set_analysis(ce_e, ce_info)) == 1) != (ce_nf == 1)) { ce_bad = 18; }
            }
            if (ck == 12) {
                var mi = 0;
                while (mi < 42) { store64(ce_mask + mi * 8, f64_div(f64_from(_fz_u(4001) - 2000), f64_from(200))); mi = mi + 1; }
                celt_encoder_set_energy_mask(ce_e, ce_mask);
            }
            if (ck == 13) { celt_encoder_set_silk_info(ce_e, _fz_u(4) - 1, _fz_u(300) - 50); }
            if (ck == 14 && _fz_u(4) == 0) { celt_encoder_reset(ce_e); }
            # the frame: 2.5 to 20 ms at the encoder's rate, or another size
            var ce_n = (120 << _fz_u(4)) / ce_up;
            var ce_ok = 1;
            if (_fz_u(12) == 0) { ce_n = _fz_u(1000); ce_ok = 0; if (ce_n * ce_up == 120 || ce_n * ce_up == 240 || ce_n * ce_up == 480 || ce_n * ce_up == 960) { ce_ok = 1; } }
            if (ce_n * ce_up > 960 || ce_n <= 0) { ce_ok = 0; }
            var ce_cap = 2 + _fz_u(300);
            if (_fz_u(4) == 0) { ce_cap = _fz_u(1400); }
            if (ce_cap < 2) { ce_ok = 0; }
            # the start band must be below the end band (2.12.5)
            if (ce_start >= ce_end) { ce_ok = 0; }
            var k = 0;
            var ce_len = ce_n;
            if (ce_len < 0 || ce_len > 960) { ce_len = 960; }
            while (k < ce_len * ce_ch) {
                var tt = k / ce_ch;
                var x = f64_div(f64_from(_fz_u(65536) - 32768), f64_from(32768));
                if (ce_shape == 1) { x = f64_div(f64_from(_fz_u(201) - 100), f64_from(3200)); }
                if (ce_shape == 2) { x = F64_ONE; if ((tt & 16) == 16) { x = f64_neg(F64_ONE); } }
                if (ce_shape == 3) { x = F64_ZERO; }
                if (ce_shape == 4) { x = F64_ZERO; if (tt % 97 == 0) { x = F64_ONE; } }
                if (ce_shape == 5) { x = f64_from(_fz_u(400001) - 200000); }
                if (ce_shape == 6) { x = 0x7FF8000000000000; }
                if (ce_shape == 7) { x = f64_div(f64_from(_fz_u(3) - 1), f64_from(1 << 30)); }
                var sp = _fz_u(100);
                if (sp == 0) { x = 0x7FF8000000000000; }
                if (sp == 1) { x = 0x7FF0000000000000; }
                if (sp == 2) { x = 0 - 0x10000000000000; }
                if (sp == 3) { x = f64_from(1000000); }
                if (sp == 4) { x = 1; }
                store64(oe_pcm + k * 8, x);
                k = k + 1;
            }
            var cv = ce_cap;
            if (cv < 0) { cv = 0; }
            var q = 0;
            while (q < 64) { store8(oe_buf + cv + q, 0xA5); q = q + 1; }
            var r = 0;
            var ce_pre = 0;
            var ce_ec = 0;
            if (ce_start > 0 && _fz_u(2) == 0 && ce_ok == 1) {
                ce_pre = 1;
                # the caller's coder: max's bytes, more (shrunk to them), or too few (refused)
                var ce_nb = ce_cap;
                if (ce_nb > 1275) { ce_nb = 1275; }
                var ce_store = ce_cap;
                var sv = _fz_u(4);
                if (sv == 0) { ce_store = ce_cap + _fz_u(3000); }
                if (sv == 1 && ce_nb > 2) { ce_store = ce_nb - 1 - _fz_u(ce_nb - 2); ce_ok = 0; }
                var ec = ec_enc_new(oe_buf, ce_store);
                ce_ec = ec;
                var nb = _fz_u(64);
                var bi = 0;
                while (bi < nb) { ec_enc_bit_logp(ec, _fz_u(2), 1 + _fz_u(4)); bi = bi + 1; }
                # pre-written bytes past the frame's are refused too
                if (load64(ec + 48) + load64(ec + 16) > ce_nb) { ce_ok = 0; }
                r = celt_encoder_encode_ec(ce_e, oe_pcm, ce_n, ce_cap, ec);
            } else {
                r = celt_encoder_encode(ce_e, oe_pcm, ce_n, oe_buf, ce_cap);
            }
            if (_fz_u(50) == 0 && celt_encoder_encode(ce_e, 0, ce_n, oe_buf, ce_cap) != err(ERR_ENCODE)) { ce_bad = 19; }
            var lim = ce_cap;
            if (lim > 1275) { lim = 1275; }
            # pre-written bits that leave the frame no room overflow the coder:
            # refused, as libopus's celt_encode_with_ec returns OPUS_INTERNAL_ERROR
            # on the coder's error
            if (ce_ok == 1 && ce_pre == 1 && r == err(ERR_ENCODE) && load64(ce_ec + 88) != 0) { ce_ok = 0; }
            if (ce_ok == 1) {
                if (r < 0 || r > lim) { ce_bad = 11; }
                if (ce_pre == 0 && r < 2) { ce_bad = 12; }
            } else {
                if (r != err(ERR_ENCODE)) { ce_bad = 13; }
            }
            q = 0;
            while (q < 64) { if (load8(oe_buf + cv + q) != 0xA5) { ce_bad = 14; } q = q + 1; }
            if (ce_bad == 0 && ce_ok == 1 && ce_pre == 0 && ce_start == 0 && ce_end == 21 && ce_c == ce_ch && r >= 2) {
                var n48 = ce_n * ce_up;
                var lm = 0;
                while ((120 << lm) != n48) { lm = lm + 1; }
                var pk = alloc(r + 1);
                store8(pk, ((28 + lm) << 3) | ((ce_ch - 1) << 2));
                memcpy(pk + 1, oe_buf, r);
                vec_push(ce_pk, str_from_buf(pk, r + 1));
                ce_dur = ce_dur + n48;
            }
            p = p + 1;
        }
        if (ce_bad == 0 && vec_len(ce_pk) > 2) {
            var ce_r = opus_decode_from_packets(ce_pk, 0, 0);
            if (is_err(ce_r) == 1) { ce_bad = 15; }
            else {
                var ce_d = decode_result_samples(ce_r);
                if (vec_len(ce_d) != ce_dur * ce_ch) { ce_bad = 16; }
                var q2 = 0;
                while (ce_bad == 0 && q2 < vec_len(ce_d)) {
                    var dv = vec_get(ce_d, q2);
                    if (f64_eq(dv, dv) == 0) { ce_bad = 17; }
                    q2 = q2 + 1;
                }
            }
        }
    }
    if (ce_bad != 0) {
        syscall(1, 1, "celt encode failed: ", 20);
        fmt_int(ce_bad);
        syscall(1, 1, " fs ", 4);
        fmt_int(ce_fs);
        syscall(1, 1, " ch ", 4);
        fmt_int(ce_ch);
        syscall(1, 1, "\n", 1);
        syscall(60, 90);
    }
    fi = fi + 1; total = total + 2;
}
syscall(1, 1, "ok\n", 3);

# ================================================================
# Target: ALAC (roadmap says the decoder is unreachable via dispatch —
# fuzz it directly so it is hardened before it is wired up)
# ================================================================
syscall(1, 1, "  alac_decode... ", 17);
fi = 0;
while (fi < iters) {
    var sz = _fz_u(max_size - 16) + 16;
    _fz_fill(buf, sz);
    alac_decode(buf, sz);
    fi = fi + 1; total = total + 1;
}
syscall(1, 1, "ok\n", 3);

# ================================================================
# Target: MP3 full decode
# ================================================================
syscall(1, 1, "  mp3_decode... ", 16);
fi = 0;
while (fi < iters) {
    var sz = _fz_u(max_size - 4) + 4;
    _fz_fill_magic(buf, sz, m_mp3, 2);
    mp3_decode(buf, sz);
    mp3_decode_pcm(buf, sz);
    fi = fi + 1; total = total + 2;
}
syscall(1, 1, "ok\n", 3);

# ================================================================
# Target: Ogg full decode (drives the Opus packet path)
# ================================================================
syscall(1, 1, "  ogg_decode... ", 16);
fi = 0;
while (fi < iters) {
    var sz = _fz_u(max_size - 27) + 27;
    _fz_fill_magic(buf, sz, m_ogg, 4);
    ogg_decode(buf, sz);
    fi = fi + 1; total = total + 1;
}
syscall(1, 1, "ok\n", 3);

# ================================================================
# Target: MP4 demux + decode (box-tree walk on hostile sizes)
# ================================================================
syscall(1, 1, "  mp4_decode... ", 16);
fi = 0;
while (fi < iters) {
    var sz = _fz_u(max_size - 16) + 16;
    _fz_fill_magic(buf, sz, m_ftyp, 8);
    mp4_demux(buf, sz);
    mp4_decode(buf, sz);
    fi = fi + 1; total = total + 2;
}
syscall(1, 1, "ok\n", 3);

# ================================================================
# Target: AAC (ADTS)
# ================================================================
syscall(1, 1, "  aac_decode... ", 16);
fi = 0;
while (fi < iters) {
    var sz = _fz_u(max_size - 7) + 7;
    _fz_fill_magic(buf, sz, m_adts, 2);
    aac_decode(buf, sz);
    fi = fi + 1; total = total + 1;
}
if (aac_len > 0) {
    fi = 0;
    while (fi < iters) {
        var n = _fz_mutate(buf, aac_seed, aac_len, _fz_u(6) + 1);
        aac_decode(buf, n);
        fi = fi + 1; total = total + 1;
    }
}
syscall(1, 1, "ok\n", 3);

# ================================================================
# Target: real encoder output
# ================================================================
# Every seed above comes from shravan's own encoders, which never write FLAC LPC,
# ALAC, TNS, short blocks or an esds, so mutating them cannot reach those paths.
# These seeds are ffmpeg, flac and lame output. A decode here costs far more than the
# targets above in time and in memory that alloc() never frees, so each runs once
# per `every` iterations (a power of two). AAC runs least: about 0.1 s a frame.
var real_buf = alloc(65536);

# Feed n bytes to decode_reader in random pieces (1..512 bytes, so headers, frames
# and samples split everywhere) with a random chunk size, then flush.
fn _fz_stream(data, n) {
    var dr = decode_reader(_fz_u(300));
    var pos = 0;
    while (pos < n) {
        var take = _fz_u(512) + 1;
        if (take > n - pos) { take = n - pos; }
        decode_reader_feed(dr, data + pos, take);
        pos = pos + take;
    }
    decode_reader_flush(dr);
    return 0;
}

# Opus: a fixture's libopus packets (u32le length each) behind a synthesized
# OpusHead, then damaged: bytes flipped, packets cut short, emptied (a loss),
# dropped or repeated, the TOC byte replaced. Mono or stereo at random.
var _fz_opus_pk = 0;
var _fz_opus_n = 0;
fn _fz_opus_load(b64) {
    var raw = alloc(strlen(b64) + 16);
    var len = _mp3_b64_decode(b64, raw);
    _fz_opus_pk = vec_new();
    var pos = 0;
    while (pos + 4 <= len) {
        var n = read_u32_le(raw, pos);
        pos = pos + 4;
        if (pos + n > len) { pos = len; }
        else {
            if (vec_len(_fz_opus_pk) < 24) { vec_push(_fz_opus_pk, str_from_buf(raw + pos, n)); }
            pos = pos + n;
        }
    }
    _fz_opus_n = vec_len(_fz_opus_pk);
    return 0;
}

fn _fz_opus_once() {
    var channels = _fz_u(2) + 1;
    var head = alloc(19);
    memset(head, 0, 19);
    memcpy(head, "OpusHead", 8);
    store8(head + 8, 1);
    store8(head + 9, channels);
    write_u32_le(head, 10, _fz_u(400));
    write_u32_le(head, 12, 48000);
    var tags = alloc(16);
    memset(tags, 0, 16);
    memcpy(tags, "OpusTags", 8);
    var pk = vec_new();
    vec_push(pk, str_from_buf(head, 19));
    vec_push(pk, str_from_buf(tags, 16));
    var i = 0;
    while (i < _fz_opus_n) {
        var src = vec_get(_fz_opus_pk, i);
        var n = str_len(src);
        var what = _fz_u(16);
        if (what == 0) { n = 0; }                       # lost
        if (what == 1) { n = _fz_u(n + 1); }            # cut short
        if (what == 2) { i = i + 1; }                   # dropped (next one skipped too)
        var b = alloc(n + 4);
        if (n > 0) { memcpy(b, str_data(src), n); }
        if (what == 3) { if (n > 0) { store8(b, _fz_u(256)); } }   # TOC replaced
        if (what >= 4) {
            if (what < 8) {
                var k = _fz_u(4) + 1;
                while (k > 0) { if (n > 0) { store8(b + _fz_u(n), _fz_u(256)); } k = k - 1; }
            }
        }
        vec_push(pk, str_from_buf(b, n));
        if (what == 9) { vec_push(pk, str_from_buf(b, n)); }       # repeated
        i = i + 1;
    }
    opus_decode_from_packets(pk, 0, 0);
    return 0;
}

fn _fz_opus(b64, every) {
    _fz_opus_load(b64);
    var i = 0;
    var calls = 0;
    while (i < iters) {
        if ((i & (every - 1)) == 0) { _fz_opus_once(); calls = calls + 1; }
        i = i + 1;
    }
    return calls;
}

fn _fz_real(b64, kind, every, max_len) {
    var seed = alloc(strlen(b64) + 16);
    var slen = _mp3_b64_decode(b64, seed);
    if (max_len > 0) { if (slen > max_len) { slen = max_len; } }
    if (slen > 65536) { return 0; }
    var i = 0;
    var calls = 0;
    while (i < iters) {
        if ((i & (every - 1)) == 0) {
            var n = _fz_mutate(real_buf, seed, slen, _fz_u(6) + 1);
            if (kind == 0) { codec_open(real_buf, n); }
            if (kind == 1) { aac_decode(real_buf, n); }
            if (kind == 2) { mp3_decode_pcm(real_buf, n); }
            if (kind == 3) { flac_verify(real_buf, n); }
            if (kind == 4) { flac_decode_range(real_buf, n, _fz_u(20000), _fz_u(20000)); }
            if (kind == 5) { tag_read_id3v2(real_buf, n); }
            if (kind == 6) { _fz_stream(real_buf, n); }
            if (kind == 7) {
                # the MP4 track API: count, default, info and decode by index
                mp4_track_count(real_buf, n);
                mp4_default_track(real_buf, n);
                mp4_track_info(real_buf, n, _fz_u(4));
                mp4_decode_track(real_buf, n, _fz_u(4));
            }
            calls = calls + 1;
        }
        i = i + 1;
    }
    return calls;
}
syscall(1, 1, "  real encoder seeds... ", 24);
total = total + _fz_real(_FX_FLAC16_B64, 0, 4, 0);
total = total + _fz_real(_FX_FLAC16_B64, 3, 4, 0);
total = total + _fz_real(_FX_FLAC8_B64, 0, 4, 0);
total = total + _fz_real(_FX_ALAC16_B64, 0, 4, 0);
total = total + _fz_real(_FX_ALAC24_B64, 0, 4, 0);
total = total + _fz_real(_FX_ALACMOV_B64, 0, 4, 0);
# AAC ran every 32nd iteration on 700 bytes while it decoded at about real time;
# since 2.9.3's transforms it is some fifty times faster and runs like the rest.
total = total + _fz_real(_FX_AAC22_B64, 1, 4, 0);
total = total + _fz_real(_FX_AAC96_B64, 0, 4, 0);
total = total + _fz_real(_FX_MP38_B64, 2, 4, 0);
total = total + _fz_real(_FX_MP344_B64, 2, 4, 0);
# 2.9.3's fixtures: WAV/AIFF as ffmpeg writes them, FLAC at 32 bits and with a
# seek table (also through flac_decode_range), the ISO MPEG conformance excerpts,
# a LAME Info frame, Ogg Opus with an output gain.
total = total + _fz_real(_FX_WAV24_B64, 0, 2, 0);
total = total + _fz_real(_FX_WAVF32_B64, 0, 2, 0);
total = total + _fz_real(_FX_WAVEXT_B64, 0, 2, 0);
total = total + _fz_real(_FX_WAVPIPE_B64, 0, 2, 0);
total = total + _fz_real(_FX_WAV12_B64, 0, 2, 0);
total = total + _fz_real(_FX_AIFF16_B64, 0, 2, 0);
total = total + _fz_real(_FX_AIFF12_B64, 0, 2, 0);
total = total + _fz_real(_FX_AIFCF32_B64, 0, 2, 0);
total = total + _fz_real(_FX_FLAC32_B64, 0, 4, 0);
total = total + _fz_real(_FX_FLACSEEK_B64, 0, 4, 0);
total = total + _fz_real(_FX_FLACSEEK_B64, 4, 4, 0);
total = total + _fz_real(_FX_ISOL1JS_B64, 0, 8, 0);
total = total + _fz_real(_FX_ISOL2JS_B64, 0, 8, 0);
total = total + _fz_real(_FX_ISOLSFIS_B64, 0, 8, 0);
total = total + _fz_real(_FX_ISOFREE_B64, 0, 8, 0);
total = total + _fz_real(_FX_MP3INFO_B64, 0, 8, 0);
# Gapless (2.10.2): edit lists (empty, two edits), iTunSMPB, two tracks, and LAME
# tags at each offset, so mutations reach the elst, stts, udta and tag parsers.
total = total + _fz_real(_FX_GLSMPB_B64, 0, 8, 0);
total = total + _fz_real(_FX_GLSMPBELST_B64, 0, 8, 0);
total = total + _fz_real(_FX_GLEMPTY_B64, 0, 8, 0);
total = total + _fz_real(_FX_GLTWO_B64, 0, 8, 0);
total = total + _fz_real(_FX_GLMULTI_B64, 7, 8, 0);
total = total + _fz_real(_FX_GLMP3LSF_B64, 2, 8, 0);
total = total + _fz_real(_FX_GLMP3CRC_B64, 2, 8, 0);
total = total + _fz_real(_FX_OGGGAIN_B64, 0, 8, 0);
# Multichannel (2.10.3): AAC 5.1 (configuration 6) and 7.1 wide (a PCE in the
# stream) as ADTS; MP4 with a PCE in the AudioSpecificConfig, and configuration
# 12 through the track API; multistream Ogg Opus, families 1, 255 and 2, with
# every self-delimited framing code between them.
total = total + _fz_real(_FX_AACMC51_B64, 1, 8, 0);
total = total + _fz_real(_FX_AACMC71W_B64, 1, 8, 0);
total = total + _fz_real(_FX_AACMC61_B64, 0, 8, 0);
total = total + _fz_real(_FX_AACMC71_B64, 7, 8, 0);
total = total + _fz_real(_FX_OPMS51_B64, 0, 8, 0);
total = total + _fz_real(_FX_OPMSC3_B64, 0, 8, 0);
total = total + _fz_real(_FX_OPMS255_B64, 0, 8, 0);
total = total + _fz_real(_FX_OPMSAMB_B64, 0, 8, 0);
syscall(1, 1, "ok\n", 3);

# ================================================================
# Target: streaming decoders (decode_reader, random splits)
# ================================================================
syscall(1, 1, "  streams... ", 13);
total = total + _fz_real(_FX_WAV24_B64, 6, 2, 0);
total = total + _fz_real(_FX_WAVPIPE_B64, 6, 2, 0);
total = total + _fz_real(_FX_AIFF16_B64, 6, 2, 0);
total = total + _fz_real(_FX_AIFCF32_B64, 6, 2, 0);
total = total + _fz_real(_FX_FLAC16_B64, 6, 4, 0);
total = total + _fz_real(_FX_FLACSEEK_B64, 6, 4, 0);
syscall(1, 1, "ok\n", 3);

# ================================================================
# Target: ID3v2 with compressed, grouped and encrypted frames (sankoch inflate)
# ================================================================
syscall(1, 1, "  tag_read_id3v2 compressed... ", 31);
total = total + _fz_real(_FX_ID3V23Z_B64, 5, 1, 0);
total = total + _fz_real(_FX_ID3V24Z_B64, 5, 1, 0);
syscall(1, 1, "ok\n", 3);

# ================================================================
# Target: Opus on libopus packets
# ================================================================
# Sequences of 24 packets, for the mode, bandwidth and loss transitions; the many
# short calls are fuzz/fuzz_opus.cyr's.
syscall(1, 1, "  opus packets... ", 18);
total = total + _fz_opus(_FX_OPUS25_B64, 16);
total = total + _fz_opus(_FX_OPUSFEC_B64, 16);
total = total + _fz_opus(_FX_OPUSHFEC_B64, 16);
total = total + _fz_opus(_FX_OPUSSW_B64, 16);
total = total + _fz_opus(_FX_OPUSPLC_B64, 16);
total = total + _fz_opus(_FX_OPUSDTX_B64, 16);
total = total + _fz_opus(_FX_OPUSC2S_B64, 16);
syscall(1, 1, "ok\n", 3);

# ================================================================
# Target: Vorbis comment (attacker-controlled length vector)
# ================================================================
syscall(1, 1, "  tag_read_vorbis... ", 21);
fi = 0;
while (fi < iters) {
    var sz = _fz_u(max_size - 8) + 8;
    _fz_fill(buf, sz);
    tag_read_vorbis(buf, sz);
    fi = fi + 1; total = total + 1;
}
syscall(1, 1, "ok\n", 3);

#ifdef CYRIUS_POISON
poison_sweep();
if (poison_violations() != 0) {
    syscall(1, 1, "poison: redzone violations\n", 27);
    syscall(60, 86);
}
#endif

syscall(1, 1, "\nfuzz_decode: ", 14);
fmt_int(total);
syscall(1, 1, " calls, 0 crashes\n", 18);
syscall(60, 0);
