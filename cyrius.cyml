[package]
name = "shravan"
version = "${file:VERSION}"
description = "shravan — audio codecs for AGNOS"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/shravan"
language = "cyrius"
cyrius = "6.3.27"

# [build] entry/output are metadata/convention only — `cyrius build`
# takes explicit <source> <output> positionals (see CI). src/main.cyr is the
# test harness: it `include`s the library (src/shravan.cyr) + codec modules.
[build]
entry = "src/main.cyr"
output = "build/shravan"

# [lib] declares the distlib bundle `cyrius distlib` concatenates into
# dist/shravan.cyr — the consumable library (tarang/jalwa/dhvani/shruti
# include it). src/shravan.cyr (core: error/format/pcm/wav/aiff/alac + codec
# dispatch + decode_file/reader) must come first; the codec modules reference
# its symbols. No test harness, no cross-includes — the bundle is self-contained;
# consumers supply stdlib + bayan + sankoch from their own manifest (see
# dist/shravan.deps). Regenerate with `cyrius distlib`.
[lib]
modules = [
    "src/shravan.cyr",
    "src/flac.cyr",
    "src/ogg.cyr",
    "src/mp3.cyr",
    "src/tag.cyr",
    "src/fft.cyr",
    "src/opus.cyr",
    "src/aac.cyr",
    "src/resample.cyr",
    "src/dither.cyr",
    "src/simd.cyr",
    "src/stream.cyr",
    "src/serde.cyr",
]

# stdlib leaves — the original cyrius.toml set, preserved, with two 6.x updates:
#   - `ganita` ADDED: the transcendentals shravan calls (f64_pow/asin/acos/
#     atan2/sinh/cosh/tanh/hypot) moved OUT of `math` into `ganita` in the 6.x
#     line; without it the build fails on undefined f64_pow.
#   - `json` -> `bayan`: the json stdlib was carved into `bayan` at 6.1.25.
#     `bayan` provides bayan_json_* (parse/get_int/build/…); serde.cyr uses them.
#     bayan's result/io needs resolve via `io` (already listed).
[deps]
stdlib = ["string", "fmt", "alloc", "vec", "str", "syscalls", "io", "args", "assert", "tagged", "math", "ganita", "thread", "fnptr", "bayan"]

[deps.sankoch]
git = "https://github.com/MacCracken/sankoch.git"
tag = "1.0.0"
modules = ["dist/sankoch.cyr"]
