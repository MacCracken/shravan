# scripts/interop/cli.cyr -- command-line access to shravan for the interop sweep.
#
# scripts/interop.py drives this against ffmpeg, flac, lame and libopus. It is a
# dev tool, not part of the library or the [lib] bundle. Build from the repo root:
#
#     cyrius build scripts/interop/cli.cyr build/interop-cli
#
# Commands (sample files are raw little-endian f64, interleaved):
#   decode  <in> <out.f64>                         codec_open; prints "rate ch bits fmt n"
#   stream  <wav|flac|aiff> <in> <out.f64> <chunk> feed <chunk> bytes at a time
#   encode  <in.f64> <kind> <rate> <ch> <arg> <out> [level]
#                                                  kind: wav (arg = bits), wavf32,
#                                                  wavf64, aiff (bits), flac (bits;
#                                                  level 0-8, default 5), aac (arg =
#                                                  bit rate)
#   opusdec <in.pk> <channels> <out.f64>           raw Opus packets, each prefixed by
#                                                  a u32le length; no pre-skip
#   celtenc <in.f64> <channels> <bytes> <out.pk>   20 ms CELT-only frames (config 31)
#   silkenc <in.f64> <rate> <bitrate> <complexity> <ms> <cbr> <out.pk> [raw|opus [cap [loss [fec [dtx [api [ch [sched [rates]]]]]]]]]
#                                                  SILK at the internal rate:
#                                                  Opus packets (silk_encode_opus), or
#                                                  with raw the bare SILK payloads
#                                                  (silk_encode, into cap bytes,
#                                                  default 1275); u32le length each;
#                                                  loss: the packet loss percentage;
#                                                  fec, dtx: 0 or 1; api: the input's
#                                                  rate (default: rate); ch: its
#                                                  channels (interleaved); sched: the
#                                                  packets' coded channels in turn,
#                                                  cycled (1 mono, 2 stereo, 3 stereo
#                                                  with to_mono; default ch); rates:
#                                                  the packets' bit rates in turn,
#                                                  cycled, as rate*count,...
#   celtlib <in.f64> <out.pk> <fs> <ch> [k=v ...]  celt_encoder_encode (libopus's CELT encoder)
#                                                  with scripts/silkref/celtenc.c's keys; toc=1
#                                                  makes each frame an Opus packet (CELT only);
#                                                  out.pk.rng per frame the final range
#   opusenc <in.f64> <out.pk> <fs> <ch> [k=v ...]  opus_encode (RESTRICTED_SILK) with
#                                                  scripts/silkref/opusenc.c's keys; out.pk.rng
#                                                  per packet the final range, bandwidth,
#                                                  in-DTX flag and bit rate (getters)
#   verify  <in.flac>                              flac_verify (STREAMINFO MD5)
#   id3     <in>                                   ID3v2 title
#   tracks  <in.mp4>                               print the audio track count and the
#                                                  default track (mp4_default_track)
#   track   <in.mp4> <index> <out.f64>             mp4_decode_track; prints as decode
#   raw     <in> <out.f64>                         codec_open with gapless off
#   mem     <in>                                   codec_open, then print the sample
#                                                  count and bytes allocated (bump
#                                                  allocator high water)
#
# Exit status: 0 success, 3 shravan returned an error (printed as "ERR <code>"),
# 2 usage or I/O error.

include "src/shravan.cyr"
include "src/flac.cyr"
include "src/ogg.cyr"
include "src/mp3.cyr"
include "src/tag.cyr"
include "src/fft.cyr"
include "src/opus.cyr"
include "src/silk.cyr"
include "src/silk_enc.cyr"
include "src/opus_enc.cyr"
include "src/celt_enc_tables.cyr"
include "src/celt_enc.cyr"
include "src/aac.cyr"
include "src/mp4.cyr"
include "src/resample.cyr"
include "src/dither.cyr"
include "src/simd.cyr"
include "src/stream.cyr"
include "src/serde.cyr"

fn _cli_read(path, out_len) {
    var fd = syscall(2, path, 0, 0);
    if (fd < 0) { return 0; }
    var size = syscall(8, fd, 0, 2);
    syscall(8, fd, 0, 0);
    var buf = alloc(size + 1);
    if (buf == 0) { syscall(3, fd); return 0; }
    var got = 0;
    while (got < size) {
        var r = syscall(0, fd, buf + got, size - got);
        if (r <= 0) { break; }
        got = got + r;
    }
    syscall(3, fd);
    store64(out_len, got);
    return buf;
}

fn _cli_write(path, buf, n) {
    var fd = syscall(2, path, 0x241, 420);
    if (fd < 0) { return -1; }
    var put = 0;
    while (put < n) {
        var w = syscall(1, fd, buf + put, n - put);
        if (w <= 0) { break; }
        put = put + w;
    }
    syscall(3, fd);
    return put;
}

fn _cli_int(v) {
    var neg = 0;
    if (v < 0) { neg = 1; v = 0 - v; }
    var b = alloc(32);
    var p = 31;
    store8(b + p, 32);
    if (v == 0) { p = p - 1; store8(b + p, 48); }
    while (v > 0) { p = p - 1; store8(b + p, 48 + (v % 10)); v = v / 10; }
    if (neg == 1) { p = p - 1; store8(b + p, 45); }
    syscall(1, 1, b + p, 32 - p);
    return 0;
}

fn _cli_nl() { syscall(1, 1, "\n", 1); return 0; }

fn _cli_fail(r) {
    syscall(1, 1, "ERR ", 4);
    _cli_int(0 - r);
    _cli_nl();
    syscall(60, 3);
    return 0;
}

fn _cli_usage() {
    syscall(1, 2, "usage: interop-cli <decode|stream|encode|opusdec|celtenc|silkenc|verify|id3|mem|tracks|track|raw> ...\n", 102);
    syscall(60, 2);
    return 0;
}

fn _cli_load(path, lenp) {
    var d = _cli_read(path, lenp);
    if (d == 0) {
        syscall(1, 2, "cannot read input\n", 18);
        syscall(60, 2);
    }
    return d;
}

# Write a vec of f64 samples as raw little-endian doubles.
fn _cli_write_vec(path, v) {
    var n = vec_len(v);
    var o = alloc(n * 8 + 8);
    for (var i = 0; i < n; i = i + 1) { store64(o + i * 8, vec_get(v, i)); }
    _cli_write(path, o, n * 8);
    return n;
}

fn _cli_read_vec(path) {
    var lenp = alloc(8);
    var d = _cli_load(path, lenp);
    var n = load64(lenp) / 8;
    var v = vec_new();
    for (var i = 0; i < n; i = i + 1) { vec_push(v, load64(d + i * 8)); }
    return v;
}

fn _cli_decode() {
    var lenp = alloc(8);
    var d = _cli_load(argv(2), lenp);
    var r = codec_open(d, load64(lenp));
    if (is_err(r) == 1) { _cli_fail(r); }
    var fi = decode_result_info(r);
    var sm = decode_result_samples(r);
    _cli_int(fmtinfo_sample_rate(fi));
    _cli_int(fmtinfo_channels(fi));
    _cli_int(fmtinfo_bit_depth(fi));
    _cli_int(fmtinfo_format(fi));
    _cli_int(vec_len(sm));
    _cli_nl();
    _cli_write_vec(argv(3), sm);
    return 0;
}

fn _cli_print_result(r, path) {
    if (is_err(r) == 1) { _cli_fail(r); }
    var fi = decode_result_info(r);
    var sm = decode_result_samples(r);
    _cli_int(fmtinfo_sample_rate(fi));
    _cli_int(fmtinfo_channels(fi));
    _cli_int(fmtinfo_bit_depth(fi));
    _cli_int(fmtinfo_format(fi));
    _cli_int(vec_len(sm));
    _cli_nl();
    _cli_write_vec(path, sm);
    return 0;
}

fn _cli_tracks() {
    var lenp = alloc(8);
    var d = _cli_load(argv(2), lenp);
    var n = mp4_track_count(d, load64(lenp));
    if (is_err(n) == 1) { _cli_fail(n); }
    _cli_int(n);
    _cli_int(mp4_default_track(d, load64(lenp)));
    _cli_nl();
    return 0;
}

fn _cli_track() {
    var lenp = alloc(8);
    var d = _cli_load(argv(2), lenp);
    return _cli_print_result(mp4_decode_track(d, load64(lenp), atoi(argv(3))), argv(4));
}

fn _cli_raw() {
    var lenp = alloc(8);
    var d = _cli_load(argv(2), lenp);
    shravan_set_gapless(0);
    return _cli_print_result(codec_open(d, load64(lenp)), argv(3));
}

fn _cli_stream() {
    var kind = argv(2);
    var lenp = alloc(8);
    var d = _cli_load(argv(3), lenp);
    var len = load64(lenp);
    var chunk = atoi(argv(5));
    if (chunk < 1) { chunk = 4096; }
    var dec = 0;
    var k = 0;
    if (streq(kind, "wav") == 1) { dec = wav_stream_new(4096); k = 1; }
    if (streq(kind, "flac") == 1) { dec = flac_stream_new(); k = 2; }
    if (streq(kind, "aiff") == 1) { dec = aiff_stream_new(4096); k = 3; }
    if (k == 0) { _cli_usage(); }
    var out = vec_new();
    var rate = 0;
    var ch = 0;
    var pos = 0;
    var done = 0;
    while (done == 0) {
        var evs = 0;
        if (pos < len) {
            var take = chunk;
            if (pos + take > len) { take = len - pos; }
            if (k == 1) { evs = wav_stream_feed(dec, d + pos, take); }
            if (k == 2) { evs = flac_stream_feed(dec, d + pos, take); }
            if (k == 3) { evs = aiff_stream_feed(dec, d + pos, take); }
            pos = pos + take;
        } else {
            if (k == 1) { evs = wav_stream_flush(dec); }
            if (k == 2) { evs = flac_stream_flush(dec); }
            if (k == 3) { evs = aiff_stream_flush(dec); }
            done = 1;
        }
        var ne = vec_len(evs);
        for (var e = 0; e < ne; e = e + 1) {
            var ev = vec_get(evs, e);
            var t = stream_evt_type(ev);
            if (t == STREAM_EVT_HEADER) {
                var fi = stream_evt_data(ev);
                rate = fmtinfo_sample_rate(fi);
                ch = fmtinfo_channels(fi);
            }
            if (t == STREAM_EVT_SAMPLES) {
                var sv = stream_evt_data(ev);
                var ns = vec_len(sv);
                for (var j = 0; j < ns; j = j + 1) { vec_push(out, vec_get(sv, j)); }
            }
        }
    }
    _cli_int(rate);
    _cli_int(ch);
    _cli_int(vec_len(out));
    _cli_nl();
    _cli_write_vec(argv(4), out);
    return 0;
}

fn _cli_encode() {
    var v = _cli_read_vec(argv(2));
    var kind = argv(3);
    var rate = atoi(argv(4));
    var ch = atoi(argv(5));
    var arg = atoi(argv(6));
    var n = vec_len(v);
    var o = alloc(n * 16 + 65536);
    var level = 5;
    if (argc() > 8) { level = atoi(argv(8)); }
    var w = err(ERR_UNSUPPORTED_FMT);
    if (streq(kind, "wav") == 1) {
        var pf = PCM_I16;
        if (arg == 8) { pf = PCM_I8; }
        if (arg == 24) { pf = PCM_I24; }
        if (arg == 32) { pf = PCM_I32; }
        w = wav_encode(v, rate, ch, pf, o);
    }
    if (streq(kind, "wavf32") == 1) { w = wav_encode(v, rate, ch, PCM_F32, o); }
    if (streq(kind, "wavf64") == 1) { w = wav_encode(v, rate, ch, PCM_F64, o); }
    if (streq(kind, "aiff") == 1) { w = aiff_encode(v, rate, ch, arg, o); }
    if (streq(kind, "flac") == 1) { w = flac_encode_level(v, rate, ch, arg, level, o); }
    if (streq(kind, "aac") == 1) { w = aac_encode(v, rate, ch, arg, o); }
    if (is_err(w) == 1) { _cli_fail(w); }
    _cli_write(argv(7), o, w);
    _cli_int(w);
    _cli_nl();
    return 0;
}

# Wrap raw packets in the vec shape opus_decode_from_packets takes: an OpusHead
# with pre-skip 0 and an empty OpusTags first, so the output lines up sample for
# sample with libopus's decode of the same packets.
fn _cli_opusdec() {
    var lenp = alloc(8);
    var d = _cli_load(argv(2), lenp);
    var len = load64(lenp);
    var ch = atoi(argv(3));
    var head = alloc(19);
    memset(head, 0, 19);
    memcpy(head, "OpusHead", 8);
    store8(head + 8, 1);
    store8(head + 9, ch);
    write_u32_le(head, 12, 48000);
    var tags = alloc(16);
    memset(tags, 0, 16);
    memcpy(tags, "OpusTags", 8);
    var pk = vec_new();
    vec_push(pk, str_from_buf(head, 19));
    vec_push(pk, str_from_buf(tags, 16));
    var pos = 0;
    while (pos + 4 <= len) {
        var n = read_u32_le(d, pos);
        pos = pos + 4;
        if (pos + n > len) { break; }
        vec_push(pk, str_from_buf(d + pos, n));
        pos = pos + n;
    }
    var r = opus_decode_from_packets(pk, 0, 0);
    if (is_err(r) == 1) { _cli_fail(r); }
    var sm = decode_result_samples(r);
    _cli_int(vec_len(pk) - 2);
    _cli_int(vec_len(sm));
    _cli_nl();
    _cli_write_vec(argv(4), sm);
    return 0;
}

# Encode 20 ms CELT-only frames (TOC config 31, fullband). celt_encode reads the
# frame plus 120 samples of lookahead, so frame k covers input [960k, 960k + 1080).
fn _cli_celtenc() {
    var v = _cli_read_vec(argv(2));
    var ch = atoi(argv(3));
    var nbytes = atoi(argv(4));
    var total = vec_len(v) / ch;
    var frames = (total - 120) / 960;
    if (frames < 1) { _cli_usage(); }
    var st = celt_dec_state_new();
    var mem = alloc(16);
    store64(mem, 0);
    store64(mem + 8, 0);
    var pcm = alloc(ch * 1080 * 8);
    var out = alloc(frames * (nbytes + 5) + 8);
    var op = 0;
    var buf = alloc(nbytes);
    for (var f = 0; f < frames; f = f + 1) {
        for (var i = 0; i < 1080 * ch; i = i + 1) {
            store64(pcm + i * 8, vec_get(v, f * 960 * ch + i));
        }
        memset(buf, 0, nbytes);
        var ec = ec_enc_new(buf, nbytes);
        celt_encode(st, ec, pcm, ch, 3, 0, -1, mem);
        ec_enc_done(ec);
        if (load64(ec + 88) != 0) { _cli_fail(err(ERR_ENCODE)); }
        write_u32_le(out, op, nbytes + 1);
        var toc = 31 << 3;
        if (ch == 2) { toc = toc | 4; }
        store8(out + op + 4, toc);
        memcpy(out + op + 5, buf, nbytes);
        op = op + nbytes + 5;
    }
    _cli_write(argv(5), out, op);
    _cli_int(frames);
    _cli_nl();
    return 0;
}

fn _cli_silkenc() {
    var v = _cli_read_vec(argv(2));
    var api = atoi(argv(3));
    if (argc() > 14) { api = atoi(argv(14)); }
    var ch = 1;
    if (argc() > 15) { ch = atoi(argv(15)); }
    var sched = 0;
    if (argc() > 16) { sched = argv(16); }
    var e = silk_encoder_new_channels(api, atoi(argv(3)), ch, atoi(argv(6)), atoi(argv(4)), atoi(argv(5)), atoi(argv(7)));
    if (is_err(e) == 1) { _cli_fail(e); }
    if (argc() > 12) {
        var fr = silk_encoder_set_fec(e, atoi(argv(12)));
        if (is_err(fr) == 1) { _cli_fail(fr); }
    }
    if (argc() > 13) {
        var dr = silk_encoder_set_dtx(e, atoi(argv(13)));
        if (is_err(dr) == 1) { _cli_fail(dr); }
    }
    var raw = 0;
    var cap = 1275;
    if (argc() > 9) { if (streq(argv(9), "raw") == 1) { raw = 1; } }
    if (argc() > 10) { cap = atoi(argv(10)); }
    if (argc() > 11) {
        var lr = silk_encoder_set_packet_loss(e, atoi(argv(11)));
        if (is_err(lr) == 1) { _cli_fail(lr); }
    }
    # the rate schedule, expanded
    var rts = alloc(4096 * 8);
    var nr = 0;
    if (argc() > 17) {
        var q = argv(17);
        var ql = strlen(q);
        var qi = 0;
        while (qi < ql && nr < 4096) {
            var rv = 0;
            while (qi < ql && load8(q + qi) >= 48 && load8(q + qi) <= 57) { rv = rv * 10 + load8(q + qi) - 48; qi = qi + 1; }
            var rc = 1;
            if (qi < ql && load8(q + qi) == 42) {
                qi = qi + 1;
                rc = 0;
                while (qi < ql && load8(q + qi) >= 48 && load8(q + qi) <= 57) { rc = rc * 10 + load8(q + qi) - 48; qi = qi + 1; }
            }
            while (rc > 0 && nr < 4096) { store64(rts + nr * 8, rv); nr = nr + 1; rc = rc - 1; }
            if (qi < ql) { qi = qi + 1; }
        }
    }
    var n = silk_encoder_samples(e) * ch;
    var packets = vec_len(v) / n;
    var pcm = alloc(n * 8);
    var out = alloc(packets * 1281 + 8);
    var op = 0;
    var ns = 0;
    if (sched != 0) { ns = strlen(sched); }
    for (var p = 0; p < packets; p = p + 1) {
        for (var i = 0; i < n; i = i + 1) { store64(pcm + i * 8, vec_get(v, p * n + i)); }
        if (ns > 0) {
            var c = load8(sched + p % ns);
            var sc = 2;
            if (c == 49) { sc = 1; }
            var cr = silk_encoder_set_channels(e, sc);
            if (is_err(cr) == 1) { _cli_fail(cr); }
            var tm = 0;
            if (c == 51) { tm = 1; }
            silk_encoder_set_to_mono(e, tm);
        }
        if (nr > 0) {
            var br = silk_encoder_set_bitrate(e, load64(rts + (p % nr) * 8));
            if (is_err(br) == 1) { _cli_fail(br); }
        }
        var r = 0;
        if (raw == 1) { r = silk_encode(e, pcm, out + op + 4, cap); }
        else { r = silk_encode_opus(e, pcm, out + op + 4, 1276); }
        if (is_err(r) == 1) { _cli_fail(r); }
        write_u32_le(out, op, r);
        op = op + 4 + r;
    }
    _cli_write(argv(8), out, op);
    _cli_int(packets);
    _cli_nl();
    return 0;
}

# opusenc: shravan's Opus encoder (opus_encoder_new, RESTRICTED_SILK) over an
# interleaved f64 file, with scripts/silkref/opusenc.c's keys; packets as
# silkenc writes them, and out.pk.rng per packet the final range, then
# opus_encoder_bandwidth, _in_dtx and _bitrate (u32le each).
fn _cli_key(a, k) {
    var n = strlen(k);
    var i = 0;
    while (i < n) { if (load8(a + i) != load8(k + i)) { return 0; } i = i + 1; }
    if (load8(a + n) != 61) { return 0; }
    return a + n + 1;
}

fn _cli_bw(v) {
    if (streq(v, "nb") == 1) { return OPUS_BANDWIDTH_NARROWBAND; }
    if (streq(v, "mb") == 1) { return OPUS_BANDWIDTH_MEDIUMBAND; }
    if (streq(v, "wb") == 1) { return OPUS_BANDWIDTH_WIDEBAND; }
    if (streq(v, "swb") == 1) { return OPUS_BANDWIDTH_SUPERWIDEBAND; }
    if (streq(v, "fb") == 1) { return OPUS_BANDWIDTH_FULLBAND; }
    return OPUS_AUTO;
}

# "rate*count,..." into words at out; returns the count.
fn _cli_list(q, out, max) {
    var ql = strlen(q);
    var qi = 0;
    var nr = 0;
    while (qi < ql && nr < max) {
        var rv = 0;
        while (qi < ql && load8(q + qi) >= 48 && load8(q + qi) <= 57) { rv = rv * 10 + load8(q + qi) - 48; qi = qi + 1; }
        var rc = 1;
        if (qi < ql && load8(q + qi) == 42) {
            qi = qi + 1;
            rc = 0;
            while (qi < ql && load8(q + qi) >= 48 && load8(q + qi) <= 57) { rc = rc * 10 + load8(q + qi) - 48; qi = qi + 1; }
        }
        while (rc > 0 && nr < max) { store64(out + nr * 8, rv); nr = nr + 1; rc = rc - 1; }
        if (qi < ql) { qi = qi + 1; }
    }
    return nr;
}

fn _cli_ctl(r) {
    if (is_err(r) == 1) { _cli_fail(r); }
    return 0;
}

fn _cli_opusenc() {
    var v = _cli_read_vec(argv(2));
    var fs = atoi(argv(4));
    var ch = atoi(argv(5));
    var enc = opus_encoder_new(fs, ch, OPUS_APPLICATION_RESTRICTED_SILK);
    if (is_err(enc) == 1) { _cli_fail(enc); }
    var maxbytes = 1276 * 6;
    var ms = 20;
    var total = 0 - 1;
    var reset = 0;
    var frames = alloc(4096 * 8);
    var nframes = 0;
    var rates = alloc(4096 * 8);
    var nrates = 0;
    var chans = 0;
    var i = 6;
    while (i < argc()) {
        var a = argv(i);
        var x = 0;
        x = _cli_key(a, "bitrate");
        if (x != 0) {
            var b = atoi(x);
            if (streq(x, "auto") == 1) { b = OPUS_AUTO; }
            if (streq(x, "max") == 1) { b = OPUS_BITRATE_MAX; }
            _cli_ctl(opus_encoder_set_bitrate(enc, b));
        }
        x = _cli_key(a, "vbr"); if (x != 0) { _cli_ctl(opus_encoder_set_vbr(enc, atoi(x))); }
        x = _cli_key(a, "cx"); if (x != 0) { _cli_ctl(opus_encoder_set_complexity(enc, atoi(x))); }
        x = _cli_key(a, "maxbw"); if (x != 0) { _cli_ctl(opus_encoder_set_max_bandwidth(enc, _cli_bw(x))); }
        x = _cli_key(a, "bw"); if (x != 0) { _cli_ctl(opus_encoder_set_bandwidth(enc, _cli_bw(x))); }
        x = _cli_key(a, "force");
        if (x != 0) {
            var fc = atoi(x);
            if (streq(x, "auto") == 1) { fc = OPUS_AUTO; }
            _cli_ctl(opus_encoder_set_force_channels(enc, fc));
        }
        x = _cli_key(a, "signal");
        if (x != 0) {
            var sg = OPUS_AUTO;
            if (streq(x, "voice") == 1) { sg = OPUS_SIGNAL_VOICE; }
            if (streq(x, "music") == 1) { sg = OPUS_SIGNAL_MUSIC; }
            _cli_ctl(opus_encoder_set_signal(enc, sg));
        }
        x = _cli_key(a, "dtx"); if (x != 0) { _cli_ctl(opus_encoder_set_dtx(enc, atoi(x))); }
        x = _cli_key(a, "fec"); if (x != 0) { _cli_ctl(opus_encoder_set_inband_fec(enc, atoi(x))); }
        x = _cli_key(a, "loss"); if (x != 0) { _cli_ctl(opus_encoder_set_packet_loss(enc, atoi(x))); }
        x = _cli_key(a, "lsb"); if (x != 0) { _cli_ctl(opus_encoder_set_lsb_depth(enc, atoi(x))); }
        x = _cli_key(a, "pred"); if (x != 0) { _cli_ctl(opus_encoder_set_prediction_disabled(enc, atoi(x))); }
        x = _cli_key(a, "maxbytes"); if (x != 0) { maxbytes = atoi(x); }
        x = _cli_key(a, "ms"); if (x != 0) { ms = atoi(x); }
        x = _cli_key(a, "frames"); if (x != 0) { nframes = _cli_list(x, frames, 4096); }
        x = _cli_key(a, "rates"); if (x != 0) { nrates = _cli_list(x, rates, 4096); }
        x = _cli_key(a, "chans"); if (x != 0) { chans = x; }
        x = _cli_key(a, "total"); if (x != 0) { total = atoi(x); }
        x = _cli_key(a, "vbrc"); if (x != 0) { _cli_ctl(opus_encoder_set_vbr_constraint(enc, atoi(x))); }
        x = _cli_key(a, "dur"); if (x != 0) { _cli_ctl(opus_encoder_set_expert_frame_duration(enc, atoi(x))); }
        x = _cli_key(a, "reset"); if (x != 0) { reset = atoi(x); }
        i = i + 1;
    }
    var len = vec_len(v) / ch;
    var pcm = alloc(fs / 1000 * 120 * ch * 8 + 8);
    var pkt = alloc(maxbytes + 16);
    var out = alloc(4096 * 16);
    var cap = 4096 * 16;
    var op = 0;
    var rng = alloc((len / (fs / 400) + 2) * 16);
    var pos = 0;
    var packets = 0;
    var going = 1;
    while (going == 1) {
        if (total >= 0 && packets >= total) { going = 0; }
        else {
            var fms = ms;
            if (nframes > 0) { fms = load64(frames + (packets % nframes) * 8); }
            var n = fs / 1000 * fms;
            if (fms == 25) { n = fs / 400; }
            if (pos + n > len) { going = 0; }
            else {
                if (reset > 0 && packets > 0 && packets % reset == 0) { opus_encoder_reset(enc); }
                if (nrates > 0) { opus_encoder_set_bitrate(enc, load64(rates + (packets % nrates) * 8)); }
                if (chans != 0) {
                    var cc = load8(chans + packets % strlen(chans));
                    var fcc = OPUS_AUTO;
                    if (cc != 97) { fcc = cc - 48; }
                    opus_encoder_set_force_channels(enc, fcc);
                }
                var k = 0;
                while (k < n * ch) { store64(pcm + k * 8, vec_get(v, pos * ch + k)); k = k + 1; }
                var r = opus_encode(enc, pcm, n, pkt, maxbytes);
                if (is_err(r) == 1) { _cli_fail(r); }
                if (op + 4 + r > cap) {
                    var nc = cap * 2 + r;
                    var no = alloc(nc);
                    memcpy(no, out, op);
                    out = no;
                    cap = nc;
                }
                write_u32_le(out, op, r);
                memcpy(out + op + 4, pkt, r);
                op = op + 4 + r;
                write_u32_le(rng, packets * 16, opus_encoder_final_range(enc));
                write_u32_le(rng, packets * 16 + 4, opus_encoder_bandwidth(enc));
                write_u32_le(rng, packets * 16 + 8, opus_encoder_in_dtx(enc));
                write_u32_le(rng, packets * 16 + 12, opus_encoder_bitrate(enc));
                pos = pos + n;
                packets = packets + 1;
            }
        }
    }
    _cli_write(argv(3), out, op);
    var rp = alloc(strlen(argv(3)) + 8);
    memcpy(rp, argv(3), strlen(argv(3)));
    memcpy(rp + strlen(argv(3)), ".rng", 5);
    _cli_write(rp, rng, packets * 16);
    _cli_int(packets);
    _cli_nl();
    return 0;
}

# celtlib: celt_encoder_encode (src/celt_enc.cyr) with scripts/silkref/celtenc.c's
# keys and synthetic AnalysisInfo / SILKInfo / energy masks / pre-written bits,
# drawn from the same 32-bit LCG. out.pk.rng: per frame the final range.
# Built with -D CELT_TRACE, trace=path writes the stage records.
fn _cli_lcg(sp) {
    var s = (load64(sp) * 1664525 + 1013904223) & 0xFFFFFFFF;
    store64(sp, s);
    return s;
}

fn _cli_unit(sp) { return f64_mul(f64_from(_cli_lcg(sp) >> 8), 0x3E70000000000000); }

fn _cli_celtlib() {
    var v = _cli_read_vec(argv(2));
    var fs = atoi(argv(4));
    var ch = atoi(argv(5));
    var enc = celt_encoder_new(fs, ch);
    if (is_err(enc) == 1) { _cli_fail(enc); }
    var nb = 1275;
    var total = 0 - 1;
    var reset = 0;
    var n0 = fs / 50;
    var frames = alloc(4096 * 8);
    var nframes = 0;
    var rates = alloc(4096 * 8);
    var nrates = 0;
    var sizes = alloc(4096 * 8);
    var nsizes = 0;
    var streams = 0;
    var ana = alloc(8);
    var silk = alloc(8);
    var mask = alloc(8);
    var pre = alloc(8);
    var use_ana = 0;
    var use_silk = 0;
    var use_mask = 0;
    var use_pre = 0;
    var toc = 0;
    var i = 6;
    while (i < argc()) {
        var a = argv(i);
        var x = 0;
        x = _cli_key(a, "toc"); if (x != 0) { toc = atoi(x); }
        x = _cli_key(a, "n"); if (x != 0) { n0 = atoi(x); }
        x = _cli_key(a, "frames"); if (x != 0) { nframes = _cli_list(x, frames, 4096); }
        x = _cli_key(a, "bitrate");
        if (x != 0) {
            var b = atoi(x);
            if (streq(x, "max") == 1) { b = 0 - 1; }
            _cli_ctl(celt_encoder_set_bitrate(enc, b));
        }
        x = _cli_key(a, "rates"); if (x != 0) { nrates = _cli_list(x, rates, 4096); }
        x = _cli_key(a, "vbr"); if (x != 0) { _cli_ctl(celt_encoder_set_vbr(enc, atoi(x))); }
        x = _cli_key(a, "vbrc"); if (x != 0) { _cli_ctl(celt_encoder_set_vbr_constraint(enc, atoi(x))); }
        x = _cli_key(a, "cx"); if (x != 0) { _cli_ctl(celt_encoder_set_complexity(enc, atoi(x))); }
        x = _cli_key(a, "loss"); if (x != 0) { _cli_ctl(celt_encoder_set_packet_loss(enc, atoi(x))); }
        x = _cli_key(a, "pred"); if (x != 0) { _cli_ctl(celt_encoder_set_prediction(enc, atoi(x))); }
        x = _cli_key(a, "lsb"); if (x != 0) { _cli_ctl(celt_encoder_set_lsb_depth(enc, atoi(x))); }
        x = _cli_key(a, "inv"); if (x != 0) { _cli_ctl(celt_encoder_set_phase_inversion_disabled(enc, atoi(x))); }
        x = _cli_key(a, "start"); if (x != 0) { _cli_ctl(celt_encoder_set_start_band(enc, atoi(x))); }
        x = _cli_key(a, "end"); if (x != 0) { _cli_ctl(celt_encoder_set_end_band(enc, atoi(x))); }
        x = _cli_key(a, "lfe"); if (x != 0) { _cli_ctl(celt_encoder_set_lfe(enc, atoi(x))); }
        x = _cli_key(a, "stream"); if (x != 0) { _cli_ctl(celt_encoder_set_channels(enc, atoi(x))); }
        x = _cli_key(a, "streams"); if (x != 0) { streams = x; }
        x = _cli_key(a, "bytes"); if (x != 0) { nb = atoi(x); }
        x = _cli_key(a, "sizes"); if (x != 0) { nsizes = _cli_list(x, sizes, 4096); }
        x = _cli_key(a, "reset"); if (x != 0) { reset = atoi(x); }
        x = _cli_key(a, "total"); if (x != 0) { total = atoi(x); }
        x = _cli_key(a, "ana"); if (x != 0) { store64(ana, atoi(x) & 0xFFFFFFFF); use_ana = 1; }
        x = _cli_key(a, "silk"); if (x != 0) { store64(silk, atoi(x) & 0xFFFFFFFF); use_silk = 1; }
        x = _cli_key(a, "mask"); if (x != 0) { store64(mask, atoi(x) & 0xFFFFFFFF); use_mask = 1; }
        x = _cli_key(a, "pre"); if (x != 0) { store64(pre, atoi(x) & 0xFFFFFFFF); use_pre = 1; }
#ifdef CELT_TRACE
        x = _cli_key(a, "trace"); if (x != 0) { _ce_trace_fd = syscall(2, x, 0x441, 420); }
#endif
        i = i + 1;
    }
    var len = vec_len(v) / ch;
    var pcm = alloc(960 * 2 * 8 + 8);
    var pkt = alloc(1276 * 2);
    var out = alloc(4096 * 16);
    var cap = 4096 * 16;
    var op = 0;
    var rng = alloc((len / (fs / 400) + 2) * 4);
    var info = alloc(_CEA_SIZE);
    var emask = alloc(42 * 8);
    var pos = 0;
    var count = 0;
    var going = 1;
    while (going == 1) {
        if (total >= 0 && count >= total) { going = 0; }
        else {
            var n = n0;
            if (nframes > 0) { n = load64(frames + (count % nframes) * 8); }
            if (pos + n > len) { going = 0; }
            else {
                if (reset > 0 && count > 0 && count % reset == 0) { celt_encoder_reset(enc); }
                if (nrates > 0) { celt_encoder_set_bitrate(enc, load64(rates + (count % nrates) * 8)); }
                if (streams != 0) { celt_encoder_set_channels(enc, load8(streams + count % strlen(streams)) - 48); }
                var bytes = nb;
                if (nsizes > 0) { bytes = load64(sizes + (count % nsizes) * 8); }
                if (use_ana != 0) {
                    memset(info, 0, _CEA_SIZE);
                    var vd = 0;
                    if ((_cli_lcg(ana) >> 29) != 0) { vd = 1; }
                    store64(info + _CEA_VALID, vd);
                    store64(info + _CEA_TONALITY, _cli_unit(ana));
                    store64(info + _CEA_TONALITY_SLOPE, f64_sub(_cli_unit(ana), 0.5));
                    store64(info + _CEA_NOISINESS, _cli_unit(ana));
                    store64(info + _CEA_ACTIVITY, _cli_unit(ana));
                    store64(info + _CEA_MUSIC_PROB, _cli_unit(ana));
                    store64(info + _CEA_MUSIC_PROB_MIN, _cli_unit(ana));
                    store64(info + _CEA_MUSIC_PROB_MAX, _cli_unit(ana));
                    store64(info + _CEA_BANDWIDTH, 1 + _cli_lcg(ana) % 20);
                    store64(info + _CEA_ACTIVITY_PROB, _cli_unit(ana));
                    store64(info + _CEA_MAX_PITCH_RATIO, _cli_unit(ana));
                    var li = 0;
                    while (li < 19) { store64(info + _CEA_LEAK_BOOST + li * 8, _cli_lcg(ana) >> 24); li = li + 1; }
                    celt_encoder_set_analysis(enc, info);
                }
                if (use_silk != 0) {
                    var stp = _cli_lcg(silk) % 3;
                    var sof = _cli_lcg(silk) % 200;
                    celt_encoder_set_silk_info(enc, stp, sof);
                }
                if (use_mask != 0) {
                    var mi = 0;
                    while (mi < 42) {
                        store64(emask + mi * 8, f64_div(f64_from((_cli_lcg(mask) >> 22) - 768), f64_from(256)));
                        mi = mi + 1;
                    }
                    celt_encoder_set_energy_mask(enc, emask);
                }
                var k = 0;
                while (k < n * ch) { store64(pcm + k * 8, vec_get(v, pos * ch + k)); k = k + 1; }
                memset(pkt, 0, 1276 * 2);
                var r = 0;
                if (use_pre != 0) {
                    var ec = ec_enc_new(pkt, bytes);
                    var kp = _cli_lcg(pre) % 64;
                    var pi = 0;
                    while (pi < kp) {
                        var w = _cli_lcg(pre);
                        ec_enc_bit_logp(ec, (w >> 20) & 1, 1 + (w >> 24) % 4);
                        pi = pi + 1;
                    }
                    var kr = _cli_lcg(pre) % 4;
                    pi = 0;
                    while (pi < kr) { ec_enc_bits(ec, _cli_lcg(pre) & 0xFFFF, 16); pi = pi + 1; }
                    r = celt_encoder_encode_ec(enc, pcm, n, bytes, ec);
                } else {
                    r = celt_encoder_encode(enc, pcm, n, pkt, bytes);
                }
                if (is_err(r) == 1) { _cli_fail(r); }
                if (op + 5 + r > cap) {
                    var nc = cap * 2 + r;
                    var no = alloc(nc);
                    memcpy(no, out, op);
                    out = no;
                    cap = nc;
                }
                if (toc != 0) {
                    # an Opus packet: CELT only, the bandwidth by the end band, the
                    # frame by its 48 kHz length, code 0
                    var n48 = n * (48000 / fs);
                    var lm = 0;
                    while ((120 << lm) != n48) { lm = lm + 1; }
                    var eb = load64(enc + _CE_END);
                    var base = 28;
                    if (eb <= 19) { base = 24; }
                    if (eb <= 17) { base = 20; }
                    if (eb <= 13) { base = 16; }
                    write_u32_le(out, op, r + 1);
                    store8(out + op + 4, ((base + lm) << 3) | ((load64(enc + _CE_C) - 1) << 2));
                    memcpy(out + op + 5, pkt, r);
                    op = op + 5 + r;
                } else {
                    write_u32_le(out, op, r);
                    memcpy(out + op + 4, pkt, r);
                    op = op + 4 + r;
                }
                write_u32_le(rng, count * 4, celt_encoder_final_range(enc));
                pos = pos + n;
                count = count + 1;
            }
        }
    }
    _cli_write(argv(3), out, op);
    var rp = alloc(strlen(argv(3)) + 8);
    memcpy(rp, argv(3), strlen(argv(3)));
    memcpy(rp + strlen(argv(3)), ".rng", 5);
    _cli_write(rp, rng, count * 4);
    _cli_int(count);
    _cli_nl();
    return 0;
}

fn _cli_verify() {
    var lenp = alloc(8);
    var d = _cli_load(argv(2), lenp);
    var r = flac_verify(d, load64(lenp));
    if (is_err(r) == 1) { _cli_fail(r); }
    _cli_int(r);
    _cli_nl();
    return 0;
}

fn _cli_mem() {
    var lenp = alloc(8);
    var d = _cli_load(argv(2), lenp);
    var before = alloc_used();
    var r = codec_open(d, load64(lenp));
    if (is_err(r) == 1) { _cli_fail(r); }
    var n = vec_len(decode_result_samples(r));
    _cli_int(n);
    _cli_int(alloc_used() - before);
    _cli_int((alloc_used() - before) / (n * 8 + 1));
    _cli_nl();
    return 0;
}

fn _cli_id3() {
    var lenp = alloc(8);
    var d = _cli_load(argv(2), lenp);
    var m = tag_read_id3v2(d, load64(lenp));
    if (is_err(m) == 1) { _cli_fail(m); }
    var t = tag_meta_title(m);
    if (t != 0) { syscall(1, 1, str_data(t), str_len(t)); }
    _cli_nl();
    return 0;
}

# Only what the documented consumer contract requires (docs/architecture/overview.md):
# every codec must initialise its own tables, and this tool is how that is checked.
alloc_init();
shravan_init_constants();
args_init();

if (argc() < 3) { _cli_usage(); }
var cmd = argv(1);
var known = 0;
if (streq(cmd, "decode") == 1) { known = 1; _cli_decode(); }
if (streq(cmd, "stream") == 1) { known = 1; _cli_stream(); }
if (streq(cmd, "encode") == 1) { known = 1; _cli_encode(); }
if (streq(cmd, "opusdec") == 1) { known = 1; _cli_opusdec(); }
if (streq(cmd, "celtenc") == 1) { known = 1; _cli_celtenc(); }
if (streq(cmd, "silkenc") == 1) { known = 1; _cli_silkenc(); }
if (streq(cmd, "opusenc") == 1) { known = 1; _cli_opusenc(); }
if (streq(cmd, "celtlib") == 1) { known = 1; _cli_celtlib(); }
if (streq(cmd, "verify") == 1) { known = 1; _cli_verify(); }
if (streq(cmd, "id3") == 1) { known = 1; _cli_id3(); }
if (streq(cmd, "mem") == 1) { known = 1; _cli_mem(); }
if (streq(cmd, "tracks") == 1) { known = 1; _cli_tracks(); }
if (streq(cmd, "track") == 1) { known = 1; _cli_track(); }
if (streq(cmd, "raw") == 1) { known = 1; _cli_raw(); }
if (known == 0) { _cli_usage(); }
syscall(60, 0);
