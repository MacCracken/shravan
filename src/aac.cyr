    store64(L+54*8, 9); store64(L+55*8, 8); store64(L+56*8, 6); store64(L+57*8, 6); store64(L+58*8, 6); store64(L+59*8, 6); store64(L+60*8, 6); store64(L+61*8, 8); store64(L+62*8, 9);
    store64(L+63*8,10); store64(L+64*8, 9); store64(L+65*8, 8); store64(L+66*8, 7); store64(L+67*8, 7); store64(L+68*8, 7); store64(L+69*8, 7); store64(L+70*8, 8); store64(L+71*8,10);
