    store64(C+72*8,0x7ff); store64(C+73*8,0x3f9); store64(C+74*8,0x1f6); store64(C+75*8,0x1ed); store64(C+76*8,0x1f8); store64(C+77*8,0x1e9); store64(C+78*8,0x1f5); store64(C+79*8,0x3fb); store64(C+80*8,0x7fc);
    return 0;
}

fn _aac_init_hcb7() {
    var L = alloc(64 * 8); var C = alloc(64 * 8);
