# ================================================================
# aac.cyr -- AAC-LC codec (ADTS encoder + decoder/parser)
# ================================================================
#
# Provides:
#   aac_parse_adts_header(data, len)  -- parse 7-byte ADTS header
#   aac_build_adts_header(sr, ch, frame_len, out_buf) -- build ADTS header
#   aac_encode(samples_vec, sample_rate, channels, bitrate, out_buf)
#   aac_decode(data, len)             -- parse ADTS, return format info
#
# Requires: alloc, vec, str, math, fft, assert

# ================================================================
# AAC sample rate table (indexed by 4-bit sample_rate_index)
# ================================================================

var _aac_sample_rates = 0;

fn _aac_init_rates() {
    _aac_sample_rates = alloc(16 * 8);
    store64(_aac_sample_rates + 0 * 8, 96000);
    store64(_aac_sample_rates + 1 * 8, 88200);
    store64(_aac_sample_rates + 2 * 8, 64000);
    store64(_aac_sample_rates + 3 * 8, 48000);
    store64(_aac_sample_rates + 4 * 8, 44100);
    store64(_aac_sample_rates + 5 * 8, 32000);
    store64(_aac_sample_rates + 6 * 8, 24000);
    store64(_aac_sample_rates + 7 * 8, 22050);
    store64(_aac_sample_rates + 8 * 8, 16000);
    store64(_aac_sample_rates + 9 * 8, 12000);
    store64(_aac_sample_rates + 10 * 8, 11025);
    store64(_aac_sample_rates + 11 * 8, 8000);
    store64(_aac_sample_rates + 12 * 8, 7350);
    store64(_aac_sample_rates + 13 * 8, 0);
    store64(_aac_sample_rates + 14 * 8, 0);
    store64(_aac_sample_rates + 15 * 8, 0);
    return 0;
}

# Channel count indexed by 3-bit channel configuration
var _aac_channel_counts = 0;

fn _aac_init_channels() {
    _aac_channel_counts = alloc(8 * 8);
    store64(_aac_channel_counts + 0 * 8, 0);
    store64(_aac_channel_counts + 1 * 8, 1);
    store64(_aac_channel_counts + 2 * 8, 2);
    store64(_aac_channel_counts + 3 * 8, 3);
    store64(_aac_channel_counts + 4 * 8, 4);
    store64(_aac_channel_counts + 5 * 8, 5);
    store64(_aac_channel_counts + 6 * 8, 6);
    store64(_aac_channel_counts + 7 * 8, 8);
    return 0;
}

fn aac_init() {
    _aac_init_rates();
    _aac_init_channels();
    return 0;
}

# ================================================================
# ADTS header struct (heap-allocated)
# ================================================================
# Layout (40 bytes):
#   +0:  profile        (i64, 0=Main, 1=LC, 2=SSR, 3=LTP)
#   +8:  sample_rate    (i64, Hz)
#   +16: sr_index       (i64, 0..12)
#   +24: channels       (i64)
#   +32: frame_length   (i64, total frame bytes incl. header)

fn aac_adts_new() {
    var h = alloc(40);
    memset(h, 0, 40);
    return h;
}

fn aac_adts_profile(h)       { return load64(h); }
fn aac_adts_sample_rate(h)   { return load64(h + 8); }
fn aac_adts_sr_index(h)      { return load64(h + 16); }
fn aac_adts_channels(h)      { return load64(h + 24); }
fn aac_adts_frame_length(h)  { return load64(h + 32); }

# ================================================================
# ADTS header parsing
# ================================================================

# Parse an ADTS frame header from data (>= 7 bytes).
# Returns ADTS header struct, or err().
fn aac_parse_adts_header(data, len) {
    if (len < 7) {
        return err(ERR_INVALID_HEADER);
    }

    # Check sync word: 12 bits = 0xFFF
    if (load8(data) != 0xFF) { return err(ERR_INVALID_HEADER); }
    if ((load8(data + 1) & 0xF0) != 0xF0) { return err(ERR_INVALID_HEADER); }

    # Layer must be 0 for AAC
    if ((load8(data + 1) & 0x06) != 0) { return err(ERR_INVALID_HEADER); }

    var profile = (load8(data + 2) >> 6) & 0x03;
    var sr_index = (load8(data + 2) >> 2) & 0x0F;

    if (sr_index >= 13) { return err(ERR_INVALID_HEADER); }

    var sample_rate = load64(_aac_sample_rates + sr_index * 8);
    if (sample_rate == 0) { return err(ERR_INVALID_RATE); }

    var channel_config = ((load8(data + 2) & 0x01) << 2) | ((load8(data + 3) >> 6) & 0x03);
    if (channel_config == 0) { return err(ERR_INVALID_CHANNELS); }
    if (channel_config >= 8) { return err(ERR_INVALID_CHANNELS); }
    var channels = load64(_aac_channel_counts + channel_config * 8);

    # Frame length: 13 bits spanning bytes 3-5
    var frame_length = ((load8(data + 3) & 0x03) << 11)
    | (load8(data + 4) << 3)
    | ((load8(data + 5) >> 5) & 0x07);

    if (frame_length < 7) { return err(ERR_INVALID_HEADER); }

    var h = aac_adts_new();
    store64(h,      profile);
    store64(h + 8,  sample_rate);
    store64(h + 16, sr_index);
    store64(h + 24, channels);
    store64(h + 32, frame_length);
    return h;
}

# ================================================================
# ADTS header building
# ================================================================

# Find sample rate index for a given rate.
fn _aac_find_sr_index(sample_rate) {
    # Lazy: mp4_decode builds ADTS headers before aac_decode has run its own init.
    if (_aac_sample_rates == 0) { aac_init(); }
    var i = 0;
    while (i < 13) {
        if (load64(_aac_sample_rates + i * 8) == sample_rate) {
            return i;
        }
        i = i + 1;
    }
    return 4;  # default to 44100
}

# The ADTS sampling-frequency index of a rate, or -1 if it has none.
fn _aac_sr_index_exact(sample_rate) {
    if (_aac_sample_rates == 0) { aac_init(); }
    var i = 0;
    while (i < 13) {
        if (load64(_aac_sample_rates + i * 8) == sample_rate) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# Build a 7-byte ADTS header into out_buf.
# frame_len: raw frame data length (without header).
# Returns 7.
fn aac_build_adts_header(sample_rate, channels, frame_len, out_buf) {
    var sr_index = _aac_find_sr_index(sample_rate);
    var total_len = frame_len + 7;

    store8(out_buf, 0xFF);
    # MPEG-4, layer=0, protection_absent=1
    store8(out_buf + 1, 0xF1);
    # profile=LC(1) | sr_index | private=0 | channel MSB
    store8(out_buf + 2, (1 << 6) | (sr_index << 2) | ((channels >> 2) & 0x01));
    # channel LSBs | frame_length MSBs
    store8(out_buf + 3, ((channels & 0x03) << 6) | ((total_len >> 11) & 0x03));
    store8(out_buf + 4, (total_len >> 3) & 0xFF);
    # frame_length LSBs | buffer fullness MSBs (0x7FF = VBR)
    store8(out_buf + 5, ((total_len & 0x07) << 5) | 0x1F);
    store8(out_buf + 6, 0xFC);  # buffer fullness LSBs + 0 frames - 1

    return 7;
}

# ================================================================
# AAC-LC constants
# ================================================================

var AAC_FRAME_SIZE = 1024;
var AAC_SHORT_SIZE = 128;
var AAC_NUM_SHORT_WINDOWS = 8;

# Scale factor band boundaries for 48kHz / 44.1kHz (long window, 49 bands)
# The active scalefactor band layout. The bands depend on the sample rate, so these
# are selected per stream by _aac_select_swb, and code reads them as variables.
var _aac_swb_offset = 0;
var _aac_swb_short = 0;
var _AAC_NUM_SWB = 49;
var _AAC_NUM_SWB_SHORT = 14;
var _aac_tns_max_long = 42;
var _aac_tns_max_short = 14;

# The most bands any rate uses: 51 at 32 kHz.
var _AAC_MAX_SWB = 51;

# Per sample rate index (13 entries each): layout pointers and band counts.
var _aac_swb_long_by_sr = 0;
var _aac_swb_short_by_sr = 0;
var _aac_swb_nlong_by_sr = 0;
var _aac_swb_nshort_by_sr = 0;

# TNS_MAX_BANDS for AAC-LC, by sample rate index.
var _aac_tns_max_long_by_sr = 0;
var _aac_tns_max_short_by_sr = 0;

# Build a band offset table of n + 1 entries. Each letter gives a band's width in
# units of 4 coefficients, with 'A' as 4.
fn _aac_swb_build(widths, n) {
    var t = alloc((n + 1) * 8);
    var off = 0;
    var i = 0;
    while (i < n) {
        store64(t + i * 8, off);
        off = off + (load8(widths + i) - 64) * 4;
        i = i + 1;
    }
    store64(t + n * 8, off);
    return t;
}

fn _aac_swb_register(sr_index, long_tbl, long_n, short_tbl, short_n) {
    store64(_aac_swb_long_by_sr + sr_index * 8, long_tbl);
    store64(_aac_swb_nlong_by_sr + sr_index * 8, long_n);
    store64(_aac_swb_short_by_sr + sr_index * 8, short_tbl);
    store64(_aac_swb_nshort_by_sr + sr_index * 8, short_n);
    return 0;
}

# Make the band layout for a sample rate index the active one.
fn _aac_select_swb(sr_index) {
    _aac_swb_offset = load64(_aac_swb_long_by_sr + sr_index * 8);
    _aac_swb_short = load64(_aac_swb_short_by_sr + sr_index * 8);
    _AAC_NUM_SWB = load64(_aac_swb_nlong_by_sr + sr_index * 8);
    _AAC_NUM_SWB_SHORT = load64(_aac_swb_nshort_by_sr + sr_index * 8);
    _aac_tns_max_long = load64(_aac_tns_max_long_by_sr + sr_index * 8);
    _aac_tns_max_short = load64(_aac_tns_max_short_by_sr + sr_index * 8);
    return 0;
}

# ISO/IEC 14496-3 scalefactor band tables. Generated from libavcodec's tables, not
# transcribed. Rates share layouts: 96/88.2, 48/44.1, 24/22.05, 16/12/11.025 and
# 8/7.35 kHz for both window lengths, and 96/88.2/64 and 48/44.1/32 for short.
fn _aac_init_swb() {
    _aac_swb_long_by_sr = alloc(13 * 8);
    _aac_swb_short_by_sr = alloc(13 * 8);
    _aac_swb_nlong_by_sr = alloc(13 * 8);
    _aac_swb_nshort_by_sr = alloc(13 * 8);
    _aac_tns_max_long_by_sr = alloc(13 * 8);
    _aac_tns_max_short_by_sr = alloc(13 * 8);

    var l96 = _aac_swb_build("AAAAAAAAAAAAAABBBBBCCCCCDDFGIKPPPPPPPPPPP", 41);
    var l64 = _aac_swb_build("AAAAAAAAAAAAAABBBBCCCDDDEFFGIJJJJJJJJJJJJJJJJJJ", 47);
    var l24 = _aac_swb_build("AAAAAAAAAAABBBBBBBBBBCCCCDDDEEFFGGHIIJKLMMPPPPP", 47);
    var l48 = _aac_swb_build("AAAAAAAAAABBBBBBBCCCCDDEEFFGGHHHHHHHHHHHHHHHHHHHX", 49);
    var l32 = _aac_swb_build("AAAAAAAAAABBBBBBBCCCCDDEEFFGGHHHHHHHHHHHHHHHHHHHHHH", 51);
    var l16 = _aac_swb_build("BBBBBBBBBBBCCCCCCCCCDDDDEEEFFGGHIJJKLMNOPPP", 43);
    var l8 = _aac_swb_build("CCCCCCCCCCCCCDDDDDDDEEEEFFFGGHIIJKLMNOPT", 40);
    var s96 = _aac_swb_build("AAAAAABBBDGI", 12);
    var s48 = _aac_swb_build("AAAAABBBCCCDDD", 14);
    var s24 = _aac_swb_build("AAAAAAABBBCCDDE", 15);
    var s16 = _aac_swb_build("AAAAAAAABBCCDEE", 15);
    var s8 = _aac_swb_build("AAAAAAABBBBCDEE", 15);

    _aac_swb_register(0, l96, 41, s96, 12);
    _aac_swb_register(1, l96, 41, s96, 12);
    _aac_swb_register(2, l64, 47, s96, 12);
    _aac_swb_register(3, l48, 49, s48, 14);
    _aac_swb_register(4, l48, 49, s48, 14);
    _aac_swb_register(5, l32, 51, s48, 14);
    _aac_swb_register(6, l24, 47, s24, 15);
    _aac_swb_register(7, l24, 47, s24, 15);
    _aac_swb_register(8, l16, 43, s16, 15);
    _aac_swb_register(9, l16, 43, s16, 15);
    _aac_swb_register(10, l16, 43, s16, 15);
    _aac_swb_register(11, l8, 40, s8, 15);
    _aac_swb_register(12, l8, 40, s8, 15);

    var tl = "\x1f\x1f\x22\x28\x2a\x33\x2e\x2e\x2a\x2a\x2a\x27\x27";
    var ts = "\x09\x09\x0a\x0e\x0e\x0e\x0e\x0e\x0e\x0e\x0e\x0e\x0e";
    var i = 0;
    while (i < 13) {
        store64(_aac_tns_max_long_by_sr + i * 8, load8(tl + i));
        store64(_aac_tns_max_short_by_sr + i * 8, load8(ts + i));
        i = i + 1;
    }

    _aac_select_swb(4);    # 44.1 kHz until a stream says otherwise
    return 0;
}

# ================================================================
# MSB-first bit writer for AAC bitstream
# ================================================================
# Layout (32 bytes):
#   +0:  buf (pointer)
#   +8:  buf_len
#   +16: buf_cap
#   +24: current (u32 accumulator)
#   +32: bits_in_current (0-7)

fn _bw_new() {
    var bw = alloc(40);
    memset(bw, 0, 40);
    var buf = alloc(8192);
    store64(bw, buf);
    store64(bw + 8, 0);
    store64(bw + 16, 8192);
    store64(bw + 24, 0);
    store64(bw + 32, 0);
    return bw;
}

fn _bw_push_byte(bw, byte) {
    var buf = load64(bw);
    var blen = load64(bw + 8);
    var bcap = load64(bw + 16);
    if (blen >= bcap) {
        var new_cap = bcap * 2;
        var new_buf = alloc(new_cap);
        memcpy(new_buf, buf, blen);
        store64(bw, new_buf);
        store64(bw + 16, new_cap);
        buf = new_buf;
    }
    store8(buf + blen, byte & 0xFF);
    store64(bw + 8, blen + 1);
    return 0;
}

# Write n bits from val (MSB-first, up to 32 bits).
fn _bw_write(bw, val, n) {
    var i = n - 1;
    while (i >= 0) {
        var cur = load64(bw + 24);
        cur = (cur << 1) | ((val >> i) & 1);
        var bits = load64(bw + 32) + 1;
        store64(bw + 24, cur);
        store64(bw + 32, bits);
        if (bits == 8) {
            _bw_push_byte(bw, cur & 0xFF);
            store64(bw + 24, 0);
            store64(bw + 32, 0);
        }
        i = i - 1;
    }
    return 0;
}

# Flush remaining bits (zero-padded to byte boundary).
# Returns Str (data, len).
fn _bw_flush(bw) {
    var bits = load64(bw + 32);
    if (bits > 0) {
        var cur = load64(bw + 24);
        cur = cur << (8 - bits);
        _bw_push_byte(bw, cur & 0xFF);
        store64(bw + 24, 0);
        store64(bw + 32, 0);
    }
    var buf = load64(bw);
    var blen = load64(bw + 8);
    return str_new(buf, blen);
}

fn _bw_byte_len(bw) {
    var blen = load64(bw + 8);
    if (load64(bw + 32) > 0) { blen = blen + 1; }
    return blen;
}

# ================================================================
# TNS (Temporal Noise Shaping) — AAC-LC, long window
# ================================================================
# Linear prediction ACROSS frequency: the encoder runs an all-zero analysis
# (FIR) filter over the top spectral bands to flatten the temporal envelope; the
# decoder runs the exact-inverse all-pole synthesis (IIR) filter. Both filters
# are built from the SAME quantized reflection (PARCOR) coefficients, so
# analysis∘synthesis is the identity — TNS shapes only the quantization noise.
# Convention: analysis e[n]=x[n]+Σa[j]x[n-j]; synthesis x[n]=e[n]-Σa[j]x[n-j].

var TNS_MAX_ORDER = 12;

# per-channel TNS state (single long-window filter)
var TNS_ST_PRESENT = 0;
var TNS_ST_ORDER = 8;
var TNS_ST_DIR = 16;
var TNS_ST_START = 24;     # region start bin (inclusive)
var TNS_ST_END = 32;       # region end bin (exclusive)
var TNS_ST_LEN = 40;       # region length in SFBs (bitstream field)
var TNS_ST_RESBITS = 48;   # coef resolution bits (3 or 4)
var TNS_ST_COMPRESS = 56;  # coef_compress flag
var TNS_ST_COEF = 64;      # coef_index[0..order-1] (signed), 12 slots
var TNS_ST_PARSED = 160;   # set by _tns_parse_data: the records below are valid
var TNS_ST_MAX_SFB = 168;
var TNS_ST_IS_SHORT = 176;
var TNS_ST_NREC = 184;     # filter records, in bitstream order
var TNS_ST_REC = 192;
var TNS_ST_SIZE = 1280;    # 192 + 8 * TNS_REC_SIZE

# One filter as read from a stream: its window, length in bands, order, direction
# and resolution, then up to 12 coefficient indices. Long windows have up to 3
# filters and short windows 1 each, so 8 records cover any frame.
var TNS_REC_WINDOW = 0;
var TNS_REC_LEN = 8;
var TNS_REC_ORDER = 16;
var TNS_REC_DIR = 24;
var TNS_REC_RESBITS = 32;
var TNS_REC_COEF = 40;
var TNS_REC_SIZE = 136;    # 40 + 12*8

# Rebuild LPC a_out[0..order] (a_out[0]=1) from reflection k[1..order] — the same
# recursion Levinson uses, so encoder and decoder derive identical a[] from the
# same reflection coefficients.
fn _tns_parcor_to_lpc(k, order, a_out) {
    memset(a_out, 0, (TNS_MAX_ORDER + 1) * 8);
    store64(a_out, F64_ONE);
    var tmp = alloc((TNS_MAX_ORDER + 1) * 8);
    var m = 1;
    while (m <= order) {
        var km = load64(k + m * 8);
        var i = 1;
        while (i < m) {
            store64(tmp + i * 8, f64_add(load64(a_out + i * 8), f64_mul(km, load64(a_out + (m - i) * 8))));
            i = i + 1;
        }
        i = 1;
        while (i < m) { store64(a_out + i * 8, load64(tmp + i * 8)); i = i + 1; }
        store64(a_out + m * 8, km);
        m = m + 1;
    }
    return 0;
}

# Dequantize a signed coef index to a reflection coefficient (ISO sin mapping).
fn _tns_dequant_coef(coef, res_bits) {
    var half = 1;
    var b = 0;
    while (b < res_bits - 1) { half = half * 2; b = b + 1; }
    var pi_half = f64_div(F64_PI, F64_TWO);
    var iqfac = f64_div(f64_sub(f64_from(half), F64_HALF), pi_half);
    var iqfac_m = f64_div(f64_add(f64_from(half), F64_HALF), pi_half);
    var denom = iqfac;
    if (coef < 0) { denom = iqfac_m; }
    return f64_sin(f64_div(f64_from(coef), denom));
}

# Quantize a reflection coefficient to the nearest coef index (search over the
# small signed range — guaranteed consistent with _tns_dequant_coef, no asin).
fn _tns_quant_coef(k, res_bits) {
    var half = 1;
    var b = 0;
    while (b < res_bits - 1) { half = half * 2; b = b + 1; }
    var best = 0;
    var bestd = f64_from(1000000);
    var c = 0 - half;
    while (c <= half - 1) {
        var d = f64_abs(f64_sub(_tns_dequant_coef(c, res_bits), k));
        if (f64_lt(d, bestd) == 1) { bestd = d; best = c; }
        c = c + 1;
    }
    return best;
}

# Apply the TNS filter over spec[start..end) with LPC a[0..order] (a[0]=1).
# is_synth=0: analysis FIR (encoder), reads original inputs (region copied first).
# is_synth=1: synthesis IIR (decoder), in-place using computed outputs.
# direction=0: forward (low->high); direction=1: backward (high->low).
# History bins outside the region contribute 0 (identical on both sides).
fn _tns_filter(spec, start, end, a, order, direction, is_synth) {
    if (end - start <= 0) { return 0; }
    if (order <= 0) { return 0; }
    var n = end - start;
    if (direction == 0) {
        if (is_synth == 0) {
            var x0 = _aac_tmp(n * 8);
            var t = 0;
            while (t < n) { store64(x0 + t * 8, load64(spec + (start + t) * 8)); t = t + 1; }
            var i = start;
            while (i < end) {
                var acc = load64(x0 + (i - start) * 8);
                var j = 1;
                while (j <= order) {
                    if (i - j >= start) {
                        acc = f64_add(acc, f64_mul(load64(a + j * 8), load64(x0 + (i - j - start) * 8)));
                    }
                    j = j + 1;
                }
                store64(spec + i * 8, acc);
                i = i + 1;
            }
        } else {
            var i = start;
            while (i < end) {
                var acc = load64(spec + i * 8);
                var j = 1;
                while (j <= order) {
                    if (i - j >= start) {
                        acc = f64_sub(acc, f64_mul(load64(a + j * 8), load64(spec + (i - j) * 8)));
                    }
                    j = j + 1;
                }
                store64(spec + i * 8, acc);
                i = i + 1;
            }
        }
    } else {
        if (is_synth == 0) {
            var x0 = _aac_tmp(n * 8);
            var t = 0;
            while (t < n) { store64(x0 + t * 8, load64(spec + (start + t) * 8)); t = t + 1; }
            var i = end - 1;
            while (i >= start) {
                var acc = load64(x0 + (i - start) * 8);
                var j = 1;
                while (j <= order) {
                    if (i + j < end) {
                        acc = f64_add(acc, f64_mul(load64(a + j * 8), load64(x0 + (i + j - start) * 8)));
                    }
                    j = j + 1;
                }
                store64(spec + i * 8, acc);
                i = i - 1;
            }
        } else {
            var i = end - 1;
            while (i >= start) {
                var acc = load64(spec + i * 8);
                var j = 1;
                while (j <= order) {
                    if (i + j < end) {
                        acc = f64_sub(acc, f64_mul(load64(a + j * 8), load64(spec + (i + j) * 8)));
                    }
                    j = j + 1;
                }
                store64(spec + i * 8, acc);
                i = i - 1;
            }
        }
    }
    return 0;
}

# Apply every filter a stream carried, in place. Within a window the filters work
# down from the top of the band table, not from max_sfb, each taking `length` bands
# below the last. The bin range is then limited by TNS_MAX_BANDS for the sample rate
# and by max_sfb, so a filter can end up narrower than its length says, or empty.
fn _tns_decode_apply(spec, st) {
    var n = load64(st + TNS_ST_NREC);
    if (n == 0) { return 0; }
    var tbl = _aac_swb_offset;
    var num_swb = _AAC_NUM_SWB;
    var limit = _aac_tns_max_long;
    var is_short = load64(st + TNS_ST_IS_SHORT);
    if (is_short == 1) {
        tbl = _aac_swb_short;
        num_swb = _AAC_NUM_SWB_SHORT;
        limit = _aac_tns_max_short;
    }
    var max_sfb = load64(st + TNS_ST_MAX_SFB);
    if (max_sfb < limit) { limit = max_sfb; }
    if (num_swb < limit) { limit = num_swb; }

    var kbuf = _aac_tmp((TNS_MAX_ORDER + 1) * 8);
    var abuf = _aac_tmp((TNS_MAX_ORDER + 1) * 8);
    var cur_w = 0 - 1;
    var bottom = 0;
    var r = 0;
    while (r < n) {
        var rec = st + TNS_ST_REC + r * TNS_REC_SIZE;
        r = r + 1;
        var w = load64(rec + TNS_REC_WINDOW);
        if (w != cur_w) {
            cur_w = w;
            bottom = num_swb;
        }
        var top = bottom;
        bottom = top - load64(rec + TNS_REC_LEN);
        if (bottom < 0) { bottom = 0; }

        var order = load64(rec + TNS_REC_ORDER);
        if (order > 0) {
            var lo = bottom;
            var hi = top;
            if (lo > limit) { lo = limit; }
            if (hi > limit) { hi = limit; }
            var resbits = load64(rec + TNS_REC_RESBITS);
            var i = 1;
            while (i <= order) {
                store64(kbuf + i * 8, _tns_dequant_coef(load64(rec + TNS_REC_COEF + (i - 1) * 8), resbits));
                i = i + 1;
            }
            _tns_parcor_to_lpc(kbuf, order, abuf);
            var base = spec;
            if (is_short == 1) { base = spec + w * AAC_SHORT_SIZE * 8; }
            _tns_filter(base, load64(tbl + lo * 8), load64(tbl + hi * 8), abuf, order,
              load64(rec + TNS_REC_DIR), 1);
        }
    }
    return 0;
}

# Decoder: rebuild the LPC from the decoded reflection coefficients and apply the
# synthesis (IIR) filter to the dequantized spectrum IN PLACE, before the IMDCT.
fn _tns_synth_apply(spec, st) {
    if (load64(st + TNS_ST_PARSED) == 1) { return _tns_decode_apply(spec, st); }
    if (load64(st + TNS_ST_PRESENT) == 0) { return 0; }
    var order = load64(st + TNS_ST_ORDER);
    if (order <= 0) { return 0; }
    var resbits = load64(st + TNS_ST_RESBITS);
    var kbuf = _aac_tmp((TNS_MAX_ORDER + 1) * 8);
    memset(kbuf, 0, (TNS_MAX_ORDER + 1) * 8);
    var i = 1;
    while (i <= order) {
        store64(kbuf + i * 8, _tns_dequant_coef(load64(st + TNS_ST_COEF + (i - 1) * 8), resbits));
        i = i + 1;
    }
    var abuf = _aac_tmp((TNS_MAX_ORDER + 1) * 8);
    _tns_parcor_to_lpc(kbuf, order, abuf);
    _tns_filter(spec, load64(st + TNS_ST_START), load64(st + TNS_ST_END), abuf, order, load64(st + TNS_ST_DIR), 1);
    return 0;
}

# Parse tns_data() into the TNS state (long window stores filter 0; short windows
# are consumed to stay in sync but not applied — the encoder is long-only).
fn _tns_parse_data(br, is_short, max_sfb, st) {
    store64(st + TNS_ST_PARSED, 1);
    store64(st + TNS_ST_MAX_SFB, max_sfb);
    store64(st + TNS_ST_IS_SHORT, is_short);
    var n_filt_bits = 2;
    var len_bits = 6;
    var order_bits = 5;
    var num_windows = 1;
    if (is_short == 1) { n_filt_bits = 1; len_bits = 4; order_bits = 3; num_windows = 8; }
    var w = 0;
    while (w < num_windows) {
        var n_filt = _br_read(br, n_filt_bits);
        if (is_err(n_filt) == 1) { return n_filt; }
        if (n_filt > 0) {
            var coef_res = _br_read(br, 1);
            if (is_err(coef_res) == 1) { return coef_res; }
            var res_bits = 3;
            if (coef_res == 1) { res_bits = 4; }
            var f = 0;
            while (f < n_filt) {
                var length = _br_read(br, len_bits);
                if (is_err(length) == 1) { return length; }
                var order = _br_read(br, order_bits);
                if (is_err(order) == 1) { return order; }
                if (order > TNS_MAX_ORDER) { return err(ERR_DECODE); }
                # Every filter gets a record, even at order 0: its length still
                # moves the next filter's band range.
                var nrec = load64(st + TNS_ST_NREC);
                if (nrec >= 8) { return err(ERR_DECODE); }
                var rec = st + TNS_ST_REC + nrec * TNS_REC_SIZE;
                store64(st + TNS_ST_NREC, nrec + 1);
                store64(rec + TNS_REC_WINDOW, w);
                store64(rec + TNS_REC_LEN, length);
                store64(rec + TNS_REC_ORDER, order);
                store64(rec + TNS_REC_DIR, 0);
                store64(rec + TNS_REC_RESBITS, res_bits);
                if (order > 0) {
                    var direction = _br_read(br, 1);
                    if (is_err(direction) == 1) { return direction; }
                    var compress = _br_read(br, 1);
                    if (is_err(compress) == 1) { return compress; }
                    store64(rec + TNS_REC_DIR, direction);
                    var coef_len = res_bits - compress;
                    var signbit = 1;
                    var sb = 0;
                    while (sb < coef_len - 1) { signbit = signbit * 2; sb = sb + 1; }
                    var store_it = 0;
                    if (is_short == 0) { if (f == 0) { store_it = 1; } }
                    var i = 0;
                    while (i < order) {
                        var raw = _br_read(br, coef_len);
                        if (is_err(raw) == 1) { return raw; }
                        var ci = raw;
                        if (raw >= signbit) { ci = raw - signbit * 2; }
                        store64(rec + TNS_REC_COEF + i * 8, ci);
                        if (store_it == 1) { store64(st + TNS_ST_COEF + i * 8, ci); }
                        i = i + 1;
                    }
                    if (store_it == 1) {
                        store64(st + TNS_ST_PRESENT, 1);
                        store64(st + TNS_ST_ORDER, order);
                        store64(st + TNS_ST_DIR, direction);
                        store64(st + TNS_ST_COMPRESS, compress);
                        store64(st + TNS_ST_RESBITS, res_bits);
                        var s_sfb = max_sfb - length;
                        if (s_sfb < 0) { s_sfb = 0; }
                        store64(st + TNS_ST_LEN, length);
                        store64(st + TNS_ST_START, load64(_aac_swb_offset + s_sfb * 8));
                        store64(st + TNS_ST_END, load64(_aac_swb_offset + max_sfb * 8));
                    }
                }
                f = f + 1;
            }
        }
        w = w + 1;
    }
    return 0;
}

# Parse the ICS extension (pulse/tns/gain presence flags). Fills st; returns 0 or err.
fn _aac_parse_ics_ext(br, is_short, max_sfb, st) {
    store64(st + TNS_ST_PRESENT, 0);
    var pulse = _br_read(br, 1);
    if (is_err(pulse) == 1) { return pulse; }
    if (pulse == 1) { return err(ERR_UNSUPPORTED_FMT); }   # pulse_data not produced by this encoder
    var tns_present = _br_read(br, 1);
    if (is_err(tns_present) == 1) { return tns_present; }
    if (tns_present == 1) {
        var prc = _tns_parse_data(br, is_short, max_sfb, st);
        if (is_err(prc) == 1) { return prc; }
    }
    var gain = _br_read(br, 1);
    if (is_err(gain) == 1) { return gain; }
    if (gain == 1) { return err(ERR_UNSUPPORTED_FMT); }
    return 0;
}

# ================================================================
# AAC-LC encoder
# ================================================================
# A rate-controlled encoder after 3GPP TS 26.403 (the reference encoder's
# description) and ffmpeg's implementation of it.
#
#   framing      1024 samples of priming, then one 2048-sample MDCT per 1024 new
#                samples, and a final frame to flush the overlap. Decoders that
#                do not read an edit list (ADTS has none) start 1024 samples late,
#                as with every AAC encoder.
#   windows      ONLY_LONG, and on an attack LONG_START, EIGHT_SHORT, LONG_STOP,
#                decided one frame ahead from the energy of high-passed 128-sample
#                blocks. The block holding the attack gets a group of its own.
#   psy          per band: -29 dB threshold, spread 15 dB/Bark upward and 30 dB/Bark
#                downward across bands, floored at the threshold in quiet (0 dBFS
#                = 96 dB SPL), pre-echo control across long frames, perceptual
#                entropy, and hole avoidance (TS 26.403 5.4 and 5.6.1).
#   bits         a bit reservoir; each frame asks for bits by its perceptual
#                entropy and the reservoir's fill (TS 26.403 5.6.1.2).
#   TNS          per window, when the spectrum's prediction gain clears 1.4.
#   M/S          per band, when coding mid and side costs less entropy than left
#                and right under the stricter of the two thresholds.
#   quantiser    each band gets the coarsest scalefactor whose measured noise fits
#                its threshold. One scale over all thresholds is bisected until
#                the exact frame size (codebooks chosen by dynamic programming
#                over sections, scalefactors, side information) fits the budget.
#   bandwidth    ffmpeg's cutoff for the bit rate per channel.

var _AE_SEQ_LONG = 0;
var _AE_SEQ_START = 1;
var _AE_SEQ_SHORT = 2;
var _AE_SEQ_STOP = 3;

# Configuration of the encode in progress.
var _ae_rate = 0;
var _ae_ch = 0;
var _ae_chan_br = 0;      # bit rate per channel
var _ae_avg = 0;          # raw_data_block bits a frame on average (ADTS header excluded)
var _ae_res = 0;          # bit reservoir size
var _ae_fill = 0;         # bits in the reservoir
var _ae_cut_l = 0;        # long bands coded (bandwidth)
var _ae_cut_s = 0;        # short bands coded
var _ae_pe_min = 0;       # f64, TS 26.403 bit demand
var _ae_pe_max = 0;
var _ae_pe_prev = 0;
var _ae_t_prev = 0;       # last frame's threshold scale (log2), the next search's start

# Features (tests and the quality rig switch them).
var _ae_use_short = 1;
var _ae_use_tns = 1;
var _ae_use_ms = 1;

# Per band psy coefficients for long [0..63] and short [64..127].
var _ae_spr_hi = 0;       # threshold spread toward higher bands
var _ae_spr_lo = 0;       # toward lower bands
var _ae_espr_hi = 0;      # energy spread (hole avoidance)
var _ae_espr_lo = 0;
var _ae_ath = 0;          # threshold in quiet, band energy
var _ae_ath_low = 0;      # dB the threshold in quiet is lowered by at this bit rate
var _AE_ATH_LOW_DB = 30;  # ... from 48 kbit/s a channel (0 at 32 and below, a ramp between)
var _ae_minsnr = 0;       # hole avoidance floor

# Tables.
var _ae_ig = 0;           # [256] 2^(-3/16 (sf - 100)): 1 / step^(3/4)
var _ae_wbuf = 0;         # [2048] windowed input
var _ae_mdct = 0;         # [1024] transform output
var _ae_fr = 0;           # [2][2560] this frame's padded samples per channel

# The frame being coded, shared by both channels (a CPE has one window).
var _ae_seq = 0;
var _ae_nwin = 1;
var _ae_ngrp = 1;
var _ae_glen = 0;         # [8] windows per group
var _ae_gw0 = 0;          # [8] first window of each group
var _ae_sfg = 0;          # scale_factor_grouping (7 bits)
var _ae_maxsfb = 0;
var _ae_nswb = 0;
var _ae_swb = 0;          # band offsets for this window size
var _ae_ms = 0;           # [512] M/S mask per (group, band)
var _ae_ms_present = 0;

# What the encoder did, for tests: [0] frames, [1..4] ONLY_LONG, LONG_START,
# EIGHT_SHORT, LONG_STOP frames, [5] windows with TNS, [6] M/S bands, [7] PNS
# bands, [8] intensity bands, [9] raw_data_block bits.
var _ae_stat = 0;

# Lookahead: block switching knows frame k + 1's attack while coding frame k.
var _ae_next_attack = 0;  # -1, or the block (0..7) of frame k + 1's attack
var _ae_cur_attack = 0;
var _ae_prev_seq = 0;

# Channel state.
var _AE_CS_THRQ = 0;      # [64] last long frame's thresholds in quiet
var _AE_CS_THRQ_OK = 8;   # 1 when those are valid for pre-echo control
var _AE_CS_SPEC = 16;     # [1024] spectrum: MDCT, then TNS, then M/S
var _AE_CS_E = 24;        # [512] energy per (group, band), index g * 64 + b
var _AE_CS_T = 32;        # [512] allowed noise
var _AE_CS_FF = 40;       # [512] form factor: sum of sqrt|x|
var _AE_CS_SCF = 48;      # [512] scalefactor
var _AE_CS_CB = 56;       # [512] codebook
var _AE_CS_Q = 64;        # [1024] quantised values
var _AE_CS_XP = 72;       # [1024] |x|^(3/4)
var _AE_CS_AH = 80;       # [512] hole avoidance on
var _AE_CS_TNS = 88;      # [8 * 16] per window: order, compress, then 12 coefficient indices
var _AE_CS_TNS_ON = 96;
var _AE_CS_GG = 104;      # global gain
var _AE_CS_PE = 112;      # perceptual entropy (f64)
var _AE_CS_ACC = 120;     # attack detector: smoothed block energy (f64)
var _AE_CS_HPX = 128;     # attack detector: last sample (f64)
var _AE_CS_MSNR = 136;    # [512] min_snr for this frame's bands
var _AE_CS_BITS = 144;    # bits of this channel's individual_channel_stream
var _AE_CS_TNSB = 152;    # TNS bits
var _AE_CS_SPC = 160;     # [512] 0, or the band's noise (13) / intensity (14, 15) codebook
var _AE_CS_ALPHA = 168;   # [64] tonality per band
var _AE_CS_TF = 176;      # [512] TNS factor: band energy after the filter over before (1 without TNS)
var _AE_CS_SIZE = 184;

var _ae_cs = 0;           # [2] channel state pointers
var _ae_cap = 0;          # scratch allocated
var _ae_bw = 0;           # the frame's bit writer, reused
var _ae_lohi = 0;         # [2] TNS band range
var _ae_bk = 0;           # [64] Bark centres while the band tables are built

fn _ae_scratch() {
    if (_ae_cap == 1) { return 0; }
    _ae_cap = 1;
    _ae_cs = alloc(2 * 8);
    var c = 0;
    while (c < 2) {
        var cs = alloc(_AE_CS_SIZE);
        memset(cs, 0, _AE_CS_SIZE);
        store64(cs + _AE_CS_THRQ, alloc(64 * 8));
        store64(cs + _AE_CS_SPEC, alloc(1024 * 8));
        store64(cs + _AE_CS_E, alloc(512 * 8));
        store64(cs + _AE_CS_T, alloc(512 * 8));
        store64(cs + _AE_CS_FF, alloc(512 * 8));
        store64(cs + _AE_CS_SCF, alloc(512 * 8));
        store64(cs + _AE_CS_CB, alloc(512 * 8));
        store64(cs + _AE_CS_Q, alloc(1024 * 8));
        store64(cs + _AE_CS_XP, alloc(1024 * 8));
        store64(cs + _AE_CS_AH, alloc(512 * 8));
        store64(cs + _AE_CS_TNS, alloc(8 * 16 * 8));
        store64(cs + _AE_CS_MSNR, alloc(512 * 8));
        store64(cs + _AE_CS_SPC, alloc(512 * 8));
        store64(cs + _AE_CS_ALPHA, alloc(64 * 8));
        store64(cs + _AE_CS_TF, alloc(512 * 8));
        store64(_ae_cs + c * 8, cs);
        c = c + 1;
    }
    _ae_spr_hi = alloc(128 * 8);
    _ae_spr_lo = alloc(128 * 8);
    _ae_espr_hi = alloc(128 * 8);
    _ae_espr_lo = alloc(128 * 8);
    _ae_ath = alloc(128 * 8);
    _ae_minsnr = alloc(128 * 8);
    _ae_wbuf = alloc(2048 * 8);
    _ae_mdct = alloc(1024 * 8);
    _ae_fr = alloc(2 * 2560 * 8);
    _ae_glen = alloc(8 * 8);
    _ae_gw0 = alloc(8 * 8);
    _ae_stat = alloc(16 * 8);
    _ae_ms = alloc(512 * 8);
    _ae_ig = alloc(256 * 8);
    _ae_bw = _bw_new();
    _ae_lohi = alloc(16);
    _ae_bk = alloc(64 * 8);
    var s = 0;
    while (s < 256) {
        store64(_ae_ig + s * 8, f64_pow(F64_TWO, f64_div(f64_from((100 - s) * 3), f64_from(16))));
        s = s + 1;
    }
    _aac_init_windows();
    _aac_init_norm();
    if (_aac_pow43_tab == 0) { _aac_dequant_tables(); }
    if (_aac_hcb1_lens == 0) { _aac_init_spectral_codebooks(); }
    if (_aac_hcb5_lens == 0) { _aac_init_spectral_codebooks(); }
    if (_aac_scf_lens == 0) { _aac_init_scf_codebook(); }
    return 0;
}

# ---------------------------------------------------------------- setup

fn _ae_bark(f) {
    var a = f64_mul(f64_div(f64_from(133), f64_from(10)), f64_atan(f64_mul(f64_div(f64_from(76), f64_from(100000)), f)));
    var r = f64_div(f, f64_from(7500));
    return f64_add(a, f64_mul(f64_div(f64_from(7), F64_TWO), f64_atan(f64_mul(r, r))));
}

# LAME's threshold in quiet in dB SPL (ffmpeg's ath() with ATH_ADD 4), f in Hz.
fn _ae_ath_db(f) {
    var k = f64_div(f, f64_from(1000));
    if (f64_lt(k, f64_div(f64_from(1), f64_from(100))) == 1) { k = f64_div(f64_from(1), f64_from(100)); }
    var t1 = f64_mul(f64_div(f64_from(364), f64_from(100)), f64_pow(k, f64_div(f64_from(0 - 8), f64_from(10))));
    var d1 = f64_sub(k, f64_div(f64_from(34), f64_from(10)));
    var t2 = f64_mul(f64_div(f64_from(68), f64_from(10)), f64_exp(f64_mul(f64_div(f64_from(0 - 6), f64_from(10)), f64_mul(d1, d1))));
    var d2 = f64_sub(k, f64_div(f64_from(87), f64_from(10)));
    var t3 = f64_mul(f64_from(6), f64_exp(f64_mul(f64_div(f64_from(0 - 15), f64_from(100)), f64_mul(d2, d2))));
    var k2 = f64_mul(k, k);
    var t4 = f64_mul(f64_div(f64_from(76), f64_from(100000)), f64_mul(k2, k2));
    var r = f64_add(f64_sub(t1, t2), f64_add(t3, t4));
    # Capped at 40 dB SPL (-56 dBFS). Uncapped, the f^4 term passes full scale near
    # 20 kHz and would drop everything above about 19 kHz at any level and any bit
    # rate. Bandwidth is the cutoff's decision; this only keeps quiet content out.
    if (f64_gt(r, f64_from(40)) == 1) { r = f64_from(40); }
    return r;
}

# Energy in the transform domain of a full-scale sine near 1 kHz: the 96 dB SPL
# reference that the threshold in quiet is measured against.
fn _ae_fullscale_energy(n) {
    var half = n / 2;
    var rise = _aac_window_tbl(0, 0);
    if (n == 256) { rise = _aac_window_tbl(1, 0); }
    var w = f64_div(f64_mul(F64_TWO, f64_mul(F64_PI, f64_from(1000))), f64_from(_ae_rate));
    var i = 0;
    while (i < n) {
        var wv = load64(rise + i * 8);
        if (i >= half) { wv = load64(rise + (n - 1 - i) * 8); }
        store64(_ae_wbuf + i * 8, f64_mul(f64_sin(f64_mul(w, f64_from(i))), wv));
        i = i + 1;
    }
    fft_mdct(_ae_wbuf, n, _ae_mdct);
    var e = 0;
    i = 0;
    while (i < half) {
        var v = f64_mul(load64(_ae_mdct + i * 8), _AAC_MDCT_DENORM);
        e = f64_add(e, f64_mul(v, v));
        i = i + 1;
    }
    return e;
}

# Spreading, threshold in quiet and hole-avoidance floors for one band table.
fn _ae_band_coefs(base, swb, nswb, n_lines, ncut) {
    var line_hz = f64_div(f64_from(_ae_rate), f64_from(n_lines * 2));
    var efs = _ae_fullscale_energy(n_lines * 2);
    var avg_bits = f64_div(f64_from(_ae_chan_br * n_lines), f64_from(_ae_rate));
    var bw_hz = f64_mul(f64_from(load64(swb + ncut * 8)), line_hz);
    var num_bark = _ae_bark(bw_hz);
    if (f64_lt(num_bark, F64_ONE) == 1) { num_bark = F64_ONE; }
    # The reference encoder spends 2.4% of the frame's entropy per Bark here.
    var bark_pe = f64_div(f64_mul(f64_div(f64_from(24), f64_from(1000)), f64_mul(f64_div(f64_from(118), f64_from(100)), avg_bits)), num_bark);
    var es_lo = f64_from(3);
    var es_hi = f64_from(2);
    if (n_lines == 128) { es_lo = F64_TWO; es_hi = f64_div(f64_from(3), F64_TWO); }
    if (_ae_chan_br <= 22000) { es_hi = f64_div(f64_from(3), F64_TWO); }
    var prev = 0;
    var b = 0;
    while (b < nswb) {
        var e = load64(swb + (b + 1) * 8);
        var bk = _ae_bark(f64_mul(f64_from(e - 1), line_hz));
        var mid = f64_mul(f64_add(bk, prev), F64_HALF);
        prev = bk;
        store64(_ae_bk + b * 8, mid);
        b = b + 1;
    }
    b = 0;
    while (b < nswb) {
        var width = 0;
        if (b + 1 < nswb) { width = f64_sub(load64(_ae_bk + (b + 1) * 8), load64(_ae_bk + b * 8)); }
        store64(_ae_spr_hi + (base + b) * 8, f64_pow(f64_from(10), f64_neg(f64_mul(width, f64_div(f64_from(3), F64_TWO)))));
        store64(_ae_spr_lo + (base + b) * 8, f64_pow(f64_from(10), f64_neg(f64_mul(width, f64_from(3)))));
        store64(_ae_espr_hi + (base + b) * 8, f64_pow(f64_from(10), f64_neg(f64_mul(width, es_hi))));
        store64(_ae_espr_lo + (base + b) * 8, f64_pow(f64_from(10), f64_neg(f64_mul(width, es_lo))));
        b = b + 1;
    }
    # min_snr after the bark widths are known (TS 26.403 5.6.1.3.3).
    b = 0;
    while (b < nswb) {
        var width2 = 0;
        if (b + 1 < nswb) { width2 = f64_sub(load64(_ae_bk + (b + 1) * 8), load64(_ae_bk + b * 8)); }
        var size = load64(swb + (b + 1) * 8) - load64(swb + b * 8);
        var pe_min = f64_mul(bark_pe, width2);
        var ms = f64_sub(f64_pow(F64_TWO, f64_div(pe_min, f64_from(size))), f64_div(f64_from(3), F64_TWO));
        var lo = f64_div(f64_from(316), f64_from(100000));      # -25 dB
        var hi = f64_div(f64_from(79432821), f64_from(100000000)); # -1 dB
        var v = hi;
        if (f64_gt(ms, 0) == 1) { v = f64_div(F64_ONE, ms); }
        if (f64_lt(v, lo) == 1) { v = lo; }
        if (f64_gt(v, hi) == 1) { v = hi; }
        if (f64_gt(ms, 0) == 0) { v = lo; }
        store64(_ae_minsnr + (base + b) * 8, v);
        b = b + 1;
    }
    b = 0;
    while (b < nswb) {
        # Threshold in quiet: the band's quietest line, as a tone's energy.
        var s = load64(swb + b * 8);
        var e2 = load64(swb + (b + 1) * 8);
        var mn = f64_from(200);
        var k = s;
        while (k < e2) {
            var db = _ae_ath_db(f64_mul(f64_from(k), line_hz));
            if (f64_lt(db, mn) == 1) { mn = db; }
            k = k + 1;
        }
        store64(_ae_ath + (base + b) * 8, f64_mul(efs, f64_pow(f64_from(10), f64_div(f64_sub(mn, f64_from(96 + _ae_ath_low)), f64_from(10)))));
        b = b + 1;
    }
    return 0;
}

# ffmpeg's AAC_CUTOFF_FROM_BITRATE for one channel. ffmpeg's twoloop feeds it
# 1.15 times the rate when PNS or intensity is on; measured on the corpus that
# cost 0.4-0.5 dB NMR and up to 3 dB of pre-echo at 16-32 kbit/s a channel and
# changed nothing from 48 kbit/s up (its only gain at 128 is content past 20 kHz).
fn _ae_cutoff_hz() {
    var br = _ae_chan_br;
    var a = br / 5;
    var a2 = br * 15 / 32 - 5500;
    if (a2 > a) { a = a2; }
    var c = 3000 + br / 4;
    if (c < a) { a = c; }
    var d = 12000 + br / 16;
    if (d < a) { a = d; }
    if (a > 22000) { a = 22000; }
    if (a > _ae_rate / 2) { a = _ae_rate / 2; }
    if (a < 3000) { a = 3000; }
    return a;
}

fn _ae_setup(rate, ch, bitrate) {
    _ae_scratch();
    _ae_rate = rate;
    _ae_ch = ch;
    _ae_chan_br = bitrate / ch;
    _aac_select_swb(_aac_find_sr_index(rate));
    var bits = bitrate * 1024 / rate - 56;
    if (bits < 48 * ch) { bits = 48 * ch; }
    if (bits > 6144 * ch - 64) { bits = 6144 * ch - 64; }
    _ae_avg = bits;
    _ae_res = 6144 * ch - bits;
    if (_ae_res < 0) { _ae_res = 0; }
    # The reservoir starts full, as in ffmpeg and FDK: a constant-rate decoder
    # buffers its 6144 bits a channel before the first frame, so a stream may
    # run ahead of its bit rate by one reservoir and never more. Empty (2.10.1's
    # first cut), the 3GPP bit demand spends 30-70% of the average while it
    # refills: at 32 kbit/s the first 30 frames came out nearly empty, and a
    # half-second clip decoded at 0.91 against ffmpeg's 0.985.
    _ae_fill = _ae_res;
    var cut = _ae_cutoff_hz();
    # Bands whose start lies below the cutoff.
    _ae_cut_l = 0;
    while (_ae_cut_l < _AAC_NUM_SWB && load64(_aac_swb_offset + _ae_cut_l * 8) * _ae_rate / 2048 < cut) { _ae_cut_l = _ae_cut_l + 1; }
    _ae_cut_s = 0;
    while (_ae_cut_s < _AAC_NUM_SWB_SHORT && load64(_aac_swb_short + _ae_cut_s * 8) * _ae_rate / 256 < cut) { _ae_cut_s = _ae_cut_s + 1; }
    if (_ae_cut_l < 1) { _ae_cut_l = 1; }
    if (_ae_cut_s < 1) { _ae_cut_s = 1; }
    # The threshold in quiet takes full scale to play at 96 dB SPL. Playback is
    # louder than that whenever a quiet passage is turned up, and at the level
    # assumed it dropped whole bands of quiet high-band content that ffmpeg codes:
    # Bark bands lost by 10 dB or more, 1.1% at 48 kbit/s a channel, 1.2% at 64
    # and 8.6% at 96 (all of 16-18 kHz; ffmpeg 0.0%). From 48 kbit/s a channel the
    # bits are there: lowered 30 dB, 0.1%, 0.0% and 0.0%, for 2.8-5.5 dB of NMR,
    # which stays 1-2 dB under ffmpeg's. (20 dB left 7.8% at 96.) At 32 and below
    # lowering it cost 1.3 dB and saved nothing: holes there come from the rate.
    _ae_ath_low = 0;
    if (_ae_chan_br > 32000) {
        _ae_ath_low = _AE_ATH_LOW_DB * (_ae_chan_br - 32000) / 16000;
        if (_ae_ath_low > _AE_ATH_LOW_DB) { _ae_ath_low = _AE_ATH_LOW_DB; }
    }
    _ae_band_coefs(0, _aac_swb_offset, _AAC_NUM_SWB, 1024, _ae_cut_l);
    _ae_band_coefs(64, _aac_swb_short, _AAC_NUM_SWB_SHORT, 128, _ae_cut_s);
    var bwf = f64_from(cut);
    _ae_pe_min = f64_mul(f64_from(8 * 1024 * ch), f64_div(bwf, f64_from(rate * 2)));
    _ae_pe_max = f64_mul(f64_from(12 * 1024 * ch), f64_div(bwf, f64_from(rate * 2)));
    _ae_pe_prev = 0;
    _ae_t_prev = 0;
    var c = 0;
    while (c < 2) {
        var cs = load64(_ae_cs + c * 8);
        store64(cs + _AE_CS_THRQ_OK, 0);
        store64(cs + _AE_CS_ACC, 0);
        store64(cs + _AE_CS_HPX, 0);
        c = c + 1;
    }
    _ae_prev_seq = _AE_SEQ_LONG;
    _ae_next_attack = 0 - 1;
    _ae_cur_attack = 0 - 1;
    memset(_ae_stat, 0, 16 * 8);
    return 0;
}

fn _ae_count_frame(used) {
    store64(_ae_stat, load64(_ae_stat) + 1);
    var si = 1;
    if (_ae_seq == _AE_SEQ_START) { si = 2; }
    if (_ae_seq == _AE_SEQ_SHORT) { si = 3; }
    if (_ae_seq == _AE_SEQ_STOP) { si = 4; }
    store64(_ae_stat + si * 8, load64(_ae_stat + si * 8) + 1);
    store64(_ae_stat + 9 * 8, load64(_ae_stat + 9 * 8) + used);
    var c = 0;
    while (c < _ae_ch) {
        var cs = load64(_ae_cs + c * 8);
        var rec = load64(cs + _AE_CS_TNS);
        var w = 0;
        while (w < _ae_nwin) {
            if (load64(cs + _AE_CS_TNS_ON) == 1 && load64(rec + w * 16 * 8) > 0) {
                store64(_ae_stat + 5 * 8, load64(_ae_stat + 5 * 8) + 1);
            }
            w = w + 1;
        }
        var CB = load64(cs + _AE_CS_CB);
        var g = 0;
        while (g < _ae_ngrp) {
            var b = 0;
            while (b < _ae_maxsfb) {
                var cb = load64(CB + (g * 64 + b) * 8);
                if (cb == 13) { store64(_ae_stat + 7 * 8, load64(_ae_stat + 7 * 8) + 1); }
                if (cb >= 14) { store64(_ae_stat + 8 * 8, load64(_ae_stat + 8 * 8) + 1); }
                if (c == 0 && load64(_ae_ms + (g * 64 + b) * 8) == 1 && _ae_ms_present > 0) {
                    store64(_ae_stat + 6 * 8, load64(_ae_stat + 6 * 8) + 1);
                }
                b = b + 1;
            }
            g = g + 1;
        }
        c = c + 1;
    }
    return 0;
}

# ---------------------------------------------------------------- input

var _ae_data = 0;         # interleaved f64 input
var _ae_total = 0;        # frames (samples per channel)

# Padded sample n of channel c: 1024 samples of priming, zeros past the end.
fn _ae_sample(c, n) {
    var i = n - 1024;
    if (i < 0) { return 0; }
    if (i >= _ae_total) { return 0; }
    var x = load64(_ae_data + (i * _ae_ch + c) * 8);
    # NaN is silence; infinities and anything past full scale are full scale.
    if (((x >> 52) & 0x7FF) == 0x7FF && (x & 0xFFFFFFFFFFFFF) != 0) { return 0; }
    if (f64_gt(x, F64_ONE) == 1) { return F64_ONE; }
    if (f64_lt(x, F64_NEG_ONE) == 1) { return F64_NEG_ONE; }
    return x;
}

# Copies frame k's 2048 padded samples of every channel into _ae_fr.
fn _ae_load_frame(k) {
    var c = 0;
    while (c < _ae_ch) {
        var dst = _ae_fr + c * 2560 * 8;
        var n0 = 1024 * k;
        var i = 0;
        while (i < 2048) {
            store64(dst + i * 8, _ae_sample(c, n0 + i));
            i = i + 1;
        }
        c = c + 1;
    }
    return 0;
}

# ---------------------------------------------------------------- block switching

var _AE_ATTACK_RATIO = 10;

# The first 128-sample block (0..7) of frame k's short-window span holding an
# attack in any channel, or -1. A block's energy is that of the first difference
# (a high-pass); an attack is a block ten times the smoothed energy before it,
# above a floor near -55 dBFS (TS 26.403 5.4.1's detector, simplified).
fn _ae_detect(k) {
    var first = 0 - 1;
    var floor_e = f64_div(f64_from(128), f64_from(316227766));
    var ratio = f64_from(_AE_ATTACK_RATIO);
    var c = 0;
    while (c < _ae_ch) {
        var cs = load64(_ae_cs + c * 8);
        var acc = load64(cs + _AE_CS_ACC);
        var n0 = 1024 * k + 512;
        var last = _ae_sample(c, n0 - 1);
        var w = 0;
        while (w < 8) {
            var e = 0;
            var i = 0;
            while (i < 128) {
                var x = _ae_sample(c, n0 + w * 128 + i);
                var d = f64_sub(x, last);
                e = f64_add(e, f64_mul(d, d));
                last = x;
                i = i + 1;
            }
            if (f64_gt(e, f64_mul(ratio, acc)) == 1) {
                if (f64_gt(e, floor_e) == 1) {
                    if (first < 0 || w < first) { first = w; }
                }
            }
            acc = f64_add(f64_mul(f64_div(f64_from(3), f64_from(10)), acc), f64_mul(f64_div(f64_from(7), f64_from(10)), e));
            w = w + 1;
        }
        store64(cs + _AE_CS_ACC, acc);
        c = c + 1;
    }
    return first;
}

# The window sequence for the frame being coded, from the previous frame's and
# whether this and the next frame hold attacks.
fn _ae_choose_seq(cur_attack, next_attack) {
    if (_ae_use_short == 0) { return _AE_SEQ_LONG; }
    var prev = _ae_prev_seq;
    if (prev == _AE_SEQ_START) { return _AE_SEQ_SHORT; }
    if (prev == _AE_SEQ_SHORT) {
        if (cur_attack >= 0) { return _AE_SEQ_SHORT; }
        if (next_attack >= 0) { return _AE_SEQ_SHORT; }
        return _AE_SEQ_STOP;
    }
    if (next_attack >= 0) { return _AE_SEQ_START; }
    return _AE_SEQ_LONG;
}

# Window groups of a short frame. A window joins the group of the one before it
# while their energies (both channels) stay within 6 dB and the group holds at
# most four, so an attack and the windows of its decay are not averaged into one
# scalefactor and one noise allowance. The attack window always starts a group.
var _ae_wen = 0;          # [8] f64 energy per short window

fn _ae_group_by_energy(attack) {
    if (_ae_wen == 0) { _ae_wen = alloc(8 * 8); }
    var w = 0;
    while (w < 8) {
        var e = 0;
        var c = 0;
        while (c < _ae_ch) {
            var spec = load64(load64(_ae_cs + c * 8) + _AE_CS_SPEC);
            var k = 0;
            while (k < 128) {
                var v = load64(spec + (w * 128 + k) * 8);
                e = f64_add(e, f64_mul(v, v));
                k = k + 1;
            }
            c = c + 1;
        }
        store64(_ae_wen + w * 8, f64_add(e, F64_ONE));
        w = w + 1;
    }
    var four = f64_from(4);       # 6 dB in energy
    var n = 0;
    w = 0;
    while (w < 8) {
        var start = 0;
        if (w == 0) { start = 1; }
        elif (w == attack) { start = 1; }
        elif (load64(_ae_glen + (n - 1) * 8) >= 4) { start = 1; }
        else {
            var a = load64(_ae_wen + w * 8);
            var p = load64(_ae_wen + (w - 1) * 8);
            if (f64_gt(a, f64_mul(p, four)) == 1 || f64_gt(p, f64_mul(a, four)) == 1) { start = 1; }
        }
        if (start == 1) {
            store64(_ae_gw0 + n * 8, w);
            store64(_ae_glen + n * 8, 1);
            n = n + 1;
        } else {
            store64(_ae_glen + (n - 1) * 8, load64(_ae_glen + (n - 1) * 8) + 1);
        }
        w = w + 1;
    }
    _ae_ngrp = n;
    _ae_sfg = 0;
    var g = 0;
    var wi = 0;
    while (g < n) {
        var l = load64(_ae_glen + g * 8);
        var j = 0;
        while (j < l) {
            if (wi > 0) {
                var cont = 0;
                if (j > 0) { cont = 1; }
                _ae_sfg = (_ae_sfg << 1) | cont;
            }
            wi = wi + 1;
            j = j + 1;
        }
        g = g + 1;
    }
    return n;
}

# Window groups of a short frame: the windows before the attack, the attack's
# window alone, then the rest in groups of up to three.
fn _ae_group(attack) {
    var n = 0;
    var w = 0;
    if (attack < 0) { attack = 8; }
    if (attack > 0) {
        if (attack > 8) { attack = 8; }
        store64(_ae_gw0 + n * 8, 0);
        store64(_ae_glen + n * 8, attack);
        n = n + 1;
        w = attack;
    }
    if (w < 8) {
        store64(_ae_gw0 + n * 8, w);
        store64(_ae_glen + n * 8, 1);
        n = n + 1;
        w = w + 1;
    }
    while (w < 8) {
        var len = 8 - w;
        if (len > 3) { len = 3; }
        store64(_ae_gw0 + n * 8, w);
        store64(_ae_glen + n * 8, len);
        n = n + 1;
        w = w + len;
    }
    _ae_ngrp = n;
    # scale_factor_grouping: bit i (MSB first, windows 1..7) set when window i
    # continues the group of window i - 1.
    _ae_sfg = 0;
    var g = 0;
    var wi = 0;
    while (g < n) {
        var l = load64(_ae_glen + g * 8);
        var j = 0;
        while (j < l) {
            if (wi > 0) {
                var cont = 0;
                if (j > 0) { cont = 1; }
                _ae_sfg = (_ae_sfg << 1) | cont;
            }
            wi = wi + 1;
            j = j + 1;
        }
        g = g + 1;
    }
    return n;
}

# ---------------------------------------------------------------- transform

# MDCT of channel c's frame for the chosen window sequence into its spectrum.
fn _ae_transform(c) {
    var x = _ae_fr + c * 2560 * 8;
    var spec = load64(load64(_ae_cs + c * 8) + _AE_CS_SPEC);
    var wl = _aac_window_tbl(0, 0);
    var ws = _aac_window_tbl(1, 0);
    var i = 0;
    if (_ae_seq == _AE_SEQ_SHORT) {
        var w = 0;
        while (w < 8) {
            var off = 448 + w * 128;
            i = 0;
            while (i < 256) {
                var wv = 0;
                if (i < 128) { wv = load64(ws + i * 8); } else { wv = load64(ws + (255 - i) * 8); }
                store64(_ae_wbuf + i * 8, f64_mul(load64(x + (off + i) * 8), wv));
                i = i + 1;
            }
            fft_mdct(_ae_wbuf, 256, _ae_mdct);
            i = 0;
            while (i < 128) {
                store64(spec + (w * 128 + i) * 8, f64_mul(load64(_ae_mdct + i * 8), _AAC_MDCT_DENORM));
                i = i + 1;
            }
            w = w + 1;
        }
        return 0;
    }
    while (i < 2048) {
        var v = 0;
        if (i < 1024) {
            v = load64(wl + i * 8);
            if (_ae_seq == _AE_SEQ_STOP) {
                if (i < 448) { v = 0; }
                elif (i < 576) { v = load64(ws + (i - 448) * 8); }
                else { v = F64_ONE; }
            }
        } else {
            var p = i - 1024;
            v = load64(wl + (1023 - p) * 8);
            if (_ae_seq == _AE_SEQ_START) {
                if (p < 448) { v = F64_ONE; }
                elif (p < 576) { v = load64(ws + (127 - (p - 448)) * 8); }
                else { v = 0; }
            }
        }
        store64(_ae_wbuf + i * 8, f64_mul(load64(x + i * 8), v));
        i = i + 1;
    }
    fft_mdct(_ae_wbuf, 2048, _ae_mdct);
    i = 0;
    while (i < 1024) {
        store64(spec + i * 8, f64_mul(load64(_ae_mdct + i * 8), _AAC_MDCT_DENORM));
        i = i + 1;
    }
    return 0;
}

# ---------------------------------------------------------------- psy

# Energy and threshold of band b in window w (128 lines a window when short).
fn _ae_band_energy(spec, w, b) {
    var s = load64(_ae_swb + b * 8);
    var e = load64(_ae_swb + (b + 1) * 8);
    var base = w * 128;
    var sum = 0;
    var k = s;
    while (k < e) {
        var v = load64(spec + (base + k) * 8);
        sum = f64_add(sum, f64_mul(v, v));
        k = k + 1;
    }
    return sum;
}

var _ae_fre = 0;          # [2048] f64 FFT real part (tonality)
var _ae_fim = 0;          # [2048] f64 FFT imaginary part
var _ae_fpw = 0;          # [1024] f64 power spectrum
var _ae_alpha = 0;        # [64] tonality per band, 0 (noise) .. 1 (tone)
var _ae_use_tonal = 1;
var _ae_hann = 0;          # [2048] the tonality estimate's window
var _ae_tw = 0;            # [1024] e^(-i pi k / 1024), the real FFT's twiddles

# Tonality per band from the spectral flatness of a Hann-windowed 2048-point FFT
# of the frame (Johnston's SFM; MDCT magnitudes swing with phase and cannot tell
# a tone from noise in a narrow band). A band narrower than 8 bins is measured
# over the 8 around it. -3 dB of flatness (noise) maps to 0, -20 dB (a tone) to 1.
fn _ae_tonality(c) {
    if (_ae_fre == 0) {
        _ae_fre = alloc(2048 * 8);
        _ae_fim = alloc(2048 * 8);
        _ae_fpw = alloc(1024 * 8);
        _ae_alpha = alloc(64 * 8);
        _ae_hann = alloc(2048 * 8);
        _ae_tw = alloc(2048 * 8);
        var hi = 0;
        while (hi < 2048) {
            store64(_ae_hann + hi * 8, f64_sub(F64_HALF, f64_mul(F64_HALF, f64_cos(f64_div(f64_mul(F64_TWO, f64_mul(F64_PI, f64_from(hi))), f64_from(2048))))));
            hi = hi + 1;
        }
        hi = 0;
        while (hi < 1024) {
            var ang = f64_div(f64_mul(F64_PI, f64_from(hi)), f64_from(1024));
            store64(_ae_tw + hi * 16, f64_cos(ang));
            store64(_ae_tw + hi * 16 + 8, f64_neg(f64_sin(ang)));
            hi = hi + 1;
        }
    }
    # The 2048-point spectrum of the real, windowed frame from one 1024-point
    # complex FFT: even samples as the real part, odd as the imaginary, then
    # X[k] = E[k] + W^k O[k] with E, O the even and odd halves' spectra.
    var x = _ae_fr + c * 2560 * 8;
    var i = 0;
    while (i < 1024) {
        store64(_ae_fre + i * 8, f64_mul(load64(x + i * 16), load64(_ae_hann + i * 16)));
        store64(_ae_fim + i * 8, f64_mul(load64(x + i * 16 + 8), load64(_ae_hann + i * 16 + 8)));
        i = i + 1;
    }
    fft_compute(_ae_fre, _ae_fim, 1024, 0);
    var floor_pw = f64_div(F64_ONE, f64_from(1000000000000));
    i = 0;
    while (i < 1024) {
        var m = (1024 - i) & 1023;
        var zr = load64(_ae_fre + i * 8);
        var zi = load64(_ae_fim + i * 8);
        var cr = load64(_ae_fre + m * 8);
        var ci = f64_neg(load64(_ae_fim + m * 8));
        var er = f64_mul(f64_add(zr, cr), F64_HALF);
        var ei = f64_mul(f64_add(zi, ci), F64_HALF);
        # (Z - conj Z') / 2i
        var orr = f64_mul(f64_sub(zi, ci), F64_HALF);
        var oi = f64_neg(f64_mul(f64_sub(zr, cr), F64_HALF));
        var wr = load64(_ae_tw + i * 16);
        var wi = load64(_ae_tw + i * 16 + 8);
        var re = f64_add(er, f64_sub(f64_mul(wr, orr), f64_mul(wi, oi)));
        var im = f64_add(ei, f64_add(f64_mul(wr, oi), f64_mul(wi, orr)));
        store64(_ae_fpw + i * 8, f64_add(f64_add(f64_mul(re, re), f64_mul(im, im)), floor_pw));
        i = i + 1;
    }
    var mul = 1;
    if (_ae_nwin == 8) { mul = 8; }
    var b = 0;
    while (b < _ae_maxsfb) {
        var s = load64(_ae_swb + b * 8) * mul;
        var e = load64(_ae_swb + (b + 1) * 8) * mul;
        if (e - s < 8) {
            var mid = (s + e) / 2;
            s = mid - 4;
            e = mid + 4;
            if (s < 0) { s = 0; e = 8; }
            if (e > 1024) { e = 1024; s = 1016; }
        }
        # one log per four lines: a product of four powers (each within about
        # 1e-12..1e13) stays far inside the f64 range
        var lg = 0;
        var ar = 0;
        var prod = F64_ONE;
        var np = 0;
        var k = s;
        while (k < e) {
            var pw = load64(_ae_fpw + k * 8);
            prod = f64_mul(prod, pw);
            ar = f64_add(ar, pw);
            np = np + 1;
            if (np == 4) { lg = f64_add(lg, f64_ln(prod)); prod = F64_ONE; np = 0; }
            k = k + 1;
        }
        if (np > 0) { lg = f64_add(lg, f64_ln(prod)); }
        var n = f64_from(e - s);
        # flatness in dB: 10 log10(geometric mean / arithmetic mean)
        var sfm = f64_mul(f64_div(f64_from(10), f64_ln(f64_from(10))), f64_sub(f64_div(lg, n), f64_ln(f64_div(ar, n))));
        var a = f64_div(f64_sub(f64_neg(sfm), f64_from(3)), f64_from(17));
        if (f64_lt(a, 0) == 1) { a = 0; }
        if (f64_gt(a, F64_ONE) == 1) { a = F64_ONE; }
        store64(_ae_alpha + b * 8, a);
        b = b + 1;
    }
    return 0;
}

var _ae_we = 0;           # [8 * 64] per window band energy
var _ae_wt = 0;           # [8 * 64] per window threshold
var _ae_wse = 0;          # [8 * 64] per window spread energy

# TS 26.403 thresholds for channel c's frame, then per (group, band) energy,
# threshold, hole avoidance and perceptual entropy.
fn _ae_psy(c) {
    if (_ae_we == 0) {
        _ae_we = alloc(8 * 64 * 8);
        _ae_wt = alloc(8 * 64 * 8);
        _ae_wse = alloc(8 * 64 * 8);
    }
    var cs = load64(_ae_cs + c * 8);
    var spec = load64(cs + _AE_CS_SPEC);
    var base = 0;
    if (_ae_nwin == 8) { base = 64; }
    var nb = _ae_maxsfb;
    # Signal-to-mask offset per band: TS 26.403's 29 dB for a tone, down to 12 dB
    # for noise (Johnston's rule, held conservative: the textbook noise offset is
    # 5.5 dB). The constant 29 dB treats every band as a tone. Long windows only:
    # short ones keep 29 dB, and PNS, the other reader, is long-only too.
    if (_ae_nwin == 1) { _ae_tonality(c); }
    var w = 0;
    while (w < _ae_nwin) {
        var b = 0;
        while (b < nb) {
            var e = _ae_band_energy(spec, w, b);
            var off = f64_from(29);
            # Not in short windows: there the attack's noise reaches back across
            # the window, and only the full offset keeps it under the quiet before.
            if (_ae_use_tonal == 1 && _ae_nwin == 1) {
                var al = load64(_ae_alpha + b * 8);
                off = f64_add(f64_mul(al, f64_from(29)), f64_mul(f64_sub(F64_ONE, al), f64_from(12)));
            }
            store64(_ae_we + (w * 64 + b) * 8, e);
            store64(_ae_wt + (w * 64 + b) * 8, f64_mul(e, f64_pow(f64_from(10), f64_div(f64_neg(off), f64_from(10)))));
            store64(_ae_wse + (w * 64 + b) * 8, e);
            b = b + 1;
        }
        # Spreading (5.4.2.3), upward then downward.
        b = 1;
        while (b < nb) {
            var t = load64(_ae_wt + (w * 64 + b) * 8);
            var up = f64_mul(load64(_ae_wt + (w * 64 + b - 1) * 8), load64(_ae_spr_hi + (base + b - 1) * 8));
            if (f64_gt(up, t) == 1) { store64(_ae_wt + (w * 64 + b) * 8, up); }
            var se = load64(_ae_wse + (w * 64 + b) * 8);
            var sup = f64_mul(load64(_ae_wse + (w * 64 + b - 1) * 8), load64(_ae_espr_hi + (base + b - 1) * 8));
            if (f64_gt(sup, se) == 1) { store64(_ae_wse + (w * 64 + b) * 8, sup); }
            b = b + 1;
        }
        b = nb - 2;
        while (b >= 0) {
            var t2 = load64(_ae_wt + (w * 64 + b) * 8);
            var dn = f64_mul(load64(_ae_wt + (w * 64 + b + 1) * 8), load64(_ae_spr_lo + (base + b) * 8));
            if (f64_gt(dn, t2) == 1) { store64(_ae_wt + (w * 64 + b) * 8, dn); }
            var se2 = load64(_ae_wse + (w * 64 + b) * 8);
            var sdn = f64_mul(load64(_ae_wse + (w * 64 + b + 1) * 8), load64(_ae_espr_lo + (base + b) * 8));
            if (f64_gt(sdn, se2) == 1) { store64(_ae_wse + (w * 64 + b) * 8, sdn); }
            b = b - 1;
        }
        # Threshold in quiet (5.4.2.4), then pre-echo control (5.4.2.5) on a long
        # frame that follows a long frame.
        b = 0;
        while (b < nb) {
            var t3 = load64(_ae_wt + (w * 64 + b) * 8);
            var q = load64(_ae_ath + (base + b) * 8);
            if (f64_lt(t3, q) == 1) { t3 = q; }
            var tq = t3;
            if (_ae_nwin == 1) {
                if (_ae_seq != _AE_SEQ_STOP) {
                    if (load64(cs + _AE_CS_THRQ_OK) == 1) {
                        var lim = f64_mul(F64_TWO, load64(load64(cs + _AE_CS_THRQ) + b * 8));
                        if (f64_lt(lim, t3) == 1) { t3 = lim; }
                        var lo = f64_mul(f64_div(F64_ONE, f64_from(100)), tq);
                        if (f64_lt(t3, lo) == 1) { t3 = lo; }
                    }
                }
                store64(load64(cs + _AE_CS_THRQ) + b * 8, tq);
            }
            store64(_ae_wt + (w * 64 + b) * 8, t3);
            b = b + 1;
        }
        w = w + 1;
    }
    store64(cs + _AE_CS_THRQ_OK, 0);
    if (_ae_nwin == 1) { store64(cs + _AE_CS_THRQ_OK, 1); }
    if (_ae_nwin == 1) { memcpy(load64(cs + _AE_CS_ALPHA), _ae_alpha, 64 * 8); }

    # Per (group, band): sums over the group's windows.
    var ah_thr = f64_div(F64_ONE, F64_TWO);
    if (_ae_nwin == 8) { ah_thr = f64_div(f64_from(63), f64_from(100)); }
    var E = load64(cs + _AE_CS_E);
    var T = load64(cs + _AE_CS_T);
    var AH = load64(cs + _AE_CS_AH);
    var MS = load64(cs + _AE_CS_MSNR);
    var g = 0;
    while (g < _ae_ngrp) {
        var w0 = load64(_ae_gw0 + g * 8);
        var gl = load64(_ae_glen + g * 8);
        var b2 = 0;
        while (b2 < nb) {
            var es = 0;
            var tmin = 0;
            var ss = 0;
            var j = 0;
            while (j < gl) {
                var ix = ((w0 + j) * 64 + b2) * 8;
                es = f64_add(es, load64(_ae_we + ix));
                var tw = load64(_ae_wt + ix);
                if (j == 0 || f64_lt(tw, tmin) == 1) { tmin = tw; }
                ss = f64_add(ss, load64(_ae_wse + ix));
                j = j + 1;
            }
            # One scalefactor spreads the noise evenly over the group's windows,
            # so each may take only what the quietest can hide.
            var ts = f64_mul(tmin, f64_from(gl));
            var gi = (g * 64 + b2) * 8;
            store64(E + gi, es);
            store64(T + gi, ts);
            var msnr = load64(_ae_minsnr + (base + b2) * 8);
            store64(MS + gi, msnr);
            var ah = 1;
            if (f64_gt(f64_mul(ss, ah_thr), es) == 1) { ah = 0; }
            if (f64_gt(msnr, F64_ONE) == 1) { ah = 0; }
            store64(AH + gi, ah);
            b2 = b2 + 1;
        }
        g = g + 1;
    }
    return 0;
}

# Form factors (sum of sqrt|x|) and |x|^(3/4) of the spectrum to be quantised.
fn _ae_prepare(c) {
    var cs = load64(_ae_cs + c * 8);
    var spec = load64(cs + _AE_CS_SPEC);
    var XP = load64(cs + _AE_CS_XP);
    var FF = load64(cs + _AE_CS_FF);
    var g = 0;
    while (g < _ae_ngrp) {
        var w0 = load64(_ae_gw0 + g * 8);
        var gl = load64(_ae_glen + g * 8);
        var b = 0;
        while (b < _ae_maxsfb) {
            var s = load64(_ae_swb + b * 8);
            var e = load64(_ae_swb + (b + 1) * 8);
            var ff = 0;
            var j = 0;
            while (j < gl) {
                var base = (w0 + j) * 128;
                var k = s;
                while (k < e) {
                    var a = f64_abs(load64(spec + (base + k) * 8));
                    var r = f64_sqrt(a);
                    ff = f64_add(ff, r);
                    store64(XP + (base + k) * 8, f64_sqrt(f64_mul(a, r)));    # |x|^(3/4)
                    k = k + 1;
                }
                j = j + 1;
            }
            store64(FF + (g * 64 + b) * 8, ff);
            b = b + 1;
        }
        g = g + 1;
    }
    return 0;
}

# Perceptual entropy of a band (TS 26.403 5.6.1.3.1).
fn _ae_band_pe(e, t, ff, n) {
    if (f64_gt(e, t) == 0) { return 0; }
    var nl = f64_mul(ff, f64_sqrt(f64_sqrt(f64_div(f64_from(n), e))));
    var d = f64_log2(f64_div(e, t));
    if (f64_lt(d, f64_from(3)) == 1) {
        d = f64_add(f64_mul(d, f64_div(f64_from(55935729), f64_from(100000000))), f64_div(f64_from(13219281), f64_from(10000000)));
    }
    return f64_mul(d, nl);
}

fn _ae_channel_pe(c) {
    var cs = load64(_ae_cs + c * 8);
    var E = load64(cs + _AE_CS_E);
    var T = load64(cs + _AE_CS_T);
    var FF = load64(cs + _AE_CS_FF);
    var pe = 0;
    var g = 0;
    while (g < _ae_ngrp) {
        var gl = load64(_ae_glen + g * 8);
        var b = 0;
        while (b < _ae_maxsfb) {
            var gi = (g * 64 + b) * 8;
            var n = (load64(_ae_swb + (b + 1) * 8) - load64(_ae_swb + b * 8)) * gl;
            pe = f64_add(pe, _ae_band_pe(load64(E + gi), load64(T + gi), load64(FF + gi), n));
            b = b + 1;
        }
        g = g + 1;
    }
    store64(cs + _AE_CS_PE, pe);
    return pe;
}

# Bits the frame may ask for (TS 26.403 5.6.1.2, as ffmpeg's calc_bit_demand).
fn _ae_bit_demand(pe) {
    var short = 0;
    if (_ae_nwin == 8) { short = 1; }
    var save_slope = f64_div(f64_from(0 - 46666667), f64_from(100000000));
    var save_add = f64_div(f64_from(0 - 84285712), f64_from(100000000));
    var spend_slope = f64_div(f64_from(66666669), f64_from(100000000));
    var spend_add = f64_div(f64_from(0 - 35), f64_from(100));
    var clip_hi = f64_div(f64_from(95), f64_from(100));
    if (short == 1) {
        save_slope = f64_div(f64_from(0 - 36363637), f64_from(100000000));
        save_add = f64_div(f64_from(0 - 75), f64_from(100));
        spend_slope = f64_div(f64_from(81818181), f64_from(100000000));
        spend_add = f64_div(f64_from(0 - 26111111), f64_from(100000000));
        clip_hi = f64_div(f64_from(75), f64_from(100));
    }
    var clip_lo = f64_div(f64_from(2), f64_from(10));
    var fill = clip_hi;
    if (_ae_res > 0) { fill = f64_div(f64_from(_ae_fill), f64_from(_ae_res)); }
    if (f64_lt(fill, clip_lo) == 1) { fill = clip_lo; }
    if (f64_gt(fill, clip_hi) == 1) { fill = clip_hi; }
    var cpe = pe;
    if (f64_lt(cpe, _ae_pe_min) == 1) { cpe = _ae_pe_min; }
    if (f64_gt(cpe, _ae_pe_max) == 1) { cpe = _ae_pe_max; }
    var bit_save = f64_mul(f64_add(fill, save_add), save_slope);
    var bit_spend = f64_mul(f64_add(fill, spend_add), spend_slope);
    var span = f64_sub(_ae_pe_max, _ae_pe_min);
    if (f64_gt(span, F64_ONE) == 0) { span = F64_ONE; }
    var factor = f64_add(f64_sub(F64_ONE, bit_save), f64_mul(f64_div(f64_sub(bit_spend, bit_save), span), f64_sub(cpe, _ae_pe_min)));
    # Track the range of the entropy seen (ffmpeg's slow forgetting of the minimum).
    if (f64_gt(pe, _ae_pe_max) == 1) { _ae_pe_max = pe; }
    var r = f64_mul(pe, f64_div(pe, _ae_pe_max));
    if (f64_lt(r, _ae_pe_min) == 1) { r = _ae_pe_min; }
    var fm = f64_div(f64_add(f64_mul(_ae_pe_min, f64_from(511)), r), f64_from(512));
    if (f64_lt(pe, fm) == 1) { fm = pe; }
    _ae_pe_min = fm;
    var want = f64_to(f64_mul(f64_from(_ae_avg), factor));
    var most = _ae_avg + _ae_fill;
    if (want > most) { want = most; }
    if (want < _ae_avg / 8) { want = _ae_avg / 8; }
    return want;
}

# ---------------------------------------------------------------- TNS

var _ae_tr = 0;           # [16] f64 autocorrelation
var _ae_tk = 0;           # [16] f64 reflection coefficients
var _ae_ta = 0;           # [16] f64 LPC
var _ae_tt = 0;           # [16] f64 recursion scratch
var _ae_tx = 0;           # [1024] f64 filter input copy

# TNS limits for this rate: from about 1.3 kHz long, 2.75 kHz short (TS 26.403),
# up to TNS_MAX_BANDS.
fn _ae_tns_range(lo_ptr, hi_ptr) {
    var short = 0;
    if (_ae_nwin == 8) { short = 1; }
    var hz = 1275;
    var lines = 1024;
    var lim = _aac_tns_max_long;
    if (short == 1) { hz = 2750; lines = 128; lim = _aac_tns_max_short; }
    if (lim > _ae_maxsfb) { lim = _ae_maxsfb; }
    var lo = 0;
    while (lo < lim && load64(_ae_swb + lo * 8) * _ae_rate / (lines * 2) < hz) { lo = lo + 1; }
    store64(lo_ptr, lo);
    store64(hi_ptr, lim);
    return 0;
}

# Same recursion as _tns_parcor_to_lpc, without its allocation.
fn _ae_parcor_to_lpc(k, order, a) {
    var i = 0;
    while (i <= 12) { store64(a + i * 8, 0); i = i + 1; }
    store64(a, F64_ONE);
    var m = 1;
    while (m <= order) {
        var km = load64(k + m * 8);
        i = 1;
        while (i < m) {
            store64(_ae_tt + i * 8, f64_add(load64(a + i * 8), f64_mul(km, load64(a + (m - i) * 8))));
            i = i + 1;
        }
        i = 1;
        while (i < m) { store64(a + i * 8, load64(_ae_tt + i * 8)); i = i + 1; }
        store64(a + m * 8, km);
        m = m + 1;
    }
    return 0;
}

# Analysis filter over spec[s..e), upward, with LPC _ae_ta: the inverse of the
# decoder's synthesis in _tns_filter (direction 0).
fn _ae_tns_fir(spec, s, e, order) {
    var n = e - s;
    var t = 0;
    while (t < n) { store64(_ae_tx + t * 8, load64(spec + (s + t) * 8)); t = t + 1; }
    var i = 0;
    while (i < n) {
        var acc = load64(_ae_tx + i * 8);
        var j = 1;
        while (j <= order) {
            if (i - j >= 0) { acc = f64_add(acc, f64_mul(load64(_ae_ta + j * 8), load64(_ae_tx + (i - j) * 8))); }
            j = j + 1;
        }
        store64(spec + (s + i) * 8, acc);
        i = i + 1;
    }
    return 0;
}

var _AE_TNS_GAIN_X100 = 200;     # prediction gain needed, x100 (TS 26.403: 1.4; 2 measured better on music, same on attacks)

# TNS for channel c: per window, if the spectrum's prediction gain clears the
# threshold, quantise the reflection coefficients (4 bits), filter with the
# quantised filter and record it. Leaves the bit cost in _AE_CS_TNSB.
fn _ae_tns(c) {
    if (_ae_tr == 0) {
        _ae_tr = alloc(16 * 8);
        _ae_tk = alloc(16 * 8);
        _ae_ta = alloc(16 * 8);
        _ae_tt = alloc(16 * 8);
        _ae_tx = alloc(1024 * 8);
    }
    var cs = load64(_ae_cs + c * 8);
    var spec = load64(cs + _AE_CS_SPEC);
    var rec = load64(cs + _AE_CS_TNS);
    memset(rec, 0, 8 * 16 * 8);
    store64(cs + _AE_CS_TNS_ON, 0);
    var TF = load64(cs + _AE_CS_TF);
    var tfi = 0;
    while (tfi < 512) { store64(TF + tfi * 8, F64_ONE); tfi = tfi + 1; }
    var bits = 0;
    var short = 0;
    if (_ae_nwin == 8) { short = 1; }
    if (_ae_use_tns == 0) {
        store64(cs + _AE_CS_TNSB, 1);
        return 0;
    }
    _ae_tns_range(_ae_lohi, _ae_lohi + 8);
    var lo = load64(_ae_lohi);
    var hi = load64(_ae_lohi + 8);
    var maxo = 12;
    if (short == 1) { maxo = 7; }
    var w = 0;
    while (w < _ae_nwin) {
        var wb = w * 128;
        var nfilt_bits = 2;
        if (short == 1) { nfilt_bits = 1; }
        bits = bits + nfilt_bits;
        if (hi - lo >= 2) {
            var s = wb + load64(_ae_swb + lo * 8);
            var e = wb + load64(_ae_swb + hi * 8);
            if (e - s > maxo * 2) {
                # Autocorrelation and Levinson-Durbin over the TNS range.
                var lag = 0;
                while (lag <= maxo) {
                    var acc = 0;
                    var i = s;
                    while (i + lag < e) {
                        acc = f64_add(acc, f64_mul(load64(spec + i * 8), load64(spec + (i + lag) * 8)));
                        i = i + 1;
                    }
                    store64(_ae_tr + lag * 8, acc);
                    lag = lag + 1;
                }
                var r0 = load64(_ae_tr);
                var order = 0;
                if (f64_gt(r0, 0) == 1) {
                    var err = r0;
                    store64(_ae_ta, F64_ONE);
                    var m = 1;
                    var ok = 1;
                    while (m <= maxo && ok == 1) {
                        var a2 = load64(_ae_tr + m * 8);
                        var i2 = 1;
                        while (i2 < m) {
                            a2 = f64_add(a2, f64_mul(load64(_ae_ta + i2 * 8), load64(_ae_tr + (m - i2) * 8)));
                            i2 = i2 + 1;
                        }
                        var km = f64_neg(f64_div(a2, err));
                        if (f64_gt(f64_abs(km), F64_ONE) == 1) { ok = 0; }
                        if (ok == 1) {
                            i2 = 1;
                            while (i2 < m) {
                                store64(_ae_tt + i2 * 8, f64_add(load64(_ae_ta + i2 * 8), f64_mul(km, load64(_ae_ta + (m - i2) * 8))));
                                i2 = i2 + 1;
                            }
                            i2 = 1;
                            while (i2 < m) { store64(_ae_ta + i2 * 8, load64(_ae_tt + i2 * 8)); i2 = i2 + 1; }
                            store64(_ae_ta + m * 8, km);
                            store64(_ae_tk + m * 8, km);
                            err = f64_mul(err, f64_sub(F64_ONE, f64_mul(km, km)));
                            if (f64_gt(err, 0) == 0) { ok = 0; }
                            m = m + 1;
                        }
                    }
                    if (ok == 1) {
                        if (f64_gt(f64_mul(r0, f64_from(100)), f64_mul(err, f64_from(_AE_TNS_GAIN_X100))) == 1) { order = maxo; }
                    }
                }
                if (order > 0) {
                    # Quantise; drop trailing zero indices.
                    var r = rec + w * 16 * 8;
                    var j = 1;
                    while (j <= order) {
                        store64(r + (1 + j) * 8, _tns_quant_coef(load64(_ae_tk + j * 8), 4));
                        j = j + 1;
                    }
                    while (order > 0 && load64(r + (1 + order) * 8) == 0) { order = order - 1; }
                }
                if (order > 0) {
                    var r2 = rec + w * 16 * 8;
                    var comp = 1;
                    var j2 = 1;
                    while (j2 <= order) {
                        var ci = load64(r2 + (1 + j2) * 8);
                        if (ci < 0 - 4 || ci > 3) { comp = 0; }
                        store64(_ae_tk + j2 * 8, _tns_dequant_coef(ci, 4));
                        j2 = j2 + 1;
                    }
                    store64(r2, order);
                    store64(r2 + 8, comp);
                    _ae_parcor_to_lpc(_ae_tk, order, _ae_ta);
                    _ae_tns_fir(spec, s, e, order);
                    store64(cs + _AE_CS_TNS_ON, 1);
                    # coef_res, length, order, direction, compress, coefficients
                    if (short == 1) { bits = bits + 1 + 4 + 3 + 1 + 1 + order * (4 - comp); }
                    else { bits = bits + 1 + 6 + 5 + 1 + 1 + order * (4 - comp); }
                }
            }
        }
        w = w + 1;
    }
    if (load64(cs + _AE_CS_TNS_ON) == 0) { bits = 0; }
    store64(cs + _AE_CS_TNSB, bits + 1);     # + tns_data_present
    if (load64(cs + _AE_CS_TNS_ON) == 1) { _ae_tns_domain(cs, lo, hi); }
    return 0;
}

# The quantiser codes the filtered spectrum, and the decoder's synthesis filter
# raises that noise again by about the prediction gain. So, in the TNS range of a
# group with a filtered window, energy and allowed noise move to the filtered
# domain: E' is the band's energy after the filter, T' = T E'/E keeps the planned
# signal-to-noise ratio. TF = E'/E lets the rate loop's reduction rule still work
# on the psychoacoustic values. Without this, TNS lowered the SNR of every
# filtered band by its prediction gain (clicks at 128 kbit/s: onset SNR 9 dB).
fn _ae_tns_domain(cs, lo, hi) {
    var spec = load64(cs + _AE_CS_SPEC);
    var rec = load64(cs + _AE_CS_TNS);
    var E = load64(cs + _AE_CS_E);
    var T = load64(cs + _AE_CS_T);
    var TF = load64(cs + _AE_CS_TF);
    var g = 0;
    while (g < _ae_ngrp) {
        var w0 = load64(_ae_gw0 + g * 8);
        var gl = load64(_ae_glen + g * 8);
        var any = 0;
        var j = 0;
        while (j < gl) {
            if (load64(rec + (w0 + j) * 16 * 8) > 0) { any = 1; }
            j = j + 1;
        }
        if (any == 1) {
            var b = lo;
            while (b < hi) {
                var s = load64(_ae_swb + b * 8);
                var e = load64(_ae_swb + (b + 1) * 8);
                var ef = 0;
                j = 0;
                while (j < gl) {
                    var base = (w0 + j) * 128;
                    var k = s;
                    while (k < e) {
                        var v = load64(spec + (base + k) * 8);
                        ef = f64_add(ef, f64_mul(v, v));
                        k = k + 1;
                    }
                    j = j + 1;
                }
                var gi = (g * 64 + b) * 8;
                var e0 = load64(E + gi);
                if (f64_gt(e0, 0) == 1 && f64_gt(ef, 0) == 1) {
                    var f = f64_div(ef, e0);
                    store64(TF + gi, f);
                    store64(E + gi, ef);
                    store64(T + gi, f64_mul(load64(T + gi), f));
                }
                b = b + 1;
            }
        }
        g = g + 1;
    }
    return 0;
}

# 1 when channel cs filters band b of group g with TNS (some window of the group
# has a filter, and b is in the TNS range lo..hi).
fn _ae_tns_covers(cs, g, b, lo, hi) {
    if (load64(cs + _AE_CS_TNS_ON) == 0) { return 0; }
    if (b < lo || b >= hi) { return 0; }
    var rec = load64(cs + _AE_CS_TNS);
    var w0 = load64(_ae_gw0 + g * 8);
    var gl = load64(_ae_glen + g * 8);
    var j = 0;
    while (j < gl) {
        if (load64(rec + (w0 + j) * 16 * 8) > 0) { return 1; }
        j = j + 1;
    }
    return 0;
}

# ---------------------------------------------------------------- PNS, intensity

var _ae_use_pns = 1;
var _ae_use_is = 1;

# Perceptual noise substitution and intensity stereo, for low rates only, with
# frequency limits in Hz (the 2.9.x encoder's were bin numbers at 44.1 kHz).
#   PNS        at most 24 kbit/s a channel: a noise-like band (tonality under
#              0.3) above 4 kHz is sent as its energy, and the decoder fills it
#              with noise of that energy. Measured on the corpus at 24 kbit/s a
#              channel it cuts bands lost by 10 dB or more from 3.3% to 0.9%
#              (ffmpeg 2.0%) for 1.3 dB of NMR (ffmpeg's PNS costs 1.4); at 32 it
#              saves 0.6% to 0.2% for 2.9 dB, and above that the bits code those
#              bands. (Substituting only the bands the rate loop would drop
#              changed nothing: hole avoidance keeps them.) Only in a long or
#              LONG_STOP frame without TNS: the noise fills the whole window, so
#              in a frame reaching into an attack it would be pre-echo.
#   intensity  stereo at most 48 kbit/s a channel: above 6 kHz (8 kHz at 48),
#              where left and right correlate past 0.9, right is sent as a gain
#              on left. Not where either channel's TNS filters the band:
#              decoders apply intensity before TNS, so the copy would be the
#              left's filtered spectrum, and the right's filter would run on it.
fn _ae_special() {
    var c = 0;
    while (c < _ae_ch) {
        memset(load64(load64(_ae_cs + c * 8) + _AE_CS_SPC), 0, 512 * 8);
        c = c + 1;
    }
    var lines = 1024;
    if (_ae_nwin == 8) { lines = 128; }
    var pns_ok = 0;
    if (_ae_seq == _AE_SEQ_LONG || _ae_seq == _AE_SEQ_STOP) { pns_ok = 1; }
    if (_ae_use_pns == 1 && _ae_chan_br <= 24000 && pns_ok == 1) {
        var pns_hz = 4000;
        var tonal_max = f64_div(f64_from(3), f64_from(10));
        c = 0;
        while (c < _ae_ch) {
            var cs = load64(_ae_cs + c * 8);
            if (load64(cs + _AE_CS_TNS_ON) == 1) {
                c = c + 1;
                continue;
            }
            var E = load64(cs + _AE_CS_E);
            var T = load64(cs + _AE_CS_T);
            var SPC = load64(cs + _AE_CS_SPC);
            var SCF = load64(cs + _AE_CS_SCF);
            var AL = load64(cs + _AE_CS_ALPHA);
            var g = 0;
            while (g < _ae_ngrp) {
                var gl = load64(_ae_glen + g * 8);
                var b = 0;
                while (b < _ae_maxsfb) {
                    var s0 = load64(_ae_swb + b * 8);
                    var n = load64(_ae_swb + (b + 1) * 8) - s0;
                    var gi = (g * 64 + b) * 8;
                    if (s0 * _ae_rate / (lines * 2) >= pns_hz && n >= 4) {
                        var e = load64(E + gi);
                        if (f64_gt(e, load64(T + gi)) == 1 && f64_lt(load64(AL + b * 8), tonal_max) == 1) {
                            # decoder: each window's band carries energy 2^(nrg / 2)
                            var ew = f64_div(e, f64_from(gl));
                            store64(SPC + gi, 13);
                            store64(SCF + gi, f64_to(f64_round(f64_mul(F64_TWO, f64_log2(ew)))));
                        }
                    }
                    b = b + 1;
                }
                g = g + 1;
            }
            c = c + 1;
        }
    }
    if (_ae_use_is == 1 && _ae_ch == 2 && _ae_chan_br <= 48000) {
        var c1 = load64(_ae_cs + 8);
        var c0 = load64(_ae_cs);
        _ae_tns_range(_ae_lohi, _ae_lohi + 8);
        var tlo = load64(_ae_lohi);
        var thi = load64(_ae_lohi + 8);
        var is_hz = 8000;
        if (_ae_chan_br <= 32000) { is_hz = 6000; }
        var sl = load64(c0 + _AE_CS_SPEC);
        var sr = load64(c1 + _AE_CS_SPEC);
        var S0 = load64(c0 + _AE_CS_SPC);
        var S1 = load64(c1 + _AE_CS_SPC);
        var F1 = load64(c1 + _AE_CS_SCF);
        var g2 = 0;
        while (g2 < _ae_ngrp) {
            var w0 = load64(_ae_gw0 + g2 * 8);
            var gl2 = load64(_ae_glen + g2 * 8);
            var b2 = 0;
            while (b2 < _ae_maxsfb) {
                var gi2 = (g2 * 64 + b2) * 8;
                var bs = load64(_ae_swb + b2 * 8);
                var be = load64(_ae_swb + (b2 + 1) * 8);
                var tns_l = _ae_tns_covers(c0, g2, b2, tlo, thi);
                var tns_r = _ae_tns_covers(c1, g2, b2, tlo, thi);
                if (bs * _ae_rate / (lines * 2) >= is_hz && load64(S0 + gi2) == 0 && tns_l == 0 && tns_r == 0) {
                    var dot = 0; var el = 0; var er = 0;
                    var j = 0;
                    while (j < gl2) {
                        var base = (w0 + j) * 128;
                        var k = bs;
                        while (k < be) {
                            var L = load64(sl + (base + k) * 8);
                            var R = load64(sr + (base + k) * 8);
                            dot = f64_add(dot, f64_mul(L, R));
                            el = f64_add(el, f64_mul(L, L));
                            er = f64_add(er, f64_mul(R, R));
                            k = k + 1;
                        }
                        j = j + 1;
                    }
                    if (f64_gt(el, 0) == 1 && f64_gt(er, 0) == 1) {
                        var cr = f64_div(dot, f64_sqrt(f64_mul(el, er)));
                        if (f64_gt(f64_abs(cr), f64_div(f64_from(9), f64_from(10))) == 1) {
                            # decoder: right = left * 0.5^(pos / 4), so pos = 2 log2(E_L / E_R)
                            var pos = f64_to(f64_round(f64_mul(F64_TWO, f64_log2(f64_div(el, er)))));
                            var cbi = 15;
                            if (f64_lt(cr, 0) == 1) { cbi = 14; }
                            store64(S1 + gi2, cbi);
                            store64(F1 + gi2, pos);
                        }
                    }
                }
                b2 = b2 + 1;
            }
            g2 = g2 + 1;
        }
    }
    return 0;
}

# ---------------------------------------------------------------- M/S

# Mid/side per (group, band) where it costs less entropy than left/right with
# both channels held to the stricter threshold (the noise of M and S lands in
# both L and R).
fn _ae_ms_decide() {
    memset(_ae_ms, 0, 512 * 8);
    _ae_ms_present = 0;
    if (_ae_ch != 2) { return 0; }
    if (_ae_use_ms == 0) { return 0; }
    var c0 = load64(_ae_cs);
    var c1 = load64(_ae_cs + 8);
    var sl = load64(c0 + _AE_CS_SPEC);
    var sr = load64(c1 + _AE_CS_SPEC);
    var EL = load64(c0 + _AE_CS_E);
    var ER = load64(c1 + _AE_CS_E);
    var TL = load64(c0 + _AE_CS_T);
    var TR = load64(c1 + _AE_CS_T);
    var used = 0;
    var total = 0;
    var special = 0;
    var g = 0;
    while (g < _ae_ngrp) {
        var w0 = load64(_ae_gw0 + g * 8);
        var gl = load64(_ae_glen + g * 8);
        var b = 0;
        while (b < _ae_maxsfb) {
            var s = load64(_ae_swb + b * 8);
            var e = load64(_ae_swb + (b + 1) * 8);
            var el = 0; var er = 0; var em = 0; var es = 0;
            var fl = 0; var fr = 0; var fm = 0; var fs = 0;
            var j = 0;
            while (j < gl) {
                var base = (w0 + j) * 128;
                var k = s;
                while (k < e) {
                    var L = load64(sl + (base + k) * 8);
                    var R = load64(sr + (base + k) * 8);
                    var M = f64_mul(f64_add(L, R), F64_HALF);
                    var S = f64_mul(f64_sub(L, R), F64_HALF);
                    el = f64_add(el, f64_mul(L, L));
                    er = f64_add(er, f64_mul(R, R));
                    em = f64_add(em, f64_mul(M, M));
                    es = f64_add(es, f64_mul(S, S));
                    fl = f64_add(fl, f64_sqrt(f64_abs(L)));
                    fr = f64_add(fr, f64_sqrt(f64_abs(R)));
                    fm = f64_add(fm, f64_sqrt(f64_abs(M)));
                    fs = f64_add(fs, f64_sqrt(f64_abs(S)));
                    k = k + 1;
                }
                j = j + 1;
            }
            var gi = (g * 64 + b) * 8;
            # noise and intensity bands (decoders skip mid/side on either)
            if (load64(load64(c0 + _AE_CS_SPC) + gi) != 0 || load64(load64(c1 + _AE_CS_SPC) + gi) != 0) {
                special = 1;
                b = b + 1;
                continue;
            }
            var tl = load64(TL + gi);
            var tr = load64(TR + gi);
            var tm = tl;
            if (f64_lt(tr, tm) == 1) { tm = tr; }
            var n = (e - s) * gl;
            var pe_lr = f64_add(_ae_band_pe(el, tl, fl, n), _ae_band_pe(er, tr, fr, n));
            # Mid and side: the decoder adds and subtracts them, so their noise
            # reaches L and R at full strength; hold each to half the stricter
            # threshold.
            var tms = f64_mul(tm, F64_HALF);
            var pe_ms = f64_add(_ae_band_pe(em, tms, fm, n), _ae_band_pe(es, tms, fs, n));
            total = total + 1;
            if (f64_lt(pe_ms, pe_lr) == 1) {
                store64(_ae_ms + gi, 1);
                used = used + 1;
                j = 0;
                while (j < gl) {
                    var base2 = (w0 + j) * 128;
                    var k2 = s;
                    while (k2 < e) {
                        var L2 = load64(sl + (base2 + k2) * 8);
                        var R2 = load64(sr + (base2 + k2) * 8);
                        store64(sl + (base2 + k2) * 8, f64_mul(f64_add(L2, R2), F64_HALF));
                        store64(sr + (base2 + k2) * 8, f64_mul(f64_sub(L2, R2), F64_HALF));
                        k2 = k2 + 1;
                    }
                    j = j + 1;
                }
                store64(EL + gi, em);
                store64(ER + gi, es);
                store64(TL + gi, tms);
                store64(TR + gi, tms);
                var FL = load64(c0 + _AE_CS_TF);
                var FR = load64(c1 + _AE_CS_TF);
                var fmin = load64(FL + gi);
                if (f64_lt(load64(FR + gi), fmin) == 1) { fmin = load64(FR + gi); }
                store64(FL + gi, fmin);
                store64(FR + gi, fmin);
            }
            b = b + 1;
        }
        g = g + 1;
    }
    if (used > 0) { _ae_ms_present = 1; }
    # "Every band" would also flip the sign of each intensity band.
    if (used == total && special == 0) { _ae_ms_present = 2; }
    return 0;
}

# ---------------------------------------------------------------- quantiser

# Quantises band (g, b) of channel c at scalefactor sf into its Q slots and
# returns the noise energy. _ae_qmax gets the largest magnitude.
var _ae_qmax = 0;
var _ae_qover = 0;            # 1 when a value needed more than 8191
var _AE_AH_SPAN = 48;       # quarter octaves of threshold scale under hole avoidance

fn _ae_quant_band(cs, g, b, sf) {
    var spec = load64(cs + _AE_CS_SPEC);
    var XP = load64(cs + _AE_CS_XP);
    var Q = load64(cs + _AE_CS_Q);
    var ig = load64(_ae_ig + sf * 8);
    var step = load64(_aac_step_tab + sf * 8);
    var magic = f64_div(f64_from(4054), f64_from(10000));
    var w0 = load64(_ae_gw0 + g * 8);
    var gl = load64(_ae_glen + g * 8);
    var s = load64(_ae_swb + b * 8);
    var e = load64(_ae_swb + (b + 1) * 8);
    var noise = 0;
    var qmax = 0;
    var over = 0;
    var j = 0;
    while (j < gl) {
        var base = (w0 + j) * 128;
        var k = s;
        while (k < e) {
            var ix = (base + k) * 8;
            var q = f64_to(f64_add(f64_mul(load64(XP + ix), ig), magic));
            if (q > 8191) { q = 8191; over = 1; }
            var x = load64(spec + ix);
            var a = f64_abs(x);
            var d = f64_sub(a, f64_mul(load64(_aac_pow43_tab + q * 8), step));
            noise = f64_add(noise, f64_mul(d, d));
            if (q > qmax) { qmax = q; }
            if (f64_lt(x, 0) == 1) { q = 0 - q; }
            store64(Q + ix, q);
            k = k + 1;
        }
        j = j + 1;
    }
    _ae_qmax = qmax;
    _ae_qover = over;
    return noise;
}

fn _ae_zero_band(cs, g, b) {
    var Q = load64(cs + _AE_CS_Q);
    var w0 = load64(_ae_gw0 + g * 8);
    var gl = load64(_ae_glen + g * 8);
    var s = load64(_ae_swb + b * 8);
    var e = load64(_ae_swb + (b + 1) * 8);
    var j = 0;
    while (j < gl) {
        var base = (w0 + j) * 128;
        var k = s;
        while (k < e) {
            store64(Q + (base + k) * 8, 0);
            k = k + 1;
        }
        j = j + 1;
    }
    return 0;
}

# Scalefactors and quantised spectrum of channel c at reduction step u. A band
# whose energy is under its threshold is left out (codebook 0). Raising u costs
# bits monotonically:
#   0 .. 48       every threshold raised as thr' = (thr^(1/4) + r)^4 (TS 26.403
#                 5.6.1.3.4), r rising to the frame's largest E^(1/4): a loud
#                 band's threshold barely moves while a quiet band's climbs past
#                 its energy. A band hole avoidance protects (one its neighbours
#                 do not mask) is then kept, coarsely, at noise 1 dB under its
#                 energy rather than dropped: a hole is more audible than noise.
#   48 .. 48 + nb from the top band down, that protection goes.
# u below 0 lowers every threshold by 2^(u/4): spending bits the reservoir
# cannot hold.
#
# ffmpeg also applies min_snr floors (to 25 dB of SNR) under hole avoidance. Its
# two-loop quantiser treats the thresholds as a guide; enforced exactly they
# starved the loudest tonal bands (whose floor min_snr puts at 1 dB) to keep
# noise bands at 25 dB, so the floors are left out.
var _ae_rmax = 0;         # largest E^(1/4) of the frame (f64)
var _ae_rule = 1;         # 1: (thr^(1/4) + r)^4, TS 26.403; 0: thresholds scaled by 2^(u/4)

fn _ae_quant_channel(c, u) {
    var nb = _ae_maxsfb;
    var t = u;
    if (t > _AE_AH_SPAN) { t = _AE_AH_SPAN; }
    var r = 0;
    if (t > 0) {
        var span = f64_sub(f64_pow(F64_TWO, f64_div(f64_from(_AE_AH_SPAN), f64_from(4))), F64_ONE);
        r = f64_mul(_ae_rmax, f64_div(f64_sub(f64_pow(F64_TWO, f64_div(f64_from(t), f64_from(4))), F64_ONE), span));
    }
    var open_from = nb;               # bands at or above this lose the protection
    if (u > _AE_AH_SPAN) {
        var k2 = u - _AE_AH_SPAN;
        if (k2 > nb) { k2 = nb; }
        open_from = nb - k2;
    }
    var minus1db = f64_div(f64_from(79432821), f64_from(100000000));
    var cs = load64(_ae_cs + c * 8);
    var E = load64(cs + _AE_CS_E);
    var T = load64(cs + _AE_CS_T);
    var FF = load64(cs + _AE_CS_FF);
    var AH = load64(cs + _AE_CS_AH);
    var SCF = load64(cs + _AE_CS_SCF);
    var CB = load64(cs + _AE_CS_CB);
    var TF = load64(cs + _AE_CS_TF);
    var scale = F64_ONE;
    if (u < 0) { scale = f64_pow(F64_TWO, f64_div(f64_from(u), f64_from(4))); }
    var prev = 0 - 1;
    var g = 0;
    while (g < _ae_ngrp) {
        var b = 0;
        while (b < _ae_maxsfb) {
            var gi = (g * 64 + b) * 8;
            var spc = load64(load64(cs + _AE_CS_SPC) + gi);
            if (spc != 0) {
                _ae_zero_band(cs, g, b);
                store64(CB + gi, spc);
                b = b + 1;
                continue;
            }
            var e = load64(E + gi);
            var tt = f64_mul(load64(T + gi), scale);
            if (t > 0) {
                # In the psychoacoustic domain (TF undoes the TNS filter's scaling).
                var tf = load64(TF + gi);
                var tu = f64_div(load64(T + gi), tf);
                var eu = f64_div(e, tf);
                var ttu = tu;
                if (_ae_rule == 1) {
                    var q4 = f64_add(f64_sqrt(f64_sqrt(tu)), r);
                    var q2 = f64_mul(q4, q4);
                    ttu = f64_mul(q2, q2);
                } else {
                    ttu = f64_mul(tu, f64_pow(F64_TWO, f64_div(f64_from(t), f64_from(4))));
                }
                if (load64(AH + gi) == 1 && b < open_from) {
                    var floor_t = f64_mul(eu, minus1db);
                    if (f64_gt(ttu, floor_t) == 1) {
                        ttu = floor_t;
                        if (f64_lt(ttu, tu) == 1) { ttu = tu; }
                    }
                }
                tt = f64_mul(ttu, tf);
            }
            var ff = load64(FF + gi);
            if (f64_gt(e, tt) == 0 || f64_gt(ff, 0) == 0) {
                _ae_zero_band(cs, g, b);
                store64(CB + gi, 0);
                b = b + 1;
                continue;
            }
            # noise ~ (4/27) step^(3/2) sum sqrt|x|  =>  sf = 100 + (8/3) log2(6.75 t / ff)
            var est = f64_mul(f64_div(f64_from(8), f64_from(3)), f64_log2(f64_div(f64_mul(f64_div(f64_from(27), f64_from(4)), tt), ff)));
            var sf = 100 + f64_to(f64_floor(est));
            if (sf < 0) { sf = 0; }
            if (sf > 255) { sf = 255; }
            if (prev >= 0) {
                if (sf > prev + 60) { sf = prev + 60; }
                if (sf < prev - 60) { sf = prev - 60; }
            }
            # The coarsest scalefactor whose noise fits tt: bracket by doubling
            # from the estimate (exact for many levels, poor for a band one tone
            # dominates), then bisect. "Fits" also needs every value within 8191
            # and the scalefactor within 60 of the previous coded band's.
            var lo_lim = 0;
            var hi_lim = 255;
            if (prev >= 0) {
                lo_lim = prev - 60;
                hi_lim = prev + 60;
                if (lo_lim < 0) { lo_lim = 0; }
                if (hi_lim > 255) { hi_lim = 255; }
            }
            if (sf < lo_lim) { sf = lo_lim; }
            if (sf > hi_lim) { sf = hi_lim; }
            var good = 0 - 1;
            var bad = 0 - 1;
            var nz = _ae_quant_band(cs, g, b, sf);
            if (_ae_qover == 0 && f64_gt(nz, tt) == 0) { good = sf; } else { bad = sf; }
            var stp = 4;
            if (good >= 0) {
                # coarser until it no longer fits
                while (bad < 0) {
                    var up = good + stp;
                    if (up > hi_lim) { up = hi_lim; }
                    if (up == good) { bad = good + 1; }
                    else {
                        nz = _ae_quant_band(cs, g, b, up);
                        if (_ae_qover == 0 && f64_gt(nz, tt) == 0 && _ae_qmax > 0) { good = up; stp = stp * 2; }
                        else { bad = up; }
                    }
                }
            } else {
                # finer until it fits
                while (good < 0) {
                    var dn = bad - stp;
                    if (dn < lo_lim) { dn = lo_lim; }
                    if (dn == bad) { good = bad; bad = bad + 1; }
                    else {
                        nz = _ae_quant_band(cs, g, b, dn);
                        if (_ae_qover == 0 && f64_gt(nz, tt) == 0) { good = dn; }
                        elif (_ae_qover == 1) { good = dn + 1; bad = dn + 2; }
                        else { bad = dn; stp = stp * 2; }
                    }
                }
            }
            while (bad - good > 1) {
                var mid = (good + bad) / 2;
                nz = _ae_quant_band(cs, g, b, mid);
                if (_ae_qover == 0 && f64_gt(nz, tt) == 0 && _ae_qmax > 0) { good = mid; } else { bad = mid; }
            }
            sf = good;
            var noise = _ae_quant_band(cs, g, b, sf);
            while (_ae_qover == 1 && sf < 255) {
                sf = sf + 1;
                noise = _ae_quant_band(cs, g, b, sf);
            }
            if (_ae_qmax == 0) {
                _ae_zero_band(cs, g, b);
                store64(CB + gi, 0);
                b = b + 1;
                continue;
            }
            store64(SCF + gi, sf);
            store64(CB + gi, 1);       # chosen by _ae_sections; nonzero marks a coded band
            prev = sf;
            b = b + 1;
        }
        g = g + 1;
    }
    return 0;
}

# ---------------------------------------------------------------- bit counting

# Codeword bits of band (g, b) of channel c with codebook cb, or a large number
# when the band's values do not fit the codebook.
fn _ae_cb_bits(cs, g, b, cb) {
    var Q = load64(cs + _AE_CS_Q);
    var w0 = load64(_ae_gw0 + g * 8);
    var gl = load64(_ae_glen + g * 8);
    var s = load64(_ae_swb + b * 8);
    var e = load64(_ae_swb + (b + 1) * 8);
    var bits = 0;
    var j = 0;
    while (j < gl) {
        var p = Q + ((w0 + j) * 128 + s) * 8;
        var pe = Q + ((w0 + j) * 128 + e) * 8;
        if (cb <= 4) {
            while (p < pe) {
                var a0 = load64(p);
                var a1 = load64(p + 8);
                var a2 = load64(p + 16);
                var a3 = load64(p + 24);
                if (cb <= 2) {
                    if (a0 < 0 - 1 || a0 > 1 || a1 < 0 - 1 || a1 > 1 || a2 < 0 - 1 || a2 > 1 || a3 < 0 - 1 || a3 > 1) { return 1000000; }
                    var idx = (a0 + 1) * 27 + (a1 + 1) * 9 + (a2 + 1) * 3 + (a3 + 1);
                    if (cb == 1) { bits = bits + load64(_aac_hcb1_lens + idx * 8); }
                    else { bits = bits + load64(_aac_hcb2_lens + idx * 8); }
                } else {
                    if (a0 < 0) { a0 = 0 - a0; }
                    if (a1 < 0) { a1 = 0 - a1; }
                    if (a2 < 0) { a2 = 0 - a2; }
                    if (a3 < 0) { a3 = 0 - a3; }
                    if (a0 > 2 || a1 > 2 || a2 > 2 || a3 > 2) { return 1000000; }
                    var idx2 = a0 * 27 + a1 * 9 + a2 * 3 + a3;
                    if (cb == 3) { bits = bits + load64(_aac_hcb3_lens + idx2 * 8); }
                    else { bits = bits + load64(_aac_hcb4_lens + idx2 * 8); }
                    if (a0 > 0) { bits = bits + 1; }
                    if (a1 > 0) { bits = bits + 1; }
                    if (a2 > 0) { bits = bits + 1; }
                    if (a3 > 0) { bits = bits + 1; }
                }
                p = p + 32;
            }
        } else {
            while (p < pe) {
                var x = load64(p);
                var y = load64(p + 8);
                if (cb <= 6) {
                    if (x < 0 - 4 || x > 4 || y < 0 - 4 || y > 4) { return 1000000; }
                    var i5 = (x + 4) * 9 + (y + 4);
                    if (cb == 5) { bits = bits + load64(_aac_hcb5_lens + i5 * 8); }
                    else { bits = bits + load64(_aac_hcb6_lens + i5 * 8); }
                } else {
                    if (x < 0) { x = 0 - x; }
                    if (y < 0) { y = 0 - y; }
                    if (x > 0) { bits = bits + 1; }
                    if (y > 0) { bits = bits + 1; }
                    if (cb <= 8) {
                        if (x > 7 || y > 7) { return 1000000; }
                        if (cb == 7) { bits = bits + load64(_aac_hcb7_lens + (x * 8 + y) * 8); }
                        else { bits = bits + load64(_aac_hcb8_lens + (x * 8 + y) * 8); }
                    } elif (cb <= 10) {
                        if (x > 12 || y > 12) { return 1000000; }
                        if (cb == 9) { bits = bits + load64(_aac_hcb9_lens + (x * 13 + y) * 8); }
                        else { bits = bits + load64(_aac_hcb10_lens + (x * 13 + y) * 8); }
                    } else {
                        var cx = x;
                        var cy = y;
                        if (cx > 16) { cx = 16; }
                        if (cy > 16) { cy = 16; }
                        bits = bits + load64(_aac_hcb11_lens + (cx * 17 + cy) * 8);
                        if (x >= 16) { bits = bits + 2 * _ae_ilog2(x) - 3; }
                        if (y >= 16) { bits = bits + 2 * _ae_ilog2(y) - 3; }
                    }
                }
                p = p + 16;
            }
        }
        j = j + 1;
    }
    return bits;
}

fn _ae_ilog2(v) {
    var r = 0;
    while (v > 1) { v = v >> 1; r = r + 1; }
    return r;
}

# The smallest codebook that can hold magnitude m.
fn _ae_min_cb(m) {
    if (m == 0) { return 0; }
    if (m <= 1) { return 1; }
    if (m <= 2) { return 3; }
    if (m <= 4) { return 5; }
    if (m <= 7) { return 7; }
    if (m <= 12) { return 9; }
    return 11;
}

var _ae_cost = 0;         # [64 * 12] per band, per codebook
var _ae_dp = 0;           # [64 * 12]
var _ae_from = 0;         # [64 * 12]

# Chooses the codebook of every coded band of group g by dynamic programming
# over sections, writing them into CB, and returns spectral plus section bits.
fn _ae_sections(cs, g) {
    if (_ae_cost == 0) {
        _ae_cost = alloc(64 * 16 * 8);
        _ae_dp = alloc(64 * 16 * 8);
        _ae_from = alloc(64 * 16 * 8);
    }
    var CB = load64(cs + _AE_CS_CB);
    var Q = load64(cs + _AE_CS_Q);
    var nb = _ae_maxsfb;
    var big = 100000000;
    var lenbits = 5;
    var esc = 31;
    if (_ae_nwin == 8) { lenbits = 3; esc = 7; }
    var hdr = 4 + lenbits;
    var b = 0;
    while (b < nb) {
        var gi = (g * 64 + b) * 8;
        var cb = 0;
        while (cb < 16) { store64(_ae_cost + (b * 16 + cb) * 8, big); cb = cb + 1; }
        var cbf = load64(CB + gi);
        if (cbf == 0) {
            store64(_ae_cost + (b * 16) * 8, 0);
        } elif (cbf >= 13) {
            store64(_ae_cost + (b * 16 + cbf) * 8, 0);    # noise or intensity: fixed
        } else {
            # largest magnitude in the band
            var w0 = load64(_ae_gw0 + g * 8);
            var gl = load64(_ae_glen + g * 8);
            var s = load64(_ae_swb + b * 8);
            var e = load64(_ae_swb + (b + 1) * 8);
            var m = 0;
            var j = 0;
            while (j < gl) {
                var k = s;
                while (k < e) {
                    var v = load64(Q + ((w0 + j) * 128 + k) * 8);
                    if (v < 0) { v = 0 - v; }
                    if (v > m) { m = v; }
                    k = k + 1;
                }
                j = j + 1;
            }
            var c0 = _ae_min_cb(m);
            # The cheapest codebooks are near the smallest that fits; cost four.
            var c1 = c0;
            var lim = c0 + 3;
            if (lim > 11) { lim = 11; }
            while (c1 <= lim) {
                store64(_ae_cost + (b * 16 + c1) * 8, _ae_cb_bits(cs, g, b, c1));
                c1 = c1 + 1;
            }
            if (c0 < 11) { store64(_ae_cost + (b * 16 + 11) * 8, _ae_cb_bits(cs, g, b, 11)); }
        }
        b = b + 1;
    }
    # dp[b][cb]: least bits for bands 0..b with band b in a section of codebook cb.
    b = 0;
    while (b < nb) {
        var cb2 = 0;
        while (cb2 < 16) {
            var cst = load64(_ae_cost + (b * 16 + cb2) * 8);
            var best = big;
            var from = 0 - 1;
            if (cst < big) {
                if (b == 0) {
                    best = cst + hdr;
                } else {
                    var p = 0;
                    while (p < 16) {
                        var v2 = load64(_ae_dp + ((b - 1) * 16 + p) * 8);
                        if (v2 < big) {
                            if (p != cb2) { v2 = v2 + hdr; }
                            if (v2 + cst < best) { best = v2 + cst; from = p; }
                        }
                        p = p + 1;
                    }
                }
            }
            store64(_ae_dp + (b * 16 + cb2) * 8, best);
            store64(_ae_from + (b * 16 + cb2) * 8, from);
            cb2 = cb2 + 1;
        }
        b = b + 1;
    }
    var bestc = 0;
    var bestv = big;
    var c3 = 0;
    while (c3 < 16) {
        var v3 = load64(_ae_dp + ((nb - 1) * 16 + c3) * 8);
        if (v3 < bestv) { bestv = v3; bestc = c3; }
        c3 = c3 + 1;
    }
    b = nb - 1;
    var cur = bestc;
    while (b >= 0) {
        store64(CB + (g * 64 + b) * 8, cur);
        cur = load64(_ae_from + (b * 16 + cur) * 8);
        b = b - 1;
    }
    # Exact section cost: escapes for long sections.
    var total = 0;
    b = 0;
    while (b < nb) {
        var cbv = load64(CB + (g * 64 + b) * 8);
        var run = 1;
        while (b + run < nb && load64(CB + (g * 64 + b + run) * 8) == cbv) { run = run + 1; }
        total = total + 4 + lenbits * (run / esc + 1);
        var r = 0;
        while (r < run) {
            total = total + load64(_ae_cost + ((b + r) * 16 + cbv) * 8);
            r = r + 1;
        }
        b = b + run;
    }
    return total;
}

# Bits of channel c's individual_channel_stream after quantisation: global gain,
# sections, spectral data, scalefactors, the three presence flags and TNS.
fn _ae_channel_bits(c) {
    var cs = load64(_ae_cs + c * 8);
    var CB = load64(cs + _AE_CS_CB);
    var SCF = load64(cs + _AE_CS_SCF);
    var bits = 8 + 1 + 1 + load64(cs + _AE_CS_TNSB);
    var g = 0;
    # global_gain: the first spectrally coded band's scalefactor.
    var first = 0 - 1;
    while (g < _ae_ngrp && first < 0) {
        var b0 = 0;
        while (b0 < _ae_maxsfb && first < 0) {
            var cb0 = load64(CB + (g * 64 + b0) * 8);
            if (cb0 >= 1 && cb0 <= 11) { first = load64(SCF + (g * 64 + b0) * 8); }
            b0 = b0 + 1;
        }
        g = g + 1;
    }
    var gg = first;
    if (gg < 0) { gg = 100; }
    store64(cs + _AE_CS_GG, gg);
    g = 0;
    var prev = gg;
    var noise_prev = gg - 90;
    var noise_first = 1;
    var is_prev = 0;
    while (g < _ae_ngrp) {
        bits = bits + _ae_sections(cs, g);
        var b = 0;
        while (b < _ae_maxsfb) {
            var gi = (g * 64 + b) * 8;
            var cb = load64(CB + gi);
            if (cb >= 1 && cb <= 11) {
                var sf = load64(SCF + gi);
                bits = bits + load64(_aac_scf_lens + (sf - prev + 60) * 8);
                prev = sf;
            } elif (cb == 13) {
                var nv = load64(SCF + gi);
                if (noise_first == 1) {
                    # 9 bits raw: nrg - (global_gain - 90) + 256
                    var raw = nv - noise_prev + 256;
                    if (raw < 0) { raw = 0; }
                    if (raw > 511) { raw = 511; }
                    nv = noise_prev + raw - 256;
                    bits = bits + 9;
                    noise_first = 0;
                } else {
                    var d = nv - noise_prev;
                    if (d < 0 - 60) { d = 0 - 60; }
                    if (d > 60) { d = 60; }
                    nv = noise_prev + d;
                    bits = bits + load64(_aac_scf_lens + (d + 60) * 8);
                }
                store64(SCF + gi, nv);
                noise_prev = nv;
            } elif (cb >= 14) {
                var iv = load64(SCF + gi);
                var di = iv - is_prev;
                if (di < 0 - 60) { di = 0 - 60; }
                if (di > 60) { di = 60; }
                iv = is_prev + di;
                store64(SCF + gi, iv);
                bits = bits + load64(_aac_scf_lens + (di + 60) * 8);
                is_prev = iv;
            }
            b = b + 1;
        }
        g = g + 1;
    }
    store64(cs + _AE_CS_BITS, bits);
    return bits;
}

# Frame bits at threshold scale t: both channels' streams plus element headers.
fn _ae_frame_bits(t) {
    var ics_info = 11;
    if (_ae_nwin == 8) { ics_info = 15; }
    var bits = 3 + 4 + 3;          # element id, instance, ID_END
    if (_ae_ch == 2) {
        bits = bits + 1 + ics_info + 2;
        if (_ae_ms_present == 1) { bits = bits + _ae_ngrp * _ae_maxsfb; }
    } else {
        bits = bits + ics_info;
    }
    var c = 0;
    while (c < _ae_ch) {
        _ae_quant_channel(c, t);
        bits = bits + _ae_channel_bits(c);
        c = c + 1;
    }
    return bits;
}

# ---------------------------------------------------------------- writing

fn _ae_write_sign(bw, v) {
    if (v < 0) { _bw_write(bw, 1, 1); } else { _bw_write(bw, 0, 1); }
    return 0;
}

fn _ae_write_escape(bw, v) {
    if (v < 16) { return 0; }
    var n = _ae_ilog2(v);           # 2^n <= v < 2^(n+1), n >= 4
    var k = 0;
    while (k < n - 4) { _bw_write(bw, 1, 1); k = k + 1; }
    _bw_write(bw, 0, 1);
    _bw_write(bw, v - (1 << n), n);
    return 0;
}

fn _ae_write_band(bw, cs, g, b, cb) {
    var Q = load64(cs + _AE_CS_Q);
    var w0 = load64(_ae_gw0 + g * 8);
    var gl = load64(_ae_glen + g * 8);
    var s = load64(_ae_swb + b * 8);
    var e = load64(_ae_swb + (b + 1) * 8);
    var j = 0;
    while (j < gl) {
        var p = Q + ((w0 + j) * 128 + s) * 8;
        var pe = Q + ((w0 + j) * 128 + e) * 8;
        if (cb <= 4) {
            while (p < pe) {
                var a0 = load64(p);
                var a1 = load64(p + 8);
                var a2 = load64(p + 16);
                var a3 = load64(p + 24);
                if (cb <= 2) {
                    var idx = (a0 + 1) * 27 + (a1 + 1) * 9 + (a2 + 1) * 3 + (a3 + 1);
                    if (cb == 1) { _bw_write(bw, load64(_aac_hcb1_codes + idx * 8), load64(_aac_hcb1_lens + idx * 8)); }
                    else { _bw_write(bw, load64(_aac_hcb2_codes + idx * 8), load64(_aac_hcb2_lens + idx * 8)); }
                } else {
                    var u0 = a0; if (u0 < 0) { u0 = 0 - u0; }
                    var u1 = a1; if (u1 < 0) { u1 = 0 - u1; }
                    var u2 = a2; if (u2 < 0) { u2 = 0 - u2; }
                    var u3 = a3; if (u3 < 0) { u3 = 0 - u3; }
                    var idx2 = u0 * 27 + u1 * 9 + u2 * 3 + u3;
                    if (cb == 3) { _bw_write(bw, load64(_aac_hcb3_codes + idx2 * 8), load64(_aac_hcb3_lens + idx2 * 8)); }
                    else { _bw_write(bw, load64(_aac_hcb4_codes + idx2 * 8), load64(_aac_hcb4_lens + idx2 * 8)); }
                    if (u0 > 0) { _ae_write_sign(bw, a0); }
                    if (u1 > 0) { _ae_write_sign(bw, a1); }
                    if (u2 > 0) { _ae_write_sign(bw, a2); }
                    if (u3 > 0) { _ae_write_sign(bw, a3); }
                }
                p = p + 32;
            }
        } else {
            while (p < pe) {
                var x = load64(p);
                var y = load64(p + 8);
                if (cb <= 6) {
                    var i5 = (x + 4) * 9 + (y + 4);
                    if (cb == 5) { _bw_write(bw, load64(_aac_hcb5_codes + i5 * 8), load64(_aac_hcb5_lens + i5 * 8)); }
                    else { _bw_write(bw, load64(_aac_hcb6_codes + i5 * 8), load64(_aac_hcb6_lens + i5 * 8)); }
                } else {
                    var ux = x; if (ux < 0) { ux = 0 - ux; }
                    var uy = y; if (uy < 0) { uy = 0 - uy; }
                    if (cb <= 8) {
                        var i7 = ux * 8 + uy;
                        if (cb == 7) { _bw_write(bw, load64(_aac_hcb7_codes + i7 * 8), load64(_aac_hcb7_lens + i7 * 8)); }
                        else { _bw_write(bw, load64(_aac_hcb8_codes + i7 * 8), load64(_aac_hcb8_lens + i7 * 8)); }
                    } elif (cb <= 10) {
                        var i9 = ux * 13 + uy;
                        if (cb == 9) { _bw_write(bw, load64(_aac_hcb9_codes + i9 * 8), load64(_aac_hcb9_lens + i9 * 8)); }
                        else { _bw_write(bw, load64(_aac_hcb10_codes + i9 * 8), load64(_aac_hcb10_lens + i9 * 8)); }
                    } else {
                        var cx = ux; if (cx > 16) { cx = 16; }
                        var cy = uy; if (cy > 16) { cy = 16; }
                        _bw_write(bw, load64(_aac_hcb11_codes + (cx * 17 + cy) * 8), load64(_aac_hcb11_lens + (cx * 17 + cy) * 8));
                    }
                    if (ux > 0) { _ae_write_sign(bw, x); }
                    if (uy > 0) { _ae_write_sign(bw, y); }
                    if (cb == 11) {
                        _ae_write_escape(bw, ux);
                        _ae_write_escape(bw, uy);
                    }
                }
                p = p + 16;
            }
        }
        j = j + 1;
    }
    return 0;
}

fn _ae_write_ics_info(bw) {
    _bw_write(bw, 0, 1);             # ics_reserved_bit
    _bw_write(bw, _ae_seq, 2);       # window_sequence
    _bw_write(bw, 0, 1);             # window_shape: sine
    if (_ae_nwin == 8) {
        _bw_write(bw, _ae_maxsfb, 4);
        _bw_write(bw, _ae_sfg, 7);
    } else {
        _bw_write(bw, _ae_maxsfb, 6);
        _bw_write(bw, 0, 1);         # predictor_data_present
    }
    return 0;
}

fn _ae_write_tns(bw, cs) {
    if (load64(cs + _AE_CS_TNS_ON) == 0) {
        _bw_write(bw, 0, 1);
        return 0;
    }
    _bw_write(bw, 1, 1);
    var rec = load64(cs + _AE_CS_TNS);
    var short = 0;
    if (_ae_nwin == 8) { short = 1; }
    _ae_tns_range(_ae_lohi, _ae_lohi + 8);
    var lo = load64(_ae_lohi);
    var nswb = _ae_nswb;
    var w = 0;
    while (w < _ae_nwin) {
        var r = rec + w * 16 * 8;
        var order = load64(r);
        if (order == 0) {
            if (short == 1) { _bw_write(bw, 0, 1); } else { _bw_write(bw, 0, 2); }
        } else {
            if (short == 1) { _bw_write(bw, 1, 1); } else { _bw_write(bw, 1, 2); }
            _bw_write(bw, 1, 1);                         # coef_res: 4 bits
            if (short == 1) {
                _bw_write(bw, nswb - lo, 4);
                _bw_write(bw, order, 3);
            } else {
                _bw_write(bw, nswb - lo, 6);
                _bw_write(bw, order, 5);
            }
            _bw_write(bw, 0, 1);                         # direction: upward
            var comp = load64(r + 8);
            _bw_write(bw, comp, 1);
            var nbits = 4 - comp;
            var mask = (1 << nbits) - 1;
            var j = 1;
            while (j <= order) {
                _bw_write(bw, load64(r + (1 + j) * 8) & mask, nbits);
                j = j + 1;
            }
        }
        w = w + 1;
    }
    return 0;
}

# individual_channel_stream(); ics_info goes with it only outside a common window.
fn _ae_write_ics(bw, c, with_info) {
    var cs = load64(_ae_cs + c * 8);
    var CB = load64(cs + _AE_CS_CB);
    var SCF = load64(cs + _AE_CS_SCF);
    var gg = load64(cs + _AE_CS_GG);
    if (gg < 0) { gg = 100; }
    _bw_write(bw, gg, 8);
    if (with_info == 1) { _ae_write_ics_info(bw); }
    var lenbits = 5;
    var esc = 31;
    if (_ae_nwin == 8) { lenbits = 3; esc = 7; }
    # section_data
    var g = 0;
    while (g < _ae_ngrp) {
        var b = 0;
        while (b < _ae_maxsfb) {
            var cb = load64(CB + (g * 64 + b) * 8);
            var run = 1;
            while (b + run < _ae_maxsfb && load64(CB + (g * 64 + b + run) * 8) == cb) { run = run + 1; }
            _bw_write(bw, cb, 4);
            var left = run;
            while (left >= esc) { _bw_write(bw, esc, lenbits); left = left - esc; }
            _bw_write(bw, left, lenbits);
            b = b + run;
        }
        g = g + 1;
    }
    # scale_factor_data: scalefactors, noise energies and intensity positions,
    # each on its own predictor (values already as transmitted, from the count).
    var prev = gg;
    var noise_prev = gg - 90;
    var noise_first = 1;
    var is_prev = 0;
    g = 0;
    while (g < _ae_ngrp) {
        var b2 = 0;
        while (b2 < _ae_maxsfb) {
            var gi = (g * 64 + b2) * 8;
            var cbs = load64(CB + gi);
            var v = load64(SCF + gi);
            if (cbs >= 1 && cbs <= 11) {
                var d = v - prev + 60;
                _bw_write(bw, load64(_aac_scf_codes + d * 8), load64(_aac_scf_lens + d * 8));
                prev = v;
            } elif (cbs == 13) {
                if (noise_first == 1) {
                    _bw_write(bw, v - noise_prev + 256, 9);
                    noise_first = 0;
                } else {
                    var dn = v - noise_prev + 60;
                    _bw_write(bw, load64(_aac_scf_codes + dn * 8), load64(_aac_scf_lens + dn * 8));
                }
                noise_prev = v;
            } elif (cbs >= 14) {
                var di = v - is_prev + 60;
                _bw_write(bw, load64(_aac_scf_codes + di * 8), load64(_aac_scf_lens + di * 8));
                is_prev = v;
            }
            b2 = b2 + 1;
        }
        g = g + 1;
    }
    _bw_write(bw, 0, 1);         # pulse_data_present
    _ae_write_tns(bw, cs);
    _bw_write(bw, 0, 1);         # gain_control_data_present
    # spectral_data
    g = 0;
    while (g < _ae_ngrp) {
        var b3 = 0;
        while (b3 < _ae_maxsfb) {
            var cb3 = load64(CB + (g * 64 + b3) * 8);
            if (cb3 > 0 && cb3 <= 11) { _ae_write_band(bw, cs, g, b3, cb3); }
            b3 = b3 + 1;
        }
        g = g + 1;
    }
    return 0;
}

fn _ae_bw_bits(bw) {
    return load64(bw + 8) * 8 + load64(bw + 32);
}

# The raw_data_block of the quantised frame into the reused bit writer, with
# fill_element padding so it carries at least min_bits. Returns its bytes.
fn _ae_write_frame(min_bits) {
    var bw = _ae_bw;
    store64(bw + 8, 0);
    store64(bw + 24, 0);
    store64(bw + 32, 0);
    if (_ae_ch == 2) {
        _bw_write(bw, 1, 3);         # ID_CPE
        _bw_write(bw, 0, 4);
        _bw_write(bw, 1, 1);         # common_window
        _ae_write_ics_info(bw);
        _bw_write(bw, _ae_ms_present, 2);
        if (_ae_ms_present == 1) {
            var g = 0;
            while (g < _ae_ngrp) {
                var b = 0;
                while (b < _ae_maxsfb) {
                    _bw_write(bw, load64(_ae_ms + (g * 64 + b) * 8), 1);
                    b = b + 1;
                }
                g = g + 1;
            }
        }
        _ae_write_ics(bw, 0, 0);
        _ae_write_ics(bw, 1, 0);
    } else {
        _bw_write(bw, 0, 3);         # ID_SCE
        _bw_write(bw, 0, 4);
        _ae_write_ics(bw, 0, 1);
    }
    # fill_element: ID_FIL, count (escaped past 14), then EXT_FILL bytes.
    var have = _ae_bw_bits(bw) + 3;
    if (have + 7 < min_bits) {
        var nbytes = (min_bits - have - 7) / 8;
        if (nbytes > 14) { nbytes = (min_bits - have - 15) / 8; }
        if (nbytes > 269) { nbytes = 269; }
        if (nbytes > 0) {
            _bw_write(bw, 6, 3);
            if (nbytes < 15) {
                _bw_write(bw, nbytes, 4);
            } else {
                _bw_write(bw, 15, 4);
                _bw_write(bw, nbytes - 14, 8);
            }
            _bw_write(bw, 0, 4);         # extension_type EXT_FILL
            _bw_write(bw, 0, 4);         # fill_nibble
            var k = 1;
            while (k < nbytes) {
                _bw_write(bw, 0xA5, 8);
                k = k + 1;
            }
        }
    }
    _bw_write(bw, 7, 3);             # ID_END
    var bits = load64(bw + 32);
    if (bits > 0) {
        _bw_push_byte(bw, (load64(bw + 24) << (8 - bits)) & 0xFF);
        store64(bw + 24, 0);
        store64(bw + 32, 0);
    }
    return load64(bw + 8);
}

# ---------------------------------------------------------------- frame and stream

# Encodes frame k (the previous frame's attack lookahead already known) into
# out_buf at pos with its ADTS header. Returns the bytes written.
fn _ae_frame(k, out_buf, pos) {
    _ae_load_frame(k);
    _ae_cur_attack = _ae_next_attack;
    _ae_next_attack = _ae_detect(k + 1);
    _ae_seq = _ae_choose_seq(_ae_cur_attack, _ae_next_attack);
    _ae_prev_seq = _ae_seq;
    if (_ae_seq == _AE_SEQ_SHORT) {
        _ae_nwin = 8;
        _ae_swb = _aac_swb_short;
        _ae_nswb = _AAC_NUM_SWB_SHORT;
        _ae_maxsfb = _ae_cut_s;
        _ae_group(_ae_cur_attack);
    } else {
        _ae_nwin = 1;
        _ae_swb = _aac_swb_offset;
        _ae_nswb = _AAC_NUM_SWB;
        _ae_maxsfb = _ae_cut_l;
        _ae_ngrp = 1;
        store64(_ae_gw0, 0);
        store64(_ae_glen, 1);
        _ae_sfg = 0;
    }
    var c = 0;
    var pe = 0;
    while (c < _ae_ch) {
        _ae_transform(c);
        c = c + 1;
    }
    if (_ae_seq == _AE_SEQ_SHORT) { _ae_group_by_energy(_ae_cur_attack); }
    c = 0;
    while (c < _ae_ch) {
        _ae_psy(c);
        _ae_tns(c);
        c = c + 1;
    }
    _ae_special();
    _ae_ms_decide();
    c = 0;
    while (c < _ae_ch) {
        _ae_prepare(c);
        pe = f64_add(pe, _ae_channel_pe(c));
        c = c + 1;
    }
    # The loudest band coded in this frame (entries past ngrp x maxsfb are
    # left over from earlier frames).
    _ae_rmax = 0;
    c = 0;
    while (c < _ae_ch) {
        var Ec = load64(load64(_ae_cs + c * 8) + _AE_CS_E);
        var Fc = load64(load64(_ae_cs + c * 8) + _AE_CS_TF);
        var gg = 0;
        while (gg < _ae_ngrp) {
            var bb = 0;
            while (bb < _ae_maxsfb) {
                var ev = f64_div(load64(Ec + (gg * 64 + bb) * 8), load64(Fc + (gg * 64 + bb) * 8));
                if (f64_gt(ev, _ae_rmax) == 1) { _ae_rmax = ev; }
                bb = bb + 1;
            }
            gg = gg + 1;
        }
        c = c + 1;
    }
    _ae_rmax = f64_sqrt(f64_sqrt(_ae_rmax));
    var budget = _ae_bit_demand(pe);
    # Spend at least what keeps the reservoir from overflowing.
    var must = _ae_avg + _ae_fill - _ae_res;
    if (must < 0) { must = 0; }
    if (budget < must) { budget = must; }
    if (budget > 6144 * _ae_ch - 64) { budget = 6144 * _ae_ch - 64; }

    var t = _ae_search(budget, must);
    _ae_t_prev = t;
    var nbytes = _ae_write_frame(must);
    var used = nbytes * 8;
    _ae_count_frame(used);
    _ae_fill = _ae_fill + _ae_avg - used;
    if (_ae_fill < 0) { _ae_fill = 0; }
    if (_ae_fill > _ae_res) { _ae_fill = _ae_res; }
    aac_build_adts_header(_ae_rate, _ae_ch, nbytes, out_buf + pos);
    memcpy(out_buf + pos + 7, load64(_ae_bw), nbytes);
    return nbytes + 7;
}

# Bits at threshold scale t (-64..512), each t quantised once a frame.
var _ae_bcache = 0;       # [577] bits
var _ae_bgen = 0;         # [577] the frame (generation) each entry is from
var _ae_gen = 0;
var _ae_last_t = 0;       # the t the quantiser state is at

fn _ae_bits_at(t) {
    var i = (t + 64) * 8;
    if (load64(_ae_bgen + i) == _ae_gen) { return load64(_ae_bcache + i); }
    var b = _ae_frame_bits(t);
    _ae_last_t = t;
    store64(_ae_bcache + i, b);
    store64(_ae_bgen + i, _ae_gen);
    return b;
}

fn _ae_ok(t, lim, kind) {
    var b = _ae_bits_at(t);
    if (kind == 0) { return b <= lim; }
    return b < lim;
}

# The smallest t in lo..hi where bits(t) <= lim (kind 0) or < lim (kind 1), both
# true from some t up (fewer bits as the thresholds rise), and taken as true at
# hi. From the guess: doubling strides toward the boundary, then bisection.
fn _ae_first(lo, hi, guess, lim, kind) {
    var g = guess;
    if (g < lo) { g = lo; }
    if (g > hi) { g = hi; }
    var f = 0;               # largest t known false (valid when hasf)
    var tr = 0;              # smallest t known true (valid when hast)
    var hasf = 0;
    var hast = 0;
    if (g == hi || _ae_ok(g, lim, kind) == 1) { tr = g; hast = 1; } else { f = g; hasf = 1; }
    var stp = 2;
    if (hast == 1) {
        while (hasf == 0 && tr > lo) {
            var d = tr - stp;
            if (d < lo) { d = lo; }
            if (_ae_ok(d, lim, kind) == 1) { tr = d; stp = stp * 2; } else { f = d; hasf = 1; }
        }
        if (hasf == 0) { return tr; }
    } else {
        while (hast == 0) {
            var u = f + stp;
            if (u > hi) { u = hi; }
            if (u == hi || _ae_ok(u, lim, kind) == 1) { tr = u; hast = 1; } else { f = u; stp = stp * 2; }
        }
    }
    while (tr - f > 1) {
        var mid = (f + tr) / 2;
        if (_ae_ok(mid, lim, kind) == 1) { tr = mid; } else { f = mid; }
    }
    return tr;
}

# Threshold scale t (quarter octaves) of this frame: the smallest that fits the
# budget, never below 0 unless the reservoir would otherwise overflow, and then
# the largest that still spends enough. Leaves the quantiser's state at the t it
# returns. Both searches start from the last frame's t, which the next one is
# usually near: from scratch they took 8.8 quantisations of the frame on average.
fn _ae_search(budget, must) {
    if (_ae_bcache == 0) {
        _ae_bcache = alloc(577 * 8);
        _ae_bgen = alloc(577 * 8);
        memset(_ae_bgen, 0, 577 * 8);
    }
    _ae_gen = _ae_gen + 1;
    _ae_last_t = 0 - 999;
    var g0 = _ae_t_prev;
    if (g0 < 0) { g0 = 0; }
    var t = _ae_first(0, 512, g0, budget, 0);
    if (t == 0 && _ae_bits_at(0) < must) {
        var g1 = _ae_t_prev;
        if (g1 > 0) { g1 = 0; }
        # the smallest t spending too little; one below it spends enough
        var r = _ae_first(0 - 64, 0, g1 + 1, must, 1);
        if (r == 0 - 64) {
            t = r;
        } else {
            t = r - 1;
            if (_ae_bits_at(t) > budget) { t = r; }
        }
    }
    if (_ae_last_t != t) { _ae_frame_bits(t); _ae_last_t = t; }
    return t;
}

# The most aac_encode writes for this many samples per channel: every frame at
# the AAC-LC limit of 6144 bits a channel, plus its ADTS header.
fn aac_encode_bound(frames, channels) {
    var n = (frames + 1023) / 1024 + 2;
    return n * (768 * channels + 7 + 64);
}

# ================================================================
# AAC-LC Encoder (ADTS output)
# ================================================================
#
# aac_encode(samples_vec, sample_rate, channels, bitrate, out_buf)
#   samples_vec: vec of f64 samples, interleaved, in [-1, 1] (beyond is clamped,
#                NaN is silence)
#   sample_rate: one of the 13 AAC rates
#   channels:    1 (SCE) or 2 (CPE)
#   bitrate:     bits per second, ADTS headers included
#   out_buf:     at least aac_encode_bound(samples per channel, channels) bytes
# Returns bytes written, or err().

fn aac_encode(samples_vec, sample_rate, channels, bitrate, out_buf) {
    if (_aac_sample_rates == 0) { aac_init(); }
    if (_aac_swb_offset == 0) { _aac_init_swb(); }
    var sr_valid = 0;
    var si = 0;
    while (si < 13) {
        if (load64(_aac_sample_rates + si * 8) == sample_rate) { sr_valid = 1; }
        si = si + 1;
    }
    if (sr_valid == 0) { return err(ERR_INVALID_RATE); }
    if (channels == 0) { return err(ERR_INVALID_CHANNELS); }
    if (channels > 2) { return err(ERR_INVALID_CHANNELS); }
    if (bitrate <= 0) { return err(ERR_ENCODE); }

    _ae_setup(sample_rate, channels, bitrate);
    _ae_data = load64(samples_vec);
    _ae_total = vec_len(samples_vec) / channels;
    var frames = (_ae_total + 1023) / 1024 + 1;
    _ae_next_attack = _ae_detect(0);
    var pos = 0;
    var k = 0;
    while (k < frames) {
        pos = pos + _ae_frame(k, out_buf, pos);
        k = k + 1;
    }
    return pos;
}

# ================================================================
# VBR encoding
# ================================================================
# Quality levels: 1 (lowest, ~64kbps) to 5 (highest, ~320kbps)
# Target bitrate estimated per quality level, but actual frame size
# varies based on spectral complexity.

var AAC_VBR_Q1 = 1;
var AAC_VBR_Q2 = 2;
var AAC_VBR_Q3 = 3;
var AAC_VBR_Q4 = 4;
var AAC_VBR_Q5 = 5;

fn aac_encode_vbr(samples_vec, sample_rate, channels, quality, out_buf) {
    # Map quality to approximate bitrate
    var bitrate = 128000;
    if (quality == 1) { bitrate = 64000; }
    if (quality == 2) { bitrate = 96000; }
    if (quality == 3) { bitrate = 128000; }
    if (quality == 4) { bitrate = 192000; }
    if (quality == 5) { bitrate = 320000; }

    # Scale for stereo
    if (channels >= 2) { bitrate = bitrate * 2; }

    return aac_encode(samples_vec, sample_rate, channels, bitrate, out_buf);
}

# ================================================================
# MSB-first bit reader for AAC bitstream
# ================================================================

# ---- per-frame scratch ----
# alloc() never frees, and a decoded frame allocated its scratch (section and
# scalefactor tables, spectra, IMDCT and TNS buffers, the bit reader) afresh: a
# decode allocated eight times its output, so a file at the one-shot ceiling
# would have needed about 4 GB. aac_decode now brackets each frame with a growable
# arena that is reset between frames; outside a decode (the encoder, unit tests)
# _aac_tmp is plain alloc(). Tables built lazily on first use stay on the heap.
var _aac_arena = 0;
var _aac_in_frame = 0;

fn _aac_frame_begin() {
    if (_aac_arena == 0) { _aac_arena = arena_new_growable(262144); }
    if (_aac_arena != 0) { arena_reset(_aac_arena); _aac_in_frame = 1; }
    return 0;
}

fn _aac_frame_end() { _aac_in_frame = 0; return 0; }

fn _aac_tmp(size) {
    if (_aac_in_frame == 1) { return arena_alloc(_aac_arena, size); }
    return alloc(size);
}

fn _br_new(data, len) {
    var br = _aac_tmp(24);
    store64(br, data);
    store64(br + 8, len * 8);
    store64(br + 16, 0);
    return br;
}

fn _br_read(br, n) {
    var brd = load64(br);
    var total = load64(br + 8);
    var pos = load64(br + 16);
    if (pos + n > total) { return err(ERR_END_OF_STREAM); }
    var val = 0;
    var i = 0;
    while (i < n) {
        var byte_idx = (pos + i) / 8;
        var bit_idx = 7 - ((pos + i) % 8);
        val = (val << 1) | ((load8(brd + byte_idx) >> bit_idx) & 1);
        i = i + 1;
    }
    store64(br + 16, pos + n);
    return val;
}

fn _br_bits_left(br) {
    return load64(br + 8) - load64(br + 16);
}

# Advance to the next byte boundary (data_stream_element alignment).
fn _br_byte_align(br) {
    var pos = load64(br + 16);
    var rem = pos % 8;
    if (rem != 0) {
        pos = pos + (8 - rem);
        if (pos > load64(br + 8)) { pos = load64(br + 8); }
        store64(br + 16, pos);
    }
    return 0;
}

# ================================================================
# AAC Huffman codebook tables + decoder
# ================================================================

# Scale factor codebook: 121 entries (index 0..120, center at 60)
# Each entry: (code_length, code_value) packed as i64
# Stored in two arrays: _aac_scf_lens[121], _aac_scf_codes[121]
var _aac_scf_lens = 0;
var _aac_scf_codes = 0;

fn _aac_init_scf_codebook() {
    _aac_scf_lens = alloc(121 * 8);
    _aac_scf_codes = alloc(121 * 8);

    # Lengths (bits per codeword)
    var lens = _aac_scf_lens;
    store64(lens+ 0*8,18); store64(lens+ 1*8,18); store64(lens+ 2*8,18); store64(lens+ 3*8,18);
    store64(lens+ 4*8,19); store64(lens+ 5*8,19); store64(lens+ 6*8,19); store64(lens+ 7*8,19);
    store64(lens+ 8*8,19); store64(lens+ 9*8,19); store64(lens+10*8,19); store64(lens+11*8,19);
    store64(lens+12*8,19); store64(lens+13*8,19); store64(lens+14*8,19); store64(lens+15*8,19);
    store64(lens+16*8,19); store64(lens+17*8,19); store64(lens+18*8,19); store64(lens+19*8,18);
    store64(lens+20*8,19); store64(lens+21*8,18); store64(lens+22*8,17); store64(lens+23*8,17);
    store64(lens+24*8,16); store64(lens+25*8,17); store64(lens+26*8,16); store64(lens+27*8,16);
    store64(lens+28*8,16); store64(lens+29*8,16); store64(lens+30*8,15); store64(lens+31*8,15);
    store64(lens+32*8,14); store64(lens+33*8,14); store64(lens+34*8,14); store64(lens+35*8,14);
    store64(lens+36*8,14); store64(lens+37*8,14); store64(lens+38*8,13); store64(lens+39*8,13);
    store64(lens+40*8,12); store64(lens+41*8,12); store64(lens+42*8,12); store64(lens+43*8,11);
    store64(lens+44*8,12); store64(lens+45*8,11); store64(lens+46*8,10); store64(lens+47*8,10);
    store64(lens+48*8,10); store64(lens+49*8, 9); store64(lens+50*8, 9); store64(lens+51*8, 8);
    store64(lens+52*8, 8); store64(lens+53*8, 8); store64(lens+54*8, 7); store64(lens+55*8, 6);
    store64(lens+56*8, 6); store64(lens+57*8, 5); store64(lens+58*8, 4); store64(lens+59*8, 3);
    store64(lens+60*8, 1); store64(lens+61*8, 4); store64(lens+62*8, 4); store64(lens+63*8, 5);
    store64(lens+64*8, 6); store64(lens+65*8, 6); store64(lens+66*8, 7); store64(lens+67*8, 7);
    store64(lens+68*8, 8); store64(lens+69*8, 8); store64(lens+70*8, 9); store64(lens+71*8, 9);
    store64(lens+72*8,10); store64(lens+73*8,10); store64(lens+74*8,10); store64(lens+75*8,11);
    store64(lens+76*8,11); store64(lens+77*8,11); store64(lens+78*8,11); store64(lens+79*8,12);
    store64(lens+80*8,12); store64(lens+81*8,13); store64(lens+82*8,13); store64(lens+83*8,13);
    store64(lens+84*8,14); store64(lens+85*8,14); store64(lens+86*8,16); store64(lens+87*8,15);
    store64(lens+88*8,16); store64(lens+89*8,15); store64(lens+90*8,18); store64(lens+91*8,19);
    store64(lens+92*8,19); store64(lens+93*8,19); store64(lens+94*8,19); store64(lens+95*8,19);
    store64(lens+96*8,19); store64(lens+97*8,19); store64(lens+98*8,19); store64(lens+99*8,19);
    store64(lens+100*8,19); store64(lens+101*8,19); store64(lens+102*8,19); store64(lens+103*8,19);
    store64(lens+104*8,19); store64(lens+105*8,19); store64(lens+106*8,19); store64(lens+107*8,19);
    store64(lens+108*8,19); store64(lens+109*8,19); store64(lens+110*8,19); store64(lens+111*8,19);
    store64(lens+112*8,19); store64(lens+113*8,19); store64(lens+114*8,19); store64(lens+115*8,19);
    store64(lens+116*8,19); store64(lens+117*8,19); store64(lens+118*8,19); store64(lens+119*8,19);
    store64(lens+120*8,19);

    # Code values
    var codes = _aac_scf_codes;
    store64(codes+ 0*8,0x3FFE8); store64(codes+ 1*8,0x3FFE6); store64(codes+ 2*8,0x3FFE7);
    store64(codes+ 3*8,0x3FFE5); store64(codes+ 4*8,0x7FFF5); store64(codes+ 5*8,0x7FFF1);
    store64(codes+ 6*8,0x7FFED); store64(codes+ 7*8,0x7FFF6); store64(codes+ 8*8,0x7FFEE);
    store64(codes+ 9*8,0x7FFEF); store64(codes+10*8,0x7FFF0); store64(codes+11*8,0x7FFFC);
    store64(codes+12*8,0x7FFFD); store64(codes+13*8,0x7FFFF); store64(codes+14*8,0x7FFFE);
    store64(codes+15*8,0x7FFF7); store64(codes+16*8,0x7FFF8); store64(codes+17*8,0x7FFFB);
    store64(codes+18*8,0x7FFF9); store64(codes+19*8,0x3FFE4); store64(codes+20*8,0x7FFFA);
    store64(codes+21*8,0x3FFE3); store64(codes+22*8,0x1FFEF); store64(codes+23*8,0x1FFF0);
    store64(codes+24*8,0x0FFF5); store64(codes+25*8,0x1FFEE); store64(codes+26*8,0x0FFF2);
    store64(codes+27*8,0x0FFF3); store64(codes+28*8,0x0FFF4); store64(codes+29*8,0x0FFF1);
    store64(codes+30*8,0x07FF6); store64(codes+31*8,0x07FF7); store64(codes+32*8,0x03FF9);
    store64(codes+33*8,0x03FF5); store64(codes+34*8,0x03FF7); store64(codes+35*8,0x03FF3);
    store64(codes+36*8,0x03FF6); store64(codes+37*8,0x03FF2); store64(codes+38*8,0x01FF7);
    store64(codes+39*8,0x01FF5); store64(codes+40*8,0x00FF9); store64(codes+41*8,0x00FF7);
    store64(codes+42*8,0x00FF6); store64(codes+43*8,0x007F9); store64(codes+44*8,0x00FF4);
    store64(codes+45*8,0x007F8); store64(codes+46*8,0x003F9); store64(codes+47*8,0x003F7);
    store64(codes+48*8,0x003F5); store64(codes+49*8,0x001F8); store64(codes+50*8,0x001F7);
    store64(codes+51*8,0x000FA); store64(codes+52*8,0x000F8); store64(codes+53*8,0x000F6);
    store64(codes+54*8,0x00079); store64(codes+55*8,0x0003A); store64(codes+56*8,0x00038);
    store64(codes+57*8,0x0001A); store64(codes+58*8,0x0000B); store64(codes+59*8,0x00004);
    store64(codes+60*8,0x00000); store64(codes+61*8,0x0000A); store64(codes+62*8,0x0000C);
    store64(codes+63*8,0x0001B); store64(codes+64*8,0x00039); store64(codes+65*8,0x0003B);
    store64(codes+66*8,0x00078); store64(codes+67*8,0x0007A); store64(codes+68*8,0x000F7);
    store64(codes+69*8,0x000F9); store64(codes+70*8,0x001F6); store64(codes+71*8,0x001F9);
    store64(codes+72*8,0x003F4); store64(codes+73*8,0x003F6); store64(codes+74*8,0x003F8);
    store64(codes+75*8,0x007F5); store64(codes+76*8,0x007F4); store64(codes+77*8,0x007F6);
    store64(codes+78*8,0x007F7); store64(codes+79*8,0x00FF5); store64(codes+80*8,0x00FF8);
    store64(codes+81*8,0x01FF4); store64(codes+82*8,0x01FF6); store64(codes+83*8,0x01FF8);
    store64(codes+84*8,0x03FF8); store64(codes+85*8,0x03FF4); store64(codes+86*8,0x0FFF0);
    store64(codes+87*8,0x07FF4); store64(codes+88*8,0x0FFF6); store64(codes+89*8,0x07FF5);
    store64(codes+90*8,0x3FFE2); store64(codes+91*8,0x7FFD9); store64(codes+92*8,0x7FFDA);
    store64(codes+93*8,0x7FFDB); store64(codes+94*8,0x7FFDC); store64(codes+95*8,0x7FFDD);
    store64(codes+96*8,0x7FFDE); store64(codes+97*8,0x7FFD8); store64(codes+98*8,0x7FFD2);
    store64(codes+99*8,0x7FFD3); store64(codes+100*8,0x7FFD4); store64(codes+101*8,0x7FFD5);
    store64(codes+102*8,0x7FFD6); store64(codes+103*8,0x7FFF2); store64(codes+104*8,0x7FFDF);
    store64(codes+105*8,0x7FFE7); store64(codes+106*8,0x7FFE8); store64(codes+107*8,0x7FFE9);
    store64(codes+108*8,0x7FFEA); store64(codes+109*8,0x7FFEB); store64(codes+110*8,0x7FFE6);
    store64(codes+111*8,0x7FFE0); store64(codes+112*8,0x7FFE1); store64(codes+113*8,0x7FFE2);
    store64(codes+114*8,0x7FFE3); store64(codes+115*8,0x7FFE4); store64(codes+116*8,0x7FFE5);
    store64(codes+117*8,0x7FFD7); store64(codes+118*8,0x7FFEC); store64(codes+119*8,0x7FFF4);
    store64(codes+120*8,0x7FFF3);
    return 0;
}

# Decode one Huffman symbol from bitstream using codebook tables.
# lens_tbl: pointer to array of code lengths (i64 each)
# codes_tbl: pointer to array of code values (i64 each)
# num_entries: number of entries in the codebook
# br: bitreader
# Returns: codebook index (0..num_entries-1), or err.
#
# Optimized: reads bits incrementally but only compares against entries
# of exactly the current bit length (early exit per length level).
fn _aac_huff_decode(br, lens_tbl, codes_tbl, num_entries) {
    var acc = 0;
    var bits_read = 0;

    while (bits_read < 20) {
        var bit = _br_read(br, 1);
        if (is_err(bit) == 1) { return bit; }
        acc = (acc << 1) | bit;
        bits_read = bits_read + 1;

        # Only check entries whose length matches current bits_read
        var i = 0;
        while (i < num_entries) {
            if (load64(lens_tbl + i * 8) == bits_read) {
                if (load64(codes_tbl + i * 8) == acc) {
                    return i;
                }
            }
            i = i + 1;
        }
    }
    return err(ERR_DECODE);
}

# ================================================================
# Fast Huffman decode via sorted codebook
# ================================================================
# Builds a sorted codebook (by length then code) for faster decode.
# _aac_huff_build_sorted: creates a sorted index table.
# _aac_huff_decode_fast: decodes using sorted table with length-group skipping.

# Build a sorted codebook for fast decode.
# Returns three parallel arrays: sorted_lens, sorted_codes, sorted_syms
# packed as a single allocation: [lens_buf | codes_buf | syms_buf]
# Sorted by length ascending so decode can skip shorter entries.
# Returns pointer to header struct: +0=lens, +8=codes, +16=syms
fn _aac_huff_build_sorted(lens_tbl, codes_tbl, num_entries) {
    var s_lens  = alloc(num_entries * 8);
    var s_codes = alloc(num_entries * 8);
    var s_syms  = alloc(num_entries * 8);

    # Copy into sortable arrays
    var i = 0;
    while (i < num_entries) {
        store64(s_lens + i * 8, load64(lens_tbl + i * 8));
        store64(s_codes + i * 8, load64(codes_tbl + i * 8));
        store64(s_syms + i * 8, i);
        i = i + 1;
    }

    # Insertion sort by (length, code) — swap all three arrays in parallel
    i = 1;
    while (i < num_entries) {
        var kl = load64(s_lens + i * 8);
        var kc = load64(s_codes + i * 8);
        var ks = load64(s_syms + i * 8);
        var j = i - 1;
        while (j >= 0) {
            var jl = load64(s_lens + j * 8);
            var should_shift = 0;
            if (jl > kl) { should_shift = 1; }
            if (jl == kl) {
                if (load64(s_codes + j * 8) > kc) { should_shift = 1; }
            }
            if (should_shift == 1) {
                store64(s_lens + (j+1)*8, load64(s_lens + j*8));
                store64(s_codes + (j+1)*8, load64(s_codes + j*8));
                store64(s_syms + (j+1)*8, load64(s_syms + j*8));
                j = j - 1;
            } else {
                # Insert here — exit loop by forcing j below 0
                # but first save correct position
                store64(s_lens + (j+1)*8, kl);
                store64(s_codes + (j+1)*8, kc);
                store64(s_syms + (j+1)*8, ks);
                j = 0 - 2;  # sentinel: already inserted
            }
        }
        # If j == -1, we shifted everything — insert at position 0
        if (j == 0 - 1) {
            store64(s_lens, kl);
            store64(s_codes, kc);
            store64(s_syms, ks);
        }
        i = i + 1;
    }

    # Return header struct
    var hdr = alloc(24);
    store64(hdr, s_lens);
    store64(hdr + 8, s_codes);
    store64(hdr + 16, s_syms);
    return hdr;
}

# Decode using sorted table — skips entries of shorter lengths.
fn _aac_huff_decode_fast(br, sorted_hdr, num_entries) {
    var s_lens  = load64(sorted_hdr);
    var s_codes = load64(sorted_hdr + 8);
    var s_syms  = load64(sorted_hdr + 16);

    var acc = 0;
    var bits_read = 0;
    var scan_from = 0;

    while (bits_read < 20) {
        var bit = _br_read(br, 1);
        if (is_err(bit) == 1) { return bit; }
        acc = (acc << 1) | bit;
        bits_read = bits_read + 1;

        # Advance scan_from past entries shorter than bits_read
        var advancing = 1;
        while (advancing == 1) {
            if (scan_from >= num_entries) { advancing = 0; }
            else {
                if (load64(s_lens + scan_from * 8) < bits_read) {
                    scan_from = scan_from + 1;
                } else { advancing = 0; }
            }
        }

        # Check entries at exactly this length
        var i = scan_from;
        var checking = 1;
        while (checking == 1) {
            if (i >= num_entries) { checking = 0; }
            else {
                var elen = load64(s_lens + i * 8);
                if (elen > bits_read) {
                    checking = 0;
                } else {
                    if (elen == bits_read) {
                        if (load64(s_codes + i * 8) == acc) {
                            return load64(s_syms + i * 8);
                        }
                    }
                    i = i + 1;
                }
            }
        }
    }
    return err(ERR_DECODE);
}

# ================================================================
# 2-level Huffman lookup table
# ================================================================
# Level 1: 256-entry table indexed by first 8 bits.
#   Entry = (symbol << 8) | length for codes <= 8 bits.
#   Entry = 0 for codes > 8 bits (fall through to sorted scan).
# Level 2: sorted scan (existing _aac_huff_decode_fast) for long codes.
#
# _aac_huff_build_lut: builds the 256-entry level-1 table.
# _aac_huff_decode_lut: tries level-1 first, falls back to sorted scan.

fn _aac_huff_build_lut(lens_tbl, codes_tbl, num_entries) {
    var lut = alloc(256 * 8);
    memset(lut, 0, 256 * 8);

    var i = 0;
    while (i < num_entries) {
        var clen = load64(lens_tbl + i * 8);
        var code = load64(codes_tbl + i * 8);
        if (clen > 0) {
            if (clen <= 8) {
                # This code fits in 8 bits — fill all entries that match
                # Left-align code to 8 bits, then fill 2^(8-clen) entries
                var prefix = code << (8 - clen);
                var fill = 1 << (8 - clen);
                var j = 0;
                while (j < fill) {
                    var idx = prefix | j;
                    if (idx < 256) {
                        # Pack: (symbol << 8) | length
                        store64(lut + idx * 8, (i << 8) | clen);
                    }
                    j = j + 1;
                }
            }
        }
        i = i + 1;
    }
    return lut;
}

fn _aac_huff_decode_lut(br, lut, sorted_hdr, num_entries) {
    # Peek 8 bits without consuming
    var saved_bpos = load64(br + 8);
    var saved_bbit = load64(br + 16);

    var peek = _br_read(br, 8);
    if (is_err(peek) == 1) {
        # Not enough bits — restore and fall back to sorted scan
        store64(br + 8, saved_bpos);
        store64(br + 16, saved_bbit);
        return _aac_huff_decode_fast(br, sorted_hdr, num_entries);
    }

    var entry = load64(lut + (peek & 0xFF) * 8);
    if (entry != 0) {
        var clen = entry & 0xFF;
        var sym = (entry >> 8) & 0xFFFF;
        # Put back unused bits: we read 8 but only used clen
        var putback = 8 - clen;
        # Rewind bitreader by putback bits
        var bpos = load64(br + 8);
        var bbit = load64(br + 16);
        bbit = bbit - putback;
        while (bbit < 0) { bbit = bbit + 8; bpos = bpos - 1; }
        store64(br + 8, bpos);
        store64(br + 16, bbit);
        return sym;
    }

    # Level-1 miss — restore bitreader and use sorted scan
    store64(br + 8, saved_bpos);
    store64(br + 16, saved_bbit);
    return _aac_huff_decode_fast(br, sorted_hdr, num_entries);
}

# Cached tables
var _aac_scf_sorted = 0;
var _aac_scf_lut = 0;
var _aac_hcb5_sorted = 0;
var _aac_hcb5_lut = 0;
var _aac_hcb6_sorted = 0;
var _aac_hcb6_lut = 0;
var _aac_hcb7_sorted = 0;
var _aac_hcb7_lut = 0;
var _aac_hcb8_sorted = 0;
var _aac_hcb8_lut = 0;
var _aac_hcb9_sorted = 0;
var _aac_hcb9_lut = 0;
var _aac_hcb10_sorted = 0;
var _aac_hcb10_lut = 0;
var _aac_hcb11_sorted = 0;
var _aac_hcb11_lut = 0;

# Decode a scale factor value using the Huffman codebook.
# Returns the codebook index (0..120), which maps to diff = index - 60.
fn _aac_decode_scf(br) {
    if (_aac_scf_lens == 0) { _aac_init_scf_codebook(); }
    if (_aac_scf_sorted == 0) {
        _aac_scf_sorted = _aac_huff_build_sorted(_aac_scf_lens, _aac_scf_codes, 121);
        _aac_scf_lut = _aac_huff_build_lut(_aac_scf_lens, _aac_scf_codes, 121);
    }
    return _aac_huff_decode_lut(br, _aac_scf_lut, _aac_scf_sorted, 121);
}

