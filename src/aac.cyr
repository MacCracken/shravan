}

# TNS analysis (FIR) and synthesis (IIR) built from the same LPC are exact
# inverses — the core roundtrip guarantee. Test both filter directions.
fn test_aac_tns_filter_inverse() {
    test_group("aac: TNS filter analysis/synthesis inverse");
    var order = 3;
    var k = alloc((TNS_MAX_ORDER + 1) * 8);
    memset(k, 0, (TNS_MAX_ORDER + 1) * 8);
    store64(k + 8, f64_div(f64_from(1), f64_from(2)));                    # 0.5
    store64(k + 16, f64_neg(f64_div(f64_from(3), f64_from(10))));         # -0.3
    store64(k + 24, f64_div(f64_from(1), f64_from(5)));                   # 0.2
    var a = alloc((TNS_MAX_ORDER + 1) * 8);
    _tns_parcor_to_lpc(k, order, a);
    var n = 40;
    var start = 100;
    var spec = alloc((start + n) * 8);
    var orig = alloc((start + n) * 8);
    memset(spec, 0, (start + n) * 8);
    memset(orig, 0, (start + n) * 8);
    var i = 0;
    while (i < n) {
        var v = f64_sin(f64_div(f64_from((i + 1) * 7), f64_from(13)));
        store64(spec + (start + i) * 8, v);
        store64(orig + (start + i) * 8, v);
        i = i + 1;
    }
    var eps = f64_div(F64_ONE, f64_from(1000000));
    _tns_filter(spec, start, start + n, a, order, 0, 0);
    _tns_filter(spec, start, start + n, a, order, 0, 1);
    var ok = 1;
    i = 0;
    while (i < n) {
        if (f64_gt(f64_abs(f64_sub(load64(spec + (start + i) * 8), load64(orig + (start + i) * 8))), eps) == 1) { ok = 0; }
        i = i + 1;
    }
    assert(ok == 1, "TNS forward analysis+synthesis == identity");
    i = 0;
    while (i < n) { store64(spec + (start + i) * 8, load64(orig + (start + i) * 8)); i = i + 1; }
    _tns_filter(spec, start, start + n, a, order, 1, 0);
    _tns_filter(spec, start, start + n, a, order, 1, 1);
    ok = 1;
    i = 0;
    while (i < n) {
        if (f64_gt(f64_abs(f64_sub(load64(spec + (start + i) * 8), load64(orig + (start + i) * 8))), eps) == 1) { ok = 0; }
        i = i + 1;
    }
    assert(ok == 1, "TNS backward analysis+synthesis == identity");
    return 0;
}

# Quantized reflection coefficients still yield exactly-inverting filters (both
# sides use the dequantized value), and indices stay in the signed 4-bit range.
fn test_aac_tns_coef_quant() {
    test_group("aac: TNS coefficient quantization roundtrip");
    var resbits = 4;
    var order = 4;
    var kq = alloc((TNS_MAX_ORDER + 1) * 8);
    memset(kq, 0, (TNS_MAX_ORDER + 1) * 8);
    var vals = alloc(4 * 8);
    store64(vals + 0, f64_div(f64_from(6), f64_from(10)));
    store64(vals + 8, f64_neg(f64_div(f64_from(4), f64_from(10))));
    store64(vals + 16, f64_div(f64_from(1), f64_from(10)));
    store64(vals + 24, f64_neg(f64_div(f64_from(7), f64_from(10))));
    var i = 0;
    while (i < order) {
        var idx = _tns_quant_coef(load64(vals + i * 8), resbits);
        assert(idx <= 7, "coef idx <= 7");
        assert(idx >= 0 - 8, "coef idx >= -8");
        store64(kq + (i + 1) * 8, _tns_dequant_coef(idx, resbits));
        i = i + 1;
    }
    var a = alloc((TNS_MAX_ORDER + 1) * 8);
    _tns_parcor_to_lpc(kq, order, a);
    var n = 30;
    var start = 60;
    var spec = alloc((start + n) * 8);
    var orig = alloc((start + n) * 8);
    memset(spec, 0, (start + n) * 8);
    memset(orig, 0, (start + n) * 8);
    i = 0;
    while (i < n) {
        var v = f64_sin(f64_div(f64_from((i + 3) * 5), f64_from(11)));
        store64(spec + (start + i) * 8, v);
        store64(orig + (start + i) * 8, v);
        i = i + 1;
    }
    _tns_filter(spec, start, start + n, a, order, 0, 0);
    _tns_filter(spec, start, start + n, a, order, 0, 1);
    var ok = 1;
    var eps = f64_div(F64_ONE, f64_from(1000000));
    i = 0;
    while (i < n) {
        if (f64_gt(f64_abs(f64_sub(load64(spec + (start + i) * 8), load64(orig + (start + i) * 8))), eps) == 1) { ok = 0; }
        i = i + 1;
    }
    assert(ok == 1, "quantized-coef TNS filter inverts exactly");
    return 0;
}

# Full mono pipeline: encode with TNS in the stream, decode via the real audio
# path. A misaligned tns_data() would desync the frame and yield zero samples.
fn test_aac_tns_frame_roundtrip() {
    test_group("aac: TNS mono frame encode/decode");
    if (_aac_sample_rates == 0) { aac_init(); }
    if (_aac_swb_offset == 0) { _aac_init_swb(); }
    var samples = vec_new();
    var i = 0;
    while (i < 1024) {
        var v = f64_sin(f64_div(f64_from(i * 6), f64_from(50)));
        if (i == 200) { v = f64_add(v, f64_from(1)); }   # transient
        vec_push(samples, v);
        i = i + 1;
    }
    var out = alloc(131072);
    var nbytes = aac_encode(samples, 44100, 1, 128000, out);
    assert(is_err(nbytes) == 0, "TNS-frame encode ok");
    assert(nbytes > 7, "produced bytes");
    var dec = aac_decode(out, nbytes);
    assert(is_err(dec) == 0, "TNS-frame decode ok");
    var decoded = decode_result_samples(dec);
    # 1024 samples are two frames since 2.10.1: the priming frame and the one
    # that flushes the overlap. A desynchronised tns_data() would yield none.
    assert(vec_len(decoded) == 2048, "two mono frames decoded (tns_data in sync)");
    return 0;
}

# ---------------------------------------------------------------- encoder tests

fn _ae_t_signal(n, ch, rate, kind) {
    var v = vec_new();
    var seed = 0x9E3779B97F4A7C15;
    var lpa = f64_exp(f64_neg(f64_div(f64_mul(f64_mul(F64_TWO, F64_PI), f64_from(4000)), f64_from(rate))));
    var lp1 = 0;
    var lp2 = 0;
    var i = 0;
    while (i < n) {
        var c = 0;
        while (c < ch) {
            seed = seed * 6364136223846793005 + 1442695040888963407;
            var rnd = f64_div(f64_from(((seed >> 11) & 0xFFFF) - 32768), f64_from(32768));
            var t = f64_div(f64_from(i), f64_from(rate));
            var x = 0;
            if (kind == 0) {        # two tones and a little noise
                x = f64_add(f64_mul(f64_div(f64_from(3), f64_from(10)), f64_sin(f64_mul(f64_mul(F64_TWO, F64_PI), f64_mul(f64_from(440 * (c + 1)), t)))),
                  f64_add(f64_mul(f64_div(F64_ONE, f64_from(10)), f64_sin(f64_mul(f64_mul(F64_TWO, F64_PI), f64_mul(f64_from(3000), t)))),
                    f64_mul(f64_div(F64_ONE, f64_from(100)), rnd)));
            }
            if (kind == 1) {        # clicks every quarter second over quiet noise (mono)
                x = f64_mul(f64_div(F64_ONE, f64_from(500)), rnd);
                var ph = i % (rate / 4);
                if (ph < 480) {
                    x = f64_add(x, f64_mul(f64_div(f64_from(6), f64_from(10)), f64_mul(rnd, f64_exp(f64_neg(f64_div(f64_from(ph), f64_from(48)))))));
                }
                # Two one-pole lowpasses at 4 kHz: white clicks put an eighth of
                # their energy past the coded bandwidth (20 kHz at 128 kbit/s),
                # which would score as error that no window choice can remove.
                lp1 = f64_add(f64_mul(lpa, lp1), f64_mul(f64_sub(F64_ONE, lpa), x));
                lp2 = f64_add(f64_mul(lpa, lp2), f64_mul(f64_sub(F64_ONE, lpa), lp1));
                x = f64_mul(f64_from(2), lp2);
            }
            if (kind == 2) {        # a steady tone
                x = f64_mul(F64_HALF, f64_sin(f64_mul(f64_mul(F64_TWO, F64_PI), f64_mul(f64_from(1000), t))));
            }
            if (kind == 3) {        # white noise
                x = f64_mul(f64_div(f64_from(3), f64_from(10)), rnd);
            }
            if (kind == 5) {        # full-band clicks every quarter second over quiet noise
                x = f64_mul(f64_div(F64_ONE, f64_from(500)), rnd);
                var ph5 = i % (rate / 4);
                if (ph5 < 480) {
                    x = f64_add(x, f64_mul(f64_div(f64_from(6), f64_from(10)), f64_mul(rnd, f64_exp(f64_neg(f64_div(f64_from(ph5), f64_from(48)))))));
                }
            }
            if (kind == 4) {        # tones across the high band, and one low
                var w2 = f64_mul(f64_mul(F64_TWO, F64_PI), t);
                x = f64_mul(f64_div(F64_ONE, f64_from(10)), f64_add(f64_add(f64_sin(f64_mul(w2, f64_from(300))), f64_sin(f64_mul(w2, f64_from(7000)))),
                    f64_add(f64_sin(f64_mul(w2, f64_from(9500))), f64_sin(f64_mul(w2, f64_from(12000))))));
            }
            vec_push(v, x);
            c = c + 1;
        }
        i = i + 1;
    }
    return v;
}

# Every ADTS frame within AAC-LC's 6144 bits a channel; returns the frame count.
fn _ae_t_frames_ok(buf, len, ch) {
    var pos = 0;
    var n = 0;
    while (pos + 7 <= len) {
        if (load8(buf + pos) != 0xFF) { return 0 - 1; }
        var fl = ((load8(buf + pos + 3) & 3) << 11) | (load8(buf + pos + 4) << 3) | (load8(buf + pos + 5) >> 5);
        if (fl - 7 > 768 * ch) { return 0 - 1; }
        pos = pos + fl;
        n = n + 1;
    }
    if (pos != len) { return 0 - 1; }
    return n;
}

# The bit rate asked for is the bit rate written (ADTS headers included), within
# what the bit reservoir holds back; every frame fits AAC-LC's limit.
fn test_aac_encoder_rate() {
    test_group("aac encoder: bit rate and frame limits");
    var n = 44100 * 3;
    var v = _ae_t_signal(n, 2, 44100, 0);
    var buf = alloc(aac_encode_bound(n, 2));
    var k = 0;
    while (k < 2) {
        var br = 64000;
        if (k == 1) { br = 128000; }
        var len = aac_encode(v, 44100, 2, br, buf);
        assert(res_ok(len) == 1, "encode");
        # the bit rate over the coded frames (priming and flush included), plus
        # the one reservoir the stream starts with
        var frames = (n + 1023) / 1024 + 1;
        var most = (frames * 1024 * br / 44100 + 6144 * 2) / 8;
        assert(len <= most, "no more than the bit rate and one reservoir");
        assert(len * 100 >= br * 3 / 8 * 90, "within 10% of the bit rate");
        assert(_ae_t_frames_ok(buf, len, 2) == (n + 1023) / 1024 + 1, "frames within 6144 bits a channel, priming and flush");
        k = k + 1;
    }
    return 0;
}

# Attacks switch to short windows through LONG_START and LONG_STOP; a steady tone
# never does. The decode follows the input either way.
fn test_aac_encoder_windows() {
    test_group("aac encoder: block switching");
    var n = 48000 * 2;
    var clicks = _ae_t_signal(n, 1, 48000, 1);
    var buf = alloc(aac_encode_bound(n, 1));
    var len = aac_encode(clicks, 48000, 1, 128000, buf);
    assert(res_ok(len) == 1, "clicks encode");
    assert(load64(_ae_stat + 3 * 8) > 0, "clicks use EIGHT_SHORT");
    assert(load64(_ae_stat + 2 * 8) > 0, "clicks use LONG_START");
    assert(load64(_ae_stat + 4 * 8) > 0, "clicks use LONG_STOP");
    var r = aac_decode(buf, len);
    assert(res_ok(r) == 1, "clicks decode");
    var d = decode_result_samples(r);
    var xs = alloc(n * 8);
    var ds = alloc(vec_len(d) * 8);
    var i = 0;
    while (i < n) { store64(xs + i * 8, vec_get(clicks, i)); i = i + 1; }
    i = 0;
    while (i < vec_len(d)) { store64(ds + i * 8, vec_get(d, i)); i = i + 1; }
    var cc = _ae_t_corr(ds, vec_len(d), xs, n);
    syscall(1, 1, "  clicks corr*1000 = ", 21); fmt_int(cc); syscall(1, 1, "\n", 1);
    # ffmpeg 0.9996 (at 136 kbit/s); long windows only 0.987
    assert(cc > 993, "clicks decode to the input (corr > 0.993)");
    # Full-band clicks at 32 kHz, which 96 kbit/s codes to the top, so TNS
    # filters most of each click. Until 2.10.1 the quantiser held the filtered
    # bands to the unfiltered thresholds, and the decoder's synthesis filter
    # raised that noise by the prediction gain: 0.987 (ffmpeg 0.9996, no TNS 0.998).
    var nw = 32000 * 2;
    var wclicks = _ae_t_signal(nw, 1, 32000, 5);
    len = aac_encode(wclicks, 32000, 1, 96000, buf);
    assert(res_ok(len) == 1, "full-band clicks encode");
    assert(load64(_ae_stat + 5 * 8) > 0, "full-band clicks use TNS");
    r = aac_decode(buf, len);
    assert(res_ok(r) == 1, "full-band clicks decode");
    d = decode_result_samples(r);
    i = 0;
    while (i < nw) { store64(xs + i * 8, vec_get(wclicks, i)); i = i + 1; }
    ds = alloc(vec_len(d) * 8);
    i = 0;
    while (i < vec_len(d)) { store64(ds + i * 8, vec_get(d, i)); i = i + 1; }
    cc = _ae_t_corr(ds, vec_len(d), xs, nw);
    syscall(1, 1, "  full-band clicks corr*1000 = ", 31); fmt_int(cc); syscall(1, 1, "\n", 1);
    assert(cc > 995, "full-band clicks decode to the input (corr > 0.995)");
    var tone = _ae_t_signal(n, 1, 48000, 2);
    len = aac_encode(tone, 48000, 1, 128000, buf);
    assert(res_ok(len) == 1, "tone encode");
    assert_eq(load64(_ae_stat + 3 * 8), 0, "a steady tone stays long");
    return 0;
}

# Correlation x1000 of a decode (delayed by the 1024 samples of priming) with
# the input.
fn _ae_t_corr(d, dn, x, xn) {
    var sxy = 0; var sxx = 0; var syy = 0;
    var i = 2048;
    while (i + 1024 < xn && i + 1024 < dn) {
        var a = load64(x + i * 8);
        var b = load64(d + (i + 1024) * 8);
        sxy = f64_add(sxy, f64_mul(a, b));
        sxx = f64_add(sxx, f64_mul(a, a));
        syy = f64_add(syy, f64_mul(b, b));
        i = i + 1;
    }
    if (f64_gt(f64_mul(sxx, syy), 0) == 0) { return 0; }
    return f64_to(f64_mul(f64_from(1000), f64_div(sxy, f64_sqrt(f64_mul(sxx, syy)))));
}

# The encoder's TNS, written as tns_data and parsed back, then the decoder's
# synthesis filter: the original spectrum returns.
fn test_aac_encoder_tns_roundtrip() {
    test_group("aac encoder: TNS analysis, bitstream, synthesis");
    if (_aac_swb_offset == 0) { _aac_init_swb(); }
    _ae_setup(44100, 1, 128000);
    _ae_seq = _AE_SEQ_LONG;
    _ae_nwin = 1;
    _ae_swb = _aac_swb_offset;
    _ae_nswb = _AAC_NUM_SWB;
    _ae_maxsfb = _ae_cut_l;
    _ae_ngrp = 1;
    store64(_ae_gw0, 0);
    store64(_ae_glen, 1);
    var cs = load64(_ae_cs);
    var spec = load64(cs + _AE_CS_SPEC);
    var orig = alloc(1024 * 8);
    var i = 0;
    while (i < 1024) {
        # a smooth spectrum: a strongly predictable one, like an attack's
        var v = f64_mul(f64_from(1000), f64_sin(f64_div(f64_from(i), f64_from(9))));
        store64(spec + i * 8, v);
        store64(orig + i * 8, v);
        i = i + 1;
    }
    _ae_tns(0);
    assert_eq(load64(cs + _AE_CS_TNS_ON), 1, "TNS engages on a predictable spectrum");
    var bw = _bw_new();
    _bw_write(bw, 0, 1);
    _ae_write_tns(bw, cs);
    _bw_write(bw, 0, 1);
    var st = _bw_flush(bw);
    var br = _br_new(str_data(st), str_len(st));
    var ts = alloc(TNS_ST_SIZE);
    memset(ts, 0, TNS_ST_SIZE);
    assert(res_ok(_aac_parse_ics_ext(br, 0, _ae_maxsfb, ts)) == 1, "tns_data parses");
    _tns_synth_apply(spec, ts);
    var worst = 0;
    i = 0;
    while (i < 1024) {
        var d = f64_abs(f64_sub(load64(spec + i * 8), load64(orig + i * 8)));
        if (f64_gt(d, worst) == 1) { worst = d; }
        i = i + 1;
    }
    assert(f64_lt(worst, f64_div(F64_ONE, f64_from(1000000))) == 1, "synthesis inverts the encoder's filter");
    return 0;
}

# The stereo and noise tools fire where they belong, and not elsewhere.
fn test_aac_encoder_tools() {
    test_group("aac encoder: M/S, PNS, intensity");
    var n = 44100 * 2;
    var buf = alloc(aac_encode_bound(n, 2));
    # identical channels: mid/side everywhere it pays
    var mono = _ae_t_signal(n, 1, 44100, 0);
    var same = vec_new();
    var i = 0;
    while (i < n) { vec_push(same, vec_get(mono, i)); vec_push(same, vec_get(mono, i)); i = i + 1; }
    assert(res_ok(aac_encode(same, 44100, 2, 128000, buf)) == 1, "identical channels encode");
    assert(load64(_ae_stat + 6 * 8) > 0, "identical channels use M/S");
    # noise at a low rate: PNS; a tone at the same rate: none; noise above 24
    # kbit/s a channel: none
    var noise = _ae_t_signal(n, 1, 44100, 3);
    assert(res_ok(aac_encode(noise, 44100, 1, 24000, buf)) == 1, "noise encodes");
    assert(load64(_ae_stat + 7 * 8) > 0, "noise at 24 kbit/s uses PNS");
    var tone = _ae_t_signal(n, 1, 44100, 2);
    assert(res_ok(aac_encode(tone, 44100, 1, 24000, buf)) == 1, "tone encodes");
    assert_eq(load64(_ae_stat + 7 * 8), 0, "a tone never becomes noise");
    assert(res_ok(aac_encode(noise, 44100, 1, 32000, buf)) == 1, "noise at 32 kbit/s encodes");
    assert_eq(load64(_ae_stat + 7 * 8), 0, "no PNS above 24 kbit/s a channel");
    # correlated high band at a low rate: intensity; decorrelated: none. Tones,
    # not noise, which PNS would take first.
    var hf = _ae_t_signal(n, 1, 44100, 4);
    var fr = vec_new();
    var ho = vec_new();
    i = 0;
    while (i < n) {
        var a = vec_get(hf, i);
        vec_push(fr, a);
        vec_push(fr, f64_mul(a, F64_HALF));
        vec_push(ho, a);
        vec_push(ho, vec_get(noise, i));
        i = i + 1;
    }
    assert(res_ok(aac_encode(fr, 44100, 2, 64000, buf)) == 1, "correlated stereo encodes");
    assert(load64(_ae_stat + 8 * 8) > 0, "correlated stereo at 32 kbit/s a channel uses intensity");
    assert(res_ok(aac_encode(ho, 44100, 2, 64000, buf)) == 1, "decorrelated stereo encodes");
    assert_eq(load64(_ae_stat + 8 * 8), 0, "decorrelated stereo never uses intensity");
    return 0;
}

# Amplitude of the f Hz component of x[start .. start + n), n a whole number of
# cycles: 2/n |sum x e^(-i w k)|.
fn _ae_t_tone_amp(x, start, n, f, rate) {
    var w = f64_div(f64_mul(F64_TWO, f64_mul(F64_PI, f64_from(f))), f64_from(rate));
    var sc = 0;
    var ss = 0;
    var k = 0;
    while (k < n) {
        var v = load64(x + (start + k) * 8);
        sc = f64_add(sc, f64_mul(v, f64_cos(f64_mul(w, f64_from(k)))));
        ss = f64_add(ss, f64_mul(v, f64_sin(f64_mul(w, f64_from(k)))));
        k = k + 1;
    }
    return f64_div(f64_mul(F64_TWO, f64_sqrt(f64_add(f64_mul(sc, sc), f64_mul(ss, ss)))), f64_from(n));
}

# A quiet tone high in the band, -75 dBFS at 14.5 kHz, over noise low-passed by
# eight one-pole sections at 3 kHz: loud enough to keep the rate loop busy (with
# bits to spare it lowers every threshold and drops nothing), gone by 14.5 kHz,
# so nothing masks the tone. At 64 kbit/s mono the tone is under the threshold in
# quiet as calibrated (full scale at 96 dB SPL puts it near 34 dB SPL there, -62
# dBFS), so until 2.10.1 every frame dropped it, where ffmpeg codes it. From 48
# kbit/s a channel the threshold sits 30 dB lower and the tone must come through
# within 3 dB.
fn test_aac_encoder_quiet_band() {
    test_group("aac encoder: quiet high band");
    var rate = 48000;
    var n = rate * 2;
    var amp = f64_div(F64_ONE, f64_from(5623));          # -75 dB
    var v = vec_new();
    var x = alloc(n * 8);
    var lpa = f64_exp(f64_neg(f64_div(f64_mul(f64_mul(F64_TWO, F64_PI), f64_from(3000)), f64_from(rate))));
    var st = alloc(8 * 8);
    memset(st, 0, 64);
    var seed = 0x2545F4914F6CDD1D;
    var i = 0;
    while (i < n) {
        seed = seed * 6364136223846793005 + 1442695040888963407;
        var y = f64_div(f64_from(((seed >> 11) & 0xFFFF) - 32768), f64_from(32768));
        var j = 0;
        while (j < 8) {
            y = f64_add(f64_mul(lpa, load64(st + j * 8)), f64_mul(f64_sub(F64_ONE, lpa), y));
            store64(st + j * 8, y);
            j = j + 1;
        }
        var t = f64_div(f64_mul(F64_TWO, f64_mul(F64_PI, f64_from(i))), f64_from(rate));
        var s = f64_add(f64_mul(f64_from(3), y), f64_mul(amp, f64_sin(f64_mul(t, f64_from(14500)))));
        vec_push(v, s);
        store64(x + i * 8, s);
        i = i + 1;
    }
    var buf = alloc(aac_encode_bound(n, 1));
    var len = aac_encode(v, rate, 1, 64000, buf);
    assert(res_ok(len) == 1, "quiet band: encode");
    var r = aac_decode(buf, len);
    assert(res_ok(r) == 1, "quiet band: decode");
    if (is_err(r) == 1) { return 0; }
    var d = decode_result_samples(r);
    var dn = vec_len(d);
    var yd = alloc(dn * 8);
    i = 0;
    while (i < dn) { store64(yd + i * 8, vec_get(d, i)); i = i + 1; }
    # one second, 14500 whole cycles, from 8192 in (the decode lags by 1024)
    var want = _ae_t_tone_amp(x, 8192, rate, 14500, rate);
    var got = _ae_t_tone_amp(yd, 8192 + 1024, rate, 14500, rate);
    var db10 = f64_to(f64_mul(f64_from(100), f64_div(f64_ln(f64_div(f64_add(got, f64_div(F64_ONE, f64_from(1000000000))), want)), f64_ln(f64_from(10)))));
    syscall(1, 1, "  14.5 kHz at -75 dBFS, decoded dB*10 = ", 40); fmt_int(db10); syscall(1, 1, "\n", 1);
    assert(db10 > 0 - 30 && db10 < 30, "a -75 dBFS tone at 14.5 kHz survives 64 kbit/s mono within 3 dB");
    return 0;
}

# NaN, infinities, values past full scale, empty and one-sample input, every
# rate: the stream is well formed and decodes.
fn test_aac_encoder_hostile() {
    test_group("aac encoder: hostile input");
    var buf = alloc(aac_encode_bound(4096, 2));
    var v = vec_new();
    var i = 0;
    while (i < 4096 * 2) {
        var x = f64_div(f64_from((i * 7919) % 2001 - 1000), f64_from(1000));
        if (i % 17 == 0) { x = 0x7FF8000000000000; }
        if (i % 19 == 0) { x = 0x7FF0000000000000; }
        if (i % 23 == 0) { x = f64_from(1000000); }
        vec_push(v, x);
        i = i + 1;
    }
    var len = aac_encode(v, 48000, 2, 96000, buf);
    assert(res_ok(len) == 1, "hostile values encode");
    assert(_ae_t_frames_ok(buf, len, 2) > 0, "hostile values: well-formed frames");
    assert(res_ok(aac_decode(buf, len)) == 1, "hostile values decode");
    var empty = vec_new();
    len = aac_encode(empty, 44100, 1, 64000, buf);
    assert(res_ok(len) == 1, "empty input encodes");
    assert(res_ok(aac_decode(buf, len)) == 1, "empty input decodes");
    var one = vec_new();
    vec_push(one, F64_HALF);
    len = aac_encode(one, 8000, 1, 16000, buf);
    assert(res_ok(len) == 1, "one sample encodes");
    assert(res_ok(aac_decode(buf, len)) == 1, "one sample decodes");
    var rates = alloc(13 * 8);
    var r = 0;
    while (r < 13) {
        var rate = load64(_aac_sample_rates + r * 8);
        var s = _ae_t_signal(2048, 2, rate, 0);
        var l2 = aac_encode(s, rate, 2, 96000, buf);
        assert(res_ok(l2) == 1, "every rate encodes");
        assert(_ae_t_frames_ok(buf, l2, 2) > 0, "every rate: well-formed frames");
        r = r + 1;
    }
    return 0;
}

fn test_aac_all() {
    fft_init();
    aac_init();
    if (_aac_swb_offset == 0) { _aac_init_swb(); }

    test_aac_adts_parse_valid();
    test_aac_adts_reject_short();
    test_aac_adts_reject_bad_sync();
    test_aac_adts_reject_reserved_sr();
    test_aac_adts_header_roundtrip();
    test_aac_encode_rejects_bad_rate();
    test_aac_encode_rejects_bad_channels();
    test_aac_encode_rejects_zero_bitrate();
    test_aac_encode_produces_adts();
    test_aac_decode_empty();
    test_aac_bitwriter_basic();
    test_aac_tns_filter_inverse();
    test_aac_tns_coef_quant();
    test_aac_tns_frame_roundtrip();
    test_aac_encoder_rate();
    test_aac_encoder_windows();
    test_aac_encoder_tns_roundtrip();
    test_aac_encoder_tools();
    test_aac_encoder_quiet_band();
    test_aac_encoder_hostile();
    return 0;
}
