    store64(C+18*8,0x1f3); store64(C+19*8,0x0ef); store64(C+20*8,0x032); store64(C+21*8,0x027); store64(C+22*8,0x028); store64(C+23*8,0x026); store64(C+24*8,0x031); store64(C+25*8,0x0eb); store64(C+26*8,0x1f7);
    store64(C+27*8,0x1e8); store64(C+28*8,0x06f); store64(C+29*8,0x02e); store64(C+30*8,0x008); store64(C+31*8,0x004); store64(C+32*8,0x006); store64(C+33*8,0x029); store64(C+34*8,0x06b); store64(C+35*8,0x1ee);
