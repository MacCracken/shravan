    store64(L+45*8, 9); store64(L+46*8,10); store64(L+47*8,13); store64(L+48*8, 8); store64(L+49*8, 9); store64(L+50*8,12); store64(L+51*8,10); store64(L+52*8,11); store64(L+53*8,12);
    store64(L+54*8, 8); store64(L+55*8,10); store64(L+56*8,15); store64(L+57*8, 9); store64(L+58*8,11); store64(L+59*8,15); store64(L+60*8,13); store64(L+61*8,14); store64(L+62*8,16);
    store64(L+63*8, 8); store64(L+64*8,10); store64(L+65*8,14); store64(L+66*8, 9); store64(L+67*8,10); store64(L+68*8,14); store64(L+69*8,12); store64(L+70*8,12); store64(L+71*8,15);
    store64(L+72*8,11); store64(L+73*8,12); store64(L+74*8,16); store64(L+75*8,10); store64(L+76*8,11); store64(L+77*8,15); store64(L+78*8,12); store64(L+79*8,12); store64(L+80*8,15);
    # Codes (81 entries)
    store64(C+ 0*8,0x000); store64(C+ 1*8,0x009); store64(C+ 2*8,0x0ef); store64(C+ 3*8,0x00b); store64(C+ 4*8,0x019); store64(C+ 5*8,0x0f0); store64(C+ 6*8,0x1eb); store64(C+ 7*8,0x1e6); store64(C+ 8*8,0x3f2);
    store64(C+ 9*8,0x00a); store64(C+10*8,0x035); store64(C+11*8,0x1ef); store64(C+12*8,0x034); store64(C+13*8,0x037); store64(C+14*8,0x1e9); store64(C+15*8,0x1ed); store64(C+16*8,0x1e7); store64(C+17*8,0x3f3);
    store64(C+18*8,0x1ee); store64(C+19*8,0x3ed); store64(C+20*8,0x1ffa); store64(C+21*8,0x1ec); store64(C+22*8,0x1f2); store64(C+23*8,0x7f9); store64(C+24*8,0x7f8); store64(C+25*8,0x3f8); store64(C+26*8,0xff8);
    store64(C+27*8,0x008); store64(C+28*8,0x038); store64(C+29*8,0x3f6); store64(C+30*8,0x036); store64(C+31*8,0x075); store64(C+32*8,0x3f1); store64(C+33*8,0x3eb); store64(C+34*8,0x3ec); store64(C+35*8,0xff4);
    store64(C+36*8,0x018); store64(C+37*8,0x076); store64(C+38*8,0x7f4); store64(C+39*8,0x039); store64(C+40*8,0x074); store64(C+41*8,0x3ef); store64(C+42*8,0x1f3); store64(C+43*8,0x1f4); store64(C+44*8,0x7f6);
    store64(C+45*8,0x1e8); store64(C+46*8,0x3ea); store64(C+47*8,0x1ffc); store64(C+48*8,0x0f2); store64(C+49*8,0x1f1); store64(C+50*8,0xffb); store64(C+51*8,0x3f5); store64(C+52*8,0x7f3); store64(C+53*8,0xffc);
    store64(C+54*8,0x0ee); store64(C+55*8,0x3f7); store64(C+56*8,0x7ffe); store64(C+57*8,0x1f0); store64(C+58*8,0x7f5); store64(C+59*8,0x7ffd); store64(C+60*8,0x1ffb); store64(C+61*8,0x3ffa); store64(C+62*8,0xffff);
    store64(C+63*8,0x0f1); store64(C+64*8,0x3f0); store64(C+65*8,0x3ffc); store64(C+66*8,0x1ea); store64(C+67*8,0x3ee); store64(C+68*8,0x3ffb); store64(C+69*8,0xff6); store64(C+70*8,0xffa); store64(C+71*8,0x7ffc);
    store64(C+72*8,0x7f2); store64(C+73*8,0xff5); store64(C+74*8,0xfffe); store64(C+75*8,0x3f4); store64(C+76*8,0x7f7); store64(C+77*8,0x7ffb); store64(C+78*8,0xff7); store64(C+79*8,0xff9); store64(C+80*8,0x7ffa);
    return 0;
}

# HCB4: unsigned quad, values 0..2, sign bits follow, 81 entries.
# Derived by measuring a reference decoder (see docs/sources.md);
# verified complete prefix code: Kraft == 1, no duplicate or
# prefix-colliding codewords, all 81 symbols reachable.
fn _aac_init_hcb4() {
    var L = alloc(81 * 8); var C = alloc(81 * 8);
    _aac_hcb4_lens = L; _aac_hcb4_codes = C;
    # Lengths (81 entries)
    store64(L+ 0*8, 4); store64(L+ 1*8, 5); store64(L+ 2*8, 8); store64(L+ 3*8, 5); store64(L+ 4*8, 4); store64(L+ 5*8, 8); store64(L+ 6*8, 9); store64(L+ 7*8, 8); store64(L+ 8*8,11);
    store64(L+ 9*8, 5); store64(L+10*8, 5); store64(L+11*8, 8); store64(L+12*8, 5); store64(L+13*8, 4); store64(L+14*8, 8); store64(L+15*8, 8); store64(L+16*8, 7); store64(L+17*8,10);
    store64(L+18*8, 9); store64(L+19*8, 8); store64(L+20*8,11); store64(L+21*8, 8); store64(L+22*8, 8); store64(L+23*8,10); store64(L+24*8,11); store64(L+25*8,10); store64(L+26*8,11);
    store64(L+27*8, 4); store64(L+28*8, 5); store64(L+29*8, 8); store64(L+30*8, 4); store64(L+31*8, 4); store64(L+32*8, 8); store64(L+33*8, 8); store64(L+34*8, 8); store64(L+35*8,10);
    store64(L+36*8, 4); store64(L+37*8, 4); store64(L+38*8, 8); store64(L+39*8, 4); store64(L+40*8, 4); store64(L+41*8, 7); store64(L+42*8, 8); store64(L+43*8, 7); store64(L+44*8, 9);
    store64(L+45*8, 8); store64(L+46*8, 8); store64(L+47*8,10); store64(L+48*8, 7); store64(L+49*8, 7); store64(L+50*8, 9); store64(L+51*8,10); store64(L+52*8, 9); store64(L+53*8,10);
    store64(L+54*8, 8); store64(L+55*8, 8); store64(L+56*8,11); store64(L+57*8, 8); store64(L+58*8, 7); store64(L+59*8,10); store64(L+60*8,11); store64(L+61*8,10); store64(L+62*8,12);
    store64(L+63*8, 8); store64(L+64*8, 7); store64(L+65*8,10); store64(L+66*8, 7); store64(L+67*8, 7); store64(L+68*8, 9); store64(L+69*8,10); store64(L+70*8, 9); store64(L+71*8,11);
    store64(L+72*8,11); store64(L+73*8,10); store64(L+74*8,12); store64(L+75*8,10); store64(L+76*8, 9); store64(L+77*8,11); store64(L+78*8,11); store64(L+79*8,10); store64(L+80*8,11);
    # Codes (81 entries)
    store64(C+ 0*8,0x007); store64(C+ 1*8,0x016); store64(C+ 2*8,0x0f6); store64(C+ 3*8,0x018); store64(C+ 4*8,0x008); store64(C+ 5*8,0x0ef); store64(C+ 6*8,0x1ef); store64(C+ 7*8,0x0f3); store64(C+ 8*8,0x7f8);
    store64(C+ 9*8,0x019); store64(C+10*8,0x017); store64(C+11*8,0x0ed); store64(C+12*8,0x015); store64(C+13*8,0x001); store64(C+14*8,0x0e2); store64(C+15*8,0x0f0); store64(C+16*8,0x070); store64(C+17*8,0x3f0);
    store64(C+18*8,0x1ee); store64(C+19*8,0x0f1); store64(C+20*8,0x7fa); store64(C+21*8,0x0ee); store64(C+22*8,0x0e4); store64(C+23*8,0x3f2); store64(C+24*8,0x7f6); store64(C+25*8,0x3ef); store64(C+26*8,0x7fd);
    store64(C+27*8,0x005); store64(C+28*8,0x014); store64(C+29*8,0x0f2); store64(C+30*8,0x009); store64(C+31*8,0x004); store64(C+32*8,0x0e5); store64(C+33*8,0x0f4); store64(C+34*8,0x0e8); store64(C+35*8,0x3f4);
    store64(C+36*8,0x006); store64(C+37*8,0x002); store64(C+38*8,0x0e7); store64(C+39*8,0x003); store64(C+40*8,0x000); store64(C+41*8,0x06b); store64(C+42*8,0x0e3); store64(C+43*8,0x069); store64(C+44*8,0x1f3);
    store64(C+45*8,0x0eb); store64(C+46*8,0x0e6); store64(C+47*8,0x3f6); store64(C+48*8,0x06e); store64(C+49*8,0x06a); store64(C+50*8,0x1f4); store64(C+51*8,0x3ec); store64(C+52*8,0x1f0); store64(C+53*8,0x3f9);
    store64(C+54*8,0x0f5); store64(C+55*8,0x0ec); store64(C+56*8,0x7fb); store64(C+57*8,0x0ea); store64(C+58*8,0x06f); store64(C+59*8,0x3f7); store64(C+60*8,0x7f9); store64(C+61*8,0x3f3); store64(C+62*8,0xfff);
    store64(C+63*8,0x0e9); store64(C+64*8,0x06d); store64(C+65*8,0x3f8); store64(C+66*8,0x06c); store64(C+67*8,0x068); store64(C+68*8,0x1f5); store64(C+69*8,0x3ee); store64(C+70*8,0x1f2); store64(C+71*8,0x7f4);
    store64(C+72*8,0x7f7); store64(C+73*8,0x3f1); store64(C+74*8,0xffe); store64(C+75*8,0x3ed); store64(C+76*8,0x1f1); store64(C+77*8,0x7f5); store64(C+78*8,0x7fe); store64(C+79*8,0x3f5); store64(C+80*8,0x7fc);
    return 0;
}

fn _aac_init_spectral_codebooks() {
    _aac_init_hcb1();
    _aac_init_hcb2();
    _aac_init_hcb3();
    _aac_init_hcb4();
    _aac_init_hcb5();
    _aac_init_hcb6();
    _aac_init_hcb7();
    _aac_init_hcb8();
    _aac_init_hcb9();
    _aac_init_hcb10();
    _aac_init_hcb11();
    return 0;
}

# Decode a spectral quad (4 values) using codebooks 1-4.
# cb: codebook number (1-4)
# br: bitreader
# out: pointer to write 4 i64 values (w, x, y, z)
# Returns 0 on success, err on failure.
#
# HCB1/2: signed quads, 81 entries (3^4), values -1,0,1
#   index = (w+1)*27 + (x+1)*9 + (y+1)*3 + (z+1)
#   values recovered as: val = (idx / divisor) % 3 - 1
# HCB3/4: unsigned quads, 81 entries (3^4), values 0,1,2
#   index = w*27 + x*9 + y*3 + z
#   sign bits read separately for nonzero values
var _aac_hcb1_sorted = 0;
var _aac_hcb1_lut = 0;
var _aac_hcb2_sorted = 0;
var _aac_hcb2_lut = 0;
var _aac_hcb3_sorted = 0;
var _aac_hcb3_lut = 0;
var _aac_hcb4_sorted = 0;
var _aac_hcb4_lut = 0;

fn _aac_decode_spectral_quad(br, cb, out) {
    if (_aac_hcb5_lens == 0) { _aac_init_spectral_codebooks(); }

    # Build sorted + LUT tables for quad codebooks on first use
    if (_aac_hcb1_sorted == 0) {
        if (_aac_hcb1_lens != 0) {
            _aac_hcb1_sorted = _aac_huff_build_sorted(_aac_hcb1_lens, _aac_hcb1_codes, 81);
            _aac_hcb1_lut = _aac_huff_build_lut(_aac_hcb1_lens, _aac_hcb1_codes, 81);
        }
        if (_aac_hcb2_lens != 0) {
            _aac_hcb2_sorted = _aac_huff_build_sorted(_aac_hcb2_lens, _aac_hcb2_codes, 81);
            _aac_hcb2_lut = _aac_huff_build_lut(_aac_hcb2_lens, _aac_hcb2_codes, 81);
        }
        if (_aac_hcb3_lens != 0) {
            _aac_hcb3_sorted = _aac_huff_build_sorted(_aac_hcb3_lens, _aac_hcb3_codes, 81);
            _aac_hcb3_lut = _aac_huff_build_lut(_aac_hcb3_lens, _aac_hcb3_codes, 81);
        }
        if (_aac_hcb4_lens != 0) {
            _aac_hcb4_sorted = _aac_huff_build_sorted(_aac_hcb4_lens, _aac_hcb4_codes, 81);
            _aac_hcb4_lut = _aac_huff_build_lut(_aac_hcb4_lens, _aac_hcb4_codes, 81);
        }
    }

    # Codebook 1-2: signed quads (values -1,0,1 directly encoded)
    if (cb == 1) {
        if (_aac_hcb1_sorted == 0) { store64(out,0); store64(out+8,0); store64(out+16,0); store64(out+24,0); return 0; }
        var idx = _aac_huff_decode_lut(br, _aac_hcb1_lut, _aac_hcb1_sorted, 81);
        if (is_err(idx) == 1) { return idx; }
        var w = (idx / 27) % 3 - 1;
        var x = (idx / 9) % 3 - 1;
        var y = (idx / 3) % 3 - 1;
        var z = idx % 3 - 1;
        store64(out, w); store64(out + 8, x); store64(out + 16, y); store64(out + 24, z);
        return 0;
    }
    if (cb == 2) {
        if (_aac_hcb2_sorted == 0) { store64(out,0); store64(out+8,0); store64(out+16,0); store64(out+24,0); return 0; }
        var idx = _aac_huff_decode_lut(br, _aac_hcb2_lut, _aac_hcb2_sorted, 81);
        if (is_err(idx) == 1) { return idx; }
        var w = (idx / 27) % 3 - 1;
        var x = (idx / 9) % 3 - 1;
        var y = (idx / 3) % 3 - 1;
        var z = idx % 3 - 1;
        store64(out, w); store64(out + 8, x); store64(out + 16, y); store64(out + 24, z);
        return 0;
    }

    # Codebook 3-4: unsigned quads (values 0,1,2 + sign bits)
    if (cb == 3) {
        if (_aac_hcb3_sorted == 0) { store64(out,0); store64(out+8,0); store64(out+16,0); store64(out+24,0); return 0; }
        var idx = _aac_huff_decode_lut(br, _aac_hcb3_lut, _aac_hcb3_sorted, 81);
        if (is_err(idx) == 1) { return idx; }
        var w = (idx / 27) % 3;
        var x = (idx / 9) % 3;
        var y = (idx / 3) % 3;
        var z = idx % 3;
        if (w > 0) { var sw = _br_read(br, 1); if (res_ok(sw) == 1) { if (sw == 1) { w = 0 - w; } } }
        if (x > 0) { var sx = _br_read(br, 1); if (res_ok(sx) == 1) { if (sx == 1) { x = 0 - x; } } }
        if (y > 0) { var sy = _br_read(br, 1); if (res_ok(sy) == 1) { if (sy == 1) { y = 0 - y; } } }
        if (z > 0) { var sz = _br_read(br, 1); if (res_ok(sz) == 1) { if (sz == 1) { z = 0 - z; } } }
        store64(out, w); store64(out + 8, x); store64(out + 16, y); store64(out + 24, z);
        return 0;
    }
    if (cb == 4) {
        if (_aac_hcb4_sorted == 0) { store64(out,0); store64(out+8,0); store64(out+16,0); store64(out+24,0); return 0; }
        var idx = _aac_huff_decode_lut(br, _aac_hcb4_lut, _aac_hcb4_sorted, 81);
        if (is_err(idx) == 1) { return idx; }
        var w = (idx / 27) % 3;
        var x = (idx / 9) % 3;
        var y = (idx / 3) % 3;
        var z = idx % 3;
        if (w > 0) { var sw = _br_read(br, 1); if (res_ok(sw) == 1) { if (sw == 1) { w = 0 - w; } } }
        if (x > 0) { var sx = _br_read(br, 1); if (res_ok(sx) == 1) { if (sx == 1) { x = 0 - x; } } }
        if (y > 0) { var sy = _br_read(br, 1); if (res_ok(sy) == 1) { if (sy == 1) { y = 0 - y; } } }
        if (z > 0) { var sz = _br_read(br, 1); if (res_ok(sz) == 1) { if (sz == 1) { z = 0 - z; } } }
        store64(out, w); store64(out + 8, x); store64(out + 16, y); store64(out + 24, z);
        return 0;
    }

    return err(ERR_DECODE);
}

# Decode a spectral pair using the given codebook.
# cb: codebook number (1-11)
# br: bitreader
# out: pointer to write 2 i64 values (x, y)
# Returns 0 on success, err on failure.
# Build the sorted + LUT decode tables on first use.
#
# This used to live inline in _aac_decode_spectral_pair, which meant any decode
# path that did NOT go through it saw null tables. The cb 11 path is exactly
# such a path, and a frame using only cb 0 and cb 11 dereferenced a null LUT.
fn _aac_ensure_huff_tables() {
    if (_aac_hcb5_lens == 0) { _aac_init_spectral_codebooks(); }
    if (_aac_hcb5_sorted != 0) { return 0; }
    _aac_build_huff_tables();
    return 0;
}

fn _aac_build_huff_tables() {
    {
        _aac_hcb5_sorted = _aac_huff_build_sorted(_aac_hcb5_lens, _aac_hcb5_codes, 81);
        _aac_hcb5_lut = _aac_huff_build_lut(_aac_hcb5_lens, _aac_hcb5_codes, 81);
        _aac_hcb6_sorted = _aac_huff_build_sorted(_aac_hcb6_lens, _aac_hcb6_codes, 81);
        _aac_hcb6_lut = _aac_huff_build_lut(_aac_hcb6_lens, _aac_hcb6_codes, 81);
        _aac_hcb7_sorted = _aac_huff_build_sorted(_aac_hcb7_lens, _aac_hcb7_codes, 64);
        _aac_hcb7_lut = _aac_huff_build_lut(_aac_hcb7_lens, _aac_hcb7_codes, 64);
        _aac_hcb8_sorted = _aac_huff_build_sorted(_aac_hcb8_lens, _aac_hcb8_codes, 64);
        _aac_hcb8_lut = _aac_huff_build_lut(_aac_hcb8_lens, _aac_hcb8_codes, 64);
        _aac_hcb9_sorted = _aac_huff_build_sorted(_aac_hcb9_lens, _aac_hcb9_codes, 169);
        _aac_hcb9_lut = _aac_huff_build_lut(_aac_hcb9_lens, _aac_hcb9_codes, 169);
        _aac_hcb10_sorted = _aac_huff_build_sorted(_aac_hcb10_lens, _aac_hcb10_codes, 169);
        _aac_hcb10_lut = _aac_huff_build_lut(_aac_hcb10_lens, _aac_hcb10_codes, 169);
        _aac_hcb11_sorted = _aac_huff_build_sorted(_aac_hcb11_lens, _aac_hcb11_codes, 289);
        _aac_hcb11_lut = _aac_huff_build_lut(_aac_hcb11_lens, _aac_hcb11_codes, 289);
    }
    return 0;
}

fn _aac_decode_spectral_pair(br, cb, out) {
    _aac_ensure_huff_tables();

    # Codebook 5-6: signed pairs, 81 entries, values -4..4
    if (cb == 5) {
        var idx = _aac_huff_decode_lut(br, _aac_hcb5_lut, _aac_hcb5_sorted, 81);
        if (is_err(idx) == 1) { return idx; }
        var x = (idx / 9) - 4;
        var y = (idx % 9) - 4;
        store64(out, x);
        store64(out + 8, y);
        return 0;
    }
    if (cb == 6) {
        # HCB5 and HCB6 cover the same value range (-4..4) but have completely
        # different codeword lengths, so decoding cb 6 with HCB5's table (as this
        # did before v2.6.10) produced both wrong values and a wrong consumed bit
        # count, desynchronising every later band of the frame. ffmpeg's encoder
        # uses cb 6 heavily — 326 of 3243 coded bands in a sample file.
        var idx = _aac_huff_decode_lut(br, _aac_hcb6_lut, _aac_hcb6_sorted, 81);
        if (is_err(idx) == 1) { return idx; }
        var x = (idx / 9) - 4;
        var y = (idx % 9) - 4;
        store64(out, x);
        store64(out + 8, y);
        return 0;
    }

    # Codebook 7-8: unsigned pairs, 64 entries, values 0..7, sign bits separate
    if (cb == 7) {
        var idx = _aac_huff_decode_lut(br, _aac_hcb7_lut, _aac_hcb7_sorted, 64);
        if (is_err(idx) == 1) { return idx; }
        var x = idx / 8;
        var y = idx % 8;
        if (x > 0) {
            var sx = _br_read(br, 1);
            if (res_ok(sx) == 1) { if (sx == 1) { x = 0 - x; } }
        }
        if (y > 0) {
            var sy = _br_read(br, 1);
            if (res_ok(sy) == 1) { if (sy == 1) { y = 0 - y; } }
        }
        store64(out, x);
        store64(out + 8, y);
        return 0;
    }
    if (cb == 8) {
        var idx = _aac_huff_decode_lut(br, _aac_hcb8_lut, _aac_hcb8_sorted, 64);
        if (is_err(idx) == 1) { return idx; }
        var x = idx / 8;
        var y = idx % 8;
        if (x > 0) {
            var sx = _br_read(br, 1);
            if (res_ok(sx) == 1) { if (sx == 1) { x = 0 - x; } }
        }
        if (y > 0) {
            var sy = _br_read(br, 1);
            if (res_ok(sy) == 1) { if (sy == 1) { y = 0 - y; } }
        }
        store64(out, x);
        store64(out + 8, y);
        return 0;
    }

    # Codebook 9: unsigned pairs, 169 entries (13x13), values 0..12, sign bits separate
    if (cb == 9) {
        var idx = _aac_huff_decode_lut(br, _aac_hcb9_lut, _aac_hcb9_sorted, 169);
        if (is_err(idx) == 1) { return idx; }
        var x = idx / 13;
        var y = idx % 13;
        if (x > 0) {
            var sx = _br_read(br, 1);
            if (res_ok(sx) == 1) { if (sx == 1) { x = 0 - x; } }
        }
        if (y > 0) {
            var sy = _br_read(br, 1);
            if (res_ok(sy) == 1) { if (sy == 1) { y = 0 - y; } }
        }
        store64(out, x);
        store64(out + 8, y);
        return 0;
    }
    # Codebook 10: unsigned pairs, 169 entries (13x13), values 0..12, sign bits separate
    if (cb == 10) {
        var idx = _aac_huff_decode_lut(br, _aac_hcb10_lut, _aac_hcb10_sorted, 169);
        if (is_err(idx) == 1) { return idx; }
        var x = idx / 13;
        var y = idx % 13;
        if (x > 0) {
            var sx = _br_read(br, 1);
            if (res_ok(sx) == 1) { if (sx == 1) { x = 0 - x; } }
        }
        if (y > 0) {
            var sy = _br_read(br, 1);
            if (res_ok(sy) == 1) { if (sy == 1) { y = 0 - y; } }
        }
        store64(out, x);
        store64(out + 8, y);
        return 0;
    }

    # Codebook 11: escape pairs (existing implementation)
    # Handled inline in _aac_decode_spectral
    return err(ERR_DECODE);
}

# ================================================================
# AAC-LC frame decoder
# ================================================================

# out_info (16 bytes, may be 0): [0] = window_sequence, [8] = window group count.
#
# The window sequence used to be read and thrown away, so the caller always ran
# the long-window synthesis (2048-point IMDCT, long sine window) even for an
# EIGHT_SHORT_SEQUENCE frame — and _aac_synth_short had no callers at all. Any
# stream with a transient therefore decoded to garbage from the first short
# frame onward, with the overlap buffer carrying the damage forward.
# ics_info(), ISO 14496-3 Table 4.45. Writes into out_info (>=128 bytes):
#   +0  window_sequence   +8  num_window_groups   +16..+79 group lengths
#   +88 window_shape      +96 max_sfb
# Split out of _aac_parse_ics so the CPE path can share it: with common_window
# set, ics_info() lives in the channel_pair_element header, ahead of BOTH
# channels' individual_channel_stream(). The CPE path used to re-implement this
# inline and diverged from it.
fn _aac_parse_ics_info(br, out_info) {

    var ics_reserved = _br_read(br, 1);
    if (is_err(ics_reserved) == 1) { return ics_reserved; }
    var window_seq = _br_read(br, 2);
    if (is_err(window_seq) == 1) { return window_seq; }
    var window_shape = _br_read(br, 1);
    if (is_err(window_shape) == 1) { return window_shape; }
    if (out_info != 0) { store64(out_info + 88, window_shape); }

    # ISO 14496-3 ics_info(): the max_sfb field is FOUR bits for an
    # EIGHT_SHORT_SEQUENCE (followed by 7 bits of scale_factor_grouping) and SIX
    # for every other window sequence (followed by predictor_data_present).
    # Reading 6 + 1 unconditionally desynchronised every short frame by two bits
    # before the section data had even started.
    var is_short = 0;
    if (window_seq == 2) { is_short = 1; }

    var max_sfb = 0;
    var num_groups = 1;
    var sfg_bits = 0;
    if (is_short == 1) {
        max_sfb = _br_read(br, 4);
        if (is_err(max_sfb) == 1) { return max_sfb; }
        var sfg = _br_read(br, 7);
        if (is_err(sfg) == 1) { return sfg; }
        sfg_bits = sfg;
        # Each 0 bit starts a new window group; 8 windows, 7 grouping bits.
        var gb = 6;
        while (gb >= 0) {
            if (((sfg >> gb) & 1) == 0) { num_groups = num_groups + 1; }
            gb = gb - 1;
        }
        if (num_groups < 1) { num_groups = 1; }
        if (num_groups > 8) { return err(ERR_DECODE); }
    } else {
        max_sfb = _br_read(br, 6);
        if (is_err(max_sfb) == 1) { return max_sfb; }
        var predictor = _br_read(br, 1);
        if (is_err(predictor) == 1) { return predictor; }
    }
    if (out_info != 0) {
        store64(out_info, window_seq);
        store64(out_info + 8, num_groups);
        # Group lengths at +16: how many of the 8 windows each group covers.
        var gi = 0;
        while (gi < 8) { store64(out_info + 16 + gi * 8, 0); gi = gi + 1; }
        if (is_short == 1) {
            var gg = 0; var wcount = 1; var gidx = 0;
            var bb = 6;
            while (bb >= 0) {
                if (((sfg_bits >> bb) & 1) == 1) { wcount = wcount + 1; }
                else {
                    store64(out_info + 16 + gidx * 8, wcount);
                    gidx = gidx + 1; wcount = 1;
                }
                bb = bb - 1;
            }
            store64(out_info + 16 + gidx * 8, wcount);
        } else {
            store64(out_info + 16, 1);
        }
    }

    if (out_info != 0) { store64(out_info + 96, max_sfb); }
    return max_sfb;
}

# section_data() + scale_factor_data() for ONE channel, ISO Table 4.44.
fn _aac_parse_sections_sf(br, sect_cb, scale_factors, max_sfb, num_groups,
                          is_short, global_gain) {
    # Section coding. section_data() and scale_factor_data() both run PER WINDOW
    # GROUP, so sect_cb and scale_factors are group-major: index g*num_swb + band.
    # (A long frame is simply the single-group case.)
    var num_swb = _AAC_NUM_SWB;
    var sect_esc = 31;
    var sect_bits_len = 5;
    if (is_short == 1) {
        num_swb = _AAC_NUM_SWB_SHORT;
        sect_esc = 7;
        sect_bits_len = 3;
    }
    if (max_sfb > num_swb) { max_sfb = num_swb; }

    var g = 0;
    while (g < num_groups) {
        var gbase = g * num_swb;
        var band = 0;
        while (band < max_sfb) {
            var cb = _br_read(br, 4);
            if (is_err(cb) == 1) { return cb; }
            var sect_len = 0;
            var sect_bits = _br_read(br, sect_bits_len);
            if (is_err(sect_bits) == 1) { return sect_bits; }
            sect_len = sect_bits;
            while (sect_bits == sect_esc) {
                sect_bits = _br_read(br, sect_bits_len);
                if (is_err(sect_bits) == 1) { return sect_bits; }
                sect_len = sect_len + sect_bits;
            }
            if (sect_len <= 0) { return err(ERR_DECODE); }
            var si = 0;
            while (si < sect_len) {
                if (band + si < num_swb) {
                    store64(sect_cb + (gbase + band + si) * 8, cb);
                }
                si = si + 1;
            }
            band = band + sect_len;
        }
        g = g + 1;
    }

    # scale_factor_data(): three different predictors, per ISO 14496-3 4.6.2.3.
    # Treating every band as an ordinary scalefactor delta desynchronised any
    # stream using PNS or intensity stereo, because the first noise band carries
    # a RAW 9-bit value rather than a Huffman code.
    var prev_scf = global_gain;
    var noise_nrg = global_gain - 90;
    var is_pos = 0;
    var noise_first = 1;
    g = 0;
    while (g < num_groups) {
        var gbase2 = g * num_swb;
        var band2 = 0;
        while (band2 < max_sfb) {
            var cbv = load64(sect_cb + (gbase2 + band2) * 8);
            if (cbv != 0) {
                if (cbv == 13) {
                    # NOISE_HCB (PNS)
                    if (noise_first == 1) {
                        noise_first = 0;
                        var praw = _br_read(br, 9);
                        if (is_err(praw) == 1) { return praw; }
                        noise_nrg = noise_nrg + praw - 256;
                    } else {
                        var nidx = _aac_decode_scf(br);
                        if (is_err(nidx) == 1) { return nidx; }
                        noise_nrg = noise_nrg + nidx - 60;
                    }
                    store64(scale_factors + (gbase2 + band2) * 8, noise_nrg);
                } else {
                    if (cbv >= 14) {
                        # INTENSITY_HCB / INTENSITY_HCB2: own predictor
                        var iidx = _aac_decode_scf(br);
                        if (is_err(iidx) == 1) { return iidx; }
                        is_pos = is_pos + iidx - 60;
                        store64(scale_factors + (gbase2 + band2) * 8, is_pos);
                    } else {
                        var idx = _aac_decode_scf(br);
                        if (is_err(idx) == 1) { return idx; }
                        prev_scf = prev_scf + idx - 60;
                        store64(scale_factors + (gbase2 + band2) * 8, prev_scf);
                    }
                }
            }
            band2 = band2 + 1;
        }
        g = g + 1;
    }
    return max_sfb;
}

# individual_channel_stream() for the non-common-window case: global_gain,
# then ics_info(), then the section/scalefactor data.
fn _aac_parse_ics(br, sect_cb, scale_factors, out_info) {
    # ISO Table 4.44 puts global_gain FIRST, ahead of ics_info().
    var global_gain = _br_read(br, 8);
    if (is_err(global_gain) == 1) { return global_gain; }
    var max_sfb = _aac_parse_ics_info(br, out_info);
    if (is_err(max_sfb) == 1) { return max_sfb; }
    var is_short = 0;
    if (load64(out_info) == 2) { is_short = 1; }
    return _aac_parse_sections_sf(br, sect_cb, scale_factors, max_sfb,
                                  load64(out_info + 8), is_short, global_gain);
}

# is_short selects the scalefactor-band table. A short frame's bands are the
# 14-entry _aac_swb_short table over a 128-coefficient window, not the 49-entry
# long table over 1024 — indexing the long table for a short frame walked the
# wrong coefficient ranges entirely.
# ISO/IEC 14496-3 escape sequence for spectral codebook 11.
#
#   read leading 1 bits until a 0  -> N
#   value = 2^(N+4) + next (N+4) bits
#
# The old code used a fixed 8-bit escape, capping magnitudes at 271 and
# mis-framing every subsequent bit. AAC quantized values reach 8191, which needs
# N up to 9.
fn _aac_read_escape(br) {
    var n = 0;
    var scanning = 1;
    while (scanning == 1) {
        var b = _br_read(br, 1);
        if (is_err(b) == 1) { return b; }
        if (b == 0) { scanning = 0; }
        else {
            n = n + 1;
            # A conforming stream never needs more than 2^(9+4); anything longer
            # is malformed (or a crafted run of 1 bits) and must not spin.
            if (n > 16) { return err(ERR_DECODE); }
        }
    }
    var width = n + 4;
    var v = _br_read(br, width);
    if (is_err(v) == 1) { return v; }
    return (1 << width) + v;
}

# Inverse of _aac_read_escape: emit `val` (>= 16) as ISO escape bits.
fn _aac_write_escape(bw, val) {
    var width = 4;
    while ((1 << (width + 1)) <= val) { width = width + 1; }
    # val now satisfies 2^width <= val < 2^(width+1); N = width - 4 ones, then a 0.
    var n = width - 4;
    var k = 0;
    while (k < n) { _bw_write(bw, 1, 1); k = k + 1; }
    _bw_write(bw, 0, 1);
    _bw_write(bw, val - (1 << width), width);
    return 0;
}

# Decode one scalefactor band's coefficients [bstart, bend) with codebook `cb`,
# writing into quant_spec at `base + i`. `base` is the window offset: 0 for a
# long block, w * AAC_SHORT_SIZE for window w of a short block.
fn _aac_decode_band_range(br, cb, quant_spec, base, bstart, bend) {
    var pair_buf = alloc(16);
    var i = bstart;

    # Codebooks 1-4: 4-tuple codebooks (decode 4 values at a time)
    if (cb >= 1) {
        if (cb <= 4) {
            var quad_buf = alloc(32);
            while (i + 3 < bend) {
                if (_br_bits_left(br) < 2) { i = bend; }
                if (i + 3 < bend) {
                    var rc = _aac_decode_spectral_quad(br, cb, quad_buf);
                    if (is_err(rc) == 1) { i = bend; }
                    if (is_err(rc) == 0) {
                        store64(quant_spec + (base + i) * 8, load64(quad_buf));
                        store64(quant_spec + (base + i + 1) * 8, load64(quad_buf + 8));
                        store64(quant_spec + (base + i + 2) * 8, load64(quad_buf + 16));
                        store64(quant_spec + (base + i + 3) * 8, load64(quad_buf + 24));
                        i = i + 4;
                    }
                }
            }
        }
    }

    # Codebooks 5-8: use Huffman table decoder
    if (cb >= 5) {
        if (cb <= 8) {
            while (i + 1 < bend) {
                if (_br_bits_left(br) < 2) { i = bend; }
                if (i + 1 < bend) {
                    var rc = _aac_decode_spectral_pair(br, cb, pair_buf);
                    if (is_err(rc) == 1) { i = bend; }
                    if (is_err(rc) == 0) {
                        store64(quant_spec + (base + i) * 8, load64(pair_buf));
                        store64(quant_spec + (base + i + 1) * 8, load64(pair_buf + 8));
                        i = i + 2;
                    }
                }
            }
        }
    }

    # Codebooks 9-10: unsigned pairs, values 0..12, sign bits separate
    # Same structure as 7-8 but with 13x13 grid
    if (cb == 9) {
        if (cb <= 10) {
            while (i + 1 < bend) {
                if (_br_bits_left(br) < 2) { i = bend; }
                if (i + 1 < bend) {
                    var rc = _aac_decode_spectral_pair(br, cb, pair_buf);
                    if (is_err(rc) == 1) { i = bend; }
                    if (is_err(rc) == 0) {
                        store64(quant_spec + (base + i) * 8, load64(pair_buf));
                        store64(quant_spec + (base + i + 1) * 8, load64(pair_buf + 8));
                        i = i + 2;
                    }
                }
            }
        }
    }
    if (cb == 10) {
        while (i + 1 < bend) {
            if (_br_bits_left(br) < 2) { i = bend; }
            if (i + 1 < bend) {
                var rc = _aac_decode_spectral_pair(br, cb, pair_buf);
                if (is_err(rc) == 1) { i = bend; }
                if (is_err(rc) == 0) {
                    store64(quant_spec + (base + i) * 8, load64(pair_buf));
                    store64(quant_spec + (base + i + 1) * 8, load64(pair_buf + 8));
                    i = i + 2;
                }
            }
        }
    }

    # Codebook 11: ESC pairs, ISO/IEC 14496-3 Table 4.A.11 — a 289-entry Huffman
    # index over the 17x17 grid, then a sign bit per non-zero value, then a
    # VARIABLE-LENGTH escape for each value coded as 16.
    #
    # shravan used to read a raw 9-bit x*17+y index with a fixed 8-bit escape.
    # That was self-consistent with its own encoder but is not the format, and
    # cb 11 is used heavily by real encoders (352 of 3243 coded bands in a
    # sample ffmpeg file), so no real .aac could be decoded.
    if (cb == 11) {
        _aac_ensure_huff_tables();
        while (i + 1 < bend) {
            if (_br_bits_left(br) < 4) { i = bend; }
            if (i + 1 < bend) {
                var pair_idx = _aac_huff_decode_lut(br, _aac_hcb11_lut,
                                                    _aac_hcb11_sorted, 289);
                if (is_err(pair_idx) == 1) { i = bend; }
                if (is_err(pair_idx) == 0) {
                    var cx = pair_idx / 17;
                    var cy = pair_idx % 17;
                    var qx = cx;
                    var qy = cy;
                    if (cx > 0) {
                        var sx = _br_read(br, 1);
                        if (res_ok(sx) == 1) { if (sx == 1) { qx = 0 - cx; } }
                    }
                    if (cy > 0) {
                        var sy = _br_read(br, 1);
                        if (res_ok(sy) == 1) { if (sy == 1) { qy = 0 - cy; } }
                    }
                    if (cx == 16) {
                        var ax = _aac_read_escape(br);
                        if (is_err(ax) == 1) { i = bend; }
                        if (is_err(ax) == 0) {
                            if (qx < 0) { qx = 0 - ax; } else { qx = ax; }
                        }
                    }
                    if (cy == 16) {
                        var ay = _aac_read_escape(br);
                        if (is_err(ay) == 1) { i = bend; }
                        if (is_err(ay) == 0) {
                            if (qy < 0) { qy = 0 - ay; } else { qy = ay; }
                        }
                    }
                    store64(quant_spec + (base + i) * 8, qx);
                    store64(quant_spec + (base + i + 1) * 8, qy);
                    i = i + 2;
                }
            }
        }
    }

    # Reserved / PNS (13) / INTENSITY (14,15) codebooks are not decoded here;
    # advance the band anyway so a malformed or merely unexpected bitstream can't
    # spin forever (DoS). Codebooks 1-4/5-8/9/10/11 already advanced above — the
    # old code re-incremented 1-4/9/10 here, skipping the following band.
    return 0;
}

# is_short selects both the scalefactor-band table and the window count. A short
# frame carries EIGHT 128-coefficient windows; in the single-group case each
# band's data is stored window-major, so the same band range is decoded once per
# window. Indexing the 49-entry long table over 1024 coefficients for a short
# frame — which is what happened before v2.6.10, since the window sequence was
# parsed and discarded — walked entirely the wrong coefficient ranges.
# group_lens: pointer to 8 window-group lengths (or 0 for a long frame).
#
# spectral_data() is ordered group -> band -> window-within-group, and both
# sect_cb and the band data are group-major. A long frame is the single-group,
# single-window case and falls out of the same loop.
fn _aac_decode_spectral(br, sect_cb, max_sfb, quant_spec, is_short, num_groups, group_lens) {
    var swb = _aac_swb_offset;
    var limit = AAC_FRAME_SIZE;
    var num_swb = _AAC_NUM_SWB;
    if (is_short == 1) {
        swb = _aac_swb_short;
        limit = AAC_SHORT_SIZE;
        num_swb = _AAC_NUM_SWB_SHORT;
    }
    if (num_groups < 1) { num_groups = 1; }

    var win_base = 0;
    var g = 0;
    while (g < num_groups) {
        var glen = 1;
        if (is_short == 1) {
            glen = 1;
            if (group_lens != 0) { glen = load64(group_lens + g * 8); }
            if (glen < 1) { glen = 1; }
        }
        var gbase = g * num_swb;
        var band = 0;
        while (band < max_sfb) {
            var cb = load64(sect_cb + (gbase + band) * 8);
            if (cb != 0) {
                var bstart = load64(swb + band * 8);
                var bend = load64(swb + (band + 1) * 8);
                if (bend > limit) { bend = limit; }
                var w = 0;
                while (w < glen) {
                    if (win_base + w < 8) {
                        _aac_decode_band_range(br, cb, quant_spec,
                                               (win_base + w) * AAC_SHORT_SIZE,
                                               bstart, bend);
                    }
                    w = w + 1;
                }
            }
            band = band + 1;
        }
        win_base = win_base + glen;
        g = g + 1;
    }
    return 0;
}

# Short window synthesis: 8 x MDCT-256 + overlap-add
# num_groups/group_lens map each of the eight windows to its scalefactor group;
# scale_factors is group-major. Applying group 0's gains to all eight windows
# (as this did before) mis-scaled every window outside the first group.
# Inverse quantiser for a SHORT block: eight 128-coefficient windows, with each
# window taking ITS window group's scalefactors.
fn _aac_dequant_short(scale_factors, quant_spec, spec, num_groups, group_lens) {
    var f43 = f64_div(f64_from(4), f64_from(3));
    var f025 = f64_div(F64_ONE, f64_from(4));
    if (num_groups < 1) { num_groups = 1; }
    var band = 0;
    while (band < _AAC_NUM_SWB_SHORT) {
        var bstart = load64(_aac_swb_short + band * 8);
        var bend = load64(_aac_swb_short + (band + 1) * 8);
        var g = 0;
        var w = 0;
        while (w < 8) {
            var glen = 1;
            if (group_lens != 0) { glen = load64(group_lens + g * 8); }
            if (glen < 1) { glen = 1; }
            var scf = load64(scale_factors + (g * _AAC_NUM_SWB_SHORT + band) * 8);
            var step = f64_pow(F64_TWO, f64_mul(f025, f64_sub(f64_from(scf), f64_from(100))));
            var gw = 0;
            while (gw < glen) {
                if (w < 8) {
                    var woff = w * AAC_SHORT_SIZE;
                    var i = bstart;
                    while (i < bend) {
                        var q = load64(quant_spec + (woff + i) * 8);
                        if (q != 0) {
                            var aq = q;
                            if (aq < 0) { aq = 0 - aq; }
                            var val = f64_mul(f64_pow(f64_from(aq), f43), step);
                            if (q < 0) { val = f64_neg(val); }
                            store64(spec + (woff + i) * 8, val);
                        }
                        i = i + 1;
                    }
                }
                w = w + 1;
                gw = gw + 1;
            }
            g = g + 1;
            if (g >= num_groups) { w = 8; }
        }
        band = band + 1;
    }
    return 0;
}

# Synthesis from an ALREADY DEQUANTISED short-block spectrum.
fn _aac_synth_short_spec(spec, overlap, out_samples, shape, prev_shape) {
    _aac_init_norm();
    # Eight 256-point IMDCTs, windowed and overlap-added into a FULL 2048-sample
    # frame. Three things were wrong here before:
    #   * the sub-windows start at sample 448 = (2048 - 8*128 - 128*2)/2 + ...,
    #     i.e. (AAC_FRAME_SIZE - AAC_SHORT_SIZE)/2, not at 0. Placing window w at
    #     w*128 put the whole short block 448 samples early.
    #   * the window shape was hardcoded to sine, ignoring window_shape.
    #   * the second half was discarded (`memset(overlap, 0, ...)`), so the tail
    #     that must overlap the NEXT frame was thrown away, corrupting it too.
    var full = alloc(2048 * 8);
    memset(full, 0, 2048 * 8);
    var base = (AAC_FRAME_SIZE - AAC_SHORT_SIZE) / 2;      # 448

    var wsh_cur  = _aac_window_tbl(1, shape);
    var wsh_prev = _aac_window_tbl(1, prev_shape);

    var w = 0;
    while (w < 8) {
        var mdct_in = spec + w * AAC_SHORT_SIZE * 8;
        var mdct_out = alloc(256 * 8);
        memset(mdct_out, 0, 256 * 8);
        fft_imdct(mdct_in, 256, mdct_out);

        # Rising half of the FIRST short window overlaps the previous frame, so
        # it takes that frame's shape; every other half uses this frame's.
        var w_rise = wsh_cur;
        if (w == 0) { w_rise = wsh_prev; }

        var j = 0;
        while (j < 256) {
            var wv = F64_ZERO;
            if (j < AAC_SHORT_SIZE) { wv = load64(w_rise + j * 8); }
            else { wv = load64(wsh_cur + (255 - j) * 8); }
            store64(mdct_out + j * 8, f64_mul(load64(mdct_out + j * 8), wv));
            j = j + 1;
        }

        var out_off = base + w * AAC_SHORT_SIZE;
        j = 0;
        while (j < 256) {
            var idx = out_off + j;
            if (idx < 2048) {
                store64(full + idx * 8,
                        f64_add(load64(full + idx * 8), load64(mdct_out + j * 8)));
            }
            j = j + 1;
        }
        w = w + 1;
    }

    var i = 0;
    while (i < AAC_FRAME_SIZE) {
        store64(out_samples + i * 8,
                f64_mul(f64_add(load64(overlap + i * 8), load64(full + i * 8)),
                        _AAC_IMDCT_NORM));
        i = i + 1;
    }
    i = 0;
    while (i < AAC_FRAME_SIZE) {
        store64(overlap + i * 8, load64(full + (i + AAC_FRAME_SIZE) * 8));
        i = i + 1;
    }
    return 0;
}

fn _aac_synth_short(scale_factors, quant_spec, overlap, out_samples,
                    num_groups, group_lens, shape, prev_shape) {
    var spec = alloc(AAC_FRAME_SIZE * 8);
    memset(spec, 0, AAC_FRAME_SIZE * 8);
    _aac_dequant_short(scale_factors, quant_spec, spec, num_groups, group_lens);
    return _aac_synth_short_spec(spec, overlap, out_samples, shape, prev_shape);
}

# ISO/IEC 14496-3 defines the synthesis IMDCT with a 2/N normalisation that
# shravan's fft_imdct does not apply, leaving AAC output 2^16 times too large
# relative to the library's [-1, 1] sample convention. That was invisible for
# years because shravan's own encoder omits the reciprocal factor, so its
# round-trip cancelled out — but decoding a real stream came out ~65536x hot and
# clipped. Measured against ffmpeg on a reference file: rms ratio 65535.55.
#
# Applied on synthesis, and inverted on analysis so the round-trip is unchanged.
var _AAC_IMDCT_NORM = 0;      # 1 / 65536
var _AAC_MDCT_DENORM = 0;     # 65536

fn _aac_init_norm() {
    if (_AAC_IMDCT_NORM != 0) { return 0; }
    _AAC_MDCT_DENORM = f64_from(65536);
    _AAC_IMDCT_NORM = f64_div(F64_ONE, _AAC_MDCT_DENORM);
    # peak/rms above this means the band is tonal, not noise: 2.5 sits well
    # above white noise (~sqrt(2)) and well below a single-bin tone (~sqrt(n)).
    _AAC_PNS_MAX_PEAK_RATIO = f64_div(f64_from(5), F64_TWO);
    _AAC_IS_MIN_CORR = f64_div(f64_from(17), f64_from(20));
    return 0;
}

# ================================================================
# Analysis/synthesis windows (ISO/IEC 14496-3 4.6.11.3)
# ================================================================
#
# AAC has TWO window shapes and the bitstream picks per frame via window_shape:
#   0 = sine, 1 = KBD (Kaiser-Bessel Derived, alpha 4 long / 6 short).
# shravan read window_shape and ignored it, always synthesising with the sine
# window. ffmpeg's encoder emits KBD for essentially every frame (23 of 23 in a
# sample tone file), so every such frame was reconstructed with the wrong window.

var _aac_kbd_long = 0;      # 1024 rising-half coefficients
var _aac_kbd_short = 0;     # 128 rising-half coefficients
var _aac_sine_long = 0;
var _aac_sine_short = 0;

# Modified Bessel function of the first kind, order 0.
#   I0(x) = sum_k ((x/2)^k / k!)^2
# The argument stays under pi*6, so the series converges well inside 40 terms.
fn _aac_bessel_i0(x) {
    var half = f64_div(x, F64_TWO);
    var sum = F64_ONE;
    var term = F64_ONE;
    var k = 1;
    while (k < 40) {
        var fk = f64_from(k);
        var r = f64_div(half, fk);
        term = f64_mul(term, f64_mul(r, r));
        sum = f64_add(sum, term);
        k = k + 1;
    }
    return sum;
}

# KBD rising half of length n, with the given alpha.
#   w[i] = sqrt( sum(j<=i) W(j) / sum(j<=n) W(j) ),
#   W(j) = I0( pi*alpha*sqrt(1 - (2j/n - 1)^2) )
fn _aac_build_kbd(n, alpha) {
    var tbl = alloc(n * 8);
    var wj = alloc((n + 1) * 8);
    var pia = f64_mul(F64_PI, f64_from(alpha));
    var total = F64_ZERO;
    var j = 0;
    while (j <= n) {
        var t = f64_sub(f64_div(f64_mul(F64_TWO, f64_from(j)), f64_from(n)), F64_ONE);
        var inner = f64_sub(F64_ONE, f64_mul(t, t));
        if (f64_lt(inner, F64_ZERO) == 1) { inner = F64_ZERO; }
        var v = _aac_bessel_i0(f64_mul(pia, f64_sqrt(inner)));
        store64(wj + j * 8, v);
        total = f64_add(total, v);
        j = j + 1;
    }
    var run = F64_ZERO;
    var i = 0;
    while (i < n) {
        run = f64_add(run, load64(wj + i * 8));
        store64(tbl + i * 8, f64_sqrt(f64_div(run, total)));
        i = i + 1;
    }
    return tbl;
}

fn _aac_build_sine(n) {
    var tbl = alloc(n * 8);
    var i = 0;
    while (i < n) {
        var angle = f64_div(f64_mul(F64_PI, f64_add(f64_from(i), F64_HALF)),
                            f64_from(2 * n));
        store64(tbl + i * 8, f64_sin(angle));
        i = i + 1;
    }
    return tbl;
}

fn _aac_init_windows() {
    if (_aac_kbd_long != 0) { return 0; }
    _aac_kbd_long   = _aac_build_kbd(AAC_FRAME_SIZE, 4);
    _aac_kbd_short  = _aac_build_kbd(AAC_SHORT_SIZE, 6);
    _aac_sine_long  = _aac_build_sine(AAC_FRAME_SIZE);
    _aac_sine_short = _aac_build_sine(AAC_SHORT_SIZE);
    return 0;
}

# Rising-half window table for the requested length and shape.
fn _aac_window_tbl(is_short, shape) {
    _aac_init_windows();
    if (is_short == 1) {
        if (shape == 1) { return _aac_kbd_short; }
        return _aac_sine_short;
    }
    if (shape == 1) { return _aac_kbd_long; }
    return _aac_sine_long;
}

# shape: window_shape of THIS frame; prev_shape: of the previous one.
#
# The 2048-point IMDCT output is windowed asymmetrically: its first half overlaps
# the previous frame and therefore uses the PREVIOUS frame's shape, while its
# second half uses this frame's. The falling half is the mirror of the rising
# half, so one table serves both.
# win_seq selects the window FORM (ISO 14496-3 Figure 4.10):
#   ONLY_LONG(0)  long rising            | long falling
#   LONG_START(1) long rising            | 1.0 x448, short falling x128, 0 x448
#   LONG_STOP(3)  0 x448, short rising x128, 1.0 x448 | long falling
# Treating 1 and 3 as ONLY_LONG leaves the transition frames windowed wrongly,
# so the overlap-add does not reconstruct and every transient smears.
# ================================================================
# Stereo tools and noise substitution (ISO/IEC 14496-3 4.6.8, 4.6.2)
# ================================================================
#
# All three operate on SPECTRAL coefficients, per scalefactor band and window
# group, between dequantisation and the IMDCT.

var _aac_pns_state = 1;

# xorshift PRNG for perceptual noise substitution. The standard does not fix the
# generator — only that the band is filled with noise of the coded energy — so
# any decent source is conformant. Deterministic here so decodes are repeatable.
fn _aac_pns_rand() {
    var x = _aac_pns_state;
    x = x ^ ((x << 13) & 0xFFFFFFFFFFFFFFFF);
    x = x ^ (x >> 7);
    x = x ^ ((x << 17) & 0xFFFFFFFFFFFFFFFF);
    if (x == 0) { x = 88172645463325252; }
    _aac_pns_state = x;
    return x;
}

# Fill [bstart, bend) at `base` with noise, then scale it to the energy the
# stream coded in the band's (noise) scalefactor.
fn _aac_pns_fill(spec, base, bstart, bend, scf) {
    var n = bend - bstart;
    if (n <= 0) { return 0; }
    var energy = F64_ZERO;
    var i = bstart;
    while (i < bend) {
        # uniform in [-1, 1) from the top bits
        var r = (_aac_pns_rand() >> 20) & 0x1FFFFF;
        var v = f64_sub(f64_div(f64_from(r), f64_from(1048576)), F64_ONE);
        store64(spec + (base + i) * 8, v);
        energy = f64_add(energy, f64_mul(v, v));
        i = i + 1;
    }
    if (f64_gt(energy, F64_ZERO) == 0) { return 0; }
    # Target RMS PER COEFFICIENT is 2^(nrg/4) / 2, where nrg is the noise energy
    # accumulated in scale_factor_data() (global_gain - 90, then the first noise
    # band's raw 9-bit value less 256, then Huffman deltas).
    #
    # Measured against a reference decoder rather than assumed: recovering the
    # spectral coefficients of PNS-only frames gave a ratio to 2^((nrg-100)/4)
    # of exactly 0.5, constant across global_gain 150/160/170 and band counts
    # 4/8/16 — i.e. the -100 offset does not apply here (the -90 noise offset
    # already carries it) and there is a further factor of two.
    var target = f64_pow(F64_TWO, f64_sub(f64_mul(f64_div(F64_ONE, f64_from(4)),
                                                  f64_from(scf)), F64_ONE));
    var gain = f64_mul(target, f64_div(f64_sqrt(f64_from(n)), f64_sqrt(energy)));
    i = bstart;
    while (i < bend) {
        store64(spec + (base + i) * 8,
                f64_mul(load64(spec + (base + i) * 8), gain));
        i = i + 1;
    }
    return 0;
}

# Should this band be coded as noise (PNS) rather than transmitted?
#
# Two conditions, both conservative:
#   * the band starts above _AAC_PNS_MIN_BIN — noise substitution below a few
#     kHz is audible, and encoders confine it to the high end;
#   * the band is NOISE-LIKE, measured as peak/rms. A tone concentrates its
#     energy in one bin and has a high ratio; noise spreads it and sits near
#     sqrt(2). Substituting a tonal band would be plainly audible.
#
# Returns the noise energy to code (>= 0), or -1 to leave the band alone.
var _AAC_PNS_MIN_BIN = 279;
# Intensity stereo, like PNS, belongs at the high end: discarding the right
# channel's phase is inaudible there and plainly audible lower down.
var _AAC_IS_MIN_BIN = 279;          # ~6 kHz at 44.1 kHz
var _AAC_IS_MIN_CORR = 0;           # set in _aac_init_norm (0.85)          # ~2 kHz at 44.1 kHz with 1024 bins
var _AAC_PNS_MAX_PEAK_RATIO = 0;    # set in _aac_init_norm (2.5)

fn _aac_pns_should_use(spec, bstart, bend) {
    if (bstart < _AAC_PNS_MIN_BIN) { return 0 - 1; }
    var n = bend - bstart;
    if (n < 4) { return 0 - 1; }
    var peak = F64_ZERO;
    var ss = F64_ZERO;
    var i = bstart;
    while (i < bend) {
        var v = f64_abs(load64(spec + i * 8));
        if (f64_gt(v, peak) == 1) { peak = v; }
        ss = f64_add(ss, f64_mul(v, v));
        i = i + 1;
    }
    if (f64_gt(ss, F64_ZERO) == 0) { return 0 - 1; }
    var rms = f64_sqrt(f64_div(ss, f64_from(n)));
    if (f64_gt(rms, F64_ZERO) == 0) { return 0 - 1; }
    if (f64_gt(f64_div(peak, rms), _AAC_PNS_MAX_PEAK_RATIO) == 1) { return 0 - 1; }

    # Invert the decoder's rule (rms per coefficient = 2^(nrg/4)/2):
    #   nrg = 4 * (log2(rms) + 1)
    var nrg = f64_to(f64_mul(f64_from(4), f64_add(f64_log2(rms), F64_ONE)));
    if (nrg < 0) { nrg = 0; }
    if (nrg > 255) { nrg = 255; }
    return nrg;
}

# M/S: left = mid + side, right = mid - side, for the bands the mask selects.
fn _aac_apply_ms(spec_l, spec_r, base, bstart, bend) {
    var i = bstart;
    while (i < bend) {
        var m = load64(spec_l + (base + i) * 8);
        var sd = load64(spec_r + (base + i) * 8);
        store64(spec_l + (base + i) * 8, f64_add(m, sd));
        store64(spec_r + (base + i) * 8, f64_sub(m, sd));
        i = i + 1;
    }
    return 0;
}

# Intensity stereo: the right channel's band is not coded at all — it is derived
# from the left, scaled by 0.5^(is_position/4). INTENSITY_HCB (15) is in phase,
# INTENSITY_HCB2 (14) is out of phase, and an M/S flag on the same band inverts
# the sense again.
fn _aac_apply_intensity(spec_l, spec_r, base, bstart, bend, is_pos, cb, ms_used) {
    var scale = f64_pow(F64_HALF, f64_mul(f64_div(F64_ONE, f64_from(4)),
                                          f64_from(is_pos)));
    var neg = 0;
    if (cb == 14) { neg = 1; }
    if (ms_used == 1) { neg = 1 - neg; }
    if (neg == 1) { scale = f64_neg(scale); }
    var i = bstart;
    while (i < bend) {
        store64(spec_r + (base + i) * 8,
                f64_mul(load64(spec_l + (base + i) * 8), scale));
        i = i + 1;
    }
    return 0;
}

# Inverse quantiser for a LONG block: x = sign(q)*|q|^(4/3) * 2^((sf-100)/4).
# Split out of the synthesis so the stereo tools (M/S, intensity) and PNS can
# operate on the spectral coefficients, which is where the format defines them —
# applying M/S to the time-domain output only happens to work when EVERY band is
# M/S coded, and is simply wrong for a per-band mask.
fn _aac_dequant_long(scale_factors, quant_spec, spec) {
    var f43 = f64_div(f64_from(4), f64_from(3));
    var f025 = f64_div(F64_ONE, f64_from(4));
    var band = 0;
    while (band < _AAC_NUM_SWB) {
        var bstart = load64(_aac_swb_offset + band * 8);
        var bend = load64(_aac_swb_offset + (band + 1) * 8);
        var scf = load64(scale_factors + band * 8);
        var step = f64_pow(F64_TWO, f64_mul(f025, f64_sub(f64_from(scf), f64_from(100))));
        var i = bstart;
        while (i < bend) {
            var q = load64(quant_spec + i * 8);
            if (q != 0) {
                var aq = q;
                if (aq < 0) { aq = 0 - aq; }
                var val = f64_mul(f64_pow(f64_from(aq), f43), step);
                if (q < 0) { val = f64_neg(val); }
                store64(spec + i * 8, val);
            }
            i = i + 1;
        }
        band = band + 1;
    }
    return 0;
}

# Synthesis from an ALREADY DEQUANTISED long-block spectrum.
fn _aac_synth_spec(spec, overlap, out_samples, tns_st, shape, prev_shape, win_seq) {
    # TNS synthesis (all-pole IIR) on the dequantized spectrum before the IMDCT.
    _tns_synth_apply(spec, tns_st);

    var mdct_out = alloc(2048 * 8);
    memset(mdct_out, 0, 2048 * 8);
    fft_imdct(spec, 2048, mdct_out);

    var w_prev  = _aac_window_tbl(0, prev_shape);
    var w_cur   = _aac_window_tbl(0, shape);
    var ws_prev = _aac_window_tbl(1, prev_shape);
    var ws_cur  = _aac_window_tbl(1, shape);
    # 448 = (1024 - 128) / 2: the flat run either side of the short segment.
    var flat = (AAC_FRAME_SIZE - AAC_SHORT_SIZE) / 2;

    var i = 0;
    while (i < AAC_FRAME_SIZE) {
        var wv = load64(w_prev + i * 8);
        if (win_seq == 3) {
            if (i < flat) { wv = F64_ZERO; }
            else {
                if (i < flat + AAC_SHORT_SIZE) { wv = load64(ws_prev + (i - flat) * 8); }
                else { wv = F64_ONE; }
            }
        }
        store64(mdct_out + i * 8, f64_mul(load64(mdct_out + i * 8), wv));
        i = i + 1;
    }
    while (i < 2048) {
        var p = i - AAC_FRAME_SIZE;
        var wv2 = load64(w_cur + (AAC_FRAME_SIZE - 1 - p) * 8);
        if (win_seq == 1) {
            if (p < flat) { wv2 = F64_ONE; }
            else {
                if (p < flat + AAC_SHORT_SIZE) {
                    wv2 = load64(ws_cur + (AAC_SHORT_SIZE - 1 - (p - flat)) * 8);
                } else { wv2 = F64_ZERO; }
            }
        }
        store64(mdct_out + i * 8, f64_mul(load64(mdct_out + i * 8), wv2));
        i = i + 1;
    }

    _aac_init_norm();
    i = 0;
    while (i < AAC_FRAME_SIZE) {
        store64(out_samples + i * 8,
                f64_mul(f64_add(load64(overlap + i * 8), load64(mdct_out + i * 8)),
                        _AAC_IMDCT_NORM));
        i = i + 1;
    }
    i = 0;
    while (i < AAC_FRAME_SIZE) {
        store64(overlap + i * 8, load64(mdct_out + (i + AAC_FRAME_SIZE) * 8));
        i = i + 1;
    }
    return 0;
}

fn _aac_synth_shaped(scale_factors, quant_spec, overlap, out_samples, tns_st,
                     shape, prev_shape, win_seq) {
    var spec = alloc(AAC_FRAME_SIZE * 8);
    memset(spec, 0, AAC_FRAME_SIZE * 8);
    _aac_dequant_long(scale_factors, quant_spec, spec);
    return _aac_synth_spec(spec, overlap, out_samples, tns_st,
                           shape, prev_shape, win_seq);
}

# Backwards-compatible wrapper: sine window on both halves (shravan's own
# encoder emits window_shape = 0).
fn _aac_synth(scale_factors, quant_spec, overlap, out_samples, tns_st) {
    return _aac_synth_shaped(scale_factors, quant_spec, overlap, out_samples,
                             tns_st, 0, 0, 0);
}

# Decode a single channel element (SCE) or channel pair element (CPE).
# out_samples: pointer to 1024 * num_channels f64 values (interleaved for CPE)
# overlap: pointer to 1024 * num_channels f64 overlap buffer
# Returns number of channels decoded (1 or 2), or err.
# Skip a fill_element() (ID_FIL). Its payload length is a 4-bit count, escaped
# through 15 to an extra 8 bits; the payload itself is that many bytes.
fn _aac_skip_fil(br) {
    var cnt = _br_read(br, 4);
    if (is_err(cnt) == 1) { return cnt; }
    if (cnt == 15) {
        var esc = _br_read(br, 8);
        if (is_err(esc) == 1) { return esc; }
        cnt = cnt + esc - 1;
    }
    var i = 0;
    while (i < cnt) {
        var b = _br_read(br, 8);
        if (is_err(b) == 1) { return b; }
        i = i + 1;
    }
    return 0;
}

# Skip a data_stream_element() (ID_DSE).
fn _aac_skip_dse(br) {
    var tag = _br_read(br, 4);
    if (is_err(tag) == 1) { return tag; }
    var align = _br_read(br, 1);
    if (is_err(align) == 1) { return align; }
    var cnt = _br_read(br, 8);
    if (is_err(cnt) == 1) { return cnt; }
    if (cnt == 255) {
        var extra = _br_read(br, 8);
        if (is_err(extra) == 1) { return extra; }
        cnt = cnt + extra;
    }
    if (align == 1) { _br_byte_align(br); }
    var i = 0;
    while (i < cnt) {
        var b = _br_read(br, 8);
        if (is_err(b) == 1) { return b; }
        i = i + 1;
    }
    return 0;
}

fn _aac_decode_frame(fdata, flen, overlap, out_samples) {
    if (_aac_swb_offset == 0) { _aac_init_swb(); }
    var br = _br_new(fdata, flen);

    var elem_id = _br_read(br, 3);
    if (is_err(elem_id) == 1) { return elem_id; }

    # A raw_data_block may carry several elements. Real encoders routinely put a
    # fill element (ID_FIL, 6) or a data stream element (ID_DSE, 4) before the
    # audio element — ffmpeg's very first frame is FIL-only. shravan read exactly
    # ONE element and failed on anything that was not SCE/CPE/END, so those
    # frames were dropped. Skip them and carry on to the audio element.
    var guard = 0;
    while (guard < 16) {
        if (elem_id == 6) {
            var rf = _aac_skip_fil(br);
            if (is_err(rf) == 1) { return rf; }
        } else {
            if (elem_id == 4) {
                var rd = _aac_skip_dse(br);
                if (is_err(rd) == 1) { return rd; }
            } else {
                guard = 16;
            }
        }
        if (guard < 16) {
            elem_id = _br_read(br, 3);
            if (is_err(elem_id) == 1) { return elem_id; }
            guard = guard + 1;
        }
    }

    # ID_END = 7: silence frame
    if (elem_id == 7) {
        var i = 0;
        while (i < AAC_FRAME_SIZE) {
            store64(out_samples + i * 8, load64(overlap + i * 8));
            store64(overlap + i * 8, F64_ZERO);
            i = i + 1;
        }
        return 1;
    }

    # ID_SCE = 0: single channel
    if (elem_id == 0) {
        var instance = _br_read(br, 4);
        if (is_err(instance) == 1) { return instance; }

        # Room for 8 window groups: section and scalefactor data are group-major.
        var sect_cb = alloc(8 * _AAC_NUM_SWB * 8);
        memset(sect_cb, 0, 8 * _AAC_NUM_SWB * 8);
        var scale_factors = alloc(8 * _AAC_NUM_SWB * 8);
        memset(scale_factors, 0, 8 * _AAC_NUM_SWB * 8);

        # 128 bytes: window_seq(+0), num_groups(+8), group lengths(+16..+79),
        # window_shape(+88), max_sfb(+96). A 96-byte buffer overflowed on the
        # last field.
        var ics_info = alloc(128);
        memset(ics_info, 0, 128);
        var max_sfb = _aac_parse_ics(br, sect_cb, scale_factors, ics_info);
        if (is_err(max_sfb) == 1) { return max_sfb; }
        var is_short = 0;
        if (load64(ics_info) == 2) { is_short = 1; }

        # ICS extension (pulse/tns/gain) follows scale_factor_data — SCE only.
        # tns_data()'s field widths differ between long and short windows
        # (n_filt 2/6/5 bits vs 1/4/3, and eight windows instead of one), so
        # passing a hardcoded 0 here read a short frame's TNS with long-window
        # widths and desynchronised the rest of the frame.
        var tns_st = alloc(TNS_ST_SIZE);
        memset(tns_st, 0, TNS_ST_SIZE);
        var text = _aac_parse_ics_ext(br, is_short, max_sfb, tns_st);
        if (is_err(text) == 1) { return text; }

        var quant_spec = alloc(AAC_FRAME_SIZE * 8);
        memset(quant_spec, 0, AAC_FRAME_SIZE * 8);
        var n_groups = load64(ics_info + 8);
        _aac_decode_spectral(br, sect_cb, max_sfb, quant_spec, is_short,
                             n_groups, ics_info + 16);

        # window_shape is per frame, and the IMDCT's first half overlaps the
        # PREVIOUS frame — so its shape is needed too. Carry it in the slot just
        # past the two overlap channels.
        var shape_slot = overlap + AAC_FRAME_SIZE * 2 * 8;
        var cur_shape = load64(ics_info + 88);
        var prev_shape = load64(shape_slot);
        store64(shape_slot, cur_shape);

        # Dequantise, then substitute noise for any PNS band, then synthesise.
        # PNS bands carry no spectrum at all — only a coded energy — so without
        # this they decoded as silence.
        var spec_m = alloc(AAC_FRAME_SIZE * 8);
        memset(spec_m, 0, AAC_FRAME_SIZE * 8);
        if (is_short == 1) {
            _aac_dequant_short(scale_factors, quant_spec, spec_m, n_groups, ics_info + 16);
        } else {
            _aac_dequant_long(scale_factors, quant_spec, spec_m);
        }

        var swb_m = _aac_swb_offset;
        var swbn_m = _AAC_NUM_SWB;
        if (is_short == 1) { swb_m = _aac_swb_short; swbn_m = _AAC_NUM_SWB_SHORT; }
        var wb_m = 0;
        var gm = 0;
        while (gm < n_groups) {
            var glm = 1;
            if (is_short == 1) {
                glm = load64(ics_info + 16 + gm * 8);
                if (glm < 1) { glm = 1; }
            }
            var bm = 0;
            while (bm < max_sfb) {
                if (load64(sect_cb + (gm * swbn_m + bm) * 8) == 13) {
                    var bs_m = load64(swb_m + bm * 8);
                    var be_m = load64(swb_m + (bm + 1) * 8);
                    var wm = 0;
                    while (wm < glm) {
                        var base_m = (wb_m + wm) * AAC_SHORT_SIZE;
                        if (is_short == 0) { base_m = 0; }
                        _aac_pns_fill(spec_m, base_m, bs_m, be_m,
                                      load64(scale_factors + (gm * swbn_m + bm) * 8));
                        wm = wm + 1;
                    }
                }
                bm = bm + 1;
            }
            wb_m = wb_m + glm;
            gm = gm + 1;
        }

        if (is_short == 1) {
            var rcs = _aac_synth_short_spec(spec_m, overlap, out_samples,
                                            cur_shape, prev_shape);
            if (is_err(rcs) == 1) { return rcs; }
            return 1;
        }
        var rc = _aac_synth_spec(spec_m, overlap, out_samples,
                                 tns_st, cur_shape, prev_shape, load64(ics_info));
        if (is_err(rc) == 1) { return rc; }
        return 1;
    }

    # ID_CPE = 1: channel pair element (ISO/IEC 14496-3 Table 4.5)
    #
    #   element_instance_tag                  4
    #   common_window                         1
    #   if (common_window) { ics_info(); ms_mask_present 2; [mask bits] }
    #   individual_channel_stream(common_window, 0)   x2
    #
    # The old implementation re-implemented ics_info() inline, read each
    # channel's global_gain AFTER its section data, never read the per-channel
    # pulse/tns/gain flags at all (so spectral_data() started three bits early),
    # refused short windows outright, and applied M/S to the TIME-domain output.
    # It now shares the same helpers as the SCE path.
    if (elem_id == 1) {
        var instance = _br_read(br, 4);
        if (is_err(instance) == 1) { return instance; }
        var common_window = _br_read(br, 1);
        if (is_err(common_window) == 1) { return common_window; }

        var info0 = alloc(128); memset(info0, 0, 128);
        var info1 = alloc(128); memset(info1, 0, 128);
        var ms_mask_present = 0;
        # Mask is per (group, band): 8 groups x the long band count is plenty.
        var ms_mask = alloc(8 * _AAC_NUM_SWB * 8);
        memset(ms_mask, 0, 8 * _AAC_NUM_SWB * 8);

        var shared_max_sfb = 0;
        var is_short = 0;
        var n_groups = 1;
        if (common_window == 1) {
            shared_max_sfb = _aac_parse_ics_info(br, info0);
            if (is_err(shared_max_sfb) == 1) { return shared_max_sfb; }
            if (load64(info0) == 2) { is_short = 1; }
            n_groups = load64(info0 + 8);
            if (shared_max_sfb > _AAC_NUM_SWB) { shared_max_sfb = _AAC_NUM_SWB; }

            ms_mask_present = _br_read(br, 2);
            if (is_err(ms_mask_present) == 1) { return ms_mask_present; }
            if (ms_mask_present == 1) {
                var swb_n = _AAC_NUM_SWB;
                if (is_short == 1) { swb_n = _AAC_NUM_SWB_SHORT; }
                var g = 0;
                while (g < n_groups) {
                    var b = 0;
                    while (b < shared_max_sfb) {
                        var mb = _br_read(br, 1);
                        if (is_err(mb) == 1) { return mb; }
                        store64(ms_mask + (g * swb_n + b) * 8, mb);
                        b = b + 1;
                    }
                    g = g + 1;
                }
            }
            # The shared ics_info applies to both channels.
            var ci = 0;
            while (ci < 128) { store8(info1 + ci, load8(info0 + ci)); ci = ci + 1; }
        }

        var sect_cb0 = alloc(8 * _AAC_NUM_SWB * 8); memset(sect_cb0, 0, 8 * _AAC_NUM_SWB * 8);
        var sf0 = alloc(8 * _AAC_NUM_SWB * 8);      memset(sf0, 0, 8 * _AAC_NUM_SWB * 8);
        var sect_cb1 = alloc(8 * _AAC_NUM_SWB * 8); memset(sect_cb1, 0, 8 * _AAC_NUM_SWB * 8);
        var sf1 = alloc(8 * _AAC_NUM_SWB * 8);      memset(sf1, 0, 8 * _AAC_NUM_SWB * 8);
        var tns0 = alloc(TNS_ST_SIZE); memset(tns0, 0, TNS_ST_SIZE);
        var tns1 = alloc(TNS_ST_SIZE); memset(tns1, 0, TNS_ST_SIZE);
        var qs0 = alloc(AAC_FRAME_SIZE * 8); memset(qs0, 0, AAC_FRAME_SIZE * 8);
        var qs1 = alloc(AAC_FRAME_SIZE * 8); memset(qs1, 0, AAC_FRAME_SIZE * 8);

        # --- channel 0: individual_channel_stream(common_window, 0) ---
        var gg0 = _br_read(br, 8);
        if (is_err(gg0) == 1) { return gg0; }
        var msfb0 = shared_max_sfb;
        if (common_window == 0) {
            msfb0 = _aac_parse_ics_info(br, info0);
            if (is_err(msfb0) == 1) { return msfb0; }
            if (load64(info0) == 2) { is_short = 1; }
            n_groups = load64(info0 + 8);
        }
        var r0 = _aac_parse_sections_sf(br, sect_cb0, sf0, msfb0, n_groups, is_short, gg0);
        if (is_err(r0) == 1) { return r0; }
        var x0 = _aac_parse_ics_ext(br, is_short, msfb0, tns0);
        if (is_err(x0) == 1) { return x0; }
        _aac_decode_spectral(br, sect_cb0, msfb0, qs0, is_short, n_groups, info0 + 16);

        # --- channel 1 ---
        var gg1 = _br_read(br, 8);
        if (is_err(gg1) == 1) { return gg1; }
        var msfb1 = shared_max_sfb;
        var is_short1 = is_short;
        var n_groups1 = n_groups;
        if (common_window == 0) {
            msfb1 = _aac_parse_ics_info(br, info1);
            if (is_err(msfb1) == 1) { return msfb1; }
            is_short1 = 0;
            if (load64(info1) == 2) { is_short1 = 1; }
            n_groups1 = load64(info1 + 8);
        }
        var r1 = _aac_parse_sections_sf(br, sect_cb1, sf1, msfb1, n_groups1, is_short1, gg1);
        if (is_err(r1) == 1) { return r1; }
        var x1 = _aac_parse_ics_ext(br, is_short1, msfb1, tns1);
        if (is_err(x1) == 1) { return x1; }
        _aac_decode_spectral(br, sect_cb1, msfb1, qs1, is_short1, n_groups1, info1 + 16);

        # --- dequantise, then run the stereo tools in the SPECTRAL domain ---
        var spec0 = alloc(AAC_FRAME_SIZE * 8); memset(spec0, 0, AAC_FRAME_SIZE * 8);
        var spec1 = alloc(AAC_FRAME_SIZE * 8); memset(spec1, 0, AAC_FRAME_SIZE * 8);
        if (is_short == 1) { _aac_dequant_short(sf0, qs0, spec0, n_groups, info0 + 16); }
        else { _aac_dequant_long(sf0, qs0, spec0); }
        if (is_short1 == 1) { _aac_dequant_short(sf1, qs1, spec1, n_groups1, info1 + 16); }
        else { _aac_dequant_long(sf1, qs1, spec1); }

        var swb_tbl = _aac_swb_offset;
        var swb_cnt = _AAC_NUM_SWB;
        var nwin = 1;
        if (is_short == 1) { swb_tbl = _aac_swb_short; swb_cnt = _AAC_NUM_SWB_SHORT; nwin = 8; }

        var wbase = 0;
        var gi2 = 0;
        while (gi2 < n_groups) {
            var glen2 = 1;
            if (is_short == 1) { glen2 = load64(info0 + 16 + gi2 * 8); if (glen2 < 1) { glen2 = 1; } }
            var bnd = 0;
            while (bnd < msfb0) {
                var bs = load64(swb_tbl + bnd * 8);
                var be = load64(swb_tbl + (bnd + 1) * 8);
                var cb_l = load64(sect_cb0 + (gi2 * swb_cnt + bnd) * 8);
                var cb_r = load64(sect_cb1 + (gi2 * swb_cnt + bnd) * 8);
                var msu = 0;
                if (ms_mask_present == 2) { msu = 1; }
                if (ms_mask_present == 1) { msu = load64(ms_mask + (gi2 * swb_cnt + bnd) * 8); }

                var ww = 0;
                while (ww < glen2) {
                    var wb = (wbase + ww) * AAC_SHORT_SIZE;
                    if (is_short == 0) { wb = 0; }
                    # PNS: a noise band carries no spectrum, only an energy.
                    if (cb_l == 13) {
                        _aac_pns_fill(spec0, wb, bs, be,
                                      load64(sf0 + (gi2 * swb_cnt + bnd) * 8));
                    }
                    if (cb_r == 13) {
                        _aac_pns_fill(spec1, wb, bs, be,
                                      load64(sf1 + (gi2 * swb_cnt + bnd) * 8));
                    }
                    # Intensity: the right band is derived from the left.
                    if (cb_r >= 14) {
                        if (cb_r <= 15) {
                            _aac_apply_intensity(spec0, spec1, wb, bs, be,
                                                 load64(sf1 + (gi2 * swb_cnt + bnd) * 8),
                                                 cb_r, msu);
                        }
                    } else {
                        if (msu == 1) { _aac_apply_ms(spec0, spec1, wb, bs, be); }
                    }
                    ww = ww + 1;
                }
                bnd = bnd + 1;
            }
            wbase = wbase + glen2;
            gi2 = gi2 + 1;
        }

        var overlap_l = overlap;
        var overlap_r = overlap + AAC_FRAME_SIZE * 8;
        var out_l = alloc(AAC_FRAME_SIZE * 8);
        var out_r = alloc(AAC_FRAME_SIZE * 8);

        var shape_slot2 = overlap + AAC_FRAME_SIZE * 2 * 8;
        var cur_shape2 = load64(info0 + 88);
        var prev_shape2 = load64(shape_slot2);
        store64(shape_slot2, cur_shape2);

        if (is_short == 1) {
            _aac_synth_short_spec(spec0, overlap_l, out_l, cur_shape2, prev_shape2);
        } else {
            _aac_synth_spec(spec0, overlap_l, out_l, tns0, cur_shape2, prev_shape2,
                            load64(info0));
        }
        if (is_short1 == 1) {
            _aac_synth_short_spec(spec1, overlap_r, out_r, cur_shape2, prev_shape2);
        } else {
            _aac_synth_spec(spec1, overlap_r, out_r, tns1, cur_shape2, prev_shape2,
                            load64(info1));
        }

        var i = 0;
        while (i < AAC_FRAME_SIZE) {
            store64(out_samples + (i * 2) * 8, load64(out_l + i * 8));
            store64(out_samples + (i * 2 + 1) * 8, load64(out_r + i * 8));
            i = i + 1;
        }
        return 2;
    }

    # Other element types not supported
    return err(ERR_DECODE);
}

# ================================================================
# AAC-LC Decoder (ADTS input -> audio samples)
# ================================================================
#
# aac_decode(data, len)
#   Parses ADTS frames and returns format info.
#   Actual audio decoding returns ERR_UNSUPPORTED_FMT.

fn aac_decode(data, len) {
    if (_aac_sample_rates == 0) { aac_init(); }

    if (len < 7) { return err(ERR_INVALID_HEADER); }

    # Find first valid ADTS frame
    var pos = 0;
    var first_header = 0;
    var frame_count = 0;
    var total_payload = 0;

    while (pos + 7 <= len) {
        # Check sync word
        if (load8(data + pos) != 0xFF) {
            pos = pos + 1;
            continue;
        }
        if ((load8(data + pos + 1) & 0xF0) != 0xF0) {
            pos = pos + 1;
            continue;
        }

        var header = aac_parse_adts_header(data + pos, len - pos);
        if (is_err(header) == 1) {
            pos = pos + 1;
            continue;
        }

        var frame_length = aac_adts_frame_length(header);
        if (pos + frame_length > len) { break; }  # truncated

        if (first_header == 0) {
            first_header = header;
        }

        # Determine header size (7 without CRC, 9 with CRC)
        var protection_absent = (load8(data + pos + 1) & 0x01);
        var hdr_size = 7;
        if (protection_absent == 0) { hdr_size = 9; }

        if (frame_length > hdr_size) {
            total_payload = total_payload + (frame_length - hdr_size);
        }

        frame_count = frame_count + 1;
        # SEC-011: cap frame count to prevent unbounded allocation
        if (frame_count > 65536) { break; }
        pos = pos + frame_length;
    }

    if (first_header == 0) { return err(ERR_INVALID_HEADER); }

    var sr = aac_adts_sample_rate(first_header);
    var ch = aac_adts_channels(first_header);

    # Second pass: decode frames
    var all_samples = vec_new();
    # Overlap buffer: 1024 * max_channels (2 for stereo)
    # +16 bytes past the two overlap channels: the previous frame's window_shape
    # (and room for future per-stream synthesis state).
    var overlap = alloc(AAC_FRAME_SIZE * 2 * 8 + 16);
    memset(overlap, 0, AAC_FRAME_SIZE * 2 * 8 + 16);
    # Frame buffer: 1024 * max_channels interleaved
    var frame_buf = alloc(AAC_FRAME_SIZE * 2 * 8);

    pos = 0;
    while (pos + 7 <= len) {
        if (load8(data + pos) != 0xFF) { pos = pos + 1; continue; }
        if ((load8(data + pos + 1) & 0xF0) != 0xF0) { pos = pos + 1; continue; }
        var hdr2 = aac_parse_adts_header(data + pos, len - pos);
        if (is_err(hdr2) == 1) { pos = pos + 1; continue; }
        var fl2 = aac_adts_frame_length(hdr2);
        if (pos + fl2 > len) { break; }
        var pa2 = (load8(data + pos + 1) & 0x01);
        var hs2 = 7;
        if (pa2 == 0) { hs2 = 9; }
        var plen = fl2 - hs2;
        if (plen > 0) {
            var rc = _aac_decode_frame(data + pos + hs2, plen, overlap, frame_buf);
            if (res_ok(rc) == 1) {
                # rc = number of channels decoded (1 or 2)
                var frame_samples = AAC_FRAME_SIZE * rc;
                # SEC-027: SEC-011 caps the FIRST pass (which only counts), but
                # this second pass is the one that allocates and had no bound.
                # A minimal 8-byte ADTS frame yields AAC_FRAME_SIZE (1024)
                # samples, so a file of repeated 8-byte frames amplified ~1024x:
                # a 560 KB input reached ~2.15 GB. Same 2^25-sample ceiling as
                # FLAC's SEC-023 (256 MB of f64 payload).
                if (vec_len(all_samples) + frame_samples > 33554432) {
                    return err(ERR_DECODE);
                }
                var i = 0;
                while (i < frame_samples) {
                    vec_push(all_samples, load64(frame_buf + i * 8));
                    i = i + 1;
                }
            }
        }
        pos = pos + fl2;
    }

    var total_decoded = vec_len(all_samples);
    var total_frames = total_decoded / ch;
    var dur = F64_ZERO;
    if (sr > 0) { dur = f64_div(f64_from(total_frames), f64_from(sr)); }

    var fi = fmtinfo_new(FMT_AAC, sr, ch, 16, dur, total_frames);
    return decode_result_new(fi, all_samples);
}

# ================================================================
# Tests
# ================================================================

fn test_aac_adts_parse_valid() {
    test_group("aac: parse valid ADTS header");

    if (_aac_sample_rates == 0) { aac_init(); }

    # Build a known ADTS header: LC, 44100, stereo, frame_length=100
    var buf = alloc(7);
    store8(buf, 0xFF);
    store8(buf + 1, 0xF1);  # sync + MPEG-4 + layer=0 + protection_absent=1
    # profile=1(LC), sr_index=4(44100), private=0, ch_config MSB=0
    store8(buf + 2, 0x50);
    # ch_config[1:0]=10, frame_length bits
    # channels=2 -> ch_config=2 -> bits = 10
    # frame_length=100: bits 12-11=00, 10-3=00001100, 2-0=100
    store8(buf + 3, 0x80);  # ch_config LSBs=10, frame[12:11]=00
    store8(buf + 4, 0x0C);  # frame[10:3] = 12 -> 12<<3 = 96
    store8(buf + 5, 0x80);  # frame[2:0] = 100 -> 4, so 96+4=100; buffer fullness MSBs
    store8(buf + 6, 0x00);

    var h = aac_parse_adts_header(buf, 7);
    assert(is_err(h) == 0, "parse succeeds");
    assert_eq(aac_adts_profile(h), 1, "profile LC");
    assert_eq(aac_adts_sample_rate(h), 44100, "sample rate");
    assert_eq(aac_adts_channels(h), 2, "channels");
    assert_eq(aac_adts_frame_length(h), 100, "frame length");

    return 0;
}

fn test_aac_adts_reject_short() {
    test_group("aac: reject short ADTS header");

    if (_aac_sample_rates == 0) { aac_init(); }

    var buf = alloc(3);
    store8(buf, 0xFF);
    store8(buf + 1, 0xF1);
    store8(buf + 2, 0x50);
    var h = aac_parse_adts_header(buf, 3);
    assert(is_err(h) == 1, "short header rejected");

    return 0;
}

fn test_aac_adts_reject_bad_sync() {
    test_group("aac: reject bad sync word");

    if (_aac_sample_rates == 0) { aac_init(); }

    var buf = alloc(7);
    memset(buf, 0, 7);
    var h = aac_parse_adts_header(buf, 7);
    assert(is_err(h) == 1, "bad sync rejected");

    return 0;
}

fn test_aac_adts_reject_reserved_sr() {
    test_group("aac: reject reserved sample rate index");

    if (_aac_sample_rates == 0) { aac_init(); }

    var buf = alloc(7);
    store8(buf, 0xFF);
    store8(buf + 1, 0xF1);
    store8(buf + 2, 0x7C);  # profile=1, sr_index=15(reserved)
    store8(buf + 3, 0x80);
    store8(buf + 4, 0x00);
    store8(buf + 5, 0x00);
    store8(buf + 6, 0x00);
    var h = aac_parse_adts_header(buf, 7);
    assert(is_err(h) == 1, "reserved sr_index rejected");

    return 0;
}

fn test_aac_adts_header_roundtrip() {
    test_group("aac: ADTS header build+parse roundtrip");

    if (_aac_sample_rates == 0) { aac_init(); }

    var buf = alloc(7);
    aac_build_adts_header(44100, 2, 100, buf);

    # Verify sync
    assert_eq(load8(buf), 0xFF, "sync byte 0");
    assert_eq(load8(buf + 1) & 0xF0, 0xF0, "sync byte 1 hi nibble");

    # Parse it back
    var h = aac_parse_adts_header(buf, 7);
    assert(is_err(h) == 0, "roundtrip parse ok");
    assert_eq(aac_adts_profile(h), 1, "rt profile LC");
    assert_eq(aac_adts_sample_rate(h), 44100, "rt sample rate");
    assert_eq(aac_adts_channels(h), 2, "rt channels");
    assert_eq(aac_adts_frame_length(h), 107, "rt frame length (100+7)");

    return 0;
}

fn test_aac_encode_rejects_bad_rate() {
    test_group("aac: encode rejects bad sample rate");

    if (_aac_sample_rates == 0) { aac_init(); }
    if (_aac_swb_offset == 0) { _aac_init_swb(); }

    var samples = vec_new();
    var out = alloc(65536);
    var r = aac_encode(samples, 11111, 1, 64000, out);
    assert(is_err(r) == 1, "bad rate rejected");

    return 0;
}

fn test_aac_encode_rejects_bad_channels() {
    test_group("aac: encode rejects bad channels");

    if (_aac_sample_rates == 0) { aac_init(); }
    if (_aac_swb_offset == 0) { _aac_init_swb(); }

    var samples = vec_new();
    var out = alloc(65536);
    var r = aac_encode(samples, 44100, 0, 64000, out);
    assert(is_err(r) == 1, "0 channels rejected");

    return 0;
}

fn test_aac_encode_rejects_zero_bitrate() {
    test_group("aac: encode rejects zero bitrate");

    if (_aac_sample_rates == 0) { aac_init(); }
    if (_aac_swb_offset == 0) { _aac_init_swb(); }

    var samples = vec_new();
    var out = alloc(65536);
    var r = aac_encode(samples, 44100, 1, 0, out);
    assert(is_err(r) == 1, "zero bitrate rejected");

    return 0;
}

fn test_aac_encode_produces_adts() {
    test_group("aac: encode produces valid ADTS");

    if (_aac_sample_rates == 0) { aac_init(); }
    if (_aac_swb_offset == 0) { _aac_init_swb(); }

    # Build 1024 silence samples (1 frame, mono)
    var samples = vec_new();
    var si = 0;
    while (si < 1024) {
        vec_push(samples, F64_ZERO);
        si = si + 1;
    }

    var out = alloc(131072);
    var result = aac_encode(samples, 44100, 1, 64000, out);
    assert(is_err(result) == 0, "encode succeeds");
    assert(result > 7, "produces bytes");

    # Check ADTS sync word
    assert_eq(load8(out), 0xFF, "ADTS sync[0]");
    assert_eq(load8(out + 1) & 0xF0, 0xF0, "ADTS sync[1]");

    # Parse the ADTS header
    var h = aac_parse_adts_header(out, result);
    assert(is_err(h) == 0, "parse encoded ADTS ok");
    assert_eq(aac_adts_profile(h), 1, "profile LC");
    assert_eq(aac_adts_sample_rate(h), 44100, "sample rate 44100");
    assert_eq(aac_adts_channels(h), 1, "mono");

    return 0;
}

fn test_aac_decode_empty() {
    test_group("aac: decode rejects empty");

    if (_aac_sample_rates == 0) { aac_init(); }

    var buf = alloc(1);
    var r = aac_decode(buf, 0);
    assert(is_err(r) == 1, "empty data rejected");

    return 0;
}

fn test_aac_bitwriter_basic() {
    test_group("aac: bitwriter basic");

    var bw = _bw_new();
    _bw_write(bw, 0xFF, 8);
    _bw_write(bw, 0x0, 4);
    _bw_write(bw, 0xF, 4);
    var result = _bw_flush(bw);
    assert_eq(str_len(result), 2, "2 bytes");
    assert_eq(load8(str_data(result)), 0xFF, "byte 0 = 0xFF");
    assert_eq(load8(str_data(result) + 1), 0x0F, "byte 1 = 0x0F");

    return 0;
}

# TNS analysis (FIR) and synthesis (IIR) built from the same LPC are exact
# inverses — the core roundtrip guarantee. Test both filter directions.
fn test_aac_tns_filter_inverse() {
    test_group("aac: TNS filter analysis/synthesis inverse");
    var order = 3;
    var k = alloc((TNS_MAX_ORDER + 1) * 8);
    memset(k, 0, (TNS_MAX_ORDER + 1) * 8);
    store64(k + 8, f64_div(f64_from(1), f64_from(2)));                    # 0.5
    store64(k + 16, f64_neg(f64_div(f64_from(3), f64_from(10))));         # -0.3
    store64(k + 24, f64_div(f64_from(1), f64_from(5)));                   # 0.2
    var a = alloc((TNS_MAX_ORDER + 1) * 8);
    _tns_parcor_to_lpc(k, order, a);
    var n = 40;
    var start = 100;
    var spec = alloc((start + n) * 8);
    var orig = alloc((start + n) * 8);
    memset(spec, 0, (start + n) * 8);
    memset(orig, 0, (start + n) * 8);
    var i = 0;
    while (i < n) {
        var v = f64_sin(f64_div(f64_from((i + 1) * 7), f64_from(13)));
        store64(spec + (start + i) * 8, v);
        store64(orig + (start + i) * 8, v);
        i = i + 1;
    }
    var eps = f64_div(F64_ONE, f64_from(1000000));
    _tns_filter(spec, start, start + n, a, order, 0, 0);
    _tns_filter(spec, start, start + n, a, order, 0, 1);
    var ok = 1;
    i = 0;
    while (i < n) {
        if (f64_gt(f64_abs(f64_sub(load64(spec + (start + i) * 8), load64(orig + (start + i) * 8))), eps) == 1) { ok = 0; }
        i = i + 1;
    }
    assert(ok == 1, "TNS forward analysis+synthesis == identity");
    i = 0;
    while (i < n) { store64(spec + (start + i) * 8, load64(orig + (start + i) * 8)); i = i + 1; }
    _tns_filter(spec, start, start + n, a, order, 1, 0);
    _tns_filter(spec, start, start + n, a, order, 1, 1);
    ok = 1;
    i = 0;
    while (i < n) {
        if (f64_gt(f64_abs(f64_sub(load64(spec + (start + i) * 8), load64(orig + (start + i) * 8))), eps) == 1) { ok = 0; }
        i = i + 1;
    }
    assert(ok == 1, "TNS backward analysis+synthesis == identity");
    return 0;
}

# Quantized reflection coefficients still yield exactly-inverting filters (both
# sides use the dequantized value), and indices stay in the signed 4-bit range.
fn test_aac_tns_coef_quant() {
    test_group("aac: TNS coefficient quantization roundtrip");
    var resbits = 4;
    var order = 4;
    var kq = alloc((TNS_MAX_ORDER + 1) * 8);
    memset(kq, 0, (TNS_MAX_ORDER + 1) * 8);
    var vals = alloc(4 * 8);
    store64(vals + 0, f64_div(f64_from(6), f64_from(10)));
    store64(vals + 8, f64_neg(f64_div(f64_from(4), f64_from(10))));
    store64(vals + 16, f64_div(f64_from(1), f64_from(10)));
    store64(vals + 24, f64_neg(f64_div(f64_from(7), f64_from(10))));
    var i = 0;
    while (i < order) {
        var idx = _tns_quant_coef(load64(vals + i * 8), resbits);
        assert(idx <= 7, "coef idx <= 7");
        assert(idx >= 0 - 8, "coef idx >= -8");
        store64(kq + (i + 1) * 8, _tns_dequant_coef(idx, resbits));
        i = i + 1;
    }
    var a = alloc((TNS_MAX_ORDER + 1) * 8);
    _tns_parcor_to_lpc(kq, order, a);
    var n = 30;
    var start = 60;
    var spec = alloc((start + n) * 8);
    var orig = alloc((start + n) * 8);
    memset(spec, 0, (start + n) * 8);
    memset(orig, 0, (start + n) * 8);
    i = 0;
    while (i < n) {
        var v = f64_sin(f64_div(f64_from((i + 3) * 5), f64_from(11)));
        store64(spec + (start + i) * 8, v);
        store64(orig + (start + i) * 8, v);
        i = i + 1;
    }
    _tns_filter(spec, start, start + n, a, order, 0, 0);
    _tns_filter(spec, start, start + n, a, order, 0, 1);
    var ok = 1;
    var eps = f64_div(F64_ONE, f64_from(1000000));
    i = 0;
    while (i < n) {
        if (f64_gt(f64_abs(f64_sub(load64(spec + (start + i) * 8), load64(orig + (start + i) * 8))), eps) == 1) { ok = 0; }
        i = i + 1;
    }
    assert(ok == 1, "quantized-coef TNS filter inverts exactly");
    return 0;
}

# tns_data() writes and parses back identically (order/direction/coefs/region).
fn test_aac_tns_bitstream() {
    test_group("aac: TNS bitstream roundtrip");
    if (_aac_swb_offset == 0) { _aac_init_swb(); }
    var st = alloc(TNS_ST_SIZE);
    memset(st, 0, TNS_ST_SIZE);
    store64(st + TNS_ST_PRESENT, 1);
    store64(st + TNS_ST_ORDER, 4);
    store64(st + TNS_ST_DIR, 1);
    store64(st + TNS_ST_COMPRESS, 0);
    store64(st + TNS_ST_RESBITS, 4);
    store64(st + TNS_ST_LEN, 10);
    store64(st + TNS_ST_START, load64(_aac_swb_offset + (49 - 10) * 8));
    store64(st + TNS_ST_END, load64(_aac_swb_offset + 49 * 8));
    store64(st + TNS_ST_COEF + 0, 3);
    store64(st + TNS_ST_COEF + 8, 0 - 5);
    store64(st + TNS_ST_COEF + 16, 7);
    store64(st + TNS_ST_COEF + 24, 0 - 8);
    var bw = _bw_new();
    _aac_write_ics_ext(bw, st);
    var s = _bw_flush(bw);
    var br = _br_new(str_data(s), str_len(s));
    var st2 = alloc(TNS_ST_SIZE);
    memset(st2, 0, TNS_ST_SIZE);
    var rc = _aac_parse_ics_ext(br, 0, 49, st2);
    assert(is_err(rc) == 0, "tns ics_ext parse ok");
    assert_eq(load64(st2 + TNS_ST_PRESENT), 1, "tns present");
    assert_eq(load64(st2 + TNS_ST_ORDER), 4, "tns order");
    assert_eq(load64(st2 + TNS_ST_DIR), 1, "tns direction");
    assert_eq(load64(st2 + TNS_ST_LEN), 10, "tns length");
    assert_eq(load64(st2 + TNS_ST_COEF + 0), 3, "tns coef0");
    assert_eq(load64(st2 + TNS_ST_COEF + 8), 0 - 5, "tns coef1");
    assert_eq(load64(st2 + TNS_ST_COEF + 16), 7, "tns coef2");
    assert_eq(load64(st2 + TNS_ST_COEF + 24), 0 - 8, "tns coef3");
    assert_eq(load64(st2 + TNS_ST_START), load64(_aac_swb_offset + 39 * 8), "tns region start");
    return 0;
}

# End-to-end TNS state path: encoder analysis fills the state + applies the FIR,
# decoder synthesis reads the state + applies the IIR — exact inverse recovery.
fn test_aac_tns_analyze_synth() {
    test_group("aac: TNS analyze/synth state roundtrip");
    if (_aac_swb_offset == 0) { _aac_init_swb(); }
    var spec = alloc(AAC_FRAME_SIZE * 8);
    var orig = alloc(AAC_FRAME_SIZE * 8);
    memset(spec, 0, AAC_FRAME_SIZE * 8);
    memset(orig, 0, AAC_FRAME_SIZE * 8);
    var i = 0;
    while (i < AAC_FRAME_SIZE) {
        # correlated spectrum (slowly varying) so upper bands have prediction gain
        var v = f64_sin(f64_div(f64_from(i), f64_from(9)));
        store64(spec + i * 8, v);
        store64(orig + i * 8, v);
        i = i + 1;
    }
    var st = alloc(TNS_ST_SIZE);
    memset(st, 0, TNS_ST_SIZE);
    _tns_analyze_apply(spec, _AAC_NUM_SWB, st);
    assert_eq(load64(st + TNS_ST_PRESENT), 1, "TNS engaged on correlated spectrum");
    _tns_synth_apply(spec, st);
    var ok = 1;
    var eps = f64_div(F64_ONE, f64_from(100000));
    var start = load64(st + TNS_ST_START);
    var end = load64(st + TNS_ST_END);
    i = start;
    while (i < end) {
        if (f64_gt(f64_abs(f64_sub(load64(spec + i * 8), load64(orig + i * 8))), eps) == 1) { ok = 0; }
        i = i + 1;
    }
    assert(ok == 1, "encoder-analyze then decoder-synth recovers the region");
    return 0;
}

# Full mono pipeline: encode with TNS in the stream, decode via the real audio
# path. A misaligned tns_data() would desync the frame and yield zero samples.
fn test_aac_tns_frame_roundtrip() {
    test_group("aac: TNS mono frame encode/decode");
    if (_aac_sample_rates == 0) { aac_init(); }
    if (_aac_swb_offset == 0) { _aac_init_swb(); }
    var samples = vec_new();
    var i = 0;
    while (i < 1024) {
        var v = f64_sin(f64_div(f64_from(i * 6), f64_from(50)));
        if (i == 200) { v = f64_add(v, f64_from(1)); }   # transient
        vec_push(samples, v);
        i = i + 1;
    }
    var out = alloc(131072);
    var nbytes = aac_encode(samples, 44100, 1, 128000, out);
    assert(is_err(nbytes) == 0, "TNS-frame encode ok");
    assert(nbytes > 7, "produced bytes");
    var dec = aac_decode(out, nbytes);
    assert(is_err(dec) == 0, "TNS-frame decode ok");
    var decoded = decode_result_samples(dec);
    assert(vec_len(decoded) == 1024, "one mono frame decoded (tns_data in sync)");
    return 0;
}

# An isolated band (no neighbours with energy) gets zero masking coarseness.
fn test_aac_psy_isolated_no_masking() {
    test_group("aac: psy isolated band, no masking");
    if (_aac_swb_offset == 0) { _aac_init_swb(); }
    var en = alloc(_AAC_NUM_SWB * 8);
    memset(en, 0, _AAC_NUM_SWB * 8);
    store64(en + 20 * 8, f64_from(1000));
    var off = alloc(_AAC_NUM_SWB * 8);
    _aac_psy_masking_offsets(en, _AAC_NUM_SWB, off);
    assert_eq(load64(off + 20 * 8), 0, "isolated band has zero masking offset");
    return 0;
}

# A loud band masks a quieter neighbour -> positive coarseness offset there.
fn test_aac_psy_neighbor_masking() {
    test_group("aac: psy neighbour masking");
    if (_aac_swb_offset == 0) { _aac_init_swb(); }
    var en = alloc(_AAC_NUM_SWB * 8);
    memset(en, 0, _AAC_NUM_SWB * 8);
    store64(en + 20 * 8, f64_from(100000));
    store64(en + 21 * 8, f64_from(10));
    var off = alloc(_AAC_NUM_SWB * 8);
    _aac_psy_masking_offsets(en, _AAC_NUM_SWB, off);
    assert(load64(off + 21 * 8) > 0, "masked neighbour gets positive offset");
    return 0;
}

# Masking falls off with critical-band distance.
fn test_aac_psy_masking_falloff() {
    test_group("aac: psy masking distance falloff");
    if (_aac_swb_offset == 0) { _aac_init_swb(); }
    var en = alloc(_AAC_NUM_SWB * 8);
    memset(en, 0, _AAC_NUM_SWB * 8);
    store64(en + 20 * 8, f64_from(100000));
    store64(en + 21 * 8, f64_from(10));
    store64(en + 24 * 8, f64_from(10));
    var off = alloc(_AAC_NUM_SWB * 8);
    _aac_psy_masking_offsets(en, _AAC_NUM_SWB, off);
    assert(load64(off + 21 * 8) > load64(off + 24 * 8), "nearer band masked more than farther");
    return 0;
}

# A louder masker raises the offset on the same neighbour.
fn test_aac_psy_louder_masks_more() {
    test_group("aac: psy louder masker masks more");
    if (_aac_swb_offset == 0) { _aac_init_swb(); }
    var en1 = alloc(_AAC_NUM_SWB * 8);
    memset(en1, 0, _AAC_NUM_SWB * 8);
    store64(en1 + 20 * 8, f64_from(10000));
    store64(en1 + 21 * 8, f64_from(10));
    var off1 = alloc(_AAC_NUM_SWB * 8);
    _aac_psy_masking_offsets(en1, _AAC_NUM_SWB, off1);
    var en2 = alloc(_AAC_NUM_SWB * 8);
    memset(en2, 0, _AAC_NUM_SWB * 8);
    store64(en2 + 20 * 8, f64_from(1000000));
    store64(en2 + 21 * 8, f64_from(10));
    var off2 = alloc(_AAC_NUM_SWB * 8);
    _aac_psy_masking_offsets(en2, _AAC_NUM_SWB, off2);
    assert(load64(off2 + 21 * 8) > load64(off1 + 21 * 8), "louder masker -> larger offset");
    return 0;
}

# Spreading is asymmetric: upward (toward higher freq) masks more than downward.
fn test_aac_psy_asymmetric_spread() {
    test_group("aac: psy asymmetric spreading");
    if (_aac_swb_offset == 0) { _aac_init_swb(); }
    var en = alloc(_AAC_NUM_SWB * 8);
    memset(en, 0, _AAC_NUM_SWB * 8);
    store64(en + 22 * 8, f64_from(100000));   # masker
    store64(en + 21 * 8, f64_from(10));        # below masker (downward spread, steep)
    store64(en + 23 * 8, f64_from(10));        # above masker (upward spread, gentle)
    var off = alloc(_AAC_NUM_SWB * 8);
    _aac_psy_masking_offsets(en, _AAC_NUM_SWB, off);
    assert(load64(off + 23 * 8) > load64(off + 21 * 8), "upward spread masks more than downward");
    assert(load64(off + 21 * 8) > 0, "downward masking still positive");
    return 0;
}

# Full pipeline with the masking-driven scale factors still decodes a valid frame.
fn test_aac_psy_frame_roundtrip() {
    test_group("aac: psy mono frame encode/decode");
    if (_aac_sample_rates == 0) { aac_init(); }
    if (_aac_swb_offset == 0) { _aac_init_swb(); }
    var samples = vec_new();
    var i = 0;
    while (i < 1024) {
        var lo = f64_sin(f64_div(f64_from(i * 3), f64_from(50)));
        var hi = f64_mul(f64_sin(f64_div(f64_from(i * 40), f64_from(50))), f64_div(F64_ONE, f64_from(50)));
        vec_push(samples, f64_add(lo, hi));
        i = i + 1;
    }
    var out = alloc(131072);
    var nbytes = aac_encode(samples, 44100, 1, 128000, out);
    assert(is_err(nbytes) == 0, "psy-frame encode ok");
    assert(nbytes > 7, "produced bytes");
    var dec = aac_decode(out, nbytes);
    assert(is_err(dec) == 0, "psy-frame decode ok");
    assert(vec_len(decode_result_samples(dec)) == 1024, "one mono frame decoded");
    return 0;
}

fn test_aac_all() {
    fft_init();
    aac_init();
    if (_aac_swb_offset == 0) { _aac_init_swb(); }

    test_aac_adts_parse_valid();
    test_aac_adts_reject_short();
    test_aac_adts_reject_bad_sync();
    test_aac_adts_reject_reserved_sr();
    test_aac_adts_header_roundtrip();
    test_aac_encode_rejects_bad_rate();
    test_aac_encode_rejects_bad_channels();
    test_aac_encode_rejects_zero_bitrate();
    test_aac_encode_produces_adts();
    test_aac_decode_empty();
    test_aac_bitwriter_basic();
    test_aac_tns_filter_inverse();
    test_aac_tns_coef_quant();
    test_aac_tns_bitstream();
    test_aac_tns_analyze_synth();
    test_aac_tns_frame_roundtrip();
    test_aac_psy_isolated_no_masking();
    test_aac_psy_neighbor_masking();
    test_aac_psy_masking_falloff();
    test_aac_psy_louder_masks_more();
    test_aac_psy_asymmetric_spread();
    test_aac_psy_frame_roundtrip();
    return 0;
}
