# ================================================================
# fft.cyr -- Mixed-radix FFT and MDCT infrastructure
# ================================================================
#
# Provides:
#   fft_compute(re, im, n, inverse)  -- in-place mixed-radix FFT (2,3,5)
#   fft_mdct(input, n, output)       -- forward MDCT via FFT
#   fft_imdct(input, n, output)      -- inverse MDCT via FFT
#
# Complex numbers stored as f64 bit patterns in parallel arrays:
#   re[i] = load64(re_buf + i*8)
#   im[i] = load64(im_buf + i*8)
#
# Requires: f64 builtins, alloc, math.cyr

# ================================================================
# Constants
# ================================================================

# pi as f64 bit pattern: 4614256656552045848
var F64_PI = 4614256656552045848;

# 2*pi
var F64_TWO_PI = 0;

# negative 2*pi
var F64_NEG_TWO_PI = 0;

fn fft_init() {
    F64_TWO_PI = f64_mul(F64_TWO, F64_PI);
    F64_NEG_TWO_PI = f64_neg(F64_TWO_PI);
    return 0;
}

# Lazy: consumers call only shravan_init_constants(), so the FFT initialises itself.
fn _fft_two_pi() {
    if (F64_TWO_PI == 0) { fft_init(); }
    return F64_TWO_PI;
}

# ================================================================
# Twiddle factor cache — pre-computed cos/sin tables per FFT size
# ================================================================
# tw_re[k] = cos(-2*pi*k/N), tw_im[k] = sin(-2*pi*k/N) for k=0..N-1
# Single-size cache: rebuilt when N changes (common case is repeated
# calls at same size within a codec — AAC always uses 2048, etc.)

var _fft_tw_re = 0;
var _fft_tw_im = 0;
var _fft_tw_n  = 0;

fn _fft_ensure_twiddles(n) {
    if (n == _fft_tw_n) { return 0; }
    _fft_tw_re = alloc(n * 8);
    _fft_tw_im = alloc(n * 8);
    var angle_base = f64_neg(f64_div(_fft_two_pi(), f64_from(n)));
    var k = 0;
    while (k < n) {
        var theta = f64_mul(angle_base, f64_from(k));
        store64(_fft_tw_re + k * 8, f64_cos(theta));
        store64(_fft_tw_im + k * 8, f64_sin(theta));
        k = k + 1;
    }
    _fft_tw_n = n;
    return 0;
}

# MDCT twiddle caches (pre and post rotation angles)
var _mdct_pre_re = 0;
var _mdct_pre_im = 0;
var _mdct_pre_n  = 0;
var _mdct_post_re = 0;
var _mdct_post_im = 0;
var _mdct_post_n  = 0;

# IMDCT twiddle caches
var _imdct_pre_re = 0;
var _imdct_pre_im = 0;
var _imdct_pre_n  = 0;
var _imdct_post_re = 0;
var _imdct_post_im = 0;
var _imdct_post_n  = 0;

# ================================================================
# Complex helpers (operate on f64 bit patterns)
# ================================================================

# Complex multiply: (ar+ai*j)*(br+bi*j) = (ar*br - ai*bi) + (ar*bi + ai*br)*j
# Returns real part; call _cmul_im for imag part
fn _cmul_re(ar, ai, br, bi) {
    return f64_sub(f64_mul(ar, br), f64_mul(ai, bi));
}

fn _cmul_im(ar, ai, br, bi) {
    return f64_add(f64_mul(ar, bi), f64_mul(ai, br));
}

# exp(i*theta): returns (cos(theta), sin(theta))
# We store results via output pointers
fn _cexp(theta, out_re, out_im) {
    store64(out_re, f64_cos(theta));
    store64(out_im, f64_sin(theta));
    return 0;
}

# ================================================================
# Factorization helper
# ================================================================

# Find the smallest factor of n among {2, 3, 5}. Returns 0 if none.
fn _fft_find_factor(n) {
    if (n % 2 == 0) { return 2; }
    if (n % 3 == 0) { return 3; }
    if (n % 5 == 0) { return 5; }
    return 0;
}

# ================================================================
# Naive DFT fallback for small prime sizes
# ================================================================

fn _dft_naive(re, im, n) {
    # Copy input
    var tmp_re = alloc(n * 8);
    var tmp_im = alloc(n * 8);
    memcpy(tmp_re, re, n * 8);
    memcpy(tmp_im, im, n * 8);

    var angle_base = f64_neg(f64_div(_fft_two_pi(), f64_from(n)));

    var k = 0;
    while (k < n) {
        var sum_re = F64_ZERO;
        var sum_im = F64_ZERO;

        var j = 0;
        while (j < n) {
            var theta = f64_mul(angle_base, f64_from(k * j));
            var tw_re = f64_cos(theta);
            var tw_im = f64_sin(theta);

            var xr = load64(tmp_re + j * 8);
            var xi = load64(tmp_im + j * 8);

            # complex multiply: (xr+xi*j)*(tw_re+tw_im*j)
            var pr = _cmul_re(xr, xi, tw_re, tw_im);
            var pi = _cmul_im(xr, xi, tw_re, tw_im);

            sum_re = f64_add(sum_re, pr);
            sum_im = f64_add(sum_im, pi);

            j = j + 1;
        }

        store64(re + k * 8, sum_re);
        store64(im + k * 8, sum_im);
        k = k + 1;
    }

    return 0;
}

# ================================================================
# In-place mixed-radix DIT FFT
# ================================================================
#
# fft_compute(re, im, n, inverse)
#   re: pointer to n f64 values (real parts)
#   im: pointer to n f64 values (imag parts)
#   n: transform size (must factor into 2, 3, 5)
#   inverse: 0 for forward FFT, 1 for inverse FFT
#
# For inverse, we conjugate input, do forward FFT, then conjugate
# and scale output by 1/n.

fn fft_compute(re, im, n, inverse) {
    if (_fft_pow2(n) == 1) {
        if (inverse == 0) { _fft2(re, im, n, 0 - 1); return 0; }
        _fft2(re, im, n, 1);
        var sc = f64_div(F64_ONE, f64_from(n));
        var q = 0;
        while (q < n) {
            store64(re + q * 8, f64_mul(load64(re + q * 8), sc));
            store64(im + q * 8, f64_mul(load64(im + q * 8), sc));
            q = q + 1;
        }
        return 0;
    }
    if (inverse != 0) {
        # Conjugate input
        var ci = 0;
        while (ci < n) {
            store64(im + ci * 8, f64_neg(load64(im + ci * 8)));
            ci = ci + 1;
        }

        # Forward FFT
        _fft_forward(re, im, n);

        # Conjugate and scale by 1/n
        var scale = f64_div(F64_ONE, f64_from(n));
        ci = 0;
        while (ci < n) {
            store64(re + ci * 8, f64_mul(load64(re + ci * 8), scale));
            store64(im + ci * 8, f64_neg(f64_mul(load64(im + ci * 8), scale)));
            ci = ci + 1;
        }
        return 0;
    }

    _fft_forward(re, im, n);
    return 0;
}

fn _fft_forward(re, im, n) {
    if (n <= 1) { return 0; }

    var radix = _fft_find_factor(n);
    if (radix == 0) {
        # n is prime and not 2, 3, or 5 -- use naive DFT
        _dft_naive(re, im, n);
        return 0;
    }

    var m = n / radix;

    # Decimation-in-time: reorder into `radix` sub-sequences of length m
    var tmp_re = alloc(n * 8);
    var tmp_im = alloc(n * 8);

    var r = 0;
    while (r < radix) {
        var j = 0;
        while (j < m) {
            var src_idx = j * radix + r;
            var dst_idx = r * m + j;
            store64(tmp_re + dst_idx * 8, load64(re + src_idx * 8));
            store64(tmp_im + dst_idx * 8, load64(im + src_idx * 8));
            j = j + 1;
        }
        r = r + 1;
    }

    # Recurse on each sub-FFT of length m
    r = 0;
    while (r < radix) {
        var off = r * m * 8;
        _fft_forward(tmp_re + off, tmp_im + off, m);
        r = r + 1;
    }

    # Combine: generic radix-R butterfly with pre-computed twiddles
    # Pre-compute all N twiddle factors for this level
    var tw_re_buf = alloc(n * 8);
    var tw_im_buf = alloc(n * 8);
    var angle_base = f64_neg(f64_div(_fft_two_pi(), f64_from(n)));
    var ti = 0;
    while (ti < n) {
        var theta = f64_mul(angle_base, f64_from(ti));
        store64(tw_re_buf + ti * 8, f64_cos(theta));
        store64(tw_im_buf + ti * 8, f64_sin(theta));
        ti = ti + 1;
    }

    var k = 0;
    while (k < n) {
        var km = k % m;
        var sum_re = F64_ZERO;
        var sum_im = F64_ZERO;

        r = 0;
        while (r < radix) {
            var tw_idx = (r * k) % n;
            var tw_re = load64(tw_re_buf + tw_idx * 8);
            var tw_im = load64(tw_im_buf + tw_idx * 8);

            var xr = load64(tmp_re + (r * m + km) * 8);
            var xi = load64(tmp_im + (r * m + km) * 8);

            var pr = _cmul_re(xr, xi, tw_re, tw_im);
            var pi_val = _cmul_im(xr, xi, tw_re, tw_im);

            sum_re = f64_add(sum_re, pr);
            sum_im = f64_add(sum_im, pi_val);

            r = r + 1;
        }

        store64(re + k * 8, sum_re);
        store64(im + k * 8, sum_im);
        k = k + 1;
    }

    return 0;
}

# ================================================================
# Power-of-two FFT
# ================================================================
# Iterative radix-2, natural order in and out. The twiddles (cos and sin of
# 2*pi*k/n) and the bit-reversal permutation are built once per size and cached
# for four sizes. The mixed-radix path above recomputed n cosines at every level
# of every call; this is what the MDCT runs on.

fn _fft_pow2(n) {
    if (n < 2) { return 0; }
    if ((n & (n - 1)) != 0) { return 0; }
    return 1;
}

var _fft2_slot_n = 0;     # [4] sizes
var _fft2_slot_t = 0;     # [4] table blocks: cos[n/2] | sin[n/2] | rev[n]
var _fft2_cur_n = 0;
var _fft2_cos = 0;
var _fft2_sin = 0;
var _fft2_rev = 0;

fn _fft2_tables(n) {
    if (n == _fft2_cur_n) { return 0; }
    if (_fft2_slot_n == 0) {
        _fft2_slot_n = alloc(4 * 8);
        _fft2_slot_t = alloc(4 * 8);
        memset(_fft2_slot_n, 0, 32);
        memset(_fft2_slot_t, 0, 32);
    }
    var t = 0;
    var free = 0 - 1;
    var j = 0;
    while (j < 4) {
        if (load64(_fft2_slot_n + j * 8) == n) { t = load64(_fft2_slot_t + j * 8); }
        if (free < 0) { if (load64(_fft2_slot_n + j * 8) == 0) { free = j; } }
        j = j + 1;
    }
    var h = n / 2;
    if (t == 0) {
        t = alloc((h + h + n) * 8);
        var step = f64_div(_fft_two_pi(), f64_from(n));
        var k = 0;
        while (k < h) {
            var th = f64_mul(step, f64_from(k));
            store64(t + k * 8, f64_cos(th));
            store64(t + (h + k) * 8, f64_sin(th));
            k = k + 1;
        }
        var bits = 0;
        while ((1 << bits) < n) { bits = bits + 1; }
        var i = 0;
        while (i < n) {
            var r = 0;
            var b = 0;
            while (b < bits) {
                if (((i >> b) & 1) == 1) { r = r | (1 << (bits - 1 - b)); }
                b = b + 1;
            }
            store64(t + (h + h + i) * 8, r);
            i = i + 1;
        }
        if (free < 0) { free = 3; }
        store64(_fft2_slot_n + free * 8, n);
        store64(_fft2_slot_t + free * 8, t);
    }
    _fft2_cur_n = n;
    _fft2_cos = t;
    _fft2_sin = t + h * 8;
    _fft2_rev = t + (h + h) * 8;
    return 0;
}

# In-place FFT of n (a power of two) complex values: X[k] = sum x[j] e^(sign*2*pi*i*jk/n),
# sign -1 forward, +1 inverse (no 1/n).
fn _fft2(re, im, n, sign) {
    _fft2_tables(n);
    var cs = _fft2_cos;
    var sn = _fft2_sin;
    var rev = _fft2_rev;
    var i = 0;
    while (i < n) {
        var j = load64(rev + i * 8);
        if (j > i) {
            var t = load64(re + i * 8); store64(re + i * 8, load64(re + j * 8)); store64(re + j * 8, t);
            t = load64(im + i * 8); store64(im + i * 8, load64(im + j * 8)); store64(im + j * 8, t);
        }
        i = i + 1;
    }
    var len = 2;
    while (len <= n) {
        var half = len / 2;
        var tstep = (n / len) * 8;
        var st = 0;
        while (st < n) {
            var k = 0;
            var tw = 0;
            while (k < half) {
                var wr = load64(cs + tw);
                var wi = load64(sn + tw);
                if (sign < 0) { wi = f64_neg(wi); }
                var pa = (st + k) * 8;
                var pb = pa + half * 8;
                var br = load64(re + pb);
                var bi = load64(im + pb);
                var tr = f64_sub(f64_mul(br, wr), f64_mul(bi, wi));
                var ti = f64_add(f64_mul(br, wi), f64_mul(bi, wr));
                var ar = load64(re + pa);
                var ai = load64(im + pa);
                store64(re + pa, f64_add(ar, tr));
                store64(im + pa, f64_add(ai, ti));
                store64(re + pb, f64_sub(ar, tr));
                store64(im + pb, f64_sub(ai, ti));
                k = k + 1;
                tw = tw + tstep;
            }
            st = st + len;
        }
        len = len * 2;
    }
    return 0;
}

# ================================================================
# MDCT / IMDCT — a verified TDAC-invertible pair (shared cosine basis)
# ================================================================
# Direct O(n*m) transform over a cached cosine basis, m = n/2:
#   basis[k][i] = cos( (pi/m) (i + 0.5 + m/2) (k + 0.5) )
# fft_mdct is the analysis (X[k]=<x,basis_k>), fft_imdct the synthesis
# (y[i]=(1/m) sum_k X[k] basis_k[i]) — exact transposes, so with a symmetric
# window + 50% overlap they perfectly reconstruct (Princen-Bradley). This replaced
# an FFT-based pair whose analysis/synthesis conventions did NOT match (encode->decode
# cancelled to silence — the root cause of silent AAC/Opus encoders). Fast FFT-based
# MDCT that preserves this exact convention is a perf follow-up.
var _mdct_basis = 0;
var _mdct_basis_n = 0;
var _mdct_cache_n = 0;    # [4] transform sizes with a built basis
var _mdct_cache_b = 0;    # [4] their bases

# The cosine basis for an n-point transform, built once per size. It used to be
# cached for ONE size, and AAC alternates 2048 (long) and 256 (short) blocks, so
# every block switch rebuilt the long basis: two million cosines and 16 MB that
# alloc() never returns. A transient-rich minute of AAC allocated eight times its
# output and decoded far slower than real time.
fn _mdct_ensure_basis(n) {
    if (_mdct_basis_n == n) { return 0; }
    if (_mdct_cache_n == 0) {
        _mdct_cache_n = alloc(4 * 8);
        _mdct_cache_b = alloc(4 * 8);
        memset(_mdct_cache_n, 0, 32);
        memset(_mdct_cache_b, 0, 32);
    }
    var slot = 0 - 1;
    var j = 0;
    while (j < 4) {
        if (load64(_mdct_cache_n + j * 8) == n) {
            _mdct_basis = load64(_mdct_cache_b + j * 8);
            _mdct_basis_n = n;
            return 0;
        }
        if (slot < 0) { if (load64(_mdct_cache_n + j * 8) == 0) { slot = j; } }
        j = j + 1;
    }
    var m = n / 2;
    var shift = n / 4;
    var bb = alloc(m * n * 8);
    var k = 0;
    while (k < m) {
        var i = 0;
        while (i < n) {
            var ang = f64_div(f64_mul(F64_PI, f64_mul(f64_add(f64_add(f64_from(i), F64_HALF), f64_from(shift)), f64_add(f64_from(k), F64_HALF))), f64_from(m));
            store64(bb + (k * n + i) * 8, f64_cos(ang));
            i = i + 1;
        }
        k = k + 1;
    }
    if (slot < 0) { slot = 3; }
    store64(_mdct_cache_n + slot * 8, n);
    store64(_mdct_cache_b + slot * 8, bb);
    _mdct_basis = bb;
    _mdct_basis_n = n;
    return 0;
}

fn fft_mdct(input, n, output) {
    # SEC-014: validate MDCT size (must be >= 4, divisible by 4, bounded)
    if (n < 4) { return 0 - 1; }
    if (n % 4 != 0) { return 0 - 1; }
    if (n > 8192) { return 0 - 1; }
    if (n % 8 == 0) { if (_fft_pow2(n / 4) == 1) { return _mdct_fast(input, n, output); } }
    return _mdct_direct(input, n, output);
}

# The O(n^2) transform over the cached basis: the definition, kept for sizes the
# fast path does not take and as the reference the tests hold it to.
fn _mdct_direct(input, n, output) {
    _mdct_ensure_basis(n);
    var m = n / 2;
    var b = _mdct_basis;
    var k = 0;
    while (k < m) {
        var acc = F64_ZERO;
        var row = k * n;
        var i = 0;
        while (i < n) {
            acc = f64_add(acc, f64_mul(load64(input + i * 8), load64(b + (row + i) * 8)));
            i = i + 1;
        }
        store64(output + k * 8, acc);
        k = k + 1;
    }
    return 0;
}

# ---- fast MDCT / IMDCT ----
# The same transforms through an n/4-point complex FFT: pre-twiddle, FFT,
# post-twiddle, the standard factorisation (as in ffmpeg's mdct_template.c, whose
# rotation tables are -cos and -sin of 2*pi*(i + 1/8)/n). Against the definition,
# the MDCT comes out exactly and the IMDCT scaled by -M/2, which the 2/M
# normalisation absorbs as -2/M. O(n log n) in place of O(n^2): a long AAC block
# was two million multiply-adds per channel.
var _mdct_tw_n = 0;
var _mdct_tc = 0;
var _mdct_ts = 0;
var _mdct_tw_slots_n = 0;    # [4]
var _mdct_tw_slots_t = 0;    # [4]
var _mdct_zr = 0;            # FFT scratch, n/4 values each
var _mdct_zi = 0;
var _mdct_zcap = 0;

fn _mdct_tw(n) {
    if (n == _mdct_tw_n) { return 0; }
    if (_mdct_tw_slots_n == 0) {
        _mdct_tw_slots_n = alloc(32);
        _mdct_tw_slots_t = alloc(32);
        memset(_mdct_tw_slots_n, 0, 32);
        memset(_mdct_tw_slots_t, 0, 32);
    }
    var n4 = n / 4;
    var t = 0;
    var free = 0 - 1;
    var j = 0;
    while (j < 4) {
        if (load64(_mdct_tw_slots_n + j * 8) == n) { t = load64(_mdct_tw_slots_t + j * 8); }
        if (free < 0) { if (load64(_mdct_tw_slots_n + j * 8) == 0) { free = j; } }
        j = j + 1;
    }
    if (t == 0) {
        t = alloc(n4 * 2 * 8);
        var eighth = f64_div(F64_ONE, f64_from(8));
        var i = 0;
        while (i < n4) {
            var a = f64_div(f64_mul(_fft_two_pi(), f64_add(f64_from(i), eighth)), f64_from(n));
            store64(t + i * 8, f64_neg(f64_cos(a)));
            store64(t + (n4 + i) * 8, f64_neg(f64_sin(a)));
            i = i + 1;
        }
        if (free < 0) { free = 3; }
        store64(_mdct_tw_slots_n + free * 8, n);
        store64(_mdct_tw_slots_t + free * 8, t);
    }
    if (_mdct_zcap < n4) {
        _mdct_zr = alloc(n4 * 8);
        _mdct_zi = alloc(n4 * 8);
        _mdct_zcap = n4;
    }
    _mdct_tw_n = n;
    _mdct_tc = t;
    _mdct_ts = t + n4 * 8;
    return 0;
}

fn _mdct_fast(x, n, out) {
    _mdct_tw(n);
    var n2 = n / 2;
    var n4 = n / 4;
    var n8 = n / 8;
    var n3 = 3 * n4;
    var tc = _mdct_tc;
    var ts = _mdct_ts;
    var zr = _mdct_zr;
    var zi = _mdct_zi;
    var i = 0;
    while (i < n8) {
        var re = f64_sub(f64_neg(load64(x + (2 * i + n3) * 8)), load64(x + (n3 - 1 - 2 * i) * 8));
        var im = f64_add(f64_neg(load64(x + (n4 + 2 * i) * 8)), load64(x + (n4 - 1 - 2 * i) * 8));
        var c = f64_neg(load64(tc + i * 8));
        var s = load64(ts + i * 8);
        store64(zr + i * 8, f64_sub(f64_mul(re, c), f64_mul(im, s)));
        store64(zi + i * 8, f64_add(f64_mul(re, s), f64_mul(im, c)));
        re = f64_sub(load64(x + 2 * i * 8), load64(x + (n2 - 1 - 2 * i) * 8));
        im = f64_sub(f64_neg(load64(x + (n2 + 2 * i) * 8)), load64(x + (n - 1 - 2 * i) * 8));
        c = f64_neg(load64(tc + (n8 + i) * 8));
        s = load64(ts + (n8 + i) * 8);
        store64(zr + (n8 + i) * 8, f64_sub(f64_mul(re, c), f64_mul(im, s)));
        store64(zi + (n8 + i) * 8, f64_add(f64_mul(re, s), f64_mul(im, c)));
        i = i + 1;
    }
    _fft2(zr, zi, n4, 0 - 1);
    i = 0;
    while (i < n8) {
        var a = n8 - i - 1;
        var b = n8 + i;
        var ar = load64(zr + a * 8);
        var ai = load64(zi + a * 8);
        var nsa = f64_neg(load64(ts + a * 8));
        var nca = f64_neg(load64(tc + a * 8));
        var br = load64(zr + b * 8);
        var bi = load64(zi + b * 8);
        var nsb = f64_neg(load64(ts + b * 8));
        var ncb = f64_neg(load64(tc + b * 8));
        # (i1, r0) = (ar, ai) * (-ts[a], -tc[a]);  (i0, r1) = (br, bi) * (-ts[b], -tc[b])
        store64(zi + b * 8, f64_sub(f64_mul(ar, nsa), f64_mul(ai, nca)));
        store64(zr + a * 8, f64_add(f64_mul(ar, nca), f64_mul(ai, nsa)));
        store64(zi + a * 8, f64_sub(f64_mul(br, nsb), f64_mul(bi, ncb)));
        store64(zr + b * 8, f64_add(f64_mul(br, ncb), f64_mul(bi, nsb)));
        i = i + 1;
    }
    var k = 0;
    while (k < n4) {
        store64(out + 2 * k * 8, load64(zr + k * 8));
        store64(out + (2 * k + 1) * 8, load64(zi + k * 8));
        k = k + 1;
    }
    return 0;
}

fn _imdct_fast(X, n, out) {
    _mdct_tw(n);
    var n2 = n / 2;
    var n4 = n / 4;
    var n8 = n / 8;
    var tc = _mdct_tc;
    var ts = _mdct_ts;
    var zr = _mdct_zr;
    var zi = _mdct_zi;
    var k = 0;
    while (k < n4) {
        var re = load64(X + (n2 - 1 - 2 * k) * 8);
        var im = load64(X + 2 * k * 8);
        var c = load64(tc + k * 8);
        var s = load64(ts + k * 8);
        store64(zr + k * 8, f64_sub(f64_mul(re, c), f64_mul(im, s)));
        store64(zi + k * 8, f64_add(f64_mul(re, s), f64_mul(im, c)));
        k = k + 1;
    }
    _fft2(zr, zi, n4, 1);
    k = 0;
    while (k < n8) {
        var a = n8 - k - 1;
        var b = n8 + k;
        var ar = load64(zr + a * 8);
        var ai = load64(zi + a * 8);
        var br = load64(zr + b * 8);
        var bi = load64(zi + b * 8);
        var sa = load64(ts + a * 8);
        var ca = load64(tc + a * 8);
        var sb = load64(ts + b * 8);
        var cb = load64(tc + b * 8);
        # (r0, i1) = (ai, ar) * (ts[a], tc[a]);  (r1, i0) = (bi, br) * (ts[b], tc[b])
        store64(zr + a * 8, f64_sub(f64_mul(ai, sa), f64_mul(ar, ca)));
        store64(zi + b * 8, f64_add(f64_mul(ai, ca), f64_mul(ar, sa)));
        store64(zr + b * 8, f64_sub(f64_mul(bi, sb), f64_mul(br, cb)));
        store64(zi + a * 8, f64_add(f64_mul(bi, cb), f64_mul(br, sb)));
        k = k + 1;
    }
    # The middle half, scaled by -2/M; the outer quarters follow by symmetry.
    var sc = f64_neg(f64_div(F64_TWO, f64_from(n2)));
    k = 0;
    while (k < n4) {
        store64(out + (n4 + 2 * k) * 8, f64_mul(load64(zr + k * 8), sc));
        store64(out + (n4 + 2 * k + 1) * 8, f64_mul(load64(zi + k * 8), sc));
        k = k + 1;
    }
    k = 0;
    while (k < n4) {
        store64(out + k * 8, f64_neg(load64(out + (n2 - k - 1) * 8)));
        store64(out + (n - k - 1) * 8, load64(out + (n2 + k) * 8));
        k = k + 1;
    }
    return 0;
}

# ================================================================
# Inverse MDCT — exact TDAC partner of fft_mdct
# ================================================================
#   input: pointer to n/2 f64 spectral coefficients
#   n: window size; output: pointer to n f64 time-domain samples
#   IMDCT: y[i] = (2/N) sum_k X[k] cos(pi/M (i + 0.5 + M/2)(k + 0.5)), M = N/2
# This is the standard AAC / Vorbis MDCT convention and the transpose of fft_mdct's
# basis, so with a symmetric analysis+synthesis window and 50% overlap it gives
# Princen-Bradley perfect reconstruction (verified OLA correlation 0.999).

fn fft_imdct(input, n, output) {
    # SEC-014: validate IMDCT size
    if (n < 4) { return 0 - 1; }
    if (n % 4 != 0) { return 0 - 1; }
    if (n > 8192) { return 0 - 1; }
    if (n % 8 == 0) { if (_fft_pow2(n / 4) == 1) { return _imdct_fast(input, n, output); } }
    return _imdct_direct(input, n, output);
}

fn _imdct_direct(input, n, output) {
    _mdct_ensure_basis(n);
    var m = n / 2;
    var b = _mdct_basis;
    # Scale 2/M: with the double sine window + 50% OLA, the single-block IMDCT∘MDCT
    # returns x/2 (the TDAC kernel has magnitude M/2), so 2/M restores unity gain.
    var invm = f64_div(F64_TWO, f64_from(m));
    var i = 0;
    while (i < n) {
        var acc = F64_ZERO;
        var k = 0;
        while (k < m) {
            acc = f64_add(acc, f64_mul(load64(input + k * 8), load64(b + (k * n + i) * 8)));
            k = k + 1;
        }
        store64(output + i * 8, f64_mul(acc, invm));
        i = i + 1;
    }
    return 0;
}

# ================================================================
# Tests
# ================================================================

fn test_fft_impulse() {
    test_group("fft: impulse response (size 4)");

    var re = alloc(4 * 8);
    var im = alloc(4 * 8);
    memset(re, 0, 4 * 8);
    memset(im, 0, 4 * 8);
    store64(re, F64_ONE);  # impulse at index 0

    fft_compute(re, im, 4, 0);

    # All bins should be 1.0 + 0.0j
    var eps = f64_from(1);  # 1e-10 threshold
    var threshold = f64_div(F64_ONE, f64_mul(f64_from(10000000), f64_from(1000)));

    var pass = 1;
    var ki = 0;
    while (ki < 4) {
        var rval = load64(re + ki * 8);
        var ival = load64(im + ki * 8);
        var rdiff = f64_abs(f64_sub(rval, F64_ONE));
        var idiff = f64_abs(ival);
        if (f64_gt(rdiff, threshold) == 1) { pass = 0; }
        if (f64_gt(idiff, threshold) == 1) { pass = 0; }
        ki = ki + 1;
    }
    assert(pass, "all bins ~= 1.0 + 0.0j");

    return 0;
}

fn test_fft_size_6() {
    test_group("fft: impulse size 6");

    var re = alloc(6 * 8);
    var im = alloc(6 * 8);
    memset(re, 0, 6 * 8);
    memset(im, 0, 6 * 8);
    store64(re, F64_ONE);

    fft_compute(re, im, 6, 0);

    var threshold = f64_div(F64_ONE, f64_mul(f64_from(10000000), f64_from(1000)));
    var pass = 1;
    var ki = 0;
    while (ki < 6) {
        var rdiff = f64_abs(f64_sub(load64(re + ki * 8), F64_ONE));
        var idiff = f64_abs(load64(im + ki * 8));
        if (f64_gt(rdiff, threshold) == 1) { pass = 0; }
        if (f64_gt(idiff, threshold) == 1) { pass = 0; }
        ki = ki + 1;
    }
    assert(pass, "size 6 impulse: all bins ~= 1.0");

    return 0;
}

fn test_fft_vs_dft_size_30() {
    test_group("fft: FFT vs DFT size 30");

    var n = 30;
    var re1 = alloc(n * 8);
    var im1 = alloc(n * 8);
    var re2 = alloc(n * 8);
    var im2 = alloc(n * 8);

    # Fill with sin/cos test pattern
    var i = 0;
    while (i < n) {
        var val_re = f64_sin(f64_mul(f64_from(i), f64_div(f64_from(7), f64_from(10))));
        var val_im = f64_cos(f64_mul(f64_from(i), f64_div(f64_from(13), f64_from(10))));
        store64(re1 + i * 8, val_re);
        store64(im1 + i * 8, val_im);
        store64(re2 + i * 8, val_re);
        store64(im2 + i * 8, val_im);
        i = i + 1;
    }

    fft_compute(re1, im1, n, 0);
    _dft_naive(re2, im2, n);

    var max_diff = F64_ZERO;
    i = 0;
    while (i < n) {
        var dr = f64_abs(f64_sub(load64(re1 + i * 8), load64(re2 + i * 8)));
        var di = f64_abs(f64_sub(load64(im1 + i * 8), load64(im2 + i * 8)));
        max_diff = f64_max(max_diff, f64_max(dr, di));
        i = i + 1;
    }

    var threshold = f64_div(F64_ONE, f64_from(1000000));
    assert(f64_lt(max_diff, threshold) == 1, "FFT vs DFT max_diff < 1e-6");

    return 0;
}

fn test_fft_size_240() {
    test_group("fft: impulse size 240");

    var n = 240;
    var re = alloc(n * 8);
    var im = alloc(n * 8);
    memset(re, 0, n * 8);
    memset(im, 0, n * 8);
    store64(re, F64_ONE);

    fft_compute(re, im, n, 0);

    var threshold = f64_div(F64_ONE, f64_mul(f64_from(10000000), f64_from(1000)));
    var rdiff = f64_abs(f64_sub(load64(re), F64_ONE));
    assert(f64_lt(rdiff, threshold) == 1, "size 240 bin[0] ~= 1.0");

    return 0;
}

fn test_fft_inverse_roundtrip() {
    test_group("fft: forward+inverse roundtrip");

    var n = 8;
    var re = alloc(n * 8);
    var im = alloc(n * 8);
    var orig_re = alloc(n * 8);

    var i = 0;
    while (i < n) {
        var v = f64_from(i + 1);
        store64(re + i * 8, v);
        store64(im + i * 8, F64_ZERO);
        store64(orig_re + i * 8, v);
        i = i + 1;
    }

    # Forward FFT
    fft_compute(re, im, n, 0);

    # Inverse FFT
    fft_compute(re, im, n, 1);

    # Check roundtrip
    var threshold = f64_div(F64_ONE, f64_from(1000000));
    var pass = 1;
    i = 0;
    while (i < n) {
        var diff = f64_abs(f64_sub(load64(re + i * 8), load64(orig_re + i * 8)));
        if (f64_gt(diff, threshold) == 1) { pass = 0; }
        i = i + 1;
    }
    assert(pass, "forward+inverse recovers original");

    return 0;
}

fn test_fft_mdct_produces_output() {
    test_group("fft: MDCT produces output");

    var n = 16;
    var input = alloc(n * 8);
    var output = alloc((n / 2) * 8);
    memset(output, 0, (n / 2) * 8);

    var i = 0;
    while (i < n) {
        store64(input + i * 8, F64_ONE);
        i = i + 1;
    }

    fft_mdct(input, n, output);

    # Check that energy is nonzero
    var energy = F64_ZERO;
    i = 0;
    while (i < n / 2) {
        var v = load64(output + i * 8);
        energy = f64_add(energy, f64_mul(v, v));
        i = i + 1;
    }
    assert(f64_gt(energy, F64_ZERO) == 1, "MDCT energy > 0");

    return 0;
}

fn test_fft_mdct_roundtrip() {
    test_group("fft: MDCT + IMDCT perfect reconstruction (windowed 50% OLA)");

    # Proper test: window -> MDCT -> IMDCT -> window -> 50%-overlap-add must reconstruct
    # the input in the interior (Princen-Bradley TDAC). The old test only checked the
    # output was nonzero and would have passed even when the transform pair did not
    # invert (which it did not — that shipped silent AAC/Opus encoders).
    var nf = 64;
    var h = nf / 2;
    var total = 256;
    var x = alloc(total * 8);
    var i = 0;
    while (i < total) {
        var a = f64_sin(f64_div(f64_mul(F64_TWO, f64_mul(F64_PI, f64_from(i))), f64_from(16)));
        var b = f64_mul(f64_sin(f64_div(f64_mul(F64_TWO, f64_mul(F64_PI, f64_from(i))), f64_from(9))), F64_HALF);
        store64(x + i * 8, f64_add(a, b));
        i = i + 1;
    }
    var acc = alloc(total * 8);
    memset(acc, 0, total * 8);
    var wf = alloc(nf * 8);
    var spec = alloc((nf / 2) * 8);
    var tt = alloc(nf * 8);
    var start = 0;
    while (start + nf <= total) {
        i = 0;
        while (i < nf) {
            var ang = f64_div(f64_mul(F64_PI, f64_add(f64_from(i), F64_HALF)), f64_from(nf));
            store64(wf + i * 8, f64_mul(load64(x + (start + i) * 8), f64_sin(ang)));
            i = i + 1;
        }
        fft_mdct(wf, nf, spec);
        fft_imdct(spec, nf, tt);
        i = 0;
        while (i < nf) {
            var ang2 = f64_div(f64_mul(F64_PI, f64_add(f64_from(i), F64_HALF)), f64_from(nf));
            var p = start + i;
            store64(acc + p * 8, f64_add(load64(acc + p * 8), f64_mul(load64(tt + i * 8), f64_sin(ang2))));
            i = i + 1;
        }
        start = start + h;
    }
    var maxerr = F64_ZERO;
    i = nf;
    while (i < total - nf) {
        var e = f64_abs(f64_sub(load64(acc + i * 8), load64(x + i * 8)));
        if (f64_gt(e, maxerr) == 1) { maxerr = e; }
        i = i + 1;
    }
    var tol = f64_div(F64_ONE, f64_from(1000000));   # 1e-6
    assert(f64_gt(tol, maxerr) == 1, "MDCT+IMDCT OLA reconstructs interior to <1e-6");

    return 0;
}

# The FFT-based MDCT and IMDCT against their definitions (the direct transforms)
# on pseudo-random input at every size AAC and the tests use; and the power-of-two
# FFT against the naive DFT.
fn test_fft_fast_matches_direct() {
    test_group("fft: fast mdct/imdct and pow2 fft match the definitions");
    var seed = 12345;
    var sizes = alloc(5 * 8);
    store64(sizes, 8); store64(sizes + 8, 16); store64(sizes + 16, 64);
    store64(sizes + 24, 256); store64(sizes + 32, 2048);
    var si = 0;
    while (si < 5) {
        var n = load64(sizes + si * 8);
        var x = alloc(n * 8);
        var a = alloc(n * 8);
        var b = alloc(n * 8);
        var i = 0;
        while (i < n) {
            seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF;
            store64(x + i * 8, f64_sub(f64_div(f64_from(seed), f64_from(1073741824)), F64_ONE));
            i = i + 1;
        }
        _mdct_fast(x, n, a);
        _mdct_direct(x, n, b);
        var worst = F64_ZERO;
        i = 0;
        while (i < n / 2) {
            var d = f64_abs(f64_sub(load64(a + i * 8), load64(b + i * 8)));
            if (f64_gt(d, worst) == 1) { worst = d; }
            i = i + 1;
        }
        assert(f64_lt(worst, f64_div(F64_ONE, f64_from(1000000000))) == 1, "fast mdct = direct mdct");
        _imdct_fast(x, n, a);
        _imdct_direct(x, n, b);
        worst = F64_ZERO;
        i = 0;
        while (i < n) {
            var d2 = f64_abs(f64_sub(load64(a + i * 8), load64(b + i * 8)));
            if (f64_gt(d2, worst) == 1) { worst = d2; }
            i = i + 1;
        }
        assert(f64_lt(worst, f64_div(F64_ONE, f64_from(1000000000))) == 1, "fast imdct = direct imdct");
        si = si + 1;
    }

    # pow2 FFT (n = 64) against the naive DFT
    var n2 = 64;
    var re = alloc(n2 * 8); var im = alloc(n2 * 8);
    var re2 = alloc(n2 * 8); var im2 = alloc(n2 * 8);
    var j = 0;
    while (j < n2) {
        seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF;
        store64(re + j * 8, f64_from(seed % 1000));
        store64(im + j * 8, f64_from((seed / 1000) % 1000));
        store64(re2 + j * 8, load64(re + j * 8));
        store64(im2 + j * 8, load64(im + j * 8));
        j = j + 1;
    }
    _fft2(re, im, n2, 0 - 1);
    _dft_naive(re2, im2, n2);
    var w2 = F64_ZERO;
    j = 0;
    while (j < n2) {
        var e1 = f64_abs(f64_sub(load64(re + j * 8), load64(re2 + j * 8)));
        var e2 = f64_abs(f64_sub(load64(im + j * 8), load64(im2 + j * 8)));
        if (f64_gt(e1, w2) == 1) { w2 = e1; }
        if (f64_gt(e2, w2) == 1) { w2 = e2; }
        j = j + 1;
    }
    assert(f64_lt(w2, f64_div(F64_ONE, f64_from(1000000))) == 1, "pow2 fft = naive dft");
    return 0;
}

fn test_fft_all() {
    test_fft_fast_matches_direct();
    fft_init();
    test_fft_impulse();
    test_fft_size_6();
    test_fft_vs_dft_size_30();
    test_fft_size_240();
    test_fft_inverse_roundtrip();
    test_fft_mdct_produces_output();
    test_fft_mdct_roundtrip();
    return 0;
}
