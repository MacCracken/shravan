    store64(lo0_FQ + 0 * 8, 2); store64(lo0_FQ + 1 * 8, 4); store64(lo0_FQ + 2 * 8, 3); store64(lo0_FQ + 3 * 8, 2); store64(lo0_FQ + 4 * 8, 2); store64(lo0_FQ + 5 * 8, 3); store64(lo0_FQ + 6 * 8, 2); store64(lo0_FQ + 7 * 8, 2);
    store64(lo0_FQ + 8 * 8, 2); store64(lo0_FQ + 9 * 8, 2); store64(lo0_FQ + 10 * 8, 2); store64(lo0_FQ + 11 * 8, 2); store64(lo0_FQ + 12 * 8, 3); store64(lo0_FQ + 13 * 8, 3); store64(lo0_FQ + 14 * 8, 3); store64(lo0_FQ + 15 * 8, 4);
    store64(lo0_FQ + 16 * 8, 3); store64(lo0_FQ + 17 * 8, 3); store64(lo0_FQ + 18 * 8, 3); store64(lo0_FQ + 19 * 8, 1); store64(lo0_FQ + 20 * 8, 1);
    _celt_assert_arr(fq, lo0_FQ, 21, "lo0 FQ");
    var lo0_FP = alloc(21 * 8);
    store64(lo0_FP + 0 * 8, 0); store64(lo0_FP + 1 * 8, 1); store64(lo0_FP + 2 * 8, 1); store64(lo0_FP + 3 * 8, 0); store64(lo0_FP + 4 * 8, 1); store64(lo0_FP + 5 * 8, 1); store64(lo0_FP + 6 * 8, 1); store64(lo0_FP + 7 * 8, 1);
    store64(lo0_FP + 8 * 8, 0); store64(lo0_FP + 9 * 8, 0); store64(lo0_FP + 10 * 8, 0); store64(lo0_FP + 11 * 8, 1); store64(lo0_FP + 12 * 8, 1); store64(lo0_FP + 13 * 8, 1); store64(lo0_FP + 14 * 8, 0); store64(lo0_FP + 15 * 8, 1);
    store64(lo0_FP + 16 * 8, 1); store64(lo0_FP + 17 * 8, 1); store64(lo0_FP + 18 * 8, 0); store64(lo0_FP + 19 * 8, 0); store64(lo0_FP + 20 * 8, 0);
    _celt_assert_arr(fp, lo0_FP, 21, "lo0 FP");
    return 0;
}

