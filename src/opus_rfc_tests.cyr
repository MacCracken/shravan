fn test_celt_pcm_stereo_rfc() {
    test_group("opus: CELT stereo decode -> PCM correlation vs ffmpeg");
    var st = celt_dec_state_new();
    var pcm = alloc(1920 * 8);
    var thr = f64_div(f64_from(99), f64_from(100));
    # stereo frame 0
    var sf0_p = alloc(639);
    store8(sf0_p + 0, 159); store8(sf0_p + 1, 233); store8(sf0_p + 2, 42); store8(sf0_p + 3, 131); store8(sf0_p + 4, 63); store8(sf0_p + 5, 137); store8(sf0_p + 6, 106); store8(sf0_p + 7, 61); store8(sf0_p + 8, 234); store8(sf0_p + 9, 40); store8(sf0_p + 10, 33); store8(sf0_p + 11, 225); store8(sf0_p + 12, 239); store8(sf0_p + 13, 82);
    store8(sf0_p + 14, 253); store8(sf0_p + 15, 41); store8(sf0_p + 16, 51); store8(sf0_p + 17, 183); store8(sf0_p + 18, 192); store8(sf0_p + 19, 121); store8(sf0_p + 20, 234); store8(sf0_p + 21, 149); store8(sf0_p + 22, 224); store8(sf0_p + 23, 154); store8(sf0_p + 24, 127); store8(sf0_p + 25, 210); store8(sf0_p + 26, 67); store8(sf0_p + 27, 132);
    store8(sf0_p + 28, 3); store8(sf0_p + 29, 34); store8(sf0_p + 30, 238); store8(sf0_p + 31, 147); store8(sf0_p + 32, 101); store8(sf0_p + 33, 21); store8(sf0_p + 34, 214); store8(sf0_p + 35, 8); store8(sf0_p + 36, 202); store8(sf0_p + 37, 144); store8(sf0_p + 38, 151); store8(sf0_p + 39, 152); store8(sf0_p + 40, 236); store8(sf0_p + 41, 37);
    store8(sf0_p + 42, 167); store8(sf0_p + 43, 205); store8(sf0_p + 44, 47); store8(sf0_p + 45, 162); store8(sf0_p + 46, 75); store8(sf0_p + 47, 51); store8(sf0_p + 48, 238); store8(sf0_p + 49, 52); store8(sf0_p + 50, 180); store8(sf0_p + 51, 129); store8(sf0_p + 52, 46); store8(sf0_p + 53, 161); store8(sf0_p + 54, 150); store8(sf0_p + 55, 139);
