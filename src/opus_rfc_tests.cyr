# SILK 10ms (config 8 WB, nb_subfr=2, frame_length=160), frame 0: verifies the
# nb_subfr threading (2 gains, NInterp forced 4, 2 LTP, 10ms pitch codebooks).
fn test_opus_silk10_rfc() {
    test_group("opus: SILK 10ms (config 8, nb_subfr=2) correlation vs libopus");
    var pl = alloc(27);
    store8(pl + 0, 132); store8(pl + 1, 39); store8(pl + 2, 87); store8(pl + 3, 193); store8(pl + 4, 194); store8(pl + 5, 104); store8(pl + 6, 201); store8(pl + 7, 17); store8(pl + 8, 185); store8(pl + 9, 55); store8(pl + 10, 203); store8(pl + 11, 13); store8(pl + 12, 83); store8(pl + 13, 180); store8(pl + 14, 90); store8(pl + 15, 212);
    store8(pl + 16, 58); store8(pl + 17, 235); store8(pl + 18, 199); store8(pl + 19, 124); store8(pl + 20, 219); store8(pl + 21, 191); store8(pl + 22, 42); store8(pl + 23, 232); store8(pl + 24, 3); store8(pl + 25, 15); store8(pl + 26, 99);
    var st = silk_decoder_init(16, 2); var rst = silk_resampler_init(16);
    var sMid = alloc(2 * 8); store64(sMid + 0, 0); store64(sMid + 8, 0);
    var ec = ec_dec_new(pl, 27);
    var o48 = alloc(480 * 8);
    silk_decode_pcm_ec(st, rst, sMid, ec, o48);
    var of = alloc(480 * 8); var j = 0;
    while (j < 480) { store64(of + j * 8, f64_from(load64(o48 + j * 8))); j = j + 1; }
    var g = alloc(480 * 8);
    store64(g + 0 * 8, 0); store64(g + 1 * 8, 0); store64(g + 2 * 8, 0); store64(g + 3 * 8, 0); store64(g + 4 * 8, 0); store64(g + 5 * 8, 0); store64(g + 6 * 8, 0); store64(g + 7 * 8, 0);
