# ================================================================
# opus_rfc_tests.cyr — RFC-6716 Opus decoder conformance tests (v2.6.0)
# ================================================================
# NOT part of the [lib] distlib bundle (embeds large libopus-generated vectors +
# reference PCM). Included by src/main.cyr AFTER src/opus.cyr so the decoder
# symbols are in scope. All vectors/PCM were produced by libopus 1.6.1 / ffmpeg;
# these assert shravan's decoder is bit-exact / correlation-1.0 vs the reference.

fn _celt_corr(a, refs, n) {
    var dot = F64_ZERO; var na = F64_ZERO; var nb = F64_ZERO; var i = 0;
    while (i < n) {
        var av = load64(a + i * 8); var bv = f64_from(load64(refs + i * 8));
        dot = f64_add(dot, f64_mul(av, bv)); na = f64_add(na, f64_mul(av, av)); nb = f64_add(nb, f64_mul(bv, bv));
        i = i + 1;
    }
    var den = f64_mul(f64_sqrt(na), f64_sqrt(nb));
    if (f64_lt(den, f64_div(F64_ONE, f64_from(1000000))) == 1) { return F64_ONE; }
    return f64_div(dot, den);
}

fn _celt_assert_arr(got, exp, n, msg) {
    var i = 0;
    var ok = 1;
    while (i < n) {
        if (load64(got + i * 8) != load64(exp + i * 8)) { ok = 0; }
        i = i + 1;
    }
    assert(ok == 1, msg);
    return 0;
}

fn _celt_assert_bytes(got, exp, n, msg) {
    var i = 0; var ok = 1;
    while (i < n) { if (load8(got + i) != load8(exp + i)) { ok = 0; } i = i + 1; }
    assert(ok == 1, msg); return 0;
}

fn _celt_run_qab(payload, plen, C, oldBandE, seed_in, exp_rng, exp_tell, exp_cm, tag) {
    var tf = alloc(21 * 8); var off = alloc(21 * 8); var pul = alloc(21 * 8);
    var fq = alloc(21 * 8); var fp = alloc(21 * 8); var cap = alloc(21 * 8); var scal = alloc(16 * 8);
    var ec = celt_decode_frame_prefix(payload, plen, C, oldBandE, tf, off, pul, fq, fp, cap, scal);
    var N = 960; var M = 8;
    var X = alloc(C * N * 8); var z = 0; while (z < C * N) { store64(X + z * 8, F64_ZERO); z = z + 1; }
    var Y = 0; if (C == 2) { Y = X + N * 8; }
    var cm = alloc(C * 21);
    var shortBlocks = 0; if (load64(scal + 8) != 0) { shortBlocks = M; }
    var total_bits = plen * 64 - load64(scal + 40);
    var seedp = alloc(8); store64(seedp, seed_in);
    var di = 0;
    quant_all_bands(X, Y, cm, pul, shortBlocks, load64(scal + 24), load64(scal + 64), load64(scal + 56), tf, total_bits, load64(scal + 72), ec, 3, load64(scal + 48), seedp, di, C, 0, 21);
    assert_eq(load64(ec + 56), exp_rng, tag);
    assert_eq(ec_tell(ec), exp_tell, tag);
    _celt_assert_bytes(cm, exp_cm, C * 21, tag);
    return 0;
}

fn test_ec_dec_rfc_vectors() {
    test_group("opus: ec_dec bit-exact vs libopus");
    var buf = alloc(16);
    var b = alloc(16 * 8);
    store64(b + 0,  146); store64(b + 8,  99);  store64(b + 16, 168); store64(b + 24, 224);
    store64(b + 32, 0);   store64(b + 40, 0);   store64(b + 48, 0);   store64(b + 56, 0);
    store64(b + 64, 0);   store64(b + 72, 0);   store64(b + 80, 0);   store64(b + 88, 3);
    store64(b + 96, 255); store64(b + 104, 255); store64(b + 112, 168); store64(b + 120, 42);
    var i = 0;
    while (i < 16) { store8(buf + i, load64(b + i * 8)); i = i + 1; }
    # icdf tables (inverse CDF, ftb=8)
    var icdf3 = alloc(4);
    store8(icdf3 + 0, 224); store8(icdf3 + 1, 160); store8(icdf3 + 2, 96); store8(icdf3 + 3, 0);
    var icdf2 = alloc(2);
    store8(icdf2 + 0, 192); store8(icdf2 + 1, 0);

    var ec = ec_dec_new(buf, 16);
    assert_eq(ec_dec_uint(ec, 10), 5, "ec uint 5/10");
    assert_eq(ec_dec_bit_logp(ec, 1), 1, "ec bit_logp1 = 1");
    assert_eq(ec_dec_bit_logp(ec, 3), 0, "ec bit_logp3 = 0");
    assert_eq(ec_dec_bits(ec, 6), 42, "ec raw bits6 = 42");
    assert_eq(ec_dec_icdf(ec, icdf3, 8), 2, "ec icdf3 = 2");
    assert_eq(ec_dec_uint(ec, 200000), 100000, "ec uint 100000/200000");
    assert_eq(ec_dec_bits(ec, 10), 1023, "ec raw bits10 = 1023");
    assert_eq(ec_dec_icdf(ec, icdf2, 8), 0, "ec icdf2 = 0");
    assert_eq(ec_dec_uint(ec, 65536), 65535, "ec uint 65535/65536");
    assert_eq(ec_dec_bit_logp(ec, 4), 1, "ec bit_logp4 = 1");
    assert_eq(ec_tell(ec), 64, "ec_tell = 64");
    return 0;
}

# Range ENCODER conformance: ec_enc must (1) produce the byte-identical packet that
# libopus's entenc.c produces for this exact symbol sequence, and (2) round-trip through
# our own verified ec_dec. The golden [100,131,52,5,171,57] (offs=4, end_offs=2) came from
# libopus ec_enc into a size-6 buffer (scratchpad encdrv.c).
fn test_ec_enc_rfc() {
    test_group("opus: range encoder ec_enc — bit-exact vs libopus + round-trip");
    var icdf = alloc(5);
    store8(icdf + 0, 24); store8(icdf + 1, 16); store8(icdf + 2, 8); store8(icdf + 3, 3); store8(icdf + 4, 0);
    var buf = alloc(6);
    var e = ec_enc_new(buf, 6);
    ec_encode(e, 3, 4, 10);
    ec_enc_bit_logp(e, 1, 3);
    ec_enc_bit_logp(e, 0, 2);
    ec_enc_icdf(e, 2, icdf, 5);
    ec_enc_uint(e, 12345, 65536);
    ec_enc_bits(e, 171, 8);
    ec_encode(e, 0, 1, 16);
    ec_enc_uint(e, 7, 100);
    ec_enc_bits(e, 5, 3);
    ec_enc_done(e);
    # (1) bit-exact vs libopus
    assert(load64(e + 88) == 0, "ec_enc: no error");
    assert(load64(e + 48) == 4, "ec_enc: offs == 4");
    assert(load64(e + 16) == 2, "ec_enc: end_offs == 2");
    assert(load8(buf + 0) == 100, "ec_enc byte0 == 100");
    assert(load8(buf + 1) == 131, "ec_enc byte1 == 131");
    assert(load8(buf + 2) == 52, "ec_enc byte2 == 52");
    assert(load8(buf + 3) == 5, "ec_enc byte3 == 5");
    assert(load8(buf + 4) == 171, "ec_enc byte4 == 171");
    assert(load8(buf + 5) == 57, "ec_enc byte5 == 57");
    # (2) round-trip through the verified decoder
    var d = ec_dec_new(buf, 6);
    var fs0 = ec_decode(d, 10); assert(fs0 == 3, "rt: ec_decode sym 3"); ec_dec_update(d, 3, 4, 10);
    assert(ec_dec_bit_logp(d, 3) == 1, "rt: bit_logp 1");
    assert(ec_dec_bit_logp(d, 2) == 0, "rt: bit_logp 0");
    assert(ec_dec_icdf(d, icdf, 5) == 2, "rt: icdf sym 2");
    assert(ec_dec_uint(d, 65536) == 12345, "rt: uint 12345");
    assert(ec_dec_bits(d, 8) == 171, "rt: bits 171");
    var fs1 = ec_decode(d, 16); assert(fs1 == 0, "rt: ec_decode sym 0"); ec_dec_update(d, 0, 1, 16);
    assert(ec_dec_uint(d, 100) == 7, "rt: uint 7");
    assert(ec_dec_bits(d, 3) == 5, "rt: bits 5");
    return 0;
}

