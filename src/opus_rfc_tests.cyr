# silk_isort_i16: the NLSF-stabilize insertion-sort fallback. Real bitstreams rarely
# reach it (only when the 20-loop iterative stabilizer fails to converge), so exercise
# it directly on assorted permutations to guarantee it sorts ascending.
fn test_silk_isort_rfc() {
    test_group("opus: SILK insertion-sort fallback (silk_isort_i16)");
    # helper: fill buf from a source array of n values, sort, assert ascending + permutation.
    var buf = alloc(6 * 8);
    # case [1,3,2] -> [1,2,3]
    store64(buf + 0, 1); store64(buf + 8, 3); store64(buf + 16, 2);
    silk_isort_i16(buf, 3);
    assert_eq(load64(buf + 0), 1, "isort a0");
    assert_eq(load64(buf + 8), 2, "isort a1");
    assert_eq(load64(buf + 16), 3, "isort a2");
    # case [3,1,2] -> [1,2,3]
    store64(buf + 0, 3); store64(buf + 8, 1); store64(buf + 16, 2);
    silk_isort_i16(buf, 3);
    assert_eq(load64(buf + 0), 1, "isort b0");
    assert_eq(load64(buf + 8), 2, "isort b1");
    assert_eq(load64(buf + 16), 3, "isort b2");
    # case [5,4,3,2,1,0] (reverse) -> [0,1,2,3,4,5]
    var r = 0; while (r < 6) { store64(buf + r * 8, 5 - r); r = r + 1; }
    silk_isort_i16(buf, 6);
    r = 0; while (r < 6) { assert_eq(load64(buf + r * 8), r, "isort rev"); r = r + 1; }
    # case with negatives + dupes [2,-3,2,-3,0,1] -> [-3,-3,0,1,2,2]
    store64(buf + 0, 2); store64(buf + 8, 0 - 3); store64(buf + 16, 2);
    store64(buf + 24, 0 - 3); store64(buf + 32, 0); store64(buf + 40, 1);
    silk_isort_i16(buf, 6);
    assert_eq(load64(buf + 0), 0 - 3, "isort n0");
    assert_eq(load64(buf + 8), 0 - 3, "isort n1");
    assert_eq(load64(buf + 16), 0, "isort n2");
    assert_eq(load64(buf + 24), 1, "isort n3");
    assert_eq(load64(buf + 32), 2, "isort n4");
    assert_eq(load64(buf + 40), 2, "isort n5");
    # already sorted stays sorted [1,2,3] -> [1,2,3]
    store64(buf + 0, 1); store64(buf + 8, 2); store64(buf + 16, 3);
    silk_isort_i16(buf, 3);
    assert_eq(load64(buf + 0), 1, "isort s0");
    assert_eq(load64(buf + 8), 2, "isort s1");
    assert_eq(load64(buf + 16), 3, "isort s2");
    return 0;
}

# Hybrid (SILK low + CELT high, shared range coder), config 15 (FB 20ms mono),
# frame 0 from clean state: verifies the shared-ec threading + CELT start=17 +
# accumulate path (incl. the norm_offset fold fix) against a libopus golden.
fn test_opus_hybrid_rfc() {
    test_group("opus: hybrid (SILK+CELT) decode correlation vs libopus");
    var pl = alloc(69);
    store8(pl + 0, 132); store8(pl + 1, 192); store8(pl + 2, 238); store8(pl + 3, 78); store8(pl + 4, 122); store8(pl + 5, 70); store8(pl + 6, 74); store8(pl + 7, 0); store8(pl + 8, 144); store8(pl + 9, 219); store8(pl + 10, 255); store8(pl + 11, 25); store8(pl + 12, 170); store8(pl + 13, 235); store8(pl + 14, 81); store8(pl + 15, 108);
    store8(pl + 16, 22); store8(pl + 17, 146); store8(pl + 18, 6); store8(pl + 19, 151); store8(pl + 20, 134); store8(pl + 21, 124); store8(pl + 22, 19); store8(pl + 23, 57); store8(pl + 24, 59); store8(pl + 25, 201); store8(pl + 26, 157); store8(pl + 27, 26); store8(pl + 28, 77); store8(pl + 29, 177); store8(pl + 30, 12); store8(pl + 31, 29);
    store8(pl + 32, 198); store8(pl + 33, 123); store8(pl + 34, 51); store8(pl + 35, 221); store8(pl + 36, 202); store8(pl + 37, 200); store8(pl + 38, 31); store8(pl + 39, 235); store8(pl + 40, 18); store8(pl + 41, 163); store8(pl + 42, 75); store8(pl + 43, 65); store8(pl + 44, 111); store8(pl + 45, 104); store8(pl + 46, 85); store8(pl + 47, 42);
    store8(pl + 48, 110); store8(pl + 49, 23); store8(pl + 50, 168); store8(pl + 51, 124); store8(pl + 52, 38); store8(pl + 53, 72); store8(pl + 54, 26); store8(pl + 55, 155); store8(pl + 56, 40); store8(pl + 57, 222); store8(pl + 58, 84); store8(pl + 59, 39); store8(pl + 60, 26); store8(pl + 61, 4); store8(pl + 62, 185); store8(pl + 63, 83);
    store8(pl + 64, 166); store8(pl + 65, 147); store8(pl + 66, 236); store8(pl + 67, 107); store8(pl + 68, 106);
    var hst = silk_decoder_init(16, 4); var hrst = silk_resampler_init(16);
    var hmid = alloc(2 * 8); store64(hmid + 0, 0); store64(hmid + 8, 0);
    var hcst = celt_dec_state_new();
    var hec = ec_dec_new(pl, 69);
    var hso = alloc(960 * 8);
    silk_decode_pcm_ec(hst, hrst, hmid, hec, hso);
    var hpcm = alloc(960 * 8); var hj = 0;
    while (hj < 960) { store64(hpcm + hj * 8, f64_div(f64_from(load64(hso + hj * 8)), f64_from(32768))); hj = hj + 1; }
    if (ec_tell(hec) + 37 <= 8 * 69) {
        if (ec_dec_bit_logp(hec, 12) != 0) {
            var hcts = ec_dec_bit_logp(hec, 1); var hrb = ec_dec_uint(hec, 256) + 2;
            store64(hec + 8, load64(hec + 8) - hrb);
        }
    }
    celt_decode_frame_ec(hcst, hec, 69, 1, 17, 21, 1, 3, hpcm);
    # golden = libopus combined output (int16-scale); _celt_corr applies f64_from itself.
    var hg = alloc(960 * 8);
    store64(hg + 0 * 8, 0); store64(hg + 1 * 8, 0); store64(hg + 2 * 8, 0); store64(hg + 3 * 8, 0); store64(hg + 4 * 8, 0); store64(hg + 5 * 8, 0); store64(hg + 6 * 8, 0); store64(hg + 7 * 8, 0);
    store64(hg + 8 * 8, 0); store64(hg + 9 * 8, 0); store64(hg + 10 * 8, 0); store64(hg + 11 * 8, 0); store64(hg + 12 * 8, 0); store64(hg + 13 * 8, 0); store64(hg + 14 * 8, 0); store64(hg + 15 * 8, 0);
