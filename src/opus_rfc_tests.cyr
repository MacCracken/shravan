    store64(hg + 24 * 8, 0); store64(hg + 25 * 8, 0); store64(hg + 26 * 8, 0); store64(hg + 27 * 8, 0); store64(hg + 28 * 8, 0); store64(hg + 29 * 8, 0); store64(hg + 30 * 8, 0); store64(hg + 31 * 8, 0);
    store64(hg + 32 * 8, 1); store64(hg + 33 * 8, 3); store64(hg + 34 * 8, 11); store64(hg + 35 * 8, 26); store64(hg + 36 * 8, 52); store64(hg + 37 * 8, 92); store64(hg + 38 * 8, 145); store64(hg + 39 * 8, 205);
    store64(hg + 40 * 8, 270); store64(hg + 41 * 8, 333); store64(hg + 42 * 8, 389); store64(hg + 43 * 8, 439); store64(hg + 44 * 8, 477); store64(hg + 45 * 8, 500); store64(hg + 46 * 8, 506); store64(hg + 47 * 8, 498);
