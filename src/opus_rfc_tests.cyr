# CELT-only 10ms (config 30 FB, LM=2, N=480), frame 0: verifies the LM parameterization
# (energy tables, IMDCT size, decode-mem offsets) added for 10ms frames.
fn test_opus_celt10_rfc() {
    test_group("opus: CELT-only 10ms (config 30, LM=2) correlation vs libopus");
    var pl = alloc(79);
    store8(pl + 0, 181); store8(pl + 1, 69); store8(pl + 2, 176); store8(pl + 3, 151); store8(pl + 4, 237); store8(pl + 5, 33); store8(pl + 6, 46); store8(pl + 7, 228); store8(pl + 8, 101); store8(pl + 9, 98); store8(pl + 10, 49); store8(pl + 11, 34); store8(pl + 12, 166); store8(pl + 13, 91); store8(pl + 14, 118); store8(pl + 15, 4);
    store8(pl + 16, 5); store8(pl + 17, 177); store8(pl + 18, 30); store8(pl + 19, 11); store8(pl + 20, 162); store8(pl + 21, 196); store8(pl + 22, 232); store8(pl + 23, 186); store8(pl + 24, 109); store8(pl + 25, 194); store8(pl + 26, 188); store8(pl + 27, 135); store8(pl + 28, 168); store8(pl + 29, 169); store8(pl + 30, 245); store8(pl + 31, 144);
    store8(pl + 32, 102); store8(pl + 33, 183); store8(pl + 34, 114); store8(pl + 35, 158); store8(pl + 36, 139); store8(pl + 37, 41); store8(pl + 38, 193); store8(pl + 39, 219); store8(pl + 40, 29); store8(pl + 41, 37); store8(pl + 42, 19); store8(pl + 43, 246); store8(pl + 44, 219); store8(pl + 45, 191); store8(pl + 46, 90); store8(pl + 47, 42);
    store8(pl + 48, 39); store8(pl + 49, 232); store8(pl + 50, 243); store8(pl + 51, 79); store8(pl + 52, 70); store8(pl + 53, 113); store8(pl + 54, 187); store8(pl + 55, 165); store8(pl + 56, 93); store8(pl + 57, 97); store8(pl + 58, 210); store8(pl + 59, 143); store8(pl + 60, 230); store8(pl + 61, 135); store8(pl + 62, 53); store8(pl + 63, 138);
    store8(pl + 64, 77); store8(pl + 65, 17); store8(pl + 66, 14); store8(pl + 67, 16); store8(pl + 68, 221); store8(pl + 69, 73); store8(pl + 70, 147); store8(pl + 71, 65); store8(pl + 72, 243); store8(pl + 73, 137); store8(pl + 74, 171); store8(pl + 75, 196); store8(pl + 76, 142); store8(pl + 77, 89); store8(pl + 78, 113);
    var cst = celt_dec_state_new();
    var cpcm = alloc(480 * 8);
    celt_decode_frame_ec(cst, ec_dec_new(pl, 79), 79, 1, 0, 21, 0, 2, cpcm);
    var cg = alloc(480 * 8);
    store64(cg + 0 * 8, 0); store64(cg + 1 * 8, 1); store64(cg + 2 * 8, 0); store64(cg + 3 * 8, 0 - 2); store64(cg + 4 * 8, 0 - 4); store64(cg + 5 * 8, 1); store64(cg + 6 * 8, 14); store64(cg + 7 * 8, 16);
