    store8(m0_p + 60, 213); store8(m0_p + 61, 238); store8(m0_p + 62, 223); store8(m0_p + 63, 14); store8(m0_p + 64, 112); store8(m0_p + 65, 179); store8(m0_p + 66, 85); store8(m0_p + 67, 141); store8(m0_p + 68, 173); store8(m0_p + 69, 10); store8(m0_p + 70, 230); store8(m0_p + 71, 6);
    store8(m0_p + 72, 107); store8(m0_p + 73, 86); store8(m0_p + 74, 243); store8(m0_p + 75, 207); store8(m0_p + 76, 97); store8(m0_p + 77, 12); store8(m0_p + 78, 167); store8(m0_p + 79, 208); store8(m0_p + 80, 184); store8(m0_p + 81, 117); store8(m0_p + 82, 12); store8(m0_p + 83, 112);
    store8(m0_p + 84, 115); store8(m0_p + 85, 202); store8(m0_p + 86, 141); store8(m0_p + 87, 105); store8(m0_p + 88, 243); store8(m0_p + 89, 135); store8(m0_p + 90, 251); store8(m0_p + 91, 72); store8(m0_p + 92, 132); store8(m0_p + 93, 132); store8(m0_p + 94, 184); store8(m0_p + 95, 23);
