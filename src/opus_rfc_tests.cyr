fn test_opus_hybrid10_rfc() {
    test_group("opus: hybrid 10ms (config 14 FB, SILK nb_subfr=2 + CELT LM=2) correlation vs libopus");
    var pl = alloc(34);
    store8(pl + 0, 131); store8(pl + 1, 202); store8(pl + 2, 63); store8(pl + 3, 26); store8(pl + 4, 3); store8(pl + 5, 29); store8(pl + 6, 213); store8(pl + 7, 157); store8(pl + 8, 85); store8(pl + 9, 2); store8(pl + 10, 18); store8(pl + 11, 91); store8(pl + 12, 12); store8(pl + 13, 38); store8(pl + 14, 94); store8(pl + 15, 169);
    store8(pl + 16, 239); store8(pl + 17, 38); store8(pl + 18, 170); store8(pl + 19, 97); store8(pl + 20, 198); store8(pl + 21, 214); store8(pl + 22, 43); store8(pl + 23, 74); store8(pl + 24, 10); store8(pl + 25, 2); store8(pl + 26, 144); store8(pl + 27, 82); store8(pl + 28, 83); store8(pl + 29, 104); store8(pl + 30, 6); store8(pl + 31, 216);
    store8(pl + 32, 17); store8(pl + 33, 163);
    var hst = silk_decoder_init(16, 2); var hrst = silk_resampler_init(16);
    var hmid = alloc(2 * 8); store64(hmid + 0, 0); store64(hmid + 8, 0);
    var hcst = celt_dec_state_new();
    var hec = ec_dec_new(pl, 34);
    var hso = alloc(480 * 8);
    silk_decode_pcm_ec(hst, hrst, hmid, hec, hso);
    var hpcm = alloc(480 * 8); var hj = 0;
    while (hj < 480) { store64(hpcm + hj * 8, f64_div(f64_from(load64(hso + hj * 8)), f64_from(32768))); hj = hj + 1; }
    if (ec_tell(hec) + 37 <= 8 * 34) {
        if (ec_dec_bit_logp(hec, 12) != 0) {
            var hcts = ec_dec_bit_logp(hec, 1); var hrb = ec_dec_uint(hec, 256) + 2;
            store64(hec + 8, load64(hec + 8) - hrb);
        }
    }
