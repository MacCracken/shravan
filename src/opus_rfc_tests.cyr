    # sw1 pitch + LTP (voiced, WB) bit-exact vs libopus decode_pitch/decode_parameters
    var pl = alloc(4 * 8);
    silk_decode_pitch(load64(out + 12 * 8), load64(out + 13 * 8), 16, pl, 4);
    assert_eq(load64(pl + 0 * 8), 145, "sw1 pitchL0");
    assert_eq(load64(pl + 1 * 8), 145, "sw1 pitchL1");
    assert_eq(load64(pl + 2 * 8), 145, "sw1 pitchL2");
    assert_eq(load64(pl + 3 * 8), 145, "sw1 pitchL3");
    var ltpc = alloc(20 * 8);
