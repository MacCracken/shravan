    store64(freq + 940 * 8, f64_div(f64_from(-3770), f64_from(100))); store64(freq + 941 * 8, f64_div(f64_from(-25131), f64_from(100))); store64(freq + 942 * 8, f64_div(f64_from(-25131), f64_from(100))); store64(freq + 943 * 8, f64_div(f64_from(-25131), f64_from(100)));
    store64(freq + 944 * 8, f64_div(f64_from(-3133), f64_from(100))); store64(freq + 945 * 8, f64_div(f64_from(-3133), f64_from(100))); store64(freq + 946 * 8, f64_div(f64_from(-3133), f64_from(100))); store64(freq + 947 * 8, f64_div(f64_from(-3133), f64_from(100)));
    store64(freq + 948 * 8, f64_div(f64_from(-3133), f64_from(100))); store64(freq + 949 * 8, f64_div(f64_from(-20884), f64_from(100))); store64(freq + 950 * 8, f64_div(f64_from(-20884), f64_from(100))); store64(freq + 951 * 8, f64_div(f64_from(-20884), f64_from(100)));
    store64(freq + 952 * 8, f64_div(f64_from(-2367), f64_from(100))); store64(freq + 953 * 8, f64_div(f64_from(-2367), f64_from(100))); store64(freq + 954 * 8, f64_div(f64_from(-2367), f64_from(100))); store64(freq + 955 * 8, f64_div(f64_from(-2367), f64_from(100)));
    store64(freq + 956 * 8, f64_div(f64_from(-2367), f64_from(100))); store64(freq + 957 * 8, f64_div(f64_from(-15781), f64_from(100))); store64(freq + 958 * 8, f64_div(f64_from(-15781), f64_from(100))); store64(freq + 959 * 8, f64_div(f64_from(-15781), f64_from(100)));
    var ste = celt_dec_state_new();
    var buf = alloc(160); var ee = ec_enc_new(buf, 160);
    celt_encode_frame_ec(ste, ee, freq, 1, 3, 0, 21, 1, 1);
    ec_enc_done(ee);
    assert(load64(ee + 88) == 0, "transient enc: no error");
    var oldD = alloc(42 * 8); var zi = 0; while (zi < 42) { store64(oldD + zi * 8, F64_ZERO); zi = zi + 1; }
    var tfr = alloc(21 * 8); var offs = alloc(21 * 8); var pul = alloc(21 * 8); var fq = alloc(21 * 8); var fp = alloc(21 * 8); var capd = alloc(21 * 8); var scald = alloc(16 * 8);
    var dd = ec_dec_new(buf, 160);
    celt_decode_frame_prefix_ec(dd, 160, 1, 3, 0, 21, oldD, tfr, offs, pul, fq, fp, capd, scald);
    assert(load64(scald + 8) == 1, "decoder reads isTransient=1");
    var Xd = alloc(960 * 8); zi = 0; while (zi < 960) { store64(Xd + zi * 8, F64_ZERO); zi = zi + 1; }
    var collapse = alloc(21);
    var shortB = 8;
    var acr = load64(scald + 40);
    var seedp = alloc(8); store64(seedp, 0);
    quant_all_bands(Xd, 0, collapse, pul, shortB, load64(scald + 24), load64(scald + 64), load64(scald + 56), tfr, 160 * 64 - acr, load64(scald + 72), dd, 3, load64(scald + 48), seedp, 0, 1, 0, 21, 0);
    var freqd = alloc(960 * 8);
    denormalise_bands(Xd, freqd, oldD, load64(scald + 0), 0, 21, 3);
    var dot = F64_ZERO; var na = F64_ZERO; var nb2 = F64_ZERO; var i = 0;
    while (i < 960) { var a = load64(freq + i * 8); var b = load64(freqd + i * 8); dot = f64_add(dot, f64_mul(a, b)); na = f64_add(na, f64_mul(a, a)); nb2 = f64_add(nb2, f64_mul(b, b)); i = i + 1; }
    var corr = f64_div(dot, f64_sqrt(f64_mul(na, nb2)));
    syscall(1, 2, "transient_spectrum_corr_x1000=", 30); fmt_int_fd(2, f64_to(f64_mul(corr, f64_from(1000)))); syscall(1, 2, "\n", 1);
    # libopus decodes this transient frame sample-identical (corr 1.0, verified externally);
    # 0.85 reflects short-block quantization at 160 bytes, not a correctness bound.
    assert(f64_gt(corr, f64_div(f64_from(85), f64_from(100))) == 1, "transient frame encode->decode spectrum correlation > 0.85");
    return 0;
}

fn test_celt_encode_pcm_rfc() {
    test_group("opus: celt_encode (PCM front-end: preemph + fwd MDCT) -> decode PCM round-trip");
    if (_celt_eBands == 0) { _celt_alloc_tables_init(); }
    var pcm = alloc(1080 * 8);
    store64(pcm + 0 * 8, f64_div(f64_from(9589), f64_from(100000))); store64(pcm + 1 * 8, f64_div(f64_from(16737), f64_from(100000))); store64(pcm + 2 * 8, f64_div(f64_from(23548), f64_from(100000))); store64(pcm + 3 * 8, f64_div(f64_from(29874), f64_from(100000)));
    store64(pcm + 4 * 8, f64_div(f64_from(35579), f64_from(100000))); store64(pcm + 5 * 8, f64_div(f64_from(40547), f64_from(100000))); store64(pcm + 6 * 8, f64_div(f64_from(44682), f64_from(100000))); store64(pcm + 7 * 8, f64_div(f64_from(47913), f64_from(100000)));
    store64(pcm + 8 * 8, f64_div(f64_from(50196), f64_from(100000))); store64(pcm + 9 * 8, f64_div(f64_from(51517), f64_from(100000))); store64(pcm + 10 * 8, f64_div(f64_from(51888), f64_from(100000))); store64(pcm + 11 * 8, f64_div(f64_from(51352), f64_from(100000)));
    store64(pcm + 12 * 8, f64_div(f64_from(49973), f64_from(100000))); store64(pcm + 13 * 8, f64_div(f64_from(47844), f64_from(100000))); store64(pcm + 14 * 8, f64_div(f64_from(45073), f64_from(100000))); store64(pcm + 15 * 8, f64_div(f64_from(41786), f64_from(100000)));
    store64(pcm + 16 * 8, f64_div(f64_from(38119), f64_from(100000))); store64(pcm + 17 * 8, f64_div(f64_from(34215), f64_from(100000))); store64(pcm + 18 * 8, f64_div(f64_from(30217), f64_from(100000))); store64(pcm + 19 * 8, f64_div(f64_from(26263), f64_from(100000)));
    store64(pcm + 20 * 8, f64_div(f64_from(22482), f64_from(100000))); store64(pcm + 21 * 8, f64_div(f64_from(18991), f64_from(100000))); store64(pcm + 22 * 8, f64_div(f64_from(15889), f64_from(100000))); store64(pcm + 23 * 8, f64_div(f64_from(13252), f64_from(100000)));
    store64(pcm + 24 * 8, f64_div(f64_from(11138), f64_from(100000))); store64(pcm + 25 * 8, f64_div(f64_from(9578), f64_from(100000))); store64(pcm + 26 * 8, f64_div(f64_from(8580), f64_from(100000))); store64(pcm + 27 * 8, f64_div(f64_from(8129), f64_from(100000)));
    store64(pcm + 28 * 8, f64_div(f64_from(8186), f64_from(100000))); store64(pcm + 29 * 8, f64_div(f64_from(8695), f64_from(100000))); store64(pcm + 30 * 8, f64_div(f64_from(9581), f64_from(100000))); store64(pcm + 31 * 8, f64_div(f64_from(10758), f64_from(100000)));
