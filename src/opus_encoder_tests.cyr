    store64(g + 112 * 8, f64_div(f64_from(0), f64_from(1000000))); store64(g + 113 * 8, f64_div(f64_from(0), f64_from(1000000))); store64(g + 114 * 8, f64_div(f64_from(0), f64_from(1000000))); store64(g + 115 * 8, f64_div(f64_from(0), f64_from(1000000)));
    store64(g + 116 * 8, f64_div(f64_from(0), f64_from(1000000))); store64(g + 117 * 8, f64_div(f64_from(0), f64_from(1000000))); store64(g + 118 * 8, f64_div(f64_from(0), f64_from(1000000))); store64(g + 119 * 8, f64_div(f64_from(0), f64_from(1000000)));
    var maxd = F64_ZERO; var i = 0;
    while (i < 120) {
        var d = f64_sub(load64(out + i * 8), load64(g + i * 8));
        if (f64_lt(d, F64_ZERO) == 1) { d = f64_neg(d); }
        if (f64_gt(d, maxd) == 1) { maxd = d; }
        i = i + 1;
    }
    syscall(1, 2, "mdctfwd_maxdiff_x1e6=", 21); fmt_int_fd(2, f64_to(f64_mul(maxd, f64_from(1000000)))); syscall(1, 2, "\n", 1);
    assert(f64_lt(maxd, f64_div(f64_from(1), f64_from(10000))) == 1, "clt_mdct_forward matches libopus (<1e-4)");
    return 0;
}

