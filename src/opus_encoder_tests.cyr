    var pcmo = alloc(960 * 8);
    celt_decode_frame_ec(std, dd, 160, 1, 0, 21, 0, 3, pcmo);
    var dot = F64_ZERO; var na = F64_ZERO; var nb2 = F64_ZERO; var i = 120;
    while (i < 840) {
        var a = load64(pcm + i * 8); var b = load64(pcmo + i * 8);
        dot = f64_add(dot, f64_mul(a, b)); na = f64_add(na, f64_mul(a, a)); nb2 = f64_add(nb2, f64_mul(b, b));
        i = i + 1;
    }
    var corr = f64_div(dot, f64_sqrt(f64_mul(na, nb2)));
    syscall(1, 2, "pcm_roundtrip_corr_x1000=", 25); fmt_int_fd(2, f64_to(f64_mul(corr, f64_from(1000)))); syscall(1, 2, "\n", 1);
    # libopus decodes this frame sample-identical (corr 1.0, verified externally); 0.85
    # reflects 64 kbps quantization + single-frame TDAC edges, not a correctness bound.
    assert(f64_gt(corr, f64_div(f64_from(85), f64_from(100))) == 1, "PCM encode->decode round-trip (middle) correlation > 0.85");
    return 0;
}

# Bit-exact conformance vs libopus's own range coder. The 16-byte vector below
# was produced by libopus ec_enc (entenc.c) encoding this exact symbol sequence;
# decoding it here must reproduce the identical values and ec_tell. This is the
# proof that ec_dec interoperates with a real RFC-6716 stream.

fn test_opus_encoder_all() {
    fft_init();
    if (_celt_band_edges == 0) { _opus_init_bands(); }
    test_ec_enc_rfc();
    test_celt_mdct_forward_rfc();
    test_celt_band_energy_rfc();
    test_ec_laplace_encode_rfc();
    test_celt_energy_encode_rfc();
    test_celt_pvq_encode_rfc();
    test_celt_compute_theta_rfc();
    test_celt_quant_band_rfc();
    test_celt_tf_encode_rfc();
    test_celt_encode_frame_rfc();
    test_celt_coarse_race_rfc();
    test_celt_encode_transient_rfc();
    test_celt_encode_pcm_rfc();
    return 0;
}
