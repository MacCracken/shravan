# ================================================================
# opus_encoder_tests.cyr — RFC-6716 Opus CELT ENCODER conformance tests.
# Split out of opus_rfc_tests.cyr so no single build overflows the code buffer.
# Built via src/main_encoder.cyr. NOT part of the [lib] distlib bundle.
# Requires src/opus_test_helpers.cyr (shared helpers) + src/opus.cyr symbols.
# ================================================================

fn test_ec_enc_rfc() {
    test_group("opus: range encoder ec_enc — bit-exact vs libopus + round-trip");
    var icdf = alloc(5);
    store8(icdf + 0, 24); store8(icdf + 1, 16); store8(icdf + 2, 8); store8(icdf + 3, 3); store8(icdf + 4, 0);
    var buf = alloc(6);
    var e = ec_enc_new(buf, 6);
    ec_encode(e, 3, 4, 10);
    ec_enc_bit_logp(e, 1, 3);
    ec_enc_bit_logp(e, 0, 2);
    ec_enc_icdf(e, 2, icdf, 5);
    ec_enc_uint(e, 12345, 65536);
    ec_enc_bits(e, 171, 8);
    ec_encode(e, 0, 1, 16);
    ec_enc_uint(e, 7, 100);
    ec_enc_bits(e, 5, 3);
    ec_enc_done(e);
    # (1) bit-exact vs libopus
    assert(load64(e + 88) == 0, "ec_enc: no error");
    assert(load64(e + 48) == 4, "ec_enc: offs == 4");
    assert(load64(e + 16) == 2, "ec_enc: end_offs == 2");
    assert(load8(buf + 0) == 100, "ec_enc byte0 == 100");
    assert(load8(buf + 1) == 131, "ec_enc byte1 == 131");
    assert(load8(buf + 2) == 52, "ec_enc byte2 == 52");
    assert(load8(buf + 3) == 5, "ec_enc byte3 == 5");
    assert(load8(buf + 4) == 171, "ec_enc byte4 == 171");
    assert(load8(buf + 5) == 57, "ec_enc byte5 == 57");
    # (2) round-trip through the verified decoder
    var d = ec_dec_new(buf, 6);
    var fs0 = ec_decode(d, 10); assert(fs0 == 3, "rt: ec_decode sym 3"); ec_dec_update(d, 3, 4, 10);
    assert(ec_dec_bit_logp(d, 3) == 1, "rt: bit_logp 1");
    assert(ec_dec_bit_logp(d, 2) == 0, "rt: bit_logp 0");
    assert(ec_dec_icdf(d, icdf, 5) == 2, "rt: icdf sym 2");
    assert(ec_dec_uint(d, 65536) == 12345, "rt: uint 12345");
    assert(ec_dec_bits(d, 8) == 171, "rt: bits 171");
    var fs1 = ec_decode(d, 16); assert(fs1 == 0, "rt: ec_decode sym 0"); ec_dec_update(d, 0, 1, 16);
    assert(ec_dec_uint(d, 100) == 7, "rt: uint 7");
    assert(ec_dec_bits(d, 3) == 5, "rt: bits 5");
    return 0;
}

fn test_celt_mdct_forward_rfc() {
