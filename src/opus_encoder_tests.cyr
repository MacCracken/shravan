    store64(gN + 16 * 8, f64_div(f64_from(317676), f64_from(1000000))); store64(gN + 17 * 8, f64_div(f64_from(327801), f64_from(1000000))); store64(gN + 18 * 8, f64_div(f64_from(337885), f64_from(1000000))); store64(gN + 19 * 8, f64_div(f64_from(347926), f64_from(1000000)));
    store64(gN + 20 * 8, f64_div(f64_from(357923), f64_from(1000000))); store64(gN + 21 * 8, f64_div(f64_from(367874), f64_from(1000000))); store64(gN + 22 * 8, f64_div(f64_from(377776), f64_from(1000000))); store64(gN + 23 * 8, f64_div(f64_from(387628), f64_from(1000000)));
    store64(gN + 24 * 8, f64_div(f64_from(325493), f64_from(1000000))); store64(gN + 25 * 8, f64_div(f64_from(333475), f64_from(1000000))); store64(gN + 26 * 8, f64_div(f64_from(341412), f64_from(1000000))); store64(gN + 27 * 8, f64_div(f64_from(349301), f64_from(1000000)));
    store64(gN + 28 * 8, f64_div(f64_from(357141), f64_from(1000000))); store64(gN + 29 * 8, f64_div(f64_from(364931), f64_from(1000000))); store64(gN + 30 * 8, f64_div(f64_from(372669), f64_from(1000000))); store64(gN + 31 * 8, f64_div(f64_from(380354), f64_from(1000000)));
    store64(gN + 32 * 8, f64_div(f64_from(330997), f64_from(1000000))); store64(gN + 33 * 8, f64_div(f64_from(337459), f64_from(1000000))); store64(gN + 34 * 8, f64_div(f64_from(343871), f64_from(1000000))); store64(gN + 35 * 8, f64_div(f64_from(350233), f64_from(1000000)));
    store64(gN + 36 * 8, f64_div(f64_from(356544), f64_from(1000000))); store64(gN + 37 * 8, f64_div(f64_from(362801), f64_from(1000000))); store64(gN + 38 * 8, f64_div(f64_from(369004), f64_from(1000000))); store64(gN + 39 * 8, f64_div(f64_from(375153), f64_from(1000000)));
    var k = 0; var maxd = F64_ZERO;
    while (k < 40) {
        var dd = f64_sub(load64(Xn + k * 8), load64(gN + k * 8));
        if (f64_lt(dd, F64_ZERO) == 1) { dd = f64_neg(dd); }
        if (f64_gt(dd, maxd) == 1) { maxd = dd; }
        k = k + 1;
    }
    assert(f64_lt(maxd, f64_div(f64_from(1), f64_from(10000))) == 1, "normalise_bands matches libopus (<1e-4)");
    var b = 0;
    while (b < 21) {
        var e2 = compute_one_band_norm(Xn, b);
        assert(f64_lt(f64_neg(f64_sub(e2, F64_ONE)), f64_div(f64_from(1), f64_from(1000))) == 1, "norm band ~1 lo");
        assert(f64_lt(f64_sub(e2, F64_ONE), f64_div(f64_from(1), f64_from(1000))) == 1, "norm band ~1 hi");
        b = b + 1;
    }
    return 0;
}

fn compute_one_band_norm(X, bi) {
    var j = 8 * load64(_celt_eBands + bi * 8);
    var j1 = 8 * load64(_celt_eBands + (bi + 1) * 8);
    var s = F64_ZERO;
    while (j < j1) { var v = load64(X + j * 8); s = f64_add(s, f64_mul(v, v)); j = j + 1; }
    return f64_sqrt(s);
}

fn test_ec_laplace_encode_rfc() {
    test_group("opus: ec_laplace_encode — bit-exact vs libopus + round-trip");
    var buf = alloc(32);
    var e = ec_enc_new(buf, 32);
    var m0 = ec_laplace_encode(e, 0, 15000, 8000);
    var m1 = ec_laplace_encode(e, 1, 15000, 8000);
    var m2 = ec_laplace_encode(e, 0 - 2, 12000, 6000);
    var m3 = ec_laplace_encode(e, 3, 10000, 4000);
    var m4 = ec_laplace_encode(e, 5, 8000, 2000);
    var m5 = ec_laplace_encode(e, 0 - 1, 20000, 10000);
    ec_enc_done(e);
    assert(load64(e + 88) == 0, "laplace enc: no error");
    assert(load64(e + 48) == 4, "laplace enc: offs == 4");
    assert(load64(e + 16) == 0, "laplace enc: end_offs == 0");
    assert(load8(buf + 0) == 83, "laplace byte0 == 83");
    assert(load8(buf + 1) == 129, "laplace byte1 == 129");
    assert(load8(buf + 2) == 128, "laplace byte2 == 128");
    assert(load8(buf + 3) == 226, "laplace byte3 == 226");
    assert(m0 == 0, "laplace mod0"); assert(m1 == 1, "laplace mod1"); assert(m2 == 0 - 2, "laplace mod2");
    assert(m3 == 3, "laplace mod3"); assert(m4 == 5, "laplace mod4"); assert(m5 == 0 - 1, "laplace mod5");
    var d = ec_dec_new(buf, 4);
    assert(ec_laplace_decode(d, 15000, 8000) == 0, "rt lap 0");
    assert(ec_laplace_decode(d, 15000, 8000) == 1, "rt lap 1");
    assert(ec_laplace_decode(d, 12000, 6000) == 0 - 2, "rt lap -2");
    assert(ec_laplace_decode(d, 10000, 4000) == 3, "rt lap 3");
    assert(ec_laplace_decode(d, 8000, 2000) == 5, "rt lap 5");
    assert(ec_laplace_decode(d, 20000, 10000) == 0 - 1, "rt lap -1");
    return 0;
}

fn test_celt_energy_encode_rfc() {
    test_group("opus: coarse+fine energy encode -> decode round-trip (bit-exact)");
    var eB = alloc(21 * 8);
    store64(eB + 0 * 8, f64_div(f64_from(80000), f64_from(10000))); store64(eB + 1 * 8, f64_div(f64_from(97677), f64_from(10000))); store64(eB + 2 * 8, f64_div(f64_from(110659), f64_from(10000)));
    store64(eB + 3 * 8, f64_div(f64_from(115400), f64_from(10000))); store64(eB + 4 * 8, f64_div(f64_from(110372), f64_from(10000))); store64(eB + 5 * 8, f64_div(f64_from(96439), f64_from(10000)));
    store64(eB + 6 * 8, f64_div(f64_from(76645), f64_from(10000))); store64(eB + 7 * 8, f64_div(f64_from(55469), f64_from(10000))); store64(eB + 8 * 8, f64_div(f64_from(37728), f64_from(10000)));
    store64(eB + 9 * 8, f64_div(f64_from(27399), f64_from(10000))); store64(eB + 10 * 8, f64_div(f64_from(26643), f64_from(10000))); store64(eB + 11 * 8, f64_div(f64_from(35278), f64_from(10000)));
    store64(eB + 12 * 8, f64_div(f64_from(50823), f64_from(10000))); store64(eB + 13 * 8, f64_div(f64_from(69105), f64_from(10000))); store64(eB + 14 * 8, f64_div(f64_from(85279), f64_from(10000)));
    store64(eB + 15 * 8, f64_div(f64_from(95020), f64_from(10000))); store64(eB + 16 * 8, f64_div(f64_from(95574), f64_from(10000))); store64(eB + 17 * 8, f64_div(f64_from(86439), f64_from(10000)));
    store64(eB + 18 * 8, f64_div(f64_from(69485), f64_from(10000))); store64(eB + 19 * 8, f64_div(f64_from(48494), f64_from(10000))); store64(eB + 20 * 8, f64_div(f64_from(28239), f64_from(10000)));
    var fq = alloc(21 * 8); var fi = 0;
    while (fi < 21) { store64(fq + fi * 8, 3); fi = fi + 1; }
    # encode into a fixed 40-byte packet (as real CELT does — the byte budget is an input),
    # so the range-coder front and raw-bit end share the boundary byte correctly.
    var buf = alloc(40);
    var e = ec_enc_new(buf, 40);
    var oldE = alloc(21 * 8); var err = alloc(21 * 8);
    var z = 0; while (z < 21) { store64(oldE + z * 8, F64_ZERO); z = z + 1; }
    quant_coarse_energy(0, 21, eB, oldE, err, e, 1, 3, 1, 40);
    quant_fine_energy(oldE, err, fq, e, 1, 0, 21);
    ec_enc_done(e);
    assert(load64(e + 88) == 0, "energy enc: no error");
    var oldD = alloc(21 * 8); var z2 = 0; while (z2 < 21) { store64(oldD + z2 * 8, F64_ZERO); z2 = z2 + 1; }
    var d = ec_dec_new(buf, 40);
    var intra_r = ec_dec_bit_logp(d, 3);   # consume the intra flag the encoder wrote
    assert(intra_r == 1, "energy: decoded intra flag == 1");
    celt_unquant_coarse_energy(oldD, intra_r, d, 1, 0, 21, 3);
    celt_unquant_fine_energy(oldD, fq, d, 1, 0, 21);
    var maxd = F64_ZERO; var maxq = F64_ZERO; var i = 0;
    while (i < 21) {
        var de = f64_sub(load64(oldE + i * 8), load64(oldD + i * 8));
        if (f64_lt(de, F64_ZERO) == 1) { de = f64_neg(de); }
        if (f64_gt(de, maxd) == 1) { maxd = de; }
        var qe = f64_sub(load64(oldD + i * 8), load64(eB + i * 8));
        if (f64_lt(qe, F64_ZERO) == 1) { qe = f64_neg(qe); }
        if (f64_gt(qe, maxq) == 1) { maxq = qe; }
        i = i + 1;
    }
    syscall(1, 2, "energy_encdec_maxdiff_x1e9=", 27); fmt_int_fd(2, f64_to(f64_mul(maxd, f64_from(1000000000)))); syscall(1, 2, "\n", 1);
    syscall(1, 2, "energy_quanterr_x1000=", 22); fmt_int_fd(2, f64_to(f64_mul(maxq, f64_from(1000)))); syscall(1, 2, "\n", 1);
    assert(f64_lt(maxd, f64_div(f64_from(1), f64_from(1000000))) == 1, "energy round-trip enc==dec (bit-exact)");
    assert(f64_lt(maxq, f64_div(f64_from(1), f64_from(10))) == 1, "quantized energy within coarse+3-bit-fine (<0.1)");
    return 0;
}

fn test_celt_pvq_encode_rfc() {
    test_group("opus: alg_quant (PVQ search+encode) -> alg_unquant round-trip");
    var X = alloc(16 * 8); var Xo = alloc(16 * 8);
    store64(X + 0 * 8, f64_div(f64_from(3510), f64_from(10000))); store64(Xo + 0 * 8, f64_div(f64_from(3510), f64_from(10000)));
    store64(X + 1 * 8, f64_div(f64_from(8573), f64_from(10000))); store64(Xo + 1 * 8, f64_div(f64_from(8573), f64_from(10000)));
    store64(X + 2 * 8, f64_div(f64_from(11482), f64_from(10000))); store64(Xo + 2 * 8, f64_div(f64_from(11482), f64_from(10000)));
    store64(X + 3 * 8, f64_div(f64_from(11000), f64_from(10000))); store64(Xo + 3 * 8, f64_div(f64_from(11000), f64_from(10000)));
    store64(X + 4 * 8, f64_div(f64_from(7038), f64_from(10000))); store64(Xo + 4 * 8, f64_div(f64_from(7038), f64_from(10000)));
    store64(X + 5 * 8, f64_div(f64_from(698), f64_from(10000))); store64(Xo + 5 * 8, f64_div(f64_from(698), f64_from(10000)));
    store64(X + 6 * 8, f64_div(f64_from(-6090), f64_from(10000))); store64(Xo + 6 * 8, f64_div(f64_from(-6090), f64_from(10000)));
    store64(X + 7 * 8, f64_div(f64_from(-11228), f64_from(10000))); store64(Xo + 7 * 8, f64_div(f64_from(-11228), f64_from(10000)));
    store64(X + 8 * 8, f64_div(f64_from(-13166), f64_from(10000))); store64(Xo + 8 * 8, f64_div(f64_from(-13166), f64_from(10000)));
    store64(X + 9 * 8, f64_div(f64_from(-11425), f64_from(10000))); store64(Xo + 9 * 8, f64_div(f64_from(-11425), f64_from(10000)));
    store64(X + 10 * 8, f64_div(f64_from(-6754), f64_from(10000))); store64(Xo + 10 * 8, f64_div(f64_from(-6754), f64_from(10000)));
    store64(X + 11 * 8, f64_div(f64_from(-861), f64_from(10000))); store64(Xo + 11 * 8, f64_div(f64_from(-861), f64_from(10000)));
    store64(X + 12 * 8, f64_div(f64_from(4191), f64_from(10000))); store64(Xo + 12 * 8, f64_div(f64_from(4191), f64_from(10000)));
    store64(X + 13 * 8, f64_div(f64_from(6703), f64_from(10000))); store64(Xo + 13 * 8, f64_div(f64_from(6703), f64_from(10000)));
    store64(X + 14 * 8, f64_div(f64_from(5931), f64_from(10000))); store64(Xo + 14 * 8, f64_div(f64_from(5931), f64_from(10000)));
    store64(X + 15 * 8, f64_div(f64_from(2337), f64_from(10000))); store64(Xo + 15 * 8, f64_div(f64_from(2337), f64_from(10000)));
    # direct icwrs <-> celt_cwrsi round-trip on a known 7-pulse vector
    var ty = alloc(16 * 8); var ti = 0; while (ti < 16) { store64(ty + ti * 8, 0); ti = ti + 1; }
    store64(ty + 0 * 8, 3); store64(ty + 2 * 8, 0 - 2); store64(ty + 4 * 8, 1); store64(ty + 6 * 8, 0 - 1);
    var ty2 = alloc(16 * 8); celt_cwrsi(16, 7, icwrs(16, ty), ty2);
    var tk = 0; var teq = 1;
    while (tk < 16) { if (load64(ty + tk * 8) != load64(ty2 + tk * 8)) { teq = 0; } tk = tk + 1; }
    assert(teq == 1, "icwrs <-> celt_cwrsi round-trip");
    # full PVQ encode -> decode round-trip (fixed 16-byte packet)
    var buf = alloc(16);
    var e = ec_enc_new(buf, 16);
    var cm = alg_quant(X, 16, 7, 2, 1, e, F64_ONE);
    ec_enc_done(e);
    assert(load64(e + 88) == 0, "pvq enc: no error");
    var X2 = alloc(16 * 8);
    var d = ec_dec_new(buf, 16);
    var cm2 = alg_unquant(d, X2, 16, 7, 2, 1, F64_ONE);
    assert(cm == cm2, "pvq: collapse mask enc==dec");
    var maxd = F64_ZERO; var i = 0;
    while (i < 16) {
        var dd = f64_sub(load64(X + i * 8), load64(X2 + i * 8));
        if (f64_lt(dd, F64_ZERO) == 1) { dd = f64_neg(dd); }
        if (f64_gt(dd, maxd) == 1) { maxd = dd; }
        i = i + 1;
    }
    assert(f64_lt(maxd, f64_div(f64_from(1), f64_from(1000000))) == 1, "pvq: resynth enc==dec (bit-exact)");
    var dot = F64_ZERO; var nx = F64_ZERO; var no = F64_ZERO; i = 0;
    while (i < 16) {
        var xv = load64(X + i * 8); var ov = load64(Xo + i * 8);
        dot = f64_add(dot, f64_mul(xv, ov)); nx = f64_add(nx, f64_mul(xv, xv)); no = f64_add(no, f64_mul(ov, ov));
        i = i + 1;
    }
    var cosim = f64_div(dot, f64_sqrt(f64_mul(nx, no)));
    assert(f64_gt(cosim, f64_div(f64_from(85), f64_from(100))) == 1, "pvq: quantized shape cosine > 0.85");
    return 0;
}
fn test_celt_compute_theta_rfc() {
    test_group("opus: compute_theta encode -> decode round-trip (mono split angle)");
    if (_celt_eBands == 0) { _celt_alloc_tables_init(); }
    var N = 8; var b = 240; var B = 1; var B0 = 1; var LM = 3;
    var Xd = alloc(16 * 8);
    var j = 0; while (j < 8) { store64(Xd + j * 8, F64_ONE); j = j + 1; }
    while (j < 16) { store64(Xd + j * 8, f64_div(f64_from(35), f64_from(100))); j = j + 1; }
    # --- encode ---
    var buf = alloc(16); var ee = ec_enc_new(buf, 16);
    var ctxe = alloc(96); var ci = 0; while (ci < 12) { store64(ctxe + ci * 8, 0); ci = ci + 1; }
    store64(ctxe + 0, ee); store64(ctxe + 16, 10000); store64(ctxe + 24, 10); store64(ctxe + 32, 2); store64(ctxe + 48, 100); store64(ctxe + 72, 1);
    var sctxe = alloc(64);
    compute_theta(ctxe, Xd, Xd + 8 * 8, N, b, B, B0, LM, 0, 15, sctxe);
    ec_enc_done(ee);
    var itheta_e = load64(sctxe + 24);
    # --- decode ---
    var dd = ec_dec_new(buf, 16);
    var ctxd = alloc(96); ci = 0; while (ci < 12) { store64(ctxd + ci * 8, 0); ci = ci + 1; }
    store64(ctxd + 0, dd); store64(ctxd + 16, 10000); store64(ctxd + 24, 10); store64(ctxd + 32, 2); store64(ctxd + 48, 100); store64(ctxd + 72, 0);
    var sctxd = alloc(64);
    compute_theta(ctxd, 0, 0, N, b, B, B0, LM, 0, 15, sctxd);
    var itheta_d = load64(sctxd + 24);
    syscall(1, 2, "theta_enc=", 10); fmt_int_fd(2, itheta_e); syscall(1, 2, " theta_dec=", 11); fmt_int_fd(2, itheta_d); syscall(1, 2, "\n", 1);
    assert(itheta_e != 0, "compute_theta: itheta actually coded (qn>1)");
    assert(itheta_e == itheta_d, "compute_theta: itheta enc==dec");
    assert(load64(sctxe + 0) == load64(sctxd + 0), "compute_theta: imid enc==dec");
    assert(load64(sctxe + 8) == load64(sctxd + 8), "compute_theta: iside enc==dec");
    assert(load64(sctxe + 16) == load64(sctxd + 16), "compute_theta: delta enc==dec");
    return 0;
}

fn test_celt_quant_band_rfc() {
    test_group("opus: quant_band encode -> decode round-trip (mono band, bit-exact)");
    if (_celt_eBands == 0) { _celt_alloc_tables_init(); }
    var X = alloc(16 * 8);
    store64(X + 0 * 8, f64_div(f64_from(7955), f64_from(10000)));
    store64(X + 1 * 8, f64_div(f64_from(12413), f64_from(10000)));
    store64(X + 2 * 8, f64_div(f64_from(14460), f64_from(10000)));
    store64(X + 3 * 8, f64_div(f64_from(13416), f64_from(10000)));
    store64(X + 4 * 8, f64_div(f64_from(9468), f64_from(10000)));
    store64(X + 5 * 8, f64_div(f64_from(3616), f64_from(10000)));
    store64(X + 6 * 8, f64_div(f64_from(-2613), f64_from(10000)));
    store64(X + 7 * 8, f64_div(f64_from(-7610), f64_from(10000)));
    store64(X + 8 * 8, f64_div(f64_from(-10145), f64_from(10000)));
    store64(X + 9 * 8, f64_div(f64_from(-9725), f64_from(10000)));
    store64(X + 10 * 8, f64_div(f64_from(-6727), f64_from(10000)));
    store64(X + 11 * 8, f64_div(f64_from(-2275), f64_from(10000)));
    store64(X + 12 * 8, f64_div(f64_from(2097), f64_from(10000)));
    store64(X + 13 * 8, f64_div(f64_from(4911), f64_from(10000)));
    store64(X + 14 * 8, f64_div(f64_from(5182), f64_from(10000)));
    store64(X + 15 * 8, f64_div(f64_from(2724), f64_from(10000)));
    var buf = alloc(32); var ee = ec_enc_new(buf, 32);
    var ce = alloc(96); var ci = 0; while (ci < 12) { store64(ce + ci * 8, 0); ci = ci + 1; }
    store64(ce + 0, ee); store64(ce + 8, 12345); store64(ce + 16, 3000); store64(ce + 24, 12); store64(ce + 32, 2); store64(ce + 48, 100); store64(ce + 72, 1);
    var Xe = alloc(16 * 8); var jj = 0; while (jj < 16) { store64(Xe + jj * 8, load64(X + jj * 8)); jj = jj + 1; }
    quant_band(ce, Xe, 16, 160, 1, 0, 3, 0, F64_ONE, 0, 3);
    ec_enc_done(ee);
    assert(load64(ee + 88) == 0, "quant_band enc: no error");
    var dd = ec_dec_new(buf, 32);
    var cd = alloc(96); ci = 0; while (ci < 12) { store64(cd + ci * 8, 0); ci = ci + 1; }
    store64(cd + 0, dd); store64(cd + 8, 12345); store64(cd + 16, 3000); store64(cd + 24, 12); store64(cd + 32, 2); store64(cd + 48, 100); store64(cd + 72, 0);
    var Xd = alloc(16 * 8);
    quant_band(cd, Xd, 16, 160, 1, 0, 3, 0, F64_ONE, 0, 3);
    var maxd = F64_ZERO; var i = 0;
    while (i < 16) {
        var dv = f64_sub(load64(Xe + i * 8), load64(Xd + i * 8));
        if (f64_lt(dv, F64_ZERO) == 1) { dv = f64_neg(dv); }
        if (f64_gt(dv, maxd) == 1) { maxd = dv; }
        i = i + 1;
    }
    syscall(1, 2, "qband_maxdiff_x1e6=", 19); fmt_int_fd(2, f64_to(f64_mul(maxd, f64_from(1000000)))); syscall(1, 2, "\n", 1);
    assert(f64_lt(maxd, f64_div(f64_from(1), f64_from(1000000))) == 1, "quant_band: resynth enc==dec (bit-exact)");
    return 0;
}

fn test_celt_tf_encode_rfc() {
    test_group("opus: celt_tf_encode -> celt_tf_decode round-trip (LM=3)");
    if (_celt_eBands == 0) { _celt_alloc_tables_init(); }
    var tfe = alloc(21 * 8);
    store64(tfe + 0 * 8, 0);
    store64(tfe + 1 * 8, 0);
    store64(tfe + 2 * 8, 1);
    store64(tfe + 3 * 8, 0);
    store64(tfe + 4 * 8, 1);
    store64(tfe + 5 * 8, 1);
    store64(tfe + 6 * 8, 0);
    store64(tfe + 7 * 8, 0);
    store64(tfe + 8 * 8, 1);
    store64(tfe + 9 * 8, 0);
    store64(tfe + 10 * 8, 0);
    store64(tfe + 11 * 8, 1);
    store64(tfe + 12 * 8, 0);
    store64(tfe + 13 * 8, 0);
    store64(tfe + 14 * 8, 0);
    store64(tfe + 15 * 8, 1);
    store64(tfe + 16 * 8, 0);
    store64(tfe + 17 * 8, 0);
    store64(tfe + 18 * 8, 1);
    store64(tfe + 19 * 8, 0);
    store64(tfe + 20 * 8, 0);
    var buf = alloc(16); var ee = ec_enc_new(buf, 16);
    celt_tf_encode(tfe, 0, 0, ee, 0, 21);
    ec_enc_done(ee);
    assert(load64(ee + 88) == 0, "tf_encode: no error");
    var dd = ec_dec_new(buf, 16);
    var tfd = alloc(21 * 8);
    celt_tf_decode(tfd, 0, dd, 0, 21);
    var i = 0; var ok = 1;
    while (i < 21) { if (load64(tfe + i * 8) != load64(tfd + i * 8)) { ok = 0; } i = i + 1; }
    assert(ok == 1, "tf_encode->tf_decode round-trip (mapped tf_res)");
    var tfe2 = alloc(21 * 8); var j = 0;
    while (j < 21) { store64(tfe2 + j * 8, (j * 7) & 1); j = j + 1; }
    var buf2 = alloc(16); var ee2 = ec_enc_new(buf2, 16);
    celt_tf_encode(tfe2, 1, 1, ee2, 0, 21);
    ec_enc_done(ee2);
    var dd2 = ec_dec_new(buf2, 16);
    var tfd2 = alloc(21 * 8);
    celt_tf_decode(tfd2, 1, dd2, 0, 21);
    i = 0; var ok2 = 1;
    while (i < 21) { if (load64(tfe2 + i * 8) != load64(tfd2 + i * 8)) { ok2 = 0; } i = i + 1; }
    assert(ok2 == 1, "tf_encode->tf_decode round-trip (transient, tf_select=1)");
    return 0;
}

