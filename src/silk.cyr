}

# ---- pitch lag + LTP coefficient decode (decode_pitch.c / decode_parameters.c) ----
# silk_decode_pitch: contour codebook maps (subframe, contourIndex) -> lag offset.
# nb_subfr fixed at 4 (20 ms). pitchL_out[4].
fn silk_decode_pitch(lagIndex, contourIndex, fs_kHz, pitchL_out, nb_subfr) {
    if (_silk_cblags2 == 0) { _silk_tables4_init(); }
    if (_silk_cblags3_10 == 0) { _silk_tables6_init(); }
    # lag codebook depends on bandwidth (NB stage2 / WB stage3) and frame size (10/20ms).
    var lag_cb = _silk_cblags3;
    var cbk_size = 34;
    if (nb_subfr == 2) { lag_cb = _silk_cblags3_10; cbk_size = 12; }
    if (fs_kHz == 8) {
        lag_cb = _silk_cblags2; cbk_size = 11;
        if (nb_subfr == 2) { lag_cb = _silk_cblags2_10; cbk_size = 3; }
    }
    var min_lag = 2 * fs_kHz;
    var max_lag = 18 * fs_kHz;
    var lag = min_lag + lagIndex;
    var k = 0;
    while (k < nb_subfr) {
        var pl = lag + load64(lag_cb + (k * cbk_size + contourIndex) * 8);
        store64(pitchL_out + k * 8, silk_limit(pl, min_lag, max_lag));
        k = k + 1;
    }
    return 0;
}

# silk_decode_ltp: fill LTPCoef_Q14[4*5] from PERIndex + per-subframe LTPIndex.
# ltp_idx points at LTPIndex[0] (4 consecutive i64 slots).
fn silk_decode_ltp(PERIndex, ltp_idx, ltpcoef_out, nb_subfr) {
    if (_silk_ltpvq0 == 0) { _silk_tables4_init(); }
    var cbk = _silk_ltpvq0;
    if (PERIndex == 1) { cbk = _silk_ltpvq1; }
    if (PERIndex == 2) { cbk = _silk_ltpvq2; }
    var k = 0;
    while (k < nb_subfr) {
        var Ix = load64(ltp_idx + k * 8);
        var i = 0;
        while (i < 5) {
            store64(ltpcoef_out + (k * 5 + i) * 8, load64(cbk + (Ix * 5 + i) * 8) << 7);
            i = i + 1;
        }
        k = k + 1;
    }
    return 0;
}

# silk_ltp_scale: LTP_scale_Q14 from LTP_scaleIndex (0..2).
fn silk_ltp_scale(LTP_scaleIndex) {
    if (_silk_ltpscales_q14 == 0) { _silk_tables4_init(); }
    return load64(_silk_ltpscales_q14 + LTP_scaleIndex * 8);
}

