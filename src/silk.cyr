# ---- NLSF -> LPC (NLSF2A.c): fixed-point AR filter coefficients ----
# Additional integer-width helpers (verbatim libopus macro semantics).
fn silk_smull(a, b) { return a * b; }                       # int64 product
fn silk_smmul(a, b) { return sar(a * b, 32); }              # RSHIFT64(SMULL,32)
fn silk_smulww(a, b) { return sar(a * b, 16); }             # RSHIFT64(SMULL,16)
fn silk_smlaww(a, b, c) { return silk_sx32(a + sar(b * c, 16)); }
fn silk_abs64(a) { if (a < 0) { return 0 - a; } return a; }
fn silk_sat32(v) {
    if (v > 2147483647) { return 2147483647; }
    if (v < 0 - 2147483648) { return 0 - 2147483648; }
    return v;
}
fn silk_sub_sat32(a, b) { return silk_sat32(a - b); }
fn silk_sat16(a) {
    if (a > 32767) { return 32767; }
    if (a < 0 - 32768) { return 0 - 32768; }
    return a;
}
# silk_CLZ32: count leading zeros of a 32-bit value (reuses ec_ilog from opus.cyr).
fn silk_clz32(v) { return 32 - ec_ilog(v & 0xFFFFFFFF); }
# silk_LSHIFT_SAT32(a, shift): clamp then shift left (shift >= 0).
fn silk_lshift_sat32(a, shift) {
    var lo = sar(0 - 2147483648, shift);
    var hi = sar(2147483647, shift);
    if (a < lo) { a = lo; }
    if (a > hi) { a = hi; }
    return a << shift;
}
# silk_INVERSE32_varQ: ~(1<<Qres)/b32, b32 != 0, Qres > 0.
fn silk_inverse32_varq(b32, Qres) {
    var b_headrm = silk_clz32(silk_abs64(b32)) - 1;
    var b32_nrm = b32 << b_headrm;
    var b32_inv = silk_div_trunc(sar(2147483647, 2), sar(b32_nrm, 16));
    var result = b32_inv << 16;
    var err_Q32 = ((1 << 29) - silk_smulwb(b32_nrm, b32_inv)) << 3;
    result = silk_smlaww(result, err_Q32, b32_inv);
    var lshift = 61 - b_headrm - Qres;
    if (lshift <= 0) { return silk_lshift_sat32(result, 0 - lshift); }
    if (lshift < 32) { return sar(result, lshift); }
    return 0;
}

# silk_NLSF2A_find_poly: intermediate polynomial out[dd+1] (QA=16) from
# interleaved 2*cos(LSF) values at clsf (stride 2), order dd.
fn silk_nlsf2a_find_poly(out, clsf, dd) {
    store64(out + 0 * 8, 1 << 16);
    store64(out + 1 * 8, 0 - load64(clsf + 0 * 8));
    var k = 1;
    while (k < dd) {
        var ftmp = load64(clsf + (2 * k) * 8);
        store64(out + (k + 1) * 8,
            (load64(out + (k - 1) * 8) << 1) - silk_rshift_round(silk_smull(ftmp, load64(out + k * 8)), 16));
        var n = k;
        while (n > 1) {
            store64(out + n * 8,
                load64(out + n * 8) + load64(out + (n - 2) * 8) - silk_rshift_round(silk_smull(ftmp, load64(out + (n - 1) * 8)), 16));
            n = n - 1;
        }
        store64(out + 1 * 8, load64(out + 1 * 8) - ftmp);
        k = k + 1;
    }
    return 0;
}

# silk_bwexpander_32: chirp (bandwidth-expand) AR filter ar[d] in place, Q-domain preserved.
fn silk_bwexpander_32(ar, d, chirp_Q16) {
    var chirp_minus_one = chirp_Q16 - 65536;
    var i = 0;
    while (i < d - 1) {
        store64(ar + i * 8, silk_smulww(chirp_Q16, load64(ar + i * 8)));
        chirp_Q16 = chirp_Q16 + silk_rshift_round(silk_mul(chirp_Q16, chirp_minus_one), 16);
        i = i + 1;
    }
    store64(ar + (d - 1) * 8, silk_smulww(chirp_Q16, load64(ar + (d - 1) * 8)));
    return 0;
}

# silk_LPC_fit: limit a_QIN[d] to fit int16, output a_QOUT[d] in QOUT (QIN>QOUT).
fn silk_lpc_fit(a_QOUT, a_QIN, QOUT, QIN, d) {
    var idx = 0;
    var i = 0;
    var broke = 0;
    while (i < 10) {
        var maxabs = 0;
        var k = 0;
        while (k < d) {
            var absval = silk_abs64(load64(a_QIN + k * 8));
            if (absval > maxabs) { maxabs = absval; idx = k; }
            k = k + 1;
        }
        maxabs = silk_rshift_round(maxabs, QIN - QOUT);
        if (maxabs > 32767) {
            if (maxabs > 163838) { maxabs = 163838; }
            var denom = sar(silk_mul(maxabs, idx + 1), 2);
            var chirp_Q16 = 65470 - silk_div_trunc((maxabs - 32767) << 14, denom);
            silk_bwexpander_32(a_QIN, d, chirp_Q16);
        } else { i = 10; broke = 1; }
        i = i + 1;
    }
    var k2 = 0;
    if (broke == 0) {
        # ran all 10 iterations: clip
        while (k2 < d) {
            var v = silk_sat16(silk_rshift_round(load64(a_QIN + k2 * 8), QIN - QOUT));
            store64(a_QOUT + k2 * 8, v);
            store64(a_QIN + k2 * 8, v << (QIN - QOUT));
            k2 = k2 + 1;
        }
    } else {
        while (k2 < d) {
            store64(a_QOUT + k2 * 8, silk_rshift_round(load64(a_QIN + k2 * 8), QIN - QOUT));
            k2 = k2 + 1;
        }
    }
    return 0;
}

# silk_LPC_inverse_pred_gain (Q12 input): returns inverse pred gain (Q30), 0 if unstable.
# Works on a scratch QA=24 copy; A_QA is caller scratch of `order` i64 slots.
fn silk_lpc_inv_pred_gain(A_Q12, order, A_QA) {
    var DC_resp = 0;
    var k = 0;
    while (k < order) {
        DC_resp = DC_resp + load64(A_Q12 + k * 8);
        store64(A_QA + k * 8, load64(A_Q12 + k * 8) << 12);   # Q12 -> QA(24)
        k = k + 1;
    }
    if (DC_resp >= 4096) { return 0; }
    var invGain = 1 << 30;
    k = order - 1;
    while (k > 0) {
        var ak = load64(A_QA + k * 8);
        if (ak > 16773022) { return 0; }
        if (ak < 0 - 16773022) { return 0; }
        var rc_Q31 = 0 - (ak << 7);
        var rc_mult1 = (1 << 30) - silk_smmul(rc_Q31, rc_Q31);
        invGain = silk_smmul(invGain, rc_mult1) << 2;
        if (invGain < 107374) { return 0; }
        var mult2Q = 32 - silk_clz32(silk_abs64(rc_mult1));
        var rc_mult2 = silk_inverse32_varq(rc_mult1, mult2Q + 30);
        var n = 0;
        var half = (k + 1) >> 1;
        while (n < half) {
            var tmp1 = load64(A_QA + n * 8);
            var tmp2 = load64(A_QA + (k - n - 1) * 8);
            var t1 = silk_rshift_round(silk_smull(silk_sub_sat32(tmp1, silk_rshift_round(silk_smull(tmp2, rc_Q31), 31)), rc_mult2), mult2Q);
            if (t1 > 2147483647) { return 0; }
            if (t1 < 0 - 2147483648) { return 0; }
            store64(A_QA + n * 8, t1);
            var t2 = silk_rshift_round(silk_smull(silk_sub_sat32(tmp2, silk_rshift_round(silk_smull(tmp1, rc_Q31), 31)), rc_mult2), mult2Q);
            if (t2 > 2147483647) { return 0; }
            if (t2 < 0 - 2147483648) { return 0; }
            store64(A_QA + (k - n - 1) * 8, t2);
            n = n + 1;
        }
        k = k - 1;
    }
    var a0 = load64(A_QA + 0);
    if (a0 > 16773022) { return 0; }
    if (a0 < 0 - 16773022) { return 0; }
    var rc0 = 0 - (a0 << 7);
    var rcm = (1 << 30) - silk_smmul(rc0, rc0);
    invGain = silk_smmul(invGain, rcm) << 2;
    if (invGain < 107374) { return 0; }
    return invGain;
}

# silk_NLSF2A: NLSF[d] (Q15) -> a_Q12[d] monic whitening filter coefficients.
fn silk_nlsf2a(a_Q12, NLSF, d) {
    if (_silk_lsfcos_q12 == 0) { _silk_lsfcos_init(); }
    # ordering tables (inline; d is 10 or 16).
    var ordering = alloc(d * 8);
    if (d == 16) {
        var o16 = alloc(16 * 8);
        store64(o16 + 0, 0); store64(o16 + 8, 15); store64(o16 + 16, 8); store64(o16 + 24, 7);
        store64(o16 + 32, 4); store64(o16 + 40, 11); store64(o16 + 48, 12); store64(o16 + 56, 3);
        store64(o16 + 64, 2); store64(o16 + 72, 13); store64(o16 + 80, 10); store64(o16 + 88, 5);
        store64(o16 + 96, 6); store64(o16 + 104, 9); store64(o16 + 112, 14); store64(o16 + 120, 1);
        ordering = o16;
    } else {
        var o10 = alloc(10 * 8);
        store64(o10 + 0, 0); store64(o10 + 8, 9); store64(o10 + 16, 6); store64(o10 + 24, 3);
        store64(o10 + 32, 4); store64(o10 + 40, 5); store64(o10 + 48, 8); store64(o10 + 56, 1);
        store64(o10 + 64, 2); store64(o10 + 72, 7);
        ordering = o10;
    }
    var cos_QA = alloc(d * 8);
    var k = 0;
    while (k < d) {
        var nlsf = load64(NLSF + k * 8);
        var f_int = sar(nlsf, 8);                 # RSHIFT(NLSF,15-7)
        var f_frac = nlsf - (f_int << 8);
        var cos_val = load64(_silk_lsfcos_q12 + f_int * 8);
        var delta = load64(_silk_lsfcos_q12 + (f_int + 1) * 8) - cos_val;
        # RSHIFT_ROUND( LSHIFT(cos_val,8) + MUL(delta,f_frac), 20-QA=4 )
        var cqa = silk_rshift_round((cos_val << 8) + silk_mul(delta, f_frac), 4);
        store64(cos_QA + load64(ordering + k * 8) * 8, cqa);
        k = k + 1;
    }
    var dd = sar(d, 1);
    var P = alloc((dd + 1) * 8);
    var Q = alloc((dd + 1) * 8);
    silk_nlsf2a_find_poly(P, cos_QA + 0 * 8, dd);
    silk_nlsf2a_find_poly(Q, cos_QA + 1 * 8, dd);
    var a32 = alloc(d * 8);
    k = 0;
    while (k < dd) {
        var Ptmp = load64(P + (k + 1) * 8) + load64(P + k * 8);
        var Qtmp = load64(Q + (k + 1) * 8) - load64(Q + k * 8);
        store64(a32 + k * 8, (0 - Qtmp) - Ptmp);
        store64(a32 + (d - k - 1) * 8, Qtmp - Ptmp);
        k = k + 1;
    }
    silk_lpc_fit(a_Q12, a32, 12, 17, d);
    var A_QA = alloc(d * 8);
    var i = 0;
    while ((silk_lpc_inv_pred_gain(a_Q12, d, A_QA) == 0) & (i < 16)) {
        silk_bwexpander_32(a32, d, 65536 - (2 << i));
        k = 0;
        while (k < d) {
            store64(a_Q12 + k * 8, silk_rshift_round(load64(a32 + k * 8), 5));   # QA+1-12 = 5
            k = k + 1;
        }
        i = i + 1;
    }
    return 0;
}

