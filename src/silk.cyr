# ---- excitation decode (decode_pulses.c / shell_coder.c / code_signs.c) ----
# decode_split: split parent pulse count p into two children via shell cdf table.
fn silk_decode_split(ec, p, shell_table, out2) {
    # out2[0]=child1, out2[1]=child2
    if (p > 0) {
        var c1 = ec_dec_icdf(ec, shell_table + load8(_silk_shell_off + p), 8);
        store64(out2 + 0, c1);
        store64(out2 + 8, p - c1);
    } else {
        store64(out2 + 0, 0);
        store64(out2 + 8, 0);
    }
    return 0;
}

# silk_shell_decoder: decode one 16-pulse shell block into pulses0[16] (i64 slots).
fn silk_shell_decoder(pulses0, ec, pulses4) {
    var p3 = alloc(2 * 8);
    var p2 = alloc(4 * 8);
    var p1 = alloc(8 * 8);
    var tmp = alloc(2 * 8);
    silk_decode_split(ec, pulses4, _silk_shell3, tmp);
    store64(p3 + 0, load64(tmp + 0)); store64(p3 + 8, load64(tmp + 8));

    silk_decode_split(ec, load64(p3 + 0), _silk_shell2, tmp);
    store64(p2 + 0, load64(tmp + 0)); store64(p2 + 8, load64(tmp + 8));

    silk_decode_split(ec, load64(p2 + 0), _silk_shell1, tmp);
    store64(p1 + 0, load64(tmp + 0)); store64(p1 + 8, load64(tmp + 8));
    silk_decode_split(ec, load64(p1 + 0), _silk_shell0, tmp);
    store64(pulses0 + 0 * 8, load64(tmp + 0)); store64(pulses0 + 1 * 8, load64(tmp + 8));
    silk_decode_split(ec, load64(p1 + 8), _silk_shell0, tmp);
    store64(pulses0 + 2 * 8, load64(tmp + 0)); store64(pulses0 + 3 * 8, load64(tmp + 8));

    silk_decode_split(ec, load64(p2 + 8), _silk_shell1, tmp);
    store64(p1 + 2 * 8, load64(tmp + 0)); store64(p1 + 3 * 8, load64(tmp + 8));
    silk_decode_split(ec, load64(p1 + 2 * 8), _silk_shell0, tmp);
    store64(pulses0 + 4 * 8, load64(tmp + 0)); store64(pulses0 + 5 * 8, load64(tmp + 8));
    silk_decode_split(ec, load64(p1 + 3 * 8), _silk_shell0, tmp);
    store64(pulses0 + 6 * 8, load64(tmp + 0)); store64(pulses0 + 7 * 8, load64(tmp + 8));

    silk_decode_split(ec, load64(p3 + 8), _silk_shell2, tmp);
    store64(p2 + 2 * 8, load64(tmp + 0)); store64(p2 + 3 * 8, load64(tmp + 8));

    silk_decode_split(ec, load64(p2 + 2 * 8), _silk_shell1, tmp);
    store64(p1 + 4 * 8, load64(tmp + 0)); store64(p1 + 5 * 8, load64(tmp + 8));
    silk_decode_split(ec, load64(p1 + 4 * 8), _silk_shell0, tmp);
    store64(pulses0 + 8 * 8, load64(tmp + 0)); store64(pulses0 + 9 * 8, load64(tmp + 8));
    silk_decode_split(ec, load64(p1 + 5 * 8), _silk_shell0, tmp);
    store64(pulses0 + 10 * 8, load64(tmp + 0)); store64(pulses0 + 11 * 8, load64(tmp + 8));

    silk_decode_split(ec, load64(p2 + 3 * 8), _silk_shell1, tmp);
    store64(p1 + 6 * 8, load64(tmp + 0)); store64(p1 + 7 * 8, load64(tmp + 8));
    silk_decode_split(ec, load64(p1 + 6 * 8), _silk_shell0, tmp);
    store64(pulses0 + 12 * 8, load64(tmp + 0)); store64(pulses0 + 13 * 8, load64(tmp + 8));
    silk_decode_split(ec, load64(p1 + 7 * 8), _silk_shell0, tmp);
    store64(pulses0 + 14 * 8, load64(tmp + 0)); store64(pulses0 + 15 * 8, load64(tmp + 8));
    return 0;
}

# silk_decode_signs: attach signs to nonzero pulses in place. sum_pulses[iter] i64.
fn silk_decode_signs(ec, pulses, length, signalType, quantOffsetType, sum_pulses) {
    var icdf2 = alloc(2);
    store8(icdf2 + 1, 0);
    var base = quantOffsetType + (signalType << 1);
    var icdf_ptr = _silk_sign_icdf + 7 * base;
    var nblk = (length + 8) >> 4;
    var i = 0;
    while (i < nblk) {
        var p = load64(sum_pulses + i * 8);
        if (p > 0) {
            var idx = p & 0x1F;
            if (idx > 6) { idx = 6; }
            store8(icdf2 + 0, load8(icdf_ptr + idx));
            var j = 0;
            while (j < 16) {
                var qj = load64(pulses + (i * 16 + j) * 8);
                if (qj > 0) {
                    var m = ec_dec_icdf(ec, icdf2, 8);
                    store64(pulses + (i * 16 + j) * 8, qj * ((m << 1) - 1));   # silk_dec_map
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

# silk_decode_pulses: decode the full excitation vector pulses[frame_length] (i64 slots).
fn silk_decode_pulses(ec, pulses, signalType, quantOffsetType, frame_length) {
    if (_silk_ratelvl_icdf == 0) { _silk_tables5_init(); }
    var RateLevelIndex = ec_dec_icdf(ec, _silk_ratelvl_icdf + (signalType >> 1) * 9, 8);
    var iter = frame_length >> 4;
    var sum_pulses = alloc(20 * 8);
    var nLshifts = alloc(20 * 8);
    var cdf = _silk_ppb_icdf + RateLevelIndex * 18;
    var i = 0;
    while (i < iter) {
        store64(nLshifts + i * 8, 0);
        var sp = ec_dec_icdf(ec, cdf, 8);
        while (sp == 17) {                                  # SILK_MAX_PULSES+1
            store64(nLshifts + i * 8, load64(nLshifts + i * 8) + 1);
            var extra = 0;
            if (load64(nLshifts + i * 8) == 10) { extra = 1; }
            sp = ec_dec_icdf(ec, _silk_ppb_icdf + 9 * 18 + extra, 8);
        }
        store64(sum_pulses + i * 8, sp);
        i = i + 1;
    }
    i = 0;
    while (i < iter) {
        if (load64(sum_pulses + i * 8) > 0) {
            silk_shell_decoder(pulses + (i * 16) * 8, ec, load64(sum_pulses + i * 8));
        } else {
            var z = 0;
            while (z < 16) { store64(pulses + (i * 16 + z) * 8, 0); z = z + 1; }
        }
        i = i + 1;
    }
    i = 0;
    while (i < iter) {
        var nLS = load64(nLshifts + i * 8);
        if (nLS > 0) {
            var k = 0;
            while (k < 16) {
                var abs_q = load64(pulses + (i * 16 + k) * 8);
                var j = 0;
                while (j < nLS) {
                    abs_q = abs_q << 1;
                    abs_q = abs_q + ec_dec_icdf(ec, _silk_lsb_icdf, 8);
                    j = j + 1;
                }
                store64(pulses + (i * 16 + k) * 8, abs_q);
                k = k + 1;
            }
            store64(sum_pulses + i * 8, load64(sum_pulses + i * 8) | (nLS << 5));
        }
        i = i + 1;
    }
    silk_decode_signs(ec, pulses, frame_length, signalType, quantOffsetType, sum_pulses);
    return 0;
}

# ---- LTP+LPC synthesis (decode_core.c) ----
fn silk_sub32_ovflw(a, b) { return silk_sx32(a - b); }
fn silk_lshift_ovflw(a, shift) { return silk_sx32(a << shift); }
fn silk_add_sat32(a, b) { return silk_sat32(a + b); }

# silk_DIV32_varQ: ~ (a32 << Qres) / b32, b32 != 0, Qres >= 0.
fn silk_div32_varq(a32, b32, Qres) {
    var a_hr = silk_clz32(silk_abs64(a32)) - 1;
    var a_nrm = a32 << a_hr;
    var b_hr = silk_clz32(silk_abs64(b32)) - 1;
    var b_nrm = b32 << b_hr;
    var b_inv = silk_div_trunc(sar(2147483647, 2), sar(b_nrm, 16));
    var result = silk_smulwb(a_nrm, b_inv);
    a_nrm = silk_sub32_ovflw(a_nrm, silk_lshift_ovflw(silk_smmul(b_nrm, result), 3));
    result = silk_smlawb(result, a_nrm, b_inv);
    var lshift = 29 + a_hr - b_hr - Qres;
    if (lshift < 0) { return silk_lshift_sat32(result, 0 - lshift); }
    if (lshift < 32) { return sar(result, lshift); }
    return 0;
}

# silk_SMLABB_ovflw(a,b,c) = ADD32_ovflw(a, (int16)b * (int16)c)
fn silk_smlabb_ovflw(a, b, c) { return silk_sx32(a + _i16(b) * _i16(c)); }

# silk_LPC_analysis_filter (#else scalar branch): out[len] from in[len], MA coefs B[d] (Q12).
# in/out are int16 values held in i64 slots.
fn silk_lpc_analysis_filter(out, inp, B, len, d) {
    var ix = d;
    while (ix < len) {
        # in_ptr = &in[ix-1]; out32_Q12 = sum_{j=0..d-1} in_ptr[-j]*B[j]  (ovflw)
        var acc = silk_smulbb(load64(inp + (ix - 1) * 8), load64(B + 0));
        var j = 1;
        while (j < d) {
            acc = silk_smlabb_ovflw(acc, load64(inp + (ix - 1 - j) * 8), load64(B + j * 8));
            j = j + 1;
        }
        # out32_Q12 = (in[ix] << 12) - acc  (ovflw); out32 = RSHIFT_ROUND(.,12); SAT16
        acc = silk_sub32_ovflw(load64(inp + ix * 8) << 12, acc);
        store64(out + ix * 8, silk_sat16(silk_rshift_round(acc, 12)));
        ix = ix + 1;
    }
    var z = 0;
    while (z < d) { store64(out + z * 8, 0); z = z + 1; }
    return 0;
}

# offset_Q10 lookup: silk_Quantization_Offsets_Q10[signalType>>1][quantOffsetType].
fn silk_quant_offset(signalType, quantOffset) {
    # {{100,240},{32,100}}
    if ((signalType >> 1) == 0) {
        if (quantOffset == 0) { return 100; }
        return 240;
    }
    if (quantOffset == 0) { return 32; }
    return 100;
}

# st layout (i64):  0 fs_kHz 1 LPC_order 2 frame_length 3 subfr_length 4 ltp_mem_length
#   5 nb_subfr 6 prev_gain_Q16 7 prevSignalType 8 lagPrev 9 lossCnt
#   10 exc_Q14(ptr) 11 sLPC_Q14_buf(ptr,16) 12 outBuf(ptr, ltp_mem_length+frame_length)
# ctrl layout (i64): 0 PredCoef0(ptr) 1 PredCoef1(ptr) 2 Gains(ptr,4) 3 pitchL(ptr,4)
#   4 LTPCoef(ptr,20) 5 LTPscale 6 signalType 7 quantOffset 8 seed 9 ninterp
fn silk_decode_core(st, ctrl, xq, pulses) {
    var LPC_order = load64(st + 1 * 8);
    var frame_length = load64(st + 2 * 8);
    var subfr_length = load64(st + 3 * 8);
    var ltp_mem = load64(st + 4 * 8);
    var nb_subfr = load64(st + 5 * 8);
    var exc = load64(st + 10 * 8);
    var sLPCbuf = load64(st + 11 * 8);
    var outBuf = load64(st + 12 * 8);
    var signalType = load64(ctrl + 6 * 8);
    var quantOffset = load64(ctrl + 7 * 8);
    var seed = load64(ctrl + 8 * 8);
    var ninterp = load64(ctrl + 9 * 8);
    var gains = load64(ctrl + 2 * 8);
    var pitchL = load64(ctrl + 3 * 8);
    var ltpcoef = load64(ctrl + 4 * 8);
    var ltpscale = load64(ctrl + 5 * 8);

    var sLTP = alloc(ltp_mem * 8);
    var sLTP_Q15 = alloc((ltp_mem + frame_length) * 8);
    var res = alloc(subfr_length * 8);
    var sLPC = alloc((subfr_length + 16) * 8);

    var offset_Q10 = silk_quant_offset(signalType, quantOffset);
    var nlsf_interp_flag = 0;
    if (ninterp < 4) { nlsf_interp_flag = 1; }

    # Decode excitation into exc[]
    var rand_seed = seed;
    var i = 0;
    while (i < frame_length) {
        rand_seed = silk_sx32(907633515 + rand_seed * 196314165);   # silk_RAND
        var e = load64(pulses + i * 8) << 14;
        if (e > 0) { e = e - 1280; }
        else { if (e < 0) { e = e + 1280; } }
        e = e + (offset_Q10 << 4);
        if (rand_seed < 0) { e = 0 - e; }
        store64(exc + i * 8, e);
        rand_seed = silk_sx32(rand_seed + load64(pulses + i * 8));   # ADD32_ovflw
        i = i + 1;
    }

    # Copy LPC state
    i = 0;
    while (i < 16) { store64(sLPC + i * 8, load64(sLPCbuf + i * 8)); i = i + 1; }

    var sLTP_buf_idx = ltp_mem;
    var prev_gain = load64(st + 6 * 8);
    var k = 0;
    while (k < nb_subfr) {
        var A = load64(ctrl + 0 * 8);
        if ((k >> 1) == 1) { A = load64(ctrl + 1 * 8); }
        var B = ltpcoef + (k * 5) * 8;
        var gk = load64(gains + k * 8);
        var Gain_Q10 = sar(gk, 6);
        var inv_gain = silk_inverse32_varq(gk, 47);

        var gain_adj = 1 << 16;
        if (gk != prev_gain) {
            gain_adj = silk_div32_varq(prev_gain, gk, 16);
            var g = 0;
            while (g < 16) { store64(sLPC + g * 8, silk_smulww(gain_adj, load64(sLPC + g * 8))); g = g + 1; }
        }
        prev_gain = gk;

        # (PLC transition path omitted: lossCnt == 0 for clean decode)
        var pexc_base = k * subfr_length;    # index into exc for this subframe

        if (signalType == 2) {
            var lag = load64(pitchL + k * 8);
            if ((k == 0) | ((k == 2) & (nlsf_interp_flag == 1))) {
                var start_idx = ltp_mem - lag - LPC_order - 2;
                if (k == 2) {
                    # outBuf[ltp_mem .. ltp_mem+2*subfr_length) = xq[0..2*subfr_length)
                    var c = 0;
                    while (c < 2 * subfr_length) { store64(outBuf + (ltp_mem + c) * 8, load64(xq + c * 8)); c = c + 1; }
                }
                silk_lpc_analysis_filter(sLTP + start_idx * 8,
                    outBuf + (start_idx + k * subfr_length) * 8, A, ltp_mem - start_idx, LPC_order);
                if (k == 0) {
                    inv_gain = silk_smulwb(inv_gain, ltpscale) << 2;
                }
                i = 0;
                while (i < lag + 2) {
                    store64(sLTP_Q15 + (sLTP_buf_idx - i - 1) * 8,
                        silk_smulwb(inv_gain, load64(sLTP + (ltp_mem - i - 1) * 8)));
                    i = i + 1;
                }
            } else {
                if (gain_adj != (1 << 16)) {
                    i = 0;
                    while (i < lag + 2) {
                        store64(sLTP_Q15 + (sLTP_buf_idx - i - 1) * 8,
                            silk_smulww(gain_adj, load64(sLTP_Q15 + (sLTP_buf_idx - i - 1) * 8)));
                        i = i + 1;
                    }
                }
            }
        }

        # Long-term prediction -> res[], or pres = exc for unvoiced
        var pres_is_exc = 1;
        if (signalType == 2) {
            pres_is_exc = 0;
            var lag2 = load64(pitchL + k * 8);
            var plp = sLTP_buf_idx - lag2 + 2;    # pred_lag_ptr index base
            i = 0;
            while (i < subfr_length) {
                var ltp = 2;
                ltp = silk_smlawb(ltp, load64(sLTP_Q15 + (plp + i) * 8), load64(B + 0));
                ltp = silk_smlawb(ltp, load64(sLTP_Q15 + (plp + i - 1) * 8), load64(B + 1 * 8));
                ltp = silk_smlawb(ltp, load64(sLTP_Q15 + (plp + i - 2) * 8), load64(B + 2 * 8));
                ltp = silk_smlawb(ltp, load64(sLTP_Q15 + (plp + i - 3) * 8), load64(B + 3 * 8));
                ltp = silk_smlawb(ltp, load64(sLTP_Q15 + (plp + i - 4) * 8), load64(B + 4 * 8));
                var pr = silk_sx32(load64(exc + (pexc_base + i) * 8) + (ltp << 1));
                store64(res + i * 8, pr);
                store64(sLTP_Q15 + sLTP_buf_idx * 8, pr << 1);
                sLTP_buf_idx = sLTP_buf_idx + 1;
                i = i + 1;
            }
        }

        # Short-term (LPC) prediction + gain scale -> xq
        i = 0;
        while (i < subfr_length) {
            var lpc = sar(LPC_order, 1);
            var j = 0;
            while (j < LPC_order) {
                lpc = silk_smlawb(lpc, load64(sLPC + (16 + i - 1 - j) * 8), load64(A + j * 8));
                j = j + 1;
            }
            var pr = load64(exc + (pexc_base + i) * 8);
            if (pres_is_exc == 0) { pr = load64(res + i * 8); }
            var s = silk_add_sat32(pr, silk_lshift_sat32(lpc, 4));
            store64(sLPC + (16 + i) * 8, s);
            store64(xq + (k * subfr_length + i) * 8,
                silk_sat16(silk_rshift_round(silk_smulww(s, Gain_Q10), 8)));
            i = i + 1;
        }

        # Shift LPC state: sLPC[0..15] = sLPC[subfr_length..subfr_length+15]
        i = 0;
        while (i < 16) { store64(sLPC + i * 8, load64(sLPC + (subfr_length + i) * 8)); i = i + 1; }
        k = k + 1;
    }

    # Save LPC state + prev_gain
    i = 0;
    while (i < 16) { store64(sLPCbuf + i * 8, load64(sLPC + i * 8)); i = i + 1; }
    store64(st + 6 * 8, prev_gain);
    return 0;
}

# ---- stateful frame orchestration (decode_frame.c / dec_API.c) ----
# Extended st layout adds: 13 LastGainIndex, 14 prevNLSF(ptr,order), 15 first_frame_after_reset.
# silk_decoder_init: allocate persistent buffers and reset state for sampling rate fs_kHz.
fn silk_decoder_init(fs_kHz, nb_subfr) {
    var order = 16;
    if (fs_kHz == 8) { order = 10; }
    var subfr_length = 5 * fs_kHz;
    var frame_length = subfr_length * nb_subfr;   # 10ms (nb_subfr=2) or 20ms (nb_subfr=4)
    var ltp_mem = 20 * fs_kHz;                     # LTP memory is always 20ms
    var st = alloc(16 * 8);
    store64(st + 0 * 8, fs_kHz);
    store64(st + 1 * 8, order);
    store64(st + 2 * 8, frame_length);
    store64(st + 3 * 8, subfr_length);
    store64(st + 4 * 8, ltp_mem);
    store64(st + 5 * 8, nb_subfr);
    store64(st + 6 * 8, 65536);          # prev_gain_Q16
    store64(st + 7 * 8, 0);              # prevSignalType
    store64(st + 8 * 8, 0);              # lagPrev
    store64(st + 9 * 8, 0);              # lossCnt
    store64(st + 10 * 8, alloc(frame_length * 8));            # exc_Q14
    var slp = alloc(16 * 8);
    var i = 0; while (i < 16) { store64(slp + i * 8, 0); i = i + 1; }
    store64(st + 11 * 8, slp);           # sLPC_Q14_buf
    var ob = alloc((ltp_mem + frame_length) * 8);
    i = 0; while (i < ltp_mem + frame_length) { store64(ob + i * 8, 0); i = i + 1; }
    store64(st + 12 * 8, ob);            # outBuf
    store64(st + 13 * 8, 10);            # LastGainIndex
    store64(st + 14 * 8, alloc(order * 8)); # prevNLSF_Q15
    store64(st + 15 * 8, 1);             # first_frame_after_reset
    return st;
}

# silk_decode_frame: full pipeline for one SILK frame using persistent state st.
# Writes internal-rate output into xq (frame_length i64 slots). condCoding = INDEPENDENT.
# Payload wrapper: create a fresh ec, then decode one SILK frame.
fn silk_decode_frame(st, payload, plen, xq) {
    return silk_decode_frame_ec(st, ec_dec_new(payload, plen), xq);
}

# ec-taking core: decode one SILK frame from an externally-owned range decoder
# (shared with CELT in hybrid). Consumes the front of `ec`.
fn silk_decode_frame_ec(st, ec, xq) {
    # Mono/hybrid: read this frame's own LP-header VAD/LBRR flags, then decode.
    var vad = ec_dec_bit_logp(ec, 1);
    var lbrr = ec_dec_bit_logp(ec, 1);
    return silk_decode_frame_ec_vad(st, ec, xq, vad);
}

# ec-taking core with a pre-read `vad` flag (stereo per-channel decode calls this after
# the shared packet header has already consumed both channels' VAD/LBRR flags).
fn silk_decode_frame_ec_vad(st, ec, xq, vad) {
    var fs_kHz = load64(st + 0 * 8);
    var order = load64(st + 1 * 8);
    var frame_length = load64(st + 2 * 8);
    var nb_subfr = load64(st + 5 * 8);
    var lg_ptr = st + 13 * 8;
    var prevNLSF = load64(st + 14 * 8);
    var first_frame = load64(st + 15 * 8);

    var out = alloc(40 * 8);
    silk_decode_indices_ec(ec, fs_kHz, lg_ptr, out, vad, nb_subfr);
    var signalType = load64(out + 0 * 8);
    var quantOffset = load64(out + 1 * 8);
    var ninterp = load64(out + 11 * 8);
    if (first_frame == 1) { ninterp = 4; }

    var pulses = alloc(frame_length * 8);
    silk_decode_pulses(ec, pulses, signalType, quantOffset, frame_length);

    # NLSF -> LPC; interpolation for PredCoef[0]
    var pNLSF = alloc(order * 8);
    silk_nlsf_decode(out + 18 * 8, fs_kHz, pNLSF);
    var predcoef1 = alloc(order * 8);
    silk_nlsf2a(predcoef1, pNLSF, order);
    var predcoef0 = alloc(order * 8);
    if (ninterp < 4) {
        var nlsf0 = alloc(order * 8);
        var i = 0;
        while (i < order) {
            var pv = load64(prevNLSF + i * 8);
            store64(nlsf0 + i * 8, pv + sar(silk_mul(ninterp, load64(pNLSF + i * 8) - pv), 2));
            i = i + 1;
        }
        silk_nlsf2a(predcoef0, nlsf0, order);
    } else {
        var i = 0;
        while (i < order) { store64(predcoef0 + i * 8, load64(predcoef1 + i * 8)); i = i + 1; }
    }
    # save prevNLSF = pNLSF
    var s = 0;
    while (s < order) { store64(prevNLSF + s * 8, load64(pNLSF + s * 8)); s = s + 1; }

    # pitch + LTP
    var pitchL = alloc(4 * 8);
    var ltpcoef = alloc(20 * 8);
    var ltpscale = 0;
    var z = 0;
    while (z < 4) { store64(pitchL + z * 8, 0); z = z + 1; }
    z = 0; while (z < 20) { store64(ltpcoef + z * 8, 0); z = z + 1; }
    if (signalType == 2) {
        silk_decode_pitch(load64(out + 12 * 8), load64(out + 13 * 8), fs_kHz, pitchL, nb_subfr);
        silk_decode_ltp(load64(out + 14 * 8), out + (19 + order) * 8, ltpcoef, nb_subfr);
        ltpscale = silk_ltp_scale(load64(out + 15 * 8));
    }

    # decode_core
    var ctrl = alloc(10 * 8);
    store64(ctrl + 0 * 8, predcoef0);
    store64(ctrl + 1 * 8, predcoef1);
    var gb = alloc(4 * 8);
    z = 0; while (z < 4) { store64(gb + z * 8, load64(out + (6 + z) * 8)); z = z + 1; }
    store64(ctrl + 2 * 8, gb);
    store64(ctrl + 3 * 8, pitchL);
    store64(ctrl + 4 * 8, ltpcoef);
    store64(ctrl + 5 * 8, ltpscale);
    store64(ctrl + 6 * 8, signalType);
    store64(ctrl + 7 * 8, quantOffset);
    store64(ctrl + 8 * 8, load64(out + 16 * 8));   # seed
    store64(ctrl + 9 * 8, ninterp);
    silk_decode_core(st, ctrl, xq, pulses);

    # Update output buffer: shift left by frame_length, append xq. mv_len = ltp_mem -
    # frame_length (0 for 20ms → outBuf=xq; 160 for WB 10ms → shift + append).
    var outBuf = load64(st + 12 * 8);
    var ltp_mem = load64(st + 4 * 8);
    var mv_len = ltp_mem - frame_length;
    var mvi = 0;
    while (mvi < mv_len) { store64(outBuf + mvi * 8, load64(outBuf + (frame_length + mvi) * 8)); mvi = mvi + 1; }
    z = 0;
    while (z < frame_length) { store64(outBuf + (mv_len + z) * 8, load64(xq + z * 8)); z = z + 1; }

    store64(st + 15 * 8, 0);                                  # first_frame_after_reset = 0
    store64(st + 7 * 8, signalType);                          # prevSignalType
    store64(st + 8 * 8, load64(pitchL + (nb_subfr - 1) * 8)); # lagPrev = pitchL[nb_subfr-1]
    return 0;
}

# ---- resampler ROM tables ----
var _silk_frac_fir12 = 0;
var _silk_up2c0 = 0;
var _silk_up2c1 = 0;

fn _silk_resampler_tables_init() {
    _silk_frac_fir12 = alloc(48 * 8);
    store64(_silk_frac_fir12 + 0 * 8, 189); store64(_silk_frac_fir12 + 1 * 8, 0 - 600); store64(_silk_frac_fir12 + 2 * 8, 617); store64(_silk_frac_fir12 + 3 * 8, 30567); store64(_silk_frac_fir12 + 4 * 8, 117); store64(_silk_frac_fir12 + 5 * 8, 0 - 159); store64(_silk_frac_fir12 + 6 * 8, 0 - 1070); store64(_silk_frac_fir12 + 7 * 8, 29704);
    store64(_silk_frac_fir12 + 8 * 8, 52); store64(_silk_frac_fir12 + 9 * 8, 221); store64(_silk_frac_fir12 + 10 * 8, 0 - 2392); store64(_silk_frac_fir12 + 11 * 8, 28276); store64(_silk_frac_fir12 + 12 * 8, 0 - 4); store64(_silk_frac_fir12 + 13 * 8, 529); store64(_silk_frac_fir12 + 14 * 8, 0 - 3350); store64(_silk_frac_fir12 + 15 * 8, 26341);
    store64(_silk_frac_fir12 + 16 * 8, 0 - 48); store64(_silk_frac_fir12 + 17 * 8, 758); store64(_silk_frac_fir12 + 18 * 8, 0 - 3956); store64(_silk_frac_fir12 + 19 * 8, 23973); store64(_silk_frac_fir12 + 20 * 8, 0 - 80); store64(_silk_frac_fir12 + 21 * 8, 905); store64(_silk_frac_fir12 + 22 * 8, 0 - 4235); store64(_silk_frac_fir12 + 23 * 8, 21254);
    store64(_silk_frac_fir12 + 24 * 8, 0 - 99); store64(_silk_frac_fir12 + 25 * 8, 972); store64(_silk_frac_fir12 + 26 * 8, 0 - 4222); store64(_silk_frac_fir12 + 27 * 8, 18278); store64(_silk_frac_fir12 + 28 * 8, 0 - 107); store64(_silk_frac_fir12 + 29 * 8, 967); store64(_silk_frac_fir12 + 30 * 8, 0 - 3957); store64(_silk_frac_fir12 + 31 * 8, 15143);
    store64(_silk_frac_fir12 + 32 * 8, 0 - 103); store64(_silk_frac_fir12 + 33 * 8, 896); store64(_silk_frac_fir12 + 34 * 8, 0 - 3487); store64(_silk_frac_fir12 + 35 * 8, 11950); store64(_silk_frac_fir12 + 36 * 8, 0 - 91); store64(_silk_frac_fir12 + 37 * 8, 773); store64(_silk_frac_fir12 + 38 * 8, 0 - 2865); store64(_silk_frac_fir12 + 39 * 8, 8798);
    store64(_silk_frac_fir12 + 40 * 8, 0 - 71); store64(_silk_frac_fir12 + 41 * 8, 611); store64(_silk_frac_fir12 + 42 * 8, 0 - 2143); store64(_silk_frac_fir12 + 43 * 8, 5784); store64(_silk_frac_fir12 + 44 * 8, 0 - 46); store64(_silk_frac_fir12 + 45 * 8, 425); store64(_silk_frac_fir12 + 46 * 8, 0 - 1375); store64(_silk_frac_fir12 + 47 * 8, 2996);
    _silk_up2c0 = alloc(3 * 8); store64(_silk_up2c0 + 0, 1746); store64(_silk_up2c0 + 8, 14986); store64(_silk_up2c0 + 16, 0 - 26453);
    _silk_up2c1 = alloc(3 * 8); store64(_silk_up2c1 + 0, 6854); store64(_silk_up2c1 + 8, 25769); store64(_silk_up2c1 + 16, 0 - 9994);
    return 0;
}

# ---- resampler: SILK internal rate -> 48 kHz (resampler.c, IIR_FIR path, up2x) ----
# silk_resampler_private_up2_HQ: 6-state all-pass 2x upsampler (Q10). out has 2*len samples.
fn silk_resampler_up2_hq(S, out, inp, len) {
    var c0a = load64(_silk_up2c0 + 0);  var c0b = load64(_silk_up2c0 + 8);  var c0c = load64(_silk_up2c0 + 16);
    var c1a = load64(_silk_up2c1 + 0);  var c1b = load64(_silk_up2c1 + 8);  var c1c = load64(_silk_up2c1 + 16);
    var k = 0;
    while (k < len) {
        var in32 = load64(inp + k * 8) << 10;
        # even sample
        var Y = in32 - load64(S + 0 * 8);
        var X = silk_smulwb(Y, c0a);
        var o1 = load64(S + 0 * 8) + X;
        store64(S + 0 * 8, in32 + X);
        Y = o1 - load64(S + 1 * 8);
        X = silk_smulwb(Y, c0b);
        var o2 = load64(S + 1 * 8) + X;
        store64(S + 1 * 8, o1 + X);
        Y = o2 - load64(S + 2 * 8);
        X = silk_smlawb(Y, Y, c0c);
        o1 = load64(S + 2 * 8) + X;
        store64(S + 2 * 8, o2 + X);
        store64(out + (2 * k) * 8, silk_sat16(silk_rshift_round(o1, 10)));
        # odd sample
        Y = in32 - load64(S + 3 * 8);
        X = silk_smulwb(Y, c1a);
        o1 = load64(S + 3 * 8) + X;
        store64(S + 3 * 8, in32 + X);
        Y = o1 - load64(S + 4 * 8);
        X = silk_smulwb(Y, c1b);
        o2 = load64(S + 4 * 8) + X;
        store64(S + 4 * 8, o1 + X);
        Y = o2 - load64(S + 5 * 8);
        X = silk_smlawb(Y, Y, c1c);
        o1 = load64(S + 5 * 8) + X;
        store64(S + 5 * 8, o2 + X);
        store64(out + (2 * k + 1) * 8, silk_sat16(silk_rshift_round(o1, 10)));
        k = k + 1;
    }
    return 0;
}

# INTERPOL: 8-tap fractional FIR over buf; writes to out; returns #samples written.
fn silk_resampler_interpol(out, buf, max_index_Q16, incr_Q16) {
    var n = 0;
    var index_Q16 = 0;
    while (index_Q16 < max_index_Q16) {
        var ti = silk_smulwb(index_Q16 & 0xFFFF, 12);
        var bp = buf + (sar(index_Q16, 16)) * 8;
        var ta = _silk_frac_fir12 + ti * 4 * 8;         # frac[ti][0..3]
        var tb = _silk_frac_fir12 + (11 - ti) * 4 * 8;  # frac[11-ti][0..3]
        var res = silk_smulbb(load64(bp + 0 * 8), load64(ta + 0 * 8));
        res = silk_sx32(res + silk_smulbb(load64(bp + 1 * 8), load64(ta + 1 * 8)));
        res = silk_sx32(res + silk_smulbb(load64(bp + 2 * 8), load64(ta + 2 * 8)));
        res = silk_sx32(res + silk_smulbb(load64(bp + 3 * 8), load64(ta + 3 * 8)));
        res = silk_sx32(res + silk_smulbb(load64(bp + 4 * 8), load64(tb + 3 * 8)));
        res = silk_sx32(res + silk_smulbb(load64(bp + 5 * 8), load64(tb + 2 * 8)));
        res = silk_sx32(res + silk_smulbb(load64(bp + 6 * 8), load64(tb + 1 * 8)));
        res = silk_sx32(res + silk_smulbb(load64(bp + 7 * 8), load64(tb + 0 * 8)));
        store64(out + n * 8, silk_sat16(silk_rshift_round(res, 15)));
        n = n + 1;
        index_Q16 = index_Q16 + incr_Q16;
    }
    return n;
}

# silk_resampler_private_IIR_FIR: batched 2x-up + FIR. out receives resampled samples.
# rst layout: 0 Fs_in_kHz 1 Fs_out_kHz 2 batchSize 3 inputDelay 4 invRatio 5 (unused)
#   6 sIIR(ptr,6) 7 sFIR(ptr,8) 8 delayBuf(ptr)
fn silk_resampler_iir_fir(rst, out, inp, inLen) {
    var batchSize = load64(rst + 2 * 8);
    var invRatio = load64(rst + 4 * 8);
    var sIIR = load64(rst + 6 * 8);
    var sFIR = load64(rst + 7 * 8);
    var buf = alloc((2 * batchSize + 8) * 8);
    var i = 0;
    while (i < 8) { store64(buf + i * 8, load64(sFIR + i * 8)); i = i + 1; }
    var out_off = 0;
    var in_off = 0;
    var done = 0;
    while (done == 0) {
        var nSamplesIn = inLen;
        if (batchSize < nSamplesIn) { nSamplesIn = batchSize; }
        silk_resampler_up2_hq(sIIR, buf + 8 * 8, inp + in_off * 8, nSamplesIn);
        var max_index = nSamplesIn << 17;
        var wrote = silk_resampler_interpol(out + out_off * 8, buf, max_index, invRatio);
        out_off = out_off + wrote;
        in_off = in_off + nSamplesIn;
        inLen = inLen - nSamplesIn;
        if (inLen > 0) {
            i = 0;
            while (i < 8) { store64(buf + i * 8, load64(buf + (nSamplesIn * 2 + i) * 8)); i = i + 1; }
        } else {
            done = 1;
            # save FIR state = buf[2*nSamplesIn .. +8]
            i = 0;
            while (i < 8) { store64(sFIR + i * 8, load64(buf + (nSamplesIn * 2 + i) * 8)); i = i + 1; }
        }
    }
    return out_off;
}

# silk_resampler: top-level, handles the 1 ms input-delay buffer split.
fn silk_resampler(rst, out, inp, inLen) {
    var Fs_in = load64(rst + 0 * 8);
    var Fs_out = load64(rst + 1 * 8);
    var inputDelay = load64(rst + 3 * 8);
    var delayBuf = load64(rst + 8 * 8);
    var nSamples = Fs_in - inputDelay;
    var i = 0;
    while (i < nSamples) { store64(delayBuf + (inputDelay + i) * 8, load64(inp + i * 8)); i = i + 1; }
    silk_resampler_iir_fir(rst, out, delayBuf, Fs_in);
    silk_resampler_iir_fir(rst, out + Fs_out * 8, inp + nSamples * 8, inLen - Fs_in);
    i = 0;
    while (i < inputDelay) { store64(delayBuf + i * 8, load64(inp + (inLen - inputDelay + i) * 8)); i = i + 1; }
    return 0;
}

# silk_resampler_init: set up state for internal fs_kHz -> 48 kHz decode.
fn silk_resampler_init(fs_kHz) {
    if (_silk_frac_fir12 == 0) { _silk_resampler_tables_init(); }
    var rst = alloc(9 * 8);
    var Fs_in = fs_kHz * 1000;
    var Fs_out = 48000;
    store64(rst + 0 * 8, fs_kHz);
    store64(rst + 1 * 8, 48);
    store64(rst + 2 * 8, fs_kHz * 10);          # batchSize
    # delay_matrix_dec[rateID(in)][rateID(48000)]: 8kHz->0, 12kHz->4, 16kHz->7.
    var inputDelay = 7;                          # WB (16 kHz)
    if (fs_kHz == 8) { inputDelay = 0; }        # NB
    if (fs_kHz == 12) { inputDelay = 4; }       # MB (for when config 4-7 is wired)
    store64(rst + 3 * 8, inputDelay);
    # invRatio_Q16 = LSHIFT(DIV32(LSHIFT(Fs_in,15), Fs_out), 2), rounded up (up2x=1)
    var invRatio = silk_div_trunc(Fs_in << 15, Fs_out) << 2;
    while (silk_smulww(invRatio, Fs_out) < (Fs_in << 1)) { invRatio = invRatio + 1; }
    store64(rst + 4 * 8, invRatio);
    store64(rst + 5 * 8, 0);
    var sIIR = alloc(6 * 8);
    var i = 0; while (i < 6) { store64(sIIR + i * 8, 0); i = i + 1; }
    store64(rst + 6 * 8, sIIR);
    var sFIR = alloc(8 * 8);
    i = 0; while (i < 8) { store64(sFIR + i * 8, 0); i = i + 1; }
    store64(rst + 7 * 8, sFIR);
    var delayBuf = alloc(fs_kHz * 8);
    i = 0; while (i < fs_kHz) { store64(delayBuf + i * 8, 0); i = i + 1; }
    store64(rst + 8 * 8, delayBuf);
    return rst;
}

# ---- full SILK decode: bitstream -> 48 kHz PCM (dec_API.c mono path) ----
# silk_decode_pcm: decode one SILK frame and resample to 48 kHz.
# st = silk_decoder_init(fs), rst = silk_resampler_init(fs), sMid = 2 i64 slots (init 0).
# out48 receives 20 ms * 48 kHz = 960 int16 samples.
fn silk_decode_pcm(st, rst, sMid, payload, plen, out48) {
    return silk_decode_pcm_ec(st, rst, sMid, ec_dec_new(payload, plen), out48);
}

# ec-taking core: decode one SILK frame from a shared range decoder + resample to 48 kHz.
# Used by the hybrid orchestrator (SILK reads the front of the shared ec, CELT continues).
fn silk_decode_pcm_ec(st, rst, sMid, ec, out48) {
    var frame_length = load64(st + 2 * 8);
    var xq = alloc(frame_length * 8);
    silk_decode_frame_ec(st, ec, xq);
    # Build resampler input: [sMid[1], xq[0..frame_length-2]] (1-sample delay via sStereo.sMid)
    var rin = alloc(frame_length * 8);
    store64(rin + 0, load64(sMid + 8));
    var i = 1;
    while (i < frame_length) { store64(rin + i * 8, load64(xq + (i - 1) * 8)); i = i + 1; }
    # Update sMid = last two internal samples
    store64(sMid + 0, load64(xq + (frame_length - 2) * 8));
    store64(sMid + 8, load64(xq + (frame_length - 1) * 8));
    silk_resampler(rst, out48, rin, frame_length);
    return 0;
}

# ---- SILK stereo: prediction weights + mid-only flag (stereo_decode_pred.c) ----
var _silk_stereo_pred_joint = 0;
var _silk_stereo_only_mid = 0;
var _silk_uniform3 = 0;
var _silk_uniform5 = 0;
var _silk_stereo_pred_q13 = 0;

fn _silk_stereo_tables_init() {
    _silk_stereo_pred_joint = alloc(25);
    store8(_silk_stereo_pred_joint + 0, 249); store8(_silk_stereo_pred_joint + 1, 247); store8(_silk_stereo_pred_joint + 2, 246); store8(_silk_stereo_pred_joint + 3, 245); store8(_silk_stereo_pred_joint + 4, 244); store8(_silk_stereo_pred_joint + 5, 234); store8(_silk_stereo_pred_joint + 6, 210); store8(_silk_stereo_pred_joint + 7, 202); store8(_silk_stereo_pred_joint + 8, 201); store8(_silk_stereo_pred_joint + 9, 200); store8(_silk_stereo_pred_joint + 10, 197); store8(_silk_stereo_pred_joint + 11, 174); store8(_silk_stereo_pred_joint + 12, 82); store8(_silk_stereo_pred_joint + 13, 59); store8(_silk_stereo_pred_joint + 14, 56); store8(_silk_stereo_pred_joint + 15, 55); store8(_silk_stereo_pred_joint + 16, 54); store8(_silk_stereo_pred_joint + 17, 46); store8(_silk_stereo_pred_joint + 18, 22); store8(_silk_stereo_pred_joint + 19, 12); store8(_silk_stereo_pred_joint + 20, 11); store8(_silk_stereo_pred_joint + 21, 10); store8(_silk_stereo_pred_joint + 22, 9); store8(_silk_stereo_pred_joint + 23, 7); store8(_silk_stereo_pred_joint + 24, 0);
    _silk_stereo_only_mid = alloc(2);
    store8(_silk_stereo_only_mid + 0, 64); store8(_silk_stereo_only_mid + 1, 0);
    _silk_uniform3 = alloc(3);
    store8(_silk_uniform3 + 0, 171); store8(_silk_uniform3 + 1, 85); store8(_silk_uniform3 + 2, 0);
    _silk_uniform5 = alloc(5);
    store8(_silk_uniform5 + 0, 205); store8(_silk_uniform5 + 1, 154); store8(_silk_uniform5 + 2, 102); store8(_silk_uniform5 + 3, 51); store8(_silk_uniform5 + 4, 0);
    _silk_stereo_pred_q13 = alloc(16 * 8);
    store64(_silk_stereo_pred_q13 + 0 * 8, 0 - 13732); store64(_silk_stereo_pred_q13 + 1 * 8, 0 - 10050); store64(_silk_stereo_pred_q13 + 2 * 8, 0 - 8266); store64(_silk_stereo_pred_q13 + 3 * 8, 0 - 7526); store64(_silk_stereo_pred_q13 + 4 * 8, 0 - 6500); store64(_silk_stereo_pred_q13 + 5 * 8, 0 - 5000); store64(_silk_stereo_pred_q13 + 6 * 8, 0 - 2950); store64(_silk_stereo_pred_q13 + 7 * 8, 0 - 820);
    store64(_silk_stereo_pred_q13 + 8 * 8, 820); store64(_silk_stereo_pred_q13 + 9 * 8, 2950); store64(_silk_stereo_pred_q13 + 10 * 8, 5000); store64(_silk_stereo_pred_q13 + 11 * 8, 6500); store64(_silk_stereo_pred_q13 + 12 * 8, 7526); store64(_silk_stereo_pred_q13 + 13 * 8, 8266); store64(_silk_stereo_pred_q13 + 14 * 8, 10050); store64(_silk_stereo_pred_q13 + 15 * 8, 13732);
    return 0;
}
# silk_smlabb(a,b,c) = a + (int16)b * (int16)c  (SMLABB, no overflow concern here).
fn silk_smlabb(a, b, c) { return silk_sx32(a + _i16(b) * _i16(c)); }

# silk_stereo_decode_pred: decode the 2 mid/side predictors into pred_out[2] (Q13).
fn silk_stereo_decode_pred(ec, pred_out) {
    if (_silk_stereo_pred_q13 == 0) { _silk_stereo_tables_init(); }
    var n = ec_dec_icdf(ec, _silk_stereo_pred_joint, 8);
    var ix02 = n / 5;                       # DIV32_16 (n >= 0, truncating)
    var ix12 = n - 5 * ix02;
    var ix00 = ec_dec_icdf(ec, _silk_uniform3, 8);
    var ix01 = ec_dec_icdf(ec, _silk_uniform5, 8);
    var ix10 = ec_dec_icdf(ec, _silk_uniform3, 8);
    var ix11 = ec_dec_icdf(ec, _silk_uniform5, 8);
    # dequant channel 0
    ix00 = ix00 + 3 * ix02;
    var low0 = load64(_silk_stereo_pred_q13 + ix00 * 8);
    var step0 = silk_smulwb(load64(_silk_stereo_pred_q13 + (ix00 + 1) * 8) - low0, 6554);
    store64(pred_out + 0, silk_smlabb(low0, step0, 2 * ix01 + 1));
    # dequant channel 1
    ix10 = ix10 + 3 * ix12;
    var low1 = load64(_silk_stereo_pred_q13 + ix10 * 8);
    var step1 = silk_smulwb(load64(_silk_stereo_pred_q13 + (ix10 + 1) * 8) - low1, 6554);
    store64(pred_out + 8, silk_smlabb(low1, step1, 2 * ix11 + 1));
    # subtract second from first predictor
    store64(pred_out + 0, load64(pred_out + 0) - load64(pred_out + 8));
    return 0;
}

# silk_stereo_decode_mid_only: 1 = only the mid channel is coded.
fn silk_stereo_decode_mid_only(ec) {
    if (_silk_stereo_only_mid == 0) { _silk_stereo_tables_init(); }
    return ec_dec_icdf(ec, _silk_stereo_only_mid, 8);
}

# ---- SILK stereo mid/side -> left/right reconstruction (stereo_MS_to_LR.c) ----
# state layout (i64): 0-1 sMid[2], 2-3 sSide[2], 4-5 pred_prev_Q13[2].
# x1 (mid), x2 (side): buffers of (frame_length+2) int16 slots; the decoded frame is at
# [2..frame_length+2). After the call, L is in x1[1..frame_length+1), R in x2[1..].
fn silk_stereo_ms_to_lr(state, x1, x2, pred_q13, fs_kHz, frame_length) {
    # Prepend the 2-sample history; save the last two mid/side samples for next frame.
    store64(x1 + 0, load64(state + 0 * 8)); store64(x1 + 1 * 8, load64(state + 1 * 8));
    store64(x2 + 0, load64(state + 2 * 8)); store64(x2 + 1 * 8, load64(state + 3 * 8));
    store64(state + 0 * 8, load64(x1 + frame_length * 8)); store64(state + 1 * 8, load64(x1 + (frame_length + 1) * 8));
    store64(state + 2 * 8, load64(x2 + frame_length * 8)); store64(state + 3 * 8, load64(x2 + (frame_length + 1) * 8));
    # Interpolate predictors and add prediction to the side channel.
    var pred0 = load64(state + 4 * 8);
    var pred1 = load64(state + 5 * 8);
    var p0 = load64(pred_q13 + 0);
    var p1 = load64(pred_q13 + 8);
    var interp_len = 8 * fs_kHz;                              # STEREO_INTERP_LEN_MS = 8
    var denom_q16 = silk_div_trunc(1 << 16, interp_len);
    var delta0 = silk_rshift_round(silk_smulbb(p0 - pred0, denom_q16), 16);
    var delta1 = silk_rshift_round(silk_smulbb(p1 - pred1, denom_q16), 16);
    var n = 0;
    while (n < interp_len) {
        pred0 = pred0 + delta0;
        pred1 = pred1 + delta1;
        var sum = (load64(x1 + n * 8) + load64(x1 + (n + 2) * 8) + (load64(x1 + (n + 1) * 8) << 1)) << 9;
        sum = silk_smlawb(load64(x2 + (n + 1) * 8) << 8, sum, pred0);
        sum = silk_smlawb(sum, load64(x1 + (n + 1) * 8) << 11, pred1);
        store64(x2 + (n + 1) * 8, silk_sat16(silk_rshift_round(sum, 8)));
        n = n + 1;
    }
    while (n < frame_length) {
        var sum2 = (load64(x1 + n * 8) + load64(x1 + (n + 2) * 8) + (load64(x1 + (n + 1) * 8) << 1)) << 9;
        sum2 = silk_smlawb(load64(x2 + (n + 1) * 8) << 8, sum2, p0);
        sum2 = silk_smlawb(sum2, load64(x1 + (n + 1) * 8) << 11, p1);
        store64(x2 + (n + 1) * 8, silk_sat16(silk_rshift_round(sum2, 8)));
        n = n + 1;
    }
    store64(state + 4 * 8, p0);
    store64(state + 5 * 8, p1);
    # Convert mid/side to left/right.
    n = 0;
    while (n < frame_length) {
        var mid = load64(x1 + (n + 1) * 8);
        var side = load64(x2 + (n + 1) * 8);
        store64(x1 + (n + 1) * 8, silk_sat16(mid + side));
        store64(x2 + (n + 1) * 8, silk_sat16(mid - side));
        n = n + 1;
    }
    return 0;
}

# ---- full SILK stereo decode: one packet -> L/R at 48 kHz (dec_API.c stereo path) ----
# st0/st1 = per-channel silk_decoder_init(fs); rstL/rstR = silk_resampler_init(fs) per output
# channel; sStereo = 6 i64 (sMid[2], sSide[2], pred_prev[2], init 0). outL/outR receive 960
# int16 samples each. WB (fs=16) 20 ms, code 0, both channels — the common stereo SILK case.
fn silk_decode_stereo(st0, st1, rstL, rstR, sStereo, ec, fs_kHz, outL, outR) {
    if (_silk_stereo_pred_q13 == 0) { _silk_stereo_tables_init(); }
    var frame_length = 20 * fs_kHz;
    # Packet header: VAD/LBRR for both channels (one 20 ms frame per packet).
    var vad0 = ec_dec_bit_logp(ec, 1);
    var lbrr0 = ec_dec_bit_logp(ec, 1);
    var vad1 = ec_dec_bit_logp(ec, 1);
    var lbrr1 = ec_dec_bit_logp(ec, 1);
    # Stereo prediction weights + mid-only flag.
    var pred = alloc(2 * 8);
    silk_stereo_decode_pred(ec, pred);
    var midonly = 0;
    if (vad1 == 0) { midonly = silk_stereo_decode_mid_only(ec); }
    # Decode mid (ch0) and side (ch1) frames.
    var mid = alloc(frame_length * 8);
    silk_decode_frame_ec_vad(st0, ec, mid, vad0);
    var side = alloc(frame_length * 8);
    if (midonly == 0) {
        silk_decode_frame_ec_vad(st1, ec, side, vad1);
    } else {
        var z = 0;
        while (z < frame_length) { store64(side + z * 8, 0); z = z + 1; }
    }
    # Build the frame_length+2 mid/side buffers (frame at [2..]) and reconstruct L/R.
    var x1 = alloc((frame_length + 2) * 8);
    var x2 = alloc((frame_length + 2) * 8);
    var i = 0;
    while (i < frame_length) {
        store64(x1 + (i + 2) * 8, load64(mid + i * 8));
        store64(x2 + (i + 2) * 8, load64(side + i * 8));
        i = i + 1;
    }
    silk_stereo_ms_to_lr(sStereo, x1, x2, pred, fs_kHz, frame_length);
    # Resample each reconstructed channel (L at x1[1..], R at x2[1..]) to 48 kHz.
    silk_resampler(rstL, outL, x1 + 1 * 8, frame_length);
    silk_resampler(rstR, outR, x2 + 1 * 8, frame_length);
    return 0;
}

# ---- 10ms (nb_subfr=2) pitch contour + CB_lags tables (verbatim libopus) ----
var _silk_contour_10_wb = 0;
var _silk_contour_10_nb = 0;
var _silk_cblags2_10 = 0;
