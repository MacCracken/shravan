# ---- NLSF -> pNLSF_Q15 (NLSF_decode.c) ----
# Truncating signed division a/b (toward zero), matches C silk_DIV32_16.
fn silk_div_trunc(a, b) {
    var neg = 0;
    if (a < 0) { a = 0 - a; neg = neg ^ 1; }
    if (b < 0) { b = 0 - b; neg = neg ^ 1; }
    var q = a / b;
    if (neg != 0) { q = 0 - q; }
    return q;
}

# silk_RSHIFT_ROUND(a,n) = (a + (1<<(n-1))) >> n   (arithmetic).
fn silk_rshift_round(a, n) { return sar(a + (1 << (n - 1)), n); }

fn silk_limit(a, lo, hi) {
    if (a < lo) { return lo; }
    if (a > hi) { return hi; }
    return a;
}

# silk_ADD_SAT16: saturate (a+b) into int16 range.
fn silk_add_sat16(a, b) {
    var s = _i16(a) + _i16(b);
    if (s > 32767) { s = 32767; }
    if (s < 0 - 32768) { s = 0 - 32768; }
    return s;
}

# In-place insertion sort ascending over `n` int16 values at i64 ptr `p`.
# C stop condition (sort.c): stop when j<0 OR a[j]<=value, leaving j intact so the
# trailing write lands at j+1. Cyrius has no `break`/`&&`, so capture the insertion
# slot in `pos` before exiting rather than clobbering `j` (which would force index 0).
fn silk_isort_i16(p, n) {
    var i = 1;
    while (i < n) {
        var v = load64(p + i * 8);
        var j = i - 1;
        var pos = 0;
        while (j >= 0) {
            var pv = load64(p + j * 8);
            if (pv <= v) { pos = j + 1; j = 0 - 1; }
            else { store64(p + (j + 1) * 8, pv); j = j - 1; }
        }
        store64(p + pos * 8, v);
        i = i + 1;
    }
    return 0;
}

# silk_NLSF_residual_dequant: res_Q10[order] from indices[order] + pred_Q8[order].
fn silk_nlsf_residual_dequant(res_out, indices, pred_q8, quant_step, order) {
    var out_Q10 = 0;
    var i = order - 1;
    while (i >= 0) {
        var pred_Q10 = sar(silk_smulbb(out_Q10, load8(pred_q8 + i)), 8);
        out_Q10 = load64(indices + i * 8) << 10;
        if (out_Q10 > 0) { out_Q10 = out_Q10 - 102; }
        else { if (out_Q10 < 0) { out_Q10 = out_Q10 + 102; } }
        out_Q10 = silk_smlawb(pred_Q10, out_Q10, quant_step);
        store64(res_out + i * 8, _i16(out_Q10));
        i = i - 1;
    }
    return 0;
}

# silk_NLSF_stabilize: enforce min spacing deltaMin_Q15[order+1], in-place on pNLSF[order].
fn silk_nlsf_stabilize(pNLSF, dmin, L) {
    var loops = 0;
    while (loops < 20) {
        var min_diff = load64(pNLSF + 0) - load64(dmin + 0);
        var I = 0;
        var i = 1;
        while (i <= L - 1) {
            var diff = load64(pNLSF + i * 8) - (load64(pNLSF + (i - 1) * 8) + load64(dmin + i * 8));
            if (diff < min_diff) { min_diff = diff; I = i; }
            i = i + 1;
        }
        var diffL = (1 << 15) - (load64(pNLSF + (L - 1) * 8) + load64(dmin + L * 8));
        if (diffL < min_diff) { min_diff = diffL; I = L; }
        if (min_diff >= 0) { return 0; }
        if (I == 0) {
            store64(pNLSF + 0, load64(dmin + 0));
        } else {
            if (I == L) {
                store64(pNLSF + (L - 1) * 8, (1 << 15) - load64(dmin + L * 8));
            } else {
                var min_center = 0;
                var k = 0;
                while (k < I) { min_center = min_center + load64(dmin + k * 8); k = k + 1; }
                min_center = min_center + sar(load64(dmin + I * 8), 1);
                var max_center = 1 << 15;
                k = L;
                while (k > I) { max_center = max_center - load64(dmin + k * 8); k = k - 1; }
                max_center = max_center - sar(load64(dmin + I * 8), 1);
                var cf = silk_limit(silk_rshift_round(load64(pNLSF + (I - 1) * 8) + load64(pNLSF + I * 8), 1), min_center, max_center);
                store64(pNLSF + (I - 1) * 8, cf - sar(load64(dmin + I * 8), 1));
                store64(pNLSF + I * 8, load64(pNLSF + (I - 1) * 8) + load64(dmin + I * 8));
            }
        }
        loops = loops + 1;
    }
    # Fallback: insertion sort + clamp deltas.
    silk_isort_i16(pNLSF, L);
    if (load64(pNLSF + 0) < load64(dmin + 0)) { store64(pNLSF + 0, load64(dmin + 0)); }
    var i2 = 1;
    while (i2 < L) {
        var lb = silk_add_sat16(load64(pNLSF + (i2 - 1) * 8), load64(dmin + i2 * 8));
        if (load64(pNLSF + i2 * 8) < lb) { store64(pNLSF + i2 * 8, lb); }
        i2 = i2 + 1;
    }
    var ub = (1 << 15) - load64(dmin + L * 8);
    if (load64(pNLSF + (L - 1) * 8) > ub) { store64(pNLSF + (L - 1) * 8, ub); }
    i2 = L - 2;
    while (i2 >= 0) {
        var ub2 = load64(pNLSF + (i2 + 1) * 8) - load64(dmin + (i2 + 1) * 8);
        if (load64(pNLSF + i2 * 8) > ub2) { store64(pNLSF + i2 * 8, ub2); }
        i2 = i2 - 1;
    }
    return 0;
}

# silk_NLSF_decode: NLSFIndices[order+1] (idx[0]=cb1, idx[1..order]=residuals) -> pNLSF_Q15[order].
fn silk_nlsf_decode(nlsf_idx, fs_kHz, pNLSF_out) {
    if (_silk_cb1nlsf_nb == 0) { _silk_tables3_init(); }
    var order = 16;
    var cb1tab = _silk_cb1nlsf_wb;
    var wghttab = _silk_cb1wght_wb;
    var dmin = _silk_dmin_wb;
    var quant_step = 9830;
    if (fs_kHz == 8) {
        order = 10; cb1tab = _silk_cb1nlsf_nb; wghttab = _silk_cb1wght_nb;
        dmin = _silk_dmin_nb; quant_step = 11796;
    }
    var cb1 = load64(nlsf_idx + 0);
    var pred_q8 = alloc(order);
    var ec_ix = alloc(order * 8);
    silk_nlsf_unpack(cb1, fs_kHz, ec_ix, pred_q8);
    var res = alloc(order * 8);
    silk_nlsf_residual_dequant(res, nlsf_idx + 1 * 8, pred_q8, quant_step, order);
    var elem = cb1tab + cb1 * order;   # uint8 codebook bytes
    var wght = wghttab + cb1 * order * 8;
    var i = 0;
    while (i < order) {
        var tmp = silk_div_trunc(load64(res + i * 8) << 14, load64(wght + i * 8)) + (load8(elem + i) << 7);
        store64(pNLSF_out + i * 8, silk_limit(tmp, 0, 32767));
        i = i + 1;
    }
    silk_nlsf_stabilize(pNLSF_out, dmin, order);
    return 0;
}

