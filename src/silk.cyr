    store64(_silk_lsfcos_q12 + 104 * 8, 0 - 6812); store64(_silk_lsfcos_q12 + 105 * 8, 0 - 6922); store64(_silk_lsfcos_q12 + 106 * 8, 0 - 7026); store64(_silk_lsfcos_q12 + 107 * 8, 0 - 7128); store64(_silk_lsfcos_q12 + 108 * 8, 0 - 7226); store64(_silk_lsfcos_q12 + 109 * 8, 0 - 7318); store64(_silk_lsfcos_q12 + 110 * 8, 0 - 7406); store64(_silk_lsfcos_q12 + 111 * 8, 0 - 7490);
