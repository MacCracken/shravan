    store8(_silk_ltp_gain2 + 0, 241); store8(_silk_ltp_gain2 + 1, 225); store8(_silk_ltp_gain2 + 2, 211); store8(_silk_ltp_gain2 + 3, 199); store8(_silk_ltp_gain2 + 4, 187); store8(_silk_ltp_gain2 + 5, 175); store8(_silk_ltp_gain2 + 6, 164); store8(_silk_ltp_gain2 + 7, 153); store8(_silk_ltp_gain2 + 8, 142); store8(_silk_ltp_gain2 + 9, 132); store8(_silk_ltp_gain2 + 10, 123); store8(_silk_ltp_gain2 + 11, 114); store8(_silk_ltp_gain2 + 12, 105); store8(_silk_ltp_gain2 + 13, 96); store8(_silk_ltp_gain2 + 14, 88); store8(_silk_ltp_gain2 + 15, 80);
