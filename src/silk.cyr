    _silk_nlsf_interp = alloc(5);
    store8(_silk_nlsf_interp + 0, 243); store8(_silk_nlsf_interp + 1, 221); store8(_silk_nlsf_interp + 2, 192); store8(_silk_nlsf_interp + 3, 181); store8(_silk_nlsf_interp + 4, 0);
    return 0;
}

# ---- integer-width helpers (reuse sar/_i16 from opus.cyr) ----
fn silk_sx32(v) { return ((v & 0xFFFFFFFF) ^ 0x80000000) - 0x80000000; }

# silk_SMULBB(a,b) = (int16)a * (int16)b, result int32.
fn silk_smulbb(a, b) { return silk_sx32(_i16(a) * _i16(b)); }

# silk_SMULWB(a,b) = (a>>16)*(int16)b + ((a&0xFFFF)*(int16)b)>>16  (both >> arithmetic).
fn silk_smulwb(a, b) {
    var b16 = _i16(b);
    return sar(a, 16) * b16 + sar((a & 0xFFFF) * b16, 16);
}

# silk_MUL(a,b) = (int32)(a*b)
fn silk_mul(a, b) { return silk_sx32(a * b); }

# silk_SMLAWB(a,b,c) = (int32)(a + silk_SMULWB(b,c))
fn silk_smlawb(a, b, c) { return silk_sx32(a + silk_smulwb(b, c)); }

# silk_log2lin(inLog_Q7) -> Q16 linear (gain_quant.c / log2lin.c).
fn silk_log2lin(inLog) {
    if (inLog < 0) { return 0; }
    if (inLog >= 3967) { return 2147483647; }
    var out = 1 << (inLog >> 7);
    var frac = inLog & 0x7F;
    var t = silk_smlawb(frac, silk_smulbb(frac, 128 - frac), 0 - 174);
    if (inLog < 2048) {
        # ADD_RSHIFT32(out, MUL(out,t), 7)
        out = silk_sx32(out + sar(silk_mul(out, t), 7));
    } else {
        # MLA(out, RSHIFT(out,7), t) = out + (out>>7)*t
        out = silk_sx32(out + silk_mul(sar(out, 7), t));
    }
    return out;
}

# ---- gains dequant (gain_quant.c) ----
fn _silk_gains_dequant_impl(GI, gains_out, lastgain_ptr, conditional, nb_subfr) {
    var prev_ind = load64(lastgain_ptr);
    var k = 0;
    while (k < nb_subfr) {
        var gk = load64(GI + k * 8);
        if ((k == 0) & (conditional == 0)) {
            var lo = prev_ind - 16;
            prev_ind = gk;
            if (lo > prev_ind) { prev_ind = lo; }
        } else {
            var ind_tmp = gk - 4;                 # + MIN_DELTA_GAIN_QUANT(-4)
            var thr = 8 + prev_ind;               # 2*36 - 64 + prev_ind
            if (ind_tmp > thr) {
                prev_ind = prev_ind + ((ind_tmp << 1) - thr);
            } else {
                prev_ind = prev_ind + ind_tmp;
            }
        }
        if (prev_ind < 0) { prev_ind = 0; }
        if (prev_ind > 63) { prev_ind = 63; }
        var il = silk_smulwb(1907825, prev_ind) + 2090;
        if (il > 3967) { il = 3967; }
        store64(gains_out + k * 8, silk_log2lin(il));
        k = k + 1;
    }
    store64(lastgain_ptr, prev_ind);
    return 0;
}

# ---- silk_decode_indices (full A-G) ----
# silk_NLSF_unpack: fill ec_ix[order] (stage-2 icdf offsets) + pred_Q8[order].
fn silk_nlsf_unpack(cb1_index, fs_kHz, ec_ix, pred_out) {
    var order = 16;
    var ec_sel = _silk_ec_sel_wb;
    var pred = _silk_pred_wb;
    if (fs_kHz == 8) { order = 10; ec_sel = _silk_ec_sel_nb; pred = _silk_pred_nb; }
    var base = cb1_index * order / 2;
    var i = 0;
    while (i < order) {
        var entry = load8(ec_sel + base + i / 2);
        store64(ec_ix + i * 8, ((entry >> 1) & 7) * 9);
        store8(pred_out + i, load8(pred + (i + (entry & 1) * (order - 1))));
        store64(ec_ix + (i + 1) * 8, ((entry >> 5) & 7) * 9);
        store8(pred_out + (i + 1), load8(pred + (i + ((entry >> 4) & 1) * (order - 1) + 1)));
        i = i + 2;
    }
    return 0;
}

# Full silk_decode_indices (Steps A-G, mono 20ms, condCoding INDEPENDENTLY).
# out layout: 0 signalType, 1 quantOffset, 2..5 GainsIndices, 6..9 Gains_Q16,
# 10 NLSF0, 11 NInterp, 12 lag, 13 contour, 14 PER, 15 LTPscale, 16 seed,
# 17 ec_tell, 18..18+order NLSFIndices[0..order], (19+order)..(22+order) LTPIndex[0..3].
# Payload wrapper: create a fresh ec over the SILK payload, then decode indices.
fn silk_decode_indices(payload, len, fs_kHz, lastgain_ptr, out) {
    var ec = ec_dec_new(payload, len);
    var vad = ec_dec_bit_logp(ec, 1);   # LP header: VAD flag
    var lbrr = ec_dec_bit_logp(ec, 1);  # LP header: LBRR flag (unused; LBRR not handled)
    return silk_decode_indices_ec(ec, fs_kHz, lastgain_ptr, out, vad, 4);
}

# ec-taking core: decode LP header + indices from an externally-owned range decoder
# (shared with CELT in hybrid mode). Returns the ec so the caller can continue (pulses).
# ec-taking core with a PRE-READ `vad` flag (the LP-header VAD/LBRR flags are read by the
# caller — mono/hybrid read them here per-frame; stereo reads both channels' flags up front).
fn silk_decode_indices_ec(ec, fs_kHz, lastgain_ptr, out, vad, nb_subfr) {
    if (_silk_type_VAD == 0) { _silk_tables_init(); }
    if (_silk_ec_sel_nb == 0) { _silk_tables2_init(); }
    if (_silk_contour_10_wb == 0) { _silk_tables6_init(); }
    var order = 16;
    if (fs_kHz == 8) { order = 10; }
    # A: signal type
    var Ix = 0;
    if (vad != 0) { Ix = ec_dec_icdf(ec, _silk_type_VAD, 8) + 2; }
    else { Ix = ec_dec_icdf(ec, _silk_type_noVAD, 8); }
    var signalType = Ix >> 1;
    var quantOffset = Ix & 1;
    # B: gains
    var GI = alloc(4 * 8);
    var g0 = ec_dec_icdf(ec, _silk_gain_iCDF + signalType * 8, 8) << 3;
    g0 = g0 + ec_dec_icdf(ec, _silk_uniform8, 8);
    store64(GI + 0, g0);
    var i = 1;
    while (i < nb_subfr) { store64(GI + i * 8, ec_dec_icdf(ec, _silk_delta_gain, 8)); i = i + 1; }
    var gains = alloc(4 * 8);
    _silk_gains_dequant_impl(GI, gains, lastgain_ptr, 0, nb_subfr);
    # C: NLSF stage-1 index
    var cb1 = _silk_cb1_wb;
    if (fs_kHz == 8) { cb1 = _silk_cb1_nb; }
    var nlsf0 = ec_dec_icdf(ec, cb1 + (signalType >> 1) * 32, 8);
    var NLSF = alloc((order + 1) * 8);
    store64(NLSF + 0, nlsf0);
    # D: NLSF stage-2 residuals
    var ec_ix = alloc(order * 8);
    var pred = alloc(order);
    silk_nlsf_unpack(nlsf0, fs_kHz, ec_ix, pred);
    var ec_icdf = _silk_ec_icdf_wb;
    if (fs_kHz == 8) { ec_icdf = _silk_ec_icdf_nb; }
    i = 0;
    while (i < order) {
        var Ix2 = ec_dec_icdf(ec, ec_icdf + load64(ec_ix + i * 8), 8);
        if (Ix2 == 0) { Ix2 = Ix2 - ec_dec_icdf(ec, _silk_nlsf_ext, 8); }
        else { if (Ix2 == 8) { Ix2 = Ix2 + ec_dec_icdf(ec, _silk_nlsf_ext, 8); } }
        store64(NLSF + (i + 1) * 8, Ix2 - 4);
        i = i + 1;
    }
    # E: interpolation factor — only coded for nb_subfr==4 (20ms); else forced to 4.
    var NInterp = 4;
    if (nb_subfr == 4) { NInterp = ec_dec_icdf(ec, _silk_nlsf_interp, 8); }
    # F: voiced block
    var lag = 0;
    var cont = 0;
    var PER = 0;
    var LTPsc = 0;
    var LTPI = alloc(4 * 8);
    var kk = 0;
    while (kk < nb_subfr) { store64(LTPI + kk * 8, 0); kk = kk + 1; }
    if (signalType == 2) {
        lag = ec_dec_icdf(ec, _silk_pitch_lag, 8) * (fs_kHz >> 1);
        var lowbits = _silk_uniform8;
        if (fs_kHz == 8) { lowbits = _silk_uniform4; }
        lag = lag + ec_dec_icdf(ec, lowbits, 8);
        # contour codebook depends on both bandwidth (NB/WB) and frame size (10/20ms).
        var contour = _silk_pitch_contour;                       # WB 20ms
        if (fs_kHz == 8) { contour = _silk_pitch_contour_nb; }   # NB 20ms
        if (nb_subfr == 2) {
            contour = _silk_contour_10_wb;                       # WB 10ms
            if (fs_kHz == 8) { contour = _silk_contour_10_nb; }  # NB 10ms
        }
        cont = ec_dec_icdf(ec, contour, 8);
        PER = ec_dec_icdf(ec, _silk_ltp_per, 8);
        var ltpgain = _silk_ltp_gain0;
        if (PER == 1) { ltpgain = _silk_ltp_gain1; }
        if (PER == 2) { ltpgain = _silk_ltp_gain2; }
        kk = 0;
        while (kk < nb_subfr) { store64(LTPI + kk * 8, ec_dec_icdf(ec, ltpgain, 8)); kk = kk + 1; }
        LTPsc = ec_dec_icdf(ec, _silk_ltpscale, 8);
    }
    # G: seed
    var seed = ec_dec_icdf(ec, _silk_uniform4, 8);
    # outputs
    store64(out + 0 * 8, signalType);
    store64(out + 1 * 8, quantOffset);
    var j = 0;
    while (j < nb_subfr) { store64(out + (2 + j) * 8, load64(GI + j * 8)); j = j + 1; }
    j = 0;
    while (j < nb_subfr) { store64(out + (6 + j) * 8, load64(gains + j * 8)); j = j + 1; }
    store64(out + 10 * 8, nlsf0);
    store64(out + 11 * 8, NInterp);
    store64(out + 12 * 8, lag);
    store64(out + 13 * 8, cont);
    store64(out + 14 * 8, PER);
    store64(out + 15 * 8, LTPsc);
    store64(out + 16 * 8, seed);
    store64(out + 17 * 8, ec_tell(ec));
    j = 0;
    while (j <= order) { store64(out + (18 + j) * 8, load64(NLSF + j * 8)); j = j + 1; }
    var lbase = 19 + order;
    j = 0;
    while (j < nb_subfr) { store64(out + (lbase + j) * 8, load64(LTPI + j * 8)); j = j + 1; }
    return ec;
}

