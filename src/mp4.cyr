# mp4.cyr — MP4 / M4A (ISO Base Media File Format) container demux (2.5.7)
#
# Parses the box tree (ftyp / moov / trak / mdia / minf / stbl), locates the audio
# track's sample table and computes each sample's byte range in the file (stsc +
# stco/co64 + stsz). ALAC frames decode directly. AAC decodes by wrapping each
# access unit in an ADTS header and handing the stream to the existing aac_decode.
# Big-endian throughout (read_*_be come from shravan.cyr).

# Box type FourCCs as big-endian u32 (matches read_u32_be of the type field).
var MP4_FTYP = 0x66747970;   # "ftyp"
var MP4_MOOV = 0x6D6F6F76;   # "moov"
var MP4_TRAK = 0x7472616B;   # "trak"
var MP4_MDIA = 0x6D646961;   # "mdia"
var MP4_MINF = 0x6D696E66;   # "minf"
var MP4_STBL = 0x7374626C;   # "stbl"
var MP4_STSD = 0x73747364;   # "stsd"
var MP4_STSZ = 0x7374737A;   # "stsz"
var MP4_STCO = 0x7374636F;   # "stco"
var MP4_CO64 = 0x636F3634;   # "co64"
var MP4_STSC = 0x73747363;   # "stsc"
var MP4_HDLR = 0x68646C72;   # "hdlr"
var MP4_MP4A = 0x6D703461;   # "mp4a"
var MP4_ALAC = 0x616C6163;   # "alac"
var MP4_ESDS = 0x65736473;   # "esds"
var MP4_WAVE = 0x77617665;   # "wave"
var MP4_SOUN = 0x736F756E;   # "soun"
var MP4_MDAT = 0x6D646174;   # "mdat"

# demux result struct (40 bytes)
var MP4_DX_CHANNELS = 0;
var MP4_DX_RATE = 8;
var MP4_DX_COUNT = 16;
var MP4_DX_OFFSETS = 24;   # ptr to sample_count u64 file offsets
var MP4_DX_SIZES = 32;     # ptr to sample_count u64 sizes
var MP4_DX_CODEC = 40;     # MP4_CODEC_*
var MP4_DX_COOKIE = 48;    # ALAC only: ptr to the 24-byte ALACSpecificConfig
var MP4_DX_SIZE = 56;

var MP4_CODEC_AAC = 1;
var MP4_CODEC_ALAC = 2;

# mp4_audio_info outcomes other than 0.
var MP4_MALFORMED = 0 - 1;
var MP4_UNSUPPORTED = 0 - 2;

# Is this buffer an MP4/ISOBMFF file? ("ftyp" at offset 4).
fn mp4_detect(data, len) {
    if (len < 8) { return 0; }
    if (read_u32_be(data, 4) == MP4_FTYP) { return 1; }
    return 0;
}

# Find a child box of `type` within [start, end). Returns the payload start offset
# and writes the box's payload end to out_end; returns -1 if not found/malformed.
fn mp4_find(data, start, end, type, out_end) {
    var pos = start;
    while (pos + 8 <= end) {
        var size = read_u32_be(data, pos);
        var btype = read_u32_be(data, pos + 4);
        var hdr = 8;
        var box_end = pos + size;
        if (size == 1) {
            if (pos + 16 > end) { return 0 - 1; }   # largesize needs a 16-byte header
            # 64-bit largesize. A hostile high word gives a value that wraps
            # negative or runs past `end`; both are handled just below.
            box_end = pos + ((read_u32_be(data, pos + 8) << 32) | read_u32_be(data, pos + 12));
            hdr = 16;
        }
        if (size == 0) { box_end = end; }
        if (box_end > end) { box_end = end; }
        if (box_end < pos + hdr) { return 0 - 1; }   # malformed: no room / no advance
        if (btype == type) {
            store64(out_end, box_end);
            return pos + hdr;
        }
        pos = box_end;
    }
    return 0 - 1;
}

# Navigate to the audio track's stbl payload. Returns stbl payload start (writes
# its end to out_end), or -1. Picks the trak whose mdia/hdlr handler is 'soun'.
fn mp4_find_audio_stbl(data, len, out_end) {
    var moov_end = alloc(8);
    var moov = mp4_find(data, 0, len, MP4_MOOV, moov_end);
    if (moov < 0) { return 0 - 1; }
    var mend = load64(moov_end);
    var pos = moov;
    while (pos + 8 <= mend) {
        var size = read_u32_be(data, pos);
        var btype = read_u32_be(data, pos + 4);
        var hdr = 8;
        var box_end = pos + size;
        # A 64-bit largesize, as mp4_find reads it. This walk used to take size 1
        # literally and step through a large trak a byte at a time, never finding it.
        if (size == 1) {
            if (pos + 16 > mend) { return 0 - 1; }
            box_end = pos + ((read_u32_be(data, pos + 8) << 32) | read_u32_be(data, pos + 12));
            hdr = 16;
        }
        if (size == 0) { box_end = mend; }
        if (box_end > mend) { box_end = mend; }
        if (box_end < pos + hdr) { return 0 - 1; }
        if (btype == MP4_TRAK) {
            var mdia_end = alloc(8);
            var mdia = mp4_find(data, pos + hdr, box_end, MP4_MDIA, mdia_end);
            if (mdia >= 0) {
                var mdend = load64(mdia_end);
                var hdlr_end = alloc(8);
                var hdlr = mp4_find(data, mdia, mdend, MP4_HDLR, hdlr_end);
                var is_audio = 0;
                if (hdlr >= 0) {
                    # hdlr: version+flags(4) + pre_defined(4) + handler_type(4).
                    # Guard the handler_type read (ends at hdlr+12) against the box.
                    if (hdlr + 12 <= load64(hdlr_end)) {
                        if (read_u32_be(data, hdlr + 8) == MP4_SOUN) { is_audio = 1; }
                    }
                }
                if (is_audio == 1) {
                    var minf_end = alloc(8);
                    var minf = mp4_find(data, mdia, mdend, MP4_MINF, minf_end);
                    if (minf >= 0) {
                        var stbl = mp4_find(data, minf, load64(minf_end), MP4_STBL, out_end);
                        if (stbl >= 0) { return stbl; }
                    }
                }
            }
        }
        pos = box_end;
    }
    return 0 - 1;
}

# Read an MPEG-4 descriptor's variable-length size at *pp_ptr, which starts just
# past the tag. Each byte carries 7 bits, and a set top bit means another follows.
# Advances *pp_ptr. Returns the size, or -1 if it runs past `end`.
fn _mp4_desc_len(data, pp_ptr, end) {
    var p = load64(pp_ptr);
    var size = 0;
    var i = 0;
    while (i < 4) {
        if (p >= end) { return MP4_MALFORMED; }
        var b = load8(data + p);
        p = p + 1;
        size = (size << 7) | (b & 0x7F);
        i = i + 1;
        if ((b & 0x80) == 0) {
            store64(pp_ptr, p);
            return size;
        }
    }
    return MP4_MALFORMED;
}

# Read n bits (n <= 24) at bit offset `bit` of the bytes at p, MSB first.
fn _mp4_bits(data, p, bit, n) {
    var v = 0;
    var i = 0;
    while (i < n) {
        var at = bit + i;
        v = (v << 1) | ((load8(data + p + at / 8) >> (7 - (at & 7))) & 1);
        i = i + 1;
    }
    return v;
}

fn _mp4_sf_rate(index) {
    if (index == 0)  { return 96000; }
    if (index == 1)  { return 88200; }
    if (index == 2)  { return 64000; }
    if (index == 3)  { return 48000; }
    if (index == 4)  { return 44100; }
    if (index == 5)  { return 32000; }
    if (index == 6)  { return 24000; }
    if (index == 7)  { return 22050; }
    if (index == 8)  { return 16000; }
    if (index == 9)  { return 12000; }
    if (index == 10) { return 11025; }
    if (index == 11) { return 8000; }
    if (index == 12) { return 7350; }
    return 0;
}

# Parse an esds box body: ES_Descriptor > DecoderConfigDescriptor > the
# AudioSpecificConfig, whose object type, rate and channels replace what the
# sample entry claims. Only AAC-LC decodes: HE-AAC would play at half rate with no
# high band, so it is reported unsupported rather than as wrong audio.
# Writes out[0]=channels and out[8]=rate; channel config 0 leaves out[0] alone.
fn mp4_parse_esds(data, p, end, out) {
    var pp = alloc(8);
    p = p + 4;                                         # version + flags
    if (p >= end) { return MP4_MALFORMED; }
    if (load8(data + p) != 3) { return MP4_MALFORMED; }   # ES_DescrTag
    store64(pp, p + 1);
    if (_mp4_desc_len(data, pp, end) < 0) { return MP4_MALFORMED; }
    p = load64(pp);
    if (p + 3 > end) { return MP4_MALFORMED; }
    var es_flags = load8(data + p + 2);
    p = p + 3;
    if ((es_flags & 0x80) != 0) { p = p + 2; }         # dependsOn_ES_ID
    if ((es_flags & 0x40) != 0) {                      # URL
        if (p >= end) { return MP4_MALFORMED; }
        p = p + 1 + load8(data + p);
    }
    if ((es_flags & 0x20) != 0) { p = p + 2; }         # OCR_ES_ID

    if (p >= end) { return MP4_MALFORMED; }
    if (load8(data + p) != 4) { return MP4_MALFORMED; }   # DecoderConfigDescrTag
    store64(pp, p + 1);
    if (_mp4_desc_len(data, pp, end) < 0) { return MP4_MALFORMED; }
    p = load64(pp);
    if (p + 13 > end) { return MP4_MALFORMED; }
    var oti = load8(data + p);
    # 0x40 is MPEG-4 audio, and 0x67 is MPEG-2 AAC LC. The rest is MP3 and others.
    if (oti != 0x40) {
        if (oti != 0x67) { return MP4_UNSUPPORTED; }
    }
    p = p + 13;

    if (p >= end) { return MP4_MALFORMED; }
    if (load8(data + p) != 5) { return MP4_MALFORMED; }   # DecSpecificInfoTag
    store64(pp, p + 1);
    var asc_len = _mp4_desc_len(data, pp, end);
    if (asc_len < 2) { return MP4_MALFORMED; }
    p = load64(pp);
    if (p + asc_len > end) { return MP4_MALFORMED; }

    # 5 bits of object type (31 escapes), then a 4-bit rate index (15 escapes to
    # a 24-bit rate), then 4 bits of channel config. That is at most 42 bits.
    if (asc_len < 6) {
        if (_mp4_bits(data, p, 0, 5) == 31) { return MP4_UNSUPPORTED; }
    }
    var aot = _mp4_bits(data, p, 0, 5);
    if (aot != 2) { return MP4_UNSUPPORTED; }
    var index = _mp4_bits(data, p, 5, 4);
    var bit = 9;
    var rate = 0;
    if (index == 15) {
        if (asc_len < 5) { return MP4_MALFORMED; }
        rate = _mp4_bits(data, p, bit, 24);
        bit = bit + 24;
    } else {
        rate = _mp4_sf_rate(index);
    }
    if (rate <= 0) { return MP4_MALFORMED; }
    var chan = _mp4_bits(data, p, bit, 4);
    store64(out + 8, rate);
    if (chan >= 1) {
        if (chan <= 6) { store64(out, chan); }
        if (chan == 7) { store64(out, 8); }
    }
    return 0;
}

# Read the codec, channel count and sample rate from the first sample entry into
# out ([0]=channels, [8]=rate, [16]=codec, [24]=ALAC cookie ptr).
#
# An AudioSampleEntry is 28 bytes ahead of its child boxes: 8 of SampleEntry, then
# version(2) revision(2) vendor(4), channels(2) samplesize(2) predefined(2)
# reserved(2) and rate(4, 16.16 fixed). ISO files use version 0. QuickTime's
# version 1 adds 16 bytes, and its version 2 adds 36 and moves the rate (an f64 at
# +32) and channels (a u32 at +40) into them.
# Returns 0, MP4_MALFORMED or MP4_UNSUPPORTED.
fn mp4_audio_info(data, stbl, stbl_end, out) {
    var e = alloc(8);
    var stsd = mp4_find(data, stbl, stbl_end, MP4_STSD, e);
    if (stsd < 0) { return MP4_MALFORMED; }
    var stsd_end = load64(e);
    # stsd: version+flags(4) + entry_count(4) + first sample entry box
    var entry = stsd + 8;
    if (entry + 8 > stsd_end) { return MP4_MALFORMED; }
    var entry_size = read_u32_be(data, entry);
    var entry_type = read_u32_be(data, entry + 4);
    if (entry_size < 8) { return MP4_MALFORMED; }
    var entry_end = entry + entry_size;
    if (entry_end > stsd_end) { entry_end = stsd_end; }
    var body = entry + 8;
    if (body + 28 > entry_end) { return MP4_MALFORMED; }

    var version = read_u16_be(data, body + 8);
    var channels = read_u16_be(data, body + 16);
    var rate = read_u16_be(data, body + 24);
    var children = body + 28;
    if (version == 1) { children = body + 44; }
    if (version == 2) {
        if (body + 64 > entry_end) { return MP4_MALFORMED; }
        children = body + 64;
        rate = f64_to((read_u32_be(data, body + 32) << 32) | read_u32_be(data, body + 36));
        channels = read_u32_be(data, body + 40);
        # The f64 is the file's: negative, NaN or absurd values mean "unknown",
        # as a v0 entry's overflowed 16.16 rate does; the esds or cookie decides.
        if (rate < 0) { rate = 0; }
        if (rate > 4000000) { rate = 0; }
    }
    if (version > 2) { return MP4_MALFORMED; }
    store64(out, channels);
    store64(out + 8, rate);

    if (entry_type == MP4_MP4A) {
        store64(out + 16, MP4_CODEC_AAC);
        var esds = mp4_find(data, children, entry_end, MP4_ESDS, e);
        if (esds < 0) {
            # QuickTime nests it inside a `wave` box.
            var wave = mp4_find(data, children, entry_end, MP4_WAVE, e);
            if (wave >= 0) { esds = mp4_find(data, wave, load64(e), MP4_ESDS, e); }
        }
        if (esds >= 0) { return mp4_parse_esds(data, esds, load64(e), out); }
        return 0;
    }

    if (entry_type == MP4_ALAC) {
        # A child box of the same name: version+flags(4), then the config.
        # QuickTime nests it inside a `wave` box, as it does esds.
        var alac = mp4_find(data, children, entry_end, MP4_ALAC, e);
        if (alac < 0) {
            var wave = mp4_find(data, children, entry_end, MP4_WAVE, e);
            if (wave >= 0) { alac = mp4_find(data, wave, load64(e), MP4_ALAC, e); }
        }
        if (alac < 0) { return MP4_MALFORMED; }
        if (alac + 28 > load64(e)) { return MP4_MALFORMED; }
        store64(out + 16, MP4_CODEC_ALAC);
        store64(out + 24, data + alac + 4);
        return 0;
    }

    return MP4_UNSUPPORTED;
}

# Build the per-sample (offset, size) table from stsz + stco/co64 + stsc into the
# demux struct dx (offsets/sizes arrays allocated here). Returns 0 or -1.
var _mp4_max_count = 0;   # set by mp4_demux from the ceiling and the codec's frame size

fn mp4_build_sample_table(data, len, stbl, stbl_end, dx) {
    var e = alloc(8);
    # --- stsz: sample sizes ---
    var stsz = mp4_find(data, stbl, stbl_end, MP4_STSZ, e);
    if (stsz < 0) { return 0 - 1; }
    var stsz_end = load64(e);
    if (stsz + 12 > stsz_end) { return 0 - 1; }        # FullBox header must fit the box
    var size_default = read_u32_be(data, stsz + 4);
    var count = read_u32_be(data, stsz + 8);
    if (count <= 0) { return 0 - 1; }
    if (count > len) { return 0 - 1; }                 # can't have more samples than bytes
    if (count > _mp4_max_count) { return 0 - 2; }      # more output than the one-shot ceiling
    if (size_default == 0) {
        if (stsz + 12 + count * 4 > stsz_end) { return 0 - 1; }   # inline table must fit the box
    } else {
        # SEC-033: a constant sample size needs no table, so nothing tied count to
        # the box. count = len with size 1 made two count*8 tables, 16x the input
        # (an 8 MiB file allocated 134 MB, a 256 MiB one about 4 GiB). Every sample
        # has to fit in the file, and since 2.9.3 the bound counts at least 4 bytes
        # a sample: `count <= len / size` alone still let size 1 through at 16x (a
        # 2.9.3 audit measured 142 MiB resident from 8 MiB). With the floor the
        # tables stay within 4x the input, as an explicit stsz table's 4-byte
        # entries already bound them, and a real file (its samples never overlap)
        # always passes.
        var floor = size_default;
        if (floor < 4) { floor = 4; }
        if (count > len / floor) { return 0 - 1; }
    }
    var sizes = _safe_alloc_mul(count, 8);
    if (sizes <= 0) { return 0 - 1; }
    # The samples of a real file never overlap, so their sizes sum to at most the
    # file. Chunk offsets can point many samples at the same bytes, each in bounds,
    # and the AAC path then staged sum(sizes) bytes: a 270 KB file made a 520 MiB
    # copy (2.9.3 audit). Refused here, for both codecs, before anything is staged.
    var sum = 0;
    var i = 0;
    while (i < count) {
        var sv = size_default;
        if (size_default == 0) { sv = read_u32_be(data, stsz + 12 + i * 4); }
        store64(sizes + i * 8, sv);
        sum = sum + sv;
        if (sum > len) { return 0 - 1; }
        i = i + 1;
    }
    # --- stco (or co64): chunk offsets ---
    var stco = mp4_find(data, stbl, stbl_end, MP4_STCO, e);
    var is64 = 0;
    if (stco < 0) {
        stco = mp4_find(data, stbl, stbl_end, MP4_CO64, e);
        is64 = 1;
    }
    if (stco < 0) { return 0 - 1; }
    var stco_end = load64(e);
    if (stco + 8 > stco_end) { return 0 - 1; }         # version+flags + entry_count must fit
    var chunk_count = read_u32_be(data, stco + 4);
    if (chunk_count <= 0) { return 0 - 1; }
    if (chunk_count > len) { return 0 - 1; }
    var entry_sz = 4;
    if (is64 == 1) { entry_sz = 8; }
    if (stco + 8 + chunk_count * entry_sz > stco_end) { return 0 - 1; }   # table must fit the box
    var chunk_off = alloc(chunk_count * 8);
    if (chunk_off == 0) { return 0 - 1; }
    var c = 0;
    while (c < chunk_count) {
        if (is64 == 1) {
            # 64-bit: hi at +8+c*8, lo at +12+c*8. The decoders reject an offset
            # that is negative or past the end of the buffer.
            store64(chunk_off + c * 8, (read_u32_be(data, stco + 8 + c * 8) << 32)
              | read_u32_be(data, stco + 12 + c * 8));
        } else {
            store64(chunk_off + c * 8, read_u32_be(data, stco + 8 + c * 4));
        }
        c = c + 1;
    }
    # --- stsc: sample-to-chunk ---
    var stsc = mp4_find(data, stbl, stbl_end, MP4_STSC, e);
    if (stsc < 0) { return 0 - 1; }
    var stsc_end = load64(e);
    if (stsc + 8 > stsc_end) { return 0 - 1; }         # version+flags + entry_count must fit
    var stsc_count = read_u32_be(data, stsc + 4);
    if (stsc_count <= 0) { return 0 - 1; }
    if (stsc + 8 + stsc_count * 12 > stsc_end) { return 0 - 1; }   # entries must fit the box
    var stsc_base = stsc + 8;   # entries: first_chunk(4) samples_per_chunk(4) desc(4)
    # --- walk chunks, assign consecutive samples ---
    var offsets = _safe_alloc_mul(count, 8);
    if (offsets <= 0) { return 0 - 1; }
    var sample_idx = 0;
    var stsc_i = 0;
    var chunk = 1;   # 1-based
    while (chunk <= chunk_count) {
        if (sample_idx >= count) { chunk = chunk_count + 1; }
        else {
            # advance to the stsc entry governing this chunk
            var adv = 1;
            while (adv == 1) {
                adv = 0;
                if (stsc_i + 1 < stsc_count) {
                    if (read_u32_be(data, stsc_base + (stsc_i + 1) * 12) <= chunk) {
                        stsc_i = stsc_i + 1;
                        adv = 1;
                    }
                }
            }
            var spc = read_u32_be(data, stsc_base + stsc_i * 12 + 4);
            var off = load64(chunk_off + (chunk - 1) * 8);
            var k = 0;
            while (k < spc) {
                if (sample_idx >= count) { k = spc; }
                else {
                    store64(offsets + sample_idx * 8, off);
                    off = off + load64(sizes + sample_idx * 8);
                    sample_idx = sample_idx + 1;
                    k = k + 1;
                }
            }
            chunk = chunk + 1;
        }
    }
    store64(dx + MP4_DX_COUNT, sample_idx);
    store64(dx + MP4_DX_OFFSETS, offsets);
    store64(dx + MP4_DX_SIZES, sizes);
    return 0;
}

# Demux an MP4/M4A buffer: fills a freshly allocated demux struct (channels, rate,
# sample count, per-sample offsets + sizes). Returns the struct ptr, or err().
fn mp4_demux(data, len) {
    if (mp4_detect(data, len) == 0) { return err(ERR_INVALID_HEADER); }
    var stbl_end = alloc(8);
    var stbl = mp4_find_audio_stbl(data, len, stbl_end);
    if (stbl < 0) { return err(ERR_UNSUPPORTED_FMT); }
    var dx = alloc(MP4_DX_SIZE);
    var info = alloc(32);
    var rc = mp4_audio_info(data, stbl, load64(stbl_end), info);
    if (rc == MP4_UNSUPPORTED) { return err(ERR_UNSUPPORTED_FMT); }
    if (rc < 0) { return err(ERR_INVALID_HEADER); }
    store64(dx + MP4_DX_CHANNELS, load64(info));
    store64(dx + MP4_DX_RATE, load64(info + 8));
    store64(dx + MP4_DX_CODEC, load64(info + 16));
    store64(dx + MP4_DX_COOKIE, load64(info + 24));
    # The sample table is allocated before anything decodes, so its size is bounded
    # by the output it implies: count * samples-per-frame * channels must fit the
    # one-shot ceiling (1024 for AAC; the cookie's frameLength for ALAC).
    var spf = 1024;
    if (load64(info + 16) == MP4_CODEC_ALAC) {
        spf = read_u32_be(load64(info + 24), 0);
        if (spf < 1) { return err(ERR_INVALID_HEADER); }
    }
    var ch = load64(info);
    if (ch < 1) { ch = 1; }
    _mp4_max_count = _shravan_max_samples / (spf * ch);
    var bt = mp4_build_sample_table(data, len, stbl, load64(stbl_end), dx);
    if (bt == 0 - 2) { return err(ERR_TOO_LARGE); }
    if (bt < 0) { return err(ERR_INVALID_HEADER); }
    return dx;
}

# Decode an MP4/M4A buffer to PCM. ALAC frames go straight to the decoder. For AAC,
# extract each access unit, prepend an ADTS header (from the track's rate and
# channels), and hand the ADTS stream to aac_decode.
fn mp4_decode(data, len) {
    var dx = mp4_demux(data, len);
    if (is_err(dx) == 1) { return dx; }
    var channels = load64(dx + MP4_DX_CHANNELS);
    var rate = load64(dx + MP4_DX_RATE);
    var count = load64(dx + MP4_DX_COUNT);
    var offsets = load64(dx + MP4_DX_OFFSETS);
    var sizes = load64(dx + MP4_DX_SIZES);
    if (load64(dx + MP4_DX_CODEC) == MP4_CODEC_ALAC) {
        return alac_decode_frames(load64(dx + MP4_DX_COOKIE), data, len, offsets, sizes, count);
    }
    # The bridge writes an ADTS header per AU, which carries a 3-bit channel
    # configuration, a 13-bit frame length and a 4-bit rate index. Channel config 7
    # (8 channels) came out as 0 and rates outside the table as 44.1 kHz; more than
    # two channels is refused by the decoder anyway (until 2.10.3), and an AU over
    # 8184 bytes cannot be AAC-LC at two channels.
    if (channels > 2) { return err(ERR_UNSUPPORTED_FMT); }
    if (channels < 1) { return err(ERR_INVALID_CHANNELS); }
    if (_aac_sr_index_exact(rate) < 0) { return err(ERR_UNSUPPORTED_FMT); }
    # total ADTS stream size = sum(AU sizes) + 7 bytes header per AU
    var total = 0;
    var i = 0;
    while (i < count) {
        var asz = load64(sizes + i * 8);
        # SEC-030: bound the running total per iteration. Sample sizes come from
        # stsz as unsigned 32-bit values (up to ~4.29e9) and `count` is bounded
        # only by the file length, so the sum could in principle wrap past 2^63
        # and land on a SMALL positive value — alloc() would then succeed at the
        # wrapped size and the memcpy loop below would run off the end of it.
        # Capping at 256 MB (the _ALLOC_MAX policy) makes the wrap unreachable.
        if (asz < 0) { return err(ERR_DECODE); }
        if (asz > 8184) { return err(ERR_DECODE); }
        total = total + asz + 7;
        if (total > 268435456) { return err(ERR_DECODE); }
        i = i + 1;
    }
    if (total <= 0) { return err(ERR_DECODE); }
    var adts = alloc(total);
    if (adts == 0) { return err(ERR_DECODE); }
    var pos = 0;
    i = 0;
    while (i < count) {
        var sz = load64(sizes + i * 8);
        var off = load64(offsets + i * 8);
        # Each access unit must lie fully inside the input buffer (untrusted
        # offset/size). Use off>len then sz>len-off to avoid off+sz overflow.
        if (off < 0) { return err(ERR_DECODE); }
        if (sz < 0) { return err(ERR_DECODE); }
        if (off > len) { return err(ERR_DECODE); }
        if (sz > len - off) { return err(ERR_DECODE); }
        aac_build_adts_header(rate, channels, sz, adts + pos);
        pos = pos + 7;
        memcpy(adts + pos, data + off, sz);
        pos = pos + sz;
        i = i + 1;
    }
    return aac_decode(adts, pos);
}

# ================================================================
# Tests
# ================================================================

# Build a minimal single-chunk MP4 into `out` (ftyp + moov/trak/mdia/hdlr/minf/
# stbl{stsd(mp4a),stsz,stsc,stco} + mdat). `aus` is an array of AU byte pointers,
# `au_sizes` their sizes. Returns total length. (Test fixture builder.)
fn _mp4_test_build(channels, sr, aus, au_sizes, num_aus, out) {
    var p = 0;
    # ftyp
    write_u32_be(out, p, 24); p = p + 4;
    write_u32_be(out, p, MP4_FTYP); p = p + 4;
    write_u32_be(out, p, 0x4D344120); p = p + 4;   # 'M4A '
    write_u32_be(out, p, 0); p = p + 4;
    write_u32_be(out, p, 0x4D344120); p = p + 4;   # 'M4A '
    write_u32_be(out, p, 0x6D703432); p = p + 4;   # 'mp42'
    # moov
    var moov = p; write_u32_be(out, p, 0); p = p + 4; write_u32_be(out, p, MP4_MOOV); p = p + 4;
    var trak = p; write_u32_be(out, p, 0); p = p + 4; write_u32_be(out, p, MP4_TRAK); p = p + 4;
    var mdia = p; write_u32_be(out, p, 0); p = p + 4; write_u32_be(out, p, MP4_MDIA); p = p + 4;
    # hdlr
    var hdlr = p; write_u32_be(out, p, 0); p = p + 4; write_u32_be(out, p, MP4_HDLR); p = p + 4;
    write_u32_be(out, p, 0); p = p + 4;            # version+flags
    write_u32_be(out, p, 0); p = p + 4;            # pre_defined
    write_u32_be(out, p, MP4_SOUN); p = p + 4;     # handler_type 'soun'
    write_u32_be(out, p, 0); p = p + 4;
    write_u32_be(out, p, 0); p = p + 4;
    write_u32_be(out, p, 0); p = p + 4;            # 12 reserved
    store8(out + p, 0); p = p + 1;                 # name (empty)
    write_u32_be(out, hdlr, p - hdlr);
    # minf / stbl
    var minf = p; write_u32_be(out, p, 0); p = p + 4; write_u32_be(out, p, MP4_MINF); p = p + 4;
    var stbl = p; write_u32_be(out, p, 0); p = p + 4; write_u32_be(out, p, MP4_STBL); p = p + 4;
    # stsd { mp4a }
    var stsd = p; write_u32_be(out, p, 0); p = p + 4; write_u32_be(out, p, MP4_STSD); p = p + 4;
    write_u32_be(out, p, 0); p = p + 4;            # version+flags
    write_u32_be(out, p, 1); p = p + 4;            # entry_count
    var mp4a = p; write_u32_be(out, p, 0); p = p + 4; write_u32_be(out, p, MP4_MP4A); p = p + 4;
    write_u32_be(out, p, 0); p = p + 4;            # 6 reserved (4)
    write_u16_be(out, p, 0); p = p + 2;            # 6 reserved (2)
    write_u16_be(out, p, 1); p = p + 2;            # data_reference_index
    write_u32_be(out, p, 0); p = p + 4;            # 8 reserved
    write_u32_be(out, p, 0); p = p + 4;
    write_u16_be(out, p, channels); p = p + 2;     # channelcount
    write_u16_be(out, p, 16); p = p + 2;           # samplesize
    write_u16_be(out, p, 0); p = p + 2;            # pre_defined
    write_u16_be(out, p, 0); p = p + 2;            # reserved
    write_u16_be(out, p, sr); p = p + 2;           # samplerate hi (16.16)
    write_u16_be(out, p, 0); p = p + 2;            # samplerate lo
    write_u32_be(out, mp4a, p - mp4a);
    write_u32_be(out, stsd, p - stsd);
    # stsz
    var stsz = p; write_u32_be(out, p, 0); p = p + 4; write_u32_be(out, p, MP4_STSZ); p = p + 4;
    write_u32_be(out, p, 0); p = p + 4;            # version+flags
    write_u32_be(out, p, 0); p = p + 4;            # sample_size (variable)
    write_u32_be(out, p, num_aus); p = p + 4;      # sample_count
    var si = 0;
    while (si < num_aus) { write_u32_be(out, p, load64(au_sizes + si * 8)); p = p + 4; si = si + 1; }
    write_u32_be(out, stsz, p - stsz);
    # stsc (1 entry)
    var stsc = p; write_u32_be(out, p, 0); p = p + 4; write_u32_be(out, p, MP4_STSC); p = p + 4;
    write_u32_be(out, p, 0); p = p + 4;            # version+flags
    write_u32_be(out, p, 1); p = p + 4;            # entry_count
    write_u32_be(out, p, 1); p = p + 4;            # first_chunk
    write_u32_be(out, p, num_aus); p = p + 4;      # samples_per_chunk
    write_u32_be(out, p, 1); p = p + 4;            # sample_desc_index
    write_u32_be(out, stsc, p - stsc);
    # stco (1 chunk; offset back-patched to mdat payload)
    var stco = p; write_u32_be(out, p, 0); p = p + 4; write_u32_be(out, p, MP4_STCO); p = p + 4;
    write_u32_be(out, p, 0); p = p + 4;            # version+flags
    write_u32_be(out, p, 1); p = p + 4;            # entry_count
    var stco_off = p; write_u32_be(out, p, 0); p = p + 4;   # chunk offset placeholder
    write_u32_be(out, stco, p - stco);
    write_u32_be(out, stbl, p - stbl);
    write_u32_be(out, minf, p - minf);
    write_u32_be(out, mdia, p - mdia);
    write_u32_be(out, trak, p - trak);
    write_u32_be(out, moov, p - moov);
    # mdat
    var mdat = p; write_u32_be(out, p, 0); p = p + 4; write_u32_be(out, p, MP4_MDAT); p = p + 4;
    write_u32_be(out, stco_off, p);                # chunk offset = mdat payload start
    si = 0;
    while (si < num_aus) {
        var sz = load64(au_sizes + si * 8);
        memcpy(out + p, load64(aus + si * 8), sz);
        p = p + sz;
        si = si + 1;
    }
    write_u32_be(out, mdat, p - mdat);
    return p;
}

fn test_mp4_demux_parses() {
    test_group("mp4: demux parses track + sample table");
    var sizes = alloc(3 * 8);
    store64(sizes + 0, 10);
    store64(sizes + 8, 20);
    store64(sizes + 16, 15);
    var dummy = alloc(64);
    var aus = alloc(3 * 8);
    store64(aus + 0, dummy);
    store64(aus + 8, dummy);
    store64(aus + 16, dummy);
    var buf = alloc(8192);
    var mlen = _mp4_test_build(2, 44100, aus, sizes, 3, buf);
    assert(mp4_detect(buf, mlen) == 1, "detects mp4 (ftyp)");
    assert_eq(detect_format(buf, mlen), FMT_MP4, "detect_format -> FMT_MP4");
    var dx = mp4_demux(buf, mlen);
    assert(is_err(dx) == 0, "demux ok");
    assert_eq(load64(dx + MP4_DX_CHANNELS), 2, "channels=2");
    assert_eq(load64(dx + MP4_DX_RATE), 44100, "rate=44100");
    assert_eq(load64(dx + MP4_DX_COUNT), 3, "3 samples");
    var offs = load64(dx + MP4_DX_OFFSETS);
    var szs = load64(dx + MP4_DX_SIZES);
    assert_eq(load64(szs + 0), 10, "size0=10");
    assert_eq(load64(szs + 16), 15, "size2=15");
    assert_eq(load64(offs + 8) - load64(offs + 0), 10, "off1-off0 = size0");
    assert_eq(load64(offs + 16) - load64(offs + 8), 20, "off2-off1 = size1");
    return 0;
}

fn test_mp4_decode_roundtrip() {
    test_group("mp4: decode AAC AU -> PCM");
    if (_aac_sample_rates == 0) { aac_init(); }
    if (_aac_swb_offset == 0) { _aac_init_swb(); }
    var samples = vec_new();
    var i = 0;
    while (i < 1024) {
        vec_push(samples, f64_sin(f64_div(f64_from(i * 5), f64_from(50))));
        i = i + 1;
    }
    var adts = alloc(131072);
    var alen = aac_encode(samples, 44100, 1, 128000, adts);
    assert(is_err(alen) == 0, "aac encode ok");
    # extract the single AU (strip the 7-byte ADTS header)
    var framelen = ((load8(adts + 3) & 3) << 11) | (load8(adts + 4) << 3) | ((load8(adts + 5) >> 5) & 7);
    var au_size = framelen - 7;
    assert(au_size > 0, "AU non-empty");
    var aus = alloc(8);
    store64(aus, adts + 7);
    var szs = alloc(8);
    store64(szs, au_size);
    var buf = alloc(131072);
    var mlen = _mp4_test_build(1, 44100, aus, szs, 1, buf);
    var dec = mp4_decode(buf, mlen);
    assert(is_err(dec) == 0, "mp4 decode ok");
    assert(vec_len(decode_result_samples(dec)) == 1024, "one AU -> 1024 samples");
    return 0;
}

# Scan for a box whose type field matches `type`; returns box start or -1. (Test util.)
fn _mp4_scan_type(data, len, type) {
    var pos = 0;
    while (pos + 8 <= len) {
        if (read_u32_be(data, pos + 4) == type) { return pos; }
        pos = pos + 1;
    }
    return 0 - 1;
}

# Hostile input must be rejected (err), never crash / read out of bounds.
fn test_mp4_rejects_malformed() {
    test_group("mp4: rejects malformed input safely");
    # (1) ftyp only, no moov
    var b1 = alloc(16);
    write_u32_be(b1, 0, 16);
    write_u32_be(b1, 4, MP4_FTYP);
    write_u32_be(b1, 8, 0x4D344120);
    write_u32_be(b1, 12, 0);
    assert(is_err(mp4_demux(b1, 16)) == 1, "no moov -> demux err");
    assert(is_err(mp4_decode(b1, 16)) == 1, "no moov -> decode err");
    # (2) garbage body behind a valid ftyp
    var b2 = alloc(64);
    var i = 0;
    while (i < 64) { store8(b2 + i, (i * 37) & 0xFF); i = i + 1; }
    write_u32_be(b2, 0, 64);
    write_u32_be(b2, 4, MP4_FTYP);
    assert(is_err(mp4_demux(b2, 64)) == 1, "garbage body -> err (no crash)");
    # fixture for field-poisoning
    var sizes = alloc(8);
    store64(sizes, 10);
    var dummy = alloc(64);
    var aus = alloc(8);
    store64(aus, dummy);
    # (3) huge stsz sample_count -> bounded rejection (no OOB read / over-alloc)
    var b3 = alloc(8192);
    var l3 = _mp4_test_build(1, 44100, aus, sizes, 1, b3);
    var s = _mp4_scan_type(b3, l3, MP4_STSZ);
    assert(s > 0, "found stsz box");
    write_u32_be(b3, s + 16, 0x7FFFFFFF);
    assert(is_err(mp4_demux(b3, l3)) == 1, "huge stsz count rejected");
    # (4) out-of-range chunk offset -> decode rejects the AU (no OOB read)
    var b4 = alloc(8192);
    var l4 = _mp4_test_build(1, 44100, aus, sizes, 1, b4);
    var t = _mp4_scan_type(b4, l4, MP4_STCO);
    assert(t > 0, "found stco box");
    write_u32_be(b4, t + 16, 0x40000000);
    assert(is_err(mp4_decode(b4, l4)) == 1, "out-of-range AU offset rejected");
    return 0;
}

fn test_mp4_all() {
    test_mp4_demux_parses();
    test_mp4_decode_roundtrip();
    test_mp4_rejects_malformed();
    return 0;
}
