# ================================================================
# CELT bands / VQ (RFC 6716 §4.3.4) — bands.c + vq.c port (decode path)
# ================================================================
# Integer-exact pieces (bitexact_cos/log2tan, compute_qn, the recursion split
# bookkeeping, collapse masks, LCG) MUST match libopus or the range coder desyncs;
# the float pieces (normalise/rotation/denormalise/merge) only affect sample values.

var _celt_eMeans = 0;      # 21 f64
var _celt_spreadF = 0;     # {15,10,5}
var _celt_exp2_8 = 0;      # 8 int
var _celt_ordery = 0;      # ordery_table (offsets: stride-2)
var _celt_bitil = 0;       # bit_interleave_table[16]
var _celt_bitdeil = 0;     # bit_deinterleave_table[16]
var F64_SQRT1_2 = 0;       # 0.70710678

fn _celt_bands_tables_init() {
    var em = alloc(21 * 8);
    var m16 = alloc(21 * 8);
    store64(m16+0,103); store64(m16+8,100); store64(m16+16,92); store64(m16+24,85);
    store64(m16+32,81); store64(m16+40,77); store64(m16+48,72); store64(m16+56,70);
    store64(m16+64,78); store64(m16+72,75); store64(m16+80,73); store64(m16+88,71);
    store64(m16+96,78); store64(m16+104,74); store64(m16+112,69); store64(m16+120,72);
    store64(m16+128,70); store64(m16+136,74); store64(m16+144,76); store64(m16+152,71);
    store64(m16+160,60);
    var i = 0;
    while (i < 21) { store64(em + i * 8, f64_div(f64_from(load64(m16 + i * 8)), f64_from(16))); i = i + 1; }
    _celt_eMeans = em;
    _celt_spreadF = alloc(3 * 8);
    store64(_celt_spreadF + 0, 15); store64(_celt_spreadF + 8, 10); store64(_celt_spreadF + 16, 5);
    _celt_exp2_8 = alloc(8 * 8);
    store64(_celt_exp2_8+0,16384); store64(_celt_exp2_8+8,17866); store64(_celt_exp2_8+16,19483);
    store64(_celt_exp2_8+24,21247); store64(_celt_exp2_8+32,23170); store64(_celt_exp2_8+40,25267);
    store64(_celt_exp2_8+48,27554); store64(_celt_exp2_8+56,30048);
    _celt_ordery = alloc(30 * 8);
    var od = alloc(30 * 8);
    store64(od+0,1); store64(od+8,0);
    store64(od+16,3); store64(od+24,0); store64(od+32,2); store64(od+40,1);
    store64(od+48,7); store64(od+56,0); store64(od+64,4); store64(od+72,3); store64(od+80,6); store64(od+88,1); store64(od+96,5); store64(od+104,2);
    store64(od+112,15); store64(od+120,0); store64(od+128,8); store64(od+136,7); store64(od+144,12); store64(od+152,3); store64(od+160,11); store64(od+168,4);
    store64(od+176,14); store64(od+184,1); store64(od+192,9); store64(od+200,6); store64(od+208,13); store64(od+216,2); store64(od+224,10); store64(od+232,5);
    i = 0; while (i < 30) { store64(_celt_ordery + i * 8, load64(od + i * 8)); i = i + 1; }
    _celt_bitil = alloc(16);
    store8(_celt_bitil+0,0); store8(_celt_bitil+1,1); store8(_celt_bitil+2,1); store8(_celt_bitil+3,1);
    store8(_celt_bitil+4,2); store8(_celt_bitil+5,3); store8(_celt_bitil+6,3); store8(_celt_bitil+7,3);
    store8(_celt_bitil+8,2); store8(_celt_bitil+9,3); store8(_celt_bitil+10,3); store8(_celt_bitil+11,3);
    store8(_celt_bitil+12,2); store8(_celt_bitil+13,3); store8(_celt_bitil+14,3); store8(_celt_bitil+15,3);
    _celt_bitdeil = alloc(16);
    store8(_celt_bitdeil+0,0); store8(_celt_bitdeil+1,3); store8(_celt_bitdeil+2,12); store8(_celt_bitdeil+3,15);
    store8(_celt_bitdeil+4,48); store8(_celt_bitdeil+5,51); store8(_celt_bitdeil+6,60); store8(_celt_bitdeil+7,63);
    store8(_celt_bitdeil+8,192); store8(_celt_bitdeil+9,195); store8(_celt_bitdeil+10,204); store8(_celt_bitdeil+11,207);
    store8(_celt_bitdeil+12,240); store8(_celt_bitdeil+13,243); store8(_celt_bitdeil+14,252); store8(_celt_bitdeil+15,255);
    F64_SQRT1_2 = f64_div(f64_from(70710678), f64_from(100000000));
    return 0;
}

fn celt_lcg_rand(seed) {
    return (1664525 * seed + 1013904223) & 0xFFFFFFFF;
}

# sign-extend low 16 bits to signed
fn _i16(x) { return ((x & 0xFFFF) ^ 0x8000) - 0x8000; }

fn frac_mul16(a, b) {
    return sar(16384 + _i16(a) * _i16(b), 15);
}

fn bitexact_cos(x) {
    var tmp = (4096 + x * x) >> 13;
    var x2 = _i16(tmp);
    var inner = 8277 + frac_mul16(0 - 626, x2);
    inner = (0 - 7651) + frac_mul16(x2, inner);
    x2 = (32767 - x2) + frac_mul16(x2, inner);
    return 1 + x2;
}

fn bitexact_log2tan(isin, icos) {
    var lc = ec_ilog(icos);
    var ls = ec_ilog(isin);
    icos = icos << (15 - lc);
    isin = isin << (15 - ls);
    return (ls - lc) * 2048
         + frac_mul16(isin, frac_mul16(isin, 0 - 2597) + 7932)
         - frac_mul16(icos, frac_mul16(icos, 0 - 2597) + 7932);
}

# isqrt32: floor(sqrt(v)) for v>=0 (exact).
fn isqrt32(v) {
    if (v <= 0) { return 0; }
    var r = 0;
    var b = 1;
    while (b * 4 <= v) { b = b * 4; }
    var x = v;
    while (b != 0) {
        if (x >= r + b) {
            x = x - (r + b);
            r = (r >> 1) + b;
        } else {
            r = r >> 1;
        }
        b = b >> 2;
    }
    return r;
}

fn compute_qn(N, b, offset, pulse_cap, stereo) {
    var N2 = 2 * N - 1;
    if ((stereo != 0) & (N == 2)) { N2 = N2 - 1; }
    # celt_sudiv(b + N2*offset, N2) — signed truncating division
    var num = b + N2 * offset;
    var qb = 0;
    if (num >= 0) { qb = num / N2; } else { qb = 0 - ((0 - num) / N2); }
    var lim = b - pulse_cap - 32;
    if (lim < qb) { qb = lim; }
    if (64 < qb) { qb = 64; }
    var qn = 1;
    if (qb >= 4) {
        qn = load64(_celt_exp2_8 + (qb & 7) * 8) >> (14 - (qb >> 3));
        qn = ((qn + 1) >> 1) << 1;
    }
    return qn;
}

# 2^x for f64 x
fn _celt_exp2(x) { return f64_pow(F64_TWO, x); }

# normalise_residual: X[i] = iy[i] * gain / sqrt(Ryy)   (float path)
fn normalise_residual(iy, X, N, ryy, gain) {
    var g = f64_div(gain, f64_sqrt(f64_from(ryy)));
    var i = 0;
    while (i < N) {
        store64(X + i * 8, f64_mul(f64_from(load64(iy + i * 8)), g));
        i = i + 1;
    }
    return 0;
}

fn exp_rotation1(X, len, stride, c, s) {
    var ms = f64_neg(s);
    var i = 0;
    var lim = len - stride;
    while (i < lim) {
        var x1 = load64(X + i * 8);
        var x2 = load64(X + (i + stride) * 8);
        store64(X + (i + stride) * 8, f64_add(f64_mul(c, x2), f64_mul(s, x1)));
        store64(X + i * 8, f64_add(f64_mul(c, x1), f64_mul(ms, x2)));
        i = i + 1;
    }
    i = len - 2 * stride - 1;
    while (i >= 0) {
        var x1b = load64(X + i * 8);
        var x2b = load64(X + (i + stride) * 8);
        store64(X + (i + stride) * 8, f64_add(f64_mul(c, x2b), f64_mul(s, x1b)));
        store64(X + i * 8, f64_add(f64_mul(c, x1b), f64_mul(ms, x2b)));
        i = i - 1;
    }
    return 0;
}

# exp_rotation for decode (dir<0).
fn exp_rotation(X, len, stride, K, spread) {
    if ((2 * K >= len) | (spread == 0)) { return 0; }
    var factor = load64(_celt_spreadF + (spread - 1) * 8);
    var gain = f64_div(f64_from(len), f64_from(len + factor * K));
    var theta = f64_mul(F64_HALF, f64_mul(gain, gain));
    var halfpi = f64_mul(F64_HALF, F64_PI);
    var c = f64_cos(f64_mul(halfpi, theta));
    var s = f64_cos(f64_mul(halfpi, f64_sub(F64_ONE, theta)));
    var stride2 = 0;
    if (len >= 8 * stride) {
        stride2 = 1;
        while ((stride2 * stride2 + stride2) * stride + (stride >> 2) < len) { stride2 = stride2 + 1; }
    }
    var blocklen = len / stride;
    var b = 0;
    while (b < stride) {
        var Xb = X + b * blocklen * 8;
        if (stride2 != 0) { exp_rotation1(Xb, blocklen, stride2, s, c); }
        exp_rotation1(Xb, blocklen, 1, c, s);
        b = b + 1;
    }
    return 0;
}

fn renormalise_vector(X, N, gain) {
    var E = f64_div(f64_from(1), f64_from(1000000000000000));   # EPSILON 1e-15
    var i = 0;
    while (i < N) {
        var x = load64(X + i * 8);
        E = f64_add(E, f64_mul(x, x));
        i = i + 1;
    }
    var g = f64_div(gain, f64_sqrt(E));
    i = 0;
    while (i < N) { store64(X + i * 8, f64_mul(g, load64(X + i * 8))); i = i + 1; }
    return 0;
}

fn extract_collapse_mask(iy, N, B) {
    if (B <= 1) { return 1; }
    var N0 = N / B;
    var mask = 0;
    var i = 0;
    while (i < B) {
        var tmp = 0;
        var j = 0;
        while (j < N0) { tmp = tmp | load64(iy + (i * N0 + j) * 8); j = j + 1; }
        if (tmp != 0) { mask = mask | (1 << i); }
        i = i + 1;
    }
    return mask;
}

# alg_unquant (decode): decode_pulses -> normalise -> rotation -> collapse mask.
fn alg_unquant(ec, X, N, K, spread, B, gain) {
    var iy = alloc(N * 8);
    var ryy = celt_decode_pulses(ec, N, K, iy);
    normalise_residual(iy, X, N, ryy, gain);
    exp_rotation(X, N, B, K, spread);
    return extract_collapse_mask(iy, N, B);
}

fn haar1(X, N0, stride) {
    var n0 = N0 >> 1;
    var i = 0;
    while (i < stride) {
        var j = 0;
        while (j < n0) {
            var a = load64(X + (stride * 2 * j + i) * 8);
            var bb = load64(X + (stride * (2 * j + 1) + i) * 8);
            var t1 = f64_mul(F64_SQRT1_2, a);
            var t2 = f64_mul(F64_SQRT1_2, bb);
            store64(X + (stride * 2 * j + i) * 8, f64_add(t1, t2));
            store64(X + (stride * (2 * j + 1) + i) * 8, f64_sub(t1, t2));
            j = j + 1;
        }
        i = i + 1;
    }
    return 0;
}

fn deinterleave_hadamard(X, N0, stride, hadamard) {
    var N = N0 * stride;
    var tmp = alloc(N * 8);
    if (hadamard != 0) {
        var ordery = _celt_ordery + (stride - 2) * 8;
        var i = 0;
        while (i < stride) {
            var oi = load64(ordery + i * 8);
            var j = 0;
            while (j < N0) {
                store64(tmp + (oi * N0 + j) * 8, load64(X + (j * stride + i) * 8));
                j = j + 1;
            }
            i = i + 1;
        }
    } else {
        var i2 = 0;
        while (i2 < stride) {
            var j2 = 0;
            while (j2 < N0) {
                store64(tmp + (i2 * N0 + j2) * 8, load64(X + (j2 * stride + i2) * 8));
                j2 = j2 + 1;
            }
            i2 = i2 + 1;
        }
    }
    var c = 0;
    while (c < N) { store64(X + c * 8, load64(tmp + c * 8)); c = c + 1; }
    return 0;
}

fn interleave_hadamard(X, N0, stride, hadamard) {
    var N = N0 * stride;
    var tmp = alloc(N * 8);
    if (hadamard != 0) {
        var ordery = _celt_ordery + (stride - 2) * 8;
        var i = 0;
        while (i < stride) {
            var oi = load64(ordery + i * 8);
            var j = 0;
            while (j < N0) {
                store64(tmp + (j * stride + i) * 8, load64(X + (oi * N0 + j) * 8));
                j = j + 1;
            }
            i = i + 1;
        }
    } else {
        var i2 = 0;
        while (i2 < stride) {
            var j2 = 0;
            while (j2 < N0) {
                store64(tmp + (j2 * stride + i2) * 8, load64(X + (i2 * N0 + j2) * 8));
                j2 = j2 + 1;
            }
            i2 = i2 + 1;
        }
    }
    var c = 0;
    while (c < N) { store64(X + c * 8, load64(tmp + c * 8)); c = c + 1; }
    return 0;
}

# stereo_merge (bands.c:418) — reconstruct L/R from mid(X)/side(Y).
fn stereo_merge(X, Y, mid, N) {
    var xp = F64_ZERO;
    var sside = F64_ZERO;
    var j = 0;
    while (j < N) {
        xp = f64_add(xp, f64_mul(load64(Y + j * 8), load64(X + j * 8)));
        sside = f64_add(sside, f64_mul(load64(Y + j * 8), load64(Y + j * 8)));
        j = j + 1;
    }
    xp = f64_mul(xp, mid);
    var mid2 = f64_mul(mid, mid);
    var El = f64_sub(f64_add(mid2, sside), f64_mul(F64_TWO, xp));
    var Er = f64_add(f64_add(mid2, sside), f64_mul(F64_TWO, xp));
    var thr = f64_div(f64_from(6), f64_from(10000));
    if ((f64_lt(Er, thr) == 1) | (f64_lt(El, thr) == 1)) {
        j = 0;
        while (j < N) { store64(Y + j * 8, load64(X + j * 8)); j = j + 1; }
        return 0;
    }
    var lgain = f64_div(F64_ONE, f64_sqrt(El));
    var rgain = f64_div(F64_ONE, f64_sqrt(Er));
    j = 0;
    while (j < N) {
        var l = f64_mul(mid, load64(X + j * 8));
        var r = load64(Y + j * 8);
        store64(X + j * 8, f64_mul(lgain, f64_sub(l, r)));
        store64(Y + j * 8, f64_mul(rgain, f64_add(l, r)));
        j = j + 1;
    }
    return 0;
}

# compute_theta (bands.c:700) — decode angle, fill sctx[0..7]:
#  imid,iside,delta,itheta,qalloc,inv,new_b,new_fill
fn compute_theta(ctx, N, b, B, B0, LM, stereo, fill, sctx) {
    var ec = load64(ctx + 0);
    var ii = load64(ctx + 24);
    var intensity = load64(ctx + 48);
    var pulse_cap = load64(_celt_logN + ii * 8) + LM * 8;
    var qoff = 4;
    if ((stereo != 0) & (N == 2)) { qoff = 16; }
    var offset = (pulse_cap >> 1) - qoff;
    var qn = compute_qn(N, b, offset, pulse_cap, stereo);
    if ((stereo != 0) & (ii >= intensity)) { qn = 1; }
    var tell = ec_tell_frac(ec);
    var itheta = 0;
    var inv = 0;
    if (qn != 1) {
        if ((stereo != 0) & (N > 2)) {
            var p0 = 3;
            var x0 = qn / 2;
            var ft = p0 * (x0 + 1) + x0;
            var fs = ec_decode(ec, ft);
            var x = 0;
            if (fs < (x0 + 1) * p0) { x = fs / p0; } else { x = x0 + 1 + (fs - (x0 + 1) * p0); }
            var fl = 0;
            var fh = 0;
            if (x <= x0) { fl = p0 * x; fh = p0 * (x + 1); }
            else { fl = (x - 1 - x0) + (x0 + 1) * p0; fh = (x - x0) + (x0 + 1) * p0; }
            ec_dec_update(ec, fl, fh, ft);
            itheta = x;
        } else {
            if ((B0 > 1) | (stereo != 0)) {
                itheta = ec_dec_uint(ec, qn + 1);
            } else {
                var ft2 = ((qn >> 1) + 1) * ((qn >> 1) + 1);
                var fm = ec_decode(ec, ft2);
                var fl2 = 0;
                var fs2 = 0;
                var thr = ((qn >> 1) * ((qn >> 1) + 1)) >> 1;
                if (fm < thr) {
                    itheta = (isqrt32(8 * fm + 1) - 1) >> 1;
                    fs2 = itheta + 1;
                    fl2 = (itheta * (itheta + 1)) >> 1;
                } else {
                    itheta = (2 * (qn + 1) - isqrt32(8 * (ft2 - fm - 1) + 1)) >> 1;
                    fs2 = qn + 1 - itheta;
                    fl2 = ft2 - (((qn + 1 - itheta) * (qn + 2 - itheta)) >> 1);
                }
                ec_dec_update(ec, fl2, fl2 + fs2, ft2);
            }
        }
        itheta = (itheta * 16384) / qn;
    } else {
        if (stereo != 0) {
            if ((b > 16) & (load64(ctx + 16) > 16)) { inv = ec_dec_bit_logp(ec, 2); } else { inv = 0; }
            if (load64(ctx + 56) != 0) { inv = 0; }
            itheta = 0;
        }
    }
    var qalloc = ec_tell_frac(ec) - tell;
    b = b - qalloc;
    var imid = 0;
    var iside = 0;
    var delta = 0;
    if (itheta == 0) {
        imid = 32767; iside = 0;
        fill = fill & ((1 << B) - 1);
        delta = 0 - 16384;
    } else {
        if (itheta == 16384) {
            imid = 0; iside = 32767;
            fill = fill & (((1 << B) - 1) << B);
            delta = 16384;
        } else {
            imid = bitexact_cos(itheta);
            iside = bitexact_cos(16384 - itheta);
            delta = frac_mul16((N - 1) << 7, bitexact_log2tan(iside, imid));
        }
    }
    store64(sctx + 0, imid);
    store64(sctx + 8, iside);
    store64(sctx + 16, delta);
    store64(sctx + 24, itheta);
    store64(sctx + 32, qalloc);
    store64(sctx + 40, inv);
    store64(sctx + 48, b);
    store64(sctx + 56, fill);
    return 0;
}

fn quant_band_n1(ctx, X, Y, lowband_out) {
    var ec = load64(ctx + 0);
    var stereo = 0;
    if (Y != 0) { stereo = 1; }
    var x = X;
    var c = 0;
    while (c < 1 + stereo) {
        var sign = 0;
        if (load64(ctx + 16) >= 8) {
            sign = ec_dec_bits(ec, 1);
            store64(ctx + 16, load64(ctx + 16) - 8);
        }
        if (sign != 0) { store64(x + 0, f64_neg(F64_ONE)); } else { store64(x + 0, F64_ONE); }
        x = Y;
        c = c + 1;
    }
    if (lowband_out != 0) { store64(lowband_out + 0, load64(X + 0)); }
    return 1;
}

fn quant_partition(ctx, X, N, b, B, lowband, LM, gain, fill) {
    var ec = load64(ctx + 0);
    var ii = load64(ctx + 24);
    var spread = load64(ctx + 32);
    var B0 = B;
    var cm = 0;
    var cache = _celt_cacheBits + load64(_celt_cacheIdx + ((LM + 1) * 21 + ii) * 8);
    var cache0 = load8(cache);
    if ((LM != (0 - 1)) & (b > load8(cache + cache0) + 12) & (N > 2)) {
        var Nh = N >> 1;
        var Y = X + Nh * 8;
        var LMn = LM - 1;
        if (B == 1) { fill = (fill & 1) | (fill << 1); }
        var Bn = (B + 1) >> 1;
        var sctx = alloc(64);
        compute_theta(ctx, Nh, b, Bn, B0, LMn, 0, fill, sctx);
        var imid = load64(sctx + 0);
        var iside = load64(sctx + 8);
        var delta = load64(sctx + 16);
        var itheta = load64(sctx + 24);
        b = load64(sctx + 48);
        fill = load64(sctx + 56);
        var mid = f64_div(f64_from(imid), f64_from(32768));
        var side = f64_div(f64_from(iside), f64_from(32768));
        if ((B0 > 1) & ((itheta & 0x3fff) != 0)) {
            if (itheta > 8192) { delta = delta - sar(delta, 4 - LMn); }
            else {
                var dd = delta + ((Nh << 3) >> (5 - LMn));
                if (dd > 0) { dd = 0; }
                delta = dd;
            }
        }
        var mbits = (b - delta) / 2;
        if (mbits > b) { mbits = b; }
        if (mbits < 0) { mbits = 0; }
        var sbits = b - mbits;
        store64(ctx + 16, load64(ctx + 16) - load64(sctx + 32));
        var next_lb = 0;
        if (lowband != 0) { next_lb = lowband + Nh * 8; }
        var rebalance = load64(ctx + 16);
        if (mbits >= sbits) {
            cm = quant_partition(ctx, X, Nh, mbits, Bn, lowband, LMn, f64_mul(gain, mid), fill);
            rebalance = mbits - (rebalance - load64(ctx + 16));
            if ((rebalance > 24) & (itheta != 0)) { sbits = sbits + rebalance - 24; }
            cm = cm | (quant_partition(ctx, Y, Nh, sbits, Bn, next_lb, LMn, f64_mul(gain, side), fill >> Bn) << (B0 >> 1));
        } else {
            cm = quant_partition(ctx, Y, Nh, sbits, Bn, next_lb, LMn, f64_mul(gain, side), fill >> Bn) << (B0 >> 1);
            rebalance = sbits - (rebalance - load64(ctx + 16));
            if ((rebalance > 24) & (itheta != 16384)) { mbits = mbits + rebalance - 24; }
            cm = cm | quant_partition(ctx, X, Nh, mbits, Bn, lowband, LMn, f64_mul(gain, mid), fill);
        }
    } else {
        var q = celt_bits2pulses(ii, LM, b);
        var curr_bits = celt_pulses2bits(ii, LM, q);
        store64(ctx + 16, load64(ctx + 16) - curr_bits);
        while ((load64(ctx + 16) < 0) & (q > 0)) {
            store64(ctx + 16, load64(ctx + 16) + curr_bits);
            q = q - 1;
            curr_bits = celt_pulses2bits(ii, LM, q);
            store64(ctx + 16, load64(ctx + 16) - curr_bits);
        }
        if (q != 0) {
            var K = celt_get_pulses(q);
            cm = alg_unquant(ec, X, N, K, spread, B, gain);
        } else {
            var cm_mask = (1 << B) - 1;
            fill = fill & cm_mask;
            if (fill == 0) {
                var z = 0;
                while (z < N) { store64(X + z * 8, F64_ZERO); z = z + 1; }
                cm = 0;
            } else {
                if (lowband == 0) {
                    var j = 0;
                    while (j < N) {
                        var seed = celt_lcg_rand(load64(ctx + 8));
                        store64(ctx + 8, seed);
                        var sv = seed;
                        if (sv >= 2147483648) { sv = sv - 4294967296; }
                        store64(X + j * 8, f64_from(sar(sv, 20)));
                        j = j + 1;
                    }
                    cm = cm_mask;
                    renormalise_vector(X, N, gain);
                } else {
                    var tmpv = f64_div(F64_ONE, f64_from(256));
                    var j2 = 0;
                    while (j2 < N) {
                        var seed2 = celt_lcg_rand(load64(ctx + 8));
                        store64(ctx + 8, seed2);
                        var t = tmpv;
                        if ((seed2 & 0x8000) == 0) { t = f64_neg(tmpv); }
                        store64(X + j2 * 8, f64_add(load64(lowband + j2 * 8), t));
                        j2 = j2 + 1;
                    }
                    cm = fill;
                    renormalise_vector(X, N, gain);
                }
            }
        }
    }
    return cm;
}

fn quant_band(ctx, X, N, b, B, lowband, LM, lowband_out, gain, lowband_scratch, fill) {
    var tf_change = load64(ctx + 40);
    var N0 = N;
    var N_B = N;
    var B0 = B;
    var time_divide = 0;
    var recombine = 0;
    var longBlocks = 0;
    if (B0 == 1) { longBlocks = 1; }
    N_B = N_B / B;
    if (N == 1) { return quant_band_n1(ctx, X, 0, lowband_out); }
    if (tf_change > 0) { recombine = tf_change; }
    if ((lowband_scratch != 0) & (lowband != 0) & ((recombine != 0) | ((((N_B & 1) == 0) & (tf_change < 0)) != 0) | (B0 > 1))) {
        var cpi = 0;
        while (cpi < N) { store64(lowband_scratch + cpi * 8, load64(lowband + cpi * 8)); cpi = cpi + 1; }
        lowband = lowband_scratch;
    }
    var k = 0;
    while (k < recombine) {
        if (lowband != 0) { haar1(lowband, N >> k, 1 << k); }
        fill = load8(_celt_bitil + (fill & 0xF)) | (load8(_celt_bitil + (fill >> 4)) << 2);
        k = k + 1;
    }
    B = B >> recombine;
    N_B = N_B << recombine;
    while (((N_B & 1) == 0) & (tf_change < 0)) {
        if (lowband != 0) { haar1(lowband, N_B, B); }
        fill = fill | (fill << B);
        B = B << 1;
        N_B = N_B >> 1;
        time_divide = time_divide + 1;
        tf_change = tf_change + 1;
    }
    B0 = B;
    var N_B0 = N_B;
    if (B0 > 1) {
        if (lowband != 0) { deinterleave_hadamard(lowband, N_B >> recombine, B0 << recombine, longBlocks); }
    }
    var cm = quant_partition(ctx, X, N, b, B, lowband, LM, gain, fill);
    if (B0 > 1) { interleave_hadamard(X, N_B >> recombine, B0 << recombine, longBlocks); }
    N_B = N_B0;
    B = B0;
    k = 0;
    while (k < time_divide) {
        B = B >> 1;
        N_B = N_B << 1;
        cm = cm | (cm >> B);
        haar1(X, N_B, B);
        k = k + 1;
    }
    k = 0;
    while (k < recombine) {
        cm = load8(_celt_bitdeil + cm);
        haar1(X, N0 >> k, 1 << k);
        k = k + 1;
    }
    B = B << recombine;
    if (lowband_out != 0) {
        var nn = f64_sqrt(f64_from(N0));
        var j = 0;
        while (j < N0) { store64(lowband_out + j * 8, f64_mul(nn, load64(X + j * 8))); j = j + 1; }
    }
    cm = cm & ((1 << B) - 1);
    return cm;
}

fn quant_band_stereo(ctx, X, Y, N, b, B, lowband, LM, lowband_out, lowband_scratch, fill) {
    var ec = load64(ctx + 0);
    if (N == 1) { return quant_band_n1(ctx, X, Y, lowband_out); }
    var orig_fill = fill;
    var sctx = alloc(64);
    compute_theta(ctx, N, b, B, B, LM, 1, fill, sctx);
    var inv = load64(sctx + 40);
    var imid = load64(sctx + 0);
    var iside = load64(sctx + 8);
    var delta = load64(sctx + 16);
    var itheta = load64(sctx + 24);
    b = load64(sctx + 48);
    fill = load64(sctx + 56);
    var mid = f64_div(f64_from(imid), f64_from(32768));
    var side = f64_div(f64_from(iside), f64_from(32768));
    var cm = 0;
    if (N == 2) {
        var mbits = b;
        var sbits = 0;
        if ((itheta != 0) & (itheta != 16384)) { sbits = 8; }
        mbits = mbits - sbits;
        var cc = 0;
        if (itheta > 8192) { cc = 1; }
        store64(ctx + 16, load64(ctx + 16) - (load64(sctx + 32) + sbits));
        var x2 = X;
        var y2 = Y;
        if (cc != 0) { x2 = Y; y2 = X; }
        var sign = 0;
        if (sbits != 0) { sign = ec_dec_bits(ec, 1); }
        sign = 1 - 2 * sign;
        cm = quant_band(ctx, x2, N, mbits, B, lowband, LM, lowband_out, F64_ONE, lowband_scratch, orig_fill);
        store64(y2 + 0, f64_mul(f64_from(0 - sign), load64(x2 + 8)));
        store64(y2 + 8, f64_mul(f64_from(sign), load64(x2 + 0)));
        store64(X + 0, f64_mul(mid, load64(X + 0)));
        store64(X + 8, f64_mul(mid, load64(X + 8)));
        store64(Y + 0, f64_mul(side, load64(Y + 0)));
        store64(Y + 8, f64_mul(side, load64(Y + 8)));
        var t0 = load64(X + 0);
        store64(X + 0, f64_sub(t0, load64(Y + 0)));
        store64(Y + 0, f64_add(t0, load64(Y + 0)));
        var t1 = load64(X + 8);
        store64(X + 8, f64_sub(t1, load64(Y + 8)));
        store64(Y + 8, f64_add(t1, load64(Y + 8)));
    } else {
        var mbits = (b - delta) / 2;
        if (mbits > b) { mbits = b; }
        if (mbits < 0) { mbits = 0; }
        var sbits = b - mbits;
        store64(ctx + 16, load64(ctx + 16) - load64(sctx + 32));
        var rebalance = load64(ctx + 16);
        if (mbits >= sbits) {
            cm = quant_band(ctx, X, N, mbits, B, lowband, LM, lowband_out, F64_ONE, lowband_scratch, fill);
            rebalance = mbits - (rebalance - load64(ctx + 16));
            if ((rebalance > 24) & (itheta != 0)) { sbits = sbits + rebalance - 24; }
            cm = cm | quant_band(ctx, Y, N, sbits, B, 0, LM, 0, side, 0, fill >> B);
        } else {
            cm = quant_band(ctx, Y, N, sbits, B, 0, LM, 0, side, 0, fill >> B);
            rebalance = sbits - (rebalance - load64(ctx + 16));
            if ((rebalance > 24) & (itheta != 16384)) { mbits = mbits + rebalance - 24; }
            cm = cm | quant_band(ctx, X, N, mbits, B, lowband, LM, lowband_out, F64_ONE, lowband_scratch, fill);
        }
        stereo_merge(X, Y, mid, N);
        if (inv != 0) {
            var j = 0;
            while (j < N) { store64(Y + j * 8, f64_neg(load64(Y + j * 8))); j = j + 1; }
        }
    }
    return cm;
}

# quant_all_bands driver (decode). X_/Y_ byte pointers; collapse_masks byte array.
fn quant_all_bands(X_, Y_, collapse_masks, pulses, shortBlocks, spread, dual_stereo, intensity, tf_res, total_bits, balance, ec, LM, codedBands, seed_ptr, disable_inv, C) {
    if (_celt_eMeans == 0) { _celt_bands_tables_init(); }
    var M = 1 << LM;
    var Bf = 1;
    if (shortBlocks != 0) { Bf = M; }
    var normsz = M * load64(_celt_eBands + 20 * 8);
    var norm = alloc(C * normsz * 8);
    var norm2 = norm + normsz * 8;
    var lowband_scratch_base = X_ + M * load64(_celt_eBands + 20 * 8) * 8;
    var ctx = alloc(72);
    store64(ctx + 0, ec);
    store64(ctx + 8, load64(seed_ptr));
    store64(ctx + 32, spread);
    store64(ctx + 48, intensity);
    store64(ctx + 56, disable_inv);
    var avoid = 0;
    if (Bf > 1) { avoid = 1; }
    store64(ctx + 64, avoid);
    var lowband_offset = 0;
    var update_lowband = 1;
    var i = 0;
    while (i < 21) {
        store64(ctx + 24, i);
        var last = 0;
        if (i == 20) { last = 1; }
        var Mei = M * load64(_celt_eBands + i * 8);
        var X = X_ + Mei * 8;
        var Y = 0;
        if (Y_ != 0) { Y = Y_ + Mei * 8; }
        var N = M * load64(_celt_eBands + (i + 1) * 8) - Mei;
        var tell = ec_tell_frac(ec);
        if (i != 0) { balance = balance - tell; }
        var remaining_bits = total_bits - tell - 1;
        store64(ctx + 16, remaining_bits);
        var b = 0;
        if (i <= codedBands - 1) {
            var mn = codedBands - i;
            if (mn > 3) { mn = 3; }
            var curr_balance = balance / mn;
            if (balance < 0) { curr_balance = 0 - ((0 - balance) / mn); }
            b = load64(pulses + i * 8) + curr_balance;
            if (remaining_bits + 1 < b) { b = remaining_bits + 1; }
            if (16383 < b) { b = 16383; }
            if (b < 0) { b = 0; }
        }
        if ((Mei - N >= 0) | (i == 1)) {
            if ((update_lowband != 0) | (lowband_offset == 0)) { lowband_offset = i; }
        }
        var tf_change = load64(tf_res + i * 8);
        store64(ctx + 40, tf_change);
        var lbscr = lowband_scratch_base;
        if (last != 0) { lbscr = 0; }
        var effective_lowband = 0 - 1;
        var x_cm = 0;
        var y_cm = 0;
        if ((lowband_offset != 0) & ((spread != 3) | (Bf > 1) | (tf_change < 0))) {
            effective_lowband = M * load64(_celt_eBands + lowband_offset * 8) - N;
            if (effective_lowband < 0) { effective_lowband = 0; }
            var fold_start = lowband_offset;
            var cs = 1;
            while (cs == 1) {
                fold_start = fold_start - 1;
                if (M * load64(_celt_eBands + fold_start * 8) > effective_lowband) { cs = 1; } else { cs = 0; }
            }
            var fold_end = lowband_offset - 1;
            var ce = 1;
            while (ce == 1) {
                fold_end = fold_end + 1;
                if ((fold_end < i) & (M * load64(_celt_eBands + fold_end * 8) < effective_lowband + N)) { ce = 1; } else { ce = 0; }
            }
            var fi = fold_start;
            var cf = 1;
            while (cf == 1) {
                x_cm = x_cm | load8(collapse_masks + (fi * C + 0));
                y_cm = y_cm | load8(collapse_masks + (fi * C + C - 1));
                fi = fi + 1;
                if (fi < fold_end) { cf = 1; } else { cf = 0; }
            }
        } else {
            x_cm = (1 << Bf) - 1;
            y_cm = (1 << Bf) - 1;
        }
        if ((dual_stereo != 0) & (i == intensity)) {
            dual_stereo = 0;
            var jj = 0;
            while (jj < Mei) {
                store64(norm + jj * 8, f64_mul(F64_HALF, f64_add(load64(norm + jj * 8), load64(norm2 + jj * 8))));
                jj = jj + 1;
            }
        }
        var lb = 0;
        if (effective_lowband != (0 - 1)) { lb = norm + effective_lowband * 8; }
        var out = 0;
        if (last == 0) { out = norm + Mei * 8; }
        if (dual_stereo != 0) {
            var lbx = 0;
            var lby = 0;
            if (effective_lowband != (0 - 1)) { lbx = norm + effective_lowband * 8; lby = norm2 + effective_lowband * 8; }
            var outx = 0;
            var outy = 0;
            if (last == 0) { outx = norm + Mei * 8; outy = norm2 + Mei * 8; }
            x_cm = quant_band(ctx, X, N, b / 2, Bf, lbx, LM, outx, F64_ONE, lbscr, x_cm);
            y_cm = quant_band(ctx, Y, N, b / 2, Bf, lby, LM, outy, F64_ONE, lbscr, y_cm);
        } else {
            if (Y != 0) {
                x_cm = quant_band_stereo(ctx, X, Y, N, b, Bf, lb, LM, out, lbscr, x_cm | y_cm);
                y_cm = x_cm;
            } else {
                x_cm = quant_band(ctx, X, N, b, Bf, lb, LM, out, F64_ONE, lbscr, x_cm | y_cm);
                y_cm = x_cm;
            }
        }
        store8(collapse_masks + (i * C + 0), x_cm & 0xFF);
        store8(collapse_masks + (i * C + C - 1), y_cm & 0xFF);
        balance = balance + load64(pulses + i * 8) + tell;
        update_lowband = 0;
        if (b > (N << 3)) { update_lowband = 1; }
        store64(ctx + 64, 0);
        i = i + 1;
    }
    store64(seed_ptr, load64(ctx + 8));
    return 0;
}

# denormalise_bands (bands.c:188): freq[j] = X[j]*2^(bandLogE[i]+eMeans[i]).
fn denormalise_bands(X, freq, bandLogE, silence) {
    var M = 8;
    var N = 960;
    var bound = M * load64(_celt_eBands + 21 * 8);
    if (silence != 0) { bound = 0; }
    if (silence == 0) {
        var i = 0;
        while (i < 21) {
            var j = M * load64(_celt_eBands + i * 8);
            var band_end = M * load64(_celt_eBands + (i + 1) * 8);
            var lg = f64_add(load64(bandLogE + i * 8), load64(_celt_eMeans + i * 8));
            if (f64_gt(lg, f64_from(32)) == 1) { lg = f64_from(32); }
            var g = _celt_exp2(lg);
            while (j < band_end) {
                store64(freq + j * 8, f64_mul(load64(X + j * 8), g));
                j = j + 1;
            }
            i = i + 1;
        }
    }
    var z = bound;
    while (z < N) { store64(freq + z * 8, F64_ZERO); z = z + 1; }
    return 0;
}

fn _celt_assert_bytes(got, exp, n, msg) {
    var i = 0; var ok = 1;
    while (i < n) { if (load8(got + i) != load8(exp + i)) { ok = 0; } i = i + 1; }
    assert(ok == 1, msg); return 0;
}

fn _celt_run_qab(payload, plen, C, oldBandE, seed_in, exp_rng, exp_tell, exp_cm, tag) {
    var tf = alloc(21 * 8); var off = alloc(21 * 8); var pul = alloc(21 * 8);
    var fq = alloc(21 * 8); var fp = alloc(21 * 8); var cap = alloc(21 * 8); var scal = alloc(16 * 8);
    var ec = celt_decode_frame_prefix(payload, plen, C, oldBandE, tf, off, pul, fq, fp, cap, scal);
    var N = 960; var M = 8;
    var X = alloc(C * N * 8); var z = 0; while (z < C * N) { store64(X + z * 8, F64_ZERO); z = z + 1; }
    var Y = 0; if (C == 2) { Y = X + N * 8; }
    var cm = alloc(C * 21);
    var shortBlocks = 0; if (load64(scal + 8) != 0) { shortBlocks = M; }
    var total_bits = plen * 64 - load64(scal + 40);
    var seedp = alloc(8); store64(seedp, seed_in);
    var di = 0;
    quant_all_bands(X, Y, cm, pul, shortBlocks, load64(scal + 24), load64(scal + 64), load64(scal + 56), tf, total_bits, load64(scal + 72), ec, 3, load64(scal + 48), seedp, di, C);
    assert_eq(load64(ec + 56), exp_rng, tag);
    assert_eq(ec_tell(ec), exp_tell, tag);
    _celt_assert_bytes(cm, exp_cm, C * 21, tag);
    return 0;
}

