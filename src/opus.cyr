    syscall(1, 2, "imdct_corr_x10000=", 18); fmt_int_fd(2, f64_to(f64_mul(cc, f64_from(10000)))); syscall(1, 2, "\n", 1);
    syscall(1, 2, "imdct_out[60..64]:", 18);
    fmt_int_fd(2, f64_to(f64_mul(load64(out + 60 * 8), f64_from(10000000)))); syscall(1, 2, " ", 1);
    fmt_int_fd(2, f64_to(f64_mul(load64(out + 61 * 8), f64_from(10000000)))); syscall(1, 2, " ", 1);
    fmt_int_fd(2, f64_to(f64_mul(load64(out + 62 * 8), f64_from(10000000)))); syscall(1, 2, " ", 1);
    fmt_int_fd(2, f64_to(f64_mul(load64(out + 63 * 8), f64_from(10000000)))); syscall(1, 2, " ", 1);
    fmt_int_fd(2, f64_to(f64_mul(load64(out + 64 * 8), f64_from(10000000)))); syscall(1, 2, " ", 1);
    syscall(1, 2, "\n", 1);
    assert(f64_gt(cc, f64_div(f64_from(9999), f64_from(10000))) == 1, "IMDCT matches libopus");
    return 0;
}



