    store8(c0_b + 42, 0); store8(c0_b + 43, 0); store8(c0_b + 44, 0); store8(c0_b + 45, 0); store8(c0_b + 46, 0); store8(c0_b + 47, 0); store8(c0_b + 48, 0); store8(c0_b + 49, 0); store8(c0_b + 50, 0); store8(c0_b + 51, 0); store8(c0_b + 52, 0); store8(c0_b + 53, 0); store8(c0_b + 54, 0); store8(c0_b + 55, 0);
