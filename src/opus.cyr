# ================================================================
# opus.cyr -- Opus header parsing and CELT-mode encoding (Ogg container)
# ================================================================
#
# Provides:
#   opus_parse_head(data, len)             -- parse OpusHead packet
#   opus_serialize_head(channels, pre_skip, sample_rate, out_buf) -- serialize OpusHead
#   opus_serialize_tags(out_buf)           -- serialize minimal OpusTags
#   opus_range_enc_init()                  -- create range encoder state
#   opus_range_enc_encode(rc, fl, fh, total) -- encode symbol
#   opus_range_enc_flush(rc)               -- finalize, returns (ptr, len) via Str
#   opus_encode(samples_vec, sample_rate, channels, bitrate, out_buf)
#   opus_decode_from_packets(packets_vec, ogg_data, ogg_len)
#
# Requires: alloc, vec, str, math, ogg, fft, assert

# ================================================================
# OpusHead struct (heap-allocated)
# ================================================================
# Layout (56 bytes):
#   +0:  version              (i64)
#   +8:  channel_count        (i64)
#   +16: pre_skip             (i64)
#   +24: input_sample_rate    (i64)
#   +32: output_gain          (i64, signed)
#   +40: channel_mapping_family (i64)

fn opus_head_new() {
    var h = alloc(48);
    memset(h, 0, 48);
    return h;
}

fn opus_head_version(h)        { return load64(h); }
fn opus_head_channels(h)       { return load64(h + 8); }
fn opus_head_pre_skip(h)       { return load64(h + 16); }
fn opus_head_sample_rate(h)    { return load64(h + 24); }
fn opus_head_output_gain(h)    { return load64(h + 32); }
fn opus_head_mapping(h)        { return load64(h + 40); }

# ================================================================
# OpusHead parsing
# ================================================================

# Parse an OpusHead identification packet.
# data: pointer to raw bytes, len: byte count.
# Returns heap-allocated OpusHead struct, or err().
fn opus_parse_head(data, len) {
    if (len < 19) { return err(ERR_INVALID_HEADER); }

    # Check "OpusHead" magic (8 bytes)
    if (load8(data)     != 0x4F) { return err(ERR_INVALID_HEADER); }  # 'O'
    if (load8(data + 1) != 0x70) { return err(ERR_INVALID_HEADER); }  # 'p'
    if (load8(data + 2) != 0x75) { return err(ERR_INVALID_HEADER); }  # 'u'
    if (load8(data + 3) != 0x73) { return err(ERR_INVALID_HEADER); }  # 's'
    if (load8(data + 4) != 0x48) { return err(ERR_INVALID_HEADER); }  # 'H'
    if (load8(data + 5) != 0x65) { return err(ERR_INVALID_HEADER); }  # 'e'
    if (load8(data + 6) != 0x61) { return err(ERR_INVALID_HEADER); }  # 'a'
    if (load8(data + 7) != 0x64) { return err(ERR_INVALID_HEADER); }  # 'd'

    var version = load8(data + 8);
    var channel_count = load8(data + 9);
    var pre_skip = read_u16_le(data, 10);
    var input_sample_rate = read_u32_le(data, 12);
    # output_gain is signed i16 LE
    var output_gain_raw = read_u16_le(data, 16);
    var output_gain = output_gain_raw;
    if (output_gain >= 32768) {
        output_gain = output_gain - 65536;
    }
    var channel_mapping_family = load8(data + 18);

    if (channel_count == 0) { return err(ERR_INVALID_CHANNELS); }

    var h = opus_head_new();
    store64(h,      version);
    store64(h + 8,  channel_count);
    store64(h + 16, pre_skip);
    store64(h + 24, input_sample_rate);
    store64(h + 32, output_gain);
    store64(h + 40, channel_mapping_family);
    return h;
}

# ================================================================
# OpusHead serialization (19 bytes)
# ================================================================

# Serialize OpusHead into out_buf (must be >= 19 bytes).
# Returns 19 (bytes written).
fn opus_serialize_head(channels, pre_skip, sample_rate, out_buf) {
    # "OpusHead" magic
    store8(out_buf,     0x4F);
    store8(out_buf + 1, 0x70);
    store8(out_buf + 2, 0x75);
    store8(out_buf + 3, 0x73);
    store8(out_buf + 4, 0x48);
    store8(out_buf + 5, 0x65);
    store8(out_buf + 6, 0x61);
    store8(out_buf + 7, 0x64);

    store8(out_buf + 8, 1);         # version
    store8(out_buf + 9, channels);
    write_u16_le(out_buf, 10, pre_skip);
    write_u32_le(out_buf, 12, sample_rate);
    write_u16_le(out_buf, 16, 0);   # output gain = 0
    store8(out_buf + 18, 0);        # channel mapping family 0

    return 19;
}

# ================================================================
# OpusTags serialization
# ================================================================

# Serialize minimal OpusTags into out_buf (must be >= 23 bytes).
# Returns bytes written.
fn opus_serialize_tags(out_buf) {
    # "OpusTags" magic
    store8(out_buf,     0x4F);
    store8(out_buf + 1, 0x70);
    store8(out_buf + 2, 0x75);
    store8(out_buf + 3, 0x73);
    store8(out_buf + 4, 0x54);
    store8(out_buf + 5, 0x61);
    store8(out_buf + 6, 0x67);
    store8(out_buf + 7, 0x73);

    # Vendor string: "shravan" (7 bytes)
    write_u32_le(out_buf, 8, 7);
    store8(out_buf + 12, 0x73);  # s
    store8(out_buf + 13, 0x68);  # h
    store8(out_buf + 14, 0x72);  # r
    store8(out_buf + 15, 0x61);  # a
    store8(out_buf + 16, 0x76);  # v
    store8(out_buf + 17, 0x61);  # a
    store8(out_buf + 18, 0x6E);  # n

    # User comment list length = 0
    write_u32_le(out_buf, 19, 0);

    return 23;
}

# ================================================================
# OpusTags parsing
# ================================================================

fn opus_parse_tags(data, len) {
    if (len < 8) { return err(ERR_INVALID_HEADER); }
    if (load8(data)     != 0x4F) { return err(ERR_INVALID_HEADER); }
    if (load8(data + 1) != 0x70) { return err(ERR_INVALID_HEADER); }
    if (load8(data + 2) != 0x75) { return err(ERR_INVALID_HEADER); }
    if (load8(data + 3) != 0x73) { return err(ERR_INVALID_HEADER); }
    if (load8(data + 4) != 0x54) { return err(ERR_INVALID_HEADER); }
    if (load8(data + 5) != 0x61) { return err(ERR_INVALID_HEADER); }
    if (load8(data + 6) != 0x67) { return err(ERR_INVALID_HEADER); }
    if (load8(data + 7) != 0x73) { return err(ERR_INVALID_HEADER); }
    return tag_read_vorbis(data + 8, len - 8);
}

# ================================================================
# Range coder (byte-oriented, LZMA-style carry) — encoder + decoder
# ================================================================
# A standard, provably-invertible range coder. The encoder emits bytes
# MSB-first with a one-byte cache plus a run counter to propagate carries;
# the decoder consumes the identical stream. RFC 6716's CELT layer uses an
# ec_enc/ec_dec pair with the same algebra; this implementation keeps the
# public opus_range_* names so existing call sites are unchanged.
#
# Encoder state (64 bytes):
#   +0:  buf (output byte pointer)   +8:  buf_len       +16: buf_cap
#   +24: low (up to 2^33, carry in bit 32)              +32: range (<= 2^32-1)
#   +40: cache (pending byte)         +48: cache_size (deferred 0xFF run + 1)
# Decoder state (48 bytes):
#   +0: data   +8: len   +16: pos   +24: range   +32: code

var RC_TOP = 0x1000000;   # 2^24 renormalization threshold (kTopValue)

fn opus_range_enc_init() {
    var rc = alloc(64);
    memset(rc, 0, 64);
    store64(rc,      alloc(4096));   # buf
    store64(rc + 8,  0);             # buf_len
    store64(rc + 16, 4096);          # buf_cap
    store64(rc + 24, 0);             # low
    store64(rc + 32, 0xFFFFFFFF);    # range
    store64(rc + 40, 0);             # cache
    store64(rc + 48, 1);             # cache_size (leading byte pending)
    return rc;
}

fn _rc_push_byte(rc, byte) {
    var buf = load64(rc);
    var blen = load64(rc + 8);
    var bcap = load64(rc + 16);
    if (blen >= bcap) {
        var new_cap = bcap * 2;
        var new_buf = alloc(new_cap);
        memcpy(new_buf, buf, blen);
        store64(rc, new_buf);
        store64(rc + 16, new_cap);
        buf = new_buf;
    }
    store8(buf + blen, byte & 0xFF);
    store64(rc + 8, blen + 1);
    return 0;
}

# LZMA ShiftLow: resolve carry, emit cache + any deferred 0xFF run, shift low.
fn _rc_shift_low(rc) {
    var low = load64(rc + 24);
    var carry = (low >> 32) & 0x1;          # 0 or 1
    if ((carry != 0) | (low < 0xFF000000)) {
        var temp = load64(rc + 40);         # cache
        var cs = load64(rc + 48);           # cache_size (>= 1)
        var i = 0;
        while (i < cs) {
            _rc_push_byte(rc, (temp + carry) & 0xFF);
            temp = 0xFF;
            i = i + 1;
        }
        store64(rc + 48, 0);
        store64(rc + 40, (low >> 24) & 0xFF);   # new cache
    }
    store64(rc + 48, load64(rc + 48) + 1);      # cache_size++
    store64(rc + 24, (low << 8) & 0xFFFFFFFF);
    return 0;
}

# Encode a symbol occupying [fl, fh) out of total.
fn opus_range_enc_encode(rc, fl, fh, total) {
    if (total == 0) { return 0; }
    var range = load64(rc + 32);
    var r = range / total;
    store64(rc + 24, load64(rc + 24) + r * fl);   # low += r*fl (carry into bit 32)
    if (fh < total) {
        store64(rc + 32, r * (fh - fl));
    } else {
        store64(rc + 32, range - r * fl);         # top symbol keeps the remainder
    }
    var rng = load64(rc + 32);
    while (rng < RC_TOP) {
        _rc_shift_low(rc);
        rng = (rng << 8) & 0xFFFFFFFF;
        store64(rc + 32, rng);
    }
    return 0;
}

# Encode a single equiprobable bit.
fn opus_range_enc_bit(rc, val) {
    if (val != 0) {
        opus_range_enc_encode(rc, 1, 2, 2);
    } else {
        opus_range_enc_encode(rc, 0, 1, 2);
    }
    return 0;
}

# Encode a value uniformly in [0, total).
fn opus_range_enc_uint(rc, val, total) {
    if (total <= 1) { return 0; }
    opus_range_enc_encode(rc, val, val + 1, total);
    return 0;
}

# Approximate bytes emitted so far (committed + pending cache run).
fn opus_range_enc_bytes_used(rc) {
    return load64(rc + 8) + load64(rc + 48);
}

# Finalize: flush the 5 low bytes and return Str(data, len).
fn opus_range_enc_flush(rc) {
    var i = 0;
    while (i < 5) {
        _rc_shift_low(rc);
        i = i + 1;
    }
    return str_new(load64(rc), load64(rc + 8));
}

# ---------------- decoder (exact mirror of the encoder) ----------------

fn _rd_next_byte(rd) {
    var pos = load64(rd + 16);
    var b = 0;
    if (pos < load64(rd + 8)) { b = load8(load64(rd) + pos); }
    store64(rd + 16, pos + 1);
    return b;
}

# Initialize from a byte buffer: prime code with 5 bytes (leading cache
# byte shifts out of the 32-bit window, mirroring the encoder's leading byte).
fn opus_range_dec_init(data, len) {
    var rd = alloc(48);
    store64(rd, data);
    store64(rd + 8, len);
    store64(rd + 16, 0);
    store64(rd + 24, 0xFFFFFFFF);
    var code = 0;
    var i = 0;
    while (i < 5) {
        code = ((code << 8) | _rd_next_byte(rd)) & 0xFFFFFFFF;
        i = i + 1;
    }
    store64(rd + 32, code);
    return rd;
}

# Decode a value uniformly in [0, total) — inverse of opus_range_enc_uint.
fn opus_range_dec_uint(rd, total) {
    if (total <= 1) { return 0; }
    var range = load64(rd + 24);
    var code = load64(rd + 32);
    var r = range / total;
    var v = code / r;
    if (v >= total) { v = total - 1; }
    code = code - r * v;
    if (v + 1 < total) {
        range = r;
    } else {
        range = range - r * v;
    }
    while (range < RC_TOP) {
        code = ((code << 8) | _rd_next_byte(rd)) & 0xFFFFFFFF;
        range = (range << 8) & 0xFFFFFFFF;
    }
    store64(rd + 24, range);
    store64(rd + 32, code);
    return v;
}

# Decode a single equiprobable bit.
fn opus_range_dec_bit(rd) {
    return opus_range_dec_uint(rd, 2);
}

# ================================================================
# RFC 6716 range decoder (ec_dec) — exact port of libopus entdec.c/entcode.c
# ================================================================
# THE REAL Opus entropy decoder. The bespoke opus_range_* coder above is the
# legacy, non-interoperable path (kept for the legacy encoder+tests); this ec_dec
# is what decodes an actual libopus/RFC-6716 stream. All uint32 arithmetic is
# emulated in i64 with explicit 0xFFFFFFFF / 0x7FFFFFFF masks.
#
# State layout (96 bytes):
#   +0  buf (byte ptr)   +8  storage (len)   +16 end_offs   +24 end_window (u32)
#   +32 nend_bits        +40 nbits_total     +48 offs       +56 rng (u32)
#   +64 val (u32)        +72 ext (u32)       +80 rem        +88 error
# Constants (mfrngcod.h): SYM_BITS=8, CODE_BITS=32, SYM_MAX=255,
#   CODE_TOP=1<<31, CODE_BOT=1<<23 (0x800000), CODE_EXTRA=7, BITRES=3.

var EC_U32 = 0xFFFFFFFF;
var _ec_corr = 0;   # lazily-built ec_tell_frac correction[8]

# EC_ILOG(v): number of significant bits of v (floor(log2 v)+1); ec_ilog(0)=0.
fn ec_ilog(v) {
    var r = 0;
    var x = v & EC_U32;
    while (x > 0) { r = r + 1; x = x >> 1; }
    return r;
}

fn ec_read_byte(ec) {
    var offs = load64(ec + 48);
    var b = 0;
    if (offs < load64(ec + 8)) {
        b = load8(load64(ec) + offs);
        store64(ec + 48, offs + 1);
    }
    return b;
}

fn ec_read_byte_from_end(ec) {
    var eo = load64(ec + 16);
    var b = 0;
    if (eo < load64(ec + 8)) {
        eo = eo + 1;
        store64(ec + 16, eo);
        b = load8(load64(ec) + load64(ec + 8) - eo);
    }
    return b;
}

# Normalize: while rng <= CODE_BOT, shift in a symbol (mirrors ec_dec_normalize).
fn ec_dec_normalize(ec) {
    while (load64(ec + 56) <= 0x800000) {
        store64(ec + 40, load64(ec + 40) + 8);                        # nbits_total += 8
        store64(ec + 56, (load64(ec + 56) << 8) & EC_U32);            # rng <<= 8
        var sym = load64(ec + 80);                                    # sym = old rem
        var newrem = ec_read_byte(ec);
        store64(ec + 80, newrem);
        sym = ((sym << 8) | newrem) >> 1;                             # >>(SYM_BITS-CODE_EXTRA)=1
        var notb = 255 - (sym & 255);                                 # 255 & ~sym
        store64(ec + 64, ((load64(ec + 64) << 8) + notb) & 0x7FFFFFFF);  # & (CODE_TOP-1)
    }
    return 0;
}

# Allocate + initialize a decoder over buf[0..len).
fn ec_dec_new(buf, len) {
    var ec = alloc(96);
    memset(ec, 0, 96);
    store64(ec, buf);
    store64(ec + 8, len);
    store64(ec + 40, 9);        # nbits_total = CODE_BITS+1 - ((CODE_BITS-CODE_EXTRA)/SYM_BITS)*SYM_BITS
    store64(ec + 56, 128);      # rng = 1<<CODE_EXTRA (1<<7)
    var rem = ec_read_byte(ec);
    store64(ec + 80, rem);
    store64(ec + 64, 127 - (rem >> 1));   # val = rng-1 - (rem>>(SYM_BITS-CODE_EXTRA))
    ec_dec_normalize(ec);
    return ec;
}

# ec_decode: return the cumulative frequency fs in [0,ft) for the coded symbol.
fn ec_decode(ec, ft) {
    var ext = load64(ec + 56) / ft;             # celt_udiv(rng, ft)
    store64(ec + 72, ext);
    var s = load64(ec + 64) / ext;
    var m = s + 1; if (m > ft) { m = ft; }
    return ft - m;
}

# ec_decode_bin: ec_decode with ft = 1<<bits (division replaced by shift).
fn ec_decode_bin(ec, bits) {
    var ext = load64(ec + 56) >> bits;
    store64(ec + 72, ext);
    var s = load64(ec + 64) / ext;
    var top = 1 << bits;
    var m = s + 1; if (m > top) { m = top; }
    return top - m;
}

# ec_dec_update: consume the symbol occupying [fl,fh) of ft.
fn ec_dec_update(ec, fl, fh, ft) {
    var ext = load64(ec + 72);
    var s = (ext * (ft - fh)) & EC_U32;
    store64(ec + 64, (load64(ec + 64) - s) & EC_U32);
    if (fl > 0) {
        store64(ec + 56, (ext * (fh - fl)) & EC_U32);
    } else {
        store64(ec + 56, (load64(ec + 56) - s) & EC_U32);
    }
    ec_dec_normalize(ec);
    return 0;
}

# Decode one bit with P(one) = 1/(1<<logp).
fn ec_dec_bit_logp(ec, logp) {
    var r = load64(ec + 56);
    var d = load64(ec + 64);
    var s = r >> logp;
    var ret = 0;
    if (d < s) { ret = 1; }
    if (ret == 0) { store64(ec + 64, d - s); }
    if (ret == 1) { store64(ec + 56, s); } else { store64(ec + 56, r - s); }
    ec_dec_normalize(ec);
    return ret;
}

# Decode a symbol from an inverse-CDF byte table with total 1<<ftb.
fn ec_dec_icdf(ec, icdf, ftb) {
    var s = load64(ec + 56);
    var d = load64(ec + 64);
    var r = s >> ftb;
    var ret = 0 - 1;
    var t = s;
    var cont = 1;
    while (cont == 1) {
        t = s;
        ret = ret + 1;
        s = (r * load8(icdf + ret)) & EC_U32;
        if (d < s) { cont = 1; } else { cont = 0; }
    }
    store64(ec + 64, d - s);
    store64(ec + 56, t - s);
    ec_dec_normalize(ec);
    return ret;
}

# Decode `bits` raw bits from the END of the buffer (LSB-first window).
fn ec_dec_bits(ec, bits) {
    var window = load64(ec + 24);
    var available = load64(ec + 32);
    if (available < bits) {
        var cont = 1;
        while (cont == 1) {
            window = (window | (ec_read_byte_from_end(ec) << available)) & EC_U32;
            available = available + 8;
            if (available <= 24) { cont = 1; } else { cont = 0; }
        }
    }
    var ret = window & ((1 << bits) - 1);
    store64(ec + 24, window >> bits);
    store64(ec + 32, available - bits);
    store64(ec + 40, load64(ec + 40) + bits);
    return ret;
}

# Decode a uniformly-distributed integer in [0, ft) (ft > 1).
fn ec_dec_uint(ec, ft) {
    var ftm = ft - 1;
    var ftb = ec_ilog(ftm);
    if (ftb > 8) {
        ftb = ftb - 8;
        var ftv = (ftm >> ftb) + 1;
        var s = ec_decode(ec, ftv);
        ec_dec_update(ec, s, s + 1, ftv);
        var t = (s << ftb) | ec_dec_bits(ec, ftb);
        if (t <= ftm) { return t; }
        store64(ec + 88, 1);
        return ftm;
    }
    var s2 = ec_decode(ec, ft);
    ec_dec_update(ec, s2, s2 + 1, ft);
    return s2;
}

# ec_tell: whole bits used so far.
fn ec_tell(ec) {
    return load64(ec + 40) - ec_ilog(load64(ec + 56));
}

fn _ec_corr_init() {
    _ec_corr = alloc(8 * 8);
    store64(_ec_corr + 0 * 8, 35733);
    store64(_ec_corr + 1 * 8, 38967);
    store64(_ec_corr + 2 * 8, 42495);
    store64(_ec_corr + 3 * 8, 46340);
    store64(_ec_corr + 4 * 8, 50535);
    store64(_ec_corr + 5 * 8, 55109);
    store64(_ec_corr + 6 * 8, 60097);
    store64(_ec_corr + 7 * 8, 65535);
    return 0;
}

# ec_tell_frac: bits used so far, in 1/8-bit (BITRES) units.
fn ec_tell_frac(ec) {
    if (_ec_corr == 0) { _ec_corr_init(); }
    var nbits = load64(ec + 40) << 3;                 # nbits_total << BITRES
    var l = ec_ilog(load64(ec + 56));
    var r = load64(ec + 56) >> (l - 16);
    var b = (r >> 12) - 8;
    if (r > load64(_ec_corr + b * 8)) { b = b + 1; }
    l = (l << 3) + b;
    return nbits - l;
}

# ================================================================
# CELT band-energy decode (RFC 6716 §4.3) — float-build port of quant_bands.c
# ================================================================
# Energy is stored as base-2 log with the per-band mean (eMeans) removed
# (celt_glog). oldBandE persists ACROSS frames (it is the inter-frame predictor).
# Three phases, strict stream order: coarse (front range coder), fine (raw bits
# from the back), finalise (raw bits). LM=3, nbEBands=21 (fullband).

var _celt_eprob_inter = 0;    # e_prob_model[3][0], 42 bytes (LM=3 inter)
var _celt_eprob_intra = 0;    # e_prob_model[3][1], 42 bytes (LM=3 intra)
var _celt_small_en_icdf = 0;  # small_energy_icdf = {2,1,0}
var CELT_LM = 3;
var CELT_NB_EBANDS = 21;
var CELT_MAX_FINE_BITS = 8;
# float pred/beta for LM=3 (see quant_bands.c:67-69, indexed [3]); inited at startup.
var CELT_PRED_COEF3 = 0;      # 0.5
var CELT_BETA_COEF3 = 0;      # 0.20001220703125
var CELT_BETA_INTRA = 0;      # 0.149993896484375

fn _celt_energy_tables_init() {
    _celt_eprob_inter = alloc(42);
    var bi = alloc(42 * 8);
    store64(bi+0*8,42);  store64(bi+1*8,121); store64(bi+2*8,96);  store64(bi+3*8,66);
    store64(bi+4*8,108); store64(bi+5*8,43);  store64(bi+6*8,111); store64(bi+7*8,40);
    store64(bi+8*8,117); store64(bi+9*8,44);  store64(bi+10*8,123);store64(bi+11*8,32);
    store64(bi+12*8,120);store64(bi+13*8,36); store64(bi+14*8,119);store64(bi+15*8,33);
    store64(bi+16*8,127);store64(bi+17*8,33); store64(bi+18*8,134);store64(bi+19*8,34);
    store64(bi+20*8,139);store64(bi+21*8,21); store64(bi+22*8,147);store64(bi+23*8,23);
    store64(bi+24*8,152);store64(bi+25*8,20); store64(bi+26*8,158);store64(bi+27*8,25);
    store64(bi+28*8,154);store64(bi+29*8,26); store64(bi+30*8,166);store64(bi+31*8,21);
    store64(bi+32*8,173);store64(bi+33*8,16); store64(bi+34*8,184);store64(bi+35*8,13);
    store64(bi+36*8,184);store64(bi+37*8,10); store64(bi+38*8,150);store64(bi+39*8,13);
