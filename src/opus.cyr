# ================================================================
# opus.cyr -- Opus header parsing and CELT-mode encoding (Ogg container)
# ================================================================
#
# Provides:
#   opus_parse_head(data, len)             -- parse OpusHead packet
#   opus_serialize_head(channels, pre_skip, sample_rate, out_buf) -- serialize OpusHead
#   opus_serialize_tags(out_buf)           -- serialize minimal OpusTags
#   opus_range_enc_init()                  -- create range encoder state
#   opus_range_enc_encode(rc, fl, fh, total) -- encode symbol
#   opus_range_enc_flush(rc)               -- finalize, returns (ptr, len) via Str
#   opus_encode(samples_vec, sample_rate, channels, bitrate, out_buf)
#   opus_decode_from_packets(packets_vec, ogg_data, ogg_len)
#
# Requires: alloc, vec, str, math, ogg, fft, assert

# ================================================================
# OpusHead struct (heap-allocated)
# ================================================================
# Layout (56 bytes):
#   +0:  version              (i64)
#   +8:  channel_count        (i64)
#   +16: pre_skip             (i64)
#   +24: input_sample_rate    (i64)
#   +32: output_gain          (i64, signed)
#   +40: channel_mapping_family (i64)

fn opus_head_new() {
    var h = alloc(48);
    memset(h, 0, 48);
    return h;
}

fn opus_head_version(h)        { return load64(h); }
fn opus_head_channels(h)       { return load64(h + 8); }
fn opus_head_pre_skip(h)       { return load64(h + 16); }
fn opus_head_sample_rate(h)    { return load64(h + 24); }
fn opus_head_output_gain(h)    { return load64(h + 32); }
fn opus_head_mapping(h)        { return load64(h + 40); }

# ================================================================
# OpusHead parsing
# ================================================================

# Parse an OpusHead identification packet.
# data: pointer to raw bytes, len: byte count.
# Returns heap-allocated OpusHead struct, or err().
fn opus_parse_head(data, len) {
    if (len < 19) { return err(ERR_INVALID_HEADER); }

    # Check "OpusHead" magic (8 bytes)
    if (load8(data)     != 0x4F) { return err(ERR_INVALID_HEADER); }  # 'O'
    if (load8(data + 1) != 0x70) { return err(ERR_INVALID_HEADER); }  # 'p'
    if (load8(data + 2) != 0x75) { return err(ERR_INVALID_HEADER); }  # 'u'
    if (load8(data + 3) != 0x73) { return err(ERR_INVALID_HEADER); }  # 's'
    if (load8(data + 4) != 0x48) { return err(ERR_INVALID_HEADER); }  # 'H'
    if (load8(data + 5) != 0x65) { return err(ERR_INVALID_HEADER); }  # 'e'
    if (load8(data + 6) != 0x61) { return err(ERR_INVALID_HEADER); }  # 'a'
    if (load8(data + 7) != 0x64) { return err(ERR_INVALID_HEADER); }  # 'd'

    var version = load8(data + 8);
    var channel_count = load8(data + 9);
    var pre_skip = read_u16_le(data, 10);
    var input_sample_rate = read_u32_le(data, 12);
    # output_gain is signed i16 LE
    var output_gain_raw = read_u16_le(data, 16);
    var output_gain = output_gain_raw;
    if (output_gain >= 32768) {
        output_gain = output_gain - 65536;
    }
    var channel_mapping_family = load8(data + 18);

    if (channel_count == 0) { return err(ERR_INVALID_CHANNELS); }

    var h = opus_head_new();
    store64(h,      version);
    store64(h + 8,  channel_count);
    store64(h + 16, pre_skip);
    store64(h + 24, input_sample_rate);
    store64(h + 32, output_gain);
    store64(h + 40, channel_mapping_family);
    return h;
}

# ================================================================
# OpusHead serialization (19 bytes)
# ================================================================

# Serialize OpusHead into out_buf (must be >= 19 bytes).
# Returns 19 (bytes written).
fn opus_serialize_head(channels, pre_skip, sample_rate, out_buf) {
    # "OpusHead" magic
    store8(out_buf,     0x4F);
    store8(out_buf + 1, 0x70);
    store8(out_buf + 2, 0x75);
    store8(out_buf + 3, 0x73);
    store8(out_buf + 4, 0x48);
    store8(out_buf + 5, 0x65);
    store8(out_buf + 6, 0x61);
    store8(out_buf + 7, 0x64);

    store8(out_buf + 8, 1);         # version
    store8(out_buf + 9, channels);
    write_u16_le(out_buf, 10, pre_skip);
    write_u32_le(out_buf, 12, sample_rate);
    write_u16_le(out_buf, 16, 0);   # output gain = 0
    store8(out_buf + 18, 0);        # channel mapping family 0

    return 19;
}

# ================================================================
# OpusTags serialization
# ================================================================

# Serialize minimal OpusTags into out_buf (must be >= 23 bytes).
# Returns bytes written.
fn opus_serialize_tags(out_buf) {
    # "OpusTags" magic
    store8(out_buf,     0x4F);
    store8(out_buf + 1, 0x70);
    store8(out_buf + 2, 0x75);
    store8(out_buf + 3, 0x73);
    store8(out_buf + 4, 0x54);
    store8(out_buf + 5, 0x61);
    store8(out_buf + 6, 0x67);
    store8(out_buf + 7, 0x73);

    # Vendor string: "shravan" (7 bytes)
    write_u32_le(out_buf, 8, 7);
    store8(out_buf + 12, 0x73);  # s
    store8(out_buf + 13, 0x68);  # h
    store8(out_buf + 14, 0x72);  # r
    store8(out_buf + 15, 0x61);  # a
    store8(out_buf + 16, 0x76);  # v
    store8(out_buf + 17, 0x61);  # a
    store8(out_buf + 18, 0x6E);  # n

    # User comment list length = 0
    write_u32_le(out_buf, 19, 0);

    return 23;
}

# ================================================================
# OpusTags parsing
# ================================================================

fn opus_parse_tags(data, len) {
    if (len < 8) { return err(ERR_INVALID_HEADER); }
    if (load8(data)     != 0x4F) { return err(ERR_INVALID_HEADER); }
    if (load8(data + 1) != 0x70) { return err(ERR_INVALID_HEADER); }
    if (load8(data + 2) != 0x75) { return err(ERR_INVALID_HEADER); }
    if (load8(data + 3) != 0x73) { return err(ERR_INVALID_HEADER); }
    if (load8(data + 4) != 0x54) { return err(ERR_INVALID_HEADER); }
    if (load8(data + 5) != 0x61) { return err(ERR_INVALID_HEADER); }
    if (load8(data + 6) != 0x67) { return err(ERR_INVALID_HEADER); }
    if (load8(data + 7) != 0x73) { return err(ERR_INVALID_HEADER); }
    return tag_read_vorbis(data + 8, len - 8);
}

# ================================================================
# Range coder (byte-oriented, LZMA-style carry) — encoder + decoder
# ================================================================
# A standard, provably-invertible range coder. The encoder emits bytes
# MSB-first with a one-byte cache plus a run counter to propagate carries;
# the decoder consumes the identical stream. RFC 6716's CELT layer uses an
# ec_enc/ec_dec pair with the same algebra; this implementation keeps the
# public opus_range_* names so existing call sites are unchanged.
#
# Encoder state (64 bytes):
#   +0:  buf (output byte pointer)   +8:  buf_len       +16: buf_cap
#   +24: low (up to 2^33, carry in bit 32)              +32: range (<= 2^32-1)
#   +40: cache (pending byte)         +48: cache_size (deferred 0xFF run + 1)
# Decoder state (48 bytes):
#   +0: data   +8: len   +16: pos   +24: range   +32: code

var RC_TOP = 0x1000000;   # 2^24 renormalization threshold (kTopValue)

fn opus_range_enc_init() {
    var rc = alloc(64);
    memset(rc, 0, 64);
    store64(rc,      alloc(4096));   # buf
    store64(rc + 8,  0);             # buf_len
    store64(rc + 16, 4096);          # buf_cap
    store64(rc + 24, 0);             # low
    store64(rc + 32, 0xFFFFFFFF);    # range
    store64(rc + 40, 0);             # cache
    store64(rc + 48, 1);             # cache_size (leading byte pending)
    return rc;
}

fn _rc_push_byte(rc, byte) {
    var buf = load64(rc);
    var blen = load64(rc + 8);
    var bcap = load64(rc + 16);
    if (blen >= bcap) {
        var new_cap = bcap * 2;
        var new_buf = alloc(new_cap);
        memcpy(new_buf, buf, blen);
        store64(rc, new_buf);
        store64(rc + 16, new_cap);
        buf = new_buf;
    }
    store8(buf + blen, byte & 0xFF);
    store64(rc + 8, blen + 1);
    return 0;
}

# LZMA ShiftLow: resolve carry, emit cache + any deferred 0xFF run, shift low.
fn _rc_shift_low(rc) {
    var low = load64(rc + 24);
    var carry = (low >> 32) & 0x1;          # 0 or 1
    if ((carry != 0) | (low < 0xFF000000)) {
        var temp = load64(rc + 40);         # cache
        var cs = load64(rc + 48);           # cache_size (>= 1)
        var i = 0;
        while (i < cs) {
            _rc_push_byte(rc, (temp + carry) & 0xFF);
            temp = 0xFF;
            i = i + 1;
        }
        store64(rc + 48, 0);
        store64(rc + 40, (low >> 24) & 0xFF);   # new cache
    }
    store64(rc + 48, load64(rc + 48) + 1);      # cache_size++
    store64(rc + 24, (low << 8) & 0xFFFFFFFF);
    return 0;
}

# Encode a symbol occupying [fl, fh) out of total.
fn opus_range_enc_encode(rc, fl, fh, total) {
    if (total == 0) { return 0; }
    var range = load64(rc + 32);
    var r = range / total;
    store64(rc + 24, load64(rc + 24) + r * fl);   # low += r*fl (carry into bit 32)
    if (fh < total) {
        store64(rc + 32, r * (fh - fl));
    } else {
        store64(rc + 32, range - r * fl);         # top symbol keeps the remainder
    }
    var rng = load64(rc + 32);
    while (rng < RC_TOP) {
        _rc_shift_low(rc);
        rng = (rng << 8) & 0xFFFFFFFF;
        store64(rc + 32, rng);
    }
    return 0;
}

# Encode a single equiprobable bit.
fn opus_range_enc_bit(rc, val) {
    if (val != 0) {
        opus_range_enc_encode(rc, 1, 2, 2);
    } else {
        opus_range_enc_encode(rc, 0, 1, 2);
    }
    return 0;
}

# Encode a value uniformly in [0, total).
fn opus_range_enc_uint(rc, val, total) {
    if (total <= 1) { return 0; }
    opus_range_enc_encode(rc, val, val + 1, total);
    return 0;
}

# Approximate bytes emitted so far (committed + pending cache run).
fn opus_range_enc_bytes_used(rc) {
    return load64(rc + 8) + load64(rc + 48);
}

# Finalize: flush the 5 low bytes and return Str(data, len).
fn opus_range_enc_flush(rc) {
    var i = 0;
    while (i < 5) {
        _rc_shift_low(rc);
        i = i + 1;
    }
    return str_new(load64(rc), load64(rc + 8));
}

# ---------------- decoder (exact mirror of the encoder) ----------------

fn _rd_next_byte(rd) {
    var pos = load64(rd + 16);
    var b = 0;
    if (pos < load64(rd + 8)) { b = load8(load64(rd) + pos); }
    store64(rd + 16, pos + 1);
    return b;
}

# Initialize from a byte buffer: prime code with 5 bytes (leading cache
# byte shifts out of the 32-bit window, mirroring the encoder's leading byte).
fn opus_range_dec_init(data, len) {
    var rd = alloc(48);
    store64(rd, data);
    store64(rd + 8, len);
    store64(rd + 16, 0);
    store64(rd + 24, 0xFFFFFFFF);
    var code = 0;
    var i = 0;
    while (i < 5) {
        code = ((code << 8) | _rd_next_byte(rd)) & 0xFFFFFFFF;
        i = i + 1;
    }
    store64(rd + 32, code);
    return rd;
}

# Decode a value uniformly in [0, total) — inverse of opus_range_enc_uint.
fn opus_range_dec_uint(rd, total) {
    if (total <= 1) { return 0; }
    var range = load64(rd + 24);
    var code = load64(rd + 32);
    var r = range / total;
    var v = code / r;
    if (v >= total) { v = total - 1; }
    code = code - r * v;
    if (v + 1 < total) {
        range = r;
    } else {
        range = range - r * v;
    }
    while (range < RC_TOP) {
        code = ((code << 8) | _rd_next_byte(rd)) & 0xFFFFFFFF;
        range = (range << 8) & 0xFFFFFFFF;
    }
    store64(rd + 24, range);
    store64(rd + 32, code);
    return v;
}

# Decode a single equiprobable bit.
fn opus_range_dec_bit(rd) {
    return opus_range_dec_uint(rd, 2);
}

# ================================================================
# RFC 6716 range decoder (ec_dec) — exact port of libopus entdec.c/entcode.c
# ================================================================
# THE REAL Opus entropy decoder. The bespoke opus_range_* coder above is the
# legacy, non-interoperable path (kept for the legacy encoder+tests); this ec_dec
# is what decodes an actual libopus/RFC-6716 stream. All uint32 arithmetic is
# emulated in i64 with explicit 0xFFFFFFFF / 0x7FFFFFFF masks.
#
# State layout (96 bytes):
#   +0  buf (byte ptr)   +8  storage (len)   +16 end_offs   +24 end_window (u32)
#   +32 nend_bits        +40 nbits_total     +48 offs       +56 rng (u32)
#   +64 val (u32)        +72 ext (u32)       +80 rem        +88 error
# Constants (mfrngcod.h): SYM_BITS=8, CODE_BITS=32, SYM_MAX=255,
#   CODE_TOP=1<<31, CODE_BOT=1<<23 (0x800000), CODE_EXTRA=7, BITRES=3.

var EC_U32 = 0xFFFFFFFF;
var _ec_corr = 0;   # lazily-built ec_tell_frac correction[8]

# EC_ILOG(v): number of significant bits of v (floor(log2 v)+1); ec_ilog(0)=0.
fn ec_ilog(v) {
    var r = 0;
    var x = v & EC_U32;
    while (x > 0) { r = r + 1; x = x >> 1; }
    return r;
}

fn ec_read_byte(ec) {
    var offs = load64(ec + 48);
    var b = 0;
    if (offs < load64(ec + 8)) {
        b = load8(load64(ec) + offs);
        store64(ec + 48, offs + 1);
    }
    return b;
}

fn ec_read_byte_from_end(ec) {
    var eo = load64(ec + 16);
    var b = 0;
    if (eo < load64(ec + 8)) {
        eo = eo + 1;
        store64(ec + 16, eo);
        b = load8(load64(ec) + load64(ec + 8) - eo);
    }
    return b;
}

# Normalize: while rng <= CODE_BOT, shift in a symbol (mirrors ec_dec_normalize).
fn ec_dec_normalize(ec) {
    while (load64(ec + 56) <= 0x800000) {
        store64(ec + 40, load64(ec + 40) + 8);                        # nbits_total += 8
        store64(ec + 56, (load64(ec + 56) << 8) & EC_U32);            # rng <<= 8
        var sym = load64(ec + 80);                                    # sym = old rem
        var newrem = ec_read_byte(ec);
        store64(ec + 80, newrem);
        sym = ((sym << 8) | newrem) >> 1;                             # >>(SYM_BITS-CODE_EXTRA)=1
        var notb = 255 - (sym & 255);                                 # 255 & ~sym
        store64(ec + 64, ((load64(ec + 64) << 8) + notb) & 0x7FFFFFFF);  # & (CODE_TOP-1)
    }
    return 0;
}

# Allocate + initialize a decoder over buf[0..len).
fn ec_dec_new(buf, len) {
    var ec = alloc(96);
    memset(ec, 0, 96);
    store64(ec, buf);
    store64(ec + 8, len);
    store64(ec + 40, 9);        # nbits_total = CODE_BITS+1 - ((CODE_BITS-CODE_EXTRA)/SYM_BITS)*SYM_BITS
    store64(ec + 56, 128);      # rng = 1<<CODE_EXTRA (1<<7)
    var rem = ec_read_byte(ec);
    store64(ec + 80, rem);
    store64(ec + 64, 127 - (rem >> 1));   # val = rng-1 - (rem>>(SYM_BITS-CODE_EXTRA))
    ec_dec_normalize(ec);
    return ec;
}

# ec_decode: return the cumulative frequency fs in [0,ft) for the coded symbol.
fn ec_decode(ec, ft) {
    var ext = load64(ec + 56) / ft;             # celt_udiv(rng, ft)
    store64(ec + 72, ext);
    var s = load64(ec + 64) / ext;
    var m = s + 1; if (m > ft) { m = ft; }
    return ft - m;
}

# ec_decode_bin: ec_decode with ft = 1<<bits (division replaced by shift).
fn ec_decode_bin(ec, bits) {
    var ext = load64(ec + 56) >> bits;
    store64(ec + 72, ext);
    var s = load64(ec + 64) / ext;
    var top = 1 << bits;
    var m = s + 1; if (m > top) { m = top; }
    return top - m;
}

# ec_dec_update: consume the symbol occupying [fl,fh) of ft.
fn ec_dec_update(ec, fl, fh, ft) {
    var ext = load64(ec + 72);
    var s = (ext * (ft - fh)) & EC_U32;
    store64(ec + 64, (load64(ec + 64) - s) & EC_U32);
    if (fl > 0) {
        store64(ec + 56, (ext * (fh - fl)) & EC_U32);
    } else {
        store64(ec + 56, (load64(ec + 56) - s) & EC_U32);
    }
    ec_dec_normalize(ec);
    return 0;
}

# Decode one bit with P(one) = 1/(1<<logp).
fn ec_dec_bit_logp(ec, logp) {
    var r = load64(ec + 56);
    var d = load64(ec + 64);
    var s = r >> logp;
    var ret = 0;
    if (d < s) { ret = 1; }
    if (ret == 0) { store64(ec + 64, d - s); }
    if (ret == 1) { store64(ec + 56, s); } else { store64(ec + 56, r - s); }
    ec_dec_normalize(ec);
    return ret;
}

# Decode a symbol from an inverse-CDF byte table with total 1<<ftb.
fn ec_dec_icdf(ec, icdf, ftb) {
    var s = load64(ec + 56);
    var d = load64(ec + 64);
    var r = s >> ftb;
    var ret = 0 - 1;
    var t = s;
    var cont = 1;
    while (cont == 1) {
        t = s;
        ret = ret + 1;
        s = (r * load8(icdf + ret)) & EC_U32;
        if (d < s) { cont = 1; } else { cont = 0; }
    }
    store64(ec + 64, d - s);
    store64(ec + 56, t - s);
    ec_dec_normalize(ec);
    return ret;
}

# Decode `bits` raw bits from the END of the buffer (LSB-first window).
fn ec_dec_bits(ec, bits) {
    var window = load64(ec + 24);
    var available = load64(ec + 32);
    if (available < bits) {
        var cont = 1;
        while (cont == 1) {
            window = (window | (ec_read_byte_from_end(ec) << available)) & EC_U32;
            available = available + 8;
            if (available <= 24) { cont = 1; } else { cont = 0; }
        }
    }
    var ret = window & ((1 << bits) - 1);
    store64(ec + 24, window >> bits);
    store64(ec + 32, available - bits);
    store64(ec + 40, load64(ec + 40) + bits);
    return ret;
}

# Decode a uniformly-distributed integer in [0, ft) (ft > 1).
fn ec_dec_uint(ec, ft) {
    var ftm = ft - 1;
    var ftb = ec_ilog(ftm);
    if (ftb > 8) {
        ftb = ftb - 8;
        var ftv = (ftm >> ftb) + 1;
        var s = ec_decode(ec, ftv);
        ec_dec_update(ec, s, s + 1, ftv);
        var t = (s << ftb) | ec_dec_bits(ec, ftb);
        if (t <= ftm) { return t; }
        store64(ec + 88, 1);
        return ftm;
    }
    var s2 = ec_decode(ec, ft);
    ec_dec_update(ec, s2, s2 + 1, ft);
    return s2;
}

# ec_tell: whole bits used so far.
fn ec_tell(ec) {
    return load64(ec + 40) - ec_ilog(load64(ec + 56));
}

fn _ec_corr_init() {
    _ec_corr = alloc(8 * 8);
    store64(_ec_corr + 0 * 8, 35733);
    store64(_ec_corr + 1 * 8, 38967);
    store64(_ec_corr + 2 * 8, 42495);
    store64(_ec_corr + 3 * 8, 46340);
    store64(_ec_corr + 4 * 8, 50535);
    store64(_ec_corr + 5 * 8, 55109);
    store64(_ec_corr + 6 * 8, 60097);
    store64(_ec_corr + 7 * 8, 65535);
    return 0;
}

# ec_tell_frac: bits used so far, in 1/8-bit (BITRES) units.
fn ec_tell_frac(ec) {
    if (_ec_corr == 0) { _ec_corr_init(); }
    var nbits = load64(ec + 40) << 3;                 # nbits_total << BITRES
    var l = ec_ilog(load64(ec + 56));
    var r = load64(ec + 56) >> (l - 16);
    var b = (r >> 12) - 8;
    if (r > load64(_ec_corr + b * 8)) { b = b + 1; }
    l = (l << 3) + b;
    return nbits - l;
}

# ================================================================
# CELT range ENCODER (ec_enc) — RFC 6716 §4.1 / entenc.c port (the inverse of ec_dec).
# ================================================================
# Writes range-coded symbols to the FRONT of buf and raw bits to the END, sharing the
# ec_ctx offset layout with the decoder so ec_dec_new() reads the encoder's output directly:
#   ec+0 buf  +8 storage  +16 end_offs  +24 end_window  +32 nend_bits  +40 nbits_total
#   +48 offs  +56 rng  +64 val  +72 ext(carry counter)  +80 rem  +88 error
# Constants: EC_SYM_MAX=255, EC_SYM_BITS=8, EC_CODE_TOP=1<<31, EC_CODE_BOT=1<<23,
#   EC_CODE_SHIFT=23, EC_UINT_BITS=8, EC_WINDOW_SIZE=32. val/rng are uint32 (& EC_U32).

fn ec_enc_new(buf, size) {
    var ec = alloc(96);
    memset(ec, 0, 96);
    store64(ec + 0, buf);            # buf
    store64(ec + 8, size);           # storage
    store64(ec + 40, 33);            # nbits_total = EC_CODE_BITS+1
    store64(ec + 56, 0x80000000);    # rng = EC_CODE_TOP
    store64(ec + 80, 0 - 1);         # rem = -1
    return ec;                        # end_offs/end_window/nend_bits/offs/val/ext/error = 0
}

fn ec_write_byte(ec, value) {
    if (load64(ec + 48) + load64(ec + 16) >= load64(ec + 8)) { return 0 - 1; }
    store8(load64(ec + 0) + load64(ec + 48), value & 255);
    store64(ec + 48, load64(ec + 48) + 1);
    return 0;
}

fn ec_write_byte_at_end(ec, value) {
    if (load64(ec + 48) + load64(ec + 16) >= load64(ec + 8)) { return 0 - 1; }
    store64(ec + 16, load64(ec + 16) + 1);
    store8(load64(ec + 0) + load64(ec + 8) - load64(ec + 16), value & 255);
    return 0;
}

# ec_enc_carry_out: emit a symbol with a carry bit, buffering runs of 0xFF until the
# carry is resolved (rem = last buffered byte, ext = count of pending 0xFF symbols).
fn ec_enc_carry_out(ec, c) {
    if (c != 255) {
        var carry = c >> 8;
        if (load64(ec + 80) >= 0) {
            store64(ec + 88, load64(ec + 88) | ec_write_byte(ec, load64(ec + 80) + carry));
        }
        if (load64(ec + 72) > 0) {
            var sym = (255 + carry) & 255;
            var cont = 1;
            while (cont == 1) {
                store64(ec + 88, load64(ec + 88) | ec_write_byte(ec, sym));
                store64(ec + 72, load64(ec + 72) - 1);
                if (load64(ec + 72) > 0) { cont = 1; } else { cont = 0; }
            }
        }
        store64(ec + 80, c & 255);
    } else {
        store64(ec + 72, load64(ec + 72) + 1);
    }
    return 0;
}

fn ec_enc_normalize(ec) {
    while (load64(ec + 56) <= 0x800000) {
        ec_enc_carry_out(ec, load64(ec + 64) >> 23);
        store64(ec + 64, (load64(ec + 64) << 8) & 0x7FFFFFFF);
        store64(ec + 56, (load64(ec + 56) << 8) & EC_U32);
        store64(ec + 40, load64(ec + 40) + 8);
    }
    return 0;
}

fn ec_encode(ec, fl, fh, ft) {
    var r = load64(ec + 56) / ft;
    if (fl > 0) {
        store64(ec + 64, (load64(ec + 64) + load64(ec + 56) - (r * (ft - fl))) & EC_U32);
        store64(ec + 56, (r * (fh - fl)) & EC_U32);
    } else {
        store64(ec + 56, (load64(ec + 56) - (r * (ft - fh))) & EC_U32);
    }
    ec_enc_normalize(ec);
    return 0;
}

fn ec_encode_bin(ec, fl, fh, bits) {
    var r = load64(ec + 56) >> bits;
    if (fl > 0) {
        store64(ec + 64, (load64(ec + 64) + load64(ec + 56) - (r * ((1 << bits) - fl))) & EC_U32);
        store64(ec + 56, (r * (fh - fl)) & EC_U32);
    } else {
        store64(ec + 56, (load64(ec + 56) - (r * ((1 << bits) - fh))) & EC_U32);
    }
    ec_enc_normalize(ec);
    return 0;
}

# Encode one bit with P(one) = 1/(1<<logp).
fn ec_enc_bit_logp(ec, val, logp) {
    var r = load64(ec + 56);
    var l = load64(ec + 64);
    var s = r >> logp;
    r = r - s;
    if (val != 0) { store64(ec + 64, (l + r) & EC_U32); store64(ec + 56, s); }
    else { store64(ec + 56, r); }
    ec_enc_normalize(ec);
    return 0;
}

fn ec_enc_icdf(ec, s, icdf, ftb) {
    var r = load64(ec + 56) >> ftb;
    if (s > 0) {
        store64(ec + 64, (load64(ec + 64) + load64(ec + 56) - (r * load8(icdf + s - 1))) & EC_U32);
        store64(ec + 56, (r * (load8(icdf + s - 1) - load8(icdf + s))) & EC_U32);
    } else {
        store64(ec + 56, (load64(ec + 56) - (r * load8(icdf + s))) & EC_U32);
    }
    ec_enc_normalize(ec);
    return 0;
}

# Encode `bits` raw bits at the END of the buffer (LSB-first window, mirrors ec_dec_bits).
fn ec_enc_bits(ec, fl, bits) {
    var window = load64(ec + 24);
    var used = load64(ec + 32);
    if (used + bits > 32) {
        var cont = 1;
        while (cont == 1) {
            store64(ec + 88, load64(ec + 88) | ec_write_byte_at_end(ec, window & 255));
            window = window >> 8;
            used = used - 8;
            if (used >= 8) { cont = 1; } else { cont = 0; }
        }
    }
    window = (window | (fl << used)) & EC_U32;
    used = used + bits;
    store64(ec + 24, window);
    store64(ec + 32, used);
    store64(ec + 40, load64(ec + 40) + bits);
    return 0;
}

# Encode a uniformly-distributed integer fl in [0, ft) (ft > 1).
fn ec_enc_uint(ec, fl, ft) {
    ft = ft - 1;
    var ftb = ec_ilog(ft);
    if (ftb > 8) {
        ftb = ftb - 8;
        var ftv = (ft >> ftb) + 1;
        var flv = fl >> ftb;
        ec_encode(ec, flv, flv + 1, ftv);
        ec_enc_bits(ec, fl & ((1 << ftb) - 1), ftb);
    } else {
        ec_encode(ec, fl, fl + 1, ft + 1);
    }
    return 0;
}

# Finalize: emit the minimum bits so the symbols decode correctly, flush buffered
# carry + raw bits, zero the gap, and OR trailing raw bits into the last byte.
fn ec_enc_done(ec) {
    var l = 32 - ec_ilog(load64(ec + 56));
    var msk = 0x7FFFFFFF >> l;
    var end = (load64(ec + 64) + msk) & ((0 - 1 - msk) & EC_U32);
    if ((end | msk) >= ((load64(ec + 64) + load64(ec + 56)) & EC_U32)) {
        l = l + 1;
        msk = msk >> 1;
        end = (load64(ec + 64) + msk) & ((0 - 1 - msk) & EC_U32);
    }
    while (l > 0) {
        ec_enc_carry_out(ec, end >> 23);
        end = (end << 8) & 0x7FFFFFFF;
        l = l - 8;
    }
    if ((load64(ec + 80) >= 0) | (load64(ec + 72) > 0)) { ec_enc_carry_out(ec, 0); }
    var window = load64(ec + 24);
    var used = load64(ec + 32);
    while (used >= 8) {
        store64(ec + 88, load64(ec + 88) | ec_write_byte_at_end(ec, window & 255));
        window = window >> 8;
        used = used - 8;
    }
    if (load64(ec + 88) == 0) {
        var gap = load64(ec + 8) - load64(ec + 48) - load64(ec + 16);
        var g = 0;
        while (g < gap) { store8(load64(ec + 0) + load64(ec + 48) + g, 0); g = g + 1; }
        if (used > 0) {
            if (load64(ec + 16) >= load64(ec + 8)) { store64(ec + 88, 0 - 1); }
            else {
                l = 0 - l;
                if ((load64(ec + 48) + load64(ec + 16) >= load64(ec + 8)) & (l < used)) {
                    window = window & ((1 << l) - 1);
                    store64(ec + 88, 0 - 1);
                }
                var lb = load64(ec + 0) + load64(ec + 8) - load64(ec + 16) - 1;
                store8(lb, load8(lb) | (window & 255));
            }
        }
    }
    return 0;
}

# ================================================================
# CELT band-energy decode (RFC 6716 §4.3) — float-build port of quant_bands.c
# ================================================================
# Energy is stored as base-2 log with the per-band mean (eMeans) removed
# (celt_glog). oldBandE persists ACROSS frames (it is the inter-frame predictor).
# Three phases, strict stream order: coarse (front range coder), fine (raw bits
# from the back), finalise (raw bits). LM=3, nbEBands=21 (fullband).

var _celt_eprob_inter = 0;    # e_prob_model[3][0], 42 bytes (LM=3 inter)
var _celt_eprob_intra = 0;    # e_prob_model[3][1], 42 bytes (LM=3 intra)
var _celt_eprob_inter2 = 0;   # e_prob_model[2][0], 42 bytes (LM=2 / 10ms inter)
var _celt_eprob_intra2 = 0;   # e_prob_model[2][1], 42 bytes (LM=2 / 10ms intra)
var _celt_small_en_icdf = 0;  # small_energy_icdf = {2,1,0}
var CELT_LM = 3;
var CELT_NB_EBANDS = 21;
var CELT_MAX_FINE_BITS = 8;
# float pred/beta for LM=3 (see quant_bands.c:67-69, indexed [3]); inited at startup.
var CELT_PRED_COEF3 = 0;      # 0.5
var CELT_BETA_COEF3 = 0;      # 0.20001220703125
var CELT_BETA_INTRA = 0;      # 0.149993896484375
var CELT_PRED_COEF2 = 0;      # 21248/32768 = 0.6484375 (LM=2)
var CELT_BETA_COEF2 = 0;      # 12124/32768 = 0.369873046875 (LM=2)

fn _celt_energy_tables_init() {
    _celt_eprob_inter = alloc(42);
    var bi = alloc(42 * 8);
    store64(bi+0*8,42);  store64(bi+1*8,121); store64(bi+2*8,96);  store64(bi+3*8,66);
    store64(bi+4*8,108); store64(bi+5*8,43);  store64(bi+6*8,111); store64(bi+7*8,40);
    store64(bi+8*8,117); store64(bi+9*8,44);  store64(bi+10*8,123);store64(bi+11*8,32);
    store64(bi+12*8,120);store64(bi+13*8,36); store64(bi+14*8,119);store64(bi+15*8,33);
    store64(bi+16*8,127);store64(bi+17*8,33); store64(bi+18*8,134);store64(bi+19*8,34);
    store64(bi+20*8,139);store64(bi+21*8,21); store64(bi+22*8,147);store64(bi+23*8,23);
    store64(bi+24*8,152);store64(bi+25*8,20); store64(bi+26*8,158);store64(bi+27*8,25);
    store64(bi+28*8,154);store64(bi+29*8,26); store64(bi+30*8,166);store64(bi+31*8,21);
    store64(bi+32*8,173);store64(bi+33*8,16); store64(bi+34*8,184);store64(bi+35*8,13);
    store64(bi+36*8,184);store64(bi+37*8,10); store64(bi+38*8,150);store64(bi+39*8,13);
    store64(bi+40*8,139);store64(bi+41*8,15);
    var i = 0;
    while (i < 42) { store8(_celt_eprob_inter + i, load64(bi + i * 8)); i = i + 1; }

    _celt_eprob_intra = alloc(42);
    var bt = alloc(42 * 8);
    store64(bt+0*8,22); store64(bt+1*8,178); store64(bt+2*8,63); store64(bt+3*8,114);
    store64(bt+4*8,74); store64(bt+5*8,82);  store64(bt+6*8,84); store64(bt+7*8,83);
    store64(bt+8*8,92); store64(bt+9*8,82);  store64(bt+10*8,103);store64(bt+11*8,62);
    store64(bt+12*8,96);store64(bt+13*8,72); store64(bt+14*8,96); store64(bt+15*8,67);
    store64(bt+16*8,101);store64(bt+17*8,73);store64(bt+18*8,107);store64(bt+19*8,72);
    store64(bt+20*8,113);store64(bt+21*8,55);store64(bt+22*8,118);store64(bt+23*8,52);
    store64(bt+24*8,125);store64(bt+25*8,52);store64(bt+26*8,118);store64(bt+27*8,52);
    store64(bt+28*8,117);store64(bt+29*8,55);store64(bt+30*8,135);store64(bt+31*8,49);
    store64(bt+32*8,137);store64(bt+33*8,39);store64(bt+34*8,157);store64(bt+35*8,32);
    store64(bt+36*8,145);store64(bt+37*8,29);store64(bt+38*8,97); store64(bt+39*8,33);
    store64(bt+40*8,77); store64(bt+41*8,40);
    i = 0;
    while (i < 42) { store8(_celt_eprob_intra + i, load64(bt + i * 8)); i = i + 1; }

    _celt_small_en_icdf = alloc(3);
    store8(_celt_small_en_icdf + 0, 2);
    store8(_celt_small_en_icdf + 1, 1);
    store8(_celt_small_en_icdf + 2, 0);

    CELT_PRED_COEF3 = f64_div(f64_from(16384), f64_from(32768));   # 0.5
    CELT_BETA_COEF3 = f64_div(f64_from(6554),  f64_from(32768));   # 0.20001220703125
    CELT_BETA_INTRA = f64_div(f64_from(4915),  f64_from(32768));   # 0.149993896484375
    _celt_eprob_inter2 = alloc(42);
    store8(_celt_eprob_inter2 + 0, 61); store8(_celt_eprob_inter2 + 1, 90); store8(_celt_eprob_inter2 + 2, 93); store8(_celt_eprob_inter2 + 3, 60); store8(_celt_eprob_inter2 + 4, 105); store8(_celt_eprob_inter2 + 5, 42); store8(_celt_eprob_inter2 + 6, 107); store8(_celt_eprob_inter2 + 7, 41); store8(_celt_eprob_inter2 + 8, 110); store8(_celt_eprob_inter2 + 9, 45); store8(_celt_eprob_inter2 + 10, 116); store8(_celt_eprob_inter2 + 11, 38); store8(_celt_eprob_inter2 + 12, 113); store8(_celt_eprob_inter2 + 13, 38);
    store8(_celt_eprob_inter2 + 14, 112); store8(_celt_eprob_inter2 + 15, 38); store8(_celt_eprob_inter2 + 16, 124); store8(_celt_eprob_inter2 + 17, 26); store8(_celt_eprob_inter2 + 18, 132); store8(_celt_eprob_inter2 + 19, 27); store8(_celt_eprob_inter2 + 20, 136); store8(_celt_eprob_inter2 + 21, 19); store8(_celt_eprob_inter2 + 22, 140); store8(_celt_eprob_inter2 + 23, 20); store8(_celt_eprob_inter2 + 24, 155); store8(_celt_eprob_inter2 + 25, 14); store8(_celt_eprob_inter2 + 26, 159); store8(_celt_eprob_inter2 + 27, 16);
    store8(_celt_eprob_inter2 + 28, 158); store8(_celt_eprob_inter2 + 29, 18); store8(_celt_eprob_inter2 + 30, 170); store8(_celt_eprob_inter2 + 31, 13); store8(_celt_eprob_inter2 + 32, 177); store8(_celt_eprob_inter2 + 33, 10); store8(_celt_eprob_inter2 + 34, 187); store8(_celt_eprob_inter2 + 35, 8); store8(_celt_eprob_inter2 + 36, 192); store8(_celt_eprob_inter2 + 37, 6); store8(_celt_eprob_inter2 + 38, 175); store8(_celt_eprob_inter2 + 39, 9); store8(_celt_eprob_inter2 + 40, 159); store8(_celt_eprob_inter2 + 41, 10);
    _celt_eprob_intra2 = alloc(42);
    store8(_celt_eprob_intra2 + 0, 21); store8(_celt_eprob_intra2 + 1, 178); store8(_celt_eprob_intra2 + 2, 59); store8(_celt_eprob_intra2 + 3, 110); store8(_celt_eprob_intra2 + 4, 71); store8(_celt_eprob_intra2 + 5, 86); store8(_celt_eprob_intra2 + 6, 75); store8(_celt_eprob_intra2 + 7, 85); store8(_celt_eprob_intra2 + 8, 84); store8(_celt_eprob_intra2 + 9, 83); store8(_celt_eprob_intra2 + 10, 91); store8(_celt_eprob_intra2 + 11, 66); store8(_celt_eprob_intra2 + 12, 88); store8(_celt_eprob_intra2 + 13, 73);
    store8(_celt_eprob_intra2 + 14, 87); store8(_celt_eprob_intra2 + 15, 72); store8(_celt_eprob_intra2 + 16, 92); store8(_celt_eprob_intra2 + 17, 75); store8(_celt_eprob_intra2 + 18, 98); store8(_celt_eprob_intra2 + 19, 72); store8(_celt_eprob_intra2 + 20, 105); store8(_celt_eprob_intra2 + 21, 58); store8(_celt_eprob_intra2 + 22, 107); store8(_celt_eprob_intra2 + 23, 54); store8(_celt_eprob_intra2 + 24, 115); store8(_celt_eprob_intra2 + 25, 52); store8(_celt_eprob_intra2 + 26, 114); store8(_celt_eprob_intra2 + 27, 55);
    store8(_celt_eprob_intra2 + 28, 112); store8(_celt_eprob_intra2 + 29, 56); store8(_celt_eprob_intra2 + 30, 129); store8(_celt_eprob_intra2 + 31, 51); store8(_celt_eprob_intra2 + 32, 132); store8(_celt_eprob_intra2 + 33, 40); store8(_celt_eprob_intra2 + 34, 150); store8(_celt_eprob_intra2 + 35, 33); store8(_celt_eprob_intra2 + 36, 140); store8(_celt_eprob_intra2 + 37, 29); store8(_celt_eprob_intra2 + 38, 98); store8(_celt_eprob_intra2 + 39, 35); store8(_celt_eprob_intra2 + 40, 77); store8(_celt_eprob_intra2 + 41, 42);
    CELT_PRED_COEF2 = f64_div(f64_from(21248), f64_from(32768));
    CELT_BETA_COEF2 = f64_div(f64_from(12124), f64_from(32768));
    return 0;
}

# ec_laplace_get_freq1: ft=32736-fs0; return (ft*(16384-decay))>>15.
fn _ec_laplace_get_freq1(fs0, decay) {
    var ft = 32736 - fs0;
    return (ft * (16384 - decay)) >> 15;
}

# ec_laplace_decode(dec, fs, decay) -> signed energy delta qi (exact port).
fn ec_laplace_decode(ec, fs, decay) {
    var val = 0;
    var fm = ec_decode_bin(ec, 15);
    var fl = 0;
    if (fm >= fs) {
        val = 1;
        fl = fs;
        fs = _ec_laplace_get_freq1(fs, decay) + 1;
        while ((fs > 1) & (fm >= fl + 2 * fs)) {
            fs = fs * 2;
            fl = fl + fs;
            fs = ((fs - 2) * decay) >> 15;
            fs = fs + 1;
            val = val + 1;
        }
        if (fs <= 1) {
            var di = (fm - fl) >> 1;
            val = val + di;
            fl = fl + 2 * di;
        }
        if (fm < fl + fs) {
            val = 0 - val;
        } else {
            fl = fl + fs;
        }
    }
    var fh = fl + fs;
    if (fh > 32768) { fh = 32768; }
    ec_dec_update(ec, fl, fh, 32768);
    return val;
}

# ec_laplace_encode (laplace.c): encode a signed value with a Laplace-ish PDF (fs = P(0),
# decay). Inverse of ec_laplace_decode. Returns the (possibly clamped for the flat tail)
# value the decoder will recover — the caller uses it for the fine-energy error.
# LAPLACE_MINP=1, LAPLACE_LOG_MINP=0, LAPLACE_NMIN=16 (baked into _ec_laplace_get_freq1).
fn ec_laplace_encode(enc, value, fs, decay) {
    var fl = 0;
    var val = value;
    if (val != 0) {
        var s = 0 - (val < 0);            # s = -(val<0)
        val = (val + s) ^ s;              # abs(val)
        fl = fs;
        fs = _ec_laplace_get_freq1(fs, decay);
        var i = 1;
        while ((fs > 0) & (i < val)) {
            fs = fs * 2;
            fl = fl + fs + 2;             # fl += fs + 2*LAPLACE_MINP
            fs = (fs * decay) >> 15;
            i = i + 1;
        }
        if (fs == 0) {
            var ndi_max = 32768 - fl;     # (32768-fl+MINP-1)>>LOG_MINP
            ndi_max = (ndi_max - s) >> 1;
            var di = val - i;
            if (ndi_max - 1 < di) { di = ndi_max - 1; }
            fl = fl + (2 * di + 1 + s);   # *LAPLACE_MINP
            fs = 1;
            if (32768 - fl < 1) { fs = 32768 - fl; }
            value = (i + di + s) ^ s;
        } else {
            fs = fs + 1;                  # fs += LAPLACE_MINP
            fl = fl + (fs & (0 - 1 - s)); # fl += fs & ~s
        }
    }
    ec_encode_bin(enc, fl, fl + fs, 15);
    return value;
}

# unquant_coarse_energy: fills oldEBands[0..C*21) with base-2 log energies.
# `intra` is decoded by the caller (orchestration) and passed in.
fn celt_unquant_coarse_energy(oldEBands, intra, ec, C, start, end, LM) {
    if (_celt_eprob_inter == 0) { _celt_energy_tables_init(); }
    var prob = 0;
    var coef = F64_ZERO;
    var beta = F64_ZERO;
    # Energy model + prediction coefficients are per-frame-size (LM). beta_intra shared.
    if (intra != 0) {
        prob = _celt_eprob_intra;
        if (LM == 2) { prob = _celt_eprob_intra2; }
        coef = F64_ZERO;
        beta = CELT_BETA_INTRA;
    } else {
        prob = _celt_eprob_inter;
        coef = CELT_PRED_COEF3;
        beta = CELT_BETA_COEF3;
        if (LM == 2) { prob = _celt_eprob_inter2; coef = CELT_PRED_COEF2; beta = CELT_BETA_COEF2; }
    }
    var budget = load64(ec + 8) * 8;
    var prev0 = F64_ZERO;
    var prev1 = F64_ZERO;
    var neg9 = f64_neg(f64_from(9));
    var i = start;
    while (i < end) {
        var c = 0;
        while (c < C) {
            var idx = i + c * CELT_NB_EBANDS;
            var tell = ec_tell(ec);
            var qi = 0;
            if (budget - tell >= 15) {
                var pi = 2 * i;   # min(i,20)=i for i<21
                qi = ec_laplace_decode(ec, load8(prob + pi) << 7, load8(prob + pi + 1) << 6);
            } else {
                if (budget - tell >= 2) {
                    var sym = ec_dec_icdf(ec, _celt_small_en_icdf, 2);
                    qi = (sym >> 1) ^ (0 - (sym & 1));
                } else {
                    if (budget - tell >= 1) {
                        qi = 0 - ec_dec_bit_logp(ec, 1);
                    } else {
                        qi = 0 - 1;
                    }
                }
            }
            var q = f64_from(qi);
            var oldE = load64(oldEBands + idx * 8);
            oldE = f64_max(neg9, oldE);
            var prevc = prev0;
            if (c == 1) { prevc = prev1; }
            var tmp = f64_add(f64_add(f64_mul(coef, oldE), prevc), q);
            store64(oldEBands + idx * 8, tmp);
            # prev[c] += q - beta*q
            var np = f64_add(prevc, f64_sub(q, f64_mul(beta, q)));
            if (c == 1) { prev1 = np; } else { prev0 = np; }
            c = c + 1;
        }
        i = i + 1;
    }
    return 0;
}

# unquant_fine_energy: adds fine corrections (raw bits from the back).
fn celt_unquant_fine_energy(oldEBands, fine_quant, ec, C, start, end) {
    var i = start;
    while (i < end) {
        var extra = load64(fine_quant + i * 8);
        if (extra <= 0) {
            i = i + 1;
        } else {
            if (ec_tell(ec) + C * extra > load64(ec + 8) * 8) {
                i = i + 1;
            } else {
                var c = 0;
                while (c < C) {
                    var idx = i + c * CELT_NB_EBANDS;
                    var q2 = ec_dec_bits(ec, extra);
                    # offset = (q2+0.5)/(1<<extra) - 0.5   (prev==0 factor is 1.0)
                    var num = f64_add(f64_from(q2), F64_HALF);
                    var den = f64_from(1 << extra);
                    var offset = f64_sub(f64_div(num, den), F64_HALF);
                    store64(oldEBands + idx * 8, f64_add(load64(oldEBands + idx * 8), offset));
                    c = c + 1;
                }
                i = i + 1;
            }
        }
    }
    return 0;
}

# unquant_energy_finalise: use leftover bits, 1 per (band,ch), two priority passes.
fn celt_unquant_energy_finalise(oldEBands, fine_quant, fine_priority, bits_left, ec, C, start, end) {
    var prio = 0;
    while (prio < 2) {
        var i = start;
        while ((i < end) & (bits_left >= C)) {
            var fq = load64(fine_quant + i * 8);
            if ((fq >= CELT_MAX_FINE_BITS) | (load64(fine_priority + i * 8) != prio)) {
                i = i + 1;
            } else {
                var c = 0;
                while (c < C) {
                    var idx = i + c * CELT_NB_EBANDS;
                    var q2 = ec_dec_bits(ec, 1);
                    # offset = (q2-0.5)/(1<<(fq+1))
                    var den = f64_from(1 << (fq + 1));
                    var offset = f64_div(f64_sub(f64_from(q2), F64_HALF), den);
                    store64(oldEBands + idx * 8, f64_add(load64(oldEBands + idx * 8), offset));
                    bits_left = bits_left - 1;
                    c = c + 1;
                }
                i = i + 1;
            }
        }
        prio = prio + 1;
    }
    return 0;
}

# ================================================================
# CELT band-energy ENCODE (quant_bands.c) — inverse of the unquant path above.
# ================================================================
# quant_coarse_energy_impl: encode target log-energies eBands[] with intra/inter prediction
# + Laplace coding, updating oldEBands in place and writing the residual to error[]. Mirrors
# celt_unquant_coarse_energy exactly. Returns "badness" (sum of clamp adjustments).
fn quant_coarse_energy_impl(start, end, eBands, oldEBands, budget, prob, error, enc, C, LM, intra, max_decay) {
    var badness = 0;
    var coef = F64_ZERO;
    var beta = CELT_BETA_INTRA;
    if (intra == 0) {
        coef = CELT_PRED_COEF3; beta = CELT_BETA_COEF3;
        if (LM == 2) { coef = CELT_PRED_COEF2; beta = CELT_BETA_COEF2; }
    }
    if (ec_tell(enc) + 3 <= budget) { ec_enc_bit_logp(enc, intra, 3); }
    var prev0 = F64_ZERO;
    var prev1 = F64_ZERO;
    var neg9 = f64_neg(f64_from(9));
    var neg28 = f64_neg(f64_from(28));
    var i = start;
    while (i < end) {
        var c = 0;
        while (c < C) {
            var idx = i + c * CELT_NB_EBANDS;
            var prevc = prev0;
            if (c == 1) { prevc = prev1; }
            var x = load64(eBands + idx * 8);
            var oldEraw = load64(oldEBands + idx * 8);
            var oldE = f64_max(neg9, oldEraw);
            var f = f64_sub(f64_sub(x, f64_mul(coef, oldE)), prevc);
            # qi = floor(0.5 + f)
            var yv = f64_add(f, F64_HALF);
            var qi = f64_to(yv);
            if (f64_lt(yv, f64_from(qi)) == 1) { qi = qi - 1; }
            # prevent energy dropping too fast
            var decay_bound = f64_sub(f64_max(neg28, oldEraw), max_decay);
            if ((qi < 0) & (f64_lt(x, decay_bound) == 1)) {
                qi = qi + f64_to(f64_sub(decay_bound, x));
                if (qi > 0) { qi = 0; }
            }
            var qi0 = qi;
            var t2 = ec_tell(enc);
            var bits_left = budget - t2 - 3 * C * (end - i);
            if ((i != start) & (bits_left < 30)) {
                if ((bits_left < 24) & (qi > 1)) { qi = 1; }
                if ((bits_left < 16) & (qi < 0 - 1)) { qi = 0 - 1; }
            }
            if (budget - t2 >= 15) {
                var pi = 2 * i;                 # 2*min(i,20), i<21
                qi = ec_laplace_encode(enc, qi, load8(prob + pi) << 7, load8(prob + pi + 1) << 6);
            } else {
                if (budget - t2 >= 2) {
                    if (qi > 1) { qi = 1; }
                    if (qi < 0 - 1) { qi = 0 - 1; }
                    ec_enc_icdf(enc, (2 * qi) ^ (0 - (qi < 0)), _celt_small_en_icdf, 2);
                } else {
                    if (budget - t2 >= 1) {
                        if (qi > 0) { qi = 0; }
                        ec_enc_bit_logp(enc, 0 - qi, 1);
                    } else {
                        qi = 0 - 1;
                    }
                }
            }
            var q = f64_from(qi);
            store64(error + idx * 8, f64_sub(f, q));
            var d = qi0 - qi;
            if (d < 0) { d = 0 - d; }
            badness = badness + d;
            store64(oldEBands + idx * 8, f64_add(f64_add(f64_mul(coef, oldE), prevc), q));
            var np = f64_add(prevc, f64_sub(q, f64_mul(beta, q)));
            if (c == 1) { prev1 = np; } else { prev0 = np; }
            c = c + 1;
        }
        i = i + 1;
    }
    return badness;
}

# quant_coarse_energy: single-pass coarse-energy encode (choose intra via `force_intra` +
# the budget guard; select the per-(LM,intra) probability model). The full libopus 2-pass
# intra-vs-inter size race is a bit-allocation optimization on top of this and is a separate
# step — this pass already produces a correct, decodable stream. budget/max_decay per libopus.
fn quant_coarse_energy(start, end, eBands, oldEBands, error, enc, C, LM, force_intra, nbAvailableBytes) {
    if (_celt_eprob_inter == 0) { _celt_energy_tables_init(); }
    var budget = load64(enc + 8) * 8;
    var intra = force_intra;
    if (ec_tell(enc) + 3 > budget) { intra = 0; }
    var max_decay = f64_from(16);
    if (end - start > 10) {
        var md2 = f64_mul(f64_div(F64_ONE, f64_from(8)), f64_from(nbAvailableBytes));
        if (f64_lt(md2, max_decay) == 1) { max_decay = md2; }
    }
    var prob = _celt_eprob_inter;
    if (intra != 0) {
        prob = _celt_eprob_intra;
        if (LM == 2) { prob = _celt_eprob_intra2; }
    } else {
        if (LM == 2) { prob = _celt_eprob_inter2; }
    }
    quant_coarse_energy_impl(start, end, eBands, oldEBands, budget, prob, error, enc, C, LM, intra, max_decay);
    return intra;
}

# quant_fine_energy: encode the fine-resolution refinement bits (raw bits, prev=0 base path).
fn quant_fine_energy(oldEBands, error, fine_quant, enc, C, start, end) {
    var i = start;
    while (i < end) {
        var fq = load64(fine_quant + i * 8);
        if (fq <= 0) {
            i = i + 1;
        } else {
            if (ec_tell(enc) + C * fq > load64(enc + 8) * 8) {
                i = i + 1;
            } else {
                var extra = 1 << fq;
                var c = 0;
                while (c < C) {
                    var idx = i + c * CELT_NB_EBANDS;
                    # q2 = floor((error+0.5)*extra), clamped to [0, extra-1]
                    var q2 = f64_to(f64_mul(f64_add(load64(error + idx * 8), F64_HALF), f64_from(extra)));
                    if (q2 > extra - 1) { q2 = extra - 1; }
                    if (q2 < 0) { q2 = 0; }
                    ec_enc_bits(enc, q2, fq);
                    var offset = f64_sub(f64_div(f64_add(f64_from(q2), F64_HALF), f64_from(extra)), F64_HALF);
                    store64(oldEBands + idx * 8, f64_add(load64(oldEBands + idx * 8), offset));
                    store64(error + idx * 8, f64_sub(load64(error + idx * 8), offset));
                    c = c + 1;
                }
                i = i + 1;
            }
        }
    }
    return 0;
}

# quant_energy_finalise: spend the remaining bits, 1 per band per priority pass.
fn quant_energy_finalise(oldEBands, error, fine_quant, fine_priority, bits_left, enc, C, start, end) {
    var prio = 0;
    while (prio < 2) {
        var i = start;
        while ((i < end) & (bits_left >= C)) {
            var fq = load64(fine_quant + i * 8);
            if ((fq >= CELT_MAX_FINE_BITS) | (load64(fine_priority + i * 8) != prio)) {
                i = i + 1;
            } else {
                var c = 0;
                while (c < C) {
                    var idx = i + c * CELT_NB_EBANDS;
                    var q2 = 0;
                    if (f64_lt(load64(error + idx * 8), F64_ZERO) == 0) { q2 = 1; }
                    ec_enc_bits(enc, q2, 1);
                    var offset = f64_div(f64_sub(f64_from(q2), F64_HALF), f64_from(1 << (fq + 1)));
                    store64(oldEBands + idx * 8, f64_add(load64(oldEBands + idx * 8), offset));
                    store64(error + idx * 8, f64_sub(load64(error + idx * 8), offset));
                    bits_left = bits_left - 1;
                    c = c + 1;
                }
                i = i + 1;
            }
        }
        prio = prio + 1;
    }
    return 0;
}

