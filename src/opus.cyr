    test_group("opus: CELT decode -> PCM correlation vs ffmpeg");
    var st = celt_dec_state_new();
    var pcm = alloc(960 * 8);
    var thr = f64_div(f64_from(99), f64_from(100));
    # frame 0
    var f0_p = alloc(319);
    store8(f0_p + 0, 159); store8(f0_p + 1, 235); store8(f0_p + 2, 54); store8(f0_p + 3, 134); store8(f0_p + 4, 64); store8(f0_p + 5, 12); store8(f0_p + 6, 87); store8(f0_p + 7, 248); store8(f0_p + 8, 109); store8(f0_p + 9, 162); store8(f0_p + 10, 157); store8(f0_p + 11, 77); store8(f0_p + 12, 244); store8(f0_p + 13, 47);
