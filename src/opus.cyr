    store8(m1_p + 0, 154); store8(m1_p + 1, 249); store8(m1_p + 2, 82); store8(m1_p + 3, 78); store8(m1_p + 4, 96); store8(m1_p + 5, 170); store8(m1_p + 6, 224); store8(m1_p + 7, 187); store8(m1_p + 8, 19); store8(m1_p + 9, 227); store8(m1_p + 10, 125); store8(m1_p + 11, 18);
