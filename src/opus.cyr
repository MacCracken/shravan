# ================================================================
# CELT inverse MDCT + synthesis + de-emphasis (RFC 6716 §4.3.7) — mdct.c/celt_decoder.c
# ================================================================
# Float path: clt_mdct_backward as a direct O(N^2) DFT (correctness-first).
# trig[i]=cos(2*PI*(i+1/8)/N), N=1920>>shift; window[i]=sin(pi/2*sin(pi/2*(i+.5)/120)^2).

var _celt_window = 0;         # 120 f64
var _mdct_trig = 0;           # [4] ptr -> trig(N2) per shift
var _mdct_dc = 0;             # [4] ptr -> cos(2pi m/N4)
var _mdct_ds = 0;             # [4] ptr -> sin(2pi m/N4)
var F64_1E30INV = 0;          # VERY_SMALL 1e-30
var CELT_DEEMPH = 0;          # 0.8500061035

fn _celt_window_init() {
    _celt_window = alloc(120 * 8);
    var halfpi = f64_mul(F64_HALF, F64_PI);
    var i = 0;
    while (i < 120) {
        var inner = f64_sin(f64_mul(halfpi, f64_div(f64_add(f64_from(i), F64_HALF), f64_from(120))));
        var w = f64_sin(f64_mul(halfpi, f64_mul(inner, inner)));
        store64(_celt_window + i * 8, w);
        i = i + 1;
    }
    F64_1E30INV = f64_div(F64_ONE, f64_pow(f64_from(10), f64_from(30)));
    CELT_DEEMPH = f64_div(f64_from(27853), f64_from(32768));
    return 0;
}

fn _mdct_cache_init(shift) {
    if (_mdct_trig == 0) {
        _mdct_trig = alloc(4 * 8);
        _mdct_dc = alloc(4 * 8);
        _mdct_ds = alloc(4 * 8);
        var z = 0;
        while (z < 4) { store64(_mdct_trig + z * 8, 0); store64(_mdct_dc + z * 8, 0); store64(_mdct_ds + z * 8, 0); z = z + 1; }
    }
    if (_celt_window == 0) { _celt_window_init(); }
    if (load64(_mdct_trig + shift * 8) != 0) { return 0; }
    var N = 1920 >> shift;
    var N2 = N >> 1;
    var N4 = N >> 2;
    var twopi = f64_mul(F64_TWO, F64_PI);
    var eighth = f64_div(F64_ONE, f64_from(8));
    var tr = alloc(N2 * 8);
    var i = 0;
    while (i < N2) {
        store64(tr + i * 8, f64_cos(f64_div(f64_mul(twopi, f64_add(f64_from(i), eighth)), f64_from(N))));
        i = i + 1;
    }
    store64(_mdct_trig + shift * 8, tr);
    var dc = alloc(N4 * 8);
    var ds = alloc(N4 * 8);
    i = 0;
    while (i < N4) {
        var a = f64_div(f64_mul(twopi, f64_from(i)), f64_from(N4));
        store64(dc + i * 8, f64_cos(a));
        store64(ds + i * 8, f64_sin(a));
        i = i + 1;
    }
    store64(_mdct_dc + shift * 8, dc);
    store64(_mdct_ds + shift * 8, ds);
    return 0;
}

# clt_mdct_backward (float, direct DFT). in: MDCT coeffs (stride in_stride);
# out: writes out[0 .. N2+59], reading out[0..59] as prev overlap. overlap=120.
fn clt_mdct_backward(inp, in_stride, out, shift) {
    _mdct_cache_init(shift);
    var N = 1920 >> shift;
    var N2 = N >> 1;
    var N4 = N >> 2;
    var t = load64(_mdct_trig + shift * 8);
    var dc = load64(_mdct_dc + shift * 8);
    var ds = load64(_mdct_ds + shift * 8);
    var Cr = alloc(N4 * 8);
    var Ci = alloc(N4 * 8);
    var i = 0;
    while (i < N4) {
        var x1 = load64(inp + (2 * i * in_stride) * 8);
        var x2 = load64(inp + ((N2 - 1 - 2 * i) * in_stride) * 8);
        var ti = load64(t + i * 8);
        var tn = load64(t + (N4 + i) * 8);
        store64(Ci + i * 8, f64_add(f64_mul(x2, ti), f64_mul(x1, tn)));   # C[i].i = yr
        store64(Cr + i * 8, f64_sub(f64_mul(x1, ti), f64_mul(x2, tn)));   # C[i].r = yi
        i = i + 1;
    }
    # forward DFT: Fout[k] = sum_i C[i]*(cos(2pi ki/N4) - j sin)
    var Fr = alloc(N4 * 8);
    var Fi = alloc(N4 * 8);
    var k = 0;
    while (k < N4) {
        var sr = F64_ZERO;
        var si = F64_ZERO;
        i = 0;
        while (i < N4) {
            var m = (k * i) % N4;
            var cs = load64(dc + m * 8);
            var sn = load64(ds + m * 8);
            var cri = load64(Cr + i * 8);
            var cii = load64(Ci + i * 8);
            sr = f64_add(sr, f64_add(f64_mul(cri, cs), f64_mul(cii, sn)));
            si = f64_add(si, f64_sub(f64_mul(cii, cs), f64_mul(cri, sn)));
            i = i + 1;
        }
        store64(Fr + k * 8, sr);
        store64(Fi + k * 8, si);
        k = k + 1;
    }
    # post-rotate -> out[60 ..]
    var lim = (N4 + 1) >> 1;
    i = 0;
    while (i < lim) {
        var re = load64(Fi + i * 8);
        var im = load64(Fr + i * 8);
        var t0 = load64(t + i * 8);
        var t1 = load64(t + (N4 + i) * 8);
        var yr = f64_add(f64_mul(re, t0), f64_mul(im, t1));
        var yi = f64_sub(f64_mul(re, t1), f64_mul(im, t0));
        var re2 = load64(Fi + (N4 - 1 - i) * 8);
        var im2 = load64(Fr + (N4 - 1 - i) * 8);
        var t0b = load64(t + (N4 - i - 1) * 8);
        var t1b = load64(t + (N2 - i - 1) * 8);
        var yr2 = f64_add(f64_mul(re2, t0b), f64_mul(im2, t1b));
        var yi2 = f64_sub(f64_mul(re2, t1b), f64_mul(im2, t0b));
        store64(out + (60 + 2 * i) * 8, yr);
        store64(out + (60 + N2 - 1 - 2 * i) * 8, yi);
        store64(out + (60 + N2 - 2 - 2 * i) * 8, yr2);
        store64(out + (60 + 2 * i + 1) * 8, yi2);
        i = i + 1;
    }
    # mirror / TDAC on out[0..119]
    var w = _celt_window;
    i = 0;
    while (i < 60) {
        var x1 = load64(out + (119 - i) * 8);
        var x2 = load64(out + i * 8);
        var wlo = load64(w + i * 8);
        var whi = load64(w + (119 - i) * 8);
        store64(out + i * 8, f64_sub(f64_mul(x2, whi), f64_mul(x1, wlo)));
        store64(out + (119 - i) * 8, f64_add(f64_mul(x2, wlo), f64_mul(x1, whi)));
        i = i + 1;
    }
    return 0;
}

# celt_synthesis: per channel denormalise + IMDCT into decode_mem+1088.
fn celt_synthesis(X, dm0, dm1, oldBandE, C, isTransient, silence) {
    var N = 960;
    var B = 1;
    var NB = 960;
    var shift = 0;
    if (isTransient != 0) { B = 8; NB = 120; shift = 3; }
    var freq = alloc(N * 8);
    var c = 0;
    while (c < C) {
        var Xc = X + c * N * 8;
        var dm = dm0;
        if (c == 1) { dm = dm1; }
        var os = dm + 1088 * 8;
        denormalise_bands(Xc, freq, oldBandE + c * 21 * 8, silence);
        var b = 0;
        while (b < B) {
            clt_mdct_backward(freq + b * 8, B, os + NB * b * 8, shift);
            b = b + 1;
        }
        c = c + 1;
    }
    return 0;
}


# anti_collapse (bands.c:259) — refill collapsed short blocks with scaled noise.
fn anti_collapse(X, collapse_masks, C, size, logE, prevLogE, prevLogE2, pulses, seed_ptr) {
    var LM = 3;
    var i = 0;
    while (i < 21) {
        var eb0 = load64(_celt_eBands + i * 8);
        var eb1 = load64(_celt_eBands + (i + 1) * 8);
        var N0 = eb1 - eb0;
        var depth = ((1 + load64(pulses + i * 8)) / N0) >> LM;
        var thresh = f64_mul(F64_HALF, _celt_exp2(f64_neg(f64_mul(f64_div(F64_ONE, f64_from(8)), f64_from(depth)))));
        var sqrt_1 = f64_div(F64_ONE, f64_sqrt(f64_from(N0 << LM)));
        var c = 0;
        while (c < C) {
            var prev1 = load64(prevLogE + (c * 21 + i) * 8);
            var prev2 = load64(prevLogE2 + (c * 21 + i) * 8);
            if (C == 1) {
                prev1 = f64_max(prev1, load64(prevLogE + (21 + i) * 8));
                prev2 = f64_max(prev2, load64(prevLogE2 + (21 + i) * 8));
            }
            var minp = prev1;
            if (f64_lt(prev2, prev1) == 1) { minp = prev2; }
            var Ediff = f64_sub(load64(logE + (c * 21 + i) * 8), minp);
            if (f64_lt(Ediff, F64_ZERO) == 1) { Ediff = F64_ZERO; }
            var r = f64_mul(F64_TWO, _celt_exp2(f64_neg(Ediff)));
            r = f64_mul(r, f64_div(f64_from(141421356), f64_from(100000000)));   # sqrt(2), LM==3
            if (f64_lt(thresh, r) == 1) { r = thresh; }
            r = f64_mul(r, sqrt_1);
            var Xc = X + (c * size + (eb0 << LM)) * 8;
            var renorm = 0;
            var kk = 0;
            while (kk < (1 << LM)) {
                if ((load8(collapse_masks + (i * C + c)) & (1 << kk)) == 0) {
                    var j = 0;
                    while (j < N0) {
                        var seed = celt_lcg_rand(load64(seed_ptr));
                        store64(seed_ptr, seed);
                        var val = r;
                        if ((seed & 0x8000) == 0) { val = f64_neg(r); }
                        store64(Xc + ((j << LM) + kk) * 8, val);
                        j = j + 1;
                    }
                    renorm = 1;
                }
                kk = kk + 1;
            }
            if (renorm != 0) { renormalise_vector(Xc, N0 << LM, F64_ONE); }
            c = c + 1;
        }
        i = i + 1;
    }
    return 0;
}

# deemphasis: out_syn -> interleaved pcm[j*CC+c], with persistent IIR memory.
fn celt_deemphasis(out_syn, pcm, c, CC, preemph_ptr) {
    var m = load64(preemph_ptr + c * 8);
    var j = 0;
    while (j < 960) {
        var tmp = f64_add(f64_add(load64(out_syn + j * 8), F64_1E30INV), m);
        m = f64_mul(CELT_DEEMPH, tmp);
        store64(pcm + (j * CC + c) * 8, f64_div(tmp, f64_from(32768)));
        j = j + 1;
    }
    store64(preemph_ptr + c * 8, m);
    return 0;
}

# ---- pitch post-filter (comb_filter) — celt.c float path ----
var _comb_gains = 0;   # gains[3][3]

fn _comb_gains_init() {
    _comb_gains = alloc(9 * 8);
    store64(_comb_gains + 0 * 8, f64_div(f64_from(10048), f64_from(32768)));  # .3066406250
    store64(_comb_gains + 1 * 8, f64_div(f64_from(7112),  f64_from(32768)));  # .2170410156
    store64(_comb_gains + 2 * 8, f64_div(f64_from(4248),  f64_from(32768)));  # .1296386719
    store64(_comb_gains + 3 * 8, f64_div(f64_from(15200), f64_from(32768)));  # .4638671875
    store64(_comb_gains + 4 * 8, f64_div(f64_from(8784),  f64_from(32768)));  # .2680664062
    store64(_comb_gains + 5 * 8, F64_ZERO);
    store64(_comb_gains + 6 * 8, f64_div(f64_from(26208), f64_from(32768)));  # .7998046875
    store64(_comb_gains + 7 * 8, f64_div(f64_from(3280),  f64_from(32768)));  # .1000976562
    store64(_comb_gains + 8 * 8, F64_ZERO);
    return 0;
}

fn comb_filter_const(y, x, T, N, g10, g11, g12) {
    var x4 = load64(x + (0 - T - 2) * 8);
    var x3 = load64(x + (0 - T - 1) * 8);
    var x2 = load64(x + (0 - T) * 8);
    var x1 = load64(x + (0 - T + 1) * 8);
    var i = 0;
    while (i < N) {
        var x0 = load64(x + (i - T + 2) * 8);
        var yv = f64_add(load64(x + i * 8),
            f64_add(f64_mul(g10, x2),
            f64_add(f64_mul(g11, f64_add(x1, x3)),
                    f64_mul(g12, f64_add(x0, x4)))));
        store64(y + i * 8, yv);
        x4 = x3; x3 = x2; x2 = x1; x1 = x0;
        i = i + 1;
    }
    return 0;
}

# comb_filter in-place (y==x): crossfade old->new params over `overlap`, then const.
fn comb_filter(y, x, T0, T1, N, g0, g1, tapset0, tapset1, overlap) {
    if (_comb_gains == 0) { _comb_gains_init(); }
    if ((g0 == F64_ZERO) & (g1 == F64_ZERO)) { return 0; }
    if (T0 < 15) { T0 = 15; }
    if (T1 < 15) { T1 = 15; }
    var g00 = f64_mul(g0, load64(_comb_gains + (tapset0 * 3 + 0) * 8));
    var g01 = f64_mul(g0, load64(_comb_gains + (tapset0 * 3 + 1) * 8));
    var g02 = f64_mul(g0, load64(_comb_gains + (tapset0 * 3 + 2) * 8));
    var g10 = f64_mul(g1, load64(_comb_gains + (tapset1 * 3 + 0) * 8));
    var g11 = f64_mul(g1, load64(_comb_gains + (tapset1 * 3 + 1) * 8));
    var g12 = f64_mul(g1, load64(_comb_gains + (tapset1 * 3 + 2) * 8));
    var x1 = load64(x + (0 - T1 + 1) * 8);
    var x2 = load64(x + (0 - T1) * 8);
    var x3 = load64(x + (0 - T1 - 1) * 8);
    var x4 = load64(x + (0 - T1 - 2) * 8);
    var ov = overlap;
    if ((g0 == g1) & (T0 == T1) & (tapset0 == tapset1)) { ov = 0; }
    var i = 0;
    while (i < ov) {
        var x0 = load64(x + (i - T1 + 2) * 8);
        var f = f64_mul(load64(_celt_window + i * 8), load64(_celt_window + i * 8));
        var omf = f64_sub(F64_ONE, f);
        var yv = f64_add(load64(x + i * 8),
            f64_add(f64_mul(f64_mul(omf, g00), load64(x + (i - T0) * 8)),
            f64_add(f64_mul(f64_mul(omf, g01), f64_add(load64(x + (i - T0 + 1) * 8), load64(x + (i - T0 - 1) * 8))),
            f64_add(f64_mul(f64_mul(omf, g02), f64_add(load64(x + (i - T0 + 2) * 8), load64(x + (i - T0 - 2) * 8))),
            f64_add(f64_mul(f64_mul(f, g10), x2),
            f64_add(f64_mul(f64_mul(f, g11), f64_add(x1, x3)),
                    f64_mul(f64_mul(f, g12), f64_add(x0, x4))))))));
        store64(y + i * 8, yv);
        x4 = x3; x3 = x2; x2 = x1; x1 = x0;
        i = i + 1;
    }
    if (g1 == F64_ZERO) { return 0; }
    comb_filter_const(y + i * 8, x + i * 8, T1, N - i, g10, g11, g12);
    return 0;
}


# ---- decoder state + full frame decode ----
# State: +0 oldBandE(42) +8 oldLogE(42) +16 oldLogE2(42) +24 dm0(2168) +32 dm1(2168)
#   +40 preemph(2) +48 rng +56 pf_period +64 pf_period_old +72 pf_gain +80 pf_gain_old
#   +88 pf_tapset +96 pf_tapset_old

fn celt_dec_state_new() {
    var st = alloc(112);
    var obe = alloc(42 * 8);
    var ole = alloc(42 * 8);
    var ol2 = alloc(42 * 8);
    var neg28 = f64_neg(f64_from(28));
    var i = 0;
    while (i < 42) {
        store64(obe + i * 8, F64_ZERO);
        store64(ole + i * 8, neg28);
        store64(ol2 + i * 8, neg28);
        i = i + 1;
    }
    var dm0 = alloc(2168 * 8);
    var dm1 = alloc(2168 * 8);
    i = 0;
    while (i < 2168) { store64(dm0 + i * 8, F64_ZERO); store64(dm1 + i * 8, F64_ZERO); i = i + 1; }
    var pre = alloc(2 * 8);
    store64(pre + 0, F64_ZERO);
    store64(pre + 8, F64_ZERO);
    store64(st + 0, obe);
    store64(st + 8, ole);
    store64(st + 16, ol2);
    store64(st + 24, dm0);
    store64(st + 32, dm1);
    store64(st + 40, pre);
    store64(st + 48, 0);
    store64(st + 56, 0);
    store64(st + 64, 0);
    store64(st + 72, F64_ZERO);
    store64(st + 80, F64_ZERO);
    store64(st + 88, 0);
    store64(st + 96, 0);
    return st;
}

fn celt_decode_frame(st, payload, len, C, pcm_out) {
    var oldBandE = load64(st + 0);
    var oldLogE = load64(st + 8);
    var oldLogE2 = load64(st + 16);
    var dm0 = load64(st + 24);
    var dm1 = load64(st + 32);
    var preemph = load64(st + 40);
    var N = 960;
    var M = 8;
    # R14 slide history: OPUS_MOVE(dm, dm+960, 1208)
    var c0 = 0;
    while (c0 < C) {
        var dm = dm0;
        if (c0 == 1) { dm = dm1; }
        var mi = 0;
        while (mi < 1208) { store64(dm + mi * 8, load64(dm + (mi + 960) * 8)); mi = mi + 1; }
        c0 = c0 + 1;
    }
    var tf = alloc(21 * 8);
    var off = alloc(21 * 8);
    var pul = alloc(21 * 8);
    var fq = alloc(21 * 8);
    var fp = alloc(21 * 8);
    var cap = alloc(21 * 8);
    var scal = alloc(16 * 8);
    var ec = celt_decode_frame_prefix(payload, len, C, oldBandE, tf, off, pul, fq, fp, cap, scal);
    var silence = load64(scal + 0);
    var isTransient = load64(scal + 8);
    var acr = load64(scal + 40);
    var pf_pitch = load64(scal + 80);
    var pf_tapset = load64(scal + 88);
    var pf_gain = load64(scal + 96);
    var X = alloc(C * N * 8);
    var z = 0;
    while (z < C * N) { store64(X + z * 8, F64_ZERO); z = z + 1; }
    var Y = 0;
    if (C == 2) { Y = X + N * 8; }
    var collapse = alloc(C * 21);
    var shortBlocks = 0;
    if (isTransient != 0) { shortBlocks = M; }
    var total_bits = len * 64 - acr;
    quant_all_bands(X, Y, collapse, pul, shortBlocks, load64(scal + 24), load64(scal + 64), load64(scal + 56), tf, total_bits, load64(scal + 72), ec, 3, load64(scal + 48), st + 48, 0, C);
    var anti_collapse_on = 0;
    if (acr > 0) { anti_collapse_on = ec_dec_bits(ec, 1); }
    celt_unquant_energy_finalise(oldBandE, fq, fp, len * 8 - ec_tell(ec), ec, C);
    if (anti_collapse_on != 0) {
        anti_collapse(X, collapse, C, N, oldBandE, oldLogE, oldLogE2, pul, st + 48);
    }
    if (silence != 0) {
        var s = 0;
        while (s < C * 21) { store64(oldBandE + s * 8, f64_neg(f64_from(28))); s = s + 1; }
    }
    celt_synthesis(X, dm0, dm1, oldBandE, C, isTransient, silence);
    # R22 postfilter (comb_filter) — in place on out_syn = dm+1088
    var pperiod = load64(st + 56);
    var pperiod_old = load64(st + 64);
    var pgain = load64(st + 72);
    var pgain_old = load64(st + 80);
    var ptap = load64(st + 88);
    var ptap_old = load64(st + 96);
    if (pperiod < 15) { pperiod = 15; }
    if (pperiod_old < 15) { pperiod_old = 15; }
    var c = 0;
    while (c < C) {
        var dm = dm0;
        if (c == 1) { dm = dm1; }
        var os = dm + 1088 * 8;
        comb_filter(os, os, pperiod_old, pperiod, 120, pgain_old, pgain, ptap_old, ptap, 120);
        comb_filter(os + 120 * 8, os + 120 * 8, pperiod, pf_pitch, N - 120, pgain, pf_gain, ptap, pf_tapset, 120);
        c = c + 1;
    }
    # de-emphasis -> pcm (out_syn = dm+1088)
    c = 0;
    while (c < C) {
        var dm2 = dm0;
        if (c == 1) { dm2 = dm1; }
        celt_deemphasis(dm2 + 1088 * 8, pcm_out, c, C, preemph);
        c = c + 1;
    }
    # R23 energy memory rotation
    if (C == 1) {
        var q = 0;
        while (q < 21) { store64(oldBandE + (21 + q) * 8, load64(oldBandE + q * 8)); q = q + 1; }
    }
    if (isTransient == 0) {
        var r = 0;
        while (r < 42) {
            store64(oldLogE2 + r * 8, load64(oldLogE + r * 8));
            store64(oldLogE + r * 8, load64(oldBandE + r * 8));
            r = r + 1;
        }
    } else {
        var r2 = 0;
        while (r2 < 42) {
            store64(oldLogE + r2 * 8, f64_min(load64(oldLogE + r2 * 8), load64(oldBandE + r2 * 8)));
            r2 = r2 + 1;
        }
    }
    # R24 persist rng
    store64(st + 48, load64(ec + 56));
    # postfilter state rotation
    store64(st + 64, pperiod);
    store64(st + 80, pgain);
    store64(st + 96, ptap);
    store64(st + 56, pf_pitch);
    store64(st + 72, pf_gain);
    store64(st + 88, pf_tapset);
    store64(st + 64, pf_pitch);
    store64(st + 80, pf_gain);
    store64(st + 96, pf_tapset);
    return 0;
}

fn _celt_corr(a, refs, n) {
    var dot = F64_ZERO; var na = F64_ZERO; var nb = F64_ZERO; var i = 0;
    while (i < n) {
        var av = load64(a + i * 8); var bv = f64_from(load64(refs + i * 8));
        dot = f64_add(dot, f64_mul(av, bv)); na = f64_add(na, f64_mul(av, av)); nb = f64_add(nb, f64_mul(bv, bv));
        i = i + 1;
    }
    var den = f64_mul(f64_sqrt(na), f64_sqrt(nb));
    if (f64_lt(den, f64_div(F64_ONE, f64_from(1000000))) == 1) { return F64_ONE; }
    return f64_div(dot, den);
}

