    store8(_celt_cacheCaps + 120, 188); store8(_celt_cacheCaps + 121, 188); store8(_celt_cacheCaps + 122, 176); store8(_celt_cacheCaps + 123, 141); store8(_celt_cacheCaps + 124, 66); store8(_celt_cacheCaps + 125, 40); store8(_celt_cacheCaps + 126, 193); store8(_celt_cacheCaps + 127, 193); store8(_celt_cacheCaps + 128, 193); store8(_celt_cacheCaps + 129, 193);
    store8(_celt_cacheCaps + 130, 193); store8(_celt_cacheCaps + 131, 193); store8(_celt_cacheCaps + 132, 193); store8(_celt_cacheCaps + 133, 193); store8(_celt_cacheCaps + 134, 193); store8(_celt_cacheCaps + 135, 193); store8(_celt_cacheCaps + 136, 193); store8(_celt_cacheCaps + 137, 193); store8(_celt_cacheCaps + 138, 194); store8(_celt_cacheCaps + 139, 194);
    store8(_celt_cacheCaps + 140, 194); store8(_celt_cacheCaps + 141, 184); store8(_celt_cacheCaps + 142, 184); store8(_celt_cacheCaps + 143, 173); store8(_celt_cacheCaps + 144, 139); store8(_celt_cacheCaps + 145, 65); store8(_celt_cacheCaps + 146, 39); store8(_celt_cacheCaps + 147, 204); store8(_celt_cacheCaps + 148, 204); store8(_celt_cacheCaps + 149, 204);
    store8(_celt_cacheCaps + 150, 204); store8(_celt_cacheCaps + 151, 204); store8(_celt_cacheCaps + 152, 204); store8(_celt_cacheCaps + 153, 204); store8(_celt_cacheCaps + 154, 204); store8(_celt_cacheCaps + 155, 201); store8(_celt_cacheCaps + 156, 201); store8(_celt_cacheCaps + 157, 201); store8(_celt_cacheCaps + 158, 201); store8(_celt_cacheCaps + 159, 198);
    store8(_celt_cacheCaps + 160, 198); store8(_celt_cacheCaps + 161, 198); store8(_celt_cacheCaps + 162, 187); store8(_celt_cacheCaps + 163, 187); store8(_celt_cacheCaps + 164, 175); store8(_celt_cacheCaps + 165, 140); store8(_celt_cacheCaps + 166, 66); store8(_celt_cacheCaps + 167, 40);
    _celt_trimIcdf = alloc(11);
    store8(_celt_trimIcdf + 0, 126); store8(_celt_trimIcdf + 1, 124); store8(_celt_trimIcdf + 2, 119); store8(_celt_trimIcdf + 3, 109); store8(_celt_trimIcdf + 4, 87); store8(_celt_trimIcdf + 5, 41); store8(_celt_trimIcdf + 6, 19); store8(_celt_trimIcdf + 7, 9); store8(_celt_trimIcdf + 8, 4); store8(_celt_trimIcdf + 9, 2);
    store8(_celt_trimIcdf + 10, 0);
    _celt_spreadIcdf = alloc(4);
    store8(_celt_spreadIcdf + 0, 25); store8(_celt_spreadIcdf + 1, 23); store8(_celt_spreadIcdf + 2, 2); store8(_celt_spreadIcdf + 3, 0);
    _celt_tapsetIcdf = alloc(3);
    store8(_celt_tapsetIcdf + 0, 2); store8(_celt_tapsetIcdf + 1, 1); store8(_celt_tapsetIcdf + 2, 0);
    return 0;
}

# ================================================================
# CELT bit allocation (RFC 6716 §4.3.3) — port of rate.c + init_caps/tf_decode
# ================================================================
# All integer math in 1/8-bit units (BITRES=3). Signed arithmetic right shift is
# needed where the C uses `>>` on values that can go negative (trim/offset).

# Arithmetic (sign-preserving) right shift — Cyrius `>>` is logical.
fn sar(x, n) {
    if (x >= 0) { return x >> n; }
    var nx = 0 - x - 1;         # ~x for x<0 is non-negative
    return 0 - (nx >> n) - 1;   # ~((~x)>>n)
}

# get_pulses(i): pseudo-pulse index -> actual pulse count K (rate.h:48).
fn celt_get_pulses(i) {
    if (i < 8) { return i; }
    return (8 + (i & 7)) << ((i >> 3) - 1);
}

# bits2pulses(band, LM, bits) -> pseudo index (rate.h:53). NOTE bits-- first.
fn celt_bits2pulses(band, LM, bits) {
    var cache = _celt_cacheBits + load64(_celt_cacheIdx + ((LM + 1) * 21 + band) * 8);
    var lo = 0;
    var hi = load8(cache);
    bits = bits - 1;
    var i = 0;
    while (i < 6) {
        var mid = (lo + hi + 1) >> 1;
        if (load8(cache + mid) >= bits) { hi = mid; } else { lo = mid; }
        i = i + 1;
    }
    var loval = 0 - 1;
    if (lo != 0) { loval = load8(cache + lo); }
    if (bits - loval <= load8(cache + hi) - bits) { return lo; }
    return hi;
}

# pulses2bits(band, LM, pulses) -> whole bits (rate.h:80).
fn celt_pulses2bits(band, LM, pulses) {
    if (pulses == 0) { return 0; }
    var cache = _celt_cacheBits + load64(_celt_cacheIdx + ((LM + 1) * 21 + band) * 8);
    return load8(cache + pulses) + 1;
}

# init_caps: cap[i] = ((cache_caps[21*(2LM+C-1)+i]+64)*C*N) >> 2   (celt.c).
fn celt_init_caps(cap_out, LM, C) {
    var i = 0;
    while (i < 21) {
        var nn = (load64(_celt_eBands + (i + 1) * 8) - load64(_celt_eBands + i * 8)) << LM;
        var ci = 21 * (2 * LM + C - 1) + i;
        store64(cap_out + i * 8, ((load8(_celt_cacheCaps + ci) + 64) * C * nn) >> 2);
        i = i + 1;
    }
    return 0;
}

# tf_decode (celt_decoder.c:513). Fills tf_res[0..20] (signed tf_select_table vals).
fn celt_tf_decode(tf_res, isTransient, ec, start, end) {
    var budget = load64(ec + 8) * 8;
    var tell = ec_tell(ec);
    var logp = 4;
    if (isTransient != 0) { logp = 2; }
    var tf_select_rsv = 0;
    if (tell + logp + 1 <= budget) { tf_select_rsv = 1; }
    budget = budget - tf_select_rsv;
    var tf_changed = 0;
    var curr = 0;
    var i = start;
    while (i < end) {
        if (tell + logp <= budget) {
            curr = curr ^ ec_dec_bit_logp(ec, logp);
            tell = ec_tell(ec);
            tf_changed = tf_changed | curr;
        }
        store64(tf_res + i * 8, curr);
        logp = 5;
        if (isTransient != 0) { logp = 4; }
        i = i + 1;
    }
    var base = 4 * isTransient;
    var tf_select = 0;
    if (tf_select_rsv != 0) {
        if (load64(_celt_tfsel + (base + tf_changed) * 8) != load64(_celt_tfsel + (base + 2 + tf_changed) * 8)) {
            tf_select = ec_dec_bit_logp(ec, 1);
        }
    }
    i = start;
    while (i < end) {
        var idx = base + 2 * tf_select + load64(tf_res + i * 8);
        store64(tf_res + i * 8, load64(_celt_tfsel + idx * 8));
        i = i + 1;
    }
    return 0;
}

# celt_tf_encode (celt_encoder.c): encode per-band tf decisions (inverse of celt_tf_decode).
# tf_res[] holds the encoder's 0/1 tf-change decisions on input; on output it is remapped to
# the tf_select_table values (the tf_change the band coder uses), same as the decoder. Uses the
# LM=3 _celt_tfsel table (the CELT-only fullband 20ms encoder target).
fn celt_tf_encode(tf_res, isTransient, tf_select, ec, start, end) {
    var budget = load64(ec + 8) * 8;
    var tell = ec_tell(ec);
    var logp = 4;
    if (isTransient != 0) { logp = 2; }
    var tf_select_rsv = 0;
    if (tell + logp + 1 <= budget) { tf_select_rsv = 1; }
    budget = budget - tf_select_rsv;
    var tf_changed = 0;
    var curr = 0;
    var i = start;
    while (i < end) {
        if (tell + logp <= budget) {
            ec_enc_bit_logp(ec, load64(tf_res + i * 8) ^ curr, logp);
            tell = ec_tell(ec);
            curr = load64(tf_res + i * 8);
            tf_changed = tf_changed | curr;
        } else {
            store64(tf_res + i * 8, curr);
        }
        logp = 5;
        if (isTransient != 0) { logp = 4; }
        i = i + 1;
    }
    var base = 4 * isTransient;
    if (tf_select_rsv != 0) {
        if (load64(_celt_tfsel + (base + tf_changed) * 8) != load64(_celt_tfsel + (base + 2 + tf_changed) * 8)) {
            ec_enc_bit_logp(ec, tf_select, 1);
        } else {
            tf_select = 0;
        }
    }
    i = start;
    while (i < end) {
        var idx = base + 2 * tf_select + load64(tf_res + i * 8);
        store64(tf_res + i * 8, load64(_celt_tfsel + idx * 8));
        i = i + 1;
    }
    return 0;
}

# clt_compute_allocation + interp_bits2pulses (rate.c). start=0,end=21.
# Fills pulses[](1/8-bit shape budget), ebits[](fine bits), fine_priority[];
# writes *intensity_out,*dual_out,*balance_out; returns codedBands.
fn celt_compute_allocation(offsets, cap, alloc_trim, intensity_out, dual_out, total_in, balance_out, pulses, ebits, fine_priority, C, LM, ec, start, end) {
    var len = 21;
    var nbAllocVectors = 11;
    var total = total_in;
    if (total < 0) { total = 0; }
    var skip_start = start;
    var skip_rsv = 0;
    if (total >= 8) { skip_rsv = 8; }
    total = total - skip_rsv;
    var intensity_rsv = 0;
    var dual_stereo_rsv = 0;
    if (C == 2) {
        intensity_rsv = load64(_celt_log2frac + (end - start) * 8);
        if (intensity_rsv > total) {
            intensity_rsv = 0;
        } else {
            total = total - intensity_rsv;
            if (total >= 8) { dual_stereo_rsv = 8; }
            total = total - dual_stereo_rsv;
        }
    }
    var thresh = alloc(21 * 8);
    var trim_offset = alloc(21 * 8);
    var j = start;
    while (j < end) {
        var N0 = load64(_celt_eBands + (j + 1) * 8) - load64(_celt_eBands + j * 8);
        var th = (((3 * N0) << LM) << 3) >> 4;
        var cfloor = C << 3;
        if (th < cfloor) { th = cfloor; }
        store64(thresh + j * 8, th);
        var to = sar(C * N0 * (alloc_trim - 5 - LM) * (end - j - 1) * (1 << (LM + 3)), 6);
        if ((N0 << LM) == 1) { to = to - (C << 3); }
        store64(trim_offset + j * 8, to);
        j = j + 1;
    }
    # outer alloc-vector bisection
    var lo = 1;
    var hi = nbAllocVectors - 1;
    var cont = 1;
    while (cont == 1) {
        var mid = (lo + hi) >> 1;
        var done = 0;
        var psum = 0;
        var jj = end - 1;
        while (jj >= start) {
            var nb = load64(_celt_eBands + (jj + 1) * 8) - load64(_celt_eBands + jj * 8);
            var bj = ((C * nb * load8(_celt_allocVec + (mid * len + jj))) << LM) >> 2;
            if (bj > 0) {
                bj = bj + load64(trim_offset + jj * 8);
                if (bj < 0) { bj = 0; }
            }
            bj = bj + load64(offsets + jj * 8);
            if ((bj >= load64(thresh + jj * 8)) | (done == 1)) {
                done = 1;
                var cj = load64(cap + jj * 8);
                if (bj < cj) { psum = psum + bj; } else { psum = psum + cj; }
            } else {
                if (bj >= (C << 3)) { psum = psum + (C << 3); }
            }
            jj = jj - 1;
        }
        if (psum > total) { hi = mid - 1; } else { lo = mid + 1; }
        if (lo <= hi) { cont = 1; } else { cont = 0; }
    }
    hi = lo;
    lo = lo - 1;
    # bits1/bits2 endpoints
    var bits1 = alloc(21 * 8);
    var bits2 = alloc(21 * 8);
    j = start;
    while (j < end) {
        var nc = load64(_celt_eBands + (j + 1) * 8) - load64(_celt_eBands + j * 8);
        var b1 = ((C * nc * load8(_celt_allocVec + (lo * len + j))) << LM) >> 2;
        var b2 = 0;
        if (hi >= nbAllocVectors) {
            b2 = load64(cap + j * 8);
        } else {
            b2 = ((C * nc * load8(_celt_allocVec + (hi * len + j))) << LM) >> 2;
        }
        if (b1 > 0) { b1 = b1 + load64(trim_offset + j * 8); if (b1 < 0) { b1 = 0; } }
        if (b2 > 0) { b2 = b2 + load64(trim_offset + j * 8); if (b2 < 0) { b2 = 0; } }
        if (lo > 0) { b1 = b1 + load64(offsets + j * 8); }
        b2 = b2 + load64(offsets + j * 8);
        if (load64(offsets + j * 8) > 0) { skip_start = j; }
        b2 = b2 - b1;
        if (b2 < 0) { b2 = 0; }
        store64(bits1 + j * 8, b1);
        store64(bits2 + j * 8, b2);
        j = j + 1;
    }
    # interp_bits2pulses
    var alloc_floor = C << 3;
    var stereo = 0;
    if (C > 1) { stereo = 1; }
    var logM = LM << 3;
    var bits = alloc(21 * 8);
    var ilo = 0;
    var ihi = 64;
    var it = 0;
    while (it < 6) {
        var mid2 = (ilo + ihi) >> 1;
        var psum2 = 0;
        var done2 = 0;
        var jk = end - 1;
        while (jk >= start) {
            var tmp = load64(bits1 + jk * 8) + ((mid2 * load64(bits2 + jk * 8)) >> 6);
            if ((tmp >= load64(thresh + jk * 8)) | (done2 == 1)) {
                done2 = 1;
                var ck = load64(cap + jk * 8);
                if (tmp < ck) { psum2 = psum2 + tmp; } else { psum2 = psum2 + ck; }
            } else {
                if (tmp >= alloc_floor) { psum2 = psum2 + alloc_floor; }
            }
            jk = jk - 1;
        }
        if (psum2 > total) { ihi = mid2; } else { ilo = mid2; }
        it = it + 1;
    }
    var psum3 = 0;
    var done3 = 0;
    var jm = end - 1;
    while (jm >= start) {
        var tmp2 = load64(bits1 + jm * 8) + ((ilo * load64(bits2 + jm * 8)) >> 6);
        if ((tmp2 < load64(thresh + jm * 8)) & (done3 == 0)) {
            if (tmp2 >= alloc_floor) { tmp2 = alloc_floor; } else { tmp2 = 0; }
        } else {
            done3 = 1;
        }
        var cm = load64(cap + jm * 8);
        if (tmp2 > cm) { tmp2 = cm; }
        store64(bits + jm * 8, tmp2);
        psum3 = psum3 + tmp2;
        jm = jm - 1;
    }
    # skip loop (descending)
    var codedBands = end;
    var cont2 = 1;
    while (cont2 == 1) {
        var jb = codedBands - 1;
        if (jb <= skip_start) {
            total = total + skip_rsv;
            cont2 = 0;
        } else {
            var left = total - psum3;
            var span = load64(_celt_eBands + codedBands * 8) - load64(_celt_eBands + start * 8);
            var percoeff = left / span;
            left = left - span * percoeff;
            var rem = left - (load64(_celt_eBands + jb * 8) - load64(_celt_eBands + start * 8));
            if (rem < 0) { rem = 0; }
            var bw = load64(_celt_eBands + codedBands * 8) - load64(_celt_eBands + jb * 8);
            var band_bits = load64(bits + jb * 8) + percoeff * bw + rem;
            var thr = load64(thresh + jb * 8);
            var afl = alloc_floor + 8;
            if (afl > thr) { thr = afl; }
            var stop = 0;
            if (band_bits >= thr) {
                if (ec_dec_bit_logp(ec, 1) != 0) {
                    stop = 1;
                } else {
                    psum3 = psum3 + 8;
                    band_bits = band_bits - 8;
                }
            }
            if (stop == 1) {
                cont2 = 0;
            } else {
                psum3 = psum3 - (load64(bits + jb * 8) + intensity_rsv);
                if (intensity_rsv > 0) {
                    intensity_rsv = load64(_celt_log2frac + (jb - start) * 8);
                }
                psum3 = psum3 + intensity_rsv;
                if (band_bits >= alloc_floor) {
                    psum3 = psum3 + alloc_floor;
                    store64(bits + jb * 8, alloc_floor);
                } else {
                    store64(bits + jb * 8, 0);
                }
                codedBands = codedBands - 1;
            }
        }
    }
    # intensity + dual_stereo
    if (intensity_rsv > 0) {
        store64(intensity_out, start + ec_dec_uint(ec, codedBands + 1 - start));
    } else {
        store64(intensity_out, 0);
    }
    if (load64(intensity_out) <= start) {
        total = total + dual_stereo_rsv;
        dual_stereo_rsv = 0;
    }
    if (dual_stereo_rsv > 0) {
        store64(dual_out, ec_dec_bit_logp(ec, 1));
    } else {
        store64(dual_out, 0);
    }
    # distribute remaining
    var left2 = total - psum3;
    var span2 = load64(_celt_eBands + codedBands * 8) - load64(_celt_eBands + start * 8);
    var pc2 = left2 / span2;
    left2 = left2 - span2 * pc2;
    j = start;
    while (j < codedBands) {
        var w = load64(_celt_eBands + (j + 1) * 8) - load64(_celt_eBands + j * 8);
        store64(bits + j * 8, load64(bits + j * 8) + pc2 * w);
        j = j + 1;
    }
    j = start;
    while (j < codedBands) {
        var w2 = load64(_celt_eBands + (j + 1) * 8) - load64(_celt_eBands + j * 8);
        var t = left2;
        if (w2 < t) { t = w2; }
        store64(bits + j * 8, load64(bits + j * 8) + t);
        left2 = left2 - t;
        j = j + 1;
    }
    # fine/shape split
    var balance = 0;
    j = start;
    while (j < codedBands) {
        var nd = load64(_celt_eBands + (j + 1) * 8) - load64(_celt_eBands + j * 8);
        var nf = nd << LM;
        var bit = load64(bits + j * 8) + balance;
        var excess = 0;
        if (nf > 1) {
            excess = bit - load64(cap + j * 8);
            if (excess < 0) { excess = 0; }
            store64(bits + j * 8, bit - excess);
            var den = C * nf;
            if ((C == 2) & (nf > 2) & (load64(dual_out) == 0) & (j < load64(intensity_out))) {
                den = den + 1;
            }
            var nclogn = den * (load64(_celt_logN + j * 8) + logM);
            var offset = sar(nclogn, 1) - den * 21;
            if (nf == 2) { offset = offset + ((den << 3) >> 2); }
            var bjj = load64(bits + j * 8);
            if (bjj + offset < ((den * 2) << 3)) {
                offset = offset + sar(nclogn, 2);
            } else {
                if (bjj + offset < ((den * 3) << 3)) { offset = offset + sar(nclogn, 3); }
            }
            var eb = bjj + offset + (den << 2);
            if (eb < 0) { eb = 0; }
            eb = (eb / den) >> 3;
            if (C * eb > (bjj >> 3)) { eb = (bjj >> stereo) >> 3; }
            if (eb > 8) { eb = 8; }
            var fp = 0;
            if (eb * (den << 3) >= bjj + offset) { fp = 1; }
            store64(fine_priority + j * 8, fp);
            store64(ebits + j * 8, eb);
            store64(bits + j * 8, bjj - ((C * eb) << 3));
        } else {
            excess = bit - (C << 3);
            if (excess < 0) { excess = 0; }
            store64(bits + j * 8, bit - excess);
            store64(ebits + j * 8, 0);
            store64(fine_priority + j * 8, 1);
        }
        if (excess > 0) {
            var ef = excess >> (stereo + 3);
            var room = 8 - load64(ebits + j * 8);
            if (ef > room) { ef = room; }
            store64(ebits + j * 8, load64(ebits + j * 8) + ef);
            var extra_bits = (ef * C) << 3;
            var fp2 = 0;
            if (extra_bits >= excess - balance) { fp2 = 1; }
            store64(fine_priority + j * 8, fp2);
            excess = excess - extra_bits;
        }
        balance = excess;
        j = j + 1;
    }
    store64(balance_out, balance);
    # skipped bands
    j = codedBands;
    while (j < end) {
        store64(ebits + j * 8, (load64(bits + j * 8) >> stereo) >> 3);
        store64(bits + j * 8, 0);
        var fp3 = 0;
        if (load64(ebits + j * 8) < 1) { fp3 = 1; }
        store64(fine_priority + j * 8, fp3);
        j = j + 1;
    }
    # copy working bits -> pulses
    j = start;
    while (j < end) {
        store64(pulses + j * 8, load64(bits + j * 8));
        j = j + 1;
    }
    return codedBands;
}

# Front-of-frame decode (R1..R13): silence..postfilter..transient..intra..coarse
# ..tf..spread..caps..dynalloc..trim..allocation..fine. Fills oldBandE (persists),
# tf_res, offsets, pulses, fine_quant, fine_priority, cap; scal[0..9] gets the
# scalar results. Returns the ec_dec state (positioned at quant_all_bands).
# Payload wrapper: CELT-only fullband prefix (fresh ec, start=0, end=21).
fn celt_decode_frame_prefix(payload, len, C, oldBandE, tf_res, offsets, pulses, fine_quant, fine_priority, cap, scal) {
    return celt_decode_frame_prefix_ec(ec_dec_new(payload, len), len, C, 3, 0, 21, oldBandE, tf_res, offsets, pulses, fine_quant, fine_priority, cap, scal);
}

# ec-taking core: decode the CELT frame header (silence, postfilter, transient, intra,
# coarse+fine energy, tf, spread, dynalloc, allocation) over bands [start,end) from a
# caller-owned range decoder. Postfilter is only present when start==0 (hybrid skips it).
fn celt_decode_frame_prefix_ec(ec, len, C, LM, start, end, oldBandE, tf_res, offsets, pulses, fine_quant, fine_priority, cap, scal) {
    if (_celt_allocVec == 0) { _celt_alloc_tables_init(); }
    if (_celt_eprob_inter == 0) { _celt_energy_tables_init(); }
    var M = 1 << LM;
    var total_bits = len * 8;
    # [C==1] fold stored 2nd-channel energy into channel 0
    if (C == 1) {
        var f = 0;
        while (f < 21) {
            store64(oldBandE + f * 8, f64_max(load64(oldBandE + f * 8), load64(oldBandE + (21 + f) * 8)));
            f = f + 1;
        }
    }
    var tell = ec_tell(ec);
    # R1 silence
    var silence = 0;
    if (tell >= total_bits) { silence = 1; }
    else { if (tell == 1) { silence = ec_dec_bit_logp(ec, 15); } }
    if (silence != 0) {
        store64(ec + 40, load64(ec + 40) + (total_bits - ec_tell(ec)));
    }
    # R2 postfilter (parse only; params unused for allocation)
    var pf_pitch = 0;
    var pf_tapset = 0;
    var pf_gain = F64_ZERO;
    tell = ec_tell(ec);
    if ((start == 0) & (tell + 16 <= total_bits)) {
        if (ec_dec_bit_logp(ec, 1) != 0) {
            var octave = ec_dec_uint(ec, 6);
            pf_pitch = (16 << octave) + ec_dec_bits(ec, 4 + octave) - 1;
            var qg = ec_dec_bits(ec, 3);
            if (ec_tell(ec) + 2 <= total_bits) {
                pf_tapset = ec_dec_icdf(ec, _celt_tapsetIcdf, 2);
            }
            pf_gain = f64_mul(f64_div(f64_from(3), f64_from(32)), f64_from(qg + 1));
        }
    }
    # R3 transient
    tell = ec_tell(ec);
    var isTransient = 0;
    if (tell + 3 <= total_bits) { isTransient = ec_dec_bit_logp(ec, 3); }
    # R4 intra
    tell = ec_tell(ec);
    var intra = 0;
    if (tell + 3 <= total_bits) { intra = ec_dec_bit_logp(ec, 3); }
    # R5 coarse energy
    celt_unquant_coarse_energy(oldBandE, intra, ec, C, start, end, LM);
    # R6 tf_decode
    celt_tf_decode(tf_res, isTransient, ec, start, end);
    # R7 spread
    tell = ec_tell(ec);
    var spread = 2;
    if (tell + 4 <= total_bits) { spread = ec_dec_icdf(ec, _celt_spreadIcdf, 5); }
    # R8 caps
    celt_init_caps(cap, LM, C);
    # R9 dynalloc
    var dynalloc_logp = 6;
    var tb2 = total_bits << 3;
    tell = ec_tell_frac(ec);
    var i = start;
    while (i < end) {
        var width = (C * (load64(_celt_eBands + (i + 1) * 8) - load64(_celt_eBands + i * 8))) << LM;
        var q1 = width << 3;
        var q2m = 48;
        if (width > q2m) { q2m = width; }
        var quanta = q1;
        if (q2m < quanta) { quanta = q2m; }
        var dll = dynalloc_logp;
        var boost = 0;
        var loopc = 1;
        while (loopc == 1) {
            if ((tell + (dll << 3) < tb2) & (boost < load64(cap + i * 8))) {
                var flag = ec_dec_bit_logp(ec, dll);
                tell = ec_tell_frac(ec);
                if (flag == 0) {
                    loopc = 0;
                } else {
                    boost = boost + quanta;
                    tb2 = tb2 - quanta;
                    dll = 1;
                }
            } else {
                loopc = 0;
            }
        }
        store64(offsets + i * 8, boost);
        if (boost > 0) {
            dynalloc_logp = dynalloc_logp - 1;
            if (dynalloc_logp < 2) { dynalloc_logp = 2; }
        }
        i = i + 1;
    }
    # R10 alloc_trim
    var alloc_trim = 5;
    if (tell + 48 <= tb2) { alloc_trim = ec_dec_icdf(ec, _celt_trimIcdf, 7); }
    # R11 budget + anti-collapse reservation
    var bits = (total_bits << 3) - ec_tell_frac(ec) - 1;
    var acr = 0;
    if ((isTransient != 0) & (LM >= 2) & (bits >= ((LM + 2) << 3))) { acr = 8; }
    bits = bits - acr;
    # R12 allocation
    var intensity = alloc(8);
    var dual = alloc(8);
    var balance = alloc(8);
    var codedBands = celt_compute_allocation(offsets, cap, alloc_trim, intensity, dual, bits, balance, pulses, fine_quant, fine_priority, C, LM, ec, start, end);
    # R13 fine energy
    celt_unquant_fine_energy(oldBandE, fine_quant, ec, C, start, end);
    store64(scal + 0 * 8, silence);
    store64(scal + 1 * 8, isTransient);
    store64(scal + 2 * 8, intra);
    store64(scal + 3 * 8, spread);
    store64(scal + 4 * 8, alloc_trim);
    store64(scal + 5 * 8, acr);
    store64(scal + 6 * 8, codedBands);
    store64(scal + 7 * 8, load64(intensity));
    store64(scal + 8 * 8, load64(dual));
    store64(scal + 9 * 8, load64(balance));
    store64(scal + 10 * 8, pf_pitch);
    store64(scal + 11 * 8, pf_tapset);
    store64(scal + 12 * 8, pf_gain);
    return ec;
}



# ================================================================
# CELT CWRS: codeword index -> pulse vector (RFC 6716 §4.3.4) — cwrs.c port
# ================================================================
# U(N,K) counts sign-annotated pulse combos; V(N,K)=U(N,K)+U(N,K+1) is the range
# coder `ft`. Table U[row][col] built by the recurrence U(n,k)=U(n-1,k)+U(n,k-1)+
# U(n-1,k-1). Only rows 0..15 are needed (allocation guarantees the smaller of
# (N,K) is <=14 for any codeword that fits uint32); cells >= 2^32 are saturated so
# i64 never overflows (saturated cells are never used as a real `ft`).

var _celt_pvqU = 0;
var CELT_U_NC = 178;

fn _celt_pvq_u_init() {
    var NROW = 16;
    var NC = CELT_U_NC;
    var CAP = 4294967296;     # 2^32
    _celt_pvqU = alloc(NROW * NC * 8);
    var k = 0;
    while (k < NC) { store64(_celt_pvqU + (0 * NC + k) * 8, 0); k = k + 1; }
    store64(_celt_pvqU + 0, 1);              # U[0][0] = 1
    var n = 1;
    while (n < NROW) {
        store64(_celt_pvqU + (n * NC + 0) * 8, 0);   # U[n][0] = 0
        k = 1;
        while (k < NC) {
            var a = load64(_celt_pvqU + ((n - 1) * NC + k) * 8);
            var b = load64(_celt_pvqU + (n * NC + (k - 1)) * 8);
            var c = load64(_celt_pvqU + ((n - 1) * NC + (k - 1)) * 8);
            var v = a + b + c;
            if (v >= CAP) { v = CAP; }
            store64(_celt_pvqU + (n * NC + k) * 8, v);
            k = k + 1;
        }
        n = n + 1;
    }
    return 0;
}

# Direct row access U_ROW[a][b] (a<=15, b<=177).
fn _u(a, b) {
    return load64(_celt_pvqU + (a * CELT_U_NC + b) * 8);
}

# U(n,k) with symmetry U(n,k)=U(k,n): row=min, col=max.
fn celt_pvq_u(n, k) {
    if (_celt_pvqU == 0) { _celt_pvq_u_init(); }
    if (n <= k) { return _u(n, k); }
    return _u(k, n);
}

fn celt_pvq_v(n, k) {
    return celt_pvq_u(n, k) + celt_pvq_u(n, k + 1);
}

# cwrsi (cwrs.c:467): index i -> pulse vector y[0..n-1]; returns yy = sum(y[j]^2).
fn celt_cwrsi(n, k, i, y) {
    if (_celt_pvqU == 0) { _celt_pvq_u_init(); }
    var NC = CELT_U_NC;
    var yy = 0;
    var N = n;
    var K = k;
    var ii = i;
    var yp = 0;
    while (N > 2) {
        var val = 0;
        if (K >= N) {
            # lots of pulses: row = N (N<=14 here)
            var p = load64(_celt_pvqU + (N * NC + (K + 1)) * 8);
            var s = 0;
            if (ii >= p) { s = 0 - 1; ii = ii - (p & s); }
            var k0 = K;
            var q = load64(_celt_pvqU + (N * NC + N) * 8);
            if (q > ii) {
                K = N;
                var cont = 1;
                while (cont == 1) {
                    K = K - 1;
                    p = load64(_celt_pvqU + (K * NC + N) * 8);
                    if (p > ii) { cont = 1; } else { cont = 0; }
                }
            } else {
                p = load64(_celt_pvqU + (N * NC + K) * 8);
                while (p > ii) { K = K - 1; p = load64(_celt_pvqU + (N * NC + K) * 8); }
            }
            ii = ii - p;
            val = (k0 - K + s) ^ s;
        } else {
            # lots of dimensions: row = K (K<=14 here)
            var p = load64(_celt_pvqU + (K * NC + N) * 8);
            var q = load64(_celt_pvqU + ((K + 1) * NC + N) * 8);
            if ((p <= ii) & (ii < q)) {
                ii = ii - p;
                val = 0;
            } else {
                var s = 0;
                if (ii >= q) { s = 0 - 1; ii = ii - (q & s); }
                var k0 = K;
                var cont = 1;
                while (cont == 1) {
                    K = K - 1;
                    p = load64(_celt_pvqU + (K * NC + N) * 8);
                    if (p > ii) { cont = 1; } else { cont = 0; }
                }
                ii = ii - p;
                val = (k0 - K + s) ^ s;
            }
        }
        store64(y + yp * 8, val);
        yp = yp + 1;
        yy = yy + val * val;
        N = N - 1;
    }
    # N == 2
    var p2 = 2 * K + 1;
    var s2 = 0;
    if (ii >= p2) { s2 = 0 - 1; ii = ii - (p2 & s2); }
    var k02 = K;
    K = (ii + 1) >> 1;
    if (K != 0) { ii = ii - (2 * K - 1); }
    var val2 = (k02 - K + s2) ^ s2;
    store64(y + yp * 8, val2);
    yp = yp + 1;
    yy = yy + val2 * val2;
    # N == 1
    var s1 = 0 - ii;
    var val1 = (K + s1) ^ s1;
    store64(y + yp * 8, val1);
    yy = yy + val1 * val1;
    return yy;
}

# decode_pulses (cwrs.c:543): read codeword index, then cwrsi. Returns yy.
fn celt_decode_pulses(ec, n, k, y) {
    var v = celt_pvq_v(n, k);
    var i = ec_dec_uint(ec, v);
    return celt_cwrsi(n, k, i, y);
}


# ================================================================
# CELT bands / VQ (RFC 6716 §4.3.4) — bands.c + vq.c port (decode path)
# ================================================================
# Integer-exact pieces (bitexact_cos/log2tan, compute_qn, the recursion split
# bookkeeping, collapse masks, LCG) MUST match libopus or the range coder desyncs;
# the float pieces (normalise/rotation/denormalise/merge) only affect sample values.

var _celt_eMeans = 0;      # 21 f64
var _celt_spreadF = 0;     # {15,10,5}
var _celt_exp2_8 = 0;      # 8 int
var _celt_ordery = 0;      # ordery_table (offsets: stride-2)
var _celt_bitil = 0;       # bit_interleave_table[16]
var _celt_bitdeil = 0;     # bit_deinterleave_table[16]
var F64_SQRT1_2 = 0;       # 0.70710678

fn _celt_bands_tables_init() {
    var em = alloc(21 * 8);
    var m16 = alloc(21 * 8);
    store64(m16+0,103); store64(m16+8,100); store64(m16+16,92); store64(m16+24,85);
    store64(m16+32,81); store64(m16+40,77); store64(m16+48,72); store64(m16+56,70);
    store64(m16+64,78); store64(m16+72,75); store64(m16+80,73); store64(m16+88,71);
    store64(m16+96,78); store64(m16+104,74); store64(m16+112,69); store64(m16+120,72);
    store64(m16+128,70); store64(m16+136,74); store64(m16+144,76); store64(m16+152,71);
    store64(m16+160,60);
    var i = 0;
    while (i < 21) { store64(em + i * 8, f64_div(f64_from(load64(m16 + i * 8)), f64_from(16))); i = i + 1; }
    _celt_eMeans = em;
    _celt_spreadF = alloc(3 * 8);
    store64(_celt_spreadF + 0, 15); store64(_celt_spreadF + 8, 10); store64(_celt_spreadF + 16, 5);
    _celt_exp2_8 = alloc(8 * 8);
    store64(_celt_exp2_8+0,16384); store64(_celt_exp2_8+8,17866); store64(_celt_exp2_8+16,19483);
    store64(_celt_exp2_8+24,21247); store64(_celt_exp2_8+32,23170); store64(_celt_exp2_8+40,25267);
    store64(_celt_exp2_8+48,27554); store64(_celt_exp2_8+56,30048);
    _celt_ordery = alloc(30 * 8);
    var od = alloc(30 * 8);
    store64(od+0,1); store64(od+8,0);
    store64(od+16,3); store64(od+24,0); store64(od+32,2); store64(od+40,1);
    store64(od+48,7); store64(od+56,0); store64(od+64,4); store64(od+72,3); store64(od+80,6); store64(od+88,1); store64(od+96,5); store64(od+104,2);
    store64(od+112,15); store64(od+120,0); store64(od+128,8); store64(od+136,7); store64(od+144,12); store64(od+152,3); store64(od+160,11); store64(od+168,4);
    store64(od+176,14); store64(od+184,1); store64(od+192,9); store64(od+200,6); store64(od+208,13); store64(od+216,2); store64(od+224,10); store64(od+232,5);
    i = 0; while (i < 30) { store64(_celt_ordery + i * 8, load64(od + i * 8)); i = i + 1; }
    _celt_bitil = alloc(16);
    store8(_celt_bitil+0,0); store8(_celt_bitil+1,1); store8(_celt_bitil+2,1); store8(_celt_bitil+3,1);
    store8(_celt_bitil+4,2); store8(_celt_bitil+5,3); store8(_celt_bitil+6,3); store8(_celt_bitil+7,3);
    store8(_celt_bitil+8,2); store8(_celt_bitil+9,3); store8(_celt_bitil+10,3); store8(_celt_bitil+11,3);
    store8(_celt_bitil+12,2); store8(_celt_bitil+13,3); store8(_celt_bitil+14,3); store8(_celt_bitil+15,3);
    _celt_bitdeil = alloc(16);
    store8(_celt_bitdeil+0,0); store8(_celt_bitdeil+1,3); store8(_celt_bitdeil+2,12); store8(_celt_bitdeil+3,15);
    store8(_celt_bitdeil+4,48); store8(_celt_bitdeil+5,51); store8(_celt_bitdeil+6,60); store8(_celt_bitdeil+7,63);
    store8(_celt_bitdeil+8,192); store8(_celt_bitdeil+9,195); store8(_celt_bitdeil+10,204); store8(_celt_bitdeil+11,207);
    store8(_celt_bitdeil+12,240); store8(_celt_bitdeil+13,243); store8(_celt_bitdeil+14,252); store8(_celt_bitdeil+15,255);
    F64_SQRT1_2 = f64_div(f64_from(70710678), f64_from(100000000));
    return 0;
}

fn celt_lcg_rand(seed) {
    return (1664525 * seed + 1013904223) & 0xFFFFFFFF;
}

# sign-extend low 16 bits to signed
fn _i16(x) { return ((x & 0xFFFF) ^ 0x8000) - 0x8000; }

fn frac_mul16(a, b) {
    return sar(16384 + _i16(a) * _i16(b), 15);
}

fn bitexact_cos(x) {
    var tmp = (4096 + x * x) >> 13;
    var x2 = _i16(tmp);
    var inner = 8277 + frac_mul16(0 - 626, x2);
    inner = (0 - 7651) + frac_mul16(x2, inner);
    x2 = (32767 - x2) + frac_mul16(x2, inner);
    return 1 + x2;
}

fn bitexact_log2tan(isin, icos) {
    var lc = ec_ilog(icos);
    var ls = ec_ilog(isin);
    icos = icos << (15 - lc);
    isin = isin << (15 - ls);
    return (ls - lc) * 2048
         + frac_mul16(isin, frac_mul16(isin, 0 - 2597) + 7932)
         - frac_mul16(icos, frac_mul16(icos, 0 - 2597) + 7932);
}

# isqrt32: floor(sqrt(v)) for v>=0 (exact).
fn isqrt32(v) {
    if (v <= 0) { return 0; }
    var r = 0;
    var b = 1;
    while (b * 4 <= v) { b = b * 4; }
    var x = v;
    while (b != 0) {
        if (x >= r + b) {
            x = x - (r + b);
            r = (r >> 1) + b;
        } else {
            r = r >> 1;
        }
        b = b >> 2;
    }
    return r;
}

fn compute_qn(N, b, offset, pulse_cap, stereo) {
    var N2 = 2 * N - 1;
    if ((stereo != 0) & (N == 2)) { N2 = N2 - 1; }
    # celt_sudiv(b + N2*offset, N2) — signed truncating division
    var num = b + N2 * offset;
    var qb = 0;
    if (num >= 0) { qb = num / N2; } else { qb = 0 - ((0 - num) / N2); }
    var lim = b - pulse_cap - 32;
    if (lim < qb) { qb = lim; }
    if (64 < qb) { qb = 64; }
    var qn = 1;
    if (qb >= 4) {
        qn = load64(_celt_exp2_8 + (qb & 7) * 8) >> (14 - (qb >> 3));
        qn = ((qn + 1) >> 1) << 1;
    }
    return qn;
}

# 2^x for f64 x
fn _celt_exp2(x) { return f64_pow(F64_TWO, x); }

# normalise_residual: X[i] = iy[i] * gain / sqrt(Ryy)   (float path)
fn normalise_residual(iy, X, N, ryy, gain) {
    var g = f64_div(gain, f64_sqrt(f64_from(ryy)));
    var i = 0;
    while (i < N) {
        store64(X + i * 8, f64_mul(f64_from(load64(iy + i * 8)), g));
        i = i + 1;
    }
    return 0;
}

fn exp_rotation1(X, len, stride, c, s) {
    var ms = f64_neg(s);
    var i = 0;
    var lim = len - stride;
    while (i < lim) {
        var x1 = load64(X + i * 8);
        var x2 = load64(X + (i + stride) * 8);
        store64(X + (i + stride) * 8, f64_add(f64_mul(c, x2), f64_mul(s, x1)));
        store64(X + i * 8, f64_add(f64_mul(c, x1), f64_mul(ms, x2)));
        i = i + 1;
    }
    i = len - 2 * stride - 1;
    while (i >= 0) {
        var x1b = load64(X + i * 8);
        var x2b = load64(X + (i + stride) * 8);
        store64(X + (i + stride) * 8, f64_add(f64_mul(c, x2b), f64_mul(s, x1b)));
        store64(X + i * 8, f64_add(f64_mul(c, x1b), f64_mul(ms, x2b)));
        i = i - 1;
    }
    return 0;
}

# exp_rotation for decode (dir<0).
fn exp_rotation(X, len, stride, K, spread) {
    if ((2 * K >= len) | (spread == 0)) { return 0; }
    var factor = load64(_celt_spreadF + (spread - 1) * 8);
    var gain = f64_div(f64_from(len), f64_from(len + factor * K));
    var theta = f64_mul(F64_HALF, f64_mul(gain, gain));
    var halfpi = f64_mul(F64_HALF, F64_PI);
    var c = f64_cos(f64_mul(halfpi, theta));
    var s = f64_cos(f64_mul(halfpi, f64_sub(F64_ONE, theta)));
    var stride2 = 0;
    if (len >= 8 * stride) {
        stride2 = 1;
        while ((stride2 * stride2 + stride2) * stride + (stride >> 2) < len) { stride2 = stride2 + 1; }
    }
    var blocklen = len / stride;
    var b = 0;
    while (b < stride) {
        var Xb = X + b * blocklen * 8;
        if (stride2 != 0) { exp_rotation1(Xb, blocklen, stride2, s, c); }
        exp_rotation1(Xb, blocklen, 1, c, s);
        b = b + 1;
    }
    return 0;
}

fn renormalise_vector(X, N, gain) {
    var E = f64_div(f64_from(1), f64_from(1000000000000000));   # EPSILON 1e-15
    var i = 0;
    while (i < N) {
        var x = load64(X + i * 8);
        E = f64_add(E, f64_mul(x, x));
        i = i + 1;
    }
    var g = f64_div(gain, f64_sqrt(E));
    i = 0;
    while (i < N) { store64(X + i * 8, f64_mul(g, load64(X + i * 8))); i = i + 1; }
    return 0;
}

fn extract_collapse_mask(iy, N, B) {
    if (B <= 1) { return 1; }
    var N0 = N / B;
    var mask = 0;
    var i = 0;
    while (i < B) {
        var tmp = 0;
        var j = 0;
        while (j < N0) { tmp = tmp | load64(iy + (i * N0 + j) * 8); j = j + 1; }
        if (tmp != 0) { mask = mask | (1 << i); }
        i = i + 1;
    }
    return mask;
}

# ================================================================
# CELT PVQ ENCODE (vq.c / cwrs.c) — inverse of the decode path above.
# ================================================================
# exp_rotation forward (dir>=0): the encoder rotates INTO the search domain (angle-negated,
# reversed stage order vs the decode exp_rotation).
fn exp_rotation_enc(X, len, stride, K, spread) {
    if ((2 * K >= len) | (spread == 0)) { return 0; }
    if (_celt_spreadF == 0) { _celt_bands_tables_init(); }
    var factor = load64(_celt_spreadF + (spread - 1) * 8);
    var gain = f64_div(f64_from(len), f64_from(len + factor * K));
    var theta = f64_mul(F64_HALF, f64_mul(gain, gain));
    var halfpi = f64_mul(F64_HALF, F64_PI);
    var c = f64_cos(f64_mul(halfpi, theta));
    var s = f64_cos(f64_mul(halfpi, f64_sub(F64_ONE, theta)));
    var stride2 = 0;
    if (len >= 8 * stride) {
        stride2 = 1;
        while ((stride2 * stride2 + stride2) * stride + (stride >> 2) < len) { stride2 = stride2 + 1; }
    }
    var blocklen = len / stride;
    var ns = f64_neg(s);
    var nc = f64_neg(c);
    var b = 0;
    while (b < stride) {
        var Xb = X + b * blocklen * 8;
        exp_rotation1(Xb, blocklen, 1, c, ns);
        if (stride2 != 0) { exp_rotation1(Xb, blocklen, stride2, s, nc); }
        b = b + 1;
    }
    return 0;
}

# op_pvq_search (vq.c): find the K-pulse integer vector iy that best matches X (max
# Rxy^2/Ryy), via a projection pre-search (K>N/2) + greedy one-pulse-at-a-time refinement.
# X is overwritten with |X| (sign restored into iy). Returns yy = sum(iy^2).
fn op_pvq_search(X, iy, K, N) {
    var y = alloc(N * 8);
    var signx = alloc(N * 8);
    var j = 0;
    while (j < N) {
        var xj = load64(X + j * 8);
        var sg = 0;
        if (f64_lt(xj, F64_ZERO) == 1) { sg = 1; xj = f64_neg(xj); }
        store64(signx + j * 8, sg);
        store64(X + j * 8, xj);
        store64(iy + j * 8, 0);
        store64(y + j * 8, F64_ZERO);
        j = j + 1;
    }
    var xy = F64_ZERO;
    var yy = F64_ZERO;
    var pulsesLeft = K;
    if (K > (N >> 1)) {
        var sum = F64_ZERO;
        j = 0;
        while (j < N) { sum = f64_add(sum, load64(X + j * 8)); j = j + 1; }
        var ok = 0;
        if ((f64_gt(sum, F64_1E30INV) == 1) & (f64_lt(sum, f64_from(64)) == 1)) { ok = 1; }
        if (ok == 0) {
            store64(X + 0, F64_ONE);
            var jj = 1; while (jj < N) { store64(X + jj * 8, F64_ZERO); jj = jj + 1; }
            sum = F64_ONE;
        }
        var rcp = f64_div(f64_add(f64_from(K), f64_div(f64_from(8), f64_from(10))), sum);   # (K+0.8)/sum
        j = 0;
        while (j < N) {
            var xj = load64(X + j * 8);
            var iyj = f64_to(f64_mul(rcp, xj));    # floor (rcp*X >= 0)
            store64(iy + j * 8, iyj);
            var yj = f64_from(iyj);
            yy = f64_add(yy, f64_mul(yj, yj));
            xy = f64_add(xy, f64_mul(xj, yj));
            store64(y + j * 8, f64_mul(yj, F64_TWO));
            pulsesLeft = pulsesLeft - iyj;
            j = j + 1;
        }
    }
    if (pulsesLeft > N + 3) {
        var tmp = f64_from(pulsesLeft);
        yy = f64_add(yy, f64_mul(tmp, tmp));
        yy = f64_add(yy, f64_mul(tmp, load64(y + 0)));
        store64(iy + 0, load64(iy + 0) + pulsesLeft);
        pulsesLeft = 0;
    }
    var i = 0;
    while (i < pulsesLeft) {
        yy = f64_add(yy, F64_ONE);
        var best_id = 0;
        var Rxy0 = f64_add(xy, load64(X + 0));
        var Ryy0 = f64_add(yy, load64(y + 0));
        Rxy0 = f64_mul(Rxy0, Rxy0);
        var best_den = Ryy0;
        var best_num = Rxy0;
        j = 1;
        while (j < N) {
            var Rxyj = f64_add(xy, load64(X + j * 8));
            var Ryyj = f64_add(yy, load64(y + j * 8));
            Rxyj = f64_mul(Rxyj, Rxyj);
            if (f64_gt(f64_mul(best_den, Rxyj), f64_mul(Ryyj, best_num)) == 1) {
                best_den = Ryyj;
                best_num = Rxyj;
                best_id = j;
            }
            j = j + 1;
        }
        xy = f64_add(xy, load64(X + best_id * 8));
        yy = f64_add(yy, load64(y + best_id * 8));
        store64(y + best_id * 8, f64_add(load64(y + best_id * 8), F64_TWO));
        store64(iy + best_id * 8, load64(iy + best_id * 8) + 1);
        i = i + 1;
    }
    j = 0;
    while (j < N) {
        if (load64(signx + j * 8) == 1) { store64(iy + j * 8, 0 - load64(iy + j * 8)); }
        j = j + 1;
    }
    return f64_to(yy);   # yy is an exact integer (sum iy^2); return as int for normalise_residual
}

# icwrs (cwrs.c): pulse vector y -> combinatorial index (inverse of celt_cwrsi).
fn icwrs(n, y) {
    var j = n - 1;
    var yj = load64(y + j * 8);
    var i = 0;
    if (yj < 0) { i = 1; }
    var k = yj; if (k < 0) { k = 0 - k; }
    var cont = 1;
    while (cont == 1) {
        j = j - 1;
        i = i + celt_pvq_u(n - j, k);
        var yv = load64(y + j * 8);
        var av = yv; if (av < 0) { av = 0 - av; }
        k = k + av;
        if (yv < 0) { i = i + celt_pvq_u(n - j, k + 1); }
        if (j > 0) { cont = 1; } else { cont = 0; }
    }
    return i;
}

# celt_encode_pulses: encode the pulse vector index (inverse of celt_decode_pulses).
fn celt_encode_pulses(enc, n, k, y) {
    ec_enc_uint(enc, icwrs(n, y), celt_pvq_v(n, k));
    return 0;
}

# alg_quant (encode): rotate into search domain -> PVQ search -> encode pulses ->
# resynth the quantized unit shape into X (rotate back). Returns the collapse mask.
fn alg_quant(X, N, K, spread, B, enc, gain) {
    var iy = alloc((N + 3) * 8);
    exp_rotation_enc(X, N, B, K, spread);
    var yy = op_pvq_search(X, iy, K, N);
    var collapse_mask = extract_collapse_mask(iy, N, B);
    celt_encode_pulses(enc, N, K, iy);
    normalise_residual(iy, X, N, yy, gain);
    exp_rotation(X, N, B, K, spread);
    return collapse_mask;
}

# alg_unquant (decode): decode_pulses -> normalise -> rotation -> collapse mask.
fn alg_unquant(ec, X, N, K, spread, B, gain) {
    var iy = alloc(N * 8);
    var ryy = celt_decode_pulses(ec, N, K, iy);
    normalise_residual(iy, X, N, ryy, gain);
    exp_rotation(X, N, B, K, spread);
    return extract_collapse_mask(iy, N, B);
}

fn haar1(X, N0, stride) {
    var n0 = N0 >> 1;
    var i = 0;
    while (i < stride) {
        var j = 0;
        while (j < n0) {
            var a = load64(X + (stride * 2 * j + i) * 8);
            var bb = load64(X + (stride * (2 * j + 1) + i) * 8);
            var t1 = f64_mul(F64_SQRT1_2, a);
            var t2 = f64_mul(F64_SQRT1_2, bb);
            store64(X + (stride * 2 * j + i) * 8, f64_add(t1, t2));
            store64(X + (stride * (2 * j + 1) + i) * 8, f64_sub(t1, t2));
            j = j + 1;
        }
        i = i + 1;
    }
    return 0;
}

fn deinterleave_hadamard(X, N0, stride, hadamard) {
    var N = N0 * stride;
    var tmp = alloc(N * 8);
    if (hadamard != 0) {
        var ordery = _celt_ordery + (stride - 2) * 8;
        var i = 0;
        while (i < stride) {
            var oi = load64(ordery + i * 8);
            var j = 0;
            while (j < N0) {
                store64(tmp + (oi * N0 + j) * 8, load64(X + (j * stride + i) * 8));
                j = j + 1;
            }
            i = i + 1;
        }
    } else {
        var i2 = 0;
        while (i2 < stride) {
            var j2 = 0;
            while (j2 < N0) {
                store64(tmp + (i2 * N0 + j2) * 8, load64(X + (j2 * stride + i2) * 8));
                j2 = j2 + 1;
            }
            i2 = i2 + 1;
        }
    }
    var c = 0;
    while (c < N) { store64(X + c * 8, load64(tmp + c * 8)); c = c + 1; }
    return 0;
}

fn interleave_hadamard(X, N0, stride, hadamard) {
    var N = N0 * stride;
    var tmp = alloc(N * 8);
    if (hadamard != 0) {
        var ordery = _celt_ordery + (stride - 2) * 8;
        var i = 0;
        while (i < stride) {
            var oi = load64(ordery + i * 8);
            var j = 0;
            while (j < N0) {
                store64(tmp + (j * stride + i) * 8, load64(X + (oi * N0 + j) * 8));
                j = j + 1;
            }
            i = i + 1;
        }
    } else {
        var i2 = 0;
        while (i2 < stride) {
            var j2 = 0;
            while (j2 < N0) {
                store64(tmp + (j2 * stride + i2) * 8, load64(X + (i2 * N0 + j2) * 8));
                j2 = j2 + 1;
            }
            i2 = i2 + 1;
        }
    }
    var c = 0;
    while (c < N) { store64(X + c * 8, load64(tmp + c * 8)); c = c + 1; }
    return 0;
}

# stereo_merge (bands.c:418) — reconstruct L/R from mid(X)/side(Y).
fn stereo_merge(X, Y, mid, N) {
    var xp = F64_ZERO;
    var sside = F64_ZERO;
    var j = 0;
    while (j < N) {
        xp = f64_add(xp, f64_mul(load64(Y + j * 8), load64(X + j * 8)));
        sside = f64_add(sside, f64_mul(load64(Y + j * 8), load64(Y + j * 8)));
        j = j + 1;
    }
    xp = f64_mul(xp, mid);
    var mid2 = f64_mul(mid, mid);
    var El = f64_sub(f64_add(mid2, sside), f64_mul(F64_TWO, xp));
    var Er = f64_add(f64_add(mid2, sside), f64_mul(F64_TWO, xp));
    var thr = f64_div(f64_from(6), f64_from(10000));
    if ((f64_lt(Er, thr) == 1) | (f64_lt(El, thr) == 1)) {
        j = 0;
        while (j < N) { store64(Y + j * 8, load64(X + j * 8)); j = j + 1; }
        return 0;
    }
    var lgain = f64_div(F64_ONE, f64_sqrt(El));
    var rgain = f64_div(F64_ONE, f64_sqrt(Er));
    j = 0;
    while (j < N) {
        var l = f64_mul(mid, load64(X + j * 8));
        var r = load64(Y + j * 8);
        store64(X + j * 8, f64_mul(lgain, f64_sub(l, r)));
        store64(Y + j * 8, f64_mul(rgain, f64_add(l, r)));
        j = j + 1;
    }
    return 0;
}

# stereo_itheta (vq.c): the split angle in Q30 from the two sides' energies. Encoder-side —
# mono split uses X (first half) vs Y (second half); stereo uses (X+Y)/(X-Y). We use the
# exact atan2 (the decoder reconstructs from the *quantized* itheta, so bit-exactness of the
# pre-quant angle isn't required). itheta_q30 = round(2^30 * (2/pi)*atan2(side, mid)).
fn stereo_itheta(X, Y, stereo, N) {
    var Emid = F64_ZERO;
    var Eside = F64_ZERO;
    var i = 0;
    if (stereo != 0) {
        while (i < N) {
            var xi = load64(X + i * 8);
            var yi = load64(Y + i * 8);
            var m = f64_add(xi, yi);
            var s = f64_sub(xi, yi);
            Emid = f64_add(Emid, f64_mul(m, m));
            Eside = f64_add(Eside, f64_mul(s, s));
            i = i + 1;
        }
    } else {
        while (i < N) {
            var xi = load64(X + i * 8);
            Emid = f64_add(Emid, f64_mul(xi, xi));
            var yi = load64(Y + i * 8);
            Eside = f64_add(Eside, f64_mul(yi, yi));
            i = i + 1;
        }
    }
    var mid = f64_sqrt(Emid);
    var side = f64_sqrt(Eside);
    var norm = f64_mul(f64_atan2(side, mid), f64_div(F64_TWO, F64_PI));   # (2/pi)*atan2 in [0,1]
    var scaled = f64_mul(norm, f64_from(1073741824));                     # * 2^30
    return f64_to(f64_add(scaled, F64_HALF));                            # round; scaled>=0
}

# compute_theta (bands.c:700) — encode/decode the split angle, fill sctx[0..7]:
#  imid,iside,delta,itheta,qalloc,inv,new_b,new_fill. `encode` (ctx+72) selects direction;
#  X/Y supply the angle on encode. theta_round at ctx+80 (0 for CELT mono/decode).
fn compute_theta(ctx, X, Y, N, b, B, B0, LM, stereo, fill, sctx) {
    var ec = load64(ctx + 0);
    var ii = load64(ctx + 24);
    var intensity = load64(ctx + 48);
    var encode = load64(ctx + 72);
    var theta_round = load64(ctx + 80);
    var pulse_cap = load64(_celt_logN + ii * 8) + LM * 8;
    var qoff = 4;
    if ((stereo != 0) & (N == 2)) { qoff = 16; }
    var offset = (pulse_cap >> 1) - qoff;
    var qn = compute_qn(N, b, offset, pulse_cap, stereo);
    if ((stereo != 0) & (ii >= intensity)) { qn = 1; }
    var tell = ec_tell_frac(ec);
    var itheta = 0;
    if (encode != 0) { itheta = stereo_itheta(X, Y, stereo, N) >> 16; }
    var inv = 0;
    if (qn != 1) {
        if (encode != 0) {
            # quantize itheta (Q14 angle) to [0, qn]
            if ((stereo == 0) | (theta_round == 0)) {
                itheta = (itheta * qn + 8192) >> 14;
                if ((stereo == 0) & (load64(ctx + 64) != 0) & (itheta > 0) & (itheta < qn)) {
                    var unq = (itheta * 16384) / qn;
                    var im0 = bitexact_cos(unq);
                    var is0 = bitexact_cos(16384 - unq);
                    var dl0 = frac_mul16((N - 1) << 7, bitexact_log2tan(is0, im0));
                    if (dl0 > b) { itheta = qn; } else { if (dl0 < 0 - b) { itheta = 0; } }
                }
            } else {
                var bias = 0 - (32767 / qn);
                if (itheta > 8192) { bias = 32767 / qn; }
                var down = (itheta * qn + bias) >> 14;
                if (down < 0) { down = 0; }
                if (down > qn - 1) { down = qn - 1; }
                itheta = down;
                if (theta_round >= 0) { itheta = down + 1; }
            }
        }
        if ((stereo != 0) & (N > 2)) {
            var p0 = 3;
            var x0 = qn / 2;
            var ft = p0 * (x0 + 1) + x0;
            if (encode != 0) {
                var xe = itheta;
                var fle = 0; var fhe = 0;
                if (xe <= x0) { fle = p0 * xe; fhe = p0 * (xe + 1); }
                else { fle = (xe - 1 - x0) + (x0 + 1) * p0; fhe = (xe - x0) + (x0 + 1) * p0; }
                ec_encode(ec, fle, fhe, ft);
            } else {
                var fs = ec_decode(ec, ft);
                var x = 0;
                if (fs < (x0 + 1) * p0) { x = fs / p0; } else { x = x0 + 1 + (fs - (x0 + 1) * p0); }
                var fl = 0;
                var fh = 0;
                if (x <= x0) { fl = p0 * x; fh = p0 * (x + 1); }
                else { fl = (x - 1 - x0) + (x0 + 1) * p0; fh = (x - x0) + (x0 + 1) * p0; }
                ec_dec_update(ec, fl, fh, ft);
                itheta = x;
            }
        } else {
            if ((B0 > 1) | (stereo != 0)) {
                if (encode != 0) { ec_enc_uint(ec, itheta, qn + 1); }
                else { itheta = ec_dec_uint(ec, qn + 1); }
            } else {
                var ft2 = ((qn >> 1) + 1) * ((qn >> 1) + 1);
                if (encode != 0) {
                    var fse = 0; var fle2 = 0;
                    if (itheta <= (qn >> 1)) { fse = itheta + 1; fle2 = (itheta * (itheta + 1)) >> 1; }
                    else { fse = qn + 1 - itheta; fle2 = ft2 - (((qn + 1 - itheta) * (qn + 2 - itheta)) >> 1); }
                    ec_encode(ec, fle2, fle2 + fse, ft2);
                } else {
                    var fm = ec_decode(ec, ft2);
                    var fl2 = 0;
                    var fs2 = 0;
                    var thr = ((qn >> 1) * ((qn >> 1) + 1)) >> 1;
                    if (fm < thr) {
                        itheta = (isqrt32(8 * fm + 1) - 1) >> 1;
                        fs2 = itheta + 1;
                        fl2 = (itheta * (itheta + 1)) >> 1;
                    } else {
                        itheta = (2 * (qn + 1) - isqrt32(8 * (ft2 - fm - 1) + 1)) >> 1;
                        fs2 = qn + 1 - itheta;
                        fl2 = ft2 - (((qn + 1 - itheta) * (qn + 2 - itheta)) >> 1);
                    }
                    ec_dec_update(ec, fl2, fl2 + fs2, ft2);
                }
            }
        }
        itheta = (itheta * 16384) / qn;
    } else {
        if (stereo != 0) {
            if (encode != 0) {
                # stereo inv (side-inversion) encode is a follow-up; write inv=0 symmetrically.
                if ((b > 16) & (load64(ctx + 16) > 16) & (load64(ctx + 56) == 0)) { ec_enc_bit_logp(ec, 0, 2); }
                inv = 0;
            } else {
                if ((b > 16) & (load64(ctx + 16) > 16)) { inv = ec_dec_bit_logp(ec, 2); } else { inv = 0; }
                if (load64(ctx + 56) != 0) { inv = 0; }
            }
            itheta = 0;
        }
    }
    var qalloc = ec_tell_frac(ec) - tell;
    b = b - qalloc;
    var imid = 0;
    var iside = 0;
    var delta = 0;
    if (itheta == 0) {
        imid = 32767; iside = 0;
        fill = fill & ((1 << B) - 1);
        delta = 0 - 16384;
    } else {
        if (itheta == 16384) {
            imid = 0; iside = 32767;
            fill = fill & (((1 << B) - 1) << B);
            delta = 16384;
        } else {
            imid = bitexact_cos(itheta);
            iside = bitexact_cos(16384 - itheta);
            delta = frac_mul16((N - 1) << 7, bitexact_log2tan(iside, imid));
        }
    }
    store64(sctx + 0, imid);
    store64(sctx + 8, iside);
    store64(sctx + 16, delta);
    store64(sctx + 24, itheta);
    store64(sctx + 32, qalloc);
    store64(sctx + 40, inv);
    store64(sctx + 48, b);
    store64(sctx + 56, fill);
    return 0;
}

fn quant_band_n1(ctx, X, Y, lowband_out) {
    var ec = load64(ctx + 0);
    var stereo = 0;
    if (Y != 0) { stereo = 1; }
    var x = X;
    var c = 0;
    while (c < 1 + stereo) {
        var sign = 0;
        if (load64(ctx + 16) >= 8) {
            if (load64(ctx + 72) != 0) {
                if (f64_lt(load64(x + 0), F64_ZERO) == 1) { sign = 1; }
                ec_enc_bits(ec, sign, 1);
            } else {
                sign = ec_dec_bits(ec, 1);
            }
            store64(ctx + 16, load64(ctx + 16) - 8);
        }
        if (sign != 0) { store64(x + 0, f64_neg(F64_ONE)); } else { store64(x + 0, F64_ONE); }
        x = Y;
        c = c + 1;
    }
    if (lowband_out != 0) { store64(lowband_out + 0, load64(X + 0)); }
    return 1;
}

fn quant_partition(ctx, X, N, b, B, lowband, LM, gain, fill) {
    var ec = load64(ctx + 0);
    var ii = load64(ctx + 24);
    var spread = load64(ctx + 32);
    var B0 = B;
    var cm = 0;
    var cache = _celt_cacheBits + load64(_celt_cacheIdx + ((LM + 1) * 21 + ii) * 8);
    var cache0 = load8(cache);
    if ((LM != (0 - 1)) & (b > load8(cache + cache0) + 12) & (N > 2)) {
        var Nh = N >> 1;
        var Y = X + Nh * 8;
        var LMn = LM - 1;
        if (B == 1) { fill = (fill & 1) | (fill << 1); }
        var Bn = (B + 1) >> 1;
        var sctx = alloc(64);
        compute_theta(ctx, X, Y, Nh, b, Bn, B0, LMn, 0, fill, sctx);
        var imid = load64(sctx + 0);
        var iside = load64(sctx + 8);
        var delta = load64(sctx + 16);
        var itheta = load64(sctx + 24);
        b = load64(sctx + 48);
        fill = load64(sctx + 56);
        var mid = f64_div(f64_from(imid), f64_from(32768));
        var side = f64_div(f64_from(iside), f64_from(32768));
        if ((B0 > 1) & ((itheta & 0x3fff) != 0)) {
            if (itheta > 8192) { delta = delta - sar(delta, 4 - LMn); }
            else {
                var dd = delta + ((Nh << 3) >> (5 - LMn));
                if (dd > 0) { dd = 0; }
                delta = dd;
            }
        }
        var mbits = (b - delta) / 2;
        if (mbits > b) { mbits = b; }
        if (mbits < 0) { mbits = 0; }
        var sbits = b - mbits;
        store64(ctx + 16, load64(ctx + 16) - load64(sctx + 32));
        var next_lb = 0;
        if (lowband != 0) { next_lb = lowband + Nh * 8; }
        var rebalance = load64(ctx + 16);
        if (mbits >= sbits) {
            cm = quant_partition(ctx, X, Nh, mbits, Bn, lowband, LMn, f64_mul(gain, mid), fill);
            rebalance = mbits - (rebalance - load64(ctx + 16));
            if ((rebalance > 24) & (itheta != 0)) { sbits = sbits + rebalance - 24; }
            cm = cm | (quant_partition(ctx, Y, Nh, sbits, Bn, next_lb, LMn, f64_mul(gain, side), fill >> Bn) << (B0 >> 1));
        } else {
            cm = quant_partition(ctx, Y, Nh, sbits, Bn, next_lb, LMn, f64_mul(gain, side), fill >> Bn) << (B0 >> 1);
            rebalance = sbits - (rebalance - load64(ctx + 16));
            if ((rebalance > 24) & (itheta != 16384)) { mbits = mbits + rebalance - 24; }
            cm = cm | quant_partition(ctx, X, Nh, mbits, Bn, lowband, LMn, f64_mul(gain, mid), fill);
        }
    } else {
        var q = celt_bits2pulses(ii, LM, b);
        var curr_bits = celt_pulses2bits(ii, LM, q);
        store64(ctx + 16, load64(ctx + 16) - curr_bits);
        while ((load64(ctx + 16) < 0) & (q > 0)) {
            store64(ctx + 16, load64(ctx + 16) + curr_bits);
            q = q - 1;
            curr_bits = celt_pulses2bits(ii, LM, q);
            store64(ctx + 16, load64(ctx + 16) - curr_bits);
        }
        if (q != 0) {
            var K = celt_get_pulses(q);
            if (load64(ctx + 72) != 0) { cm = alg_quant(X, N, K, spread, B, ec, gain); }
            else { cm = alg_unquant(ec, X, N, K, spread, B, gain); }
        } else {
            var cm_mask = (1 << B) - 1;
            fill = fill & cm_mask;
            if (fill == 0) {
                var z = 0;
                while (z < N) { store64(X + z * 8, F64_ZERO); z = z + 1; }
                cm = 0;
            } else {
                if (lowband == 0) {
                    var j = 0;
                    while (j < N) {
                        var seed = celt_lcg_rand(load64(ctx + 8));
                        store64(ctx + 8, seed);
                        var sv = seed;
                        if (sv >= 2147483648) { sv = sv - 4294967296; }
                        store64(X + j * 8, f64_from(sar(sv, 20)));
                        j = j + 1;
                    }
                    cm = cm_mask;
                    renormalise_vector(X, N, gain);
                } else {
                    var tmpv = f64_div(F64_ONE, f64_from(256));
                    var j2 = 0;
                    while (j2 < N) {
                        var seed2 = celt_lcg_rand(load64(ctx + 8));
                        store64(ctx + 8, seed2);
                        var t = tmpv;
                        if ((seed2 & 0x8000) == 0) { t = f64_neg(tmpv); }
                        store64(X + j2 * 8, f64_add(load64(lowband + j2 * 8), t));
                        j2 = j2 + 1;
                    }
                    cm = fill;
                    renormalise_vector(X, N, gain);
                }
            }
        }
    }
    return cm;
}

fn quant_band(ctx, X, N, b, B, lowband, LM, lowband_out, gain, lowband_scratch, fill) {
    var tf_change = load64(ctx + 40);
    var encode = load64(ctx + 72);
    var N0 = N;
    var N_B = N;
    var B0 = B;
    var time_divide = 0;
    var recombine = 0;
    var longBlocks = 0;
    if (B0 == 1) { longBlocks = 1; }
    N_B = N_B / B;
    if (N == 1) { return quant_band_n1(ctx, X, 0, lowband_out); }
    if (tf_change > 0) { recombine = tf_change; }
    if ((lowband_scratch != 0) & (lowband != 0) & ((recombine != 0) | ((((N_B & 1) == 0) & (tf_change < 0)) != 0) | (B0 > 1))) {
        var cpi = 0;
        while (cpi < N) { store64(lowband_scratch + cpi * 8, load64(lowband + cpi * 8)); cpi = cpi + 1; }
        lowband = lowband_scratch;
    }
    var k = 0;
    while (k < recombine) {
        if (encode != 0) { haar1(X, N >> k, 1 << k); }
        if (lowband != 0) { haar1(lowband, N >> k, 1 << k); }
        fill = load8(_celt_bitil + (fill & 0xF)) | (load8(_celt_bitil + (fill >> 4)) << 2);
        k = k + 1;
    }
    B = B >> recombine;
    N_B = N_B << recombine;
    while (((N_B & 1) == 0) & (tf_change < 0)) {
        if (encode != 0) { haar1(X, N_B, B); }
        if (lowband != 0) { haar1(lowband, N_B, B); }
        fill = fill | (fill << B);
        B = B << 1;
        N_B = N_B >> 1;
        time_divide = time_divide + 1;
        tf_change = tf_change + 1;
    }
    B0 = B;
    var N_B0 = N_B;
    if (B0 > 1) {
        if (encode != 0) { deinterleave_hadamard(X, N_B >> recombine, B0 << recombine, longBlocks); }
        if (lowband != 0) { deinterleave_hadamard(lowband, N_B >> recombine, B0 << recombine, longBlocks); }
    }
    var cm = quant_partition(ctx, X, N, b, B, lowband, LM, gain, fill);
    if (B0 > 1) { interleave_hadamard(X, N_B >> recombine, B0 << recombine, longBlocks); }
    N_B = N_B0;
    B = B0;
    k = 0;
    while (k < time_divide) {
        B = B >> 1;
        N_B = N_B << 1;
        cm = cm | (cm >> B);
        haar1(X, N_B, B);
        k = k + 1;
    }
    k = 0;
    while (k < recombine) {
        cm = load8(_celt_bitdeil + cm);
        haar1(X, N0 >> k, 1 << k);
        k = k + 1;
    }
    B = B << recombine;
    if (lowband_out != 0) {
        var nn = f64_sqrt(f64_from(N0));
        var j = 0;
        while (j < N0) { store64(lowband_out + j * 8, f64_mul(nn, load64(X + j * 8))); j = j + 1; }
    }
    cm = cm & ((1 << B) - 1);
    return cm;
}

fn quant_band_stereo(ctx, X, Y, N, b, B, lowband, LM, lowband_out, lowband_scratch, fill) {
    var ec = load64(ctx + 0);
    if (N == 1) { return quant_band_n1(ctx, X, Y, lowband_out); }
    var orig_fill = fill;
    var sctx = alloc(64);
    compute_theta(ctx, X, Y, N, b, B, B, LM, 1, fill, sctx);
    var inv = load64(sctx + 40);
    var imid = load64(sctx + 0);
    var iside = load64(sctx + 8);
    var delta = load64(sctx + 16);
    var itheta = load64(sctx + 24);
    b = load64(sctx + 48);
    fill = load64(sctx + 56);
    var mid = f64_div(f64_from(imid), f64_from(32768));
    var side = f64_div(f64_from(iside), f64_from(32768));
    var cm = 0;
    if (N == 2) {
        var mbits = b;
        var sbits = 0;
        if ((itheta != 0) & (itheta != 16384)) { sbits = 8; }
        mbits = mbits - sbits;
        var cc = 0;
        if (itheta > 8192) { cc = 1; }
        store64(ctx + 16, load64(ctx + 16) - (load64(sctx + 32) + sbits));
        var x2 = X;
        var y2 = Y;
        if (cc != 0) { x2 = Y; y2 = X; }
        var sign = 0;
        if (sbits != 0) { sign = ec_dec_bits(ec, 1); }
        sign = 1 - 2 * sign;
        cm = quant_band(ctx, x2, N, mbits, B, lowband, LM, lowband_out, F64_ONE, lowband_scratch, orig_fill);
        store64(y2 + 0, f64_mul(f64_from(0 - sign), load64(x2 + 8)));
        store64(y2 + 8, f64_mul(f64_from(sign), load64(x2 + 0)));
        store64(X + 0, f64_mul(mid, load64(X + 0)));
        store64(X + 8, f64_mul(mid, load64(X + 8)));
        store64(Y + 0, f64_mul(side, load64(Y + 0)));
        store64(Y + 8, f64_mul(side, load64(Y + 8)));
        var t0 = load64(X + 0);
        store64(X + 0, f64_sub(t0, load64(Y + 0)));
        store64(Y + 0, f64_add(t0, load64(Y + 0)));
        var t1 = load64(X + 8);
        store64(X + 8, f64_sub(t1, load64(Y + 8)));
        store64(Y + 8, f64_add(t1, load64(Y + 8)));
    } else {
        var mbits = (b - delta) / 2;
        if (mbits > b) { mbits = b; }
        if (mbits < 0) { mbits = 0; }
        var sbits = b - mbits;
        store64(ctx + 16, load64(ctx + 16) - load64(sctx + 32));
        var rebalance = load64(ctx + 16);
        if (mbits >= sbits) {
            cm = quant_band(ctx, X, N, mbits, B, lowband, LM, lowband_out, F64_ONE, lowband_scratch, fill);
            rebalance = mbits - (rebalance - load64(ctx + 16));
            if ((rebalance > 24) & (itheta != 0)) { sbits = sbits + rebalance - 24; }
            cm = cm | quant_band(ctx, Y, N, sbits, B, 0, LM, 0, side, 0, fill >> B);
        } else {
            cm = quant_band(ctx, Y, N, sbits, B, 0, LM, 0, side, 0, fill >> B);
            rebalance = sbits - (rebalance - load64(ctx + 16));
            if ((rebalance > 24) & (itheta != 16384)) { mbits = mbits + rebalance - 24; }
            cm = cm | quant_band(ctx, X, N, mbits, B, lowband, LM, lowband_out, F64_ONE, lowband_scratch, fill);
        }
        stereo_merge(X, Y, mid, N);
        if (inv != 0) {
            var j = 0;
            while (j < N) { store64(Y + j * 8, f64_neg(load64(Y + j * 8))); j = j + 1; }
        }
    }
    return cm;
}

# quant_all_bands driver (decode). X_/Y_ byte pointers; collapse_masks byte array.
fn quant_all_bands(X_, Y_, collapse_masks, pulses, shortBlocks, spread, dual_stereo, intensity, tf_res, total_bits, balance, ec, LM, codedBands, seed_ptr, disable_inv, C, start, end) {
    if (_celt_eMeans == 0) { _celt_bands_tables_init(); }
    var M = 1 << LM;
    var Bf = 1;
    if (shortBlocks != 0) { Bf = M; }
    var normsz = M * load64(_celt_eBands + 20 * 8);
    var norm = alloc(C * normsz * 8);
    var norm2 = norm + normsz * 8;
    # norm is indexed absolutely (norm[M*eBands[i]]); norm_offset = M*eBands[start] is
    # the frequency of the first coded band, used to clamp the fold source so hybrid
    # (start=17) never folds from the un-decoded low region. Zero for config-31.
    var norm_offset = M * load64(_celt_eBands + start * 8);
    var lowband_scratch_base = X_ + M * load64(_celt_eBands + 20 * 8) * 8;
    var ctx = alloc(96);
    store64(ctx + 0, ec);
    store64(ctx + 8, load64(seed_ptr));
    store64(ctx + 32, spread);
    store64(ctx + 48, intensity);
    store64(ctx + 56, disable_inv);
    var avoid = 0;
    if (Bf > 1) { avoid = 1; }
    store64(ctx + 64, avoid);
    store64(ctx + 72, 0);   # encode = 0 (this is the decode path)
    store64(ctx + 80, 0);   # theta_round = 0
    var lowband_offset = 0;
    var update_lowband = 1;
    var i = start;
    while (i < end) {
        store64(ctx + 24, i);
        var last = 0;
        if (i == end - 1) { last = 1; }
        var Mei = M * load64(_celt_eBands + i * 8);
        var X = X_ + Mei * 8;
        var Y = 0;
        if (Y_ != 0) { Y = Y_ + Mei * 8; }
        var N = M * load64(_celt_eBands + (i + 1) * 8) - Mei;
        var tell = ec_tell_frac(ec);
        if (i != start) { balance = balance - tell; }
        var remaining_bits = total_bits - tell - 1;
        store64(ctx + 16, remaining_bits);
        var b = 0;
        if (i <= codedBands - 1) {
            var mn = codedBands - i;
            if (mn > 3) { mn = 3; }
            var curr_balance = balance / mn;
            if (balance < 0) { curr_balance = 0 - ((0 - balance) / mn); }
            b = load64(pulses + i * 8) + curr_balance;
            if (remaining_bits + 1 < b) { b = remaining_bits + 1; }
            if (16383 < b) { b = 16383; }
            if (b < 0) { b = 0; }
        }
        if ((Mei - N >= norm_offset) | (i == start + 1)) {
            if ((update_lowband != 0) | (lowband_offset == 0)) { lowband_offset = i; }
        }
        # special_hybrid_folding (bands.c:1579): at the 2nd coded band, duplicate enough of
        # the first band's fold data so the (wider) 2nd band can fold — hybrid has no lower
        # band to borrow from. norm is indexed absolutely here; libopus uses norm-relative,
        # so dst=M*eBands[start+1], src=norm_offset+2*n1-n2, len=n2-n1 (dst=src+len, no overlap).
        # For CELT-only (equal band widths at start) len=0 → no-op.
        if (i == start + 1) {
            var shf_n1 = M * (load64(_celt_eBands + (start + 1) * 8) - load64(_celt_eBands + start * 8));
            var shf_n2 = M * (load64(_celt_eBands + (start + 2) * 8) - load64(_celt_eBands + (start + 1) * 8));
            var shf_dst = M * load64(_celt_eBands + (start + 1) * 8);
            var shf_src = norm_offset + 2 * shf_n1 - shf_n2;
            var shf_len = shf_n2 - shf_n1;
            var shf_j = 0;
            while (shf_j < shf_len) {
                store64(norm + (shf_dst + shf_j) * 8, load64(norm + (shf_src + shf_j) * 8));
                if (dual_stereo != 0) { store64(norm2 + (shf_dst + shf_j) * 8, load64(norm2 + (shf_src + shf_j) * 8)); }
                shf_j = shf_j + 1;
            }
        }
        var tf_change = load64(tf_res + i * 8);
        store64(ctx + 40, tf_change);
        var lbscr = lowband_scratch_base;
        if (last != 0) { lbscr = 0; }
        var effective_lowband = 0 - 1;
        var x_cm = 0;
        var y_cm = 0;
        if ((lowband_offset != 0) & ((spread != 3) | (Bf > 1) | (tf_change < 0))) {
            effective_lowband = M * load64(_celt_eBands + lowband_offset * 8) - N;
            if (effective_lowband < norm_offset) { effective_lowband = norm_offset; }
            var fold_start = lowband_offset;
            var cs = 1;
            while (cs == 1) {
                fold_start = fold_start - 1;
                if (M * load64(_celt_eBands + fold_start * 8) > effective_lowband) { cs = 1; } else { cs = 0; }
            }
            var fold_end = lowband_offset - 1;
            var ce = 1;
            while (ce == 1) {
                fold_end = fold_end + 1;
                if ((fold_end < i) & (M * load64(_celt_eBands + fold_end * 8) < effective_lowband + N)) { ce = 1; } else { ce = 0; }
            }
            var fi = fold_start;
            var cf = 1;
            while (cf == 1) {
                x_cm = x_cm | load8(collapse_masks + (fi * C + 0));
                y_cm = y_cm | load8(collapse_masks + (fi * C + C - 1));
                fi = fi + 1;
                if (fi < fold_end) { cf = 1; } else { cf = 0; }
            }
        } else {
            x_cm = (1 << Bf) - 1;
            y_cm = (1 << Bf) - 1;
        }
        if ((dual_stereo != 0) & (i == intensity)) {
            dual_stereo = 0;
            var jj = 0;
            while (jj < Mei) {
                store64(norm + jj * 8, f64_mul(F64_HALF, f64_add(load64(norm + jj * 8), load64(norm2 + jj * 8))));
                jj = jj + 1;
            }
        }
        var lb = 0;
        if (effective_lowband != (0 - 1)) { lb = norm + effective_lowband * 8; }
        var out = 0;
        if (last == 0) { out = norm + Mei * 8; }
        if (dual_stereo != 0) {
            var lbx = 0;
            var lby = 0;
            if (effective_lowband != (0 - 1)) { lbx = norm + effective_lowband * 8; lby = norm2 + effective_lowband * 8; }
            var outx = 0;
            var outy = 0;
            if (last == 0) { outx = norm + Mei * 8; outy = norm2 + Mei * 8; }
            x_cm = quant_band(ctx, X, N, b / 2, Bf, lbx, LM, outx, F64_ONE, lbscr, x_cm);
            y_cm = quant_band(ctx, Y, N, b / 2, Bf, lby, LM, outy, F64_ONE, lbscr, y_cm);
        } else {
            if (Y != 0) {
                x_cm = quant_band_stereo(ctx, X, Y, N, b, Bf, lb, LM, out, lbscr, x_cm | y_cm);
                y_cm = x_cm;
            } else {
                x_cm = quant_band(ctx, X, N, b, Bf, lb, LM, out, F64_ONE, lbscr, x_cm | y_cm);
                y_cm = x_cm;
            }
        }
        store8(collapse_masks + (i * C + 0), x_cm & 0xFF);
        store8(collapse_masks + (i * C + C - 1), y_cm & 0xFF);
        balance = balance + load64(pulses + i * 8) + tell;
        update_lowband = 0;
        if (b > (N << 3)) { update_lowband = 1; }
        store64(ctx + 64, 0);
        i = i + 1;
    }
    store64(seed_ptr, load64(ctx + 8));
    return 0;
}

# compute_band_energies (bands.c, float path): bandE[i] = sqrt(1e-27 + sum X[j]^2)
# over each band — the L2 norm of the band's MDCT coefficients (encoder side).
fn compute_band_energies(X, bandE, end, C, LM) {
    if (_celt_eBands == 0) { _celt_alloc_tables_init(); }
    var M = 1 << LM;
    var N = 120 << LM;
    var eps = f64_mul(f64_div(F64_ONE, f64_from(1000000000)), f64_div(F64_ONE, f64_from(1000000000000000000)));  # 1e-27
    var c = 0;
    while (c < C) {
        var i = 0;
        while (i < end) {
            var j = M * load64(_celt_eBands + i * 8);
            var j1 = M * load64(_celt_eBands + (i + 1) * 8);
            var sum = eps;
            while (j < j1) {
                var x = load64(X + (c * N + j) * 8);
                sum = f64_add(sum, f64_mul(x, x));
                j = j + 1;
            }
            store64(bandE + (i + c * 21) * 8, f64_sqrt(sum));
            i = i + 1;
        }
        c = c + 1;
    }
    return 0;
}

# normalise_bands (bands.c, float path): X[j] = freq[j] / (1e-27 + bandE[i]) — the
# unit-norm spectral shape the PVQ then quantizes (inverse of denormalise_bands).
fn normalise_bands(freq, X, bandE, end, C, LM) {
    if (_celt_eBands == 0) { _celt_alloc_tables_init(); }
    var M = 1 << LM;
    var N = 120 << LM;
    var eps = f64_mul(f64_div(F64_ONE, f64_from(1000000000)), f64_div(F64_ONE, f64_from(1000000000000000000)));  # 1e-27
    var c = 0;
    while (c < C) {
        var i = 0;
        while (i < end) {
            var g = f64_div(F64_ONE, f64_add(eps, load64(bandE + (i + c * 21) * 8)));
            var j = M * load64(_celt_eBands + i * 8);
            var j1 = M * load64(_celt_eBands + (i + 1) * 8);
            while (j < j1) {
                store64(X + (c * N + j) * 8, f64_mul(load64(freq + (c * N + j) * 8), g));
                j = j + 1;
            }
            i = i + 1;
        }
        c = c + 1;
    }
    return 0;
}

# denormalise_bands (bands.c:188): freq[j] = X[j]*2^(bandLogE[i]+eMeans[i]).
fn denormalise_bands(X, freq, bandLogE, silence, start, end, LM) {
    var M = 1 << LM;
    var N = 120 << LM;
    var bound = M * load64(_celt_eBands + end * 8);
    if (silence != 0) { bound = 0; }
    # Zero bands below `start` (hybrid: CELT contributes nothing to the SILK-covered
    # low band). For config-31 (start=0) this loop is empty.
    var lo = M * load64(_celt_eBands + start * 8);
    if (silence != 0) { lo = 0; }
    var z0 = 0;
    while (z0 < lo) { store64(freq + z0 * 8, F64_ZERO); z0 = z0 + 1; }
    if (silence == 0) {
        var i = start;
        while (i < end) {
            var j = M * load64(_celt_eBands + i * 8);
            var band_end = M * load64(_celt_eBands + (i + 1) * 8);
            var lg = f64_add(load64(bandLogE + i * 8), load64(_celt_eMeans + i * 8));
            if (f64_gt(lg, f64_from(32)) == 1) { lg = f64_from(32); }
            var g = _celt_exp2(lg);
            while (j < band_end) {
                store64(freq + j * 8, f64_mul(load64(X + j * 8), g));
                j = j + 1;
            }
            i = i + 1;
        }
    }
    var z = bound;
    while (z < N) { store64(freq + z * 8, F64_ZERO); z = z + 1; }
    return 0;
}




# ================================================================
# CELT inverse MDCT + synthesis + de-emphasis (RFC 6716 §4.3.7) — mdct.c/celt_decoder.c
# ================================================================
# Float path: clt_mdct_backward as a direct O(N^2) DFT (correctness-first).
# trig[i]=cos(2*PI*(i+1/8)/N), N=1920>>shift; window[i]=sin(pi/2*sin(pi/2*(i+.5)/120)^2).

var _celt_window = 0;         # 120 f64
var _mdct_trig = 0;           # [4] ptr -> trig(N2) per shift
var _mdct_dc = 0;             # [4] ptr -> cos(2pi m/N4)
var _mdct_ds = 0;             # [4] ptr -> sin(2pi m/N4)
var F64_1E30INV = 0;          # VERY_SMALL 1e-30
var CELT_DEEMPH = 0;          # 0.8500061035

fn _celt_window_init() {
    _celt_window = alloc(120 * 8);
    var halfpi = f64_mul(F64_HALF, F64_PI);
    var i = 0;
    while (i < 120) {
        var inner = f64_sin(f64_mul(halfpi, f64_div(f64_add(f64_from(i), F64_HALF), f64_from(120))));
        var w = f64_sin(f64_mul(halfpi, f64_mul(inner, inner)));
        store64(_celt_window + i * 8, w);
        i = i + 1;
    }
    F64_1E30INV = f64_div(F64_ONE, f64_pow(f64_from(10), f64_from(30)));
    CELT_DEEMPH = f64_div(f64_from(27853), f64_from(32768));
    return 0;
}

fn _mdct_cache_init(shift) {
    if (_mdct_trig == 0) {
        _mdct_trig = alloc(4 * 8);
        _mdct_dc = alloc(4 * 8);
        _mdct_ds = alloc(4 * 8);
        var z = 0;
        while (z < 4) { store64(_mdct_trig + z * 8, 0); store64(_mdct_dc + z * 8, 0); store64(_mdct_ds + z * 8, 0); z = z + 1; }
    }
    if (_celt_window == 0) { _celt_window_init(); }
    if (load64(_mdct_trig + shift * 8) != 0) { return 0; }
    var N = 1920 >> shift;
    var N2 = N >> 1;
    var N4 = N >> 2;
    var twopi = f64_mul(F64_TWO, F64_PI);
    var eighth = f64_div(F64_ONE, f64_from(8));
    var tr = alloc(N2 * 8);
    var i = 0;
    while (i < N2) {
        store64(tr + i * 8, f64_cos(f64_div(f64_mul(twopi, f64_add(f64_from(i), eighth)), f64_from(N))));
        i = i + 1;
    }
    store64(_mdct_trig + shift * 8, tr);
    var dc = alloc(N4 * 8);
    var ds = alloc(N4 * 8);
    i = 0;
    while (i < N4) {
        var a = f64_div(f64_mul(twopi, f64_from(i)), f64_from(N4));
        store64(dc + i * 8, f64_cos(a));
        store64(ds + i * 8, f64_sin(a));
        i = i + 1;
    }
    store64(_mdct_dc + shift * 8, dc);
    store64(_mdct_ds + shift * 8, ds);
    return 0;
}

# clt_mdct_backward (float, direct DFT). in: MDCT coeffs (stride in_stride);
# out: writes out[0 .. N2+59], reading out[0..59] as prev overlap. overlap=120.
fn clt_mdct_backward(inp, in_stride, out, shift) {
    _mdct_cache_init(shift);
    var N = 1920 >> shift;
    var N2 = N >> 1;
    var N4 = N >> 2;
    var t = load64(_mdct_trig + shift * 8);
    var dc = load64(_mdct_dc + shift * 8);
    var ds = load64(_mdct_ds + shift * 8);
    var Cr = alloc(N4 * 8);
    var Ci = alloc(N4 * 8);
    var i = 0;
    while (i < N4) {
        var x1 = load64(inp + (2 * i * in_stride) * 8);
        var x2 = load64(inp + ((N2 - 1 - 2 * i) * in_stride) * 8);
        var ti = load64(t + i * 8);
        var tn = load64(t + (N4 + i) * 8);
        store64(Ci + i * 8, f64_add(f64_mul(x2, ti), f64_mul(x1, tn)));   # C[i].i = yr
        store64(Cr + i * 8, f64_sub(f64_mul(x1, ti), f64_mul(x2, tn)));   # C[i].r = yi
        i = i + 1;
    }
    # forward DFT: Fout[k] = sum_i C[i]*(cos(2pi ki/N4) - j sin)
    var Fr = alloc(N4 * 8);
    var Fi = alloc(N4 * 8);
    var k = 0;
    while (k < N4) {
        var sr = F64_ZERO;
        var si = F64_ZERO;
        i = 0;
        while (i < N4) {
            var m = (k * i) % N4;
            var cs = load64(dc + m * 8);
            var sn = load64(ds + m * 8);
            var cri = load64(Cr + i * 8);
            var cii = load64(Ci + i * 8);
            sr = f64_add(sr, f64_add(f64_mul(cri, cs), f64_mul(cii, sn)));
            si = f64_add(si, f64_sub(f64_mul(cii, cs), f64_mul(cri, sn)));
            i = i + 1;
        }
        store64(Fr + k * 8, sr);
        store64(Fi + k * 8, si);
        k = k + 1;
    }
    # post-rotate -> out[60 ..]
    var lim = (N4 + 1) >> 1;
    i = 0;
    while (i < lim) {
        var re = load64(Fi + i * 8);
        var im = load64(Fr + i * 8);
        var t0 = load64(t + i * 8);
        var t1 = load64(t + (N4 + i) * 8);
        var yr = f64_add(f64_mul(re, t0), f64_mul(im, t1));
        var yi = f64_sub(f64_mul(re, t1), f64_mul(im, t0));
        var re2 = load64(Fi + (N4 - 1 - i) * 8);
        var im2 = load64(Fr + (N4 - 1 - i) * 8);
        var t0b = load64(t + (N4 - i - 1) * 8);
        var t1b = load64(t + (N2 - i - 1) * 8);
        var yr2 = f64_add(f64_mul(re2, t0b), f64_mul(im2, t1b));
        var yi2 = f64_sub(f64_mul(re2, t1b), f64_mul(im2, t0b));
        store64(out + (60 + 2 * i) * 8, yr);
        store64(out + (60 + N2 - 1 - 2 * i) * 8, yi);
        store64(out + (60 + N2 - 2 - 2 * i) * 8, yr2);
        store64(out + (60 + 2 * i + 1) * 8, yi2);
        i = i + 1;
    }
    # mirror / TDAC on out[0..119]
    var w = _celt_window;
    i = 0;
    while (i < 60) {
        var x1 = load64(out + (119 - i) * 8);
        var x2 = load64(out + i * 8);
        var wlo = load64(w + i * 8);
        var whi = load64(w + (119 - i) * 8);
        store64(out + i * 8, f64_sub(f64_mul(x2, whi), f64_mul(x1, wlo)));
        store64(out + (119 - i) * 8, f64_add(f64_mul(x2, wlo), f64_mul(x1, whi)));
        i = i + 1;
    }
    return 0;
}

# clt_mdct_forward — forward MDCT (mdct.c float path), inverse of clt_mdct_backward.
# Windows/folds `in` (frame + 120-sample overlap) into N4 complex, pre-rotates (scale
# = 1/N4), runs the same direct N4-point DFT as the backward transform, post-rotates
# into `out` (N2 real coeffs, stride out_stride). N = 1920>>shift, N2=N/2, N4=N/4.
fn clt_mdct_forward(inp, out, out_stride, shift) {
    _mdct_cache_init(shift);
    var N = 1920 >> shift;
    var N2 = N >> 1;
    var N4 = N >> 2;
    var t = load64(_mdct_trig + shift * 8);
    var dc = load64(_mdct_dc + shift * 8);
    var ds = load64(_mdct_ds + shift * 8);
    var w = _celt_window;
    var scale = f64_div(F64_ONE, f64_from(N4));
    var f = alloc(N2 * 8);          # interleaved re/im: N4 complex
    var Cr = alloc(N4 * 8);
    var Ci = alloc(N4 * 8);
    # --- window / shuffle / fold: input [a,b,c,d] -> f ---
    var nfirst = (120 + 3) >> 2;    # (overlap+3)>>2 = 30
    var xp1 = 60;                   # in + overlap/2
    var xp2 = N2 - 1 + 60;          # in + N2-1 + overlap/2
    var wp1 = 60;                   # window + overlap/2
    var wp2 = 59;                   # window + overlap/2 - 1
    var yp = 0;
    var i = 0;
    while (i < nfirst) {
        store64(f + yp * 8, f64_add(f64_mul(load64(inp + (xp1 + N2) * 8), load64(w + wp2 * 8)), f64_mul(load64(inp + xp2 * 8), load64(w + wp1 * 8))));
        store64(f + (yp + 1) * 8, f64_sub(f64_mul(load64(inp + xp1 * 8), load64(w + wp1 * 8)), f64_mul(load64(inp + (xp2 - N2) * 8), load64(w + wp2 * 8))));
        xp1 = xp1 + 2; xp2 = xp2 - 2; wp1 = wp1 + 2; wp2 = wp2 - 2; yp = yp + 2;
        i = i + 1;
    }
    while (i < N4 - nfirst) {
        store64(f + yp * 8, load64(inp + xp2 * 8));
        store64(f + (yp + 1) * 8, load64(inp + xp1 * 8));
        xp1 = xp1 + 2; xp2 = xp2 - 2; yp = yp + 2;
        i = i + 1;
    }
    var wp1b = 0;                   # window
    var wp2b = 119;                 # window + overlap - 1
    while (i < N4) {
        store64(f + yp * 8, f64_add(f64_neg(f64_mul(load64(inp + (xp1 - N2) * 8), load64(w + wp1b * 8))), f64_mul(load64(inp + xp2 * 8), load64(w + wp2b * 8))));
        store64(f + (yp + 1) * 8, f64_add(f64_mul(load64(inp + xp1 * 8), load64(w + wp2b * 8)), f64_mul(load64(inp + (xp2 + N2) * 8), load64(w + wp1b * 8))));
        xp1 = xp1 + 2; xp2 = xp2 - 2; wp1b = wp1b + 2; wp2b = wp2b - 2; yp = yp + 2;
        i = i + 1;
    }
    # --- pre-rotation (+ scale) ---
    i = 0;
    while (i < N4) {
        var re = load64(f + (2 * i) * 8);
        var im = load64(f + (2 * i + 1) * 8);
        var t0 = load64(t + i * 8);
        var t1 = load64(t + (N4 + i) * 8);
        store64(Cr + i * 8, f64_mul(f64_sub(f64_mul(re, t0), f64_mul(im, t1)), scale));
        store64(Ci + i * 8, f64_mul(f64_add(f64_mul(im, t0), f64_mul(re, t1)), scale));
        i = i + 1;
    }
    # --- N4-point forward DFT (same kernel as backward) ---
    var Fr = alloc(N4 * 8);
    var Fi = alloc(N4 * 8);
    var k = 0;
    while (k < N4) {
        var sr = F64_ZERO;
        var si = F64_ZERO;
        i = 0;
        while (i < N4) {
            var m = (k * i) % N4;
            var cs = load64(dc + m * 8);
            var sn = load64(ds + m * 8);
            var cri = load64(Cr + i * 8);
            var cii = load64(Ci + i * 8);
            sr = f64_add(sr, f64_add(f64_mul(cri, cs), f64_mul(cii, sn)));
            si = f64_add(si, f64_sub(f64_mul(cii, cs), f64_mul(cri, sn)));
            i = i + 1;
        }
        store64(Fr + k * 8, sr);
        store64(Fi + k * 8, si);
        k = k + 1;
    }
    # --- post-rotation -> out (stride) ---
    i = 0;
    while (i < N4) {
        var fr = load64(Fr + i * 8);
        var fi = load64(Fi + i * 8);
        var pt0 = load64(t + i * 8);
        var pt1 = load64(t + (N4 + i) * 8);
        store64(out + (2 * i) * out_stride * 8, f64_sub(f64_mul(fi, pt1), f64_mul(fr, pt0)));
        store64(out + (N2 - 1 - 2 * i) * out_stride * 8, f64_add(f64_mul(fr, pt1), f64_mul(fi, pt0)));
        i = i + 1;
    }
    return 0;
}

# celt_synthesis: per channel denormalise + IMDCT into decode_mem+1088.
fn celt_synthesis(X, dm0, dm1, oldBandE, C, isTransient, silence, start, end, LM) {
    var N = 120 << LM;
    var B = 1;
    var NB = 120 << LM;
    var shift = 3 - LM;
    if (isTransient != 0) { B = 1 << LM; NB = 120; shift = 3; }
    var osoff = 2048 - N;
    var freq = alloc(N * 8);
    var c = 0;
    while (c < C) {
        var Xc = X + c * N * 8;
        var dm = dm0;
        if (c == 1) { dm = dm1; }
        var os = dm + osoff * 8;
        denormalise_bands(Xc, freq, oldBandE + c * 21 * 8, silence, start, end, LM);
        var b = 0;
        while (b < B) {
            clt_mdct_backward(freq + b * 8, B, os + NB * b * 8, shift);
            b = b + 1;
        }
        c = c + 1;
    }
    return 0;
}


# anti_collapse (bands.c:259) — refill collapsed short blocks with scaled noise.
fn anti_collapse(X, collapse_masks, C, size, logE, prevLogE, prevLogE2, pulses, seed_ptr, start, end, LM) {
    var i = start;
    while (i < end) {
        var eb0 = load64(_celt_eBands + i * 8);
        var eb1 = load64(_celt_eBands + (i + 1) * 8);
        var N0 = eb1 - eb0;
        var depth = ((1 + load64(pulses + i * 8)) / N0) >> LM;
        var thresh = f64_mul(F64_HALF, _celt_exp2(f64_neg(f64_mul(f64_div(F64_ONE, f64_from(8)), f64_from(depth)))));
        var sqrt_1 = f64_div(F64_ONE, f64_sqrt(f64_from(N0 << LM)));
        var c = 0;
        while (c < C) {
            var prev1 = load64(prevLogE + (c * 21 + i) * 8);
            var prev2 = load64(prevLogE2 + (c * 21 + i) * 8);
            if (C == 1) {
                prev1 = f64_max(prev1, load64(prevLogE + (21 + i) * 8));
                prev2 = f64_max(prev2, load64(prevLogE2 + (21 + i) * 8));
            }
            var minp = prev1;
            if (f64_lt(prev2, prev1) == 1) { minp = prev2; }
            var Ediff = f64_sub(load64(logE + (c * 21 + i) * 8), minp);
            if (f64_lt(Ediff, F64_ZERO) == 1) { Ediff = F64_ZERO; }
            var r = f64_mul(F64_TWO, _celt_exp2(f64_neg(Ediff)));
            if (LM == 3) { r = f64_mul(r, f64_div(f64_from(141421356), f64_from(100000000))); }   # *sqrt(2), only LM==3 (bands.c:329)
            if (f64_lt(thresh, r) == 1) { r = thresh; }
            r = f64_mul(r, sqrt_1);
            var Xc = X + (c * size + (eb0 << LM)) * 8;
            var renorm = 0;
            var kk = 0;
            while (kk < (1 << LM)) {
                if ((load8(collapse_masks + (i * C + c)) & (1 << kk)) == 0) {
                    var j = 0;
                    while (j < N0) {
                        var seed = celt_lcg_rand(load64(seed_ptr));
                        store64(seed_ptr, seed);
                        var val = r;
                        if ((seed & 0x8000) == 0) { val = f64_neg(r); }
                        store64(Xc + ((j << LM) + kk) * 8, val);
                        j = j + 1;
                    }
                    renorm = 1;
                }
                kk = kk + 1;
            }
            if (renorm != 0) { renormalise_vector(Xc, N0 << LM, F64_ONE); }
            c = c + 1;
        }
        i = i + 1;
    }
    return 0;
}

# deemphasis: out_syn -> interleaved pcm[j*CC+c], with persistent IIR memory.
fn celt_deemphasis(out_syn, pcm, c, CC, preemph_ptr, accum, LM) {
    var m = load64(preemph_ptr + c * 8);
    var j = 0;
    var N = 120 << LM;
    while (j < N) {
        var tmp = f64_add(f64_add(load64(out_syn + j * 8), F64_1E30INV), m);
        m = f64_mul(CELT_DEEMPH, tmp);
        var v = f64_div(tmp, f64_from(32768));
        # Hybrid: accumulate the CELT high band onto the SILK low band already in pcm.
        if (accum != 0) { v = f64_add(load64(pcm + (j * CC + c) * 8), v); }
        store64(pcm + (j * CC + c) * 8, v);
        j = j + 1;
    }
    store64(preemph_ptr + c * 8, m);
    return 0;
}

# ---- pitch post-filter (comb_filter) — celt.c float path ----
var _comb_gains = 0;   # gains[3][3]

fn _comb_gains_init() {
    _comb_gains = alloc(9 * 8);
    store64(_comb_gains + 0 * 8, f64_div(f64_from(10048), f64_from(32768)));  # .3066406250
    store64(_comb_gains + 1 * 8, f64_div(f64_from(7112),  f64_from(32768)));  # .2170410156
    store64(_comb_gains + 2 * 8, f64_div(f64_from(4248),  f64_from(32768)));  # .1296386719
    store64(_comb_gains + 3 * 8, f64_div(f64_from(15200), f64_from(32768)));  # .4638671875
    store64(_comb_gains + 4 * 8, f64_div(f64_from(8784),  f64_from(32768)));  # .2680664062
    store64(_comb_gains + 5 * 8, F64_ZERO);
    store64(_comb_gains + 6 * 8, f64_div(f64_from(26208), f64_from(32768)));  # .7998046875
    store64(_comb_gains + 7 * 8, f64_div(f64_from(3280),  f64_from(32768)));  # .1000976562
    store64(_comb_gains + 8 * 8, F64_ZERO);
    return 0;
}

fn comb_filter_const(y, x, T, N, g10, g11, g12) {
    var x4 = load64(x + (0 - T - 2) * 8);
    var x3 = load64(x + (0 - T - 1) * 8);
    var x2 = load64(x + (0 - T) * 8);
    var x1 = load64(x + (0 - T + 1) * 8);
    var i = 0;
    while (i < N) {
        var x0 = load64(x + (i - T + 2) * 8);
        var yv = f64_add(load64(x + i * 8),
            f64_add(f64_mul(g10, x2),
            f64_add(f64_mul(g11, f64_add(x1, x3)),
                    f64_mul(g12, f64_add(x0, x4)))));
        store64(y + i * 8, yv);
        x4 = x3; x3 = x2; x2 = x1; x1 = x0;
        i = i + 1;
    }
    return 0;
}

# comb_filter in-place (y==x): crossfade old->new params over `overlap`, then const.
fn comb_filter(y, x, T0, T1, N, g0, g1, tapset0, tapset1, overlap) {
    if (_comb_gains == 0) { _comb_gains_init(); }
    if ((g0 == F64_ZERO) & (g1 == F64_ZERO)) { return 0; }
    if (T0 < 15) { T0 = 15; }
    if (T1 < 15) { T1 = 15; }
    var g00 = f64_mul(g0, load64(_comb_gains + (tapset0 * 3 + 0) * 8));
    var g01 = f64_mul(g0, load64(_comb_gains + (tapset0 * 3 + 1) * 8));
    var g02 = f64_mul(g0, load64(_comb_gains + (tapset0 * 3 + 2) * 8));
    var g10 = f64_mul(g1, load64(_comb_gains + (tapset1 * 3 + 0) * 8));
    var g11 = f64_mul(g1, load64(_comb_gains + (tapset1 * 3 + 1) * 8));
    var g12 = f64_mul(g1, load64(_comb_gains + (tapset1 * 3 + 2) * 8));
    var x1 = load64(x + (0 - T1 + 1) * 8);
    var x2 = load64(x + (0 - T1) * 8);
    var x3 = load64(x + (0 - T1 - 1) * 8);
    var x4 = load64(x + (0 - T1 - 2) * 8);
    var ov = overlap;
    if ((g0 == g1) & (T0 == T1) & (tapset0 == tapset1)) { ov = 0; }
    var i = 0;
    while (i < ov) {
        var x0 = load64(x + (i - T1 + 2) * 8);
        var f = f64_mul(load64(_celt_window + i * 8), load64(_celt_window + i * 8));
        var omf = f64_sub(F64_ONE, f);
        var yv = f64_add(load64(x + i * 8),
            f64_add(f64_mul(f64_mul(omf, g00), load64(x + (i - T0) * 8)),
            f64_add(f64_mul(f64_mul(omf, g01), f64_add(load64(x + (i - T0 + 1) * 8), load64(x + (i - T0 - 1) * 8))),
            f64_add(f64_mul(f64_mul(omf, g02), f64_add(load64(x + (i - T0 + 2) * 8), load64(x + (i - T0 - 2) * 8))),
            f64_add(f64_mul(f64_mul(f, g10), x2),
            f64_add(f64_mul(f64_mul(f, g11), f64_add(x1, x3)),
                    f64_mul(f64_mul(f, g12), f64_add(x0, x4))))))));
        store64(y + i * 8, yv);
        x4 = x3; x3 = x2; x2 = x1; x1 = x0;
        i = i + 1;
    }
    if (g1 == F64_ZERO) { return 0; }
    comb_filter_const(y + i * 8, x + i * 8, T1, N - i, g10, g11, g12);
    return 0;
}


# ---- decoder state + full frame decode ----
# State: +0 oldBandE(42) +8 oldLogE(42) +16 oldLogE2(42) +24 dm0(2168) +32 dm1(2168)
#   +40 preemph(2) +48 rng +56 pf_period +64 pf_period_old +72 pf_gain +80 pf_gain_old
#   +88 pf_tapset +96 pf_tapset_old

fn celt_dec_state_new() {
    var st = alloc(112);
    var obe = alloc(42 * 8);
    var ole = alloc(42 * 8);
    var ol2 = alloc(42 * 8);
    var neg28 = f64_neg(f64_from(28));
    var i = 0;
    while (i < 42) {
        store64(obe + i * 8, F64_ZERO);
        store64(ole + i * 8, neg28);
        store64(ol2 + i * 8, neg28);
        i = i + 1;
    }
    var dm0 = alloc(2168 * 8);
    var dm1 = alloc(2168 * 8);
    i = 0;
    while (i < 2168) { store64(dm0 + i * 8, F64_ZERO); store64(dm1 + i * 8, F64_ZERO); i = i + 1; }
    var pre = alloc(2 * 8);
    store64(pre + 0, F64_ZERO);
    store64(pre + 8, F64_ZERO);
    store64(st + 0, obe);
    store64(st + 8, ole);
    store64(st + 16, ol2);
    store64(st + 24, dm0);
    store64(st + 32, dm1);
    store64(st + 40, pre);
    store64(st + 48, 0);
    store64(st + 56, 0);
    store64(st + 64, 0);
    store64(st + 72, F64_ZERO);
    store64(st + 80, F64_ZERO);
    store64(st + 88, 0);
    store64(st + 96, 0);
    return st;
}

# Payload wrapper: CELT-only fullband (start=0, end=21, no accumulate, fresh ec).
fn celt_decode_frame(st, payload, len, C, pcm_out) {
    return celt_decode_frame_ec(st, ec_dec_new(payload, len), len, C, 0, 21, 0, 3, pcm_out);
}

# ec-taking core: decode CELT bands [start,end) from a caller-owned range decoder,
# optionally accumulating onto pcm_out (hybrid: start=17, accum=1). Config-31 passes
# (start=0, end=21, accum=0) for bit-identical behaviour.
fn celt_decode_frame_ec(st, ec, len, C, start, end, accum, LM, pcm_out) {
    var oldBandE = load64(st + 0);
    var oldLogE = load64(st + 8);
    var oldLogE2 = load64(st + 16);
    var dm0 = load64(st + 24);
    var dm1 = load64(st + 32);
    var preemph = load64(st + 40);
    var N = 120 << LM;                # frame size: 480 (10ms) or 960 (20ms)
    var M = 1 << LM;
    var dmove = 2168 - N;             # decode_mem slide length (2168 = DECODE_BUFFER_SIZE+overlap)
    var osoff = 2048 - N;             # out_syn offset into decode_mem
    # R14 slide history: OPUS_MOVE(dm, dm+N, 2168-N)
    var c0 = 0;
    while (c0 < C) {
        var dm = dm0;
        if (c0 == 1) { dm = dm1; }
        var mi = 0;
        while (mi < dmove) { store64(dm + mi * 8, load64(dm + (mi + N) * 8)); mi = mi + 1; }
        c0 = c0 + 1;
    }
    var tf = alloc(21 * 8);
    var off = alloc(21 * 8);
    var pul = alloc(21 * 8);
    var fq = alloc(21 * 8);
    var fp = alloc(21 * 8);
    var cap = alloc(21 * 8);
    var scal = alloc(16 * 8);
    celt_decode_frame_prefix_ec(ec, len, C, LM, start, end, oldBandE, tf, off, pul, fq, fp, cap, scal);
    var silence = load64(scal + 0);
    var isTransient = load64(scal + 8);
    var acr = load64(scal + 40);
    var pf_pitch = load64(scal + 80);
    var pf_tapset = load64(scal + 88);
    var pf_gain = load64(scal + 96);
    var X = alloc(C * N * 8);
    var z = 0;
    while (z < C * N) { store64(X + z * 8, F64_ZERO); z = z + 1; }
    var Y = 0;
    if (C == 2) { Y = X + N * 8; }
    var collapse = alloc(C * 21);
    var shortBlocks = 0;
    if (isTransient != 0) { shortBlocks = M; }
    var total_bits = len * 64 - acr;
    quant_all_bands(X, Y, collapse, pul, shortBlocks, load64(scal + 24), load64(scal + 64), load64(scal + 56), tf, total_bits, load64(scal + 72), ec, LM, load64(scal + 48), st + 48, 0, C, start, end);
    var anti_collapse_on = 0;
    if (acr > 0) { anti_collapse_on = ec_dec_bits(ec, 1); }
    celt_unquant_energy_finalise(oldBandE, fq, fp, len * 8 - ec_tell(ec), ec, C, start, end);
    if (anti_collapse_on != 0) {
        anti_collapse(X, collapse, C, N, oldBandE, oldLogE, oldLogE2, pul, st + 48, start, end, LM);
    }
    if (silence != 0) {
        var s = 0;
        while (s < C * 21) { store64(oldBandE + s * 8, f64_neg(f64_from(28))); s = s + 1; }
    }
    celt_synthesis(X, dm0, dm1, oldBandE, C, isTransient, silence, start, end, LM);
    # R22 postfilter (comb_filter) — in place on out_syn = dm+1088
    var pperiod = load64(st + 56);
    var pperiod_old = load64(st + 64);
    var pgain = load64(st + 72);
    var pgain_old = load64(st + 80);
    var ptap = load64(st + 88);
    var ptap_old = load64(st + 96);
    if (pperiod < 15) { pperiod = 15; }
    if (pperiod_old < 15) { pperiod_old = 15; }
    var c = 0;
    while (c < C) {
        var dm = dm0;
        if (c == 1) { dm = dm1; }
        var os = dm + osoff * 8;
        comb_filter(os, os, pperiod_old, pperiod, 120, pgain_old, pgain, ptap_old, ptap, 120);
        comb_filter(os + 120 * 8, os + 120 * 8, pperiod, pf_pitch, N - 120, pgain, pf_gain, ptap, pf_tapset, 120);
        c = c + 1;
    }
    # de-emphasis -> pcm (out_syn = dm+1088)
    c = 0;
    while (c < C) {
        var dm2 = dm0;
        if (c == 1) { dm2 = dm1; }
        celt_deemphasis(dm2 + osoff * 8, pcm_out, c, C, preemph, accum, LM);
        c = c + 1;
    }
    # R23 energy memory rotation
    if (C == 1) {
        var q = 0;
        while (q < 21) { store64(oldBandE + (21 + q) * 8, load64(oldBandE + q * 8)); q = q + 1; }
    }
    if (isTransient == 0) {
        var r = 0;
        while (r < 42) {
            store64(oldLogE2 + r * 8, load64(oldLogE + r * 8));
            store64(oldLogE + r * 8, load64(oldBandE + r * 8));
            r = r + 1;
        }
    } else {
        var r2 = 0;
        while (r2 < 42) {
            store64(oldLogE + r2 * 8, f64_min(load64(oldLogE + r2 * 8), load64(oldBandE + r2 * 8)));
            r2 = r2 + 1;
        }
    }
    # R24 persist rng
    store64(st + 48, load64(ec + 56));
    # postfilter state rotation
    store64(st + 64, pperiod);
    store64(st + 80, pgain);
    store64(st + 96, ptap);
    store64(st + 56, pf_pitch);
    store64(st + 72, pf_gain);
    store64(st + 88, pf_tapset);
    store64(st + 64, pf_pitch);
    store64(st + 80, pf_gain);
    store64(st + 96, pf_tapset);
    return 0;
}









fn test_opus_range_roundtrip() {
    test_group("opus: range coder roundtrip");
    var rc = opus_range_enc_init();
    opus_range_enc_uint(rc, 5, 10);
    opus_range_enc_uint(rc, 100, 128);
    opus_range_enc_uint(rc, 3, 7);
    opus_range_enc_uint(rc, 42, 256);
    opus_range_enc_bit(rc, 1);
    opus_range_enc_bit(rc, 0);
    opus_range_enc_uint(rc, 1000, 4096);
    opus_range_enc_uint(rc, 0, 3);
    opus_range_enc_uint(rc, 65535, 65536);
    var coded = opus_range_enc_flush(rc);
    assert(str_len(coded) > 0, "range coder produces output");

    var rd = opus_range_dec_init(str_data(coded), str_len(coded));
    assert_eq(opus_range_dec_uint(rd, 10), 5, "rc roundtrip uint 5/10");
    assert_eq(opus_range_dec_uint(rd, 128), 100, "rc roundtrip uint 100/128");
    assert_eq(opus_range_dec_uint(rd, 7), 3, "rc roundtrip uint 3/7");
    assert_eq(opus_range_dec_uint(rd, 256), 42, "rc roundtrip uint 42/256");
    assert_eq(opus_range_dec_bit(rd), 1, "rc roundtrip bit 1");
    assert_eq(opus_range_dec_bit(rd), 0, "rc roundtrip bit 0");
    assert_eq(opus_range_dec_uint(rd, 4096), 1000, "rc roundtrip uint 1000/4096");
    assert_eq(opus_range_dec_uint(rd, 3), 0, "rc roundtrip uint 0/3");
    assert_eq(opus_range_dec_uint(rd, 65536), 65535, "rc roundtrip uint 65535/65536");
    return 0;
}

# ================================================================
# CELT band structure (Bark-scale at 48 kHz, 20ms)
# ================================================================

# 21 bands, boundaries in MDCT bin indices (960 samples -> 480 bins)
var _celt_band_edges = 0;
var _CELT_NUM_BANDS = 21;

fn _opus_init_bands() {
    _celt_band_edges = alloc(22 * 8);
    store64(_celt_band_edges + 0 * 8, 0);
    store64(_celt_band_edges + 1 * 8, 1);
    store64(_celt_band_edges + 2 * 8, 2);
    store64(_celt_band_edges + 3 * 8, 3);
    store64(_celt_band_edges + 4 * 8, 4);
    store64(_celt_band_edges + 5 * 8, 5);
    store64(_celt_band_edges + 6 * 8, 6);
    store64(_celt_band_edges + 7 * 8, 7);
    store64(_celt_band_edges + 8 * 8, 8);
    store64(_celt_band_edges + 9 * 8, 10);
    store64(_celt_band_edges + 10 * 8, 12);
    store64(_celt_band_edges + 11 * 8, 14);
    store64(_celt_band_edges + 12 * 8, 17);
    store64(_celt_band_edges + 13 * 8, 21);
    store64(_celt_band_edges + 14 * 8, 26);
    store64(_celt_band_edges + 15 * 8, 32);
    store64(_celt_band_edges + 16 * 8, 40);
    store64(_celt_band_edges + 17 * 8, 50);
    store64(_celt_band_edges + 18 * 8, 62);
    store64(_celt_band_edges + 19 * 8, 78);
    store64(_celt_band_edges + 20 * 8, 100);
    store64(_celt_band_edges + 21 * 8, 480);
    return 0;
}


# ================================================================
# Opus decoder — header parsing + duration estimation
# ================================================================

fn _opus_find_last_granule(data, len) {
    if (len < 27) { return 0 - 1; }
    var pos = len - 27;
    while (pos >= 0) {
        if (load8(data + pos) == 0x4F) {
            if (load8(data + pos + 1) == 0x67) {
                if (load8(data + pos + 2) == 0x67) {
                    if (load8(data + pos + 3) == 0x53) {
                        if (load8(data + pos + 4) == 0) {
                            if (pos + 14 <= len) {
                                var granule = load8(data + pos + 6);
                                granule = granule | (load8(data + pos + 7) << 8);
                                granule = granule | (load8(data + pos + 8) << 16);
                                granule = granule | (load8(data + pos + 9) << 24);
                                granule = granule | (load8(data + pos + 10) << 32);
                                granule = granule | (load8(data + pos + 11) << 40);
                                granule = granule | (load8(data + pos + 12) << 48);
                                granule = granule | (load8(data + pos + 13) << 56);
                                return granule;
                            }
                        }
                    }
                }
            }
        }
        if (pos == 0) { return 0 - 1; }
        pos = pos - 1;
    }
    return 0 - 1;
}

fn opus_decode_from_packets(packets_vec, ogg_data, ogg_len) {
    if (vec_len(packets_vec) == 0) { return err(ERR_END_OF_STREAM); }

    var pkt0 = vec_get(packets_vec, 0);
    var pkt0_data = str_data(pkt0);
    var pkt0_len = str_len(pkt0);
    var head = opus_parse_head(pkt0_data, pkt0_len);
    if (is_err(head) == 1) { return head; }

    if (vec_len(packets_vec) >= 2) {
        var pkt1 = vec_get(packets_vec, 1);
        opus_parse_tags(str_data(pkt1), str_len(pkt1));
    }

    var duration_secs = F64_ZERO;
    var total_samples = 0;
    var F64_48000 = f64_from(48000);
    var granule = _opus_find_last_granule(ogg_data, ogg_len);
    if (granule > 0) {
        var pre_skip = opus_head_pre_skip(head);
        var effective = granule - pre_skip;
        if (effective > 0) {
            duration_secs = f64_div(f64_from(effective), F64_48000);
            total_samples = effective;
        }
    }

    var channels = opus_head_channels(head);
    var pre_skip = opus_head_pre_skip(head);
    if (_celt_band_edges == 0) { _opus_init_bands(); }

    var samples = vec_new();
    var npkts = vec_len(packets_vec);
    var num_frames = npkts - 2;
    if (num_frames < 0) { num_frames = 0; }

    # Decode audio with the real RFC-6716 CELT decoder (config 31, CELT-only fullband
    # 20ms). SILK-only 20ms mono packets (config 1 NB / 9 WB) are decoded to 48kHz via
    # the real RFC-6716 SILK decoder. Other configs (MB SILK, hybrid, multi-frame) emit
    # silence for their frame so the timeline stays aligned. Pre-skip trimmed, capped to granule.
    if (num_frames > 0) {
        var st = celt_dec_state_new();
        var pcm = alloc(2 * 960 * 8);
        var maxsamp = num_frames * 960;
        var allpcm = alloc(maxsamp * channels * 8);
        # Persistent SILK decode state (created lazily on first SILK packet; the SILK
        # decoder, resampler and 1-sample mid history all carry across packets).
        var silk_st = 0;
        var silk_rst = 0;
        var silk_mid = 0;
        var silk_fs = 0;
        var silk_nsub = 0;   # nb_subfr the mono SILK state was inited with (2=10ms, 4=20ms)
        var silk_out = alloc(960 * 8);
        # Persistent SILK stereo state (created lazily on the first stereo SILK packet).
        var sk_st0 = 0;
        var sk_st1 = 0;
        var sk_rstL = 0;
        var sk_rstR = 0;
        var sk_stereo = 0;
        var sk_sfs = 0;
        var sk_nsub = 0;
        var sk_outL = alloc(960 * 8);
        var sk_outR = alloc(960 * 8);
        var F64_32768 = f64_from(32768);
        var wpos = 0;
        var f = 0;
        while (f < num_frames) {
            var pkt = vec_get(packets_vec, f + 2);
            var pdata = str_data(pkt);
            var plen = str_len(pkt);
            var config = 0;
            var stbit = 0;
            if (plen >= 1) { var toc = load8(pdata); config = (toc >> 3) & 0x1F; stbit = (toc >> 2) & 1; }
            # Per-frame output sample count (48 kHz): 10 ms configs = 480, else 20 ms = 960.
            var fsamp = 960;
            if ((config >= 16) & ((config & 3) == 2)) { fsamp = 480; }   # CELT-only 10ms
            if ((config == 12) | (config == 14)) { fsamp = 480; }        # hybrid 10ms
            if ((config == 0) | (config == 8)) { fsamp = 480; }          # SILK-only 10ms (NB/WB)
            var Cf = 1;
            if (stbit != 0) { Cf = 2; }
            var code = 0;
            if (plen >= 1) { code = load8(pdata) & 3; }
            var handled = 0;
            # CELT-only 10/20ms: configs 18/22/26/30 (LM=2, 10ms) + 19/23/27/31 (LM=3, 20ms).
            # LM = config&3 (2 or 3); bandwidth = (config>>2)&3 → end band NB13/WB17/SWB19/FB21.
            if ((config >= 18) & (config <= 31) & (((config & 3) == 2) | ((config & 3) == 3))) {
                if (plen >= 2) {
                    var clm = config & 3;
                    var cbw = (config >> 2) & 3;
                    var ceb = 21;
                    if (cbw == 0) { ceb = 13; }
                    if (cbw == 1) { ceb = 17; }
                    if (cbw == 2) { ceb = 19; }
                    celt_decode_frame_ec(st, ec_dec_new(pdata + 1, plen - 1), plen - 1, Cf, 0, ceb, 0, clm, pcm);
                    handled = 1;
                }
            }
            # SILK-only mono: NB (8kHz internal) config 0 (10ms)/1 (20ms), WB (16kHz)
            # config 8 (10ms)/9 (20ms). code 0 (one frame/packet), mono. → 48kHz.
            # nb_subfr = 2 (10ms) or 4 (20ms); resampler emits fsamp (480/960) samples.
            if ((handled == 0) & (stbit == 0) & (code == 0) & (plen >= 2)) {
                if ((config == 0) | (config == 1) | (config == 8) | (config == 9)) {
                    var sfs = 8;
                    if ((config == 8) | (config == 9)) { sfs = 16; }
                    var nsub = 4;
                    if ((config == 0) | (config == 8)) { nsub = 2; }
                    if ((silk_fs != sfs) | (silk_nsub != nsub)) {
                        silk_st = silk_decoder_init(sfs, nsub);
                        silk_rst = silk_resampler_init(sfs);
                        silk_mid = alloc(2 * 8);
                        store64(silk_mid + 0, 0); store64(silk_mid + 8, 0);
                        silk_fs = sfs;
                        silk_nsub = nsub;
                    }
                    silk_decode_pcm(silk_st, silk_rst, silk_mid, pdata + 1, plen - 1, silk_out);
                    var q = 0;
                    while (q < fsamp) {
                        store64(pcm + q * 8, f64_div(f64_from(load64(silk_out + q * 8)), F64_32768));
                        q = q + 1;
                    }
                    handled = 1;
                }
            }
            # SILK stereo: config 0/1 (NB) or 8/9 (WB), stereo bit set. 10ms = config 0/8
            # (nb_subfr=2), 20ms = config 1/9 (nb_subfr=4). Mid/side decoded from the shared
            # range coder, silk_stereo_MS_to_LR reconstruction, resample per channel → fsamp.
            if ((handled == 0) & (stbit == 1) & (code == 0) & (plen >= 2) & (channels == 2)) {
                if ((config == 0) | (config == 1) | (config == 8) | (config == 9)) {
                    var ssfs = 8;
                    if ((config == 8) | (config == 9)) { ssfs = 16; }
                    var snsub = 4;
                    if ((config == 0) | (config == 8)) { snsub = 2; }
                    if ((sk_sfs != ssfs) | (sk_nsub != snsub)) {
                        sk_st0 = silk_decoder_init(ssfs, snsub);
                        sk_st1 = silk_decoder_init(ssfs, snsub);
                        sk_rstL = silk_resampler_init(ssfs);
                        sk_rstR = silk_resampler_init(ssfs);
                        sk_stereo = alloc(6 * 8);
                        var sz = 0; while (sz < 6) { store64(sk_stereo + sz * 8, 0); sz = sz + 1; }
                        sk_sfs = ssfs;
                        sk_nsub = snsub;
                    }
                    var sec = ec_dec_new(pdata + 1, plen - 1);
                    silk_decode_stereo(sk_st0, sk_st1, sk_rstL, sk_rstR, sk_stereo, sec, ssfs, sk_outL, sk_outR);
                    var sq = 0;
                    while (sq < fsamp) {
                        store64(pcm + (sq * 2 + 0) * 8, f64_div(f64_from(load64(sk_outL + sq * 8)), F64_32768));
                        store64(pcm + (sq * 2 + 1) * 8, f64_div(f64_from(load64(sk_outR + sq * 8)), F64_32768));
                        sq = sq + 1;
                    }
                    handled = 1;
                }
            }
            # Hybrid 20ms mono: config 13 (SWB, CELT end=19) or 15 (FB, end=21). SILK
            # decodes the low band (WB 16kHz) from the front of the shared range coder;
            # CELT decodes the high band (start=17) from the same ec and accumulates.
            # Hybrid mono: SWB config 12 (10ms)/13 (20ms, CELT end=19), FB config 14 (10ms)/
            # 15 (20ms, end=21). SILK is always WB 16kHz; nb_subfr=2 (10ms)/4 (20ms), CELT
            # LM=2 (10ms)/3 (20ms). SILK low band + CELT high band (start=17, accumulate).
            if ((handled == 0) & (stbit == 0) & (code == 0) & (plen >= 2)) {
                if ((config == 12) | (config == 13) | (config == 14) | (config == 15)) {
                    var hnsub = 4;
                    var hlm = 3;
                    if ((config == 12) | (config == 14)) { hnsub = 2; hlm = 2; }
                    if ((silk_fs != 16) | (silk_nsub != hnsub)) {
                        silk_st = silk_decoder_init(16, hnsub);
                        silk_rst = silk_resampler_init(16);
                        silk_mid = alloc(2 * 8);
                        store64(silk_mid + 0, 0); store64(silk_mid + 8, 0);
                        silk_fs = 16;
                        silk_nsub = hnsub;
                    }
                    var hb_end = 21;
                    if ((config == 12) | (config == 13)) { hb_end = 19; }
                    var hec = ec_dec_new(pdata + 1, plen - 1);
                    # SILK low band -> silk_out (int16 48k), normalized into pcm.
                    silk_decode_pcm_ec(silk_st, silk_rst, silk_mid, hec, silk_out);
                    var hq = 0;
                    while (hq < fsamp) {
                        store64(pcm + hq * 8, f64_div(f64_from(load64(silk_out + hq * 8)), F64_32768));
                        hq = hq + 1;
                    }
                    # Redundancy flag: must be read to keep the shared ec in sync even
                    # when 0. Redundant-audio handling is a follow-on (assume/skip here).
                    var hlen = plen - 1;
                    if (ec_tell(hec) + 17 + 20 <= 8 * hlen) {
                        if (ec_dec_bit_logp(hec, 12) != 0) {
                            var hcts = ec_dec_bit_logp(hec, 1);
                            var hrb = ec_dec_uint(hec, 256) + 2;
                            hlen = hlen - hrb;
                            store64(hec + 8, load64(hec + 8) - hrb);
                        }
                    }
                    # CELT high band from the same ec, accumulated onto the SILK low band.
                    celt_decode_frame_ec(st, hec, hlen, 1, 17, hb_end, 1, hlm, pcm);
                    handled = 1;
                }
            }
            # Hybrid STEREO: SWB config 12 (10ms)/13 (20ms), FB config 14 (10ms)/15 (20ms),
            # stereo bit set. SILK stereo (mid/side → L/R, WB) low band from the front of the
            # shared ec; CELT stereo (C=2, start=17) high band, accumulated onto interleaved L/R.
            # nb_subfr=2/CELT LM=2 (10ms) or nb_subfr=4/LM=3 (20ms).
            if ((handled == 0) & (stbit == 1) & (code == 0) & (plen >= 2) & (channels == 2)) {
                if ((config == 12) | (config == 13) | (config == 14) | (config == 15)) {
                    var hsnsub = 4;
                    var hslm = 3;
                    if ((config == 12) | (config == 14)) { hsnsub = 2; hslm = 2; }
                    if ((sk_sfs != 16) | (sk_nsub != hsnsub)) {
                        sk_st0 = silk_decoder_init(16, hsnsub);
                        sk_st1 = silk_decoder_init(16, hsnsub);
                        sk_rstL = silk_resampler_init(16);
                        sk_rstR = silk_resampler_init(16);
                        sk_stereo = alloc(6 * 8);
                        var hsz = 0; while (hsz < 6) { store64(sk_stereo + hsz * 8, 0); hsz = hsz + 1; }
                        sk_sfs = 16;
                        sk_nsub = hsnsub;
                    }
                    var hsbe = 21;
                    if ((config == 12) | (config == 13)) { hsbe = 19; }
                    var hsec = ec_dec_new(pdata + 1, plen - 1);
                    silk_decode_stereo(sk_st0, sk_st1, sk_rstL, sk_rstR, sk_stereo, hsec, 16, sk_outL, sk_outR);
                    var hsq = 0;
                    while (hsq < fsamp) {
                        store64(pcm + (hsq * 2 + 0) * 8, f64_div(f64_from(load64(sk_outL + hsq * 8)), F64_32768));
                        store64(pcm + (hsq * 2 + 1) * 8, f64_div(f64_from(load64(sk_outR + hsq * 8)), F64_32768));
                        hsq = hsq + 1;
                    }
                    var hslen = plen - 1;
                    if (ec_tell(hsec) + 17 + 20 <= 8 * hslen) {
                        if (ec_dec_bit_logp(hsec, 12) != 0) {
                            var hscts = ec_dec_bit_logp(hsec, 1);
                            var hsrb = ec_dec_uint(hsec, 256) + 2;
                            hslen = hslen - hsrb;
                            store64(hsec + 8, load64(hsec + 8) - hsrb);
                        }
                    }
                    # CELT stereo high band from the same ec, accumulated onto L/R.
                    celt_decode_frame_ec(st, hsec, hslen, 2, 17, hsbe, 1, hslm, pcm);
                    handled = 1;
                }
            }
            if (handled == 0) {
                var zz = 0;
                while (zz < 2 * 960) { store64(pcm + zz * 8, F64_ZERO); zz = zz + 1; }
            }
            var i = 0;
            while (i < fsamp) {
                var cc = 0;
                while (cc < channels) {
                    var v = F64_ZERO;
                    if (cc < Cf) { v = load64(pcm + (i * Cf + cc) * 8); }
                    store64(allpcm + (wpos * channels + cc) * 8, v);
                    cc = cc + 1;
                }
                wpos = wpos + 1;
                i = i + 1;
            }
            f = f + 1;
        }
        # Trim pre-skip and cap to the granule.
        var out_frames = wpos - pre_skip;
        if (granule > 0) {
            var eff = granule - pre_skip;
            if (eff < out_frames) { out_frames = eff; }
        }
        if (out_frames < 0) { out_frames = 0; }
        var si = 0;
        while (si < out_frames) {
            var cc2 = 0;
            while (cc2 < channels) {
                vec_push(samples, load64(allpcm + ((pre_skip + si) * channels + cc2) * 8));
                cc2 = cc2 + 1;
            }
            si = si + 1;
        }
        total_samples = out_frames;
        duration_secs = f64_div(f64_from(total_samples), F64_48000);
    }

    var fi = fmtinfo_new(FMT_OPUS, 48000, channels, 16, duration_secs, total_samples);
    return decode_result_new(fi, samples);
}
