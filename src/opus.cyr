    store8(c0_b + 84, 0); store8(c0_b + 85, 0); store8(c0_b + 86, 0); store8(c0_b + 87, 0); store8(c0_b + 88, 0); store8(c0_b + 89, 0); store8(c0_b + 90, 0); store8(c0_b + 91, 0); store8(c0_b + 92, 0); store8(c0_b + 93, 0); store8(c0_b + 94, 0); store8(c0_b + 95, 0); store8(c0_b + 96, 0); store8(c0_b + 97, 0);
    store8(c0_b + 98, 0); store8(c0_b + 99, 0); store8(c0_b + 100, 0); store8(c0_b + 101, 0); store8(c0_b + 102, 0); store8(c0_b + 103, 0); store8(c0_b + 104, 0); store8(c0_b + 105, 0); store8(c0_b + 106, 0); store8(c0_b + 107, 0); store8(c0_b + 108, 0); store8(c0_b + 109, 0); store8(c0_b + 110, 0); store8(c0_b + 111, 0);
    store8(c0_b + 112, 0); store8(c0_b + 113, 0); store8(c0_b + 114, 0); store8(c0_b + 115, 0); store8(c0_b + 116, 0); store8(c0_b + 117, 0); store8(c0_b + 118, 0); store8(c0_b + 119, 0); store8(c0_b + 120, 0); store8(c0_b + 121, 0); store8(c0_b + 122, 0); store8(c0_b + 123, 0); store8(c0_b + 124, 0); store8(c0_b + 125, 0);
