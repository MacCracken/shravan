# ================================================================
# CELT CWRS: codeword index -> pulse vector (RFC 6716 §4.3.4) — cwrs.c port
# ================================================================
# U(N,K) counts sign-annotated pulse combos; V(N,K)=U(N,K)+U(N,K+1) is the range
# coder `ft`. Table U[row][col] built by the recurrence U(n,k)=U(n-1,k)+U(n,k-1)+
# U(n-1,k-1). Only rows 0..15 are needed (allocation guarantees the smaller of
# (N,K) is <=14 for any codeword that fits uint32); cells >= 2^32 are saturated so
# i64 never overflows (saturated cells are never used as a real `ft`).

var _celt_pvqU = 0;
var CELT_U_NC = 178;

fn _celt_pvq_u_init() {
    var NROW = 16;
    var NC = CELT_U_NC;
    var CAP = 4294967296;     # 2^32
    _celt_pvqU = alloc(NROW * NC * 8);
    var k = 0;
    while (k < NC) { store64(_celt_pvqU + (0 * NC + k) * 8, 0); k = k + 1; }
    store64(_celt_pvqU + 0, 1);              # U[0][0] = 1
    var n = 1;
    while (n < NROW) {
        store64(_celt_pvqU + (n * NC + 0) * 8, 0);   # U[n][0] = 0
        k = 1;
        while (k < NC) {
            var a = load64(_celt_pvqU + ((n - 1) * NC + k) * 8);
            var b = load64(_celt_pvqU + (n * NC + (k - 1)) * 8);
            var c = load64(_celt_pvqU + ((n - 1) * NC + (k - 1)) * 8);
            var v = a + b + c;
            if (v >= CAP) { v = CAP; }
            store64(_celt_pvqU + (n * NC + k) * 8, v);
            k = k + 1;
        }
        n = n + 1;
    }
    return 0;
}

# Direct row access U_ROW[a][b] (a<=15, b<=177).
fn _u(a, b) {
    return load64(_celt_pvqU + (a * CELT_U_NC + b) * 8);
}

# U(n,k) with symmetry U(n,k)=U(k,n): row=min, col=max.
fn celt_pvq_u(n, k) {
    if (_celt_pvqU == 0) { _celt_pvq_u_init(); }
    if (n <= k) { return _u(n, k); }
    return _u(k, n);
}

fn celt_pvq_v(n, k) {
    return celt_pvq_u(n, k) + celt_pvq_u(n, k + 1);
}

# cwrsi (cwrs.c:467): index i -> pulse vector y[0..n-1]; returns yy = sum(y[j]^2).
fn celt_cwrsi(n, k, i, y) {
    if (_celt_pvqU == 0) { _celt_pvq_u_init(); }
    var NC = CELT_U_NC;
    var yy = 0;
    var N = n;
    var K = k;
    var ii = i;
    var yp = 0;
    while (N > 2) {
        var val = 0;
        if (K >= N) {
            # lots of pulses: row = N (N<=14 here)
            var p = load64(_celt_pvqU + (N * NC + (K + 1)) * 8);
            var s = 0;
            if (ii >= p) { s = 0 - 1; ii = ii - (p & s); }
            var k0 = K;
            var q = load64(_celt_pvqU + (N * NC + N) * 8);
            if (q > ii) {
                K = N;
                var cont = 1;
                while (cont == 1) {
                    K = K - 1;
                    p = load64(_celt_pvqU + (K * NC + N) * 8);
                    if (p > ii) { cont = 1; } else { cont = 0; }
                }
            } else {
                p = load64(_celt_pvqU + (N * NC + K) * 8);
                while (p > ii) { K = K - 1; p = load64(_celt_pvqU + (N * NC + K) * 8); }
            }
            ii = ii - p;
            val = (k0 - K + s) ^ s;
        } else {
            # lots of dimensions: row = K (K<=14 here)
            var p = load64(_celt_pvqU + (K * NC + N) * 8);
            var q = load64(_celt_pvqU + ((K + 1) * NC + N) * 8);
            if ((p <= ii) & (ii < q)) {
                ii = ii - p;
                val = 0;
            } else {
                var s = 0;
                if (ii >= q) { s = 0 - 1; ii = ii - (q & s); }
                var k0 = K;
                var cont = 1;
                while (cont == 1) {
                    K = K - 1;
                    p = load64(_celt_pvqU + (K * NC + N) * 8);
                    if (p > ii) { cont = 1; } else { cont = 0; }
                }
                ii = ii - p;
                val = (k0 - K + s) ^ s;
            }
        }
        store64(y + yp * 8, val);
        yp = yp + 1;
        yy = yy + val * val;
        N = N - 1;
    }
    # N == 2
    var p2 = 2 * K + 1;
    var s2 = 0;
    if (ii >= p2) { s2 = 0 - 1; ii = ii - (p2 & s2); }
    var k02 = K;
    K = (ii + 1) >> 1;
    if (K != 0) { ii = ii - (2 * K - 1); }
    var val2 = (k02 - K + s2) ^ s2;
    store64(y + yp * 8, val2);
    yp = yp + 1;
    yy = yy + val2 * val2;
    # N == 1
    var s1 = 0 - ii;
    var val1 = (K + s1) ^ s1;
    store64(y + yp * 8, val1);
    yy = yy + val1 * val1;
    return yy;
}

# decode_pulses (cwrs.c:543): read codeword index, then cwrsi. Returns yy.
fn celt_decode_pulses(ec, n, k, y) {
    var v = celt_pvq_v(n, k);
    var i = ec_dec_uint(ec, v);
    return celt_cwrsi(n, k, i, y);
}

