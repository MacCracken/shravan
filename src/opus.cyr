    store8(f0_p + 84, 115); store8(f0_p + 85, 202); store8(f0_p + 86, 141); store8(f0_p + 87, 105); store8(f0_p + 88, 243); store8(f0_p + 89, 135); store8(f0_p + 90, 251); store8(f0_p + 91, 72); store8(f0_p + 92, 132); store8(f0_p + 93, 132); store8(f0_p + 94, 184); store8(f0_p + 95, 23); store8(f0_p + 96, 49); store8(f0_p + 97, 182);
