    # CFG 1: N=2 K=5 Ryy=13
    var c1_b = alloc(128);
    store8(c1_b + 0, 56); store8(c1_b + 1, 0); store8(c1_b + 2, 0); store8(c1_b + 3, 0); store8(c1_b + 4, 0); store8(c1_b + 5, 0); store8(c1_b + 6, 0); store8(c1_b + 7, 0); store8(c1_b + 8, 0); store8(c1_b + 9, 0); store8(c1_b + 10, 0); store8(c1_b + 11, 0); store8(c1_b + 12, 0); store8(c1_b + 13, 0);
