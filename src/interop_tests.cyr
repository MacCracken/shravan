# interop_tests.cyr -- decode real encoder output and compare with a reference.
#
# Round-trip tests decode what shravan encoded, so they cannot see a bug the two
# sides share, or a path shravan's encoder never takes. These fixtures come from
# ffmpeg, flac and lame, and the expected values from ffmpeg's decoders. See
# scripts/gen-interop-fixtures.py.

var _FX_KIND_CODEC = 0;     # codec_open: anything detect_format recognises
var _FX_KIND_AAC = 1;       # aac_decode: raw ADTS
var _FX_KIND_MP3 = 2;       # mp3_decode_pcm
var _FX_KIND_OPUS1 = 3;     # raw Opus packets (u32le length each), one channel out
var _FX_KIND_OPUS2 = 4;     # the same, two channels out

# Wrap raw Opus packets the way opus_decode_from_packets takes them: an OpusHead with
# pre-skip 0 and an empty OpusTags first, so the output lines up sample for sample
# with libopus's decode of the same packets.
fn _fx_opus_packets(buf, len, channels) {
    var head = alloc(19);
    memset(head, 0, 19);
    memcpy(head, "OpusHead", 8);
    store8(head + 8, 1);
    store8(head + 9, channels);
    write_u32_le(head, 12, 48000);
    var tags = alloc(16);
    memset(tags, 0, 16);
    memcpy(tags, "OpusTags", 8);
    var pk = vec_new();
    vec_push(pk, str_from_buf(head, 19));
    vec_push(pk, str_from_buf(tags, 16));
    var pos = 0;
    while (pos + 4 <= len) {
        var n = read_u32_le(buf, pos);
        pos = pos + 4;
        if (pos + n > len) { break; }
        vec_push(pk, str_from_buf(buf + pos, n));
        pos = pos + n;
    }
    return opus_decode_from_packets(pk, 0, 0);
}

# Decode a base64 fixture. Returns a decode result or error.
fn _fx_decode(b64, kind) {
    var buf = alloc(strlen(b64) + 16);
    var n = _mp3_b64_decode(b64, buf);
    if (kind == _FX_KIND_AAC) { return aac_decode(buf, n); }
    if (kind == _FX_KIND_MP3) { return mp3_decode_pcm(buf, n); }
    if (kind == _FX_KIND_OPUS1) { return _fx_opus_packets(buf, n, 1); }
    if (kind == _FX_KIND_OPUS2) { return _fx_opus_packets(buf, n, 2); }
    return codec_open(buf, n);
}

# FNV-1a over the low 32 bits of each sample. Matches fnv_hash in the generator.
fn _fx_hash(samples, bps) {
    var scale = f64_from(1 << (bps - 1));
    var h = 1469598103934665603;
    var n = vec_len(samples);
    var i = 0;
    while (i < n) {
        var v = f64_to(f64_round(f64_mul(vec_get(samples, i), scale)));
        h = (h ^ (v & 0xFFFFFFFF)) * 0x100000001B3;
        i = i + 1;
    }
    return h;
}

# A lossless stream must match the reference on every sample.
fn _fx_exact(name, b64, rate, channels, bps, count, hash) {
    var r = _fx_decode(b64, _FX_KIND_CODEC);
    assert(res_ok(r) == 1, name);
    if (is_err(r) == 1) { return 0; }
    var fi = decode_result_info(r);
    assert_eq(fmtinfo_sample_rate(fi), rate, name);
    assert_eq(fmtinfo_channels(fi), channels, name);
    assert_eq(fmtinfo_bit_depth(fi), bps, name);
    var samples = decode_result_samples(r);
    assert_eq(vec_len(samples), count, name);
    assert_eq(_fx_hash(samples, bps), hash, name);
    return 0;
}

# Read the next integer from a comma-separated cstring at *pos_ptr.
fn _fx_next_int(s, pos_ptr) {
    var p = load64(pos_ptr);
    var neg = 0;
    if (load8(s + p) == 45) { neg = 1; p = p + 1; }
    var v = 0;
    while (load8(s + p) >= 48 && load8(s + p) <= 57) {
        v = v * 10 + load8(s + p) - 48;
        p = p + 1;
    }
    if (load8(s + p) == 44) { p = p + 1; }
    store64(pos_ptr, p);
    if (neg == 1) { return 0 - v; }
    return v;
}

# A lossy stream must match on every sampled point, to within rounding as 16-bit
# values. `ref_csv` holds every step-th reference sample.
fn _fx_lossy(name, b64, kind, rate, channels, count, step, ref_csv) {
    var r = _fx_decode(b64, kind);
    assert(res_ok(r) == 1, name);
    if (is_err(r) == 1) { return 0; }
    var fi = decode_result_info(r);
    assert_eq(fmtinfo_sample_rate(fi), rate, name);
    assert_eq(fmtinfo_channels(fi), channels, name);
    var samples = decode_result_samples(r);
    assert(vec_len(samples) >= count, name);
    var scale = f64_from(32768);
    var pos = alloc(8);
    var i = 0;
    var off = 0;
    while (i < count) {
        var want = _fx_next_int(ref_csv, pos);
        var got = f64_to(f64_round(f64_mul(vec_get(samples, i), scale)));
        var d = got - want;
        if (d < 0) { d = 0 - d; }
        if (d > 2) { off = off + 1; }
        i = i + step;
    }
    assert_eq(off, 0, name);
    return 0;
}

# As _fx_lossy, comparing from sample `off` on (an excerpt's filterbanks start
# without the history the reference decode had).
fn _fx_lossy_off(name, b64, kind, rate, channels, count, off, step, ref_csv) {
    var r = _fx_decode(b64, kind);
    assert(res_ok(r) == 1, name);
    if (is_err(r) == 1) { return 0; }
    var fi = decode_result_info(r);
    assert_eq(fmtinfo_sample_rate(fi), rate, name);
    assert_eq(fmtinfo_channels(fi), channels, name);
    var samples = decode_result_samples(r);
    assert(vec_len(samples) >= count, name);
    if (vec_len(samples) < count) { return 0; }
    var scale = f64_from(32768);
    var pos = alloc(8);
    var i = off;
    var bad = 0;
    while (i < count) {
        var want = _fx_next_int(ref_csv, pos);
        var got = f64_to(f64_round(f64_mul(vec_get(samples, i), scale)));
        if (got > 32767) { got = 32767; }
        if (got < 0 - 32768) { got = 0 - 32768; }
        var d = got - want;
        if (d < 0) { d = 0 - d; }
        if (d > 2) { bad = bad + 1; }
        i = i + step;
    }
    assert_eq(bad, 0, name);
    return 0;
}

# MPEG audio against the ISO conformance reference decodes. Each path decoded
# wrongly before 2.9.3 (ffmpeg and mpg123 both still miss some of them).
fn test_interop_mpeg_conformance() {
    syscall(1, 1, "test: interop mpeg audio conformance (ISO 11172-4, 13818-4)\n", 60);
    _fx_lossy_off("layer I joint stereo", _FX_ISOL1JS_B64, _FX_KIND_CODEC, 32000, 2,
      _FX_ISOL1JS_COUNT, _FX_ISOL1JS_OFF, _FX_ISOL1JS_STEP, _FX_ISOL1JS_REF);
    _fx_lossy_off("layer II joint stereo", _FX_ISOL2JS_B64, _FX_KIND_CODEC, 32000, 2,
      _FX_ISOL2JS_COUNT, _FX_ISOL2JS_OFF, _FX_ISOL2JS_STEP, _FX_ISOL2JS_REF);
    _fx_lossy_off("mpeg-2 intensity + m/s, short blocks", _FX_ISOLSFIS_B64, _FX_KIND_CODEC, 22050, 2,
      _FX_ISOLSFIS_COUNT, _FX_ISOLSFIS_OFF, _FX_ISOLSFIS_STEP, _FX_ISOLSFIS_REF);
    _fx_lossy_off("mpeg-1 stereo modes incl. intensity", _FX_ISOMODE_B64, _FX_KIND_CODEC, 44100, 2,
      _FX_ISOMODE_COUNT, _FX_ISOMODE_OFF, _FX_ISOMODE_STEP, _FX_ISOMODE_REF);
    _fx_lossy_off("free-format layer III", _FX_ISOFREE_B64, _FX_KIND_CODEC, 44100, 2,
      _FX_ISOFREE_COUNT, _FX_ISOFREE_OFF, _FX_ISOFREE_STEP, _FX_ISOFREE_REF);
    _fx_lossy("mp3 with a LAME Info frame", _FX_MP3INFO_B64, _FX_KIND_CODEC, 44100, 2,
      _FX_MP3INFO_COUNT, _FX_MP3INFO_STEP, _FX_MP3INFO_REF);

    # Leading junk before the first frame (the ISO sin1k0db stream opens with 215
    # bytes of it): detection scans for two matching frames.
    var buf = alloc(strlen(_FX_MP344_B64) + 512);
    memset(buf, 0, 300);
    store8(buf + 120, 0xFF);
    store8(buf + 121, 0xE3);
    var n = _mp3_b64_decode(_FX_MP344_B64, buf + 300);
    assert_eq(shravan_detect_format(buf, n + 300), FMT_MP3, "mp3 after leading junk detected");
    var r = codec_open(buf, n + 300);
    assert(res_ok(r) == 1, "mp3 after leading junk decodes");
    if (res_ok(r) == 1) {
        var plain = codec_open(buf + 300, n);
        assert_eq(vec_len(decode_result_samples(r)), vec_len(decode_result_samples(plain)), "same samples after junk");
    }
    return 0;
}

fn test_interop_flac() {
    syscall(1, 1, "test: interop flac (flac CLI, LPC subframes)\n", 45);
    _fx_exact("flac 16-bit stereo LPC", _FX_FLAC16_B64, 44100, 2, 16, _FX_FLAC16_COUNT, _FX_FLAC16_HASH);
    _fx_exact("flac 8-bit mono LPC", _FX_FLAC8_B64, 8000, 1, 8, _FX_FLAC8_COUNT, _FX_FLAC8_HASH);

    _fx_exact("flac 32-bit stereo", _FX_FLAC32_B64, 48000, 2, 32, _FX_FLAC32_COUNT, _FX_FLAC32_HASH);

    # Frames whose channel count contradicts STREAMINFO (here: patched to claim
    # mono over stereo frames) are refused, as libFLAC refuses them.
    var mb = alloc(strlen(_FX_FLAC16_B64) + 16);
    var mn = _mp3_b64_decode(_FX_FLAC16_B64, mb);
    store8(mb + 20, load8(mb + 20) & 0xF1);
    assert_eq(codec_open(mb, mn), err(ERR_DECODE), "flac frames contradicting STREAMINFO channels");
    # One-shot also trips over the declared length; a range and a stream have only
    # the channel check to stop them.
    assert_eq(flac_decode_range(mb, mn, 0, 100), err(ERR_DECODE), "flac range: contradicting channels");
    var sm = flac_stream_new();
    var evs = flac_stream_feed(sm, mb, mn);
    var stream_err = 0;
    for (var e = 0; e < vec_len(evs); e = e + 1) {
        if (stream_evt_type(vec_get(evs, e)) == STREAM_EVT_ERROR) { stream_err = stream_evt_data(vec_get(evs, e)); }
    }
    assert_eq(stream_err, err(ERR_DECODE), "flac stream: contradicting channels");

    # The signature check on the same real files.
    var buf = alloc(strlen(_FX_FLAC16_B64) + 16);
    var n = _mp3_b64_decode(_FX_FLAC16_B64, buf);
    assert_eq(flac_verify(buf, n), 0, "flac verify on a real file");
    return 0;
}

# Stereo FLAC keeps every integer the encoder took in. The mid channel has to round
# down: an odd negative sum rounded toward zero came back one off, on every such
# sample. And since 2.9.3 the encoders scale by 2^(N-1), the decoders' inverse, so
# the decoded samples equal the input exactly, not just as integers.
fn test_interop_flac_midside_exact() {
    syscall(1, 1, "test: flac mid-side is lossless\n", 32);
    var samples = vec_new();
    var scale = f64_from(32768);
    for (var i = 0; i < 2048; i = i + 1) {
        # Both channels negative, with an odd sum on odd i.
        vec_push(samples, f64_div(f64_from(0 - 1000 - i), scale));
        vec_push(samples, f64_div(f64_from(0 - 2000 - i * 2), scale));
    }
    var buf = alloc(131072);
    var n = flac_encode(samples, 44100, 2, 16, buf);
    assert(res_ok(n) == 1, "flac mid-side encode ok");
    assert_eq(flac_verify(buf, n), 0, "flac mid-side output matches its signature");
    var r = flac_decode(buf, n);
    assert(res_ok(r) == 1, "flac mid-side decode ok");
    var out = decode_result_samples(r);
    assert_eq(vec_len(out), 4096, "flac mid-side count");
    var wrong = 0;
    for (var i = 0; i < 4096; i = i + 1) {
        if (vec_get(out, i) != vec_get(samples, i)) { wrong = wrong + 1; }
    }
    assert_eq(wrong, 0, "flac mid-side round trip is exact");
    return 0;
}

fn test_interop_aiff() {
    syscall(1, 1, "test: interop aiff-c (float, refused compressions)\n", 51);
    _fx_exact("aiff-c fl32", _FX_AIFCF32_B64, 44100, 2, 32, _FX_AIFCF32_COUNT, _FX_AIFCF32_HASH);
    assert_eq(_fx_decode(_FX_AIFCULAW_B64, _FX_KIND_CODEC), err(ERR_UNSUPPORTED_FMT), "aiff-c ulaw refused");
    return 0;
}

# Encoders and decoders are exact inverses: a decoded sample re-encodes to the same
# integer, and the range ends are reachable (-1.0 is -32768; +1.0 clamps to 32767).
fn test_pcm_quant_inverse() {
    syscall(1, 1, "test: pcm encode is the inverse of decode\n", 42);
    var src = alloc(16);
    var vals = alloc(8 * 8);
    store64(vals + 0, 0 - 32768); store64(vals + 8, 0 - 32767); store64(vals + 16, 0 - 1);
    store64(vals + 24, 0); store64(vals + 32, 1); store64(vals + 40, 16384); store64(vals + 48, 32767);
    var i = 0;
    var wrong = 0;
    while (i < 7) {
        write_u16_le(src, 0, load64(vals + i * 8) & 0xFFFF);
        var v = i16_to_f64(src, 1);
        var out = alloc(8);
        f64_to_i16(v, out);
        if (read_u16_le(out, 0) != (load64(vals + i * 8) & 0xFFFF)) { wrong = wrong + 1; }
        i = i + 1;
    }
    assert_eq(wrong, 0, "i16 decode then encode is exact");
    var ends = vec_new();
    vec_push(ends, f64_neg(F64_ONE));
    vec_push(ends, F64_ONE);
    vec_push(ends, F64_TWO);
    var o2 = alloc(16);
    f64_to_i16(ends, o2);
    assert_eq(read_u16_le(o2, 0), 0x8000, "-1.0 encodes to -32768");
    assert_eq(read_u16_le(o2, 2), 0x7FFF, "+1.0 clamps to 32767");
    assert_eq(read_u16_le(o2, 4), 0x7FFF, "overload clamps to 32767");
    # 24 bits through the same quantiser.
    var s24 = alloc(8);
    store8(s24, 0x01); store8(s24 + 1, 0x00); store8(s24 + 2, 0x80);   # -8388607
    var v24 = i24_packed_to_f64(s24, 1);
    var o24 = alloc(8);
    f64_to_i24_packed(v24, o24);
    assert_eq(load8(o24) | (load8(o24 + 1) << 8) | (load8(o24 + 2) << 16), 0x800001, "i24 decode then encode is exact");
    return 0;
}

# The one-shot ceiling (shravan_set_max_samples): every decoder refuses past it
# with ERR_TOO_LARGE, before allocating, instead of a generic decode error.
fn test_one_shot_ceiling() {
    syscall(1, 1, "test: one-shot sample ceiling\n", 30);
    assert_eq(shravan_max_samples(), 67108864, "default ceiling is 2^26 samples");
    var prev = shravan_set_max_samples(1000);
    assert_eq(prev, 67108864, "set returns the previous ceiling");
    assert_eq(_fx_decode(_FX_FLAC16_B64, _FX_KIND_CODEC), err(ERR_TOO_LARGE), "flac over the ceiling");
    assert_eq(_fx_decode(_FX_AAC22_B64, _FX_KIND_AAC), err(ERR_TOO_LARGE), "aac over the ceiling");
    assert_eq(_fx_decode(_FX_MP344_B64, _FX_KIND_MP3), err(ERR_TOO_LARGE), "mp3 over the ceiling");
    assert_eq(_fx_decode(_FX_OPUS25_B64, _FX_KIND_OPUS2), err(ERR_TOO_LARGE), "opus over the ceiling");
    assert_eq(_fx_decode(_FX_ALAC16_B64, _FX_KIND_CODEC), err(ERR_TOO_LARGE), "alac over the ceiling");
    var w = vec_new();
    for (var i = 0; i < 2000; i = i + 1) { vec_push(w, F64_ZERO); }
    var wb = alloc(8192);
    var wn = wav_encode(w, 8000, 1, PCM_I16, wb);
    assert_eq(codec_open(wb, wn), err(ERR_TOO_LARGE), "wav over the ceiling");
    shravan_set_max_samples(0);
    assert_eq(shravan_max_samples(), 1, "ceiling is at least 1");
    shravan_set_max_samples(prev);
    assert(res_ok(_fx_decode(_FX_FLAC16_B64, _FX_KIND_CODEC)) == 1, "restored ceiling decodes again");

    # SEC-033: an MP4 whose stsz claims a constant 1-byte sample size for every
    # byte of the file. The sample table alone was 16x the input (an 8 MiB file
    # allocated 134 MB); now the implied output is checked first.
    if (_aac_sample_rates == 0) { aac_init(); }
    var big = 1048576;
    var buf = alloc(big);
    memset(buf, 0, big);
    var au = alloc(64);
    memset(au, 0x11, 64);
    var aus = alloc(8);
    store64(aus, au);
    var szs = alloc(8);
    store64(szs, 10);
    var l = _mp4_test_build(1, 44100, aus, szs, 1, buf);
    var stsz = _mp4_scan_type(buf, l, MP4_STSZ);
    write_u32_be(buf, stsz + 12, 1);
    write_u32_be(buf, stsz + 16, big - 4096);
    var stsc = _mp4_scan_type(buf, l, MP4_STSC);
    write_u32_be(buf, stsc + 20, 0xFFFFFFFF);
    var before = alloc_used();
    assert_eq(mp4_demux(buf, big), err(ERR_TOO_LARGE), "mp4 sample table over the ceiling refused");
    assert(alloc_used() - before < 65536, "mp4 refusal allocates almost nothing");
    return 0;
}

fn test_interop_alac() {
    syscall(1, 1, "test: interop alac (ffmpeg, MP4 and MOV)\n", 41);
    _fx_exact("alac 16-bit stereo m4a", _FX_ALAC16_B64, 44100, 2, 16, _FX_ALAC16_COUNT, _FX_ALAC16_HASH);
    _fx_exact("alac 24-bit shifted bytes", _FX_ALAC24_B64, 48000, 2, 24, _FX_ALAC24_COUNT, _FX_ALAC24_HASH);
    _fx_exact("alac in QuickTime v2", _FX_ALACMOV_B64, 96000, 2, 16, _FX_ALACMOV_COUNT, _FX_ALACMOV_HASH);
    return 0;
}

fn test_interop_aac() {
    syscall(1, 1, "test: interop aac (ffmpeg, per-rate bands, TNS)\n", 48);
    _fx_lossy("aac 22 kHz TNS, independent windows", _FX_AAC22_B64, _FX_KIND_AAC, 22050, 2,
      _FX_AAC22_COUNT, _FX_AAC22_STEP, _FX_AAC22_REF);
    _fx_lossy("aac 96 kHz in MP4, rate from esds", _FX_AAC96_B64, _FX_KIND_CODEC, 96000, 2,
      _FX_AAC96_COUNT, _FX_AAC96_STEP, _FX_AAC96_REF);
    _aac_select_swb(4);    # later tests assume the 44.1 kHz layout
    return 0;
}

fn test_interop_mp3() {
    syscall(1, 1, "test: interop mp3 (lame, count1 B, 8 kHz)\n", 42);
    _fx_lossy("mp3 8 kHz short blocks", _FX_MP38_B64, _FX_KIND_MP3, 8000, 1,
      _FX_MP38_COUNT, _FX_MP38_STEP, _FX_MP38_REF);
    _fx_lossy("mp3 44.1 kHz count1 table B", _FX_MP344_B64, _FX_KIND_MP3, 44100, 1,
      _FX_MP344_COUNT, _FX_MP344_STEP, _FX_MP344_REF);
    return 0;
}

# Opus against libopus's own decode of the same packets. Each stream decoded
# wrongly before 2.9.3, by between 4 and 280,000 LSB.
fn test_interop_opus() {
    syscall(1, 1, "test: interop opus (libopus packets and decode)\n", 48);
    _fx_lossy("opus 2.5 ms CELT postfilter", _FX_OPUS25_B64, _FX_KIND_OPUS2, 48000, 2,
      _FX_OPUS25_COUNT, _FX_OPUS25_STEP, _FX_OPUS25_REF);
    _fx_lossy("opus stereo 40 ms SILK with inband FEC", _FX_OPUSFEC_B64, _FX_KIND_OPUS2, 48000, 2,
      _FX_OPUSFEC_COUNT, _FX_OPUSFEC_STEP, _FX_OPUSFEC_REF);
    _fx_lossy("opus hybrid with inband FEC", _FX_OPUSHFEC_B64, _FX_KIND_OPUS1, 48000, 1,
      _FX_OPUSHFEC_COUNT, _FX_OPUSHFEC_STEP, _FX_OPUSHFEC_REF);
    _fx_lossy("opus stereo SILK mid-only and side restart", _FX_OPUSMID_B64, _FX_KIND_OPUS2, 48000, 2,
      _FX_OPUSMID_COUNT, _FX_OPUSMID_STEP, _FX_OPUSMID_REF);
    _fx_lossy("opus mode and mono/stereo switches", _FX_OPUSSW_B64, _FX_KIND_OPUS2, 48000, 2,
      _FX_OPUSSW_COUNT, _FX_OPUSSW_STEP, _FX_OPUSSW_REF);
    _fx_lossy("opus SILK bandwidth switches", _FX_OPUSBW_B64, _FX_KIND_OPUS2, 48000, 2,
      _FX_OPUSBW_COUNT, _FX_OPUSBW_STEP, _FX_OPUSBW_REF);
    _fx_lossy("opus SILK 10/20 ms switches", _FX_OPUSFS_B64, _FX_KIND_OPUS2, 48000, 2,
      _FX_OPUSFS_COUNT, _FX_OPUSFS_STEP, _FX_OPUSFS_REF);
    _fx_lossy("opus CELT bandwidth switches", _FX_OPUSCBW_B64, _FX_KIND_OPUS2, 48000, 2,
      _FX_OPUSCBW_COUNT, _FX_OPUSCBW_STEP, _FX_OPUSCBW_REF);
    _fx_lossy("opus concealed mode switches", _FX_OPUSPLC_B64, _FX_KIND_OPUS2, 48000, 2,
      _FX_OPUSPLC_COUNT, _FX_OPUSPLC_STEP, _FX_OPUSPLC_REF);
    _fx_lossy("opus SILK DTX", _FX_OPUSDTX_B64, _FX_KIND_OPUS2, 48000, 2,
      _FX_OPUSDTX_COUNT, _FX_OPUSDTX_STEP, _FX_OPUSDTX_REF);
    _fx_lossy("opus CELT DTX", _FX_OPUSCDTX_B64, _FX_KIND_OPUS1, 48000, 1,
      _FX_OPUSCDTX_COUNT, _FX_OPUSCDTX_STEP, _FX_OPUSCDTX_REF);
    _fx_lossy("opus CELT 2.5 ms with lost packets", _FX_OPUSCLOSS_B64, _FX_KIND_OPUS2, 48000, 2,
      _FX_OPUSCLOSS_COUNT, _FX_OPUSCLOSS_STEP, _FX_OPUSCLOSS_REF);
    _fx_lossy("opus SILK with lost packets", _FX_OPUSSLOSS_B64, _FX_KIND_OPUS2, 48000, 2,
      _FX_OPUSSLOSS_COUNT, _FX_OPUSSLOSS_STEP, _FX_OPUSSLOSS_REF);
    # 16 kHz concealment, against a default libopus build (a deep-PLC build skips
    # the fade-in after a loss there; shravan follows the default build).
    _fx_lossy("opus WB SILK with lost packets", _FX_OPUSWBLOSS_B64, _FX_KIND_OPUS1, 48000, 1,
      _FX_OPUSWBLOSS_COUNT, _FX_OPUSWBLOSS_STEP, _FX_OPUSWBLOSS_REF);
    _fx_lossy("opus hybrid with lost packets", _FX_OPUSHYBLOSS_B64, _FX_KIND_OPUS2, 48000, 2,
      _FX_OPUSHYBLOSS_COUNT, _FX_OPUSHYBLOSS_STEP, _FX_OPUSHYBLOSS_REF);
    _fx_lossy("opus WB SILK DTX", _FX_OPUSWBDTX_B64, _FX_KIND_OPUS2, 48000, 2,
      _FX_OPUSWBDTX_COUNT, _FX_OPUSWBDTX_STEP, _FX_OPUSWBDTX_REF);
    _fx_lossy("opus CELT->SILK redundancy after SILK", _FX_OPUSC2S_B64, _FX_KIND_OPUS2, 48000, 2,
      _FX_OPUSC2S_COUNT, _FX_OPUSC2S_STEP, _FX_OPUSC2S_REF);
    _fx_lossy("opus SILK gain clamp after loss", _FX_OPUSGCLAMP_B64, _FX_KIND_OPUS2, 48000, 2,
      _FX_OPUSGCLAMP_COUNT, _FX_OPUSGCLAMP_STEP, _FX_OPUSGCLAMP_REF);
    _fx_lossy("ogg opus header output gain", _FX_OGGGAIN_B64, _FX_KIND_CODEC, 48000, 2,
      _FX_OGGGAIN_COUNT, _FX_OGGGAIN_STEP, _FX_OGGGAIN_REF);
    return 0;
}

# Mapping families 1 and 255 put several streams in each packet. Decoding them as
# one stream returned garbage with success; they are refused until supported.
fn test_opus_multistream_refused() {
    syscall(1, 1, "test: opus multistream refused\n", 31);
    var head = alloc(21);
    memset(head, 0, 21);
    memcpy(head, "OpusHead", 8);
    store8(head + 8, 1);
    store8(head + 9, 6);
    write_u32_le(head, 12, 48000);
    store8(head + 18, 1);
    store8(head + 19, 4);
    store8(head + 20, 2);
    var tags = alloc(16);
    memset(tags, 0, 16);
    memcpy(tags, "OpusTags", 8);
    var pk = vec_new();
    vec_push(pk, str_from_buf(head, 21));
    vec_push(pk, str_from_buf(tags, 16));
    var one = alloc(4);
    store8(one, 0xF8);
    vec_push(pk, str_from_buf(one, 1));
    assert_eq(opus_decode_from_packets(pk, 0, 0), err(ERR_UNSUPPORTED_FMT), "5.1 opus refused");
    return 0;
}

# Band tables: the shape of each one, and the values the reference has at the
# points that differ between layouts.
fn test_interop_aac_tables() {
    syscall(1, 1, "test: aac band tables per sample rate\n", 38);
    if (_aac_sample_rates == 0) { aac_init(); }
    if (_aac_swb_offset == 0) { _aac_init_swb(); }
    var sr = 0;
    while (sr < 13) {
        _aac_select_swb(sr);
        assert_eq(load64(_aac_swb_offset), 0, "long table starts at 0");
        assert_eq(load64(_aac_swb_offset + _AAC_NUM_SWB * 8), 1024, "long table ends at 1024");
        assert_eq(load64(_aac_swb_short), 0, "short table starts at 0");
        assert_eq(load64(_aac_swb_short + _AAC_NUM_SWB_SHORT * 8), 128, "short table ends at 128");
        var b = 0;
        var rising = 1;
        while (b < _AAC_NUM_SWB) {
            if (load64(_aac_swb_offset + (b + 1) * 8) <= load64(_aac_swb_offset + b * 8)) { rising = 0; }
            b = b + 1;
        }
        assert_eq(rising, 1, "long table rises");
        sr = sr + 1;
    }
    _aac_select_swb(0);  assert_eq(_AAC_NUM_SWB, 41, "96 kHz has 41 bands");
    _aac_select_swb(2);  assert_eq(_AAC_NUM_SWB, 47, "64 kHz has 47 bands");
    _aac_select_swb(5);  assert_eq(_AAC_NUM_SWB, 51, "32 kHz has 51 bands");
    _aac_select_swb(7);  assert_eq(_AAC_NUM_SWB_SHORT, 15, "22 kHz has 15 short bands");
    _aac_select_swb(10); assert_eq(_AAC_NUM_SWB, 43, "11 kHz has 43 bands");
    _aac_select_swb(11); assert_eq(_AAC_NUM_SWB, 40, "8 kHz has 40 bands");
    _aac_select_swb(4);
    assert_eq(_AAC_NUM_SWB, 49, "44.1 kHz has 49 bands");
    assert_eq(_aac_tns_max_long, 42, "44.1 kHz TNS limit");
    return 0;
}

# Hand-built boxes for the MP4 paths a small file cannot reach.
fn test_interop_mp4_boxes() {
    syscall(1, 1, "test: mp4 64-bit boxes and esds\n", 32);
    var buf = alloc(256);
    var e = alloc(8);

    # A 64-bit box size in the low word finds the box after it.
    write_u32_be(buf, 0, 1);
    write_u32_be(buf, 4, MP4_FTYP);
    write_u32_be(buf, 8, 0);
    write_u32_be(buf, 12, 24);
    write_u32_be(buf, 24, 16);
    write_u32_be(buf, 28, MP4_MOOV);
    assert_eq(mp4_find(buf, 0, 40, MP4_MOOV, e), 32, "largesize box skipped");

    # A size past 4 GiB must not wrap to a small one and land inside the file.
    write_u32_be(buf, 8, 1);
    write_u32_be(buf, 12, 24);
    assert(mp4_find(buf, 0, 40, MP4_MOOV, e) < 0, "high word of largesize is honoured");

    # esds: AAC-LC, 44.1 kHz, stereo.
    var d = alloc(64);
    store8(d + 4, 3); store8(d + 5, 22);       # ES descriptor
    store8(d + 6, 0); store8(d + 7, 1); store8(d + 8, 0);
    store8(d + 9, 4); store8(d + 10, 17);      # decoder config
    store8(d + 11, 0x40);                      # MPEG-4 audio
    store8(d + 24, 5); store8(d + 25, 2);      # specific info
    store8(d + 26, 0x12); store8(d + 27, 0x10);   # AOT 2, index 4, 2 channels
    var out = alloc(32);
    assert_eq(mp4_parse_esds(d, 0, 28, out), 0, "esds parses");
    assert_eq(load64(out), 2, "esds channels");
    assert_eq(load64(out + 8), 44100, "esds rate");

    # An explicit 24-bit rate: index 15 escapes.
    store8(d + 25, 5);
    store8(d + 26, 0x17); store8(d + 27, 0x80);
    store8(d + 28, 0x7D); store8(d + 29, 0x00);   # 64000, then 2 channels
    store8(d + 30, 0x10);
    assert_eq(mp4_parse_esds(d, 0, 31, out), 0, "esds explicit rate parses");
    assert_eq(load64(out + 8), 64000, "esds explicit rate");

    # HE-AAC is reported, not played at half rate with no high band.
    store8(d + 25, 2);
    store8(d + 26, 0x2A); store8(d + 27, 0x10);   # AOT 5
    assert_eq(mp4_parse_esds(d, 0, 28, out), MP4_UNSUPPORTED, "HE-AAC is unsupported");

    # Truncated: the descriptor runs past the box.
    assert_eq(mp4_parse_esds(d, 0, 12, out), MP4_MALFORMED, "truncated esds is malformed");
    return 0;
}

fn test_interop_wav() {
    syscall(1, 1, "test: interop wav and aiff as ffmpeg writes them\n", 49);
    _fx_exact("wav 24-bit with a LIST chunk", _FX_WAV24_B64, 44100, 2, 24, _FX_WAV24_COUNT, _FX_WAV24_HASH);
    _fx_exact("wav float32", _FX_WAVF32_B64, 44100, 2, 32, _FX_WAVF32_COUNT, _FX_WAVF32_HASH);
    _fx_exact("wav extensible, 3 channels", _FX_WAVEXT_B64, 48000, 3, 16, _FX_WAVEXT_COUNT, _FX_WAVEXT_HASH);
    _fx_exact("wav from a pipe (sizes unknown)", _FX_WAVPIPE_B64, 22050, 1, 16, _FX_WAVPIPE_COUNT, _FX_WAVPIPE_HASH);
    _fx_exact("wav 12-bit in 16-bit containers", _FX_WAV12_B64, 16000, 1, 12, _FX_WAV12_COUNT, _FX_WAV12_HASH);
    _fx_exact("aiff 16-bit", _FX_AIFF16_B64, 44100, 2, 16, _FX_AIFF16_COUNT, _FX_AIFF16_HASH);
    _fx_exact("aiff 12-bit in 16-bit containers", _FX_AIFF12_B64, 16000, 1, 12, _FX_AIFF12_COUNT, _FX_AIFF12_HASH);
    return 0;
}

# A seek point on the last, shorter frame: flac_decode_range has to place it at
# frame number x STREAMINFO block size (8192), not x its own size (2208).
fn test_interop_flac_range_seek() {
    syscall(1, 1, "test: flac range from a seek point on the last frame\n", 53);
    _fx_exact("flac with a seek table", _FX_FLACSEEK_B64, 8000, 1, 16, _FX_FLACSEEK_COUNT, _FX_FLACSEEK_HASH);
    var buf = alloc(strlen(_FX_FLACSEEK_B64) + 16);
    var n = _mp3_b64_decode(_FX_FLACSEEK_B64, buf);
    var whole = decode_result_samples(flac_decode(buf, n));
    var r = flac_decode_range(buf, n, 8197, 10);
    assert(res_ok(r) == 1, "flac range in the last frame decodes");
    if (is_err(r) == 1) { return 0; }
    var got = decode_result_samples(r);
    assert_eq(vec_len(got), 10, "flac range in the last frame: count");
    var wrong = 0;
    for (var i = 0; i < vec_len(got); i = i + 1) {
        if (vec_get(got, i) != vec_get(whole, 8197 + i)) { wrong = wrong + 1; }
    }
    assert_eq(wrong, 0, "flac range in the last frame: samples");
    # The range ending exactly where the file does, and one running past it.
    var tail = flac_decode_range(buf, n, 10390, 100);
    assert_eq(vec_len(decode_result_samples(tail)), 10, "flac range clipped at the end");
    return 0;
}

# ---- streaming ----

var _fxs_rate = 0;
var _fxs_ch = 0;
var _fxs_headers = 0;
var _fxs_ends = 0;
var _fxs_errors = 0;
var _fxs_last_err = 0;
var _fxs_odd = 0;        # SAMPLES events, other than the last, not chunk_frames long
var _fxs_events = 0;

# Feed buf to a stream split into `split`-byte pieces, then flush. kind: 0 =
# decode_reader, 1 = WAV, 2 = AIFF, 3 = FLAC. Returns the samples, concatenated.
fn _fxs_run(buf, n, kind, split, chunk) {
    var dec = 0;
    if (kind == 0) { dec = decode_reader(chunk); }
    if (kind == 1) { dec = wav_stream_new(chunk); }
    if (kind == 2) { dec = aiff_stream_new(chunk); }
    if (kind == 3) { dec = flac_stream_new(); }
    _fxs_rate = 0; _fxs_ch = 0; _fxs_headers = 0; _fxs_ends = 0;
    _fxs_errors = 0; _fxs_last_err = 0; _fxs_odd = 0; _fxs_events = 0;
    var got = vec_new();
    var prev = 0 - 1;        # length of the previous SAMPLES event
    var pos = 0;
    var done = 0;
    while (done == 0) {
        var evs = 0;
        if (pos < n) {
            var take = split;
            if (take > n - pos) { take = n - pos; }
            if (kind == 0) { evs = decode_reader_feed(dec, buf + pos, take); }
            if (kind == 1) { evs = wav_stream_feed(dec, buf + pos, take); }
            if (kind == 2) { evs = aiff_stream_feed(dec, buf + pos, take); }
            if (kind == 3) { evs = flac_stream_feed(dec, buf + pos, take); }
            pos = pos + take;
        } else {
            if (kind == 0) { evs = decode_reader_flush(dec); }
            if (kind == 1) { evs = wav_stream_flush(dec); }
            if (kind == 2) { evs = aiff_stream_flush(dec); }
            if (kind == 3) { evs = flac_stream_flush(dec); }
            done = 1;
        }
        var ne = vec_len(evs);
        for (var e = 0; e < ne; e = e + 1) {
            var ev = vec_get(evs, e);
            var t = stream_evt_type(ev);
            if (t == STREAM_EVT_HEADER) {
                _fxs_headers = _fxs_headers + 1;
                _fxs_rate = fmtinfo_sample_rate(stream_evt_data(ev));
                _fxs_ch = fmtinfo_channels(stream_evt_data(ev));
            }
            if (t == STREAM_EVT_SAMPLES) {
                var sv = stream_evt_data(ev);
                if (prev >= 0) { if (prev != chunk * _fxs_ch) { _fxs_odd = _fxs_odd + 1; } }
                prev = vec_len(sv);
                _fxs_events = _fxs_events + 1;
                for (var j = 0; j < vec_len(sv); j = j + 1) { vec_push(got, vec_get(sv, j)); }
            }
            if (t == STREAM_EVT_END) { _fxs_ends = _fxs_ends + 1; }
            if (t == STREAM_EVT_ERROR) {
                _fxs_errors = _fxs_errors + 1;
                _fxs_last_err = stream_evt_data(ev);
            }
        }
    }
    return got;
}

# A stream must give exactly the one-shot decode, however the input is split.
fn _fxs_check(name, b64, kind, split, chunk) {
    var buf = alloc(strlen(b64) + 16);
    var n = _mp3_b64_decode(b64, buf);
    var ref = codec_open(buf, n);
    assert(res_ok(ref) == 1, name);
    if (is_err(ref) == 1) { return 0; }
    var want = decode_result_samples(ref);
    var got = _fxs_run(buf, n, kind, split, chunk);
    assert_eq(_fxs_headers, 1, name);
    assert_eq(_fxs_ends, 1, name);
    assert_eq(_fxs_errors, 0, name);
    assert_eq(_fxs_rate, fmtinfo_sample_rate(decode_result_info(ref)), name);
    assert_eq(_fxs_ch, fmtinfo_channels(decode_result_info(ref)), name);
    if ((kind == 1) | (kind == 2)) { assert_eq(_fxs_odd, 0, name); }
    assert_eq(vec_len(got), vec_len(want), name);
    var wrong = 0;
    var m = vec_len(got);
    if (m > vec_len(want)) { m = vec_len(want); }
    for (var i = 0; i < m; i = i + 1) {
        if (vec_get(got, i) != vec_get(want, i)) { wrong = wrong + 1; }
    }
    assert_eq(wrong, 0, name);
    return 0;
}

fn _fxs_sweep(name, b64, kind) {
    var whole = strlen(b64);
    _fxs_check(name, b64, kind, 1, 64);
    _fxs_check(name, b64, kind, 7, 1);
    _fxs_check(name, b64, kind, 100, 4096);
    _fxs_check(name, b64, kind, 4096, 100);
    _fxs_check(name, b64, kind, whole, 4096);
    _fxs_check(name, b64, 0, 1, 64);
    _fxs_check(name, b64, 0, 333, 256);
    return 0;
}

# Until 2.9.3 the WAV and AIFF streams decoded the first feed holding a complete
# header and dropped every later byte, and FLAC re-decoded from its last seek point
# on each feed. The old tests only looked for a SAMPLES event, never counted one.
fn test_interop_stream() {
    syscall(1, 1, "test: streams match the one-shot decoders\n", 42);
    _fxs_sweep("stream wav 24-bit", _FX_WAV24_B64, 1);
    _fxs_sweep("stream wav float32", _FX_WAVF32_B64, 1);
    _fxs_sweep("stream wav extensible", _FX_WAVEXT_B64, 1);
    _fxs_sweep("stream wav from a pipe", _FX_WAVPIPE_B64, 1);
    _fxs_sweep("stream wav 12-bit", _FX_WAV12_B64, 1);
    _fxs_sweep("stream aiff 16-bit", _FX_AIFF16_B64, 2);
    _fxs_sweep("stream aiff 12-bit", _FX_AIFF12_B64, 2);
    _fxs_sweep("stream aiff-c fl32", _FX_AIFCF32_B64, 2);
    _fxs_sweep("stream flac 16-bit", _FX_FLAC16_B64, 3);
    _fxs_sweep("stream flac 8-bit", _FX_FLAC8_B64, 3);
    _fxs_sweep("stream flac 32-bit", _FX_FLAC32_B64, 3);
    _fxs_sweep("stream flac with a seek table", _FX_FLACSEEK_B64, 3);

    # A stream holds only an unfinished chunk, not the file.
    var buf = alloc(strlen(_FX_WAV24_B64) + 16);
    var n = _mp3_b64_decode(_FX_WAV24_B64, buf);
    var dec = wav_stream_new(64);
    var pos = 0;
    while (pos < n) {
        var take = 100;
        if (take > n - pos) { take = n - pos; }
        wav_stream_feed(dec, buf + pos, take);
        pos = pos + take;
    }
    assert(load64(dec + 24) < n, "stream buffer stays below the file size");

    # No one-shot ceiling: a stream is the route for long files.
    var prev = shravan_set_max_samples(1000);
    var fb = alloc(strlen(_FX_FLAC16_B64) + 16);
    var fn_ = _mp3_b64_decode(_FX_FLAC16_B64, fb);
    assert_eq(codec_open(fb, fn_), err(ERR_TOO_LARGE), "one-shot refuses past the ceiling");
    var got = _fxs_run(fb, fn_, 3, 4096, 0);
    assert_eq(vec_len(got), _FX_FLAC16_COUNT, "the stream decodes past the ceiling");
    var wb = alloc(strlen(_FX_WAV24_B64) + 16);
    var wn = _mp3_b64_decode(_FX_WAV24_B64, wb);
    got = _fxs_run(wb, wn, 1, 512, 256);
    assert_eq(vec_len(got), _FX_WAV24_COUNT, "the wav stream decodes past the ceiling");
    shravan_set_max_samples(prev);

    # A truncated FLAC: the complete frames, then ERR_END_OF_STREAM at flush.
    got = _fxs_run(fb, fn_ - 9, 3, 1000, 0);
    assert_eq(_fxs_errors, 1, "truncated flac stream: one error");
    assert_eq(_fxs_last_err, err(ERR_END_OF_STREAM), "truncated flac stream: end of stream");
    assert(vec_len(got) > 0, "truncated flac stream: the whole frames arrive");
    assert_eq(_fxs_ends, 1, "truncated flac stream: END");

    # A corrupt frame stops the stream with ERR_DECODE rather than stalling.
    var cb = alloc(fn_);
    memcpy(cb, fb, fn_);
    store8(cb + fn_ / 2, load8(cb + fn_ / 2) ^ 0x5A);
    got = _fxs_run(cb, fn_, 3, 512, 0);
    assert_eq(_fxs_errors, 1, "corrupt flac stream: one error");
    assert_eq(_fxs_last_err, err(ERR_DECODE), "corrupt flac stream: decode error");
    assert(vec_len(got) < _FX_FLAC16_COUNT, "corrupt flac stream stops");

    # A frame is accepted only once its CRC-16 footer has arrived and matched: a
    # damaged footer on the first frame fails the one-shot decode and must fail a
    # stream fed a byte at a time too, not slip through before the footer lands.
    var br = bitreader_new(fb, fn_);
    var si = flac_parse_metadata(fb, fn_);
    flac_br_set_pos(br, load64(si + 48));
    _flac_frame(br, fb, fn_, load64(si + 16), load64(si + 32), load64(si + 24));
    var foot = flac_br_byte_pos(br) - 1;
    var kb = alloc(fn_);
    memcpy(kb, fb, fn_);
    store8(kb + foot, load8(kb + foot) ^ 0x01);
    assert_eq(codec_open(kb, fn_), err(ERR_DECODE), "flac with a bad footer: one-shot refuses");
    # The first piece ends inside the footer, so the frame is whole but for it.
    got = _fxs_run(kb, fn_, 3, foot, 0);
    assert_eq(_fxs_errors, 1, "flac with a bad footer: the stream refuses");
    assert_eq(vec_len(got), 0, "flac with a bad footer: no samples from that frame");

    # decode_reader refuses what it cannot stream, once, and ends on flush.
    var mb = alloc(strlen(_FX_MP344_B64) + 16);
    var mn = _mp3_b64_decode(_FX_MP344_B64, mb);
    got = _fxs_run(mb, mn, 0, 5, 64);
    assert_eq(_fxs_errors, 1, "decode_reader refuses mp3 once");
    assert_eq(_fxs_last_err, err(ERR_UNSUPPORTED_FMT), "decode_reader: unsupported format");
    assert_eq(_fxs_ends, 1, "decode_reader refused stream still ends");
    got = _fxs_run(mb, 5, 0, 1, 64);
    assert_eq(_fxs_last_err, err(ERR_INVALID_HEADER), "decode_reader: too short to detect");
    return 0;
}

# A tag field equals the expected text (a Str, or 0 when absent).
fn _fx_tag_is(field, want, name) {
    assert_neq(field, 0, name);
    if (field == 0) { return 0; }
    var n = strlen(want);
    assert_eq(str_len(field), n, name);
    assert(memeq(str_data(field), want, n) == 1, name);
    return 0;
}

# Compressed ID3v2 frames, inflated with sankoch. No installed tool writes them,
# so the generator builds the tags from the specs and keeps them only if ffprobe
# (v2.4) and mutagen (v2.3) read them back. Grouped frames are read per the spec;
# both references take the group byte for the text encoding and drop the frame.
# Encrypted frames are skipped.
fn test_interop_id3_compressed() {
    syscall(1, 1, "test: id3v2 compressed frames (sankoch)\n", 40);
    var title = "Compressed Title xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx";
    var b = alloc(strlen(_FX_ID3V23Z_B64) + 16);
    var n = _mp3_b64_decode(_FX_ID3V23Z_B64, b);
    var m = tag_read_id3v2(b, n);
    assert(res_ok(m) == 1, "id3v2.3 tag reads");
    if (res_ok(m) == 1) {
        _fx_tag_is(tag_meta_title(m), title, "id3v2.3 compressed title");
        _fx_tag_is(tag_meta_artist(m), "Grouped Artist", "id3v2.3 grouped artist");
        _fx_tag_is(tag_meta_album(m), "Plain Album", "id3v2.3 plain album");
        assert_eq(tag_meta_genre(m), 0, "id3v2.3 encrypted genre skipped");
    }
    b = alloc(strlen(_FX_ID3V24Z_B64) + 16);
    n = _mp3_b64_decode(_FX_ID3V24Z_B64, b);
    m = tag_read_id3v2(b, n);
    assert(res_ok(m) == 1, "id3v2.4 tag reads");
    if (res_ok(m) == 1) {
        _fx_tag_is(tag_meta_title(m), title, "id3v2.4 compressed title");
        _fx_tag_is(tag_meta_artist(m), "Grouped Artist", "id3v2.4 grouped artist");
        _fx_tag_is(tag_meta_album(m), "Plain Album", "id3v2.4 compressed + unsynchronised album");
        _fx_tag_is(tag_meta_comment(m), "Compressed comment", "id3v2.4 compressed comment");
        assert_eq(tag_meta_genre(m), 0, "id3v2.4 encrypted genre skipped");
    }
    # v2.2 with the whole-tag compression bit: the spec says ignore the tag.
    b = alloc(strlen(_FX_ID3V22Z_B64) + 16);
    n = _mp3_b64_decode(_FX_ID3V22Z_B64, b);
    m = tag_read_id3v2(b, n);
    assert(res_ok(m) == 1, "id3v2.2 compressed tag: not an error");
    if (res_ok(m) == 1) { assert_eq(tag_meta_title(m), 0, "id3v2.2 compressed tag ignored"); }

    # The whole tag shares a 1 MiB inflate budget: five frames each declaring the
    # 256 KiB per-frame maximum get four through. (The fixture's compressed TIT2
    # frame, copied under five IDs, its size indicator raised to 262144.)
    b = alloc(strlen(_FX_ID3V24Z_B64) + 16);
    n = _mp3_b64_decode(_FX_ID3V24Z_B64, b);
    var flen = 10 + tag_syncsafe(b, 10 + 4);
    var t5 = alloc(10 + flen * 5 + 16);
    memcpy(t5, b, 10);
    var ids = "TIT2TPE1TALBTRCKTYER";
    for (var k = 0; k < 5; k = k + 1) {
        var f = t5 + 10 + k * flen;
        memcpy(f, b + 10, flen);
        memcpy(f, ids + k * 4, 4);
        store8(f + 10, 0x00); store8(f + 11, 0x10); store8(f + 12, 0x00); store8(f + 13, 0x00);
    }
    _tag_write_syncsafe(t5, 6, flen * 5);
    m = tag_read_id3v2(t5, 10 + flen * 5);
    assert(res_ok(m) == 1, "inflate budget: tag reads");
    if (res_ok(m) == 1) {
        _fx_tag_is(tag_meta_track_number(m), title, "inflate budget: fourth frame inflates");
        assert_eq(tag_meta_year(m), 0, "inflate budget: fifth frame refused");
    }

    # A frame claiming more than the per-frame limit, or zlib that does not
    # decode, is skipped, not trusted.
    b = alloc(strlen(_FX_ID3V24Z_B64) + 16);
    n = _mp3_b64_decode(_FX_ID3V24Z_B64, b);
    # TIT2's size indicator, after its 10-byte frame header, set to 512 KiB: over
    # the per-frame limit, inside the tag's budget.
    _tag_write_syncsafe(b, 10 + 10, 524288);
    m = tag_read_id3v2(b, n);
    if (res_ok(m) == 1) { assert_eq(tag_meta_title(m), 0, "oversized compressed frame skipped"); }
    _tag_write_syncsafe(b, 10 + 10, 1 << 27);
    m = tag_read_id3v2(b, n);
    if (res_ok(m) == 1) { assert_eq(tag_meta_title(m), 0, "128 MiB compressed frame skipped"); }
    b = alloc(strlen(_FX_ID3V24Z_B64) + 16);
    n = _mp3_b64_decode(_FX_ID3V24Z_B64, b);
    store8(b + 10 + 10 + 4, load8(b + 10 + 10 + 4) ^ 0xFF);   # the zlib header byte after it
    m = tag_read_id3v2(b, n);
    if (res_ok(m) == 1) {
        assert_eq(tag_meta_title(m), 0, "corrupt zlib frame skipped");
        _fx_tag_is(tag_meta_artist(m), "Grouped Artist", "frames after a corrupt one still read");
    }
    return 0;
}

# f64 to f32 rounds to nearest, ties to even, as C's (float) does: the expected
# bits are Python's struct.pack('<f'), and FLT_MAX plus half a step is infinity.
fn test_f32_rounding() {
    syscall(1, 1, "test: f64 -> f32 rounds to nearest even\n", 40);
    assert_eq(f64_to_f32_bits(4591870180066957722), 0x3DCCCCCD, "0.1 rounds up");
    assert_eq(f64_to_f32_bits(4599676419421066581), 0x3EAAAAAB, "1/3 rounds up");
    assert_eq(f64_to_f32_bits(13827852295878370918), 0xBF333333, "-0.7");
    assert_eq(f64_to_f32_bits(4008604054463141788), 0x000116C2, "1e-40 stays subnormal");
    assert_eq(f64_to_f32_bits(3931642474694443008), 0, "2^-150 ties to zero");
    assert_eq(f64_to_f32_bits(3933894274508128256), 1, "1.5 * 2^-150 rounds to 2^-149");
    assert_eq(f64_to_f32_bits(3938397874135498752), 2, "1.5 * 2^-149 ties to even");
    assert_eq(f64_to_f32_bits(5183643170835005440), 0x7F800000, "FLT_MAX + half step overflows");
    assert_eq(f64_to_f32_bits(4607182418709945415), 0x3F800000, "0.99999999 rounds to 1");
    assert_eq(f64_to_f32_bits(4607182418531581952), 0x3F800000, "1 - 2^-25 ties up to 1");
    assert_eq(f64_to_f32_bits(4607182418128928768), 0x3F7FFFFF, "1 - 2^-24 - 2^-26 rounds down");
    return 0;
}

# Found by fuzz_decode: a fresh decoder whose first packet sets the LBRR flag on a
# 60 ms SILK frame read the LBRR iCDF before any table was built (a null pointer;
# libopus never writes such a first packet). The suite runs warm, so the tables
# are cleared first to stand for a fresh process. The packet is the fuzzer's,
# shrunk: SILK WB 60 ms, mono, two payload bytes.
fn test_opus_cold_lbrr() {
    syscall(1, 1, "test: opus first packet with LBRR, cold tables\n", 47);
    _silk_lbrr2 = 0;
    _silk_lbrr3 = 0;
    _silk_ec_sel_nb = 0;
    var raw = alloc(16);
    write_u32_le(raw, 0, 3);
    store8(raw + 4, 0x58); store8(raw + 5, 0x33); store8(raw + 6, 0xD2);
    var r = _fx_opus_packets(raw, 7, 1);
    assert(r != 0, "opus cold LBRR packet: returns instead of crashing");
    return 0;
}

# The 2.9.3 ALAC/MP4 bounds audit: each fixture stands for a finding.
fn test_interop_mp4_audit() {
    syscall(1, 1, "test: mp4 bounds audit findings\n", 32);
    # F1: constant sample size 1, as many samples as bytes (16x in sample tables).
    assert(is_err(_fx_decode(_FX_MP4CONST1_B64, _FX_KIND_CODEC)) == 1, "mp4 constant size-1 sample table refused");
    # F2: chunks pointing many AAC samples at one access unit (the staging copy was their sum).
    assert(is_err(_fx_decode(_FX_MP4OVERLAP_B64, _FX_KIND_CODEC)) == 1, "mp4 overlapping samples refused");
    # F4: an AU too long for the ADTS bridge, and channel configuration 7.
    assert_eq(_fx_decode(_FX_MP4BIGAU_B64, _FX_KIND_CODEC), err(ERR_DECODE), "mp4 AAC access unit over 8184 bytes");
    assert_eq(_fx_decode(_FX_MP4ASCCH7_B64, _FX_KIND_CODEC), err(ERR_UNSUPPORTED_FMT), "mp4 AAC channel config 7");
    # ... and an explicit rate (22000 Hz) ADTS has no index for; ffmpeg refuses it too.
    assert_eq(_fx_decode(_FX_MP4RATE_B64, _FX_KIND_CODEC), err(ERR_UNSUPPORTED_FMT), "mp4 AAC explicit 22000 Hz rate");
    # F3: the audio trak behind a 64-bit size header, decoded as ffmpeg decodes it.
    _fx_exact("mp4 trak with a 64-bit size", _FX_MP4LARGETRAK_B64, 8000, 1, 16, _FX_MP4LARGETRAK_COUNT, _FX_MP4LARGETRAK_HASH);
    # F5: a QuickTime v2 entry whose f64 rate is negative. The demuxer reports 0
    # (unknown) rather than the negative value; ALAC takes its rate from the cookie.
    var b = alloc(strlen(_FX_ALACMOV_B64) + 16);
    var n = _mp3_b64_decode(_FX_ALACMOV_B64, b);
    var at = 0;
    var i = 0;
    while (i + 4 <= n) {
        if (load8(b + i) == 0x73) { if (load8(b + i + 1) == 0x74) { if (load8(b + i + 2) == 0x73) { if (load8(b + i + 3) == 0x64) {
                        if (at == 0) { at = i; }
                    }}}}
        i = i + 1;
    }
    assert(at > 0, "alac mov has an stsd");
    var neg = 0xC0F7700000000000;            # -96000.0
    var k = 0;
    while (k < 8) { store8(b + at + 52 + k, (neg >> (56 - k * 8)) & 0xFF); k = k + 1; }
    var dx = mp4_demux(b, n);
    assert(res_ok(dx) == 1, "mp4 v2 negative rate: demux ok");
    if (res_ok(dx) == 1) { assert(load64(dx + MP4_DX_RATE) >= 0, "mp4 v2 negative rate: not reported negative"); }
    var r = codec_open(b, n);
    assert(res_ok(r) == 1, "mp4 v2 negative rate: decodes");
    if (res_ok(r) == 1) {
        assert_eq(fmtinfo_sample_rate(decode_result_info(r)), 96000, "mp4 v2 negative rate: rate from the cookie");
        assert_eq(_fx_hash(decode_result_samples(r), 16), _FX_ALACMOV_HASH, "mp4 v2 negative rate: same samples");
    }
    return 0;
}

fn test_interop_all() {
    test_interop_flac();
    test_interop_flac_midside_exact();
    test_interop_alac();
    test_interop_aac_tables();
    test_interop_aac();
    test_interop_mp3();
    test_interop_mp4_boxes();
    test_interop_opus();
    test_opus_multistream_refused();
    test_interop_mpeg_conformance();
    test_interop_aiff();
    test_pcm_quant_inverse();
    test_one_shot_ceiling();
    test_interop_wav();
    test_interop_flac_range_seek();
    test_interop_stream();
    test_interop_id3_compressed();
    test_f32_rounding();
    test_opus_cold_lbrr();
    test_interop_mp4_audit();
    return 0;
}
