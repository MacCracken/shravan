# ================================================================
# stream.cyr -- Streaming decoders (chunk-at-a-time)
# ================================================================
#
# Provides:
#   WAV:  wav_stream_new(chunk_frames),  wav_stream_feed, wav_stream_flush
#   FLAC: flac_stream_new(),             flac_stream_feed, flac_stream_flush
#   AIFF: aiff_stream_new(chunk_frames), aiff_stream_feed, aiff_stream_flush
#
# Feed bytes as they arrive, split anywhere; every call returns a vec of events:
#   type 0 = HEADER  -> FormatInfo pointer, once the header is complete. Its frame
#                       count and duration are the declared ones (0 if unknown).
#   type 1 = SAMPLES -> vec of interleaved f64 samples
#   type 2 = END     -> 0, from flush
#   type 3 = ERROR   -> packed error; the stream decodes nothing further
#
# The decoders are incremental. Each decodes what has arrived, keeps only the
# bytes of an unfinished chunk or frame, and has no length ceiling, so a stream is
# how to decode a file past the one-shot limit (shravan_set_max_samples). WAV and
# AIFF emit SAMPLES of exactly chunk_frames frames, the last one shorter; FLAC
# emits one SAMPLES per FLAC frame. However the input is split, the samples are
# identical to the one-shot decoders'.
#
# Until 2.9.3 these buffered the whole input and ran the one-shot decoder on it.
# WAV and AIFF decoded the first feed that held a complete header, truncated to
# whatever had arrived, and ignored every later byte; FLAC re-decoded from its
# last seek point on every feed, so a minute of audio took minutes to stream.
#
# Requires: shravan.cyr (_wav_header, _aiff_header, converters), flac.cyr.

# ================================================================
# Stream event types
# ================================================================

var STREAM_EVT_HEADER  = 0;
var STREAM_EVT_SAMPLES = 1;
var STREAM_EVT_END     = 2;
var STREAM_EVT_ERROR   = 3;

# ================================================================
# Stream event struct (16 bytes on heap)
# ================================================================
#   +0: type (i64)
#   +8: data_ptr (i64)

fn stream_evt_new(type, data_ptr) {
    var evt = alloc(16);
    store64(evt, type);
    store64(evt + 8, data_ptr);
    return evt;
}

fn stream_evt_type(evt) { return load64(evt); }
fn stream_evt_data(evt) { return load64(evt + 8); }

# For decode_reader in shravan.cyr, which names no stream.cyr variable: a file that
# includes shravan.cyr without this one still compiles while the reader is unused.
fn stream_evt_error(e) { return stream_evt_new(STREAM_EVT_ERROR, e); }
fn stream_evt_end() { return stream_evt_new(STREAM_EVT_END, 0); }

# ================================================================
# Shared input buffer
# ================================================================
#
# Every stream struct starts with:
#   +0  state     +8  buffer     +16 bytes buffered   +24 capacity
#   +32 read position (bytes before it are consumed)
#   +40 retry threshold: a decode that ran out of bytes is not retried until this
#       many are buffered. The threshold doubles after each miss, so a frame or
#       header fed a few bytes at a time is parsed O(log n) times, not O(n).

var _ST_HEADER = 0;    # waiting for a complete header
var _ST_DATA   = 1;    # decoding
var _ST_DONE   = 2;    # flushed
var _ST_FAILED = 3;    # an ERROR event has been sent

# Input held without completing a frame or chunk before the stream gives up, and
# the most a SAMPLES chunk may span: a header declaring 65535 channels would
# otherwise have a 4096-frame chunk wait for 2 GB. Headers get more room, since
# FLAC metadata may carry a large picture.
var _ST_MAX_PENDING = 16777216;
var _ST_MAX_HEADER = 67108864;

fn _st_new(size) {
    var dec = alloc(size);
    memset(dec, 0, size);
    store64(dec + 8, alloc(4096));
    store64(dec + 24, 4096);
    return dec;
}

# Append len bytes. Consumed bytes are dropped (the live tail moves to the front)
# before the buffer grows, so it stays near the size of one chunk or frame.
fn _st_append(dec, data, len) {
    if (len <= 0) { return 0; }
    var buf = load64(dec + 8);
    var blen = load64(dec + 16);
    var bcap = load64(dec + 24);
    var rpos = load64(dec + 32);
    if (blen + len > bcap) {
        if (rpos > 0) {
            memcpy(buf, buf + rpos, blen - rpos);   # forward copy: safe for this overlap
            blen = blen - rpos;
            store64(dec + 40, load64(dec + 40) - rpos);
            rpos = 0;
            store64(dec + 32, 0);
            store64(dec + 16, blen);
        }
    }
    if (blen + len > bcap) {
        var new_cap = bcap * 2;
        if (new_cap < blen + len) { new_cap = blen + len; }
        var new_buf = alloc(new_cap);
        if (new_buf == 0) { return err(ERR_DECODE); }
        memcpy(new_buf, buf, blen);
        buf = new_buf;
        store64(dec + 8, buf);
        store64(dec + 24, new_cap);
    }
    memcpy(buf + blen, data, len);
    store64(dec + 16, blen + len);
    return 0;
}

# A decode attempt ran out of bytes: wait for twice what is buffered past rpos.
fn _st_miss(dec) {
    var live = load64(dec + 16) - load64(dec + 32);
    var more = live;
    if (more < 1024) { more = 1024; }
    store64(dec + 40, load64(dec + 16) + more);
    return 0;
}

fn _st_ready(dec) { return load64(dec + 16) >= load64(dec + 40); }

fn _st_fail(dec, events, e) {
    store64(dec, _ST_FAILED);
    vec_push(events, stream_evt_new(STREAM_EVT_ERROR, e));
    return 0;
}

fn _st_finish(dec, events) {
    if (load64(dec) != _ST_FAILED) { store64(dec, _ST_DONE); }
    vec_push(events, stream_evt_new(STREAM_EVT_END, 0));
    return events;
}

# ================================================================
# WAV and AIFF streaming decoder
# ================================================================
#
# After the shared header:
#   +48 chunk_frames   +56 header facts (_wav_header / _aiff_header layout)
#   +64 audio bytes still to come (the declared size; one-shot clamps it the same)
#   +72 sample layout (_PL_*)   +80 channels   +88 kind (1 = WAV, 2 = AIFF)

fn _pcm_stream_new(kind, chunk_frames) {
    var dec = _st_new(96);
    var cf = chunk_frames;
    if (cf <= 0) { cf = 4096; }
    if (cf > 16777216) { cf = 16777216; }
    store64(dec + 48, cf);
    store64(dec + 56, alloc(56));
    store64(dec + 88, kind);
    return dec;
}

# n bytes (whole samples) of audio as a new vec. Streams sit outside the one-shot
# ceiling; the chunk size bounds each vec.
fn _pcm_stream_convert(dec, ptr, n) {
    var pl = load64(dec + 72);
    var count = n / _pl_bytes(pl);
    var v = _vec_alloc(count);
    if (is_err(v) == 1) { return v; }
    return _pcm_into(v, pl, ptr, count);
}

# Parse the header once it has arrived. Returns 1 when decoding can start.
fn _pcm_stream_header(dec, events, final) {
    var buf = load64(dec + 8);
    var blen = load64(dec + 16);
    if (final == 0) { if (_st_ready(dec) == 0) { return 0; } }
    var h = load64(dec + 56);
    var kind = load64(dec + 88);
    var r = 0;
    if (kind == 1) { r = _wav_header(buf, blen, h); } else { r = _aiff_header(buf, blen, h); }
    if (is_err(r) == 1) { _st_fail(dec, events, r); return 0; }
    if (r == 0) {
        if (final == 1) {
            if (blen > 0) { _st_fail(dec, events, err(ERR_INVALID_HEADER)); }
            return 0;
        }
        if (blen > _ST_MAX_HEADER) { _st_fail(dec, events, err(ERR_INVALID_HEADER)); return 0; }
        _st_miss(dec);
        return 0;
    }

    var ch = 0;
    var rate = 0;
    var pl = 0;
    var bits = 0;
    var declared = 0;
    var fmt = FMT_WAV;
    if (kind == 1) {
        ch = load64(h + 8);
        rate = load64(h + 16);
        pl = _wav_layout(load64(h), load64(h + 24));
        bits = load64(h + 24);
        if (load64(h + 32) > 0) { bits = load64(h + 32); }
        declared = load64(h + 48);
    } else {
        fmt = FMT_AIFF;
        ch = load64(h);
        rate = load64(h + 16);
        pl = _aiff_layout(h);
        bits = load64(h + 8);
        declared = load64(h + 48);
    }
    if (pl == 0) { _st_fail(dec, events, err(ERR_UNSUPPORTED_FMT)); return 0; }

    var frames = 0;
    if (declared != 0xFFFFFFFF) { frames = declared / (_pl_bytes(pl) * ch); }
    var dur = f64_div(f64_from(frames), f64_from(rate));
    vec_push(events, stream_evt_new(STREAM_EVT_HEADER, fmtinfo_new(fmt, rate, ch, bits, dur, frames)));

    var frame_bytes = _pl_bytes(pl) * ch;
    if (load64(dec + 48) * frame_bytes > _ST_MAX_PENDING) {
        var cf = _ST_MAX_PENDING / frame_bytes;
        if (cf < 1) { cf = 1; }
        store64(dec + 48, cf);
    }

    store64(dec + 32, load64(h + 40));
    store64(dec + 40, 0);
    store64(dec + 64, declared);
    store64(dec + 72, pl);
    store64(dec + 80, ch);
    store64(dec, _ST_DATA);
    return 1;
}

# Emit every complete chunk, then the rest, in whole samples as the one-shot
# decoders give it, once no more audio can arrive.
fn _pcm_stream_run(dec, events, final) {
    if (load64(dec) == _ST_HEADER) {
        if (_pcm_stream_header(dec, events, final) == 0) { return 0; }
    }
    if (load64(dec) != _ST_DATA) { return 0; }

    var buf = load64(dec + 8);
    var rpos = load64(dec + 32);
    var left = load64(dec + 64);
    var w = _pl_bytes(load64(dec + 72));
    var avail = load64(dec + 16) - rpos;
    if (avail > left) { avail = left; }
    var chunk = load64(dec + 48) * w * load64(dec + 80);
    var going = 1;
    while (going == 1) {
        var n = chunk;
        if (avail < chunk) {
            # A short chunk goes out once nothing more can join it: at flush, or
            # when everything the header declared has arrived.
            n = 0;
            if ((final == 1) | (avail == left)) { n = (avail / w) * w; }
        }
        if (n == 0) { going = 0; }
        else {
            var sv = _pcm_stream_convert(dec, buf + rpos, n);
            if (is_err(sv) == 1) { _st_fail(dec, events, sv); return 0; }
            vec_push(events, stream_evt_new(STREAM_EVT_SAMPLES, sv));
            rpos = rpos + n;
            left = left - n;
            avail = avail - n;
        }
    }
    store64(dec + 32, rpos);
    store64(dec + 64, left);
    return 0;
}

fn _pcm_stream_feed(dec, data, len) {
    var events = vec_new();
    var state = load64(dec);
    if (state == _ST_DONE) { return events; }
    if (state == _ST_FAILED) { return events; }
    var a = _st_append(dec, data, len);
    if (is_err(a) == 1) { _st_fail(dec, events, a); return events; }
    _pcm_stream_run(dec, events, 0);
    return events;
}

fn _pcm_stream_flush(dec) {
    var events = vec_new();
    var state = load64(dec);
    if ((state == _ST_HEADER) | (state == _ST_DATA)) { _pcm_stream_run(dec, events, 1); }
    return _st_finish(dec, events);
}

fn wav_stream_new(chunk_frames) { return _pcm_stream_new(1, chunk_frames); }
fn wav_stream_feed(dec, data, len) { return _pcm_stream_feed(dec, data, len); }
fn wav_stream_flush(dec) { return _pcm_stream_flush(dec); }

fn aiff_stream_new(chunk_frames) { return _pcm_stream_new(2, chunk_frames); }
fn aiff_stream_feed(dec, data, len) { return _pcm_stream_feed(dec, data, len); }
fn aiff_stream_flush(dec) { return _pcm_stream_flush(dec); }

# ================================================================
# FLAC streaming decoder
# ================================================================
#
# After the shared header:
#   +48 STREAMINFO (flac_parse_metadata)   +56 bit reader over the buffer

# Bytes of FLAC metadata including the magic, or 0 if the buffer ends inside it.
fn _flac_meta_len(data, len) {
    var pos = 4;
    while (pos + 4 <= len) {
        var hdr = load8(data + pos);
        var bsz = (load8(data + pos + 1) << 16) | (load8(data + pos + 2) << 8) | load8(data + pos + 3);
        pos = pos + 4 + bsz;
        if (pos > len) { return 0; }
        if ((hdr & 0x80) != 0) { return pos; }
    }
    return 0;
}

fn flac_stream_new() {
    var dec = _st_new(64);
    store64(dec + 56, bitreader_new(0, 0));
    return dec;
}

fn _flac_stream_header(dec, events, final) {
    var buf = load64(dec + 8);
    var blen = load64(dec + 16);
    if (blen >= 4) {
        if (load8(buf) != 0x66) { _st_fail(dec, events, err(ERR_INVALID_HEADER)); return 0; }
        if (load8(buf + 1) != 0x4C) { _st_fail(dec, events, err(ERR_INVALID_HEADER)); return 0; }
        if (load8(buf + 2) != 0x61) { _st_fail(dec, events, err(ERR_INVALID_HEADER)); return 0; }
        if (load8(buf + 3) != 0x43) { _st_fail(dec, events, err(ERR_INVALID_HEADER)); return 0; }
    }
    if (final == 0) { if (_st_ready(dec) == 0) { return 0; } }
    var mlen = 0;
    if (blen >= 4) { mlen = _flac_meta_len(buf, blen); }
    if (mlen == 0) {
        if (final == 1) {
            if (blen > 0) { _st_fail(dec, events, err(ERR_INVALID_HEADER)); }
            return 0;
        }
        if (blen > _ST_MAX_HEADER) { _st_fail(dec, events, err(ERR_INVALID_HEADER)); return 0; }
        _st_miss(dec);
        return 0;
    }
    var si = flac_parse_metadata(buf, mlen);
    if (is_err(si) == 1) { _st_fail(dec, events, si); return 0; }
    var rate = load64(si + 16);
    if (rate == 0) { _st_fail(dec, events, err(ERR_INVALID_RATE)); return 0; }
    var total = load64(si + 40);
    var dur = f64_div(f64_from(total), f64_from(rate));
    vec_push(events, stream_evt_new(STREAM_EVT_HEADER,
        fmtinfo_new(FMT_FLAC, rate, load64(si + 24), load64(si + 32), dur, total)));
    store64(dec + 48, si);
    store64(dec + 32, mlen);
    store64(dec + 40, 0);
    store64(dec, _ST_DATA);
    return 1;
}

# Decode every complete frame. A frame cut off by the end of the buffer waits for
# more bytes; on the final call it is an error, as it is to flac_decode, except a
# frame that is whole but for its CRC-16 footer, which both accept.
fn _flac_stream_run(dec, events, final) {
    if (load64(dec) == _ST_HEADER) {
        if (_flac_stream_header(dec, events, final) == 0) { return 0; }
    }
    if (load64(dec) != _ST_DATA) { return 0; }
    if (final == 0) { if (_st_ready(dec) == 0) { return 0; } }

    var buf = load64(dec + 8);
    var blen = load64(dec + 16);
    var si = load64(dec + 48);
    var br = load64(dec + 56);
    store64(br, buf);
    store64(br + 24, blen);
    var going = 1;
    while (going == 1) {
        var rpos = load64(dec + 32);
        flac_br_set_pos(br, rpos);
        var bs = _flac_frame(br, buf, blen, load64(si + 16), load64(si + 32), load64(si + 24));
        var whole = 0;
        if (bs > 0) {
            whole = _flac_f_crc;
            if (final == 1) { whole = 1; }
        }
        if (whole == 1) {
            var sv = _vec_alloc(bs * _flac_f_ch);
            if (is_err(sv) == 1) { _st_fail(dec, events, sv); return 0; }
            _flac_emit(sv, 0, bs);
            vec_push(events, stream_evt_new(STREAM_EVT_SAMPLES, sv));
            store64(dec + 32, flac_br_byte_pos(br));
            store64(dec + 40, 0);
        } else {
            going = 0;
            var short = 0;
            if (bs == 0) { short = 1; }
            if (bs > 0) { short = 1; }
            if (bs == err(ERR_END_OF_STREAM)) { short = 1; }
            if (short == 0) { _st_fail(dec, events, bs); return 0; }
            if (final == 1) {
                if (is_err(bs) == 1) { _st_fail(dec, events, bs); }
                return 0;
            }
            if (blen - rpos > _ST_MAX_PENDING) { _st_fail(dec, events, err(ERR_DECODE)); return 0; }
            _st_miss(dec);
        }
    }
    return 0;
}

fn flac_stream_feed(dec, data, len) {
    var events = vec_new();
    var state = load64(dec);
    if (state == _ST_DONE) { return events; }
    if (state == _ST_FAILED) { return events; }
    var a = _st_append(dec, data, len);
    if (is_err(a) == 1) { _st_fail(dec, events, a); return events; }
    _flac_stream_run(dec, events, 0);
    return events;
}

fn flac_stream_flush(dec) {
    var events = vec_new();
    var state = load64(dec);
    if ((state == _ST_HEADER) | (state == _ST_DATA)) { _flac_stream_run(dec, events, 1); }
    return _st_finish(dec, events);
}

# ================================================================
# Tests
# ================================================================

fn test_stream() {
    test_group("stream");

    # ---- Helper: build a minimal 16-bit mono PCM WAV in memory ----
    # Header: 44 bytes, then 200 samples * 2 bytes = 400 bytes data
    var n_samples = 200;
    var wav_data_len = 44 + n_samples * 2;
    var wav_data = alloc(wav_data_len);

    # RIFF header
    store8(wav_data, 0x52); store8(wav_data+1, 0x49);   # RI
    store8(wav_data+2, 0x46); store8(wav_data+3, 0x46);  # FF
    write_u32_le(wav_data, 4, wav_data_len - 8);         # file size - 8
    store8(wav_data+8, 0x57); store8(wav_data+9, 0x41);  # WA
    store8(wav_data+10, 0x56); store8(wav_data+11, 0x45); # VE

    # fmt chunk
    store8(wav_data+12, 0x66); store8(wav_data+13, 0x6D); # fm
    store8(wav_data+14, 0x74); store8(wav_data+15, 0x20); # t<space>
    write_u32_le(wav_data, 16, 16);        # chunk size
    write_u16_le(wav_data, 20, 1);         # PCM format
    write_u16_le(wav_data, 22, 1);         # 1 channel
    write_u32_le(wav_data, 24, 44100);     # sample rate
    write_u32_le(wav_data, 28, 88200);     # byte rate
    write_u16_le(wav_data, 32, 2);         # block align
    write_u16_le(wav_data, 34, 16);        # bits per sample

    # data chunk
    store8(wav_data+36, 0x64); store8(wav_data+37, 0x61); # da
    store8(wav_data+38, 0x74); store8(wav_data+39, 0x61); # ta
    write_u32_le(wav_data, 40, n_samples * 2);

    # Fill samples: ramp from 0 to n_samples-1 as i16
    var si = 0;
    while (si < n_samples) {
        var val = si * 100;
        if (val > 32767) { val = 32767; }
        write_u16_le(wav_data, 44 + si * 2, val & 0xFFFF);
        si = si + 1;
    }

    # --- Test: WAV stream single feed ---
    var dec1 = wav_stream_new(4096);
    var evts1 = wav_stream_feed(dec1, wav_data, wav_data_len);
    var flush1 = wav_stream_flush(dec1);

    # Count events from feed
    var got_header = 0;
    var got_samples = 0;
    var ei = 0;
    while (ei < vec_len(evts1)) {
        var evt = vec_get(evts1, ei);
        var etype = stream_evt_type(evt);
        if (etype == STREAM_EVT_HEADER) { got_header = 1; }
        if (etype == STREAM_EVT_SAMPLES) { got_samples = 1; }
        ei = ei + 1;
    }
    assert(got_header == 1, "wav stream single feed: got header");
    assert(got_samples == 1, "wav stream single feed: got samples");

    # Flush should have END
    var got_end = 0;
    ei = 0;
    while (ei < vec_len(flush1)) {
        var evt = vec_get(flush1, ei);
        if (stream_evt_type(evt) == STREAM_EVT_END) { got_end = 1; }
        ei = ei + 1;
    }
    assert(got_end == 1, "wav stream single feed: flush has END");

    # --- Test: WAV stream small chunks (feed 50 bytes at a time) ---
    var dec2 = wav_stream_new(64);
    var all_evts = vec_new();
    var chunk_size = 50;
    var off = 0;
    while (off < wav_data_len) {
        var remain = wav_data_len - off;
        var feed_len = chunk_size;
        if (feed_len > remain) { feed_len = remain; }
        var evts = wav_stream_feed(dec2, wav_data + off, feed_len);
        if (is_err(evts) == 0) {
            ei = 0;
            while (ei < vec_len(evts)) {
                vec_push(all_evts, vec_get(evts, ei));
                ei = ei + 1;
            }
        }
        off = off + feed_len;
    }
    var flush2 = wav_stream_flush(dec2);
    ei = 0;
    while (ei < vec_len(flush2)) {
        vec_push(all_evts, vec_get(flush2, ei));
        ei = ei + 1;
    }

    got_header = 0;
    got_samples = 0;
    got_end = 0;
    ei = 0;
    while (ei < vec_len(all_evts)) {
        var evt = vec_get(all_evts, ei);
        var etype = stream_evt_type(evt);
        if (etype == STREAM_EVT_HEADER) { got_header = 1; }
        if (etype == STREAM_EVT_SAMPLES) { got_samples = 1; }
        if (etype == STREAM_EVT_END) { got_end = 1; }
        ei = ei + 1;
    }
    assert(got_header == 1, "wav stream small chunks: got header");
    assert(got_samples == 1, "wav stream small chunks: got samples");
    assert(got_end == 1, "wav stream small chunks: got END");

    # --- Test: flush on empty produces END ---
    var dec3 = wav_stream_new(4096);
    var flush3 = wav_stream_flush(dec3);
    assert_eq(vec_len(flush3), 1, "empty flush: one event");
    var evt3 = vec_get(flush3, 0);
    assert_eq(stream_evt_type(evt3), STREAM_EVT_END, "empty flush: is END");

    # (format info test removed — buffer-then-decode doesn't expose intermediate state)

    return 0;
}
