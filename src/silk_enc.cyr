# ================================================================
# silk_enc.cyr -- SILK encoder: analysis, noise shaping quantiser, frame
# ================================================================
#
# A port of libopus's float SILK encoder (silk/float/*_FLP.c over the fixed
# point silk/*.c it calls), in f64. Where libopus computes in single precision
# shravan computes in double, so the float stages agree with libopus to float
# precision, not to the bit; every float->fixed boundary rounds as libopus's
# lrintf does (half to even, _sk_lrint), and the fixed-point stages are exact.
# src/silk_tests.cyr checks each stage against libopus on libopus's own inputs
# (src/silk_enc_vectors.cyr, from scripts/gen-silk-vectors.py).
#
# The quantisers and bitstream writers (gains, NLSF, indices, pulses) are in
# src/silk.cyr since 2.8.0. Here, by release:
#   2.11.0  LPC analysis: silk_burg_modified_FLP, silk_find_LPC_FLP (with the NLSF
#           interpolation search), silk_process_NLSFs, silk_residual_energy_FLP,
#           and the unvoiced branch of silk_find_pred_coefs_FLP.
#   2.11.1  The encoder's parameters (silk_setup_complexity, silk_setup_fs,
#           silk_control_SNR), the VAD (silk_VAD_GetSA_Q8, fixed point), the LPC
#           residual of the pitch analysis (silk_find_pitch_lags_FLP up to its
#           voicing decision), silk_noise_shape_analysis_FLP and
#           silk_process_gains_FLP.
#   2.11.2  The noise shaping quantiser silk_NSQ (fixed point, 32-bit wrapping,
#           exact) and the float->fixed conversion in front of it
#           (silk_NSQ_wrapper_FLP).
#   2.11.3  The frame (silk_encode_frame_FLP: the stages in order and the rate
#           loop over a gain multiplier), the packet (silk_Encode, mono: input
#           buffering, the per-frame bit targets and reservoir, the VAD and LBRR
#           flags patched into the first bits), the public encoder
#           (silk_encoder_new, silk_encode, silk_encode_opus) and the Opus packet
#           around a SILK payload.
#   2.12.0  The voiced path: pitch estimation (silk_pitch_analysis_core_FLP,
#           its fixed-point decimators, the voicing decision in
#           silk_find_pitch_lags_FLP), long-term prediction (silk_find_LTP_FLP,
#           silk_quant_LTP_gains with silk_VQ_WMat_EC, silk_LTP_scale_ctrl_FLP,
#           silk_LTP_analysis_filter_FLP, the voiced silk_find_pred_coefs_FLP),
#           silk_HP_variable_cutoff, and the packet loss setting.
#   2.12.1  The rest of mono silk_Encode: the input resampled from the API rate
#           (silk_resampler, encoder side), in-band FEC (silk_LBRR_encode_FLP and
#           the LBRR frames the next packet carries), DTX, silk_encoder_new_api.
#   2.12.2  Stereo: silk_stereo_LR_to_MS with its predictor search, quantiser and
#           index writers, and silk_Encode's two-channel path (the side's reset
#           after mid-only frames, moves between mono and stereo, stereo input
#           coded mono); silk_encoder_new_channels and the channel, toMono and
#           bit rate setters.

# ---------------------------------------------------------------- encoder state
#
# One SILK channel's encoder state (libopus silk_encoder_state_FLP, the parts
# this port uses), 8-byte words at fixed offsets. Arrays are inline.
var _SKE_FS_KHZ = 0;          # internal rate, 8, 12 or 16
var _SKE_NB_SUBFR = 8;        # 2 (10 ms) or 4 (20 ms)
var _SKE_SUBFR_LEN = 16;      # 5 ms of samples
var _SKE_FRAME_LEN = 24;
var _SKE_ORDER = 32;          # predictLPCOrder: 10 (NB, MB) or 16 (WB)
var _SKE_FIRST = 40;          # first_frame_after_reset
var _SKE_USE_INTERP = 48;     # useInterpolatedNLSFs
var _SKE_SURVIVORS = 56;      # NLSF_MSVQ_Survivors
var _SKE_SPEECH_Q8 = 64;      # speech_activity_Q8
var _SKE_SUM_LOG_GAIN = 72;   # sum_log_gain_Q7
var _SKE_IDX = 80;            # [64] side information indices, silk_encode_indices_ec's layout
var _SKE_PREV_NLSF = 592;     # [16] prev_NLSFq_Q15
var _SKE_LA_SHAPE = 720;      # la_shape: shaping lookahead
var _SKE_SHAPE_WIN = 728;     # shapeWinLength
var _SKE_SHAPE_ORDER = 736;   # shapingLPCOrder
var _SKE_WARPING_Q16 = 744;
var _SKE_PITCH_ORDER = 752;   # pitchEstimationLPCOrder
var _SKE_PITCH_WIN = 760;     # pitch_LPC_win_length
var _SKE_LA_PITCH = 768;
var _SKE_LTP_MEM = 776;       # ltp_mem_length
var _SKE_NSTATES = 784;       # nStatesDelayedDecision
var _SKE_SNR_Q7 = 792;        # SNR_dB_Q7
var _SKE_USE_CBR = 800;
var _SKE_TILT_Q15 = 808;      # input_tilt_Q15 (VAD)
var _SKE_QUALITY = 816;       # [4] input_quality_bands_Q15 (VAD)
var _SKE_PREV_SIGNAL = 848;   # prevSignalType
var _SKE_LTP_CORR = 856;      # LTPCorr, f64
var _SKE_HARM_SMTH = 864;     # sShape.HarmShapeGain_smth, f64
var _SKE_TILT_SMTH = 872;     # sShape.Tilt_smth, f64
var _SKE_LAST_GAIN = 880;     # sShape.LastGainIndex
var _SKE_VAD = 888;           # the VAD state (_SKD_)
var _SKE_NOSPEECH = 896;      # noSpeechCounter
var _SKE_INDTX = 904;
var _SKE_VAD_FLAGS = 912;     # [3]
var _SKE_NFRAMES_ENC = 936;   # nFramesEncoded
var _SKE_COMPLEXITY = 944;
var _SKE_TARGET_RATE = 952;   # TargetRate_bps
var _SKE_PREV_LAG = 960;
var _SKE_NSQ = 968;           # the noise shaping quantiser's state (_SKN_)
var _SKE_PULSES = 976;        # [320] the frame's pulses (ptr)
var _SKE_XBUF = 984;          # f64 [ltp_mem + 5 ms + frame]: history, the frame, 5 ms lookahead (ptr)
var _SKE_RES_PITCH = 992;     # f64 [la_pitch + frame + ltp_mem]: the pitch LPC residual (ptr)
var _SKE_FRAME_COUNTER = 1000;
var _SKE_ECPREV = 1008;       # [2] ec_prevSignalType, ec_prevLagIndex (the index writer's)
var _SKE_NSQ_COPY = 1024;     # [2] quantiser snapshots for the rate loop (ptrs)
var _SKE_EC_COPY = 1040;      # [2] range coder snapshots (ptrs)
var _SKE_EC_BUF_COPY = 1056;  # 1275 bytes: the payload under the lower snapshot (ptr)
var _SKE_PE_COMPLEXITY = 1064;  # pitchEstimationComplexity: 0, 1 or 2
var _SKE_PE_THRES_Q16 = 1072;   # pitchEstimationThreshold_Q16
var _SKE_HP_SMTH1 = 1080;     # variable_HP_smth1_Q15: the pitch-tracking high-pass cutoff (log2 Hz, Q15)
var _SKE_PACKET_LOSS = 1088;  # PacketLoss_perc: the expected loss, 0-100 (LTP scaling)
var _SKE_LBRR_FLAG = 1096;    # LBRR_flag: in-band FEC in this packet
var _SKE_NFRAMES_PP = 1104;   # nFramesPerPacket
var _SKE_LBRR_ENABLED = 1112; # LBRR_enabled: in-band FEC coded this packet (2.12.1)
var _SKE_LBRR_GAIN_INC = 1120;  # LBRR_GainIncreases: the LBRR frames' first gain, steps up
var _SKE_LBRR_FLAGS = 1128;   # [3] LBRR_flags: each frame of the packet has an LBRR copy
var _SKE_LBRR_PREV_GAIN = 1152; # LBRRprevLastGainIndex
var _SKE_LBRR_IDX = 1160;     # [3 x 64] indices_LBRR (ptr)
var _SKE_LBRR_PULSES = 1168;  # [3 x 320] pulses_LBRR (ptr)
var _SKE_LBRR_NSQ = 1176;     # the LBRR pass's quantiser state (ptr)
var _SKE_USE_DTX = 1184;      # useDTX
var _SKE_LP_STATE = 1192;     # [2] sLP.In_LP_State: the transition low-pass (2.12.3)
var _SKE_LP_TFN = 1208;       # sLP.transition_frame_no, 0 to 256
var _SKE_LP_MODE = 1216;      # sLP.mode: 0 off, 1 up, -2 down at double speed
var _SKE_LP_SAVED_FS = 1224;  # sLP.saved_fs_kHz
var _SKE_PACKET_MS = 1232;    # PacketSize_ms (0 before the first control)
var _SKE_PREV_API_HZ = 1240;  # prev_API_fs_Hz
var _SKE_SIZE = 1248;

# The indices (libopus SideInfoIndices), as silk_encode_indices_ec reads them.
var _SKI_SIGNAL_TYPE = 0;
var _SKI_QUANT_OFFSET = 1;
var _SKI_GAINS = 2;           # [4]
var _SKI_NLSF_INTERP = 11;
var _SKI_LAG = 12;
var _SKI_CONTOUR = 13;
var _SKI_PER = 14;
var _SKI_LTP_SCALE = 15;
var _SKI_SEED = 16;
var _SKI_NLSF = 18;           # [17] stage-1 index, then the residuals
var _SKI_LTP = 35;            # [4] wideband; the LTP indices follow the NLSF ones, at 19 + order
                              # (29 narrow- and mediumband), where silk_encode_indices_ec reads them

# n bytes at p zeroed a word at a time (the stdlib's memset goes a byte at a
# time); the states' buffers are whole words.
fn _sk_zero(p, n) {
    var i = 0;
    while (i + 8 <= n) { store64(p + i, 0); i = i + 8; }
    while (i < n) { store8(p + i, 0); i = i + 1; }
    return 0;
}

# silk_enc_state_alloc (2.12.3): a state with its buffers at their largest
# (16 kHz, 20 ms frames), as silk_init_encoder leaves it: internal rate 0,
# set by the first silk_control_encoder.
fn silk_enc_state_alloc() {
    var st = alloc(_SKE_SIZE);
    _sk_zero(st, _SKE_SIZE);
    store64(st + _SKE_VAD, alloc(_SKD_SIZE));
    store64(st + _SKE_NSQ, alloc(_SKN_SIZE));
    store64(st + _SKE_PULSES, alloc(320 * 8));
    store64(st + _SKE_XBUF, alloc(720 * 8));                 # 2 x 320 + LA_SHAPE_MAX 80
    store64(st + _SKE_RES_PITCH, alloc(672 * 8));            # 22 ms at 16 kHz + 320
    store64(st + _SKE_NSQ_COPY, alloc(_SKN_SIZE));
    store64(st + _SKE_NSQ_COPY + 8, alloc(_SKN_SIZE));
    store64(st + _SKE_EC_COPY, alloc(96));
    store64(st + _SKE_EC_COPY + 8, alloc(96));
    store64(st + _SKE_EC_BUF_COPY, alloc(1280));
    store64(st + _SKE_LBRR_IDX, alloc(3 * 64 * 8));
    store64(st + _SKE_LBRR_PULSES, alloc(3 * 320 * 8));
    store64(st + _SKE_LBRR_NSQ, alloc(_SKN_SIZE));
    silk_enc_state_reset(st);
    return st;
}

# A state set up at fs_kHz with nb_subfr subframes (4: 20 ms, 2: 10 ms) and
# complexity 1, as the first packet's control would leave it.
fn silk_enc_state_new(fs_kHz, nb_subfr) {
    var st = silk_enc_state_alloc();
    var ms = 20;
    if (nb_subfr == 2) { ms = 10; }
    _sk_setup_fs(st, fs_kHz, ms);
    silk_enc_setup_complexity(st, 1);
    return st;
}

# The state's buffers, by their fields' offsets, and room to keep them.
var _sk_state_bufs = 0;
var _sk_state_keep = 0;
fn _sk_state_bufs_init() {
    _sk_state_bufs = _sk_ints("888,968,976,984,992,1024,1032,1040,1048,1056,1160,1168,1176", 13);
    _sk_state_keep = alloc(13 * 8);
    return 0;
}

# silk_enc_state_reset: silk_init_encoder in place (the buffers kept, and
# cleared): everything zero but the VAD, the high-pass smoother at 60 Hz and
# the first-frame flag. The next control sets the rate and packet length.
fn silk_enc_state_reset(st) {
    if (_sk_state_bufs == 0) { _sk_state_bufs_init(); }
    var keep = _sk_state_keep;
    var i = 0;
    while (i < 13) { store64(keep + i * 8, load64(st + load64(_sk_state_bufs + i * 8))); i = i + 1; }
    _sk_zero(st, _SKE_SIZE);
    i = 0;
    while (i < 13) { store64(st + load64(_sk_state_bufs + i * 8), load64(keep + i * 8)); i = i + 1; }
    store64(st + _SKE_FIRST, 1);
    _sk_vad_init(load64(st + _SKE_VAD));
    _sk_zero(load64(st + _SKE_NSQ), _SKN_SIZE);
    _sk_zero(load64(st + _SKE_PULSES), 320 * 8);
    _sk_zero(load64(st + _SKE_XBUF), 720 * 8);
    _sk_zero(load64(st + _SKE_RES_PITCH), 672 * 8);
    _sk_zero(load64(st + _SKE_NSQ_COPY), _SKN_SIZE);
    _sk_zero(load64(st + _SKE_NSQ_COPY + 8), _SKN_SIZE);
    _sk_zero(load64(st + _SKE_EC_COPY), 96);
    _sk_zero(load64(st + _SKE_EC_COPY + 8), 96);
    _sk_zero(load64(st + _SKE_EC_BUF_COPY), 1280);
    _sk_zero(load64(st + _SKE_LBRR_IDX), 3 * 64 * 8);
    _sk_zero(load64(st + _SKE_LBRR_PULSES), 3 * 320 * 8);
    _sk_zero(load64(st + _SKE_LBRR_NSQ), _SKN_SIZE);
    # silk_init_encoder: the smoother starts at the lowest cutoff, 60 Hz
    store64(st + _SKE_HP_SMTH1, (silk_lin2log(60 << 16) - (16 << 7)) << 8);
    return st;
}

# silk_setup_fs (control_codec.c): a new packet length sets the frames a
# packet, subframes and frame length; a new internal rate resets the shaping,
# quantiser and NLSF history and the transition filter, and sets the rate's
# orders and lengths.
fn _sk_setup_fs(st, fs, ms) {
    if (ms != load64(st + _SKE_PACKET_MS)) {
        if (ms <= 10) {
            store64(st + _SKE_NFRAMES_PP, 1);
            var nbs = 1;
            if (ms == 10) { nbs = 2; }
            store64(st + _SKE_NB_SUBFR, nbs);
            store64(st + _SKE_FRAME_LEN, silk_smulbb(ms, fs));
            store64(st + _SKE_PITCH_WIN, silk_smulbb(14, fs));          # FIND_PITCH_LPC_WIN_MS_2_SF
        } else {
            store64(st + _SKE_NFRAMES_PP, silk_div_trunc(ms, 20));
            store64(st + _SKE_NB_SUBFR, 4);
            store64(st + _SKE_FRAME_LEN, silk_smulbb(20, fs));
            store64(st + _SKE_PITCH_WIN, silk_smulbb(24, fs));          # FIND_PITCH_LPC_WIN_MS
        }
        store64(st + _SKE_PACKET_MS, ms);
        store64(st + _SKE_TARGET_RATE, 0);
    }
    if (load64(st + _SKE_FS_KHZ) != fs) {
        store64(st + _SKE_HARM_SMTH, F64_ZERO);
        store64(st + _SKE_TILT_SMTH, F64_ZERO);
        _sk_nsq_init(load64(st + _SKE_NSQ));
        _sk_zero(st + _SKE_PREV_NLSF, 16 * 8);
        _sk_zero(st + _SKE_LP_STATE, 2 * 8);
        store64(st + _SKE_NFRAMES_ENC, 0);
        store64(st + _SKE_TARGET_RATE, 0);
        store64(st + _SKE_PREV_LAG, 100);
        store64(st + _SKE_FIRST, 1);
        store64(st + _SKE_LAST_GAIN, 10);
        store64(st + _SKE_PREV_SIGNAL, 0);
        store64(st + _SKE_FS_KHZ, fs);
        var order = 10;
        if (fs == 16) { order = 16; }
        store64(st + _SKE_ORDER, order);
        store64(st + _SKE_SUBFR_LEN, 5 * fs);
        store64(st + _SKE_FRAME_LEN, silk_smulbb(5 * fs, load64(st + _SKE_NB_SUBFR)));
        store64(st + _SKE_LTP_MEM, 20 * fs);
        store64(st + _SKE_LA_PITCH, 2 * fs);
        if (load64(st + _SKE_NB_SUBFR) == 4) { store64(st + _SKE_PITCH_WIN, 24 * fs); }
        else { store64(st + _SKE_PITCH_WIN, 14 * fs); }
    }
    return 0;
}

# silk_setup_complexity (control_codec.c): the analysis orders, lookahead,
# delayed-decision states, NLSF survivors, interpolation and warping of each
# complexity 0-10. shravan's quantiser is silk_NSQ, the one libopus uses at
# complexity 0 and 1; higher settings need silk_NSQ_del_dec.
fn silk_enc_setup_complexity(st, c) {
    var fs = load64(st + _SKE_FS_KHZ);
    var po = 16;
    var so = 24;
    var la = 5 * fs;
    var nst = 4;
    var ui = 1;
    var sv = 16;
    var warp = fs * 983;                      # SILK_FIX_CONST(WARPING_MULTIPLIER 0.015, 16)
    var pec = 2;                              # pitch estimation: SILK_PE_MAX_COMPLEX
    var pet = 45875;                          # its threshold, SILK_FIX_CONST(0.7, 16)
    if (c < 1) { po = 6; so = 12; la = 3 * fs; nst = 1; ui = 0; sv = 2; warp = 0; pec = 0; pet = 52429; }
    else {
        if (c < 2) { po = 8; so = 14; la = 5 * fs; nst = 1; ui = 0; sv = 3; warp = 0; pec = 1; pet = 49807; }
        else {
            if (c < 3) { po = 6; so = 12; la = 3 * fs; nst = 2; ui = 0; sv = 2; warp = 0; pec = 0; pet = 52429; }
            else {
                if (c < 4) { po = 8; so = 14; la = 5 * fs; nst = 2; ui = 0; sv = 4; warp = 0; pec = 1; pet = 49807; }
                else {
                    if (c < 6) { po = 10; so = 16; nst = 2; sv = 6; pec = 1; pet = 48497; }
                    else {
                        if (c < 8) { po = 12; so = 20; nst = 3; sv = 8; pec = 1; pet = 47186; }
                    }
                }
            }
        }
    }
    var ord = load64(st + _SKE_ORDER);
    if (po > ord) { po = ord; }
    store64(st + _SKE_PITCH_ORDER, po);
    store64(st + _SKE_SHAPE_ORDER, so);
    store64(st + _SKE_LA_SHAPE, la);
    store64(st + _SKE_NSTATES, nst);
    store64(st + _SKE_USE_INTERP, ui);
    store64(st + _SKE_SURVIVORS, sv);
    store64(st + _SKE_WARPING_Q16, warp);
    store64(st + _SKE_SHAPE_WIN, 5 * fs + 2 * la);
    store64(st + _SKE_COMPLEXITY, c);
    store64(st + _SKE_PE_COMPLEXITY, pec);
    store64(st + _SKE_PE_THRES_Q16, pet);
    return 0;
}

# silk_control_SNR (control_SNR.c): the target SNR, Q7 dB, of a bit rate, from
# libopus's per-bandwidth tables (21 x the table entry).
fn silk_control_snr(st, rate_bps) {
    if (_sk_snr_wb == 0) { _sk_snr_tables_init(); }
    store64(st + _SKE_TARGET_RATE, rate_bps);
    var fs = load64(st + _SKE_FS_KHZ);
    if (load64(st + _SKE_NB_SUBFR) == 2) { rate_bps = rate_bps - (2000 + fs / 16); }
    var tab = _sk_snr_wb;
    var bound = 191;
    if (fs == 8) { tab = _sk_snr_nb; bound = 107; }
    if (fs == 12) { tab = _sk_snr_mb; bound = 155; }
    var id = (rate_bps + 200) / 400;
    id = id - 10;
    if (id > bound - 1) { id = bound - 1; }
    if (id <= 0) { store64(st + _SKE_SNR_Q7, 0); }
    else { store64(st + _SKE_SNR_Q7, load8(tab + id) * 21); }
    return 0;
}

var _sk_snr_nb = 0;
var _sk_snr_mb = 0;
var _sk_snr_wb = 0;

fn _sk_bytes(csv, n) {
    var t = alloc(n + 8);
    var p = 0;
    var i = 0;
    while (i < n) {
        var v = 0;
        var c = load8(csv + p);
        while (c >= 48 && c <= 57) { v = v * 10 + c - 48; p = p + 1; c = load8(csv + p); }
        store8(t + i, v);
        i = i + 1;
        if (c == 44) { p = p + 1; }
    }
    return t;
}

fn _sk_snr_tables_init() {
    # silk_TargetRate_{NB,MB,WB}_21 (control_SNR.c)
    _sk_snr_nb = _sk_bytes("0,15,39,52,61,68,74,79,84,88,92,95,99,102,105,108,111,114,117,119,122,124,126,129,131,133,135,137,139,142,143,145,147,149,151,153,155,157,158,160,162,163,165,167,168,170,171,173,174,176,177,179,180,182,183,185,186,187,189,190,192,193,194,196,197,199,200,201,203,204,205,207,208,209,211,212,213,215,216,217,219,220,221,223,224,225,227,228,230,231,232,234,235,236,238,239,241,242,243,245,246,248,249,250,252,253,255", 107);
    _sk_snr_mb = _sk_bytes("0,0,28,43,52,59,65,70,74,78,81,85,87,90,93,95,98,100,102,105,107,109,111,113,115,116,118,120,122,123,125,127,128,130,131,133,134,136,137,138,140,141,143,144,145,147,148,149,151,152,153,154,156,157,158,159,160,162,163,164,165,166,167,168,169,171,172,173,174,175,176,177,178,179,180,181,182,183,184,185,186,187,188,188,189,190,191,192,193,194,195,196,197,198,199,200,201,202,203,203,204,205,206,207,208,209,210,211,212,213,214,214,215,216,217,218,219,220,221,222,223,224,224,225,226,227,228,229,230,231,232,233,234,235,236,236,237,238,239,240,241,242,243,244,245,246,247,248,249,250,251,252,253,254,255", 155);
    _sk_snr_wb = _sk_bytes("0,0,0,8,29,41,49,56,62,66,70,74,77,80,83,86,88,91,93,95,97,99,101,103,105,107,108,110,112,113,115,116,118,119,121,122,123,125,126,127,129,130,131,132,134,135,136,137,138,140,141,142,143,144,145,146,147,148,149,150,151,152,153,154,156,157,158,159,159,160,161,162,163,164,165,166,167,168,169,170,171,171,172,173,174,175,176,177,177,178,179,180,181,181,182,183,184,185,185,186,187,188,189,189,190,191,192,192,193,194,195,195,196,197,198,198,199,200,200,201,202,203,203,204,205,206,206,207,208,209,209,210,211,211,212,213,214,214,215,216,216,217,218,219,219,220,221,221,222,223,224,224,225,226,226,227,228,229,229,230,231,232,232,233,234,234,235,236,237,237,238,239,240,240,241,242,243,243,244,245,246,246,247,248,249,249,250,251,252,253,255", 191);
    return 0;
}

fn _ske_idx(st, k) { return load64(st + _SKE_IDX + k * 8); }
fn _ske_set_idx(st, k, v) { store64(st + _SKE_IDX + k * 8, v); return 0; }

# One frame's control values (libopus silk_encoder_control_FLP, the parts used).
var _SKC_GAINS = 0;           # [4] f64
var _SKC_CODING_QUALITY = 32;
var _SKC_LTPRED_GAIN = 40;
var _SKC_PRED0 = 48;          # [16] f64, LPC for the first half
var _SKC_PRED1 = 176;         # [16] f64, LPC for the second half
var _SKC_RESNRG = 304;        # [4] f64
var _SKC_LTPCOEF = 336;       # [20] f64
var _SKC_AR = 496;            # [4 x 24] f64 noise shaping filters, 24 a subframe
var _SKC_LF_MA = 1264;        # [4] f64
var _SKC_LF_AR = 1296;        # [4] f64
var _SKC_TILT = 1328;         # [4] f64
var _SKC_HARM = 1360;         # [4] f64 HarmShapeGain
var _SKC_LAMBDA = 1392;
var _SKC_INPUT_QUALITY = 1400;
var _SKC_PRED_GAIN = 1408;
var _SKC_PITCHL = 1416;       # [4] pitch lags
var _SKC_GAINS_UNQ = 1448;    # [4] GainsUnq_Q16
var _SKC_LAST_GAIN_PREV = 1480;
var _SKC_LTP_SCALE = 1488;    # f64
var _SKC_SIZE = 1496;

fn silk_enc_ctrl_new() {
    var c = alloc(_SKC_SIZE);
    memset(c, 0, _SKC_SIZE);
    return c;
}

# ---------------------------------------------------------------- f64 helpers

# libopus's single-precision constants (the f-suffixed literals), as doubles.
fn _skf(num, den) { return f32_to(f32_from(f64_div(f64_from(num), f64_from(den)))); }

# x rounded to single precision, where libopus stores a float.
fn _sk_f32(x) { return f32_to(f32_from(x)); }

# pGains_Q16[k] / 65536.0f, exactly: a quantised gain (silk_log2lin) has at
# most 8 significant bits, so libopus's int32 -> float conversion never rounds.
fn _sk_gain_q16_flp(q) { return f64_div(f64_from(q), f64_from(65536)); }

# lrintf: to the nearest integer, ties to even (the float->fixed conversion
# silk_float2int uses throughout).
fn _sk_lrint(x) {
    var fl = f64_floor(x);
    var d = f64_sub(x, fl);
    var i = f64_to(fl);
    if (f64_gt(d, F64_HALF) == 1) { return i + 1; }
    if (f64_lt(d, F64_HALF) == 1) { return i; }
    if ((i & 1) == 1) { return i + 1; }
    return i;
}

# silk_energy_FLP: the sum of squares, in libopus's four-way order.
fn silk_energy_flp(x, n) {
    var r = F64_ZERO;
    var i = 0;
    while (i < n - 3) {
        var a = load64(x + i * 8);
        var b = load64(x + (i + 1) * 8);
        var c = load64(x + (i + 2) * 8);
        var d = load64(x + (i + 3) * 8);
        r = f64_add(r, f64_add(f64_add(f64_add(f64_mul(a, a), f64_mul(b, b)), f64_mul(c, c)), f64_mul(d, d)));
        i = i + 4;
    }
    while (i < n) {
        var e = load64(x + i * 8);
        r = f64_add(r, f64_mul(e, e));
        i = i + 1;
    }
    return r;
}

# silk_inner_product_FLP, in the same order.
fn silk_inner_product_flp(x, y, n) {
    var r = F64_ZERO;
    var i = 0;
    while (i < n - 3) {
        var p = f64_add(f64_mul(load64(x + i * 8), load64(y + i * 8)), f64_mul(load64(x + (i + 1) * 8), load64(y + (i + 1) * 8)));
        p = f64_add(p, f64_mul(load64(x + (i + 2) * 8), load64(y + (i + 2) * 8)));
        p = f64_add(p, f64_mul(load64(x + (i + 3) * 8), load64(y + (i + 3) * 8)));
        r = f64_add(r, p);
        i = i + 4;
    }
    while (i < n) {
        r = f64_add(r, f64_mul(load64(x + i * 8), load64(y + i * 8)));
        i = i + 1;
    }
    return r;
}

# silk_LPC_analysis_filter_FLP: r[i] = s[i] - sum_k a[k] s[i-1-k] for i >= order;
# the first `order` outputs are zero.
fn silk_lpc_analysis_filter_flp(r, a, s, length, order) {
    var i = 0;
    while (i < order) { store64(r + i * 8, F64_ZERO); i = i + 1; }
    var ix = order;
    while (ix < length) {
        var sp = s + (ix - 1) * 8;
        var pred = f64_mul(load64(sp), load64(a));
        var k = 1;
        while (k < order) {
            pred = f64_add(pred, f64_mul(load64(sp - k * 8), load64(a + k * 8)));
            k = k + 1;
        }
        store64(r + ix * 8, f64_sub(load64(sp + 8), pred));
        ix = ix + 1;
    }
    return 0;
}

# ---------------------------------------------------------------- LPC analysis

# silk_burg_modified_FLP (burg_modified_FLP.c): the order-D prediction filter
# A[] (A[k] predicts x[n] from x[n-1-k]) of nb_subfr subframes stacked in x, each
# subfr_length long with its D preceding samples first; the prediction gain is
# held to 1/minInvGain. Returns the residual energy. Double precision throughout,
# as libopus computes it.
fn silk_burg_modified_flp(A, x, minInvGain, subfr_length, nb_subfr, D) {
    var cfr = _opus_tmp(24 * 8);      # C_first_row
    var clr = _opus_tmp(24 * 8);      # C_last_row
    var caf = _opus_tmp(25 * 8);      # CAf
    var cab = _opus_tmp(25 * 8);      # CAb
    var af = _opus_tmp(24 * 8);       # Af
    var k = 0;
    while (k < 24) { store64(cfr + k * 8, F64_ZERO); store64(af + k * 8, F64_ZERO); k = k + 1; }
    var C0 = silk_energy_flp(x, nb_subfr * subfr_length);
    var s = 0;
    while (s < nb_subfr) {
        var xp = x + s * subfr_length * 8;
        var n = 1;
        while (n < D + 1) {
            store64(cfr + (n - 1) * 8, f64_add(load64(cfr + (n - 1) * 8), silk_inner_product_flp(xp, xp + n * 8, subfr_length - n)));
            n = n + 1;
        }
        s = s + 1;
    }
    k = 0;
    while (k < 24) { store64(clr + k * 8, load64(cfr + k * 8)); k = k + 1; }
    var cond = _skf(1, 100000);                       # FIND_LPC_COND_FAC 1e-5f
    var init = f64_add(f64_add(C0, f64_mul(cond, C0)), _skf(1, 1000000000));
    store64(caf, init);
    store64(cab, init);
    var invGain = F64_ONE;
    var reached = 0;
    var n2 = 0;
    var done = 0;
    while (n2 < D && done == 0) {
        s = 0;
        while (s < nb_subfr) {
            var xq = x + s * subfr_length * 8;
            var tmp1 = load64(xq + n2 * 8);
            var tmp2 = load64(xq + (subfr_length - n2 - 1) * 8);
            k = 0;
            while (k < n2) {
                var xn = load64(xq + n2 * 8);
                var xe = load64(xq + (subfr_length - n2 - 1) * 8);
                store64(cfr + k * 8, f64_sub(load64(cfr + k * 8), f64_mul(xn, load64(xq + (n2 - k - 1) * 8))));
                store64(clr + k * 8, f64_sub(load64(clr + k * 8), f64_mul(xe, load64(xq + (subfr_length - n2 + k) * 8))));
                var at = load64(af + k * 8);
                tmp1 = f64_add(tmp1, f64_mul(load64(xq + (n2 - k - 1) * 8), at));
                tmp2 = f64_add(tmp2, f64_mul(load64(xq + (subfr_length - n2 + k) * 8), at));
                k = k + 1;
            }
            k = 0;
            while (k <= n2) {
                store64(caf + k * 8, f64_sub(load64(caf + k * 8), f64_mul(tmp1, load64(xq + (n2 - k) * 8))));
                store64(cab + k * 8, f64_sub(load64(cab + k * 8), f64_mul(tmp2, load64(xq + (subfr_length - n2 + k - 1) * 8))));
                k = k + 1;
            }
            s = s + 1;
        }
        var t1 = load64(cfr + n2 * 8);
        var t2 = load64(clr + n2 * 8);
        k = 0;
        while (k < n2) {
            var a2 = load64(af + k * 8);
            t1 = f64_add(t1, f64_mul(load64(clr + (n2 - k - 1) * 8), a2));
            t2 = f64_add(t2, f64_mul(load64(cfr + (n2 - k - 1) * 8), a2));
            k = k + 1;
        }
        store64(caf + (n2 + 1) * 8, t1);
        store64(cab + (n2 + 1) * 8, t2);
        var num = load64(cab + (n2 + 1) * 8);
        var nrg_b = load64(cab);
        var nrg_f = load64(caf);
        k = 0;
        while (k < n2) {
            var a3 = load64(af + k * 8);
            num = f64_add(num, f64_mul(load64(cab + (n2 - k) * 8), a3));
            nrg_b = f64_add(nrg_b, f64_mul(load64(cab + (k + 1) * 8), a3));
            nrg_f = f64_add(nrg_f, f64_mul(load64(caf + (k + 1) * 8), a3));
            k = k + 1;
        }
        var rc = f64_div(f64_mul(f64_neg(F64_TWO), num), f64_add(nrg_f, nrg_b));
        var tg = f64_mul(invGain, f64_sub(F64_ONE, f64_mul(rc, rc)));
        if (f64_le(tg, minInvGain) == 1) {
            # the maximum prediction gain is reached: take exactly it
            rc = f64_sqrt(f64_sub(F64_ONE, f64_div(minInvGain, invGain)));
            if (f64_gt(num, F64_ZERO) == 1) { rc = f64_neg(rc); }
            invGain = minInvGain;
            reached = 1;
        } else {
            invGain = tg;
        }
        k = 0;
        while (k < (n2 + 1) >> 1) {
            var u1 = load64(af + k * 8);
            var u2 = load64(af + (n2 - k - 1) * 8);
            store64(af + k * 8, f64_add(u1, f64_mul(rc, u2)));
            store64(af + (n2 - k - 1) * 8, f64_add(u2, f64_mul(rc, u1)));
            k = k + 1;
        }
        store64(af + n2 * 8, rc);
        if (reached == 1) {
            k = n2 + 1;
            while (k < D) { store64(af + k * 8, F64_ZERO); k = k + 1; }
            done = 1;
        } else {
            k = 0;
            while (k <= n2 + 1) {
                var c1 = load64(caf + k * 8);
                store64(caf + k * 8, f64_add(c1, f64_mul(rc, load64(cab + (n2 - k + 1) * 8))));
                store64(cab + (n2 - k + 1) * 8, f64_add(load64(cab + (n2 - k + 1) * 8), f64_mul(rc, c1)));
                k = k + 1;
            }
            n2 = n2 + 1;
        }
    }
    var nrg = F64_ZERO;
    if (reached == 1) {
        k = 0;
        while (k < D) { store64(A + k * 8, f64_neg(load64(af + k * 8))); k = k + 1; }
        s = 0;
        while (s < nb_subfr) {
            C0 = f64_sub(C0, silk_energy_flp(x + s * subfr_length * 8, D));
            s = s + 1;
        }
        nrg = f64_mul(C0, invGain);
    } else {
        nrg = load64(caf);
        var sq = F64_ONE;
        k = 0;
        while (k < D) {
            var a4 = load64(af + k * 8);
            nrg = f64_add(nrg, f64_mul(load64(caf + (k + 1) * 8), a4));
            sq = f64_add(sq, f64_mul(a4, a4));
            store64(A + k * 8, f64_neg(a4));
            k = k + 1;
        }
        nrg = f64_sub(nrg, f64_mul(f64_mul(cond, C0), sq));
    }
    return nrg;
}

# silk_A2NLSF_FLP: f64 prediction coefficients to Q15 NLSFs through the Q16
# fixed-point silk_a2nlsf.
fn silk_a2nlsf_flp(nlsf, a, order) {
    var aq = _opus_tmp(16 * 8);
    var i = 0;
    while (i < order) {
        store64(aq + i * 8, _sk_lrint(f64_mul(load64(a + i * 8), f64_from(65536))));
        i = i + 1;
    }
    silk_a2nlsf(nlsf, aq, order);
    return 0;
}

# silk_NLSF2A_FLP: Q15 NLSFs to f64 coefficients (silk_nlsf2a's Q12, over 4096).
fn silk_nlsf2a_flp(a, nlsf, order) {
    var aq = _opus_tmp(16 * 8);
    silk_nlsf2a(aq, nlsf, order);
    var sc = f64_div(F64_ONE, f64_from(4096));
    var i = 0;
    while (i < order) {
        store64(a + i * 8, f64_mul(f64_from(load64(aq + i * 8)), sc));
        i = i + 1;
    }
    return 0;
}

# silk_interpolate: xi = x0 + ((x1 - x0) * ifact_Q2 >> 2), int16 vectors.
fn silk_interpolate(xi, x0, x1, ifact_Q2, d) {
    var i = 0;
    while (i < d) {
        var a = load64(x0 + i * 8);
        store64(xi + i * 8, _i16(a + sar(silk_smulbb(load64(x1 + i * 8) - a, ifact_Q2), 2)));
        i = i + 1;
    }
    return 0;
}

# silk_find_LPC_FLP (find_LPC_FLP.c): the frame's NLSFs from Burg over all its
# subframes of x (each with its `order` preceding samples). With interpolation
# on, a 20 ms frame after the first, it also tries the first half's NLSFs as an
# interpolation between the previous frame's and these (indices 3 down to 0),
# keeping the one with the least residual energy; NLSFInterpCoef_Q2 = 4 means
# none. Writes the indices' interpolation factor.
fn silk_find_lpc_flp(st, nlsf, x, minInvGain) {
    var order = load64(st + _SKE_ORDER);
    var nb_subfr = load64(st + _SKE_NB_SUBFR);
    var sfl = load64(st + _SKE_SUBFR_LEN) + order;
    _ske_set_idx(st, _SKI_NLSF_INTERP, 4);
    var a = _opus_tmp(16 * 8);
    var res_nrg = silk_burg_modified_flp(a, x, minInvGain, sfl, nb_subfr, order);
    if (load64(st + _SKE_USE_INTERP) == 1 && load64(st + _SKE_FIRST) == 0 && nb_subfr == 4) {
        var a_tmp = _opus_tmp(16 * 8);
        # the optimum for the last 10 ms; its energy comes off here rather than
        # being added to every candidate's first half below
        res_nrg = f64_sub(res_nrg, silk_burg_modified_flp(a_tmp, x + 2 * sfl * 8, minInvGain, sfl, 2, order));
        silk_a2nlsf_flp(nlsf, a_tmp, order);
        var nlsf0 = _opus_tmp(16 * 8);
        var res = _opus_tmp(2 * sfl * 8);
        var res_2nd = 0;
        var have_2nd = 0;
        var k = 3;
        while (k >= 0) {
            silk_interpolate(nlsf0, st + _SKE_PREV_NLSF, nlsf, k, order);
            silk_nlsf2a_flp(a_tmp, nlsf0, order);
            silk_lpc_analysis_filter_flp(res, a_tmp, x, 2 * sfl, order);
            var e = f64_add(silk_energy_flp(res + order * 8, sfl - order), silk_energy_flp(res + (order + sfl) * 8, sfl - order));
            var stop = 0;
            if (f64_lt(e, res_nrg) == 1) {
                res_nrg = e;
                _ske_set_idx(st, _SKI_NLSF_INTERP, k);
            } else {
                if (have_2nd == 1 && f64_gt(e, res_2nd) == 1) { stop = 1; }
            }
            res_2nd = e;
            have_2nd = 1;
            k = k - 1;
            if (stop == 1) { k = 0 - 1; }
        }
    }
    if (_ske_idx(st, _SKI_NLSF_INTERP) == 4) { silk_a2nlsf_flp(nlsf, a, order); }
    return 0;
}

# silk_process_NLSFs (process_NLSFs.c): quantise the NLSFs in place, with
# weights from their spacing (Laroia), the first half's added when it is
# interpolated, and a rate weight NLSF_mu falling with speech activity. Writes
# the NLSF indices; pred0 and pred1 receive the Q12 filters for each half.
fn silk_process_nlsfs(st, pred0_Q12, pred1_Q12, nlsf, prev_nlsf) {
    var order = load64(st + _SKE_ORDER);
    # NLSF_mu = 0.003 - 0.001 * speech_activity (Q20); x1.5 for 10 ms frames
    var mu = silk_smlawb(3146, 0 - 268434, load64(st + _SKE_SPEECH_Q8));
    if (load64(st + _SKE_NB_SUBFR) == 2) { mu = mu + sar(mu, 1); }
    var w = _opus_tmp(16 * 8);
    silk_nlsf_vq_weights_laroia(w, nlsf, order);
    var interp = _ske_idx(st, _SKI_NLSF_INTERP);
    var doi = 0;
    if (load64(st + _SKE_USE_INTERP) == 1 && interp < 4) { doi = 1; }
    var tmp = _opus_tmp(16 * 8);
    if (doi == 1) {
        silk_interpolate(tmp, prev_nlsf, nlsf, interp, order);
        var w0 = _opus_tmp(16 * 8);
        silk_nlsf_vq_weights_laroia(w0, tmp, order);
        var isq = silk_smulbb(interp, interp) << 11;
        var i = 0;
        while (i < order) {
            store64(w + i * 8, _i16(sar(load64(w + i * 8), 1) + sar(silk_smulbb(load64(w0 + i * 8), isq), 16)));
            i = i + 1;
        }
    }
    silk_nlsf_encode(st + _SKE_IDX + _SKI_NLSF * 8, nlsf, load64(st + _SKE_FS_KHZ), w, mu,
      load64(st + _SKE_SURVIVORS), _ske_idx(st, _SKI_SIGNAL_TYPE));
    silk_nlsf2a(pred1_Q12, nlsf, order);
    if (doi == 1) {
        silk_interpolate(tmp, prev_nlsf, nlsf, interp, order);
        silk_nlsf2a(pred0_Q12, tmp, order);
    } else {
        var j = 0;
        while (j < order) { store64(pred0_Q12 + j * 8, load64(pred1_Q12 + j * 8)); j = j + 1; }
    }
    return 0;
}

# silk_process_NLSFs_FLP: the same, the filters as f64 (Q12 over 4096).
fn silk_process_nlsfs_flp(st, ctrl, nlsf, prev_nlsf) {
    var order = load64(st + _SKE_ORDER);
    var p0 = _opus_tmp(16 * 8);
    var p1 = _opus_tmp(16 * 8);
    silk_process_nlsfs(st, p0, p1, nlsf, prev_nlsf);
    var sc = f64_div(F64_ONE, f64_from(4096));
    var i = 0;
    while (i < order) {
        store64(ctrl + _SKC_PRED0 + i * 8, f64_mul(f64_from(load64(p0 + i * 8)), sc));
        store64(ctrl + _SKC_PRED1 + i * 8, f64_mul(f64_from(load64(p1 + i * 8)), sc));
        i = i + 1;
    }
    return 0;
}

# silk_residual_energy_FLP: each subframe's LPC residual energy (the first half
# through pred0, the second through pred1), times its gain squared.
fn silk_residual_energy_flp(nrgs, x, pred0, pred1, gains, subfr_length, nb_subfr, order) {
    var shift = order + subfr_length;
    var res = _opus_tmp(2 * shift * 8);
    var rp = res + order * 8;
    silk_lpc_analysis_filter_flp(res, pred0, x, 2 * shift, order);
    var g0 = load64(gains);
    var g1 = load64(gains + 8);
    store64(nrgs, f64_mul(f64_mul(g0, g0), silk_energy_flp(rp, subfr_length)));
    store64(nrgs + 8, f64_mul(f64_mul(g1, g1), silk_energy_flp(rp + shift * 8, subfr_length)));
    if (nb_subfr == 4) {
        silk_lpc_analysis_filter_flp(res, pred1, x + 2 * shift * 8, 2 * shift, order);
        var g2 = load64(gains + 16);
        var g3 = load64(gains + 24);
        store64(nrgs + 16, f64_mul(f64_mul(g2, g2), silk_energy_flp(rp, subfr_length)));
        store64(nrgs + 24, f64_mul(f64_mul(g3, g3), silk_energy_flp(rp + shift * 8, subfr_length)));
    }
    return 0;
}

# silk_find_pred_coefs_FLP (find_pred_coefs_FLP.c): the long-term predictor
# first on a voiced frame (the pitch residual's correlations at each
# subframe's lag, the LTP filters quantised, the LTP scaling, and the input
# through them scaled by each subframe's inverse gain), on any other the input
# scaled alone (each subframe with its `order` preceding samples); then Burg
# over that (the prediction gain held to 1e4, to 1e2 on the first frame, and
# lower at low coding quality and high LTP gain), the NLSFs quantised, and the
# quantised filters' residual energies. x points at the frame (x[-ltp_mem..-1]
# valid); res_pitch at the pitch residual's frame start (voiced frames only);
# cond: libopus's condCoding.
fn silk_find_pred_coefs_flp(st, ctrl, res_pitch, x, cond) {
    var order = load64(st + _SKE_ORDER);
    var nb_subfr = load64(st + _SKE_NB_SUBFR);
    var sl = load64(st + _SKE_SUBFR_LEN);
    var inv = _opus_tmp(4 * 8);
    var i = 0;
    while (i < nb_subfr) {
        store64(inv + i * 8, f64_div(F64_ONE, load64(ctrl + _SKC_GAINS + i * 8)));
        i = i + 1;
    }
    var pre = _opus_tmp(nb_subfr * (sl + order) * 8);
    if (_ske_idx(st, _SKI_SIGNAL_TYPE) == 2) {
        var XX = _opus_tmp(4 * 25 * 8);
        var xX = _opus_tmp(4 * 5 * 8);
        silk_find_ltp_flp(XX, xX, res_pitch, ctrl + _SKC_PITCHL, sl, nb_subfr);
        silk_quant_ltp_gains_flp(ctrl + _SKC_LTPCOEF, st + _SKE_IDX + (19 + order) * 8, st + _SKE_IDX + _SKI_PER * 8,
          st + _SKE_SUM_LOG_GAIN, ctrl + _SKC_LTPRED_GAIN, XX, xX, sl, nb_subfr);
        silk_ltp_scale_ctrl_flp(st, ctrl, cond);
        silk_ltp_analysis_filter_flp(pre, x - order * 8, ctrl + _SKC_LTPCOEF, ctrl + _SKC_PITCHL, inv, sl, nb_subfr, order);
    } else {
        var xp = x - order * 8;
        var pp = pre;
        i = 0;
        while (i < nb_subfr) {
            var g = load64(inv + i * 8);
            var j = 0;
            while (j < sl + order) { store64(pp + j * 8, f64_mul(g, load64(xp + j * 8))); j = j + 1; }
            pp = pp + (sl + order) * 8;
            xp = xp + sl * 8;
            i = i + 1;
        }
        i = 0;
        while (i < 20) { store64(ctrl + _SKC_LTPCOEF + i * 8, F64_ZERO); i = i + 1; }
        store64(ctrl + _SKC_LTPRED_GAIN, F64_ZERO);
        store64(st + _SKE_SUM_LOG_GAIN, 0);
    }
    var minInvGain = 0;
    if (load64(st + _SKE_FIRST) == 1) {
        minInvGain = f64_div(F64_ONE, f64_from(100));
    } else {
        # 2^(LTPredCodGain/3) / 1e4, over 0.25 + 0.75 coding_quality
        minInvGain = f64_div(f64_pow(F64_TWO, f64_div(load64(ctrl + _SKC_LTPRED_GAIN), f64_from(3))), f64_from(10000));
        minInvGain = f64_div(minInvGain, f64_add(_skf(1, 4), f64_mul(_skf(3, 4), load64(ctrl + _SKC_CODING_QUALITY))));
    }
    var nlsf = _opus_tmp(16 * 8);
    i = 0;
    while (i < 16) { store64(nlsf + i * 8, 0); i = i + 1; }
    silk_find_lpc_flp(st, nlsf, pre, minInvGain);
    silk_process_nlsfs_flp(st, ctrl, nlsf, st + _SKE_PREV_NLSF);
    silk_residual_energy_flp(ctrl + _SKC_RESNRG, pre, ctrl + _SKC_PRED0, ctrl + _SKC_PRED1,
      ctrl + _SKC_GAINS, sl, nb_subfr, order);
    i = 0;
    while (i < order) { store64(st + _SKE_PREV_NLSF + i * 8, load64(nlsf + i * 8)); i = i + 1; }
    return minInvGain;
}

# ---------------------------------------------------------------- long-term prediction (2.12.0)

# silk_corrMatrix_FLP: XX = X'X for X the order columns x[order-1-j ..], each
# L long (x holds L + order - 1 samples): the diagonal recursively, then each
# off-diagonal recursively from its first entry. Row-major, order x order.
fn silk_corrmatrix_flp(x, L, order, XX) {
    var p1 = x + (order - 1) * 8;
    var e = silk_energy_flp(p1, L);
    store64(XX, e);
    var j = 1;
    while (j < order) {
        var a = load64(p1 - j * 8);
        var b = load64(p1 + (L - j) * 8);
        e = f64_add(e, f64_sub(f64_mul(a, a), f64_mul(b, b)));
        store64(XX + (j * order + j) * 8, e);
        j = j + 1;
    }
    var p2 = x + (order - 2) * 8;
    var lag = 1;
    while (lag < order) {
        e = silk_inner_product_flp(p1, p2, L);
        store64(XX + (lag * order) * 8, e);
        store64(XX + lag * 8, e);
        j = 1;
        while (j < order - lag) {
            e = f64_add(e, f64_sub(f64_mul(load64(p1 - j * 8), load64(p2 - j * 8)),
              f64_mul(load64(p1 + (L - j) * 8), load64(p2 + (L - j) * 8))));
            store64(XX + ((lag + j) * order + j) * 8, e);
            store64(XX + (j * order + lag + j) * 8, e);
            j = j + 1;
        }
        p2 = p2 - 8;
        lag = lag + 1;
    }
    return 0;
}

# silk_corrVector_FLP: Xt = X't, the same columns against the target t.
fn silk_corrvector_flp(x, t, L, order, Xt) {
    var p1 = x + (order - 1) * 8;
    var lag = 0;
    while (lag < order) {
        store64(Xt + lag * 8, silk_inner_product_flp(p1, t, L));
        p1 = p1 - 8;
        lag = lag + 1;
    }
    return 0;
}

# silk_find_LTP_FLP (find_LTP_FLP.c): per subframe, the 5-tap correlation
# matrix and vector of the residual r against itself one lag back, both scaled
# by the inverse of the subframe's energy (no less than a fraction of the
# matrix's corner energies).
fn silk_find_ltp_flp(XX, xX, r, lag, sl, nb_subfr) {
    var k = 0;
    while (k < nb_subfr) {
        var XXk = XX + k * 25 * 8;
        var xXk = xX + k * 5 * 8;
        var lp = r - (load64(lag + k * 8) + 2) * 8;
        silk_corrmatrix_flp(lp, sl, 5, XXk);
        silk_corrvector_flp(lp, r, sl, 5, xXk);
        var xx = silk_energy_flp(r, sl + 5);
        var floor = f64_add(f64_mul(f64_mul(_skf(3, 100), F64_HALF), f64_add(load64(XXk), load64(XXk + 24 * 8))), F64_ONE);
        if (f64_gt(xx, floor) == 1) { floor = xx; }
        var temp = f64_div(F64_ONE, floor);
        var i = 0;
        while (i < 25) { store64(XXk + i * 8, f64_mul(load64(XXk + i * 8), temp)); i = i + 1; }
        i = 0;
        while (i < 5) { store64(xXk + i * 8, f64_mul(load64(xXk + i * 8), temp)); i = i + 1; }
        r = r + sl * 8;
        k = k + 1;
    }
    return 0;
}

# silk_MLA, silk_LSHIFT32: int32 multiply-add and shift, wrapping.
fn _sk_mla(a, b, c) { return silk_sx32(a + b * c); }

# silk_VQ_WMat_EC (VQ_WMat_EC.c): the codebook vector that minimises the
# weighted error 1 - 2 xX'cb + cb'XX cb (in Q15, plus a penalty when its gain
# exceeds max_gain_Q7) plus half its code length, in bits under a high-rate
# assumption. XX_Q17 and xX_Q17 one subframe's, Q17. res: [index, residual
# energy Q15, rate-distortion Q8, gain Q7]; res[3] keeps its value when no
# vector qualifies, as libopus's does.
fn silk_vq_wmat_ec(res, XX, xX, cb, cb_gain, cl, subfr_len, max_gain_Q7, L) {
    var n0 = silk_sx32(0 - (load64(xX) << 7));
    var n1 = silk_sx32(0 - (load64(xX + 8) << 7));
    var n2 = silk_sx32(0 - (load64(xX + 16) << 7));
    var n3 = silk_sx32(0 - (load64(xX + 24) << 7));
    var n4 = silk_sx32(0 - (load64(xX + 32) << 7));
    store64(res, 0);
    store64(res + 8, 2147483647);
    store64(res + 16, 2147483647);
    var k = 0;
    while (k < L) {
        var row = cb + k * 5 * 8;
        var r0 = load64(row);
        var r1 = load64(row + 8);
        var r2 = load64(row + 16);
        var r3 = load64(row + 24);
        var r4 = load64(row + 32);
        var gain_tmp = load8(cb_gain + k);
        var sum1 = 32801;                               # SILK_FIX_CONST(1.001, 15)
        var pen = gain_tmp - max_gain_Q7;
        if (pen < 0) { pen = 0; }
        pen = silk_sx32(pen << 11);
        var s2 = _sk_mla(n0, load64(XX + 8), r1);
        s2 = _sk_mla(s2, load64(XX + 16), r2);
        s2 = _sk_mla(s2, load64(XX + 24), r3);
        s2 = _sk_mla(s2, load64(XX + 32), r4);
        s2 = silk_sx32(s2 << 1);
        s2 = _sk_mla(s2, load64(XX), r0);
        sum1 = silk_smlawb(sum1, s2, r0);
        s2 = _sk_mla(n1, load64(XX + 7 * 8), r2);
        s2 = _sk_mla(s2, load64(XX + 8 * 8), r3);
        s2 = _sk_mla(s2, load64(XX + 9 * 8), r4);
        s2 = silk_sx32(s2 << 1);
        s2 = _sk_mla(s2, load64(XX + 6 * 8), r1);
        sum1 = silk_smlawb(sum1, s2, r1);
        s2 = _sk_mla(n2, load64(XX + 13 * 8), r3);
        s2 = _sk_mla(s2, load64(XX + 14 * 8), r4);
        s2 = silk_sx32(s2 << 1);
        s2 = _sk_mla(s2, load64(XX + 12 * 8), r2);
        sum1 = silk_smlawb(sum1, s2, r2);
        s2 = _sk_mla(n3, load64(XX + 19 * 8), r4);
        s2 = silk_sx32(s2 << 1);
        s2 = _sk_mla(s2, load64(XX + 18 * 8), r3);
        sum1 = silk_smlawb(sum1, s2, r3);
        s2 = silk_sx32(n4 << 1);
        s2 = _sk_mla(s2, load64(XX + 24 * 8), r4);
        sum1 = silk_smlawb(sum1, s2, r4);
        if (sum1 >= 0) {
            var bits_res = silk_smulbb(subfr_len, silk_lin2log(silk_sx32(sum1 + pen)) - (15 << 7));
            var bits_tot = silk_sx32(bits_res + (load8(cl + k) << 2));
            if (bits_tot <= load64(res + 16)) {
                store64(res + 16, bits_tot);
                store64(res + 8, silk_sx32(sum1 + pen));
                store64(res, k);
                store64(res + 24, gain_tmp);
            }
        }
        k = k + 1;
    }
    return 0;
}

# silk_quant_LTP_gains (quant_LTP_gains.c): each of the three codebooks over
# all subframes (each subframe's gain held under what the running sum of log
# gains still allows), the codebook with the least total rate-distortion kept:
# B_Q14[nb x 5], the indices, the periodicity index; *sum_log_gain_Q7 carried
# to the next frame; *pred_gain_dB_Q7 from the last codebook's residual (as
# libopus's does).
fn silk_quant_ltp_gains(B_Q14, cbk_index, per, sum_log_gain, pred_gain, XX_Q17, xX_Q17, subfr_len, nb_subfr) {
    if (_sk_ltp_bits == 0) { _sk_pitch_tables_init(); }
    var min_rd = 2147483647;
    var best_slg = 0;
    var tmp_idx = _opus_tmp(4 * 8);
    var vq = _opus_tmp(4 * 8);
    store64(vq + 24, 0);
    var res_nrg = 0;
    var k = 0;
    while (k < 3) {
        var gs = 51;                                     # gain_safety, SILK_FIX_CONST(0.4, 7)
        var cl = load64(_sk_ltp_bits + k * 8);
        var cbk = _silk_ltpvq0;
        if (k == 1) { cbk = _silk_ltpvq1; }
        if (k == 2) { cbk = _silk_ltpvq2; }
        var cg = load64(_sk_ltp_vqgain + k * 8);
        res_nrg = 0;
        var rd = 0;
        var slg = load64(sum_log_gain);
        var j = 0;
        while (j < nb_subfr) {
            var max_gain = silk_log2lin((5333 - slg) + 896) - gs;
            silk_vq_wmat_ec(vq, XX_Q17 + j * 25 * 8, xX_Q17 + j * 5 * 8, cbk, cg, cl, subfr_len, max_gain, 8 << k);
            store64(tmp_idx + j * 8, load64(vq));
            res_nrg = _sk_add_pos_sat32(res_nrg, load64(vq + 8));
            rd = _sk_add_pos_sat32(rd, load64(vq + 16));
            slg = slg + silk_lin2log(gs + load64(vq + 24)) - 896;
            if (slg < 0) { slg = 0; }
            j = j + 1;
        }
        if (rd <= min_rd) {
            min_rd = rd;
            store64(per, k);
            j = 0;
            while (j < nb_subfr) { store64(cbk_index + j * 8, load64(tmp_idx + j * 8)); j = j + 1; }
            best_slg = slg;
        }
        k = k + 1;
    }
    var p = load64(per);
    var cb = _silk_ltpvq0;
    if (p == 1) { cb = _silk_ltpvq1; }
    if (p == 2) { cb = _silk_ltpvq2; }
    var j2 = 0;
    while (j2 < nb_subfr) {
        var i = 0;
        while (i < 5) {
            store64(B_Q14 + (j2 * 5 + i) * 8, load64(cb + (load64(cbk_index + j2 * 8) * 5 + i) * 8) << 7);
            i = i + 1;
        }
        j2 = j2 + 1;
    }
    if (nb_subfr == 2) { res_nrg = sar(res_nrg, 1); } else { res_nrg = sar(res_nrg, 2); }
    store64(sum_log_gain, best_slg);
    store64(pred_gain, silk_smulbb(0 - 3, silk_lin2log(res_nrg) - (15 << 7)));
    return 0;
}

# silk_quant_LTP_gains_FLP (wrappers_FLP.c): the correlations to Q17 by
# lrintf, the quantiser, and the filters and prediction gain back to f64.
fn silk_quant_ltp_gains_flp(B, cbk_index, per, sum_log_gain, pred_gain_dB, XX, xX, subfr_len, nb_subfr) {
    var XXq = _opus_tmp(4 * 25 * 8);
    var xXq = _opus_tmp(4 * 5 * 8);
    var q = f64_from(131072);
    var i = 0;
    while (i < nb_subfr * 25) { store64(XXq + i * 8, silk_sx32(_sk_lrint(f64_mul(load64(XX + i * 8), q)))); i = i + 1; }
    i = 0;
    while (i < nb_subfr * 5) { store64(xXq + i * 8, silk_sx32(_sk_lrint(f64_mul(load64(xX + i * 8), q)))); i = i + 1; }
    var bq = _opus_tmp(4 * 5 * 8);
    var pg = _opus_tmp(8);
    silk_quant_ltp_gains(bq, cbk_index, per, sum_log_gain, pg, XXq, xXq, subfr_len, nb_subfr);
    i = 0;
    while (i < nb_subfr * 5) { store64(B + i * 8, f64_div(f64_from(load64(bq + i * 8)), f64_from(16384))); i = i + 1; }
    store64(pred_gain_dB, f64_div(f64_from(load64(pg)), f64_from(128)));
    return 0;
}

# silk_LTP_scale_ctrl_FLP (LTP_scale_ctrl_FLP.c): on an independently coded
# frame, scale the long-term predictor down (index 1 or 2) when the LTP gain
# times the expected loss (squared, plus 2, under in-band FEC) passes a
# threshold set by the target SNR; otherwise index 0. Only that index is coded.
fn silk_ltp_scale_ctrl_flp(st, ctrl, cond) {
    var ix = 0;
    if (cond == 0) {
        var rl = load64(st + _SKE_PACKET_LOSS) * load64(st + _SKE_NFRAMES_PP);
        if (load64(st + _SKE_LBRR_FLAG) != 0) { rl = 2 + silk_smulbb(rl, rl) / 100; }
        var g = silk_smulbb(f64_to(load64(ctrl + _SKC_LTPRED_GAIN)), rl);
        var snr = load64(st + _SKE_SNR_Q7);
        if (g > silk_log2lin(2900 - snr)) { ix = ix + 1; }
        if (g > silk_log2lin(3900 - snr)) { ix = ix + 1; }
    }
    _ske_set_idx(st, _SKI_LTP_SCALE, ix);
    store64(ctrl + _SKC_LTP_SCALE, f64_div(f64_from(silk_ltp_scale(ix)), f64_from(16384)));
    return 0;
}

# silk_LTP_analysis_filter_FLP (LTP_analysis_filter_FLP.c): each subframe and
# its pre_length preceding samples less the 5-tap long-term prediction from one
# lag back, times the subframe's inverse gain, into LTP_res (subframes of
# pre_length + subfr_length). x starts pre_length samples before the frame.
fn silk_ltp_analysis_filter_flp(LTP_res, x, B, pitchL, invGains, sl, nb_subfr, pre_length) {
    var xp = x;
    var rp = LTP_res;
    var k = 0;
    while (k < nb_subfr) {
        var lp = xp - load64(pitchL + k * 8) * 8;
        var ig = load64(invGains + k * 8);
        var b = B + k * 5 * 8;
        var i = 0;
        while (i < sl + pre_length) {
            var v = load64(xp + i * 8);
            var j = 0;
            while (j < 5) {
                v = f64_sub(v, f64_mul(load64(b + j * 8), load64(lp + (2 - j) * 8)));
                j = j + 1;
            }
            store64(rp + i * 8, f64_mul(v, ig));
            lp = lp + 8;
            i = i + 1;
        }
        rp = rp + (sl + pre_length) * 8;
        xp = xp + sl * 8;
        k = k + 1;
    }
    return 0;
}

# silk_HP_variable_cutoff (HP_variable_cutoff.c): after a voiced frame, move
# the smoothed cutoff (log2 Hz, Q15) towards the low end of the pitch range,
# adjusted by the low band's quality, faster down than up, between 60 and
# 100 Hz. The Opus layer's VOIP high-pass reads it.
fn silk_hp_variable_cutoff(st) {
    if (load64(st + _SKE_PREV_SIGNAL) == 2) {
        var pf = silk_div_trunc((load64(st + _SKE_FS_KHZ) * 1000) << 16, load64(st + _SKE_PREV_LAG));
        var pfl = silk_lin2log(pf) - (16 << 7);
        var q = load64(st + _SKE_QUALITY);
        pfl = silk_smlawb(pfl, silk_sx32(silk_smulwb(silk_sx32((0 - q) << 2), q)),
          pfl - (silk_lin2log(60 << 16) - (16 << 7)));
        var sm = load64(st + _SKE_HP_SMTH1);
        var delta = pfl - sar(sm, 8);
        if (delta < 0) { delta = delta * 3; }
        delta = silk_limit(delta, 0 - 51, 51);              # SILK_FIX_CONST(0.4, 7)
        sm = silk_smlawb(sm, silk_smulbb(load64(st + _SKE_SPEECH_Q8), delta), 6554);
        sm = silk_limit(sm, silk_lin2log(60) << 8, silk_lin2log(100) << 8);
        store64(st + _SKE_HP_SMTH1, sm);
    }
    return 0;
}

# ---------------------------------------------------------------- VAD (fixed point)
#
# silk_VAD_GetSA_Q8 (VAD.c): four subbands by three halving filter banks, their
# energies against slowly tracked noise levels, and from those the speech
# activity (Q8), the spectral tilt and each band's quality. Exact, as libopus's.
var _SKD_ANA = 0;             # [6] AnaState, AnaState1, AnaState2 (2 each)
var _SKD_XNRG_SUBFR = 48;     # [4]
var _SKD_NRG_RATIO = 80;      # [4] NrgRatioSmth_Q8
var _SKD_HP = 112;            # HPstate
var _SKD_NL = 120;            # [4] noise levels
var _SKD_INV_NL = 152;        # [4]
var _SKD_BIAS = 184;          # [4] NoiseLevelBias
var _SKD_COUNTER = 216;
var _SKD_SIZE = 224;

# silk_VAD_Init
fn silk_vad_new() { return _sk_vad_init(alloc(_SKD_SIZE)); }

fn _sk_vad_init(v) {
    _sk_zero(v, _SKD_SIZE);
    var b = 0;
    while (b < 4) {
        var bias = silk_div_trunc(50, b + 1);
        if (bias < 1) { bias = 1; }
        store64(v + _SKD_BIAS + b * 8, bias);
        store64(v + _SKD_NL + b * 8, 100 * bias);
        store64(v + _SKD_INV_NL + b * 8, silk_div_trunc(2147483647, 100 * bias));
        store64(v + _SKD_NRG_RATIO + b * 8, 100 * 256);
        b = b + 1;
    }
    store64(v + _SKD_COUNTER, 15);
    return v;
}

# silk_ADD_POS_SAT32: a + b, INT32_MAX when the unsigned sum has bit 31 set.
fn _sk_add_pos_sat32(a, b) {
    var t = (a + b) & 0xFFFFFFFF;
    if ((t & 0x80000000) != 0) { return 2147483647; }
    return silk_sx32(a + b);
}

# silk_sigm_Q15: a sigmoid, Q5 in, Q15 out, by table and linear interpolation.
fn silk_sigm_q15(in_Q5) {
    var slope = "\xed\x99\x49\x1e\x0c\x07";             # sigm_LUT_slope_Q10
    if (in_Q5 < 0) {
        in_Q5 = 0 - in_Q5;
        if (in_Q5 >= 192) { return 0; }
        var ind = in_Q5 >> 5;
        var neg = 16384;
        if (ind == 1) { neg = 8812; }
        if (ind == 2) { neg = 3906; }
        if (ind == 3) { neg = 1554; }
        if (ind == 4) { neg = 589; }
        if (ind == 5) { neg = 219; }
        return neg - silk_smulbb(load8(slope + ind), in_Q5 & 31);
    }
    if (in_Q5 >= 192) { return 32767; }
    var ind2 = in_Q5 >> 5;
    var pos = 16384;
    if (ind2 == 1) { pos = 23955; }
    if (ind2 == 2) { pos = 28861; }
    if (ind2 == 3) { pos = 31213; }
    if (ind2 == 4) { pos = 32178; }
    if (ind2 == 5) { pos = 32548; }
    return pos + silk_smulbb(load8(slope + ind2), in_Q5 & 31);
}

# silk_ana_filt_bank_1: split into low and high bands at half rate (two first
# order all-pass sections, Q10 internally). src, outL, outH are int16 arrays of
# i64 words; S is the 2-word state. outL may be src.
fn silk_ana_filt_bank_1(src, S, outL, outH, N) {
    var N2 = N >> 1;
    var k = 0;
    while (k < N2) {
        var in32 = load64(src + 2 * k * 8) << 10;
        var Y = silk_sx32(in32 - load64(S));
        var X = silk_smlawb(Y, Y, 0 - 24290);                 # A_fb1_21
        var out1 = silk_sx32(load64(S) + X);
        store64(S, silk_sx32(in32 + X));
        in32 = load64(src + (2 * k + 1) * 8) << 10;
        Y = silk_sx32(in32 - load64(S + 8));
        X = silk_smulwb(Y, 10788);                            # A_fb1_20 = 5394 << 1
        var out2 = silk_sx32(load64(S + 8) + X);
        store64(S + 8, silk_sx32(in32 + X));
        store64(outL + k * 8, silk_sat16(silk_rshift_round(silk_sx32(out2 + out1), 11)));
        store64(outH + k * 8, silk_sat16(silk_rshift_round(silk_sx32(out2 - out1), 11)));
        k = k + 1;
    }
    return 0;
}

# silk_VAD_GetNoiseLevels: track each band's noise level, faster at the start.
fn _sk_vad_noise_levels(pX, v) {
    var min_coef = 0;
    var cnt = load64(v + _SKD_COUNTER);
    if (cnt < 1000) {
        min_coef = silk_div_trunc(32767, (cnt >> 4) + 1);
        store64(v + _SKD_COUNTER, cnt + 1);
    }
    var k = 0;
    while (k < 4) {
        var nl = load64(v + _SKD_NL + k * 8);
        var nrg = _sk_add_pos_sat32(load64(pX + k * 8), load64(v + _SKD_BIAS + k * 8));
        var inv_nrg = silk_div_trunc(2147483647, nrg);
        var coef = 0;
        if (nrg > (nl << 3)) { coef = 128; }
        else {
            if (nrg < nl) { coef = 1024; }
            else { coef = silk_smulwb(silk_sx32(silk_smulww(inv_nrg, nl)), 2048); }
        }
        if (coef < min_coef) { coef = min_coef; }
        var inv = load64(v + _SKD_INV_NL + k * 8);
        inv = silk_smlawb(inv, inv_nrg - inv, coef);
        store64(v + _SKD_INV_NL + k * 8, inv);
        nl = silk_div_trunc(2147483647, inv);
        if (nl > 16777215) { nl = 16777215; }
        store64(v + _SKD_NL + k * 8, nl);
        k = k + 1;
    }
    return 0;
}

# The VAD on one frame of int16 input (i64 words at pIn): sets the state's
# speech_activity_Q8, input_tilt_Q15 and input_quality_bands_Q15.
fn silk_vad_get_sa_q8(st, pIn) {
    var v = load64(st + _SKE_VAD);
    var fl = load64(st + _SKE_FRAME_LEN);
    var fs = load64(st + _SKE_FS_KHZ);
    var d1 = fl >> 1;
    var d2 = fl >> 2;
    var d = fl >> 3;
    var xo = _opus_tmp(4 * 8);
    store64(xo, 0);
    store64(xo + 8, d + d2);
    store64(xo + 16, d + d2 + d);
    store64(xo + 24, d + d2 + d + d2);
    var X = _opus_tmp((load64(xo + 24) + d1) * 8);
    silk_ana_filt_bank_1(pIn, v + _SKD_ANA, X, X + load64(xo + 24) * 8, fl);
    silk_ana_filt_bank_1(X, v + _SKD_ANA + 16, X, X + load64(xo + 16) * 8, d1);
    silk_ana_filt_bank_1(X, v + _SKD_ANA + 32, X, X + load64(xo + 8) * 8, d2);
    # the lowest band: a first-order high-pass
    store64(X + (d - 1) * 8, sar(load64(X + (d - 1) * 8), 1));
    var hp = load64(X + (d - 1) * 8);
    var i = d - 1;
    while (i > 0) {
        store64(X + (i - 1) * 8, sar(load64(X + (i - 1) * 8), 1));
        store64(X + i * 8, _i16(load64(X + i * 8) - load64(X + (i - 1) * 8)));
        i = i - 1;
    }
    store64(X, _i16(load64(X) - load64(v + _SKD_HP)));
    store64(v + _SKD_HP, hp);
    # band energies, the last quarter subframe at half weight
    var xnrg = _opus_tmp(4 * 8);
    var b = 0;
    while (b < 4) {
        var sh = 4 - b;
        if (sh > 3) { sh = 3; }
        var dlen = fl >> sh;
        var dsub = dlen >> 2;
        var off = 0;
        var xn = load64(v + _SKD_XNRG_SUBFR + b * 8);
        var sum = 0;
        var s2 = 0;
        while (s2 < 4) {
            sum = 0;
            var j = 0;
            while (j < dsub) {
                var xt = sar(load64(X + (load64(xo + b * 8) + j + off) * 8), 3);
                sum = silk_sx32(sum + silk_smulbb(xt, xt));
                j = j + 1;
            }
            if (s2 < 3) { xn = _sk_add_pos_sat32(xn, sum); }
            else { xn = _sk_add_pos_sat32(xn, sar(sum, 1)); }
            off = off + dsub;
            s2 = s2 + 1;
        }
        store64(v + _SKD_XNRG_SUBFR + b * 8, sum);
        store64(xnrg + b * 8, xn);
        b = b + 1;
    }
    _sk_vad_noise_levels(xnrg, v);
    # SNR, tilt and activity
    var ratio = _opus_tmp(4 * 8);
    var ssq = 0;
    var tilt = 0;
    b = 0;
    while (b < 4) {
        var xb = load64(xnrg + b * 8);
        var nlb = load64(v + _SKD_NL + b * 8);
        var sp = xb - nlb;
        if (sp > 0) {
            var r = 0;
            if ((xb & 0xFF800000) == 0) { r = silk_div_trunc(xb << 8, nlb + 1); }
            else { r = silk_div_trunc(xb, (nlb >> 8) + 1); }
            store64(ratio + b * 8, r);
            var snr = silk_lin2log(r) - 1024;
            ssq = silk_sx32(ssq + silk_smulbb(snr, snr));
            if (sp < 1048576) { snr = silk_smulwb(silk_sqrt_approx(sp) << 6, snr); }
            var tw = 30000;
            if (b == 1) { tw = 6000; }
            if (b >= 2) { tw = 0 - 12000; }
            tilt = silk_smlawb(tilt, tw, snr);
        } else {
            store64(ratio + b * 8, 256);
        }
        b = b + 1;
    }
    ssq = silk_div_trunc(ssq, 4);
    var psnr = _i16(3 * silk_sqrt_approx(ssq));
    var sa = silk_sigm_q15(silk_smulwb(45000, psnr) - 128);
    store64(st + _SKE_TILT_Q15, (silk_sigm_q15(tilt) - 16384) << 1);
    var spn = 0;
    b = 0;
    while (b < 4) {
        spn = silk_sx32(spn + (b + 1) * sar(load64(xnrg + b * 8) - load64(v + _SKD_NL + b * 8), 4));
        b = b + 1;
    }
    if (fl == 20 * fs) { spn = sar(spn, 1); }
    if (spn <= 0) { sa = sar(sa, 1); }
    else {
        if (spn < 16384) {
            spn = silk_sqrt_approx(spn << 16);
            sa = silk_smulwb(32768 + spn, sa);
        }
    }
    var act = sa >> 7;
    if (act > 255) { act = 255; }
    store64(st + _SKE_SPEECH_Q8, act);
    var smooth = silk_smulwb(4096, silk_smulwb(sa, sa));
    if (fl == 10 * fs) { smooth = sar(smooth, 1); }
    b = 0;
    while (b < 4) {
        var nr = load64(v + _SKD_NRG_RATIO + b * 8);
        nr = silk_smlawb(nr, load64(ratio + b * 8) - nr, smooth);
        store64(v + _SKD_NRG_RATIO + b * 8, nr);
        var snr2 = 3 * (silk_lin2log(nr) - 1024);
        store64(st + _SKE_QUALITY + b * 8, silk_sigm_q15(sar(snr2 - 2048, 4)));
        b = b + 1;
    }
    return 0;
}

# silk_encode_do_VAD_FLP: the VAD, then the frame's signal type (no voice
# activity under 5% activity, else unvoiced until pitch analysis says voiced)
# and its VAD flag. activity: libopus's own decision, or -1 for none.
fn silk_encode_do_vad(st, pIn, activity) {
    silk_vad_get_sa_q8(st, pIn);
    if (activity == 0 && load64(st + _SKE_SPEECH_Q8) >= 13) { store64(st + _SKE_SPEECH_Q8, 12); }
    var nf = load64(st + _SKE_NFRAMES_ENC);
    if (load64(st + _SKE_SPEECH_Q8) < 13) {
        _ske_set_idx(st, _SKI_SIGNAL_TYPE, 0);
        var ns = load64(st + _SKE_NOSPEECH) + 1;
        store64(st + _SKE_NOSPEECH, ns);
        if (ns <= 10) { store64(st + _SKE_INDTX, 0); }
        else {
            if (ns > 30) { store64(st + _SKE_NOSPEECH, 10); store64(st + _SKE_INDTX, 0); }
        }
        store64(st + _SKE_VAD_FLAGS + nf * 8, 0);
    } else {
        store64(st + _SKE_NOSPEECH, 0);
        store64(st + _SKE_INDTX, 0);
        _ske_set_idx(st, _SKI_SIGNAL_TYPE, 1);
        store64(st + _SKE_VAD_FLAGS + nf * 8, 1);
    }
    return 0;
}

# ---------------------------------------------------------------- float helpers (2.11.1)

# silk_sigmoid: 1 / (1 + e^-x)
fn _sk_sigmoid(x) { return f64_div(F64_ONE, f64_add(F64_ONE, f64_exp(f64_neg(x)))); }

# silk_log2 (SigProc_FLP.h): 3.32192809488736 log10(x)
fn _sk_log2(x) {
    var c = f64_div(f64_from(332192809488736), f64_from(100000000000000));
    return f64_mul(c, f64_div(f64_ln(x), f64_ln(f64_from(10))));
}

# silk_autocorrelation_FLP: r[i] = sum x[n] x[n+i], i < count (and < n).
fn silk_autocorrelation_flp(r, x, n, count) {
    if (count > n) { count = n; }
    var i = 0;
    while (i < count) {
        store64(r + i * 8, silk_inner_product_flp(x, x + i * 8, n - i));
        i = i + 1;
    }
    return 0;
}

# silk_schur_FLP: reflection coefficients from an autocorrelation (double
# precision); returns the residual energy.
fn silk_schur_flp(rc, ac, order) {
    var c0 = _opus_tmp(25 * 8);
    var c1 = _opus_tmp(25 * 8);
    var k = 0;
    while (k <= order) {
        store64(c0 + k * 8, load64(ac + k * 8));
        store64(c1 + k * 8, load64(ac + k * 8));
        k = k + 1;
    }
    var floor = _skf(1, 1000000000);
    k = 0;
    while (k < order) {
        var den = load64(c1);
        if (f64_lt(den, floor) == 1) { den = floor; }
        var rt = f64_neg(f64_div(load64(c0 + (k + 1) * 8), den));
        store64(rc + k * 8, rt);
        var n = 0;
        while (n < order - k) {
            var t1 = load64(c0 + (n + k + 1) * 8);
            var t2 = load64(c1 + n * 8);
            store64(c0 + (n + k + 1) * 8, f64_add(t1, f64_mul(t2, rt)));
            store64(c1 + n * 8, f64_add(t2, f64_mul(t1, rt)));
            n = n + 1;
        }
        k = k + 1;
    }
    return load64(c1);
}

# silk_k2a_FLP: reflection coefficients to prediction coefficients (step-up).
fn silk_k2a_flp(A, rc, order) {
    var k = 0;
    while (k < order) {
        var rk = load64(rc + k * 8);
        var n = 0;
        while (n < (k + 1) >> 1) {
            var t1 = load64(A + n * 8);
            var t2 = load64(A + (k - n - 1) * 8);
            store64(A + n * 8, f64_add(t1, f64_mul(t2, rk)));
            store64(A + (k - n - 1) * 8, f64_add(t2, f64_mul(t1, rk)));
            n = n + 1;
        }
        store64(A + k * 8, f64_neg(rk));
        k = k + 1;
    }
    return 0;
}

# silk_bwexpander_FLP: a[i] *= chirp^(i+1).
fn silk_bwexpander_flp(a, d, chirp) {
    var cf = chirp;
    var i = 0;
    while (i < d - 1) {
        store64(a + i * 8, f64_mul(load64(a + i * 8), cf));
        cf = f64_mul(cf, chirp);
        i = i + 1;
    }
    store64(a + (d - 1) * 8, f64_mul(load64(a + (d - 1) * 8), cf));
    return 0;
}

# silk_apply_sine_window_FLP: x times a rising (1) or falling (2) sine slope,
# by libopus's recursion (length a multiple of 4).
fn silk_apply_sine_window_flp(w, x, win_type, length) {
    var freq = f64_div(F64_PI, f64_from(length + 1));
    var c = f64_sub(F64_TWO, f64_mul(freq, freq));
    var S0 = F64_ZERO;
    var S1 = freq;
    if (win_type >= 2) {
        S0 = F64_ONE;
        S1 = f64_mul(F64_HALF, c);
    }
    var k = 0;
    while (k < length) {
        store64(w + k * 8, f64_mul(f64_mul(load64(x + k * 8), F64_HALF), f64_add(S0, S1)));
        store64(w + (k + 1) * 8, f64_mul(load64(x + (k + 1) * 8), S1));
        S0 = f64_sub(f64_mul(c, S1), S0);
        store64(w + (k + 2) * 8, f64_mul(f64_mul(load64(x + (k + 2) * 8), F64_HALF), f64_add(S1, S0)));
        store64(w + (k + 3) * 8, f64_mul(load64(x + (k + 3) * 8), S0));
        S1 = f64_sub(f64_mul(c, S0), S1);
        k = k + 4;
    }
    return 0;
}

# silk_warped_autocorrelation_FLP: the autocorrelation on a warped frequency
# scale (a chain of first-order all-passes), order even.
fn silk_warped_autocorrelation_flp(corr, x, warping, length, order) {
    var stt = _opus_tmp(25 * 8);
    var C = _opus_tmp(25 * 8);
    var i = 0;
    while (i <= order) { store64(stt + i * 8, F64_ZERO); store64(C + i * 8, F64_ZERO); i = i + 1; }
    var n = 0;
    while (n < length) {
        var t1 = load64(x + n * 8);
        i = 0;
        while (i < order) {
            var t2 = f64_sub(f64_add(load64(stt + i * 8), f64_mul(warping, load64(stt + (i + 1) * 8))), f64_mul(warping, t1));
            store64(stt + i * 8, t1);
            store64(C + i * 8, f64_add(load64(C + i * 8), f64_mul(load64(stt), t1)));
            t1 = f64_sub(f64_add(load64(stt + (i + 1) * 8), f64_mul(warping, load64(stt + (i + 2) * 8))), f64_mul(warping, t2));
            store64(stt + (i + 1) * 8, t2);
            store64(C + (i + 1) * 8, f64_add(load64(C + (i + 1) * 8), f64_mul(load64(stt), t2)));
            i = i + 2;
        }
        store64(stt + order * 8, t1);
        store64(C + order * 8, f64_add(load64(C + order * 8), f64_mul(load64(stt), t1)));
        n = n + 1;
    }
    i = 0;
    while (i <= order) { store64(corr + i * 8, load64(C + i * 8)); i = i + 1; }
    return 0;
}

# warped_gain (noise_shape_analysis_FLP.c): the gain of a warped filter at DC.
fn _sk_warped_gain(coefs, lambda, order) {
    lambda = f64_neg(lambda);
    var g = load64(coefs + (order - 1) * 8);
    var i = order - 2;
    while (i >= 0) {
        g = f64_add(f64_mul(lambda, g), load64(coefs + i * 8));
        i = i - 1;
    }
    return f64_div(F64_ONE, f64_sub(F64_ONE, f64_mul(lambda, g)));
}

# The index and value of the largest |c[i]|, i < order (the first on ties).
fn _sk_maxabs(coefs, order, ind_ptr) {
    var m = f64_neg(F64_ONE);
    var i = 0;
    while (i < order) {
        var t = f64_abs(load64(coefs + i * 8));
        if (f64_gt(t, m) == 1) { m = t; store64(ind_ptr, i); }
        i = i + 1;
    }
    return m;
}

# The bandwidth expansion limit_coefs and warped_true2monic_coefs apply when a
# coefficient exceeds `limit`: 0.99 - (0.8 + 0.1 iter)(maxabs - limit)/(maxabs (ind + 1)).
fn _sk_limit_chirp(maxabs, limit, iter, ind) {
    var num = f64_mul(f64_add(_skf(4, 5), f64_mul(_skf(1, 10), f64_from(iter))), f64_sub(maxabs, limit));
    return f64_sub(_skf(99, 100), f64_div(num, f64_mul(maxabs, f64_from(ind + 1))));
}

# limit_coefs: bandwidth-expand until every |coef| <= limit (at most 10 rounds).
fn _sk_limit_coefs(coefs, limit, order) {
    var ip = _opus_tmp(8);
    store64(ip, 0);
    var iter = 0;
    while (iter < 10) {
        var m = _sk_maxabs(coefs, order, ip);
        if (f64_le(m, limit) == 1) { return 0; }
        silk_bwexpander_flp(coefs, order, _sk_limit_chirp(m, limit, iter, load64(ip)));
        iter = iter + 1;
    }
    return 0;
}

fn _sk_to_monic(coefs, lambda, order) {
    var i = order - 1;
    while (i > 0) {
        store64(coefs + (i - 1) * 8, f64_sub(load64(coefs + (i - 1) * 8), f64_mul(lambda, load64(coefs + i * 8))));
        i = i - 1;
    }
    var g = f64_div(f64_sub(F64_ONE, f64_mul(lambda, lambda)), f64_add(F64_ONE, f64_mul(lambda, load64(coefs))));
    i = 0;
    while (i < order) { store64(coefs + i * 8, f64_mul(load64(coefs + i * 8), g)); i = i + 1; }
    return g;
}

# warped_true2monic_coefs: warped coefficients to monic pseudo-warped ones, with
# the same limit on their size.
fn _sk_warped_true2monic(coefs, lambda, limit, order) {
    var ip = _opus_tmp(8);
    store64(ip, 0);
    var g = _sk_to_monic(coefs, lambda, order);
    var iter = 0;
    while (iter < 10) {
        var m = _sk_maxabs(coefs, order, ip);
        if (f64_le(m, limit) == 1) { return 0; }
        # back to true warped coefficients, expand, and monic again
        var i = 1;
        while (i < order) {
            store64(coefs + (i - 1) * 8, f64_add(load64(coefs + (i - 1) * 8), f64_mul(lambda, load64(coefs + i * 8))));
            i = i + 1;
        }
        var ig = f64_div(F64_ONE, g);
        i = 0;
        while (i < order) { store64(coefs + i * 8, f64_mul(load64(coefs + i * 8), ig)); i = i + 1; }
        silk_bwexpander_flp(coefs, order, _sk_limit_chirp(m, limit, iter, load64(ip)));
        g = _sk_to_monic(coefs, lambda, order);
        iter = iter + 1;
    }
    return 0;
}

# ---------------------------------------------------------------- pitch analysis front end

# silk_find_pitch_lags_FLP (find_pitch_lags_FLP.c): a sine-windowed LPC
# analysis of the last pitch_LPC_win_length samples (Schur, step-up, bandwidth
# expansion), its prediction gain, and the whole buffer's residual through it
# into res (la_pitch + frame + ltp_mem samples, from x - ltp_mem_length). Then,
# on a frame with voice activity after the first, the voicing decision: the
# pitch estimator over that residual, against a threshold that falls with
# the analysis order, speech activity, a voiced previous frame and the input's
# tilt. A voiced frame gets its lags, lag and contour indices and LTPCorr; any
# other has none.
fn silk_find_pitch_lags_flp(st, ctrl, res, x) {
    var la = load64(st + _SKE_LA_PITCH);
    var fl = load64(st + _SKE_FRAME_LEN);
    var lm = load64(st + _SKE_LTP_MEM);
    var win = load64(st + _SKE_PITCH_WIN);
    var po = load64(st + _SKE_PITCH_ORDER);
    var buf_len = la + fl + lm;
    var xb = x - lm * 8;
    var W = _opus_tmp(win * 8);
    var xp = xb + (buf_len - win) * 8;
    silk_apply_sine_window_flp(W, xp, 1, la);
    var mid = win - (la << 1);
    var i = 0;
    while (i < mid) { store64(W + (la + i) * 8, load64(xp + (la + i) * 8)); i = i + 1; }
    silk_apply_sine_window_flp(W + (la + mid) * 8, xp + (la + mid) * 8, 2, la);
    var ac = _opus_tmp(17 * 8);
    silk_autocorrelation_flp(ac, W, win, po + 1);
    store64(ac, f64_add(load64(ac), f64_add(f64_mul(load64(ac), _skf(1, 1000)), F64_ONE)));
    var rc = _opus_tmp(16 * 8);
    var rn = silk_schur_flp(rc, ac, po);
    var floor = rn;
    if (f64_lt(floor, F64_ONE) == 1) { floor = F64_ONE; }
    store64(ctrl + _SKC_PRED_GAIN, f64_div(load64(ac), floor));
    var A = _opus_tmp(16 * 8);
    i = 0;
    while (i < 16) { store64(A + i * 8, F64_ZERO); i = i + 1; }
    silk_k2a_flp(A, rc, po);
    silk_bwexpander_flp(A, po, _skf(99, 100));
    silk_lpc_analysis_filter_flp(res, A, xb, buf_len, po);
    if (_ske_idx(st, _SKI_SIGNAL_TYPE) != 0 && load64(st + _SKE_FIRST) == 0) {
        var li = _opus_tmp(2 * 8);
        var v = silk_pitch_analysis_core_flp(res, ctrl + _SKC_PITCHL, li, st + _SKE_LTP_CORR, load64(st + _SKE_PREV_LAG),
          _skf(load64(st + _SKE_PE_THRES_Q16), 65536), _sk_pitch_threshold(st), load64(st + _SKE_FS_KHZ),
          load64(st + _SKE_PE_COMPLEXITY), load64(st + _SKE_NB_SUBFR));
        _ske_set_idx(st, _SKI_LAG, load64(li));
        _ske_set_idx(st, _SKI_CONTOUR, load64(li + 8));
        if (v == 0) { _ske_set_idx(st, _SKI_SIGNAL_TYPE, 2); }
        else { _ske_set_idx(st, _SKI_SIGNAL_TYPE, 1); }
    } else {
        i = 0;
        while (i < 4) { store64(ctrl + _SKC_PITCHL + i * 8, 0); i = i + 1; }
        _ske_set_idx(st, _SKI_LAG, 0);
        _ske_set_idx(st, _SKI_CONTOUR, 0);
        store64(st + _SKE_LTP_CORR, F64_ZERO);
    }
    return 0;
}

# The voicing threshold: the normalised correlation a voiced frame needs, 0.6
# less 0.004 an analysis order, 0.1 at full speech activity, 0.15 after a voiced
# frame and 0.1 of the input's tilt.
fn _sk_pitch_threshold(st) {
    var thr = _skf(3, 5);
    thr = f64_sub(thr, f64_mul(_skf(1, 250), f64_from(load64(st + _SKE_PITCH_ORDER))));
    thr = f64_sub(thr, f64_mul(f64_mul(_skf(1, 10), f64_from(load64(st + _SKE_SPEECH_Q8))), _skf(1, 256)));
    thr = f64_sub(thr, f64_mul(_skf(3, 20), f64_from(load64(st + _SKE_PREV_SIGNAL) >> 1)));
    thr = f64_sub(thr, f64_mul(f64_mul(_skf(1, 10), f64_from(load64(st + _SKE_TILT_Q15))), _skf(1, 32768)));
    return thr;
}

# ---------------------------------------------------------------- pitch estimation (2.12.0)
#
# silk_pitch_analysis_core_FLP (pitch_analysis_core_FLP.c) and what it needs:
# the residual decimated to 8 and 4 kHz in fixed point, a coarse search over
# lags at 4 kHz, a finer one over the best of them at 8 kHz with a lag contour
# per subframe, and at 12 and 16 kHz a last search around that lag at the
# full rate. Float stages in f64, the decimators exact.

var _sk_ltp_bits = 0;         # [3] silk_LTP_gain_BITS_Q5_{0,1,2}: code lengths, Q5 (bytes)
var _sk_ltp_vqgain = 0;       # [3] silk_LTP_gain_vq_{0,1,2}_gain: each vector's gain, Q7 (bytes)
var _sk_lag_range = 0;        # silk_Lag_range_stage3 [3][4][2]
var _sk_lag_range10 = 0;      # silk_Lag_range_stage3_10_ms [2][2]

# Comma-separated integers, a leading '-' allowed, into n words.
fn _sk_ints(csv, n) {
    var t = alloc(n * 8);
    var p = 0;
    var i = 0;
    while (i < n) {
        var neg = 0;
        var c = load8(csv + p);
        if (c == 45) { neg = 1; p = p + 1; c = load8(csv + p); }
        var v = 0;
        while (c >= 48 && c <= 57) { v = v * 10 + c - 48; p = p + 1; c = load8(csv + p); }
        if (neg == 1) { v = 0 - v; }
        store64(t + i * 8, v);
        i = i + 1;
        if (c == 44) { p = p + 1; }
    }
    return t;
}

# libopus's tables_LTP.c and pitch_est_tables.c (the lag codebooks and LTP
# vectors are the decoder's, in src/silk.cyr).
fn _sk_pitch_tables_init() {
    if (_silk_cblags2 == 0) { _silk_tables4_init(); }
    if (_silk_cblags3_10 == 0) { _silk_tables6_init(); }
    var b = alloc(3 * 8);
    store64(b, _sk_bytes("15,131,138,138,155,155,173,173", 8));
    store64(b + 8, _sk_bytes("69,93,115,118,131,138,141,138,150,150,155,150,155,160,166,160", 16));
    store64(b + 16, _sk_bytes("131,128,134,141,141,141,145,145,145,150,155,155,155,155,160,160,160,160,166,166,173,173,182,192,182,192,192,192,205,192,205,224", 32));
    var g = alloc(3 * 8);
    store64(g, _sk_bytes("46,2,90,87,93,91,82,98", 8));
    store64(g + 8, _sk_bytes("109,120,118,12,113,115,117,119,99,59,87,111,63,111,112,80", 16));
    store64(g + 16, _sk_bytes("126,124,125,124,129,121,126,23,132,127,127,127,126,127,122,133,130,134,101,118,119,145,126,86,124,120,123,119,170,173,107,109", 32));
    _sk_lag_range = _sk_ints("-5,8,-1,6,-1,6,-4,10,-6,10,-2,6,-1,6,-5,10,-9,12,-3,7,-2,7,-7,13", 24);
    _sk_lag_range10 = _sk_ints("-3,7,-2,7", 4);
    _sk_ltp_vqgain = g;
    _sk_ltp_bits = b;
    return 0;
}

# silk_resampler_down2 (resampler_down2.c): half the rate through two
# first-order all-pass sections, Q10. S: 2 words of state; int16 values as
# words. inLen/2 outputs.
fn silk_resampler_down2(S, out, inp, inLen) {
    var len2 = inLen >> 1;
    var k = 0;
    while (k < len2) {
        var in32 = load64(inp + 2 * k * 8) << 10;
        var Y = silk_sx32(in32 - load64(S));
        var X = silk_smlawb(Y, Y, 39809 - 65536);        # silk_resampler_down2_1
        var out32 = silk_sx32(load64(S) + X);
        store64(S, silk_sx32(in32 + X));
        in32 = load64(inp + (2 * k + 1) * 8) << 10;
        Y = silk_sx32(in32 - load64(S + 8));
        X = silk_sx32(silk_smulwb(Y, 9872));               # silk_resampler_down2_0
        out32 = silk_sx32(out32 + load64(S + 8));
        out32 = silk_sx32(out32 + X);
        store64(S + 8, silk_sx32(in32 + X));
        store64(out + k * 8, silk_sat16(silk_rshift_round(out32, 11)));
        k = k + 1;
    }
    return 0;
}

# silk_resampler_private_AR2: a second-order AR filter, its output in Q8.
fn _sk_resampler_ar2(S, out_Q8, inp, a0, a1, len) {
    var k = 0;
    while (k < len) {
        var out32 = silk_sx32(load64(S) + (load64(inp + k * 8) << 8));
        store64(out_Q8 + k * 8, out32);
        out32 = silk_sx32(out32 << 2);
        store64(S, silk_smlawb(load64(S + 8), out32, a0));
        store64(S + 8, silk_sx32(silk_smulwb(out32, a1)));
        k = k + 1;
    }
    return 0;
}

# silk_resampler_down2_3 (resampler_down2_3.c): two thirds of the rate, low
# quality: the AR2 filter, then a 4-tap interpolation for each pair of outputs
# from three inputs. S: 6 words (4 buffered samples, the filter's 2).
fn silk_resampler_down2_3(S, out, inp, inLen) {
    var buf = _opus_tmp((480 + 4) * 8);
    var i = 0;
    while (i < 4) { store64(buf + i * 8, load64(S + i * 8)); i = i + 1; }
    var op = out;
    var ip = inp;
    var nIn = 0;
    var done = 0;
    while (done == 0) {
        nIn = inLen;
        if (nIn > 480) { nIn = 480; }                  # RESAMPLER_MAX_BATCH_SIZE_IN
        _sk_resampler_ar2(S + 32, buf + 32, ip, 0 - 2797, 0 - 6507, nIn);
        var bp = buf;
        var counter = nIn;
        while (counter > 2) {
            # silk_Resampler_2_3_COEFS_LQ[2..5]: 4697, 10739, 1567, 8276
            var r = silk_smulwb(load64(bp), 4697);
            r = silk_smlawb(r, load64(bp + 8), 10739);
            r = silk_smlawb(r, load64(bp + 16), 8276);
            r = silk_smlawb(r, load64(bp + 24), 1567);
            store64(op, silk_sat16(silk_rshift_round(r, 6)));
            op = op + 8;
            r = silk_smulwb(load64(bp + 8), 1567);
            r = silk_smlawb(r, load64(bp + 16), 8276);
            r = silk_smlawb(r, load64(bp + 24), 10739);
            r = silk_smlawb(r, load64(bp + 32), 4697);
            store64(op, silk_sat16(silk_rshift_round(r, 6)));
            op = op + 8;
            bp = bp + 24;
            counter = counter - 3;
        }
        ip = ip + nIn * 8;
        inLen = inLen - nIn;
        if (inLen > 0) {
            i = 0;
            while (i < 4) { store64(buf + i * 8, load64(buf + (nIn + i) * 8)); i = i + 1; }
        } else {
            done = 1;
        }
    }
    i = 0;
    while (i < 4) { store64(S + i * 8, load64(buf + (nIn + i) * 8)); i = i + 1; }
    return 0;
}

# celt_pitch_xcorr: xcorr[i] = sum x[j] y[i + j], j < len, for i < max_pitch.
fn _sk_pitch_xcorr(x, y, xcorr, len, max_pitch) {
    var i = 0;
    while (i < max_pitch) {
        var acc = F64_ZERO;
        var yp = y + i * 8;
        var j = 0;
        while (j < len) { acc = f64_add(acc, f64_mul(load64(x + j * 8), load64(yp + j * 8))); j = j + 1; }
        store64(xcorr + i * 8, acc);
        i = i + 1;
    }
    return 0;
}

# silk_insertion_sort_decreasing_FLP: the K largest of a[0..L) sorted to the
# front, decreasing, with their original indices in idx.
fn silk_insertion_sort_decreasing_flp(a, idx, L, K) {
    var i = 0;
    while (i < K) { store64(idx + i * 8, i); i = i + 1; }
    i = 1;
    while (i < K) {
        var value = load64(a + i * 8);
        var j = i - 1;
        while (j >= 0 && f64_gt(value, load64(a + j * 8)) == 1) {
            store64(a + (j + 1) * 8, load64(a + j * 8));
            store64(idx + (j + 1) * 8, load64(idx + j * 8));
            j = j - 1;
        }
        store64(a + (j + 1) * 8, value);
        store64(idx + (j + 1) * 8, i);
        i = i + 1;
    }
    i = K;
    while (i < L) {
        var value2 = load64(a + i * 8);
        if (f64_gt(value2, load64(a + (K - 1) * 8)) == 1) {
            var j2 = K - 2;
            while (j2 >= 0 && f64_gt(value2, load64(a + j2 * 8)) == 1) {
                store64(a + (j2 + 1) * 8, load64(a + j2 * 8));
                store64(idx + (j2 + 1) * 8, load64(idx + j2 * 8));
                j2 = j2 - 1;
            }
            store64(a + (j2 + 1) * 8, value2);
            store64(idx + (j2 + 1) * 8, i);
        }
        i = i + 1;
    }
    return 0;
}

# silk_nb_cbk_searchs_stage3: the 20 ms contour codebook entries the third
# stage searches at each estimator complexity.
fn _sk_st3_ncb(complexity) {
    if (complexity == 0) { return 16; }
    if (complexity == 1) { return 24; }
    return 34;
}

# The stage-3 lag ranges and codebook of a frame size and complexity.
fn _sk_st3_range(nb_subfr, complexity) {
    if (nb_subfr == 4) { return _sk_lag_range + complexity * 64; }
    return _sk_lag_range10;
}

# silk_P_Ana_calc_corr_st3: per subframe, the correlations of the 20 ms frame
# start's subframes with the lags start_lag + its range, laid out per contour
# codebook entry and lag offset: cc[(k * 34 + i) * 5 + j].
fn _sk_calc_corr_st3(cc, frame, start_lag, sf_length, nb_subfr, complexity) {
    var rng = _sk_st3_range(nb_subfr, complexity);
    var cb = _silk_cblags3;
    var nbc = _sk_st3_ncb(complexity);
    var cbs = 34;
    if (nb_subfr != 4) { cb = _silk_cblags3_10; nbc = 12; cbs = 12; }
    var scratch = _opus_tmp(22 * 8);
    var xc = _opus_tmp(22 * 8);
    var tp = frame + (sf_length << 2) * 8;
    var k = 0;
    while (k < nb_subfr) {
        var lo = load64(rng + (k * 2) * 8);
        var hi = load64(rng + (k * 2 + 1) * 8);
        _sk_pitch_xcorr(tp, tp - (start_lag + hi) * 8, xc, sf_length, hi - lo + 1);
        var n = 0;
        var j = lo;
        while (j <= hi) { store64(scratch + n * 8, load64(xc + (hi - j) * 8)); n = n + 1; j = j + 1; }
        var i = 0;
        while (i < nbc) {
            var idx = load64(cb + (k * cbs + i) * 8) - lo;
            j = 0;
            while (j < 5) { store64(cc + ((k * 34 + i) * 5 + j) * 8, load64(scratch + (idx + j) * 8)); j = j + 1; }
            i = i + 1;
        }
        tp = tp + sf_length * 8;
        k = k + 1;
    }
    return 0;
}

# silk_P_Ana_calc_energy_st3: the energies of the same lagged subframes,
# recursively (one sample in, one out), in the same layout.
fn _sk_calc_energy_st3(en, frame, start_lag, sf_length, nb_subfr, complexity) {
    var rng = _sk_st3_range(nb_subfr, complexity);
    var cb = _silk_cblags3;
    var nbc = _sk_st3_ncb(complexity);
    var cbs = 34;
    if (nb_subfr != 4) { cb = _silk_cblags3_10; nbc = 12; cbs = 12; }
    var scratch = _opus_tmp(22 * 8);
    var tp = frame + (sf_length << 2) * 8;
    var k = 0;
    while (k < nb_subfr) {
        var lo = load64(rng + (k * 2) * 8);
        var bp = tp - (start_lag + lo) * 8;
        var e = f64_add(silk_energy_flp(bp, sf_length), f64_div(F64_ONE, f64_from(1000)));   # 1e-3, a double
        store64(scratch, e);
        var n = 1;
        var ld = load64(rng + (k * 2 + 1) * 8) - lo + 1;
        var i = 1;
        while (i < ld) {
            var a = load64(bp + (sf_length - i) * 8);
            e = f64_sub(e, f64_mul(a, a));
            var b = load64(bp - i * 8);
            e = f64_add(e, f64_mul(b, b));
            store64(scratch + n * 8, e);
            n = n + 1;
            i = i + 1;
        }
        i = 0;
        while (i < nbc) {
            var idx = load64(cb + (k * cbs + i) * 8) - lo;
            var j = 0;
            while (j < 5) { store64(en + ((k * 34 + i) * 5 + j) * 8, load64(scratch + (idx + j) * 8)); j = j + 1; }
            i = i + 1;
        }
        tp = tp + sf_length * 8;
        k = k + 1;
    }
    return 0;
}

# The pitch analysis's unvoiced exits: no lags, no correlation.
fn _sk_pitch_unvoiced(pitch_out, out, LTPCorr) {
    var k = 0;
    while (k < 4) { store64(pitch_out + k * 8, 0); k = k + 1; }
    store64(LTPCorr, F64_ZERO);
    store64(out, 0);
    store64(out + 8, 0);
    return 1;
}

# silk_pitch_analysis_core_FLP: frame is (20 + 5 nb_subfr) ms at Fs_kHz (the
# pitch LPC residual). Returns 0 for voiced, with pitch_out[nb_subfr], out[0]
# lagIndex, out[1] contourIndex and *LTPCorr (in: the previous frame's, which
# biases the search towards prevLag); 1 for unvoiced, all of them zero.
# thres1: the first stage's candidate threshold, relative to the best; thres2:
# the normalised correlation a voiced frame needs.
fn silk_pitch_analysis_core_flp(frame, pitch_out, out, LTPCorr, prevLag, thres1, thres2, Fs_kHz, complexity, nb_subfr) {
    if (_sk_lag_range == 0) { _sk_pitch_tables_init(); }
    var frame_length = (20 + nb_subfr * 5) * Fs_kHz;
    var fl4 = (20 + nb_subfr * 5) * 4;
    var fl8 = (20 + nb_subfr * 5) * 8;
    var sf_length = 5 * Fs_kHz;
    var min_lag = 2 * Fs_kHz;
    var max_lag = 18 * Fs_kHz - 1;
    var f8 = _opus_tmp(320 * 8);
    var f4 = _opus_tmp(160 * 8);
    var f8x = _opus_tmp(320 * 8);
    var f4x = _opus_tmp(160 * 8);
    var fs = _opus_tmp(6 * 8);
    var i = 0;
    # to 8 kHz, through int16
    if (Fs_kHz == 8) {
        i = 0;
        while (i < fl8) { store64(f8x + i * 8, silk_sat16(_sk_lrint(load64(frame + i * 8)))); i = i + 1; }
    } else {
        var fx = _opus_tmp(640 * 8);
        i = 0;
        while (i < frame_length) { store64(fx + i * 8, silk_sat16(_sk_lrint(load64(frame + i * 8)))); i = i + 1; }
        i = 0;
        while (i < 6) { store64(fs + i * 8, 0); i = i + 1; }
        if (Fs_kHz == 16) { silk_resampler_down2(fs, f8x, fx, frame_length); }
        else { silk_resampler_down2_3(fs, f8x, fx, frame_length); }
        i = 0;
        while (i < fl8) { store64(f8 + i * 8, f64_from(load64(f8x + i * 8))); i = i + 1; }
    }
    # and to 4 kHz, then a two-tap low-pass (in place, from the end)
    store64(fs, 0);
    store64(fs + 8, 0);
    silk_resampler_down2(fs, f4x, f8x, fl8);
    i = fl4 - 1;
    while (i > 0) {
        store64(f4x + i * 8, silk_sat16(load64(f4x + i * 8) + load64(f4x + (i - 1) * 8)));
        i = i - 1;
    }
    i = 0;
    while (i < fl4) { store64(f4 + i * 8, f64_from(load64(f4x + i * 8))); i = i + 1; }

    # first stage, 4 kHz: normalised correlations over lags 8 to 72
    var C = _opus_tmp(4 * 149 * 8);
    i = 0;
    while (i < 4 * 149) { store64(C + i * 8, F64_ZERO); i = i + 1; }
    var xcorr = _opus_tmp(65 * 8);
    var tp = f4 + 80 * 8;
    var k = 0;
    while (k < (nb_subfr >> 1)) {
        var bp = tp - 8 * 8;
        _sk_pitch_xcorr(tp, tp - 72 * 8, xcorr, 40, 65);
        var cc = load64(xcorr + 64 * 8);
        var norm = f64_add(f64_add(silk_energy_flp(tp, 40), silk_energy_flp(bp, 40)), f64_from(160000));
        store64(C + 8 * 8, f64_add(load64(C + 8 * 8), f64_div(f64_mul(F64_TWO, cc), norm)));
        var d = 9;
        while (d <= 72) {
            bp = bp - 8;
            cc = load64(xcorr + (72 - d) * 8);
            var b0 = load64(bp);
            var b1 = load64(bp + 40 * 8);
            norm = f64_add(norm, f64_sub(f64_mul(b0, b0), f64_mul(b1, b1)));
            store64(C + d * 8, f64_add(load64(C + d * 8), f64_div(f64_mul(F64_TWO, cc), norm)));
            d = d + 1;
        }
        tp = tp + 40 * 8;
        k = k + 1;
    }
    # a bias towards short lags
    i = 72;
    while (i >= 8) {
        var c0 = load64(C + i * 8);
        store64(C + i * 8, f64_sub(c0, f64_div(f64_mul(c0, f64_from(i)), f64_from(4096))));
        i = i - 1;
    }
    var nsrch = 4 + 2 * complexity;
    var d_srch = _opus_tmp(24 * 8);
    silk_insertion_sort_decreasing_flp(C + 8 * 8, d_srch, 65, nsrch);
    var Cmax = load64(C + 8 * 8);
    if (f64_lt(Cmax, _skf(1, 5)) == 1) { return _sk_pitch_unvoiced(pitch_out, out, LTPCorr); }
    var threshold = f64_mul(thres1, Cmax);
    i = 0;
    var cut = 0;
    while (i < nsrch && cut == 0) {
        if (f64_gt(load64(C + (8 + i) * 8), threshold) == 1) {
            store64(d_srch + i * 8, (load64(d_srch + i * 8) + 8) << 1);
            i = i + 1;
        } else {
            nsrch = i;
            cut = 1;
        }
    }
    # the candidates at 8 kHz, each widened by one lag either side
    var d_comp = _opus_tmp(149 * 8);
    i = 11;
    while (i < 148) { store64(d_comp + i * 8, 0); i = i + 1; }
    i = 0;
    while (i < nsrch) { store64(d_comp + load64(d_srch + i * 8) * 8, 1); i = i + 1; }
    i = 146;
    while (i >= 16) {
        store64(d_comp + i * 8, load64(d_comp + i * 8) + load64(d_comp + (i - 1) * 8) + load64(d_comp + (i - 2) * 8));
        i = i - 1;
    }
    nsrch = 0;
    i = 16;
    while (i < 144) {
        if (load64(d_comp + (i + 1) * 8) > 0) { store64(d_srch + nsrch * 8, i); nsrch = nsrch + 1; }
        i = i + 1;
    }
    i = 146;
    while (i >= 16) {
        store64(d_comp + i * 8, load64(d_comp + i * 8) + load64(d_comp + (i - 1) * 8) + load64(d_comp + (i - 2) * 8)
          + load64(d_comp + (i - 3) * 8));
        i = i - 1;
    }
    var ncomp = 0;
    i = 16;
    while (i < 147) {
        if (load64(d_comp + i * 8) > 0) { store64(d_comp + ncomp * 8, i - 2); ncomp = ncomp + 1; }
        i = i + 1;
    }

    # second stage, 8 kHz: each subframe's normalised correlation at those lags
    i = 0;
    while (i < 4 * 149) { store64(C + i * 8, F64_ZERO); i = i + 1; }
    tp = f8 + 160 * 8;
    if (Fs_kHz == 8) { tp = frame + 160 * 8; }
    k = 0;
    while (k < nb_subfr) {
        var etmp = f64_add(silk_energy_flp(tp, 40), F64_ONE);
        var j = 0;
        while (j < ncomp) {
            var dd = load64(d_comp + j * 8);
            var bq = tp - dd * 8;
            var xc = silk_inner_product_flp(bq, tp, 40);
            if (f64_gt(xc, F64_ZERO) == 1) {
                var en = silk_energy_flp(bq, 40);
                store64(C + (k * 149 + dd) * 8, f64_div(f64_mul(F64_TWO, xc), f64_add(en, etmp)));
            } else {
                store64(C + (k * 149 + dd) * 8, F64_ZERO);
            }
            j = j + 1;
        }
        tp = tp + 40 * 8;
        k = k + 1;
    }
    # the best lag and contour, biased towards short lags and the previous lag
    var CCmax = F64_ZERO;
    var CCmax_b = f64_from(0 - 1000);
    var CBimax = 0;
    var lag = 0 - 1;
    var prevLag_log2 = F64_ZERO;
    if (prevLag > 0) {
        if (Fs_kHz == 12) { prevLag = (prevLag << 1) / 3; }
        if (Fs_kHz == 16) { prevLag = prevLag >> 1; }
        prevLag_log2 = _sk_f32(_sk_log2(f64_from(prevLag)));
    }
    var cbk = _silk_cblags2;
    var cbs = 11;
    var nbc = 3;
    if (nb_subfr == 4) {
        if (Fs_kHz == 8 && complexity > 0) { nbc = 11; }
    } else {
        cbk = _silk_cblags2_10;
        cbs = 3;
    }
    var CC = _opus_tmp(11 * 8);
    var nbsub = f64_from(nb_subfr);
    k = 0;
    while (k < nsrch) {
        var d2 = load64(d_srch + k * 8);
        var j2 = 0;
        while (j2 < nbc) {
            var acc = F64_ZERO;
            i = 0;
            while (i < nb_subfr) {
                acc = f64_add(acc, load64(C + (i * 149 + d2 + load64(cbk + (i * cbs + j2) * 8)) * 8));
                i = i + 1;
            }
            store64(CC + j2 * 8, acc);
            j2 = j2 + 1;
        }
        var CCmax_new = f64_from(0 - 1000);
        var CBimax_new = 0;
        i = 0;
        while (i < nbc) {
            if (f64_gt(load64(CC + i * 8), CCmax_new) == 1) { CCmax_new = load64(CC + i * 8); CBimax_new = i; }
            i = i + 1;
        }
        var lag_log2 = _sk_f32(_sk_log2(f64_from(d2)));
        var CCmax_new_b = f64_sub(CCmax_new, f64_mul(f64_mul(_skf(1, 5), nbsub), lag_log2));
        if (prevLag > 0) {
            var dl = f64_sub(lag_log2, prevLag_log2);
            dl = f64_mul(dl, dl);
            CCmax_new_b = f64_sub(CCmax_new_b, f64_div(f64_mul(f64_mul(f64_mul(_skf(1, 5), nbsub), load64(LTPCorr)), dl),
              f64_add(dl, F64_HALF)));
        }
        if (f64_gt(CCmax_new_b, CCmax_b) == 1 && f64_gt(CCmax_new, f64_mul(nbsub, thres2)) == 1) {
            CCmax_b = CCmax_new_b;
            CCmax = CCmax_new;
            lag = d2;
            CBimax = CBimax_new;
        }
        k = k + 1;
    }
    if (lag == 0 - 1) { return _sk_pitch_unvoiced(pitch_out, out, LTPCorr); }
    store64(LTPCorr, f64_div(CCmax, nbsub));

    if (Fs_kHz > 8) {
        # third stage, at the full rate around the lag
        if (Fs_kHz == 12) { lag = silk_rshift_round(silk_smulbb(lag, 3), 1); }
        else { lag = lag << 1; }
        lag = silk_limit(lag, min_lag, max_lag);
        var start_lag = lag - 2;
        if (start_lag < min_lag) { start_lag = min_lag; }
        var end_lag = lag + 2;
        if (end_lag > max_lag) { end_lag = max_lag; }
        var lag_new = lag;
        CBimax = 0;
        CCmax = f64_from(0 - 1000);
        var ccs = _opus_tmp(4 * 34 * 5 * 8);
        var ens = _opus_tmp(4 * 34 * 5 * 8);
        _sk_calc_corr_st3(ccs, frame, start_lag, sf_length, nb_subfr, complexity);
        _sk_calc_energy_st3(ens, frame, start_lag, sf_length, nb_subfr, complexity);
        var contour_bias = f64_div(_skf(1, 20), f64_from(lag));
        var cb3 = _silk_cblags3;
        var cbs3 = 34;
        var nbc3 = _sk_st3_ncb(complexity);
        if (nb_subfr != 4) { cb3 = _silk_cblags3_10; cbs3 = 12; nbc3 = 12; }
        var target = frame + 20 * Fs_kHz * 8;
        var etmp3 = f64_add(silk_energy_flp(target, nb_subfr * sf_length), F64_ONE);
        var lc = 0;
        var d3 = start_lag;
        while (d3 <= end_lag) {
            var j3 = 0;
            while (j3 < nbc3) {
                var xc3 = F64_ZERO;
                var e3 = etmp3;
                k = 0;
                while (k < nb_subfr) {
                    xc3 = f64_add(xc3, load64(ccs + ((k * 34 + j3) * 5 + lc) * 8));
                    e3 = f64_add(e3, load64(ens + ((k * 34 + j3) * 5 + lc) * 8));
                    k = k + 1;
                }
                var cn = F64_ZERO;
                if (f64_gt(xc3, F64_ZERO) == 1) {
                    cn = f64_div(f64_mul(F64_TWO, xc3), e3);
                    cn = f64_mul(cn, f64_sub(F64_ONE, f64_mul(contour_bias, f64_from(j3))));
                }
                # (libopus checks the reach with the 20 ms codebook's first row for both sizes)
                if (f64_gt(cn, CCmax) == 1 && d3 + load64(_silk_cblags3 + j3 * 8) <= max_lag) {
                    CCmax = cn;
                    lag_new = d3;
                    CBimax = j3;
                }
                j3 = j3 + 1;
            }
            lc = lc + 1;
            d3 = d3 + 1;
        }
        k = 0;
        while (k < nb_subfr) {
            store64(pitch_out + k * 8, silk_limit(lag_new + load64(cb3 + (k * cbs3 + CBimax) * 8), min_lag, 18 * Fs_kHz));
            k = k + 1;
        }
        store64(out, lag_new - min_lag);
        store64(out + 8, CBimax);
    } else {
        k = 0;
        while (k < nb_subfr) {
            store64(pitch_out + k * 8, silk_limit(lag + load64(cbk + (k * cbs + CBimax) * 8), 16, 144));
            k = k + 1;
        }
        store64(out, lag - 16);
        store64(out + 8, CBimax);
    }
    return 0;
}

# ---------------------------------------------------------------- noise shaping

# silk_noise_shape_analysis_FLP (noise_shape_analysis_FLP.c): from the target
# SNR, the VAD's measures and the signal, the frame's coding quality and
# quantiser offset, each subframe's noise shaping filter (a windowed LPC
# analysis of x around it, warped at complexity 4 and up) and gain, and the low
# frequency shaping, tilt and harmonic shaping, smoothed over subframes.
# pitch_res: the frame's LPC residual (silk_find_pitch_lags_flp's, from its
# frame start); x: the frame, with la_shape samples valid before and after.
fn silk_noise_shape_analysis_flp(st, ctrl, pitch_res, x) {
    var fs = load64(st + _SKE_FS_KHZ);
    var nb = load64(st + _SKE_NB_SUBFR);
    var sl = load64(st + _SKE_SUBFR_LEN);
    var so = load64(st + _SKE_SHAPE_ORDER);
    var la = load64(st + _SKE_LA_SHAPE);
    var swl = load64(st + _SKE_SHAPE_WIN);
    var wq16 = load64(st + _SKE_WARPING_Q16);
    var sig = _ske_idx(st, _SKI_SIGNAL_TYPE);
    var speech = f64_div(f64_from(load64(st + _SKE_SPEECH_Q8)), f64_from(256));
    var snr_db = f64_div(f64_from(load64(st + _SKE_SNR_Q7)), f64_from(128));
    var snr_adj = snr_db;
    var iq = f64_div(f64_mul(F64_HALF, f64_from(load64(st + _SKE_QUALITY) + load64(st + _SKE_QUALITY + 8))), f64_from(32768));
    store64(ctrl + _SKC_INPUT_QUALITY, iq);
    var cq = _sk_sigmoid(f64_mul(_skf(1, 4), f64_sub(snr_adj, f64_from(20))));
    store64(ctrl + _SKC_CODING_QUALITY, cq);
    if (load64(st + _SKE_USE_CBR) == 0) {
        # less SNR at low speech activity
        var b = f64_sub(F64_ONE, speech);
        snr_adj = f64_sub(snr_adj, f64_mul(f64_mul(f64_mul(f64_mul(F64_TWO, cq), f64_add(F64_HALF, f64_mul(F64_HALF, iq))), b), b));
    }
    if (sig == 2) {
        snr_adj = f64_add(snr_adj, f64_mul(F64_TWO, load64(st + _SKE_LTP_CORR)));
    } else {
        var adj = f64_add(f64_mul(f64_neg(_skf(2, 5)), snr_db), f64_from(6));
        snr_adj = f64_add(snr_adj, f64_mul(adj, f64_sub(F64_ONE, iq)));
    }
    # the quantiser offset: from the energy's fluctuation over 2 ms segments
    if (sig == 2) {
        _ske_set_idx(st, _SKI_QUANT_OFFSET, 0);
    } else {
        var ns = 2 * fs;
        var nseg = silk_smulbb(5, nb) / 2;
        var ev = F64_ZERO;
        var lprev = F64_ZERO;
        var rp = pitch_res;
        var k = 0;
        while (k < nseg) {
            var nrg = f64_add(f64_from(ns), silk_energy_flp(rp, ns));
            var le = _sk_log2(nrg);
            if (k > 0) { ev = f64_add(ev, f64_abs(f64_sub(le, lprev))); }
            lprev = le;
            rp = rp + ns * 8;
            k = k + 1;
        }
        if (f64_gt(ev, f64_mul(_skf(3, 5), f64_from(nseg - 1))) == 1) { _ske_set_idx(st, _SKI_QUANT_OFFSET, 0); }
        else { _ske_set_idx(st, _SKI_QUANT_OFFSET, 1); }
    }
    # more bandwidth expansion at high prediction gain
    var strength = f64_mul(_skf(1, 1000), load64(ctrl + _SKC_PRED_GAIN));
    var bwexp = f64_div(_skf(47, 50), f64_add(F64_ONE, f64_mul(strength, strength)));
    var warping = f64_add(f64_div(f64_from(wq16), f64_from(65536)), f64_mul(_skf(1, 100), cq));
    # each subframe's shaping filter and gain
    var flat = fs * 3;
    var slope = (swl - flat) / 2;
    var xw = _opus_tmp(swl * 8);
    var ac = _opus_tmp(25 * 8);
    var rc = _opus_tmp(25 * 8);
    var xp = x - la * 8;
    var k2 = 0;
    while (k2 < nb) {
        silk_apply_sine_window_flp(xw, xp, 1, slope);
        var j = 0;
        while (j < flat) { store64(xw + (slope + j) * 8, load64(xp + (slope + j) * 8)); j = j + 1; }
        silk_apply_sine_window_flp(xw + (slope + flat) * 8, xp + (slope + flat) * 8, 2, slope);
        xp = xp + sl * 8;
        if (wq16 > 0) { silk_warped_autocorrelation_flp(ac, xw, warping, swl, so); }
        else { silk_autocorrelation_flp(ac, xw, swl, so + 1); }
        store64(ac, f64_add(load64(ac), f64_add(f64_mul(load64(ac), _skf(3, 100000)), F64_ONE)));
        var nrg2 = silk_schur_flp(rc, ac, so);
        var ar = ctrl + _SKC_AR + k2 * 24 * 8;
        j = 0;
        while (j < 24) { store64(ar + j * 8, F64_ZERO); j = j + 1; }
        silk_k2a_flp(ar, rc, so);
        var g = f64_sqrt(nrg2);
        if (wq16 > 0) { g = f64_mul(g, _sk_warped_gain(ar, warping, so)); }
        store64(ctrl + _SKC_GAINS + k2 * 8, g);
        silk_bwexpander_flp(ar, so, bwexp);
        if (wq16 > 0) { _sk_warped_true2monic(ar, warping, _skf(3999, 1000), so); }
        else { _sk_limit_coefs(ar, _skf(3999, 1000), so); }
        k2 = k2 + 1;
    }
    # gains: up at low SNR, plus a floor
    var gm = f64_pow(F64_TWO, f64_mul(f64_neg(_skf(4, 25)), snr_adj));
    var ga = f64_pow(F64_TWO, f64_mul(_skf(4, 25), F64_TWO));          # 0.16 MIN_QGAIN_DB
    k2 = 0;
    while (k2 < nb) {
        store64(ctrl + _SKC_GAINS + k2 * 8, f64_add(f64_mul(load64(ctrl + _SKC_GAINS + k2 * 8), gm), ga));
        k2 = k2 + 1;
    }
    # low frequency shaping and tilt
    var q0 = f64_div(f64_from(load64(st + _SKE_QUALITY)), f64_from(32768));
    var lfs = f64_mul(f64_from(4), f64_add(F64_ONE, f64_mul(F64_HALF, f64_sub(q0, F64_ONE))));
    lfs = f64_mul(lfs, speech);
    var tilt = F64_ZERO;
    if (sig == 2) {
        k2 = 0;
        while (k2 < nb) {
            var bv = f64_add(f64_div(_skf(1, 5), f64_from(fs)), f64_div(f64_from(3), f64_from(load64(ctrl + _SKC_PITCHL + k2 * 8))));
            store64(ctrl + _SKC_LF_MA + k2 * 8, f64_add(f64_neg(F64_ONE), bv));
            store64(ctrl + _SKC_LF_AR + k2 * 8, f64_sub(f64_sub(F64_ONE, bv), f64_mul(bv, lfs)));
            k2 = k2 + 1;
        }
        tilt = f64_sub(f64_neg(_skf(1, 4)), f64_mul(f64_mul(f64_sub(F64_ONE, _skf(1, 4)), _skf(7, 20)), speech));
    } else {
        var b1 = f64_div(_skf(13, 10), f64_from(fs));
        var ma = f64_add(f64_neg(F64_ONE), b1);
        var arv = f64_sub(f64_sub(F64_ONE, b1), f64_mul(f64_mul(b1, lfs), _skf(3, 5)));
        k2 = 0;
        while (k2 < nb) {
            store64(ctrl + _SKC_LF_MA + k2 * 8, ma);
            store64(ctrl + _SKC_LF_AR + k2 * 8, arv);
            k2 = k2 + 1;
        }
        tilt = f64_neg(_skf(1, 4));
    }
    # harmonic shaping, voiced frames only
    var harm = F64_ZERO;
    if (sig == 2) {
        harm = f64_add(_skf(3, 10), f64_mul(_skf(1, 5), f64_sub(F64_ONE, f64_mul(f64_sub(F64_ONE, cq), iq))));
        harm = f64_mul(harm, f64_sqrt(load64(st + _SKE_LTP_CORR)));
    }
    # smoothed over subframes
    var sm = _skf(2, 5);
    k2 = 0;
    while (k2 < nb) {
        var hs = load64(st + _SKE_HARM_SMTH);
        hs = f64_add(hs, f64_mul(sm, f64_sub(harm, hs)));
        store64(st + _SKE_HARM_SMTH, hs);
        store64(ctrl + _SKC_HARM + k2 * 8, hs);
        var ts = load64(st + _SKE_TILT_SMTH);
        ts = f64_add(ts, f64_mul(sm, f64_sub(tilt, ts)));
        store64(st + _SKE_TILT_SMTH, ts);
        store64(ctrl + _SKC_TILT + k2 * 8, ts);
        k2 = k2 + 1;
    }
    return 0;
}

# silk_process_gains_FLP (process_gains_FLP.c): the shaping gains reduced at
# high LTP gain (voiced), soft-limited against the residual energy, quantised
# (silk_gains_quant: the indices, the carried last index, the quantised gains),
# the voiced quantiser offset, and the rate/distortion weight Lambda.
fn silk_process_gains_flp(st, ctrl, cond) {
    var nb = load64(st + _SKE_NB_SUBFR);
    var sig = _ske_idx(st, _SKI_SIGNAL_TYPE);
    var k = 0;
    if (sig == 2) {
        var s = f64_sub(F64_ONE, f64_mul(F64_HALF, _sk_sigmoid(f64_mul(_skf(1, 4), f64_sub(load64(ctrl + _SKC_LTPRED_GAIN), f64_from(12))))));
        k = 0;
        while (k < nb) { store64(ctrl + _SKC_GAINS + k * 8, f64_mul(load64(ctrl + _SKC_GAINS + k * 8), s)); k = k + 1; }
    }
    var snr_db = f64_div(f64_from(load64(st + _SKE_SNR_Q7)), f64_from(128));
    var inv_max = f64_div(f64_pow(F64_TWO, f64_mul(_skf(33, 100), f64_sub(f64_from(21), snr_db))), f64_from(load64(st + _SKE_SUBFR_LEN)));
    var cap = f64_from(32767);
    k = 0;
    while (k < nb) {
        var g = load64(ctrl + _SKC_GAINS + k * 8);
        g = f64_sqrt(f64_add(f64_mul(g, g), f64_mul(load64(ctrl + _SKC_RESNRG + k * 8), inv_max)));
        if (f64_gt(g, cap) == 1) { g = cap; }
        store64(ctrl + _SKC_GAINS + k * 8, g);
        k = k + 1;
    }
    # to Q16 by truncation, as libopus's (opus_int32) cast
    var gq = _opus_tmp(4 * 8);
    k = 0;
    while (k < nb) {
        var q = f64_to(f64_mul(load64(ctrl + _SKC_GAINS + k * 8), f64_from(65536)));
        store64(gq + k * 8, q);
        store64(ctrl + _SKC_GAINS_UNQ + k * 8, q);
        k = k + 1;
    }
    store64(ctrl + _SKC_LAST_GAIN_PREV, load64(st + _SKE_LAST_GAIN));
    var cnd = 0;
    if (cond == 2) { cnd = 1; }                     # CODE_CONDITIONALLY
    silk_gains_quant(st + _SKE_IDX + _SKI_GAINS * 8, gq, st + _SKE_LAST_GAIN, cnd, nb);
    k = 0;
    while (k < nb) {
        store64(ctrl + _SKC_GAINS + k * 8, _sk_gain_q16_flp(load64(gq + k * 8)));
        k = k + 1;
    }
    if (sig == 2) {
        var t = f64_add(load64(ctrl + _SKC_LTPRED_GAIN), f64_div(f64_from(load64(st + _SKE_TILT_Q15)), f64_from(32768)));
        if (f64_gt(t, F64_ONE) == 1) { _ske_set_idx(st, _SKI_QUANT_OFFSET, 0); }
        else { _ske_set_idx(st, _SKI_QUANT_OFFSET, 1); }
    }
    var qo = f64_div(f64_from(silk_quant_offset(sig, _ske_idx(st, _SKI_QUANT_OFFSET))), f64_from(1024));
    var lam = _skf(6, 5);
    lam = f64_add(lam, f64_mul(f64_neg(_skf(1, 20)), f64_from(load64(st + _SKE_NSTATES))));
    lam = f64_add(lam, f64_mul(f64_neg(_skf(1, 5)), f64_div(f64_from(load64(st + _SKE_SPEECH_Q8)), f64_from(256))));
    lam = f64_add(lam, f64_mul(f64_neg(_skf(1, 10)), load64(ctrl + _SKC_INPUT_QUALITY)));
    lam = f64_add(lam, f64_mul(f64_neg(_skf(1, 5)), load64(ctrl + _SKC_CODING_QUALITY)));
    lam = f64_add(lam, f64_mul(_skf(4, 5), qo));
    store64(ctrl + _SKC_LAMBDA, lam);
    return 0;
}

# ---------------------------------------------------------------- noise shaping quantiser
#
# silk_NSQ (NSQ.c): the excitation. Per sample: the short-term (and for voiced
# frames long-term) prediction and the noise shaping feedback (shaping filter,
# tilt, low-frequency and harmonic shaping) come off the gain-normalised input,
# and the residual is quantised to one of two levels by rate and distortion
# (Lambda), its sign dithered by a pseudo-random seed; the decoder's
# reconstruction is tracked to keep every prediction in step with it. Fixed
# point, 32-bit wrapping where libopus wraps; exact.
var _SKN_XQ = 0;              # [640] int16: quantised output, ltp_mem of history then the frame
var _SKN_SLTP_SHP = 5120;     # [640] sLTP_shp_Q14
var _SKN_SLPC = 10240;        # [96] sLPC_Q14 (16 of history, then a subframe)
var _SKN_SAR2 = 11008;        # [24] sAR2_Q14
var _SKN_SLF_AR = 11200;      # sLF_AR_shp_Q14
var _SKN_SDIFF = 11208;       # sDiff_shp_Q14
var _SKN_LAG_PREV = 11216;
var _SKN_SLTP_IDX = 11224;    # sLTP_buf_idx
var _SKN_SHP_IDX = 11232;     # sLTP_shp_buf_idx
var _SKN_SEED = 11240;        # rand_seed
var _SKN_PREV_GAIN = 11248;   # prev_gain_Q16
var _SKN_REWHITE = 11256;     # rewhite_flag
var _SKN_SIZE = 11264;

# A fresh state, as silk_setup_fs leaves it.
fn silk_nsq_new() { return _sk_nsq_init(alloc(_SKN_SIZE)); }

fn _sk_nsq_init(n) {
    _sk_zero(n, _SKN_SIZE);
    store64(n + _SKN_LAG_PREV, 100);
    store64(n + _SKN_PREV_GAIN, 65536);
    return n;
}

# silk_SMLAWT: a + (b * (c >> 16)) >> 16, and silk_SMULWT.
fn _sk_smlawt(a, b, c) { return silk_sx32(a + sar(b * sar(c, 16), 16)); }
fn _sk_smulwt(a, b) { return silk_sx32(sar(a * sar(b, 16), 16)); }
fn _sk_smulww(a, b) { return silk_sx32(sar(a * b, 16)); }
fn _sk_rand(seed) { return silk_sx32(907633515 + seed * 196314165); }

# silk_nsq_scale_states: the input over the subframe's gain (Q10), the
# re-whitened LTP state scaled to it, and every filter state rescaled when the
# gain changes. silk_SMULWW and silk_SMULWB inline (2.12.3), as in
# _sk_nsq_dd_scale_states: products under 2^62 shifted through the 2^62 bias, a
# gain ratio outside (0, 2^31) taking the helper.
fn _sk_nsq_scale_states(st, nsq, x16, x_sc, sLTP, sLTP_Q15, subfr, LTP_scale_Q14, gains, pitchL, sig) {
    var B62 = 4611686018427387904;
    var B46 = 70368744177664;
    var W32 = 4294967295;
    var H31 = 2147483648;
    var sl = load64(st + _SKE_SUBFR_LEN);
    var lm = load64(st + _SKE_LTP_MEM);
    var lag = load64(pitchL + subfr * 8);
    var g = load64(gains + subfr * 8);
    var gm = g;
    if (gm < 1) { gm = 1; }
    var inv31 = silk_inverse32_varq(gm, 47);
    var inv26 = silk_rshift_round(inv31, 5);
    var v = 0;
    var i = 0;
    while (i < sl) {
        v = ((load64(x16 + i * 8) * inv26 + B62) >> 16) - B46;
        store64(x_sc + i * 8, ((v + H31) & W32) - H31);
        i = i + 1;
    }
    var lidx = load64(nsq + _SKN_SLTP_IDX);
    if (load64(nsq + _SKN_REWHITE) == 1) {
        if (subfr == 0) { inv31 = silk_sx32(silk_smulwb(inv31, LTP_scale_Q14) << 2); }
        i = lidx - lag - 2;
        while (i < lidx) {
            store64(sLTP_Q15 + i * 8, ((inv31 * (((load64(sLTP + i * 8) & 0xFFFF) ^ 0x8000) - 0x8000) + B62) >> 16) - B46);
            i = i + 1;
        }
    }
    if (g != load64(nsq + _SKN_PREV_GAIN)) {
        var adj = silk_div32_varq(load64(nsq + _SKN_PREV_GAIN), g, 16);
        var sidx = load64(nsq + _SKN_SHP_IDX);
        if (adj >= 0 && adj < H31) {
            var a = nsq + _SKN_SLTP_SHP + (sidx - lm) * 8;
            var ae = nsq + _SKN_SLTP_SHP + sidx * 8;
            while (a < ae) {
                v = ((adj * load64(a) + B62) >> 16) - B46;
                store64(a, ((v + H31) & W32) - H31);
                a = a + 8;
            }
            if (sig == 2 && load64(nsq + _SKN_REWHITE) == 0) {
                a = sLTP_Q15 + (lidx - lag - 2) * 8;
                ae = sLTP_Q15 + lidx * 8;
                while (a < ae) {
                    v = ((adj * load64(a) + B62) >> 16) - B46;
                    store64(a, ((v + H31) & W32) - H31);
                    a = a + 8;
                }
            }
            v = ((adj * load64(nsq + _SKN_SLF_AR) + B62) >> 16) - B46;
            store64(nsq + _SKN_SLF_AR, ((v + H31) & W32) - H31);
            v = ((adj * load64(nsq + _SKN_SDIFF) + B62) >> 16) - B46;
            store64(nsq + _SKN_SDIFF, ((v + H31) & W32) - H31);
            a = nsq + _SKN_SLPC;
            ae = a + 16 * 8;
            while (a < ae) {
                v = ((adj * load64(a) + B62) >> 16) - B46;
                store64(a, ((v + H31) & W32) - H31);
                a = a + 8;
            }
            a = nsq + _SKN_SAR2;
            ae = a + 24 * 8;
            while (a < ae) {
                v = ((adj * load64(a) + B62) >> 16) - B46;
                store64(a, ((v + H31) & W32) - H31);
                a = a + 8;
            }
        } else {
            i = sidx - lm;
            while (i < sidx) {
                store64(nsq + _SKN_SLTP_SHP + i * 8, _sk_smulww(adj, load64(nsq + _SKN_SLTP_SHP + i * 8)));
                i = i + 1;
            }
            if (sig == 2 && load64(nsq + _SKN_REWHITE) == 0) {
                i = lidx - lag - 2;
                while (i < lidx) {
                    store64(sLTP_Q15 + i * 8, _sk_smulww(adj, load64(sLTP_Q15 + i * 8)));
                    i = i + 1;
                }
            }
            store64(nsq + _SKN_SLF_AR, _sk_smulww(adj, load64(nsq + _SKN_SLF_AR)));
            store64(nsq + _SKN_SDIFF, _sk_smulww(adj, load64(nsq + _SKN_SDIFF)));
            i = 0;
            while (i < 16) {
                store64(nsq + _SKN_SLPC + i * 8, _sk_smulww(adj, load64(nsq + _SKN_SLPC + i * 8)));
                i = i + 1;
            }
            i = 0;
            while (i < 24) {
                store64(nsq + _SKN_SAR2 + i * 8, _sk_smulww(adj, load64(nsq + _SKN_SAR2 + i * 8)));
                i = i + 1;
            }
        }
        store64(nsq + _SKN_PREV_GAIN, g);
    }
    return 0;
}

# silk_noise_shape_quantizer: one subframe, `length` samples. The arithmetic is
# inline (2.12.3) on the identities _sk_nsq_dd_quantizer states:
# silk_SMULWB(b, c) is floor(b * (int16)c / 2^16), arithmetic shifts go through
# the 2^62 bias, and the int32 wrap is reduction mod 2^32, so a value built by
# sums, differences and shifts left (the short-term prediction, the shaping
# filter silk_NSQ_noise_shape_feedback_loop with the tilt, the low-frequency
# shaping, the combined prediction before its rounding shift) is wrapped once.
# The levels' int16 cast before x Lambda is a no-op (within +-32,656); the
# residual's stays. Its sDiff, sLF_AR and indices live in locals for the
# subframe.
fn _sk_nsq_quantizer(nsq, sig, x_sc, pulses, xq, sLTP_Q15, a_Q12, b_Q14, ar_Q13, lag, harm_packed,
  tilt_Q14, lf_Q14, gain_Q16, lambda_Q10, offset_Q10, length, so, po) {
    var B62 = 4611686018427387904;           # 2^62
    var B46 = 70368744177664;                # 2^62 >> 16
    var B60 = 1152921504606846976;           # 2^62 >> 2
    var B59 = 576460752303423488;            # 2^62 >> 3
    var B52 = 4503599627370496;              # 2^62 >> 10
    var B54 = 18014398509481984;             # 2^62 >> 8
    var W32 = 4294967295;
    var H31 = 2147483648;
    var S31 = 2147483647;
    var a16 = _opus_tmp(16 * 8);
    var ar16 = _opus_tmp(24 * 8);
    var b16 = _opus_tmp(5 * 8);
    var t = 0;
    while (t < po) { store64(a16 + t * 8, _i16(load64(a_Q12 + t * 8))); t = t + 1; }
    t = 0;
    while (t < so) { store64(ar16 + t * 8, _i16(load64(ar_Q13 + t * 8))); t = t + 1; }
    t = 0;
    while (t < 5) { store64(b16 + t * 8, _i16(load64(b_Q14 + t * 8))); t = t + 1; }
    var tilt16 = _i16(tilt_Q14);
    var lf_lo = _i16(lf_Q14);
    var lf_hi = sar(lf_Q14, 16);
    var hp_lo = _i16(harm_packed);
    var hp_hi = sar(harm_packed, 16);
    var lam16 = _i16(lambda_Q10);
    var rdo = lambda_Q10 / 2 - 512;
    var sidx = load64(nsq + _SKN_SHP_IDX);
    var lidx = load64(nsq + _SKN_SLTP_IDX);
    var shpbuf = nsq + _SKN_SLTP_SHP;
    var shp = shpbuf + (sidx - lag + 1) * 8;                                    # HARM_SHAPE_FIR_TAPS / 2
    var pred = sLTP_Q15 + (lidx - lag + 2) * 8;                                 # LTP_ORDER / 2
    var gain_Q10 = sar(gain_Q16, 6);
    var lpc = nsq + _SKN_SLPC + 15 * 8;                                         # NSQ_LPC_BUF_LENGTH - 1
    var ar2 = nsq + _SKN_SAR2;
    var seedv = load64(nsq + _SKN_SEED);
    var sdiff = load64(nsq + _SKN_SDIFF);
    var slf = load64(nsq + _SKN_SLF_AR);
    var v = 0;
    var i = 0;
    while (i < length) {
        v = 907633515 + seedv * 196314165;
        var seed = ((v + H31) & W32) - H31;
        # the short-term prediction
        var lp = lpc;
        var cp = a16;
        var ce = a16 + po * 8;
        var lpc_pred = po >> 1;
        while (cp < ce) {
            lpc_pred = lpc_pred + ((load64(lp) * load64(cp) + B62) >> 16) - B46;
            lp = lp - 8;
            cp = cp + 8;
        }
        lpc_pred = ((lpc_pred + H31) & W32) - H31;
        var ltp_pred = 0;
        if (sig == 2) {
            ltp_pred = 2;
            var pp = pred;
            var bp = b16;
            var be = b16 + 40;
            while (bp < be) {
                ltp_pred = ltp_pred + ((load64(pp) * load64(bp) + B62) >> 16) - B46;
                pp = pp - 8;
                bp = bp + 8;
            }
            ltp_pred = ((ltp_pred + H31) & W32) - H31;
            pred = pred + 8;
        }
        # silk_NSQ_noise_shape_feedback_loop over sDiff and sAR2, x2, plus the tilt
        var tmp2 = sdiff;
        var tmp1 = load64(ar2);
        store64(ar2, tmp2);
        var nar = (so >> 1) + ((tmp2 * load64(ar16) + B62) >> 16) - B46;
        var pa = ar2 + 8;
        var pc = ar16 + 8;
        var pend = ar2 + (so - 1) * 8;
        while (pa < pend) {
            tmp2 = load64(pa);
            store64(pa, tmp1);
            nar = nar + ((tmp1 * load64(pc) + B62) >> 16) - B46;
            tmp1 = load64(pa + 8);
            store64(pa + 8, tmp2);
            nar = nar + ((tmp2 * load64(pc + 8) + B62) >> 16) - B46;
            pa = pa + 16;
            pc = pc + 16;
        }
        store64(ar2 + (so - 1) * 8, tmp1);
        nar = nar + ((tmp1 * load64(ar16 + (so - 1) * 8) + B62) >> 16) - B46;
        v = (nar << 1) + ((slf * tilt16 + B62) >> 16) - B46;
        var n_ar = ((v + H31) & W32) - H31;
        v = ((load64(shpbuf + (sidx - 1) * 8) * lf_lo + B62) >> 16) - B46 + ((slf * lf_hi + B62) >> 16) - B46;
        var n_lf = ((v + H31) & W32) - H31;
        var c1 = (lpc_pred << 2) - n_ar - n_lf;
        if (lag > 0) {
            var sh = load64(shp) + load64(shp - 16);
            if (sh > S31) { sh = S31; }
            if (sh < 0 - H31) { sh = 0 - H31; }
            var nl = ((sh * hp_lo + B62) >> 16) - B46 + ((load64(shp - 8) * hp_hi + B62) >> 16) - B46;
            shp = shp + 8;
            v = ltp_pred - (nl << 1) + (c1 << 1);
            v = ((v + H31) & W32) - H31;
            c1 = ((v + 4 + B62) >> 3) - B59;
        } else {
            v = ((c1 + H31) & W32) - H31;
            c1 = ((v + 2 + B62) >> 2) - B60;
        }
        v = load64(x_sc + i * 8) - c1;
        var r = ((v + H31) & W32) - H31;
        if (seed < 0) { r = 0 - r; }
        if (r < 0 - 31744) { r = 0 - 31744; }                                      # -(31 << 10)
        if (r > 30720) { r = 30720; }                                              # 30 << 10
        # two candidate levels and their rate-distortion cost
        var q1 = r - offset_Q10;
        var q1_0 = ((q1 + B62) >> 10) - B52;
        if (lambda_Q10 > 2048) {
            # aggressive rate/distortion: a bias of more than one pulse
            if (q1 > rdo) { q1_0 = ((q1 - rdo + B62) >> 10) - B52; }
            else {
                if (q1 < 0 - rdo) { q1_0 = ((q1 + rdo + B62) >> 10) - B52; }
                else {
                    if (q1 < 0) { q1_0 = 0 - 1; } else { q1_0 = 0; }
                }
            }
        }
        var q2 = 0;
        var rd1 = 0;
        var rd2 = 0;
        if (q1_0 > 0) {
            q1 = (q1_0 << 10) - 80 + offset_Q10;                                   # QUANT_LEVEL_ADJUST_Q10
            q2 = q1 + 1024;
            rd1 = q1;
            rd2 = q2;
        } else {
            if (q1_0 == 0) {
                q1 = offset_Q10;
                q2 = q1 + 1024 - 80;
                rd1 = q1;
                rd2 = q2;
            } else {
                if (q1_0 == 0 - 1) {
                    q2 = offset_Q10;
                    q1 = q2 - (1024 - 80);
                    rd1 = 0 - q1;
                    rd2 = q2;
                } else {
                    q1 = (q1_0 << 10) + 80 + offset_Q10;
                    q2 = q1 + 1024;
                    rd1 = 0 - q1;
                    rd2 = 0 - q2;
                }
            }
        }
        v = rd1 * lam16;
        rd1 = ((v + H31) & W32) - H31;
        v = rd2 * lam16;
        rd2 = ((v + H31) & W32) - H31;
        var rr = (((r - q1) & 0xFFFF) ^ 0x8000) - 0x8000;
        v = rd1 + rr * rr;
        rd1 = ((v + H31) & W32) - H31;
        rr = (((r - q2) & 0xFFFF) ^ 0x8000) - 0x8000;
        v = rd2 + rr * rr;
        rd2 = ((v + H31) & W32) - H31;
        if (rd2 < rd1) { q1 = q2; }
        var pulse = ((q1 + 512 + B62) >> 10) - B52;
        store64(pulses + i * 8, pulse);
        # the excitation, the decoder's reconstruction, and the states
        var exc = q1 << 4;                                                         # |q1| < 2^16: no wrap
        if (seed < 0) { exc = 0 - exc; }
        v = exc + (ltp_pred << 1);
        var lpc_exc = ((v + H31) & W32) - H31;
        v = lpc_exc + (lpc_pred << 4);
        var xq14 = ((v + H31) & W32) - H31;
        v = ((xq14 * gain_Q10 + B62) >> 16) - B46;
        v = ((((v + H31) & W32) - H31 + 128 + B62) >> 8) - B54;
        if (v > 32767) { v = 32767; }
        if (v < 0 - 32768) { v = 0 - 32768; }
        store64(xq + i * 8, v);
        lpc = lpc + 8;
        store64(lpc, xq14);
        v = xq14 - (load64(x_sc + i * 8) << 4);
        sdiff = ((v + H31) & W32) - H31;
        v = sdiff - (n_ar << 2);
        slf = ((v + H31) & W32) - H31;
        v = slf - (n_lf << 2);
        store64(shpbuf + sidx * 8, ((v + H31) & W32) - H31);
        v = lpc_exc << 1;
        store64(sLTP_Q15 + lidx * 8, ((v + H31) & W32) - H31);
        sidx = sidx + 1;
        lidx = lidx + 1;
        v = seed + pulse;
        seedv = ((v + H31) & W32) - H31;
        i = i + 1;
    }
    store64(nsq + _SKN_SEED, seedv);
    store64(nsq + _SKN_SDIFF, sdiff);
    store64(nsq + _SKN_SLF_AR, slf);
    store64(nsq + _SKN_SHP_IDX, sidx);
    store64(nsq + _SKN_SLTP_IDX, lidx);
    # keep the last 16 samples of the synthesis state
    _sk_copy_words8(nsq + _SKN_SLPC, nsq + _SKN_SLPC + length * 8, 16);
    return 0;
}

# silk_NSQ_c: the frame's pulses from its int16 input x16, the fixed-point
# coefficients (Q12 prediction filters for each half, Q14 LTP taps, Q13 shaping
# filters at 24 a subframe, Q14 harmonic shaping and tilt, packed Q14 low
# frequency shaping, Q16 gains), the pitch lags, Lambda_Q10 and the LTP scale.
fn silk_nsq(st, nsq, x16, pulses, pred_Q12, ltp_Q14, ar_Q13, harm_Q14, tilt_Q14, lf_Q14, gains_Q16,
  pitchL, lambda_Q10, LTP_scale_Q14) {
    var lm = load64(st + _SKE_LTP_MEM);
    var fl = load64(st + _SKE_FRAME_LEN);
    var sl = load64(st + _SKE_SUBFR_LEN);
    var nb = load64(st + _SKE_NB_SUBFR);
    var so = load64(st + _SKE_SHAPE_ORDER);
    var po = load64(st + _SKE_ORDER);
    var sig = _ske_idx(st, _SKI_SIGNAL_TYPE);
    store64(nsq + _SKN_SEED, _ske_idx(st, _SKI_SEED));
    var lag = load64(nsq + _SKN_LAG_PREV);
    var offset = silk_quant_offset(sig, _ske_idx(st, _SKI_QUANT_OFFSET));
    var interp = 1;
    if (_ske_idx(st, _SKI_NLSF_INTERP) == 4) { interp = 0; }
    var sLTP_Q15 = _opus_tmp((lm + fl) * 8);
    var sLTP = _opus_tmp((lm + fl) * 8);
    var x_sc = _opus_tmp(sl * 8);
    store64(nsq + _SKN_SHP_IDX, lm);
    store64(nsq + _SKN_SLTP_IDX, lm);
    var pxq = nsq + _SKN_XQ + lm * 8;
    var k = 0;
    while (k < nb) {
        var A = pred_Q12 + (((k >> 1) | (1 - interp)) * 16) * 8;
        var B = ltp_Q14 + k * 5 * 8;
        var AR = ar_Q13 + k * 24 * 8;
        var hg = load64(harm_Q14 + k * 8);
        var harm_packed = sar(hg, 2) | silk_sx32(sar(hg, 1) << 16);
        store64(nsq + _SKN_REWHITE, 0);
        if (sig == 2) {
            lag = load64(pitchL + k * 8);
            if ((k & (3 - (interp << 1))) == 0) {
                # re-whiten the history with the new filter
                var start = lm - lag - po - 2;
                silk_lpc_analysis_filter(sLTP + start * 8, nsq + _SKN_XQ + (start + k * sl) * 8, A, lm - start, po);
                store64(nsq + _SKN_REWHITE, 1);
                store64(nsq + _SKN_SLTP_IDX, lm);
            }
        }
        _sk_nsq_scale_states(st, nsq, x16, x_sc, sLTP, sLTP_Q15, k, LTP_scale_Q14, gains_Q16, pitchL, sig);
        _sk_nsq_quantizer(nsq, sig, x_sc, pulses, pxq, sLTP_Q15, A, B, AR, lag, harm_packed,
          load64(tilt_Q14 + k * 8), load64(lf_Q14 + k * 8), load64(gains_Q16 + k * 8), lambda_Q10, offset, sl, so, po);
        x16 = x16 + sl * 8;
        pulses = pulses + sl * 8;
        pxq = pxq + sl * 8;
        k = k + 1;
    }
    store64(nsq + _SKN_LAG_PREV, load64(pitchL + (nb - 1) * 8));
    # keep ltp_mem of history (memmove: forward, the regions may overlap)
    var i = 0;
    while (i < lm) {
        store64(nsq + _SKN_XQ + i * 8, load64(nsq + _SKN_XQ + (i + fl) * 8));
        store64(nsq + _SKN_SLTP_SHP + i * 8, load64(nsq + _SKN_SLTP_SHP + (i + fl) * 8));
        i = i + 1;
    }
    return 0;
}

# ---------------------------------------------------------------- the delayed-decision quantiser (2.12.3)
#
# silk_NSQ_del_dec (NSQ_del_dec.c), which libopus runs from complexity 2 (two
# to four states, a decision 40 samples back) and wherever the shaping is
# warped. Fixed point, exact. A state (libopus NSQ_del_dec_struct, field for
# field, so that the replacement of a state can copy it from word i on, as
# libopus's memcpy does):
var _SKDD_LPC = 0;            # [96] sLPC_Q14
var _SKDD_RAND = 96;          # [40] RandState
var _SKDD_Q = 136;            # [40] Q_Q10
var _SKDD_XQ = 176;           # [40] Xq_Q14
var _SKDD_PRED = 216;         # [40] Pred_Q15
var _SKDD_SHAPE = 256;        # [40] Shape_Q14
var _SKDD_AR2 = 296;          # [24] sAR2_Q14
var _SKDD_LF_AR = 320;
var _SKDD_DIFF = 321;
var _SKDD_SEED = 322;
var _SKDD_SEED_INIT = 323;
var _SKDD_RD = 324;
var _SKDD_WORDS = 325;
# A sample's candidate (NSQ_sample_struct), two a state:
var _SKSS_Q = 0;
var _SKSS_RD = 1;
var _SKSS_XQ = 2;
var _SKSS_LF_AR = 3;
var _SKSS_DIFF = 4;
var _SKSS_SHP = 5;
var _SKSS_LPC_EXC = 6;
var _SKSS_WORDS = 7;

fn _skdd(dd, k, f) { return dd + (k * _SKDD_WORDS + f) * 8; }
fn _skss(ss, k, j, f) { return ss + ((k * 2 + j) * _SKSS_WORDS + f) * 8; }

# silk_nsq_del_dec_scale_states: as _sk_nsq_scale_states, with every state's
# filter memories and delayed values rescaled when the gain changes, and the
# LTP state only up to the decision delay. silk_SMULWW and silk_SMULWB are
# inline (2.12.3): the input by inv26 (under 2^26), the LTP state by inv31
# (int16 operand), and the states by the gain ratio adj (positive, under 2^31:
# every product under 2^62, shifted through the 2^62 bias); a ratio outside
# that range takes the helper.
fn _sk_nsq_dd_scale_states(st, nsq, dd, x16, x_sc, sLTP, sLTP_Q15, subfr, nstates, LTP_scale_Q14, gains, pitchL, sig, dD) {
    var B62 = 4611686018427387904;
    var B46 = 70368744177664;
    var W32 = 4294967295;
    var H31 = 2147483648;
    var sl = load64(st + _SKE_SUBFR_LEN);
    var lm = load64(st + _SKE_LTP_MEM);
    var lag = load64(pitchL + subfr * 8);
    var g = load64(gains + subfr * 8);
    var gm = g;
    if (gm < 1) { gm = 1; }
    var inv31 = silk_inverse32_varq(gm, 47);
    var inv26 = silk_rshift_round(inv31, 5);
    var v = 0;
    var i = 0;
    while (i < sl) {
        v = ((load64(x16 + i * 8) * inv26 + B62) >> 16) - B46;
        store64(x_sc + i * 8, ((v + H31) & W32) - H31);
        i = i + 1;
    }
    var lidx = load64(nsq + _SKN_SLTP_IDX);
    if (load64(nsq + _SKN_REWHITE) == 1) {
        if (subfr == 0) { inv31 = silk_sx32(silk_smulwb(inv31, LTP_scale_Q14) << 2); }
        i = lidx - lag - 2;
        while (i < lidx) {
            store64(sLTP_Q15 + i * 8, ((inv31 * (((load64(sLTP + i * 8) & 0xFFFF) ^ 0x8000) - 0x8000) + B62) >> 16) - B46);
            i = i + 1;
        }
    }
    if (g != load64(nsq + _SKN_PREV_GAIN)) {
        var adj = silk_div32_varq(load64(nsq + _SKN_PREV_GAIN), g, 16);
        var sidx = load64(nsq + _SKN_SHP_IDX);
        if (adj >= 0 && adj < H31) {
            var a = nsq + _SKN_SLTP_SHP + (sidx - lm) * 8;
            var ae = nsq + _SKN_SLTP_SHP + sidx * 8;
            while (a < ae) {
                v = ((adj * load64(a) + B62) >> 16) - B46;
                store64(a, ((v + H31) & W32) - H31);
                a = a + 8;
            }
            if (sig == 2 && load64(nsq + _SKN_REWHITE) == 0) {
                a = sLTP_Q15 + (lidx - lag - 2) * 8;
                ae = sLTP_Q15 + (lidx - dD) * 8;
                while (a < ae) {
                    v = ((adj * load64(a) + B62) >> 16) - B46;
                    store64(a, ((v + H31) & W32) - H31);
                    a = a + 8;
                }
            }
            var k = 0;
            while (k < nstates) {
                var p = _skdd(dd, k, 0);
                # LF_AR and DIFF (words 320, 321), sLPC_Q14's 16 newest, sAR2,
                # and the delayed Pred and Shape
                v = ((adj * load64(p + _SKDD_LF_AR * 8) + B62) >> 16) - B46;
                store64(p + _SKDD_LF_AR * 8, ((v + H31) & W32) - H31);
                v = ((adj * load64(p + _SKDD_DIFF * 8) + B62) >> 16) - B46;
                store64(p + _SKDD_DIFF * 8, ((v + H31) & W32) - H31);
                a = p + _SKDD_LPC * 8;
                ae = a + 16 * 8;
                while (a < ae) {
                    v = ((adj * load64(a) + B62) >> 16) - B46;
                    store64(a, ((v + H31) & W32) - H31);
                    a = a + 8;
                }
                a = p + _SKDD_AR2 * 8;
                ae = a + 24 * 8;
                while (a < ae) {
                    v = ((adj * load64(a) + B62) >> 16) - B46;
                    store64(a, ((v + H31) & W32) - H31);
                    a = a + 8;
                }
                a = p + _SKDD_PRED * 8;
                ae = a + 40 * 8;
                var a2 = p + _SKDD_SHAPE * 8;
                while (a < ae) {
                    v = ((adj * load64(a) + B62) >> 16) - B46;
                    store64(a, ((v + H31) & W32) - H31);
                    v = ((adj * load64(a2) + B62) >> 16) - B46;
                    store64(a2, ((v + H31) & W32) - H31);
                    a = a + 8;
                    a2 = a2 + 8;
                }
                k = k + 1;
            }
        } else {
            i = sidx - lm;
            while (i < sidx) {
                store64(nsq + _SKN_SLTP_SHP + i * 8, _sk_smulww(adj, load64(nsq + _SKN_SLTP_SHP + i * 8)));
                i = i + 1;
            }
            if (sig == 2 && load64(nsq + _SKN_REWHITE) == 0) {
                i = lidx - lag - 2;
                while (i < lidx - dD) {
                    store64(sLTP_Q15 + i * 8, _sk_smulww(adj, load64(sLTP_Q15 + i * 8)));
                    i = i + 1;
                }
            }
            var k2 = 0;
            while (k2 < nstates) {
                var p2 = _skdd(dd, k2, 0);
                store64(p2 + _SKDD_LF_AR * 8, _sk_smulww(adj, load64(p2 + _SKDD_LF_AR * 8)));
                store64(p2 + _SKDD_DIFF * 8, _sk_smulww(adj, load64(p2 + _SKDD_DIFF * 8)));
                i = 0;
                while (i < 16) { store64(p2 + (_SKDD_LPC + i) * 8, _sk_smulww(adj, load64(p2 + (_SKDD_LPC + i) * 8))); i = i + 1; }
                i = 0;
                while (i < 24) { store64(p2 + (_SKDD_AR2 + i) * 8, _sk_smulww(adj, load64(p2 + (_SKDD_AR2 + i) * 8))); i = i + 1; }
                i = 0;
                while (i < 40) {
                    store64(p2 + (_SKDD_PRED + i) * 8, _sk_smulww(adj, load64(p2 + (_SKDD_PRED + i) * 8)));
                    store64(p2 + (_SKDD_SHAPE + i) * 8, _sk_smulww(adj, load64(p2 + (_SKDD_SHAPE + i) * 8)));
                    i = i + 1;
                }
                k2 = k2 + 1;
            }
        }
        store64(nsq + _SKN_PREV_GAIN, g);
    }
    return 0;
}

# silk_noise_shape_quantizer_del_dec: one subframe. For each sample every
# state proposes its two nearest quantisation levels with their running
# rate-distortion; the best state's decision from dD samples back is output,
# states whose dither seed has parted from the winner's at that point are
# penalised, and the worst first choice is replaced by the best second one.
# sbi: a one-word cell holding the index of the newest delayed sample.
#
# The arithmetic is inline (2.12.3): each sample of each state went through
# some 500 helper calls. silk_SMULWB(b, c) is floor(b * (int16)c / 2^16)
# exactly ((b >> 16) * c + ((b & 0xFFFF) * c) >> 16 is that floor), and an
# arithmetic shift of x by n is ((x + 2^62) >> n) - 2^(62 - n) for |x| under
# 2^62, which every product here is (int32 by int16 or int32 by a Q10 gain
# under 2^25). The int16 casts and int32 wraps of libopus's macros stay where
# they apply: the coefficients are cast once a subframe; each SMLAWB, SMLAWT,
# SMULBB and SMLABB wraps or casts as the helpers did (W32/H31: the wrap). The
# wrap is reduction mod 2^32, so a sum whose partial values feed only its next
# term (the LTP and LPC predictions, the shaping filter's output) is wrapped once
# at its end: wrap(wrap(a + x) + y) = wrap(a + x + y), and 24 terms under 2^31
# do not overflow 64 bits.
fn _sk_nsq_dd_quantizer(nsq, dd, ss, nstates, sig, x_Q10, pulses, xq, sLTP_Q15, dgain, a_Q12, b_Q14, ar_Q13, lag,
  harm_packed, tilt_Q14, lf_Q14, gain_Q16, lambda_Q10, offset_Q10, length, subfr, so, po, warp, sbi, dD) {
    var B62 = 4611686018427387904;           # 2^62
    var B46 = 70368744177664;                # 2^62 >> 16
    var B58 = 288230376151711744;            # 2^62 >> 4
    var B52 = 4503599627370496;              # 2^62 >> 10
    var B54 = 18014398509481984;             # 2^62 >> 8
    var W32 = 4294967295;
    var H31 = 2147483648;
    var S31 = 2147483647;
    var oLPC = _SKDD_LPC * 8;
    var oRAND = _SKDD_RAND * 8;
    var oQ = _SKDD_Q * 8;
    var oXQ = _SKDD_XQ * 8;
    var oPRED = _SKDD_PRED * 8;
    var oSHAPE = _SKDD_SHAPE * 8;
    var oAR2 = _SKDD_AR2 * 8;
    var oLF = _SKDD_LF_AR * 8;
    var oDIFF = _SKDD_DIFF * 8;
    var oSEED = _SKDD_SEED * 8;
    var oRD = _SKDD_RD * 8;
    var SDD = _SKDD_WORDS * 8;
    var SSS = _SKSS_WORDS * 8;
    # the coefficients as the int16 the macros cast them to
    var a16 = _opus_tmp(16 * 8);
    var ar16 = _opus_tmp(24 * 8);
    var b16 = _opus_tmp(5 * 8);
    var t = 0;
    while (t < po) { store64(a16 + t * 8, _i16(load64(a_Q12 + t * 8))); t = t + 1; }
    t = 0;
    while (t < so) { store64(ar16 + t * 8, _i16(load64(ar_Q13 + t * 8))); t = t + 1; }
    t = 0;
    while (t < 5) { store64(b16 + t * 8, _i16(load64(b_Q14 + t * 8))); t = t + 1; }
    var w16 = _i16(warp);
    var tilt16 = _i16(tilt_Q14);
    var lf_lo = _i16(lf_Q14);
    var lf_hi = sar(lf_Q14, 16);
    var hp_lo = _i16(harm_packed);
    var hp_hi = sar(harm_packed, 16);
    var lam16 = _i16(lambda_Q10);
    var rdo = lambda_Q10 / 2 - 512;
    var sidx = load64(nsq + _SKN_SHP_IDX);
    var lidx = load64(nsq + _SKN_SLTP_IDX);
    var shpbuf = nsq + _SKN_SLTP_SHP;
    var shp = shpbuf + (sidx - lag + 1) * 8;                                   # HARM_SHAPE_FIR_TAPS / 2
    var pred = sLTP_Q15 + (lidx - lag + 2) * 8;                                # LTP_ORDER / 2
    var gain_Q10 = sar(gain_Q16, 6);
    var bidx = load64(sbi);
    var k = 0;
    var i = 0;
    var v = 0;
    while (i < length) {
        var ltp_pred = 0;
        if (sig == 2) {
            ltp_pred = 2;
            var pp = pred;
            var bp = b16;
            var be = b16 + 40;
            while (bp < be) {
                ltp_pred = ltp_pred + ((load64(pp) * load64(bp) + B62) >> 16) - B46;
                pp = pp - 8;
                bp = bp + 8;
            }
            ltp_pred = (((ltp_pred << 1) + H31) & W32) - H31;
            pred = pred + 8;
        }
        var n_ltp = 0;
        if (lag > 0) {
            var sh = load64(shp) + load64(shp - 16);
            if (sh > S31) { sh = S31; }
            if (sh < 0 - H31) { sh = 0 - H31; }
            n_ltp = ((sh * hp_lo + B62) >> 16) - B46;
            v = n_ltp + ((load64(shp - 8) * hp_hi + B62) >> 16) - B46;
            n_ltp = ((v + H31) & W32) - H31;
            v = ltp_pred - ((((n_ltp << 2) + H31) & W32) - H31);
            n_ltp = ((v + H31) & W32) - H31;
            shp = shp + 8;
        }
        var xin = load64(x_Q10 + i * 8);
        var xin4 = (((xin << 4) + H31) & W32) - H31;
        k = 0;
        while (k < nstates) {
            var p = dd + k * SDD;
            v = 907633515 + load64(p + oSEED) * 196314165;
            var seed = ((v + H31) & W32) - H31;
            store64(p + oSEED, seed);
            # the short-term prediction (silk_noise_shape_quantizer_short_prediction)
            var lp = p + oLPC + (15 + i) * 8;
            var lpc_pred = po >> 1;
            var cp = a16;
            var ce = a16 + po * 8;
            while (cp < ce) {
                lpc_pred = lpc_pred + ((load64(lp) * load64(cp) + B62) >> 16) - B46;
                lp = lp - 8;
                cp = cp + 8;
            }
            lpc_pred = (((lpc_pred << 4) + H31) & W32) - H31;
            # the warped shaping filter, an allpass chain
            var ar2 = p + oAR2;
            var a0 = load64(ar2);
            v = load64(p + oDIFF) + ((a0 * w16 + B62) >> 16) - B46;
            var tmp2 = ((v + H31) & W32) - H31;
            v = load64(ar2 + 8) - tmp2;
            v = ((v + H31) & W32) - H31;
            v = a0 + ((v * w16 + B62) >> 16) - B46;
            var tmp1 = ((v + H31) & W32) - H31;
            store64(ar2, tmp2);
            var n_ar = (so >> 1) + ((tmp2 * load64(ar16) + B62) >> 16) - B46;
            # pa: sAR2[j - 1] for j = 2, 4, .. so - 2; pc: AR[j - 1]
            var pa = ar2 + 8;
            var pc = ar16 + 8;
            var pend = ar2 + (so - 1) * 8;
            while (pa < pend) {
                var aj1 = load64(pa);
                var aj = load64(pa + 8);
                v = aj - tmp1;
                v = ((v + H31) & W32) - H31;
                v = aj1 + ((v * w16 + B62) >> 16) - B46;
                tmp2 = ((v + H31) & W32) - H31;
                store64(pa, tmp1);
                n_ar = n_ar + ((tmp1 * load64(pc) + B62) >> 16) - B46;
                v = load64(pa + 16) - tmp2;
                v = ((v + H31) & W32) - H31;
                v = aj + ((v * w16 + B62) >> 16) - B46;
                tmp1 = ((v + H31) & W32) - H31;
                store64(pa + 8, tmp2);
                n_ar = n_ar + ((tmp2 * load64(pc + 8) + B62) >> 16) - B46;
                pa = pa + 16;
                pc = pc + 16;
            }
            store64(ar2 + (so - 1) * 8, tmp1);
            n_ar = n_ar + ((tmp1 * load64(ar16 + (so - 1) * 8) + B62) >> 16) - B46;
            var lf_ar = load64(p + oLF);
            v = (n_ar << 1) + ((lf_ar * tilt16 + B62) >> 16) - B46;
            n_ar = (((v << 2) + H31) & W32) - H31;
            v = ((load64(p + oSHAPE + bidx * 8) * lf_lo + B62) >> 16) - B46 + ((lf_ar * lf_hi + B62) >> 16) - B46;
            var n_lf = (((v << 2) + H31) & W32) - H31;
            var t1 = n_ar + n_lf;
            if (t1 > S31) { t1 = S31; }
            if (t1 < 0 - H31) { t1 = 0 - H31; }
            v = n_ltp + lpc_pred;
            var t2 = ((v + H31) & W32) - H31;
            t1 = t2 - t1;
            if (t1 > S31) { t1 = S31; }
            if (t1 < 0 - H31) { t1 = 0 - H31; }
            t1 = ((t1 + 8 + B62) >> 4) - B58;
            v = xin - t1;
            var r = ((v + H31) & W32) - H31;
            if (seed < 0) { r = 0 - r; }
            if (r < 0 - 31744) { r = 0 - 31744; }                                  # -(31 << 10)
            if (r > 30720) { r = 30720; }                                          # 30 << 10
            var q1 = r - offset_Q10;
            var q1_0 = ((q1 + B62) >> 10) - B52;
            if (lambda_Q10 > 2048) {
                if (q1 > rdo) { q1_0 = ((q1 - rdo + B62) >> 10) - B52; }
                else {
                    if (q1 < 0 - rdo) { q1_0 = ((q1 + rdo + B62) >> 10) - B52; }
                    else {
                        if (q1 < 0) { q1_0 = 0 - 1; } else { q1_0 = 0; }
                    }
                }
            }
            var q2 = 0;
            var rd1 = 0;
            var rd2 = 0;
            if (q1_0 > 0) {
                q1 = (q1_0 << 10) - 80 + offset_Q10;                               # QUANT_LEVEL_ADJUST_Q10
                q2 = q1 + 1024;
                rd1 = q1;
                rd2 = q2;
            } else {
                if (q1_0 == 0) {
                    q1 = offset_Q10;
                    q2 = q1 + 1024 - 80;
                    rd1 = q1;
                    rd2 = q2;
                } else {
                    if (q1_0 == 0 - 1) {
                        q2 = offset_Q10;
                        q1 = q2 - (1024 - 80);
                        rd1 = 0 - q1;
                        rd2 = q2;
                    } else {
                        q1 = (q1_0 << 10) + 80 + offset_Q10;
                        q2 = q1 + 1024;
                        rd1 = 0 - q1;
                        rd2 = 0 - q2;
                    }
                }
            }
            # silk_SMULBB(rd, Lambda) then silk_SMLABB(., rr, rr): int16 operands.
            # The levels are within +-32,656 (q1_0 runs -32 to 29 with r limited
            # to -31,744..30,720, RDO or not; -32 x 1024 + 80 + 32 at the least),
            # so their cast is a no-op here.
            v = rd1 * lam16;
            rd1 = ((v + H31) & W32) - H31;
            v = rd2 * lam16;
            rd2 = ((v + H31) & W32) - H31;
            var rr = (((r - q1) & 0xFFFF) ^ 0x8000) - 0x8000;
            v = rd1 + rr * rr;
            rd1 = ((((v + H31) & W32) - H31 + B62) >> 10) - B52;
            rr = (((r - q2) & 0xFFFF) ^ 0x8000) - 0x8000;
            v = rd2 + rr * rr;
            rd2 = ((((v + H31) & W32) - H31 + B62) >> 10) - B52;
            var rdp = load64(p + oRD);
            var s0 = ss + (k * 2) * SSS;
            var s1 = s0 + SSS;
            if (rd1 < rd2) {
                v = rdp + rd1;
                store64(s0 + 8, ((v + H31) & W32) - H31);
                v = rdp + rd2;
                store64(s1 + 8, ((v + H31) & W32) - H31);
                store64(s0, q1);
                store64(s1, q2);
            } else {
                v = rdp + rd2;
                store64(s0 + 8, ((v + H31) & W32) - H31);
                v = rdp + rd1;
                store64(s1 + 8, ((v + H31) & W32) - H31);
                store64(s0, q2);
                store64(s1, q1);
            }
            # both candidates' reconstructions and states (Q, RD, XQ, LF_AR,
            # DIFF, SHP, LPC_EXC at words 0 to 6)
            var c = 0;
            var sc = s0;
            while (c < 2) {
                var exc = load64(sc) << 4;                                         # |q| < 2^16: no wrap
                if (seed < 0) { exc = 0 - exc; }
                v = exc + ltp_pred;
                var lpc_exc = ((v + H31) & W32) - H31;
                v = lpc_exc + lpc_pred;
                var xq14 = ((v + H31) & W32) - H31;
                v = xq14 - xin4;
                var dif = ((v + H31) & W32) - H31;
                store64(sc + 32, dif);
                v = dif - n_ar;
                var slf = ((v + H31) & W32) - H31;
                var shv = slf - n_lf;
                if (shv > S31) { shv = S31; }
                if (shv < 0 - H31) { shv = 0 - H31; }
                store64(sc + 40, shv);
                store64(sc + 24, slf);
                store64(sc + 48, lpc_exc);
                store64(sc + 16, xq14);
                sc = sc + SSS;
                c = c + 1;
            }
            k = k + 1;
        }
        var b = (bidx - 1) % 40;
        if (b < 0) { b = b + 40; }
        bidx = b;
        var last = (b + dD) % 40;
        # the winner, the expired states, the replacement
        var rdmin = load64(ss + 8);
        var win = 0;
        k = 1;
        while (k < nstates) {
            var rk = load64(ss + (k * 2) * SSS + 8);
            if (rk < rdmin) { rdmin = rk; win = k; }
            k = k + 1;
        }
        var wrand = load64(dd + win * SDD + oRAND + last * 8);
        k = 0;
        while (k < nstates) {
            if (load64(dd + k * SDD + oRAND + last * 8) != wrand) {
                var sk0 = ss + (k * 2) * SSS;
                v = load64(sk0 + 8) + 134217727;                                    # silk_int32_MAX >> 4
                store64(sk0 + 8, ((v + H31) & W32) - H31);
                v = load64(sk0 + SSS + 8) + 134217727;
                store64(sk0 + SSS + 8, ((v + H31) & W32) - H31);
            }
            k = k + 1;
        }
        var rdmax = load64(ss + 8);
        rdmin = load64(ss + SSS + 8);
        var imax = 0;
        var imin = 0;
        k = 1;
        while (k < nstates) {
            var sk1 = ss + (k * 2) * SSS;
            if (load64(sk1 + 8) > rdmax) { rdmax = load64(sk1 + 8); imax = k; }
            if (load64(sk1 + SSS + 8) < rdmin) { rdmin = load64(sk1 + SSS + 8); imin = k; }
            k = k + 1;
        }
        if (rdmin < rdmax) {
            # libopus copies the state from word i on. Of sLPC_Q14 only the 16
            # words from i are read again before they are written (the first
            # choice writes word 16 + i at this sample and each later one at its
            # own); RD, LF_AR and DIFF are rewritten from the candidate below.
            var pd = dd + imax * SDD;
            var ps = dd + imin * SDD;
            _sk_copy_words8(pd + oLPC + i * 8, ps + oLPC + i * 8, 16);
            _sk_copy_words8(pd + oRAND, ps + oRAND, _SKDD_SEED_INIT - _SKDD_RAND + 1);
            var sd2 = ss + (imax * 2) * SSS;
            var ss2 = ss + (imin * 2 + 1) * SSS;
            store64(sd2, load64(ss2));
            store64(sd2 + 8, load64(ss2 + 8));
            store64(sd2 + 16, load64(ss2 + 16));
            store64(sd2 + 24, load64(ss2 + 24));
            store64(sd2 + 32, load64(ss2 + 32));
            store64(sd2 + 40, load64(ss2 + 40));
            store64(sd2 + 48, load64(ss2 + 48));
        }
        # the winner's decision from dD samples back
        var pw = dd + win * SDD;
        if (subfr > 0 || i >= dD) {
            store64(pulses + (i - dD) * 8, ((load64(pw + oQ + last * 8) + 512 + B62) >> 10) - B52);
            v = ((load64(pw + oXQ + last * 8) * load64(dgain + last * 8) + B62) >> 16) - B46;
            v = ((((v + H31) & W32) - H31 + 128 + B62) >> 8) - B54;
            if (v > 32767) { v = 32767; }
            if (v < 0 - 32768) { v = 0 - 32768; }
            store64(xq + (i - dD) * 8, v);
            store64(shpbuf + (sidx - dD) * 8, load64(pw + oSHAPE + last * 8));
            store64(sLTP_Q15 + (lidx - dD) * 8, load64(pw + oPRED + last * 8));
        }
        sidx = sidx + 1;
        lidx = lidx + 1;
        # every state takes its first choice
        k = 0;
        while (k < nstates) {
            var q = dd + k * SDD;
            var s = ss + (k * 2) * SSS;
            store64(q + oLF, load64(s + 24));
            store64(q + oDIFF, load64(s + 32));
            store64(q + oLPC + (16 + i) * 8, load64(s + 16));
            store64(q + oXQ + b * 8, load64(s + 16));
            var qq = load64(s);
            store64(q + oQ + b * 8, qq);
            v = load64(s + 48) << 1;
            store64(q + oPRED + b * 8, ((v + H31) & W32) - H31);
            store64(q + oSHAPE + b * 8, load64(s + 40));
            v = load64(q + oSEED) + ((qq + 512 + B62) >> 10) - B52;
            var sd = ((v + H31) & W32) - H31;
            store64(q + oSEED, sd);
            store64(q + oRAND + b * 8, sd);
            store64(q + oRD, load64(s + 8));
            k = k + 1;
        }
        store64(dgain + b * 8, gain_Q10);
        i = i + 1;
    }
    store64(nsq + _SKN_SHP_IDX, sidx);
    store64(nsq + _SKN_SLTP_IDX, lidx);
    store64(sbi, bidx);
    k = 0;
    while (k < nstates) {
        var pl = dd + k * SDD + oLPC;
        _sk_copy_words(pl, pl + length * 8, 16);
        k = k + 1;
    }
    return 0;
}

# n words from src to dst (not overlapping), eight at a time.
fn _sk_copy_words8(dst, src, n) {
    var e = src + (n >> 3) * 64;
    while (src < e) {
        store64(dst, load64(src));
        store64(dst + 8, load64(src + 8));
        store64(dst + 16, load64(src + 16));
        store64(dst + 24, load64(src + 24));
        store64(dst + 32, load64(src + 32));
        store64(dst + 40, load64(src + 40));
        store64(dst + 48, load64(src + 48));
        store64(dst + 56, load64(src + 56));
        src = src + 64;
        dst = dst + 64;
    }
    e = src + (n & 7) * 8;
    while (src < e) {
        store64(dst, load64(src));
        src = src + 8;
        dst = dst + 8;
    }
    return 0;
}

# The winner by its running rate-distortion.
fn _sk_nsq_dd_winner(dd, nstates) {
    var rdmin = load64(_skdd(dd, 0, _SKDD_RD));
    var win = 0;
    var k = 1;
    while (k < nstates) {
        if (load64(_skdd(dd, k, _SKDD_RD)) < rdmin) { rdmin = load64(_skdd(dd, k, _SKDD_RD)); win = k; }
        k = k + 1;
    }
    return win;
}

# The winner's last dD decisions into pulses, xq (each scaled by gain_Q,
# shifted by sh) and the shaping state, ending at the current position.
fn _sk_nsq_dd_flush(nsq, dd, win, pulses, pxq, sbi, dD, gain, sh) {
    var last = sbi + dD;
    var i = 0;
    while (i < dD) {
        last = (last - 1) % 40;
        if (last < 0) { last = last + 40; }
        store64(pulses + (i - dD) * 8, silk_rshift_round(load64(_skdd(dd, win, _SKDD_Q + last)), 10));
        store64(pxq + (i - dD) * 8, silk_sat16(silk_rshift_round(_sk_smulww(load64(_skdd(dd, win, _SKDD_XQ + last)), gain), sh)));
        store64(nsq + _SKN_SLTP_SHP + (load64(nsq + _SKN_SHP_IDX) - dD + i) * 8, load64(_skdd(dd, win, _SKDD_SHAPE + last)));
        i = i + 1;
    }
    return 0;
}

# silk_NSQ_del_dec_c: as silk_nsq, with nStatesDelayedDecision states and
# the shaping filter warped by warping_Q16. idx: the indices whose seed the
# winning state's initial seed replaces (the frame's, or an LBRR copy's).
fn silk_nsq_del_dec(st, nsq, idx, x16, pulses, pred_Q12, ltp_Q14, ar_Q13, harm_Q14, tilt_Q14, lf_Q14, gains_Q16,
  pitchL, lambda_Q10, LTP_scale_Q14) {
    var lm = load64(st + _SKE_LTP_MEM);
    var fl = load64(st + _SKE_FRAME_LEN);
    var sl = load64(st + _SKE_SUBFR_LEN);
    var nb = load64(st + _SKE_NB_SUBFR);
    var so = load64(st + _SKE_SHAPE_ORDER);
    var po = load64(st + _SKE_ORDER);
    var nstates = load64(st + _SKE_NSTATES);
    var warp = load64(st + _SKE_WARPING_Q16);
    var sig = load64(idx + _SKI_SIGNAL_TYPE * 8);
    var lag = load64(nsq + _SKN_LAG_PREV);
    var dd = _opus_tmp(nstates * _SKDD_WORDS * 8);
    _sk_zero(dd, nstates * _SKDD_WORDS * 8);
    var ss = _opus_tmp(nstates * 2 * _SKSS_WORDS * 8);
    _sk_zero(ss, nstates * 2 * _SKSS_WORDS * 8);
    var k = 0;
    while (k < nstates) {
        var p = _skdd(dd, k, 0);
        var sd = (k + load64(idx + _SKI_SEED * 8)) & 3;
        store64(p + _SKDD_SEED * 8, sd);
        store64(p + _SKDD_SEED_INIT * 8, sd);
        store64(p + _SKDD_LF_AR * 8, load64(nsq + _SKN_SLF_AR));
        store64(p + _SKDD_DIFF * 8, load64(nsq + _SKN_SDIFF));
        store64(p + _SKDD_SHAPE * 8, load64(nsq + _SKN_SLTP_SHP + (lm - 1) * 8));
        _sk_copy_words(p + _SKDD_LPC * 8, nsq + _SKN_SLPC, 16);
        _sk_copy_words(p + _SKDD_AR2 * 8, nsq + _SKN_SAR2, 24);
        k = k + 1;
    }
    var offset = silk_quant_offset(sig, load64(idx + _SKI_QUANT_OFFSET * 8));
    var sbi = _opus_tmp(8);
    store64(sbi, 0);
    var dD = sl;
    if (dD > 40) { dD = 40; }
    if (sig == 2) {
        k = 0;
        while (k < nb) {
            var lim = load64(pitchL + k * 8) - 3;                                  # LTP_ORDER / 2 + 1
            if (lim < dD) { dD = lim; }
            k = k + 1;
        }
    } else {
        if (lag > 0) { if (lag - 3 < dD) { dD = lag - 3; } }
    }
    var interp = 1;
    if (load64(idx + _SKI_NLSF_INTERP * 8) == 4) { interp = 0; }
    var sLTP_Q15 = _opus_tmp((lm + fl) * 8);
    var sLTP = _opus_tmp((lm + fl) * 8);
    var x_sc = _opus_tmp(sl * 8);
    var dgain = _opus_tmp(40 * 8);
    _sk_zero(dgain, 40 * 8);
    var pxq = nsq + _SKN_XQ + lm * 8;
    store64(nsq + _SKN_SHP_IDX, lm);
    store64(nsq + _SKN_SLTP_IDX, lm);
    var subfr = 0;
    k = 0;
    while (k < nb) {
        var A = pred_Q12 + (((k >> 1) | (1 - interp)) * 16) * 8;
        var B = ltp_Q14 + k * 5 * 8;
        var AR = ar_Q13 + k * 24 * 8;
        var hg = load64(harm_Q14 + k * 8);
        var harm_packed = sar(hg, 2) | silk_sx32(sar(hg, 1) << 16);
        store64(nsq + _SKN_REWHITE, 0);
        if (sig == 2) {
            lag = load64(pitchL + k * 8);
            if ((k & (3 - (interp << 1))) == 0) {
                if (k == 2) {
                    # reset the delayed decisions: the winner's output so far
                    var w = _sk_nsq_dd_winner(dd, nstates);
                    var q = 0;
                    while (q < nstates) {
                        if (q != w) { store64(_skdd(dd, q, _SKDD_RD), silk_sx32(load64(_skdd(dd, q, _SKDD_RD)) + 134217727)); }
                        q = q + 1;
                    }
                    _sk_nsq_dd_flush(nsq, dd, w, pulses, pxq, load64(sbi), dD, load64(gains_Q16 + 8), 14);
                    subfr = 0;
                }
                var start = lm - lag - po - 2;
                silk_lpc_analysis_filter(sLTP + start * 8, nsq + _SKN_XQ + (start + k * sl) * 8, A, lm - start, po);
                store64(nsq + _SKN_SLTP_IDX, lm);
                store64(nsq + _SKN_REWHITE, 1);
            }
        }
        _sk_nsq_dd_scale_states(st, nsq, dd, x16, x_sc, sLTP, sLTP_Q15, k, nstates, LTP_scale_Q14, gains_Q16, pitchL, sig, dD);
        _sk_nsq_dd_quantizer(nsq, dd, ss, nstates, sig, x_sc, pulses, pxq, sLTP_Q15, dgain, A, B, AR, lag, harm_packed,
          load64(tilt_Q14 + k * 8), load64(lf_Q14 + k * 8), load64(gains_Q16 + k * 8), lambda_Q10, offset, sl, subfr,
          so, po, warp, sbi, dD);
        subfr = subfr + 1;
        x16 = x16 + sl * 8;
        pulses = pulses + sl * 8;
        pxq = pxq + sl * 8;
        k = k + 1;
    }
    var win = _sk_nsq_dd_winner(dd, nstates);
    store64(idx + _SKI_SEED * 8, load64(_skdd(dd, win, _SKDD_SEED_INIT)));
    _sk_nsq_dd_flush(nsq, dd, win, pulses, pxq, load64(sbi), dD, sar(load64(gains_Q16 + (nb - 1) * 8), 6), 8);
    _sk_copy_words(nsq + _SKN_SLPC, _skdd(dd, win, _SKDD_LPC + sl), 16);
    _sk_copy_words(nsq + _SKN_SAR2, _skdd(dd, win, _SKDD_AR2), 24);
    store64(nsq + _SKN_SLF_AR, load64(_skdd(dd, win, _SKDD_LF_AR)));
    store64(nsq + _SKN_SDIFF, load64(_skdd(dd, win, _SKDD_DIFF)));
    store64(nsq + _SKN_LAG_PREV, load64(pitchL + (nb - 1) * 8));
    var i = 0;
    while (i < lm) {
        store64(nsq + _SKN_XQ + i * 8, load64(nsq + _SKN_XQ + (i + fl) * 8));
        store64(nsq + _SKN_SLTP_SHP + i * 8, load64(nsq + _SKN_SLTP_SHP + (i + fl) * 8));
        i = i + 1;
    }
    return 0;
}

# The quantiser's fixed-point parameters, one block (_SKP_), filled from the
# frame's f64 control values by _sk_nsq_convert.
var _SKP_AR = 0;              # [96] Q13 shaping filters, 24 a subframe
var _SKP_LF = 768;            # [4] packed Q14 low-frequency shaping: AR << 16 | MA
var _SKP_TILT = 800;          # [4] Q14
var _SKP_HARM = 832;          # [4] Q14
var _SKP_LTP = 864;           # [20] Q14
var _SKP_PRED = 1024;         # [32] Q12, 16 a half
var _SKP_GAINS = 1280;        # [4] Q16
var _SKP_LAMBDA = 1312;       # Q10
var _SKP_LTP_SCALE = 1320;    # Q14
var _SKP_X16 = 1328;          # [320] int16 input
var _SKP_SIZE = 3888;

# silk_NSQ_wrapper_FLP's conversion: each value by lrintf (_sk_lrint), into prm.
# x: the frame's f64 input (int16 range).
fn _sk_nsq_convert(st, ctrl, x, prm) {
    var nb = load64(st + _SKE_NB_SUBFR);
    var so = load64(st + _SKE_SHAPE_ORDER);
    var po = load64(st + _SKE_ORDER);
    var fl = load64(st + _SKE_FRAME_LEN);
    memset(prm, 0, _SKP_SIZE);
    var i = 0;
    while (i < nb) {
        var j = 0;
        while (j < so) {
            store64(prm + _SKP_AR + (i * 24 + j) * 8, _i16(_sk_lrint(f64_mul(load64(ctrl + _SKC_AR + (i * 24 + j) * 8), f64_from(8192)))));
            j = j + 1;
        }
        var lar = _sk_lrint(f64_mul(load64(ctrl + _SKC_LF_AR + i * 8), f64_from(16384)));
        var lma = _sk_lrint(f64_mul(load64(ctrl + _SKC_LF_MA + i * 8), f64_from(16384)));
        store64(prm + _SKP_LF + i * 8, silk_sx32((lar << 16) | (lma & 0xFFFF)));
        store64(prm + _SKP_TILT + i * 8, _sk_lrint(f64_mul(load64(ctrl + _SKC_TILT + i * 8), f64_from(16384))));
        store64(prm + _SKP_HARM + i * 8, _sk_lrint(f64_mul(load64(ctrl + _SKC_HARM + i * 8), f64_from(16384))));
        store64(prm + _SKP_GAINS + i * 8, _sk_lrint(f64_mul(load64(ctrl + _SKC_GAINS + i * 8), f64_from(65536))));
        i = i + 1;
    }
    store64(prm + _SKP_LAMBDA, _sk_lrint(f64_mul(load64(ctrl + _SKC_LAMBDA), f64_from(1024))));
    i = 0;
    while (i < nb * 5) {
        store64(prm + _SKP_LTP + i * 8, _i16(_sk_lrint(f64_mul(load64(ctrl + _SKC_LTPCOEF + i * 8), f64_from(16384)))));
        i = i + 1;
    }
    i = 0;
    while (i < po) {
        store64(prm + _SKP_PRED + i * 8, _i16(_sk_lrint(f64_mul(load64(ctrl + _SKC_PRED0 + i * 8), f64_from(4096)))));
        store64(prm + _SKP_PRED + (16 + i) * 8, _i16(_sk_lrint(f64_mul(load64(ctrl + _SKC_PRED1 + i * 8), f64_from(4096)))));
        i = i + 1;
    }
    var ltp_scale = 0;
    if (_ske_idx(st, _SKI_SIGNAL_TYPE) == 2) {
        # silk_LTPScales_table_Q14
        var ls = _ske_idx(st, _SKI_LTP_SCALE);
        ltp_scale = 15565;
        if (ls == 1) { ltp_scale = 12288; }
        if (ls == 2) { ltp_scale = 8192; }
    }
    store64(prm + _SKP_LTP_SCALE, ltp_scale);
    i = 0;
    while (i < fl) {
        store64(prm + _SKP_X16 + i * 8, _i16(_sk_lrint(load64(x + i * 8))));
        i = i + 1;
    }
    return 0;
}

# silk_NSQ_wrapper_FLP: the conversion, then silk_nsq into the state's pulses.
fn silk_nsq_wrapper_flp(st, ctrl, x) {
    return _sk_nsq_wrapper(st, ctrl, x, load64(st + _SKE_NSQ), load64(st + _SKE_PULSES), st + _SKE_IDX);
}

# The same with the quantiser state and pulses given (the LBRR pass's).
fn _sk_nsq_wrapper(st, ctrl, x, nsq, pulses, idx) {
    var prm = _opus_tmp(_SKP_SIZE);
    _sk_nsq_convert(st, ctrl, x, prm);
    # as libopus: the delayed-decision quantiser for several states or warped
    # shaping (complexity 2 and up)
    if (load64(st + _SKE_NSTATES) > 1 || load64(st + _SKE_WARPING_Q16) > 0) {
        silk_nsq_del_dec(st, nsq, idx, prm + _SKP_X16, pulses, prm + _SKP_PRED, prm + _SKP_LTP,
          prm + _SKP_AR, prm + _SKP_HARM, prm + _SKP_TILT, prm + _SKP_LF, prm + _SKP_GAINS, ctrl + _SKC_PITCHL,
          load64(prm + _SKP_LAMBDA), load64(prm + _SKP_LTP_SCALE));
        return 0;
    }
    silk_nsq(st, nsq, prm + _SKP_X16, pulses, prm + _SKP_PRED, prm + _SKP_LTP,
      prm + _SKP_AR, prm + _SKP_HARM, prm + _SKP_TILT, prm + _SKP_LF, prm + _SKP_GAINS, ctrl + _SKC_PITCHL,
      load64(prm + _SKP_LAMBDA), load64(prm + _SKP_LTP_SCALE));
    return 0;
}

# FNV-1a over the quantiser's state, as scripts/silkref/patch.py's dump hashes
# it: xq, sLTP_shp, sLPC, sAR2, then the eight scalars, each as 32 bits.
fn _sk_nsq_hash(nsq) {
    var h = 1469598103934665603;
    var i = 0;
    while (i < 640) { h = (h ^ (load64(nsq + _SKN_XQ + i * 8) & 0xFFFFFFFF)) * 1099511628211; i = i + 1; }
    i = 0;
    while (i < 640) { h = (h ^ (load64(nsq + _SKN_SLTP_SHP + i * 8) & 0xFFFFFFFF)) * 1099511628211; i = i + 1; }
    i = 0;
    while (i < 96) { h = (h ^ (load64(nsq + _SKN_SLPC + i * 8) & 0xFFFFFFFF)) * 1099511628211; i = i + 1; }
    i = 0;
    while (i < 24) { h = (h ^ (load64(nsq + _SKN_SAR2 + i * 8) & 0xFFFFFFFF)) * 1099511628211; i = i + 1; }
    i = 0;
    while (i < 8) { h = (h ^ (load64(nsq + _SKN_SLF_AR + i * 8) & 0xFFFFFFFF)) * 1099511628211; i = i + 1; }
    return h;
}

# ---------------------------------------------------------------- the frame (2.11.3)

fn _sk_copy_words(dst, src, n) {
    var i = 0;
    while (i < n) { store64(dst + i * 8, load64(src + i * 8)); i = i + 1; }
    return 0;
}

# silk_gains_ID: the gain indices packed into one value, which the rate loop
# compares to spot a gain vector it has already coded.
fn silk_gains_id(ind, nb_subfr) {
    var id = 0;
    var k = 0;
    while (k < nb_subfr) { id = silk_sx32(load64(ind + k * 8) + (id << 8)); k = k + 1; }
    return id;
}

# The frame's indices, then its pulses.
fn _sk_encode_frame_bits(st, ec, cond) {
    silk_encode_indices_ec(ec, load64(st + _SKE_FS_KHZ), st + _SKE_IDX, load64(st + _SKE_NB_SUBFR), cond, st + _SKE_ECPREV);
    silk_encode_pulses(ec, _ske_idx(st, _SKI_SIGNAL_TYPE), _ske_idx(st, _SKI_QUANT_OFFSET), load64(st + _SKE_PULSES),
      load64(st + _SKE_FRAME_LEN));
    return ec_tell(ec);
}

# silk_LBRR_encode_FLP (encode_frame_FLP.c, 2.12.1): with in-band FEC on and
# over 30% speech activity, the frame quantised a second time into its LBRR
# slot, for the next packet to carry: the same indices, the first gain raised
# LBRR_GainIncreases steps when no LBRR frame precedes it in the packet, the
# gains dequantised from them as the decoder will (the regular coding's own
# stay in ctrl), and the quantiser started from the regular coding's state as
# it was before this frame. Before the rate loop, while the state's indices
# are the ones copied. cond: the frame's condCoding.
fn silk_lbrr_encode_flp(st, ctrl, x, cond) {
    if (load64(st + _SKE_LBRR_ENABLED) == 0 || load64(st + _SKE_SPEECH_Q8) <= 77) { return 0; }  # LBRR_SPEECH_ACTIVITY_THRES 0.3
    var nf = load64(st + _SKE_NFRAMES_ENC);
    var nb = load64(st + _SKE_NB_SUBFR);
    store64(st + _SKE_LBRR_FLAGS + nf * 8, 1);
    var nsq = load64(st + _SKE_LBRR_NSQ);
    _sk_copy_words(nsq, load64(st + _SKE_NSQ), _SKN_SIZE / 8);
    var idx = load64(st + _SKE_LBRR_IDX) + nf * 64 * 8;
    _sk_copy_words(idx, st + _SKE_IDX, 64);
    var saved = _opus_tmp(4 * 8);
    _sk_copy_words(saved, ctrl + _SKC_GAINS, 4);
    if (nf == 0 || load64(st + _SKE_LBRR_FLAGS + (nf - 1) * 8) == 0) {
        store64(st + _SKE_LBRR_PREV_GAIN, load64(st + _SKE_LAST_GAIN));
        var g0 = load64(idx + _SKI_GAINS * 8) + load64(st + _SKE_LBRR_GAIN_INC);
        if (g0 > 63) { g0 = 63; }
        store64(idx + _SKI_GAINS * 8, g0);
    }
    var gq = _opus_tmp(4 * 8);
    var cnd = 0;
    if (cond == 2) { cnd = 1; }
    _silk_gains_dequant_impl(idx + _SKI_GAINS * 8, gq, st + _SKE_LBRR_PREV_GAIN, cnd, nb);
    var k = 0;
    while (k < nb) { store64(ctrl + _SKC_GAINS + k * 8, _sk_gain_q16_flp(load64(gq + k * 8))); k = k + 1; }
    _sk_nsq_wrapper(st, ctrl, x, nsq, load64(st + _SKE_LBRR_PULSES) + nf * 320 * 8, idx);
    _sk_copy_words(ctrl + _SKC_GAINS, saved, 4);
    return 0;
}

# silk_encode_frame_FLP (encode_frame_FLP.c): one frame into the range coder.
# x16: the frame's input, frame_length int16 values (the packet layer's
# inputBuf + 1). The new samples go in 5 ms ahead of the frame being coded, so
# the encoder sees 5 ms of lookahead; then pitch analysis's LPC residual, noise
# shaping, the prediction filters and the gains, and the rate loop: quantise,
# code, and while the frame misses maxBits (or, under CBR, falls short of it by
# more than 5 bits) scale the gains, bracketing the target between a frame
# over and a frame under it and interpolating. After six tries the best frame
# under the budget is restored, or, if none was, the frame is coded with the
# last frame's gains and no pulses. cond: libopus's condCoding (0
# independently, 2 conditionally). Returns the packet's bytes so far. With
# in-band FEC on, the frame's LBRR copy is quantised first (silk_lbrr_encode_flp).
fn silk_encode_frame_flp(st, ctrl, ec, x16, cond, maxBits, useCBR) {
    var fs = load64(st + _SKE_FS_KHZ);
    var fl = load64(st + _SKE_FRAME_LEN);
    var lm = load64(st + _SKE_LTP_MEM);
    var nb = load64(st + _SKE_NB_SUBFR);
    var sl = load64(st + _SKE_SUBFR_LEN);
    var bits_margin = 5;
    if (useCBR == 0) { bits_margin = maxBits / 4; }
    var fc = load64(st + _SKE_FRAME_COUNTER);
    _ske_set_idx(st, _SKI_SEED, fc & 3);
    store64(st + _SKE_FRAME_COUNTER, fc + 1);
    var xbuf = load64(st + _SKE_XBUF);
    var xf = xbuf + lm * 8;
    var res_pitch = load64(st + _SKE_RES_PITCH);
    # smooth bandwidth transitions (silk_LP_variable_cutoff, on the int16 input)
    _sk_lp_variable_cutoff(st, x16, fl);
    var ins = xf + 5 * fs * 8;
    var i = 0;
    while (i < fl) { store64(ins + i * 8, f64_from(load64(x16 + i * 8))); i = i + 1; }
    # a tiny signal against denormals, added in single precision
    var tiny = _skf(1, 1000000);
    i = 0;
    while (i < 8) {
        var tp = ins + i * (fl >> 3) * 8;
        var t = tiny;
        if ((i & 2) != 0) { t = f64_neg(tiny); }
        store64(tp, _sk_f32(f64_add(load64(tp), t)));
        i = i + 1;
    }

    silk_find_pitch_lags_flp(st, ctrl, res_pitch, xf);
    silk_noise_shape_analysis_flp(st, ctrl, res_pitch + lm * 8, xf);
    silk_find_pred_coefs_flp(st, ctrl, res_pitch + lm * 8, xf, cond);
    silk_process_gains_flp(st, ctrl, cond);
    silk_lbrr_encode_flp(st, ctrl, xf, cond);

    var cnd = 0;
    if (cond == 2) { cnd = 1; }
    var gidx = st + _SKE_IDX + _SKI_GAINS * 8;
    var maxIter = 6;
    var gainMult = 256;
    var found_lower = 0;
    var found_upper = 0;
    var gainsID = silk_gains_id(gidx, nb);
    var gainsID_lower = 0 - 1;
    var gainsID_upper = 0 - 1;
    var nBits = 0;
    var nBits_lower = 0;
    var nBits_upper = 0;
    var gainMult_lower = 0;
    var gainMult_upper = 0;
    var lastGain_copy2 = 0;
    var ec_copy = load64(st + _SKE_EC_COPY);
    var ec_copy2 = load64(st + _SKE_EC_COPY + 8);
    var nsq = load64(st + _SKE_NSQ);
    var nsq_copy0 = load64(st + _SKE_NSQ_COPY);
    var nsq_copy1 = load64(st + _SKE_NSQ_COPY + 8);
    var ecbuf_copy = load64(st + _SKE_EC_BUF_COPY);
    var nw = _SKN_SIZE / 8;
    ec_enc_copy(ec_copy, ec);
    _sk_copy_words(nsq_copy0, nsq, nw);
    var seed_copy = _ske_idx(st, _SKI_SEED);
    var ecprev = st + _SKE_ECPREV;
    var sig_copy = load64(ecprev);
    var lag_copy = load64(ecprev + 8);
    var pulses = load64(st + _SKE_PULSES);
    var gain_lock = _opus_tmp(4 * 8);
    var best_gain_mult = _opus_tmp(4 * 8);
    var best_sum = _opus_tmp(4 * 8);
    var pGains = _opus_tmp(4 * 8);
    i = 0;
    while (i < 4) { store64(gain_lock + i * 8, 0); store64(best_gain_mult + i * 8, 0); store64(best_sum + i * 8, 0); i = i + 1; }
    var iter = 0;
    var done = 0;
    while (done == 0) {
        var coded = 0;
        if (gainsID == gainsID_lower) { nBits = nBits_lower; }
        else {
            if (gainsID == gainsID_upper) { nBits = nBits_upper; }
            else {
                coded = 1;
                if (iter > 0) {
                    ec_enc_copy(ec, ec_copy);
                    _sk_copy_words(nsq, nsq_copy0, nw);
                    _ske_set_idx(st, _SKI_SEED, seed_copy);
                    store64(ecprev, sig_copy);
                    store64(ecprev + 8, lag_copy);
                }
                silk_nsq_wrapper_flp(st, ctrl, xf);
                if (iter == maxIter && found_lower == 0) { ec_enc_copy(ec_copy2, ec); }
                nBits = _sk_encode_frame_bits(st, ec, cond);
                if (iter == maxIter && found_lower == 0 && nBits > maxBits) {
                    # damage control: the last frame's gains and no excitation
                    ec_enc_copy(ec, ec_copy2);
                    var lgp = load64(ctrl + _SKC_LAST_GAIN_PREV);
                    store64(st + _SKE_LAST_GAIN, lgp);
                    i = 0;
                    while (i < nb) { store64(gidx + i * 8, 4); i = i + 1; }
                    if (cond != 2) { store64(gidx, lgp); }
                    store64(ecprev, sig_copy);
                    store64(ecprev + 8, lag_copy);
                    i = 0;
                    while (i < fl) { store64(pulses + i * 8, 0); i = i + 1; }
                    nBits = _sk_encode_frame_bits(st, ec, cond);
                }
                if (useCBR == 0 && iter == 0 && nBits <= maxBits) { done = 1; }
            }
        }
        if (done == 0) {
            if (iter == maxIter) {
                if (found_lower == 1 && (gainsID == gainsID_lower || nBits > maxBits)) {
                    # back to the best frame that met the budget
                    ec_enc_copy(ec, ec_copy2);
                    var nby = load64(ec_copy2 + 48);
                    var eb = load64(ec + 0);
                    i = 0;
                    while (i < nby) { store8(eb + i, load8(ecbuf_copy + i)); i = i + 1; }
                    _sk_copy_words(nsq, nsq_copy1, nw);
                    store64(st + _SKE_LAST_GAIN, lastGain_copy2);
                }
                done = 1;
            }
        }
        if (done == 0) {
            if (nBits > maxBits) {
                if (found_lower == 0 && iter >= 2) {
                    # trade distortion for rate, drop the dither, forget the upper bound
                    var lam = _sk_f32(f64_mul(load64(ctrl + _SKC_LAMBDA), _skf(3, 2)));
                    if (f64_lt(lam, _skf(3, 2)) == 1) { lam = _skf(3, 2); }
                    store64(ctrl + _SKC_LAMBDA, lam);
                    _ske_set_idx(st, _SKI_QUANT_OFFSET, 0);
                    found_upper = 0;
                    gainsID_upper = 0 - 1;
                } else {
                    found_upper = 1;
                    nBits_upper = nBits;
                    gainMult_upper = gainMult;
                    gainsID_upper = gainsID;
                }
            } else {
                if (nBits < maxBits - bits_margin) {
                    found_lower = 1;
                    nBits_lower = nBits;
                    gainMult_lower = gainMult;
                    if (gainsID != gainsID_lower) {
                        gainsID_lower = gainsID;
                        ec_enc_copy(ec_copy2, ec);
                        var nb2 = load64(ec + 48);
                        var eb2 = load64(ec + 0);
                        i = 0;
                        while (i < nb2) { store8(ecbuf_copy + i, load8(eb2 + i)); i = i + 1; }
                        _sk_copy_words(nsq_copy1, nsq, nw);
                        lastGain_copy2 = load64(st + _SKE_LAST_GAIN);
                    }
                } else {
                    done = 1;                       # close enough
                }
            }
        }
        if (done == 0) {
            if (found_lower == 0 && nBits > maxBits) {
                # per subframe, the multiplier that gave the fewest pulses; a
                # subframe locks once more gain stops reducing them
                var k = 0;
                while (k < nb) {
                    var sum = 0;
                    var j = k * sl;
                    while (j < (k + 1) * sl) {
                        var pv = load64(pulses + j * 8);
                        if (pv < 0) { pv = 0 - pv; }
                        sum = sum + pv;
                        j = j + 1;
                    }
                    if (iter == 0 || (sum < load64(best_sum + k * 8) && load64(gain_lock + k * 8) == 0)) {
                        store64(best_sum + k * 8, sum);
                        store64(best_gain_mult + k * 8, gainMult);
                    } else {
                        store64(gain_lock + k * 8, 1);
                    }
                    k = k + 1;
                }
            }
            if ((found_lower & found_upper) == 0) {
                # the high-rate rate/distortion curve
                if (nBits > maxBits) {
                    gainMult = gainMult * 3 / 2;
                    if (gainMult > 1024) { gainMult = 1024; }
                } else {
                    gainMult = gainMult * 4 / 5;
                    if (gainMult < 64) { gainMult = 64; }
                }
            } else {
                # interpolate, held to the middle half of the bracket
                gainMult = gainMult_lower + silk_div_trunc((gainMult_upper - gainMult_lower) * (maxBits - nBits_lower),
                  nBits_upper - nBits_lower);
                var hi = gainMult_lower + sar(gainMult_upper - gainMult_lower, 2);
                var lo = gainMult_upper - sar(gainMult_upper - gainMult_lower, 2);
                if (gainMult > hi) { gainMult = hi; }
                else { if (gainMult < lo) { gainMult = lo; } }
            }
            i = 0;
            while (i < nb) {
                var gm = gainMult;
                if (load64(gain_lock + i * 8) == 1) { gm = load64(best_gain_mult + i * 8); }
                store64(pGains + i * 8, silk_lshift_sat32(silk_smulwb(load64(ctrl + _SKC_GAINS_UNQ + i * 8), gm), 8));
                i = i + 1;
            }
            store64(st + _SKE_LAST_GAIN, load64(ctrl + _SKC_LAST_GAIN_PREV));
            silk_gains_quant(gidx, pGains, st + _SKE_LAST_GAIN, cnd, nb);
            gainsID = silk_gains_id(gidx, nb);
            i = 0;
            while (i < nb) {
                store64(ctrl + _SKC_GAINS + i * 8, _sk_gain_q16_flp(load64(pGains + i * 8)));
                i = i + 1;
            }
            iter = iter + 1;
        }
    }

    # keep ltp_mem + 5 ms of the buffer for the next frame
    var keep = lm + 5 * fs;
    i = 0;
    while (i < keep) { store64(xbuf + i * 8, load64(xbuf + (i + fl) * 8)); i = i + 1; }
    store64(st + _SKE_PREV_LAG, load64(ctrl + _SKC_PITCHL + (nb - 1) * 8));
    store64(st + _SKE_PREV_SIGNAL, _ske_idx(st, _SKI_SIGNAL_TYPE));
    store64(st + _SKE_FIRST, 0);
    return (ec_tell(ec) + 7) >> 3;
}

# ---------------------------------------------------------------- input resampling (2.12.1)
#
# libopus's encoder-side silk_resampler (resampler.c, forEnc): from the API
# rate (8, 12, 16, 24 or 48 kHz) to the internal one, never up. Equal rates
# copy through a delay; lower ones take a second-order AR filter and a FIR
# interpolation (silk_resampler_private_down_FIR) at 3/4, 2/3, 1/2, 1/3, 1/4 or
# 1/6. Fixed point, exact. int16 values as words.
var _SKRS_FS_IN = 0;          # kHz
var _SKRS_FS_OUT = 8;         # kHz
var _SKRS_BATCH = 16;         # batchSize: 10 ms at the input rate
var _SKRS_DELAY = 24;         # inputDelay (delay_matrix_enc)
var _SKRS_INV_RATIO = 32;     # invRatio_Q16
var _SKRS_FN = 40;            # 0: copy, 1: down_FIR
var _SKRS_FIR_ORDER = 48;     # 18, 24 or 36
var _SKRS_FIR_FRACS = 56;
var _SKRS_COEFS = 64;         # the table: 2 AR2 coefficients, then the FIR's (ptr)
var _SKRS_SIIR = 72;          # [2]
var _SKRS_SFIR = 88;          # [36]
var _SKRS_DELAYBUF = 376;     # [48]
var _SKRS_SIZE = 760;

var _sk_rs_tabs = 0;          # [6] silk_Resampler_{3_4,2_3,1_2,1_3,1_4,1_6}_COEFS (ptrs)

fn _sk_rs_tables_init() {
    var t = alloc(6 * 8);
    store64(t, _sk_ints("-20694,-13867,-49,64,17,-157,353,-496,163,11047,22205,-39,6,91,-170,186,23,-896,6336,19928,-19,-36,102,-89,-24,328,-951,2568,15909", 29));
    store64(t + 8, _sk_ints("-14457,-14019,64,128,-122,36,310,-768,584,9267,17733,12,128,18,-142,288,-117,-865,4123,14459", 20));
    store64(t + 16, _sk_ints("616,-14323,-10,39,58,-46,-84,120,184,-315,-541,1284,5380,9024", 14));
    store64(t + 24, _sk_ints("16102,-15162,-13,0,20,26,5,-31,-43,-4,65,90,7,-157,-248,-44,593,1583,2612,3271", 20));
    store64(t + 32, _sk_ints("22500,-15099,3,-14,-20,-15,2,25,37,25,-16,-71,-107,-79,50,292,623,982,1288,1464", 20));
    store64(t + 40, _sk_ints("27540,-15257,17,12,8,1,-10,-22,-30,-32,-22,3,44,100,168,243,317,381,429,455", 20));
    _sk_rs_tabs = t;
    return 0;
}

# rateID: 8, 12, 16, 24, 48 kHz to 0..4.
fn _sk_rate_id(hz) {
    if (hz == 8000) { return 0; }
    if (hz == 12000) { return 1; }
    if (hz == 16000) { return 2; }
    if (hz == 24000) { return 3; }
    return 4;
}

# silk_resampler_init (forEnc): a state for api_hz to fs_hz, or 0 for a pair
# libopus refuses.
fn silk_enc_resampler_new(api_hz, fs_hz) {
    if (api_hz != 8000 && api_hz != 12000 && api_hz != 16000 && api_hz != 24000 && api_hz != 48000) { return 0; }
    if (fs_hz != 8000 && fs_hz != 12000 && fs_hz != 16000) { return 0; }
    if (fs_hz > api_hz) { return 0; }
    var rs = alloc(_SKRS_SIZE);
    silk_enc_resampler_init(rs, api_hz, fs_hz);
    return rs;
}

var _sk_rs_delay_enc = 0;

# silk_resampler_init (encoder side) in place: a fresh state for api_hz to
# fs_hz, as silk_setup_resamplers re-initialises it when the internal rate
# changes.
fn silk_enc_resampler_init(rs, api_hz, fs_hz) {
    if (_sk_rs_tabs == 0) { _sk_rs_tables_init(); }
    # delay_matrix_enc[in][out]: rows 8, 12, 16, 24, 48 kHz, columns 8, 12, 16
    if (_sk_rs_delay_enc == 0) { _sk_rs_delay_enc = _sk_ints("6,0,3,0,7,3,0,1,10,0,2,6,18,10,12", 15); }
    _sk_zero(rs, _SKRS_SIZE);
    var dm = _sk_rs_delay_enc;
    store64(rs + _SKRS_DELAY, load64(dm + (_sk_rate_id(api_hz) * 3 + _sk_rate_id(fs_hz)) * 8));
    store64(rs + _SKRS_FS_IN, api_hz / 1000);
    store64(rs + _SKRS_FS_OUT, fs_hz / 1000);
    store64(rs + _SKRS_BATCH, api_hz / 1000 * 10);
    if (fs_hz < api_hz) {
        store64(rs + _SKRS_FN, 1);
        var tab = 0;
        var order = 18;
        var fracs = 1;
        if (fs_hz * 4 == api_hz * 3) { tab = 0; fracs = 3; }
        else {
            if (fs_hz * 3 == api_hz * 2) { tab = 1; fracs = 2; }
            else {
                if (fs_hz * 2 == api_hz) { tab = 2; order = 24; }
                else {
                    if (fs_hz * 3 == api_hz) { tab = 3; order = 36; }
                    else {
                        if (fs_hz * 4 == api_hz) { tab = 4; order = 36; }
                        else { tab = 5; order = 36; }      # 1/6
                    }
                }
            }
        }
        store64(rs + _SKRS_COEFS, load64(_sk_rs_tabs + tab * 8));
        store64(rs + _SKRS_FIR_ORDER, order);
        store64(rs + _SKRS_FIR_FRACS, fracs);
    }
    # invRatio_Q16, rounded up
    var inv = silk_div_trunc(api_hz << 14, fs_hz) << 2;
    while (silk_smulww(inv, fs_hz) < api_hz) { inv = inv + 1; }
    store64(rs + _SKRS_INV_RATIO, inv);
    return rs;
}

# The decoder-side silk_resampler (resampler.c, forEnc 0) from an internal
# rate fs_in (8, 12 or 16 kHz) up to fs_out (8 to 48 kHz), in the arena: the
# temporary resampler silk_setup_resamplers runs the encoder's history
# through. Words as silk_resampler_init's (shravan's decoder): fs_in and
# fs_out (kHz), batch, inputDelay (delay_matrix_dec), invRatio_Q16, the
# function (0 copy, 1 up2_HQ, 2 IIR_FIR), and sIIR, sFIR and delayBuf.
var _sk_rs_delay_dec = 0;
fn _sk_dec_resampler_new(fs_in_hz, fs_out_hz) {
    if (_silk_frac_fir12 == 0) { _silk_resampler_tables_init(); }
    if (_sk_rs_delay_dec == 0) { _sk_rs_delay_dec = _sk_ints("4,0,2,0,0,0,9,4,7,4,0,3,12,7,7", 15); }
    var rst = _opus_tmp(9 * 8);
    var fi = fs_in_hz / 1000;
    var fo = fs_out_hz / 1000;
    store64(rst, fi);
    store64(rst + 8, fo);
    store64(rst + 16, fi * 10);
    store64(rst + 24, load64(_sk_rs_delay_dec + (_sk_rate_id(fs_in_hz) * 5 + _sk_rate_id(fs_out_hz)) * 8));
    var up2x = 0;
    var fn_ = 0;
    if (fs_out_hz > fs_in_hz) {
        if (fs_out_hz == 2 * fs_in_hz) { fn_ = 1; } else { fn_ = 2; up2x = 1; }
    }
    var inv = silk_div_trunc(fs_in_hz << (14 + up2x), fs_out_hz) << 2;
    while (silk_smulww(inv, fs_out_hz) < (fs_in_hz << up2x)) { inv = inv + 1; }
    store64(rst + 32, inv);
    store64(rst + 40, fn_);
    var siir = _opus_tmp(6 * 8);
    _sk_zero(siir, 6 * 8);
    store64(rst + 48, siir);
    var sfir = _opus_tmp(8 * 8);
    _sk_zero(sfir, 8 * 8);
    store64(rst + 56, sfir);
    var db = _opus_tmp(fi * 8);
    _sk_zero(db, fi * 8);
    store64(rst + 64, db);
    return rst;
}

# silk_resampler for _sk_dec_resampler_new's state: the input's first
# fs_in - inputDelay samples through the delay buffer, then the rest.
fn _sk_dec_resample(rst, out, inp, inLen) {
    var fi = load64(rst);
    var fo = load64(rst + 8);
    var dly = load64(rst + 24);
    var fn_ = load64(rst + 40);
    var db = load64(rst + 64);
    var ns = fi - dly;
    _sk_copy_words(db + dly * 8, inp, ns);
    if (fn_ == 2) {
        silk_resampler_iir_fir(rst, out, db, fi);
        silk_resampler_iir_fir(rst, out + fo * 8, inp + ns * 8, inLen - fi);
    } else {
        if (fn_ == 1) {
            silk_resampler_up2_hq(load64(rst + 48), out, db, fi);
            silk_resampler_up2_hq(load64(rst + 48), out + fo * 8, inp + ns * 8, inLen - fi);
        } else {
            _sk_copy_words(out, db, fi);
            _sk_copy_words(out + fo * 8, inp + ns * 8, inLen - fi);
        }
    }
    _sk_copy_words(db, inp + (inLen - dly) * 8, dly);
    return 0;
}

# silk_resampler_private_down_FIR_INTERPOL: the FIR over the AR2 output.
fn _sk_down_fir_interpol(out, buf, fir, order, fracs, max_index_Q16, incr_Q16) {
    var op = out;
    var index_Q16 = 0;
    while (index_Q16 < max_index_Q16) {
        var bp = buf + sar(index_Q16, 16) * 8;
        var r = 0;
        var k = 0;
        if (order == 18) {
            var ind = silk_smulwb(index_Q16 & 0xFFFF, fracs);
            var ip = fir + 9 * ind * 8;
            r = silk_smulwb(load64(bp), load64(ip));
            k = 1;
            while (k < 9) { r = silk_smlawb(r, load64(bp + k * 8), load64(ip + k * 8)); k = k + 1; }
            ip = fir + 9 * (fracs - 1 - ind) * 8;
            k = 0;
            while (k < 9) { r = silk_smlawb(r, load64(bp + (17 - k) * 8), load64(ip + k * 8)); k = k + 1; }
        } else {
            var half = order / 2;
            r = silk_smulwb(silk_sx32(load64(bp) + load64(bp + (order - 1) * 8)), load64(fir));
            k = 1;
            while (k < half) {
                r = silk_smlawb(r, silk_sx32(load64(bp + k * 8) + load64(bp + (order - 1 - k) * 8)), load64(fir + k * 8));
                k = k + 1;
            }
        }
        store64(op, silk_sat16(silk_rshift_round(r, 6)));
        op = op + 8;
        index_Q16 = index_Q16 + incr_Q16;
    }
    return op;
}

# silk_resampler_private_down_FIR: batches of 10 ms through the AR2 filter
# (Q8) and the interpolating FIR, the filter's tail carried between calls.
fn _sk_down_fir(rs, out, inp, inLen) {
    var order = load64(rs + _SKRS_FIR_ORDER);
    var coefs = load64(rs + _SKRS_COEFS);
    var batch = load64(rs + _SKRS_BATCH);
    var buf = _opus_tmp((batch + order) * 8);
    var i = 0;
    while (i < order) { store64(buf + i * 8, load64(rs + _SKRS_SFIR + i * 8)); i = i + 1; }
    var incr = load64(rs + _SKRS_INV_RATIO);
    var op = out;
    var ip = inp;
    var nIn = 0;
    var done = 0;
    while (done == 0) {
        nIn = inLen;
        if (nIn > batch) { nIn = batch; }
        _sk_resampler_ar2(rs + _SKRS_SIIR, buf + order * 8, ip, load64(coefs), load64(coefs + 8), nIn);
        op = _sk_down_fir_interpol(op, buf, coefs + 16, order, load64(rs + _SKRS_FIR_FRACS), nIn << 16, incr);
        ip = ip + nIn * 8;
        inLen = inLen - nIn;
        if (inLen > 1) {
            i = 0;
            while (i < order) { store64(buf + i * 8, load64(buf + (nIn + i) * 8)); i = i + 1; }
        } else {
            done = 1;
        }
    }
    i = 0;
    while (i < order) { store64(rs + _SKRS_SFIR + i * 8, load64(buf + (nIn + i) * 8)); i = i + 1; }
    return 0;
}

# silk_resampler: inLen input samples (at least 1 ms) to inLen * out / in.
# The first millisecond goes through the delay buffer, so the output lags the
# input by inputDelay samples.
fn silk_enc_resample(rs, out, inp, inLen) {
    var fin = load64(rs + _SKRS_FS_IN);
    var fout = load64(rs + _SKRS_FS_OUT);
    var dly = load64(rs + _SKRS_DELAY);
    var db = rs + _SKRS_DELAYBUF;
    var ns = fin - dly;
    var i = 0;
    while (i < ns) { store64(db + (dly + i) * 8, load64(inp + i * 8)); i = i + 1; }
    if (load64(rs + _SKRS_FN) == 1) {
        _sk_down_fir(rs, out, db, fin);
        _sk_down_fir(rs, out + fout * 8, inp + ns * 8, inLen - fin);
    } else {
        i = 0;
        while (i < fin) { store64(out + i * 8, load64(db + i * 8)); i = i + 1; }
        i = 0;
        while (i < inLen - fin) { store64(out + (fout + i) * 8, load64(inp + (ns + i) * 8)); i = i + 1; }
    }
    i = 0;
    while (i < dly) { store64(db + i * 8, load64(inp + (inLen - dly + i) * 8)); i = i + 1; }
    return 0;
}

# ---------------------------------------------------------------- stereo (2.12.2)
#
# libopus's stereo SILK encoder (stereo_LR_to_MS.c and the files it calls):
# left/right to an adaptive mid/side, the side predicted from the mid's low and
# high bands, the rate split between them, and the width collapsed to mid-only
# frames at low rates or for nearly panned input. Fixed point, exact.
var _SKST_PRED_PREV = 0;      # [2] pred_prev_Q13
var _SKST_SSIDE = 16;         # [2] sSide (sMid is the encoder's _SKX_SMID)
var _SKST_AMP = 32;           # [4] mid_side_amp_Q0: smoothed mid and residual norms, low then high band
var _SKST_SMTH_WIDTH = 64;    # smth_width_Q14
var _SKST_WIDTH_PREV = 72;    # width_prev_Q14
var _SKST_SILENT_SIDE = 80;   # silent_side_len
var _SKST_PREDIX = 88;        # [3 frames][2][3] predIx
var _SKST_MID_ONLY = 232;     # [3] mid_only_flags
var _SKST_SIZE = 256;

# The stereo state, zeroed as silk_InitEncoder leaves it; the first stereo
# packet (a move from mono, which is how the encoder starts) sets the norms
# and the width.
fn silk_stereo_enc_state_new() {
    var t = alloc(_SKST_SIZE);
    memset(t, 0, _SKST_SIZE);
    return t;
}

# silk_inner_prod_aligned_scale: sum of x[i] y[i] >> scale, for int16 words
# and the scale silk_stereo_find_predictor takes from both energies (each
# under 2^30 after its shift), so that the sum is within them and int32
# never wraps.
fn _sk_inner_prod_scale(x, y, scale, len) {
    var sum = 0;
    var i = 0;
    while (i < len) { sum = sum + sar(load64(x + i * 8) * load64(y + i * 8), scale); i = i + 1; }
    return sum;
}

# silk_sum_sqr_shift for int16 words at the frame lengths (80 to 320), its
# arithmetic inline. A pair's squares sum to at most 2^31 (libopus's unsigned
# silk_SMLABB_ovflw); shifted by floor(log2 len), the first pass's total is at
# most len / 2 * 2^31 / 2^floor(log2 len) + len, 2,013,266,160 at its largest
# (240 samples), under 2^31, and the second pass keeps two bits of headroom:
# libopus's int32 sum never wraps here.
fn _sk_sum_sqr_shift16(out, x, len) {
    var shft = 31 - silk_clz32(len);
    var nrg = len;
    var pass = 0;
    while (pass < 2) {
        var i = 0;
        while (i < len - 1) {
            var a = load64(x + i * 8);
            var b = load64(x + (i + 1) * 8);
            nrg = nrg + ((a * a + b * b) >> shft);
            i = i + 2;
        }
        if (i < len) {
            var c = load64(x + i * 8);
            nrg = silk_sx32(nrg + ((c * c) >> shft));
        }
        if (pass == 0) {
            shft = shft + 3 - silk_clz32(nrg);
            if (shft < 0) { shft = 0; }
            nrg = 0;
        }
        pass = pass + 1;
    }
    store64(out + 0, nrg);
    store64(out + 8, shft);
    return 0;
}

# silk_stereo_find_predictor (stereo_find_predictor.c): the least-squares
# predictor of y from x (Q13), the smoothed norms of x and of the residual
# (amp[0], amp[1]), and their ratio (Q14) into *ratio.
fn silk_stereo_find_predictor(ratio, x, y, amp, length, smooth) {
    var sx = _opus_tmp(2 * 8);
    var sy = _opus_tmp(2 * 8);
    _sk_sum_sqr_shift16(sx, x, length);
    _sk_sum_sqr_shift16(sy, y, length);
    var scale1 = load64(sx + 8);
    var scale2 = load64(sy + 8);
    var scale = scale1;
    if (scale2 > scale) { scale = scale2; }
    scale = scale + (scale & 1);
    var nrgy = sar(load64(sy), scale - scale2);
    var nrgx = sar(load64(sx), scale - scale1);
    if (nrgx < 1) { nrgx = 1; }
    var corr = _sk_inner_prod_scale(x, y, scale, length);
    var pred = silk_div32_varq(corr, nrgx, 13);
    pred = silk_limit(pred, 0 - 16384, 16384);
    var pred2 = silk_sx32(silk_smulwb(pred, pred));
    var p2 = pred2;
    if (p2 < 0) { p2 = 0 - p2; }
    if (p2 > smooth) { smooth = p2; }
    scale = sar(scale, 1);
    store64(amp, silk_smlawb(load64(amp), silk_sx32((silk_sqrt_approx(nrgx) << scale) - load64(amp)), smooth));
    nrgy = silk_sx32(nrgy - (silk_sx32(silk_smulwb(corr, pred)) << 4));
    nrgy = silk_sx32(nrgy + (silk_sx32(silk_smulwb(nrgx, pred2)) << 6));
    store64(amp + 8, silk_smlawb(load64(amp + 8), silk_sx32((silk_sqrt_approx(nrgy) << scale) - load64(amp + 8)), smooth));
    var den = load64(amp);
    if (den < 1) { den = 1; }
    store64(ratio, silk_limit(silk_div32_varq(load64(amp + 8), den, 14), 0, 32767));
    return pred;
}

# silk_stereo_quant_pred (stereo_quant_pred.c): each predictor to the nearest
# of 15 x 5 levels (stopping where the error starts to grow), ix[n] = {step
# within its third, sub-step, third}; then pred[0] -= pred[1].
fn silk_stereo_quant_pred(pred, ix) {
    if (_silk_stereo_pred_q13 == 0) { _silk_stereo_tables_init(); }
    var n = 0;
    while (n < 2) {
        var err_min = 2147483647;
        var qp = 0;
        var done = 0;
        var i = 0;
        while (i < 15 && done == 0) {
            var low = load64(_silk_stereo_pred_q13 + i * 8);
            var step = silk_smulwb(load64(_silk_stereo_pred_q13 + (i + 1) * 8) - low, 6554);   # SILK_FIX_CONST(0.5 / 5, 16)
            var j = 0;
            while (j < 5 && done == 0) {
                var lvl = silk_smlabb(low, step, 2 * j + 1);
                var er = load64(pred + n * 8) - lvl;
                if (er < 0) { er = 0 - er; }
                if (er < err_min) {
                    err_min = er;
                    qp = lvl;
                    store64(ix + (n * 3) * 8, i);
                    store64(ix + (n * 3 + 1) * 8, j);
                } else {
                    done = 1;
                }
                j = j + 1;
            }
            i = i + 1;
        }
        var third = load64(ix + (n * 3) * 8) / 3;
        store64(ix + (n * 3 + 2) * 8, third);
        store64(ix + (n * 3) * 8, load64(ix + (n * 3) * 8) - third * 3);
        store64(pred + n * 8, qp);
        n = n + 1;
    }
    store64(pred, load64(pred) - load64(pred + 8));
    return 0;
}

# silk_stereo_encode_pred and silk_stereo_encode_mid_only (stereo_encode_pred.c).
fn silk_stereo_encode_pred(ec, ix) {
    if (_silk_stereo_pred_q13 == 0) { _silk_stereo_tables_init(); }
    ec_enc_icdf(ec, 5 * load64(ix + 2 * 8) + load64(ix + 5 * 8), _silk_stereo_pred_joint, 8);
    var n = 0;
    while (n < 2) {
        ec_enc_icdf(ec, load64(ix + (n * 3) * 8), _silk_uniform3, 8);
        ec_enc_icdf(ec, load64(ix + (n * 3 + 1) * 8), _silk_uniform5, 8);
        n = n + 1;
    }
    return 0;
}

fn silk_stereo_encode_mid_only(ec, flag) {
    if (_silk_stereo_pred_q13 == 0) { _silk_stereo_tables_init(); }
    ec_enc_icdf(ec, flag, _silk_stereo_only_mid, 8);
    return 0;
}

# silk_stereo_LR_to_MS (stereo_LR_to_MS.c). x1, x2: each channel's input
# buffer at inputBuf + 2 (int16 words, the frame); x1 becomes the mid (from
# x1 - 2, with the 2 samples smid carries), x2 the side residual (from x2 - 1).
# ix: the frame's 6 predictor indices; *mid_only: the flag; rates: the mid's
# and side's bit rates out of total_rate. prev_speech: the mid's speech
# activity (Q8) from the frame before; toMono: the last frame before a
# stereo-to-mono switch.
fn silk_stereo_lr_to_ms(stst, smid, x1, x2, ix, mid_only, rates, total_rate, prev_speech, toMono, fs, fl) {
    var mid = x1 - 16;
    var side = _opus_tmp((fl + 2) * 8);
    var n = 0;
    while (n < fl + 2) {
        # int16 in: the rounded half sum always fits, the half difference
        # only saturates at 32768
        var a = load64(x1 + (n - 2) * 8);
        var b = load64(x2 + (n - 2) * 8);
        store64(mid + n * 8, sar(a + b + 1, 1));
        var dd = sar(a - b + 1, 1);
        if (dd > 32767) { dd = 32767; }
        store64(side + n * 8, dd);
        n = n + 1;
    }
    # buffering: the 2 samples each from the frame before
    store64(mid, load64(smid));
    store64(mid + 8, load64(smid + 8));
    store64(side, load64(stst + _SKST_SSIDE));
    store64(side + 8, load64(stst + _SKST_SSIDE + 8));
    store64(smid, load64(mid + fl * 8));
    store64(smid + 8, load64(mid + (fl + 1) * 8));
    store64(stst + _SKST_SSIDE, load64(side + fl * 8));
    store64(stst + _SKST_SSIDE + 8, load64(side + (fl + 1) * 8));
    # low and high bands
    var lpm = _opus_tmp(fl * 8);
    var hpm = _opus_tmp(fl * 8);
    var lps = _opus_tmp(fl * 8);
    var hps = _opus_tmp(fl * 8);
    n = 0;
    while (n < fl) {
        # For int16 x, both bands fit int16 as they are, so libopus's int16
        # stores change nothing: the low band (x0 + 2 x1 + x2 + 2) >> 2 trivially,
        # the high band x1 less it lies in [(2 x1 - x0 - x2 - 2) / 4,
        # (2 x1 - x0 - x2 + 1) / 4], inside [-32768, 32767.75].
        var m1 = load64(mid + (n + 1) * 8);
        var sm = sar(load64(mid + n * 8) + load64(mid + (n + 2) * 8) + (m1 << 1) + 2, 2);
        store64(lpm + n * 8, sm);
        store64(hpm + n * 8, m1 - sm);
        var s1 = load64(side + (n + 1) * 8);
        var ss = sar(load64(side + n * 8) + load64(side + (n + 2) * 8) + (s1 << 1) + 2, 2);
        store64(lps + n * 8, ss);
        store64(hps + n * 8, s1 - ss);
        n = n + 1;
    }
    # predictors and energies
    var is10 = 0;
    if (fl == 10 * fs) { is10 = 1; }
    var smooth = 655;                                   # SILK_FIX_CONST(STEREO_RATIO_SMOOTH_COEF 0.01, 16)
    if (is10 == 1) { smooth = 328; }
    smooth = silk_sx32(silk_smulwb(silk_smulbb(prev_speech, prev_speech), smooth));
    var lr = _opus_tmp(8);
    var hr = _opus_tmp(8);
    var pred = _opus_tmp(2 * 8);
    store64(pred, silk_stereo_find_predictor(lr, lpm, lps, stst + _SKST_AMP, fl, smooth));
    store64(pred + 8, silk_stereo_find_predictor(hr, hpm, hps, stst + _SKST_AMP + 16, fl, smooth));
    var frac = silk_smlabb(load64(hr), load64(lr), 3);
    if (frac > 65536) { frac = 65536; }
    # the rate split, and possibly a narrower width
    if (is10 == 1) { total_rate = total_rate - 1200; } else { total_rate = total_rate - 600; }
    if (total_rate < 1) { total_rate = 1; }
    var min_mid = silk_smlabb(2000, fs, 600);
    var frac3 = silk_sx32(3 * frac);
    var width = 16384;
    store64(rates, silk_div32_varq(total_rate, 851968 + frac3, 19));      # SILK_FIX_CONST(8 + 5, 16)
    if (load64(rates) < min_mid) {
        store64(rates, min_mid);
        store64(rates + 8, total_rate - min_mid);
        width = silk_div32_varq(silk_sx32((load64(rates + 8) << 1) - min_mid),
          silk_sx32(silk_smulwb(65536 + frac3, min_mid)), 16);
        width = silk_limit(width, 0, 16384);
    } else {
        store64(rates + 8, total_rate - load64(rates));
    }
    var sw = load64(stst + _SKST_SMTH_WIDTH);
    sw = _i16(silk_smlawb(sw, width - sw, smooth));
    store64(stst + _SKST_SMTH_WIDTH, sw);
    # mid-only (panned mono) coding at very low rates or nearly panned input
    var mo = 0;
    var wp = load64(stst + _SKST_WIDTH_PREV);
    var fw = silk_smulwb(frac, sw);
    if (toMono != 0) {
        width = 0;
        store64(pred, 0);
        store64(pred + 8, 0);
        silk_stereo_quant_pred(pred, ix);
    } else {
        if (wp == 0 && (8 * total_rate < 13 * min_mid || fw < 819)) {          # SILK_FIX_CONST(0.05, 14)
            store64(pred, sar(silk_smulbb(sw, load64(pred)), 14));
            store64(pred + 8, sar(silk_smulbb(sw, load64(pred + 8)), 14));
            silk_stereo_quant_pred(pred, ix);
            width = 0;
            store64(pred, 0);
            store64(pred + 8, 0);
            store64(rates, total_rate);
            store64(rates + 8, 0);
            mo = 1;
        } else {
            if (wp != 0 && (8 * total_rate < 11 * min_mid || fw < 328)) {      # SILK_FIX_CONST(0.02, 14)
                store64(pred, sar(silk_smulbb(sw, load64(pred)), 14));
                store64(pred + 8, sar(silk_smulbb(sw, load64(pred + 8)), 14));
                silk_stereo_quant_pred(pred, ix);
                width = 0;
                store64(pred, 0);
                store64(pred + 8, 0);
            } else {
                if (sw > 15565) {                                               # SILK_FIX_CONST(0.95, 14)
                    silk_stereo_quant_pred(pred, ix);
                    width = 16384;
                } else {
                    store64(pred, sar(silk_smulbb(sw, load64(pred)), 14));
                    store64(pred + 8, sar(silk_smulbb(sw, load64(pred + 8)), 14));
                    silk_stereo_quant_pred(pred, ix);
                    width = sw;
                }
            }
        }
    }
    # keep coding the side until the tapered output has gone out
    if (mo == 1) {
        var ssl = load64(stst + _SKST_SILENT_SIDE) + fl - 8 * fs;            # STEREO_INTERP_LEN_MS
        if (ssl < 5 * fs) { mo = 0; store64(stst + _SKST_SILENT_SIDE, ssl); }  # LA_SHAPE_MS
        else { store64(stst + _SKST_SILENT_SIDE, 10000); }
    } else {
        store64(stst + _SKST_SILENT_SIDE, 0);
    }
    store64(mid_only, mo);
    if (mo == 0 && load64(rates + 8) < 1) {
        store64(rates + 8, 1);
        var r0 = total_rate - 1;
        if (r0 < 1) { r0 = 1; }
        store64(rates, r0);
    }
    # the side less its prediction from the mid, the predictors and width
    # interpolated over the first 8 ms
    var pp0 = load64(stst + _SKST_PRED_PREV);
    var pp1 = load64(stst + _SKST_PRED_PREV + 8);
    var p0 = 0 - pp0;
    var p1 = 0 - pp1;
    var w = wp << 10;
    var il = 8 * fs;
    var denom = silk_div_trunc(65536, il);
    var d0 = 0 - silk_rshift_round(silk_smulbb(load64(pred) - pp0, denom), 16);
    var d1 = 0 - silk_rshift_round(silk_smulbb(load64(pred + 8) - pp1, denom), 16);
    var dw = silk_sx32(silk_smulwb(width - wp, denom)) << 10;
    # Each term stays inside 32 bits (the mid's 3-tap sum, 2^26, times a Q13
    # predictor under 2^15, over 2^16; w under 2^25 times int16 over 2^16), so
    # silk_SMULWB/SMLAWB are inline here without the wrap; the predictors and
    # the side are int16, as their casts take them.
    n = 0;
    while (n < fl) {
        if (n < il) {
            p0 = p0 + d0;
            p1 = p1 + d1;
            w = w + dw;
        } else {
            if (n == il) { p0 = 0 - load64(pred); p1 = 0 - load64(pred + 8); w = width << 10; }
        }
        var c0 = _i16(p0);
        var c1 = _i16(p1);
        var mm = load64(mid + (n + 1) * 8);
        var sm2 = (load64(mid + n * 8) + load64(mid + (n + 2) * 8) + (mm << 1)) << 9;
        var sd = load64(side + (n + 1) * 8);
        var sum = sar(w, 16) * sd + sar((w & 0xFFFF) * sd, 16);
        sum = sum + sar(sm2, 16) * c0 + sar((sm2 & 0xFFFF) * c0, 16);
        var mm11 = mm << 11;
        sum = sum + sar(mm11, 16) * c1 + sar((mm11 & 0xFFFF) * c1, 16);
        var o = sar(sum + 128, 8);
        if (o > 32767) { o = 32767; }
        if (o < 0 - 32768) { o = 0 - 32768; }
        store64(x2 + (n - 1) * 8, o);
        n = n + 1;
    }
    store64(stst + _SKST_PRED_PREV, _i16(load64(pred)));
    store64(stst + _SKST_PRED_PREV + 8, _i16(load64(pred + 8)));
    store64(stst + _SKST_WIDTH_PREV, _i16(width));
    return 0;
}

# ---------------------------------------------------------------- the packet (2.11.3)
#
# The encoder (libopus silk_Encode), 8-byte words at fixed offsets.
var _SKX_ST = 0;              # the channel's state (_SKE_)
var _SKX_CTRL = 8;
var _SKX_FS_HZ = 16;          # the internal rate
var _SKX_MS = 24;             # packet duration: 10, 20, 40 or 60 ms
var _SKX_NFRAMES = 32;        # frames a packet: 1 (10 and 20 ms), 2 or 3
var _SKX_BITRATE = 40;
var _SKX_CBR = 48;
var _SKX_INBUF = 56;          # [frame + 2] int16: the frame behind the previous frame's last 2 samples
var _SKX_SMID = 64;           # [2] those 2 samples
var _SKX_RS = 80;             # the input resampler (_SKRS_, ptr)
var _SKX_API_HZ = 88;         # the input's rate (API_sampleRate)
var _SKX_EXCEEDED = 96;       # nBitsExceeded, the bit reservoir
var _SKX_ICDF = 104;          # the flags' reservation: a two-entry iCDF (ptr)
var _SKX_X16 = 112;           # [packet] int16 input at the API rate (ptr)
var _SKX_EC = 120;            # the range coder's struct (ptr)
var _SKX_NBITS_LBRR = 128;    # nBitsUsedLBRR, the LBRR frames' bits, averaged
var _SKX_FEC = 136;           # LBRR_coded: in-band FEC on
var _SKX_LBRR_ICDF = 144;     # silk_LBRR_flags_iCDF of the packet's frame count (ptr)
var _SKX_CH_API = 152;        # input channels, 1 or 2 (interleaved): nChannelsAPI (2.12.2)
var _SKX_CH_INT = 160;        # channels coded, 1 or 2: nChannelsInternal
var _SKX_ST1 = 168;           # the side channel's state (_SKE_, ptr; stereo input)
var _SKX_INBUF1 = 176;        # its [frame + 2] input
var _SKX_RS1 = 184;           # its resampler
var _SKX_STEREO = 192;        # the stereo state (_SKST_, ptr)
var _SKX_PREV_MID_ONLY = 200; # prev_decode_only_middle: the last frame coded the mid alone
var _SKX_PREV_CH_INT = 208;   # nPrevChannelsInternal: the last packet's channels (0 before the first)
var _SKX_CUR_CH_INT = 216;    # psEnc->nChannelsInternal: the channels the states are set up for
var _SKX_TO_MONO = 224;       # toMono: the last packet before going from stereo to mono
var _SKX_X16B = 232;          # [packet] the right channel, int16 at the API rate (ptr)
var _SKX_RATES = 240;         # [2] MStargetRates_bps: the mid's and side's bit rates
var _SKX_MAX_INT_HZ = 256;    # maxInternalSampleRate (2.12.3: the control, libopus silk_EncControlStruct)
var _SKX_MIN_INT_HZ = 264;    # minInternalSampleRate
var _SKX_DESIRED_INT_HZ = 272;  # desiredInternalSampleRate
var _SKX_COMPLEXITY = 280;    # 0 to 10
var _SKX_CAN_SWITCH = 288;    # opusCanSwitch (in)
var _SKX_SWITCH_READY = 296;  # switchReady (out)
var _SKX_ALLOW_SWITCH = 304;  # allowBandwidthSwitch: low speech activity lately (out)
var _SKX_TIME_SINCE_SWITCH = 312;  # timeSinceSwitchAllowed_ms
var _SKX_ACTIVITY = 320;      # the Opus layer's voice activity: -1 none, 0 or 1
var _SKX_REDUCED_DEP = 328;   # reducedDependency: every packet coded as a first one
var _SKX_LBRR_ICDF2 = 336;    # silk_LBRR_flags_iCDF_ptr for 2 and 3 frames a packet
var _SKX_LBRR_ICDF3 = 344;
var _SKX_MAX_BITS_OUT = 352;  # the packet's maxBits after the control's switchReady share
var _SKX_LOSS = 360;          # packetLossPercentage
var _SKX_DTX = 368;           # useDTX
var _SKX_SIZE = 376;

# silk_encoder_new: a mono SILK encoder. fs_hz: 8000, 12000 or 16000, both the
# input rate and the coded bandwidth (narrow, medium, wide); packet_ms 10, 20,
# 40 or 60; bitrate 1 to 1,000,000 bit/s (the coder itself holds a frame to at
# least 5 kbit/s); complexity 0 or 1 (libopus's settings for them: higher ones
# select silk_NSQ_del_dec, which shravan does not have); cbr nonzero for
# constant bit rate. Returns the encoder, or ERR_INVALID_RATE / ERR_ENCODE /
# ERR_UNSUPPORTED_FMT.
fn silk_encoder_new(fs_hz, packet_ms, bitrate, complexity, cbr) {
    return silk_encoder_new_api(fs_hz, fs_hz, packet_ms, bitrate, complexity, cbr);
}

# silk_encoder_new_api (2.12.1): the same with the input at its own rate
# (libopus's API_sampleRate): api_hz 8000, 12000, 16000, 24000 or 48000,
# resampled to the internal rate fs_hz, which, as libopus does, never exceeds
# it (a higher one codes at api_hz).
fn silk_encoder_new_api(api_hz, fs_hz, packet_ms, bitrate, complexity, cbr) {
    return silk_encoder_new_channels(api_hz, fs_hz, 1, packet_ms, bitrate, complexity, cbr);
}

# silk_encoder_new_channels (2.12.2): the same for 1 or 2 input channels
# (libopus's nChannelsAPI; stereo input interleaved, left first). Stereo input
# is coded as stereo (mid and side, the side predicted from the mid) until
# silk_encoder_set_channels says otherwise. bitrate is the total. Returns
# the encoder, or as silk_encoder_new_api does, ERR_INVALID_CHANNELS for
# another channel count.
fn silk_encoder_new_channels(api_hz, fs_hz, channels, packet_ms, bitrate, complexity, cbr) {
    if (api_hz != 8000 && api_hz != 12000 && api_hz != 16000 && api_hz != 24000 && api_hz != 48000) {
        return err(ERR_INVALID_RATE);
    }
    if (fs_hz != 8000 && fs_hz != 12000 && fs_hz != 16000) { return err(ERR_INVALID_RATE); }
    if (channels != 1 && channels != 2) { return err(ERR_INVALID_CHANNELS); }
    if (packet_ms != 10 && packet_ms != 20 && packet_ms != 40 && packet_ms != 60) { return err(ERR_ENCODE); }
    if (bitrate < 1 || bitrate > 1000000) { return err(ERR_ENCODE); }
    if (complexity < 0 || complexity > 10) { return err(ERR_ENCODE); }
    if (fs_hz > api_hz) { fs_hz = api_hz; }
    var c = 0;
    if (cbr != 0) { c = 1; }
    var e = alloc(_SKX_SIZE);
    _sk_zero(e, _SKX_SIZE);
    # the states as silk_InitEncoder leaves them: the first packet's control
    # sets the rate (the desired one, fs_hz) and the packet length
    store64(e + _SKX_ST, silk_enc_state_alloc());
    store64(e + _SKX_CTRL, silk_enc_ctrl_new());
    store64(e + _SKX_FS_HZ, fs_hz);
    store64(e + _SKX_API_HZ, api_hz);
    store64(e + _SKX_MS, packet_ms);
    store64(e + _SKX_NFRAMES, packet_ms / 20 + (packet_ms == 10));
    store64(e + _SKX_BITRATE, bitrate);
    store64(e + _SKX_CBR, c);
    store64(e + _SKX_COMPLEXITY, complexity);
    store64(e + _SKX_MAX_INT_HZ, fs_hz);
    store64(e + _SKX_MIN_INT_HZ, fs_hz);
    store64(e + _SKX_DESIRED_INT_HZ, fs_hz);
    store64(e + _SKX_ACTIVITY, 0 - 1);
    var ib = alloc(322 * 8);
    _sk_zero(ib, 322 * 8);
    store64(e + _SKX_INBUF, ib);
    store64(e + _SKX_RS, alloc(_SKRS_SIZE));
    store64(e + _SKX_ICDF, alloc(8));
    store8(load64(e + _SKX_ICDF) + 1, 0);
    store64(e + _SKX_LBRR_ICDF2, _sk_bytes("203,150,0", 3));
    store64(e + _SKX_LBRR_ICDF3, _sk_bytes("215,195,166,125,110,82,0", 7));
    store64(e + _SKX_X16, alloc(api_hz / 1000 * 60 * 8));
    store64(e + _SKX_EC, alloc(96));
    store64(e + _SKX_CH_API, channels);
    store64(e + _SKX_CH_INT, channels);
    store64(e + _SKX_CUR_CH_INT, 1);
    if (channels == 2) {
        store64(e + _SKX_ST1, silk_enc_state_alloc());
        var ib1 = alloc(322 * 8);
        _sk_zero(ib1, 322 * 8);
        store64(e + _SKX_INBUF1, ib1);
        store64(e + _SKX_RS1, alloc(_SKRS_SIZE));
        store64(e + _SKX_STEREO, silk_stereo_enc_state_new());
        store64(e + _SKX_X16B, alloc(api_hz / 1000 * 60 * 8));
    }
    return e;
}

# silk_encoder_reset (2.12.3): silk_InitEncoder in place, nothing allocated:
# both channels' states, their input buffers, the stereo state, the bit
# reservoir and the bandwidth switching as silk_encoder_new_channels leaves
# them, one channel set up (the next stereo packet starts the side afresh). The
# control (rates, packet length, bit rate, complexity, CBR, loss, FEC, DTX)
# is kept.
fn silk_encoder_reset(e) {
    silk_enc_state_reset(load64(e + _SKX_ST));
    _sk_zero(load64(e + _SKX_CTRL), _SKC_SIZE);
    _sk_zero(load64(e + _SKX_INBUF), 322 * 8);
    _sk_zero(e + _SKX_SMID, 2 * 8);
    store64(e + _SKX_EXCEEDED, 0);
    store64(e + _SKX_NBITS_LBRR, 0);
    store64(e + _SKX_PREV_MID_ONLY, 0);
    store64(e + _SKX_PREV_CH_INT, 0);
    store64(e + _SKX_CUR_CH_INT, 1);
    store64(e + _SKX_TO_MONO, 0);
    _sk_zero(e + _SKX_RATES, 2 * 8);
    store64(e + _SKX_SWITCH_READY, 0);
    store64(e + _SKX_ALLOW_SWITCH, 0);
    store64(e + _SKX_TIME_SINCE_SWITCH, 0);
    store64(e + _SKX_MAX_BITS_OUT, 0);
    if (load64(e + _SKX_CH_API) == 2) {
        silk_enc_state_reset(load64(e + _SKX_ST1));
        _sk_zero(load64(e + _SKX_INBUF1), 322 * 8);
        _sk_zero(load64(e + _SKX_STEREO), _SKST_SIZE);
    }
    return 0;
}

# silk_encoder_set_channels (2.12.2): the channels the next packets code, 1 or
# 2 (libopus's nChannelsInternal), at most the input's. Stereo input coded as
# mono is the average of the two. Going to stereo starts the side channel
# afresh; before going to mono, a packet with silk_encoder_set_to_mono(e, 1)
# narrows the stereo image to nothing, as libopus's Opus layer does. Returns
# 0, or ERR_INVALID_CHANNELS.
fn silk_encoder_set_channels(e, n) {
    if (n != 1 && n != 2) { return err(ERR_INVALID_CHANNELS); }
    if (n > load64(e + _SKX_CH_API)) { return err(ERR_INVALID_CHANNELS); }
    store64(e + _SKX_CH_INT, n);
    return 0;
}

# silk_encoder_set_to_mono (2.12.2): 1 for the last stereo packets before
# going to mono (libopus's toMono): the side's predictors and width go to 0.
# Returns 0, or ERR_ENCODE for another value.
fn silk_encoder_set_to_mono(e, on) {
    if (on != 0 && on != 1) { return err(ERR_ENCODE); }
    store64(e + _SKX_TO_MONO, on);
    return 0;
}

# silk_encoder_stereo_width (2.12.2): the smoothed stereo width the encoder
# codes, Q14 (16384 full; libopus's stereoWidth_Q14, which its Opus layer
# reads for hybrid frames); 0 for mono input and under toMono.
fn silk_encoder_stereo_width(e) {
    var t = load64(e + _SKX_STEREO);
    if (t == 0 || load64(e + _SKX_TO_MONO) == 1) { return 0; }
    return load64(t + _SKST_SMTH_WIDTH);
}

# silk_encoder_set_bitrate (2.12.2): the bit rate of the next packets, 1 to
# 1,000,000 bit/s (libopus takes encControl->bitRate afresh each packet; its
# Opus layer moves it with the bandwidth and the signal). Under stereo coding
# the split between mid and side follows it. Returns 0, or ERR_ENCODE out of
# range.
fn silk_encoder_set_bitrate(e, bitrate) {
    if (bitrate < 1 || bitrate > 1000000) { return err(ERR_ENCODE); }
    store64(e + _SKX_BITRATE, bitrate);
    return 0;
}

# silk_encoder_set_packet_loss: the loss rate the far end reports, 0 to 100
# percent (libopus's packetLossPercentage). It scales the long-term predictor
# of voiced frames down, so that a lost packet costs the next ones less, and
# with in-band FEC it sets how much coarser the LBRR frames are. 0 by default.
# Returns 0, or ERR_ENCODE out of range.
fn silk_encoder_set_packet_loss(e, perc) {
    if (perc < 0 || perc > 100) { return err(ERR_ENCODE); }
    store64(e + _SKX_LOSS, perc);
    return 0;
}

# silk_encoder_set_fec (2.12.1): in-band FEC on (1) or off (0, the default),
# libopus's LBRR_coded. Each frame over 30% speech activity is then also coded
# coarser (an LBRR frame), and the next packet carries it ahead of its own
# frames, for a decoder to fall back on when this packet is lost. Returns 0, or
# ERR_ENCODE for another value.
fn silk_encoder_set_fec(e, on) {
    if (on != 0 && on != 1) { return err(ERR_ENCODE); }
    store64(e + _SKX_FEC, on);
    return 0;
}

# silk_encoder_set_dtx (2.12.1): discontinuous transmission on (1) or off (0,
# the default), libopus's useDTX. After 200 ms without voice activity, up to
# 400 ms at a time, packets carry nothing: silk_encode returns 0 bytes, and
# silk_encode_opus the TOC alone, which decoders conceal. Returns 0, or
# ERR_ENCODE for another value.
fn silk_encoder_set_dtx(e, on) {
    if (on != 0 && on != 1) { return err(ERR_ENCODE); }
    store64(e + _SKX_DTX, on);
    return 0;
}

# Samples a packet takes, at the input's rate, a channel (stereo input takes
# twice as many words, interleaved).
fn silk_encoder_samples(e) { return load64(e + _SKX_API_HZ) / 1000 * load64(e + _SKX_MS); }

# FLOAT2INT16: the sample as a float, times 32768, clamped (NaN to -32768, as
# libopus's comparisons leave it), rounded half to even.
fn _sk_float2int16(x) {
    var v = f64_mul(_sk_f32(x), f64_from(32768));
    if (f64_gt(v, f64_from(0 - 32768)) == 0) { v = f64_from(0 - 32768); }
    if (f64_lt(v, f64_from(32767)) == 0) { v = f64_from(32767); }
    return _sk_lrint(v);
}

# ---------------------------------------------------------------- control (2.12.3)
#
# silk_control_encoder (control_codec.c) and what it runs: the internal rate
# from the bandwidth state machine (silk_control_audio_bandwidth), the input
# resampler and history moved to a new rate (silk_setup_resamplers), the packet
# length and rate (silk_setup_fs), complexity, loss and LBRR; and the transition
# low-pass (silk_LP_variable_cutoff) a frame's input goes through while a
# switch is under way.

# silk_control_audio_bandwidth: the internal rate (kHz). A first control takes
# the desired rate (at most the input's); one out of the allowed range is
# clamped into it; otherwise, where a switch is allowed, a lower desired rate
# starts the transition down (the low-pass narrowing over 128 frames, then
# switchReady), a higher one is ready at once, and opusCanSwitch makes the
# switch, starting the low-pass's widening after an upward one. switchReady
# takes 5 / (ms + 5) of maxBits, for the Opus layer's redundancy.
fn _sk_control_audio_bandwidth(e, st) {
    var orig = load64(st + _SKE_FS_KHZ);
    if (orig == 0) { orig = load64(st + _SKE_LP_SAVED_FS); }
    var fs = orig;
    var fsHz = silk_smulbb(fs, 1000);
    var api = load64(e + _SKX_API_HZ);
    var mx = load64(e + _SKX_MAX_INT_HZ);
    var mn = load64(e + _SKX_MIN_INT_HZ);
    var des = load64(e + _SKX_DESIRED_INT_HZ);
    if (fsHz == 0) {
        fsHz = des;
        if (api < fsHz) { fsHz = api; }
        return fsHz / 1000;
    }
    if (fsHz > api || fsHz > mx || fsHz < mn) {
        fsHz = api;
        if (mx < fsHz) { fsHz = mx; }
        if (mn > fsHz) { fsHz = mn; }
        return fsHz / 1000;
    }
    if (load64(st + _SKE_LP_TFN) >= 256) { store64(st + _SKE_LP_MODE, 0); }                 # TRANSITION_FRAMES
    var can = load64(e + _SKX_CAN_SWITCH);
    if (load64(e + _SKX_ALLOW_SWITCH) == 1 || can == 1) {
        if (silk_smulbb(orig, 1000) > des) {
            if (load64(st + _SKE_LP_MODE) == 0) {
                store64(st + _SKE_LP_TFN, 256);
                _sk_zero(st + _SKE_LP_STATE, 2 * 8);
            }
            if (can == 1) {
                store64(st + _SKE_LP_MODE, 0);
                fs = 8;
                if (orig == 16) { fs = 12; }
            } else {
                if (load64(st + _SKE_LP_TFN) <= 0) {
                    store64(e + _SKX_SWITCH_READY, 1);
                    var mb = load64(e + _SKX_MAX_BITS_OUT);
                    store64(e + _SKX_MAX_BITS_OUT, mb - mb * 5 / (load64(e + _SKX_MS) + 5));
                } else {
                    store64(st + _SKE_LP_MODE, 0 - 2);
                }
            }
        } else {
            if (silk_smulbb(orig, 1000) < des) {
                if (can == 1) {
                    fs = 16;
                    if (orig == 8) { fs = 12; }
                    store64(st + _SKE_LP_TFN, 0);
                    _sk_zero(st + _SKE_LP_STATE, 2 * 8);
                    store64(st + _SKE_LP_MODE, 1);
                } else {
                    if (load64(st + _SKE_LP_MODE) == 0) {
                        store64(e + _SKX_SWITCH_READY, 1);
                        var mb2 = load64(e + _SKX_MAX_BITS_OUT);
                        store64(e + _SKX_MAX_BITS_OUT, mb2 - mb2 * 5 / (load64(e + _SKX_MS) + 5));
                    } else {
                        store64(st + _SKE_LP_MODE, 1);
                    }
                }
            } else {
                if (load64(st + _SKE_LP_MODE) < 0) { store64(st + _SKE_LP_MODE, 1); }
            }
        }
    }
    return fs;
}

# silk_setup_resamplers: a first rate initialises the input resampler; a new
# rate re-initialises it, and the history (2 frames and 5 ms, at the old
# rate) goes to int16, up to the input's rate through a fresh decoder-side
# resampler, and back down through the new one, which leaves that resampler's
# state as if it had run all along and the history at the new rate.
fn _sk_setup_resamplers(st, rs, api, fs) {
    var cur = load64(st + _SKE_FS_KHZ);
    if (cur != fs || load64(st + _SKE_PREV_API_HZ) != api) {
        if (cur == 0) {
            silk_enc_resampler_init(rs, api, fs * 1000);
        } else {
            var bms = silk_sx32((load64(st + _SKE_NB_SUBFR) * 5) << 1) + 5;               # + LA_SHAPE_MS
            var old_n = bms * cur;
            var new_n = bms * fs;
            var big = old_n;
            if (new_n > big) { big = new_n; }
            var xb = load64(st + _SKE_XBUF);
            var xfix = _opus_tmp(big * 8);
            var i = 0;
            while (i < old_n) { store64(xfix + i * 8, silk_sat16(_sk_lrint(load64(xb + i * 8)))); i = i + 1; }
            var tmp = _sk_dec_resampler_new(silk_smulbb(cur, 1000), api);
            var api_n = bms * (api / 1000);
            var xapi = _opus_tmp(api_n * 8);
            _sk_dec_resample(tmp, xapi, xfix, old_n);
            silk_enc_resampler_init(rs, api, silk_smulbb(fs, 1000));
            silk_enc_resample(rs, xfix, xapi, api_n);
            i = 0;
            while (i < new_n) { store64(xb + i * 8, f64_from(load64(xfix + i * 8))); i = i + 1; }
        }
    }
    store64(st + _SKE_PREV_API_HZ, api);
    return 0;
}

# silk_control_encoder for one channel, once a packet: force_fs (the side
# channel's, from the mid) overrides the rate the state machine picks.
fn _sk_control_encoder(e, st, rs, force_fs) {
    store64(st + _SKE_USE_DTX, load64(e + _SKX_DTX));
    store64(st + _SKE_USE_CBR, load64(e + _SKX_CBR));
    var fs = _sk_control_audio_bandwidth(e, st);
    if (force_fs != 0) { fs = force_fs; }
    _sk_setup_resamplers(st, rs, load64(e + _SKX_API_HZ), fs);
    _sk_setup_fs(st, fs, load64(e + _SKX_MS));
    silk_enc_setup_complexity(st, load64(e + _SKX_COMPLEXITY));
    store64(st + _SKE_PACKET_LOSS, load64(e + _SKX_LOSS));
    _sk_setup_lbrr(st, load64(e + _SKX_FEC));
    return 0;
}

# silk_Transition_LP_B_Q28 / _A_Q28 (tables_other.c): five elliptic low-passes
# from the full band down, which the transition interpolates between.
var _sk_lp_b = 0;
var _sk_lp_a = 0;

# silk_biquad_alt_stride1 (biquad_alt.c): direct form II transposed, the AR
# coefficients split into 14-bit halves; in place allowed.
fn _sk_biquad_alt(inp, B, A, S, out, len) {
    var a0n = 0 - load64(A);
    var a1n = 0 - load64(A + 8);
    var a0l = a0n & 0x3FFF;
    var a0u = sar(a0n, 14);
    var a1l = a1n & 0x3FFF;
    var a1u = sar(a1n, 14);
    var k = 0;
    while (k < len) {
        var v = load64(inp + k * 8);
        var o = silk_sx32(silk_smlawb(load64(S), load64(B), v) << 2);
        var s0 = silk_sx32(load64(S + 8) + silk_rshift_round(silk_smulwb(o, a0l), 14));
        s0 = silk_smlawb(s0, o, a0u);
        s0 = silk_smlawb(s0, load64(B + 8), v);
        store64(S, s0);
        var s1 = silk_rshift_round(silk_smulwb(o, a1l), 14);
        s1 = silk_smlawb(s1, o, a1u);
        s1 = silk_smlawb(s1, load64(B + 16), v);
        store64(S + 8, s1);
        store64(out + k * 8, silk_sat16(sar(o + 16383, 14)));
        k = k + 1;
    }
    return 0;
}

# silk_LP_variable_cutoff: while a transition runs (mode nonzero), the frame
# (int16 words, in place) through the low-pass interpolated at the
# transition's point, which then moves a step.
fn _sk_lp_variable_cutoff(st, frame, len) {
    var mode = load64(st + _SKE_LP_MODE);
    if (mode == 0) { return 0; }
    if (_sk_lp_b == 0) {
        _sk_lp_b = _sk_ints("250767114,501534038,250767114,209867381,419732057,209867381,170987846,341967853,170987846,131531482,263046905,131531482,89306658,178584282,89306658", 15);
        _sk_lp_a = _sk_ints("506393414,239854379,411067935,169683996,306733530,116694253,185807084,77959395,35497197,57401098", 10);
    }
    var tfn = load64(st + _SKE_LP_TFN);
    var fac = silk_sx32((256 - tfn) << 10);                                  # TRANSITION_INT_STEPS 64
    var ind = sar(fac, 16);
    fac = fac - (ind << 16);
    var B = _opus_tmp(3 * 8);
    var A = _opus_tmp(2 * 8);
    var j = 0;
    if (ind < 4) {
        if (fac > 0) {
            if (fac < 32768) {
                while (j < 3) {
                    var b0 = load64(_sk_lp_b + (ind * 3 + j) * 8);
                    store64(B + j * 8, silk_smlawb(b0, load64(_sk_lp_b + ((ind + 1) * 3 + j) * 8) - b0, fac));
                    j = j + 1;
                }
                j = 0;
                while (j < 2) {
                    var a0 = load64(_sk_lp_a + (ind * 2 + j) * 8);
                    store64(A + j * 8, silk_smlawb(a0, load64(_sk_lp_a + ((ind + 1) * 2 + j) * 8) - a0, fac));
                    j = j + 1;
                }
            } else {
                while (j < 3) {
                    var b1 = load64(_sk_lp_b + ((ind + 1) * 3 + j) * 8);
                    store64(B + j * 8, silk_smlawb(b1, b1 - load64(_sk_lp_b + (ind * 3 + j) * 8), fac - 65536));
                    j = j + 1;
                }
                j = 0;
                while (j < 2) {
                    var a1 = load64(_sk_lp_a + ((ind + 1) * 2 + j) * 8);
                    store64(A + j * 8, silk_smlawb(a1, a1 - load64(_sk_lp_a + (ind * 2 + j) * 8), fac - 65536));
                    j = j + 1;
                }
            }
        } else {
            _sk_copy_words(B, _sk_lp_b + ind * 3 * 8, 3);
            _sk_copy_words(A, _sk_lp_a + ind * 2 * 8, 2);
        }
    } else {
        _sk_copy_words(B, _sk_lp_b + 12 * 8, 3);
        _sk_copy_words(A, _sk_lp_a + 8 * 8, 2);
    }
    var nt = tfn + mode;
    if (nt < 0) { nt = 0; }
    if (nt > 256) { nt = 256; }
    store64(st + _SKE_LP_TFN, nt);
    _sk_biquad_alt(frame, B, A, st + _SKE_LP_STATE, frame, len);
    return 0;
}

# The side channel's reset for its first coded frame after mid-only ones
# (silk_Encode): shaping, quantiser and NLSF history as at the start.
fn _sk_side_reset(st) {
    store64(st + _SKE_LAST_GAIN, 10);
    store64(st + _SKE_HARM_SMTH, F64_ZERO);
    store64(st + _SKE_TILT_SMTH, F64_ZERO);
    _sk_nsq_init(load64(st + _SKE_NSQ));
    memset(st + _SKE_PREV_NLSF, 0, 16 * 8);
    store64(st + _SKE_PREV_LAG, 100);
    store64(st + _SKE_PREV_SIGNAL, 0);
    store64(st + _SKE_FIRST, 1);
    return 0;
}

# silk_setup_LBRR (control_codec.c), per channel and packet.
fn _sk_setup_lbrr(st, fec) {
    var before = load64(st + _SKE_LBRR_ENABLED);
    store64(st + _SKE_LBRR_ENABLED, fec);
    if (fec == 1) {
        var inc = 7;
        if (before != 0) {
            inc = 7 - silk_smulwb(load64(st + _SKE_PACKET_LOSS), 13107);      # SILK_FIX_CONST(0.2, 16)
            if (inc < 3) { inc = 3; }
        }
        store64(st + _SKE_LBRR_GAIN_INC, inc);
    }
    return 0;
}

# silk_Encode: one packet's frames into ec, the flags reserved at the front
# and patched in at the end. The input is resampled from the API rate a frame
# at a time; the first frame carries the previous packet's LBRR frames ahead
# of its own. Stereo (2.12.2): each frame's left and right become mid and
# side (silk_stereo_lr_to_ms), the predictors and the mid-only flag coded
# ahead of the mid's frame, the side's after it unless the frame codes the
# mid alone. maxBits: the packet's budget; rate: the payload's bit rate.
# Returns the payload's bytes, 0 for a packet DTX leaves out.
fn _silk_encode_packet(e, pcm, ec, maxBits, rate) {
    var st = load64(e + _SKX_ST);
    var st1 = load64(e + _SKX_ST1);
    var stst = load64(e + _SKX_STEREO);
    var ctrl = load64(e + _SKX_CTRL);
    var ms = load64(e + _SKX_MS);
    var api_k = load64(e + _SKX_API_HZ) / 1000;
    var x16 = load64(e + _SKX_X16);
    var x16b = load64(e + _SKX_X16B);
    var inb = load64(e + _SKX_INBUF);
    var inb1 = load64(e + _SKX_INBUF1);
    var rs = load64(e + _SKX_RS);
    var rs1 = load64(e + _SKX_RS1);
    var cha = load64(e + _SKX_CH_API);
    var nch = load64(e + _SKX_CH_INT);
    # every packet coded as a first one (reducedDependency)
    if (load64(e + _SKX_REDUCED_DEP) == 1) {
        store64(st + _SKE_FIRST, 1);
        if (cha == 2) { store64(st1 + _SKE_FIRST, 1); }
    }
    store64(st + _SKE_NFRAMES_ENC, 0);
    if (cha == 2) { store64(st1 + _SKE_NFRAMES_ENC, 0); }
    store64(e + _SKX_SWITCH_READY, 0);
    # mono to stereo: the side channel and the stereo state start afresh, the
    # side's resampler from the mid's
    var cur = load64(e + _SKX_CUR_CH_INT);
    if (nch > cur) {
        silk_enc_state_reset(st1);
        memset(stst + _SKST_PRED_PREV, 0, 2 * 8);
        memset(stst + _SKST_SSIDE, 0, 2 * 8);
        store64(stst + _SKST_AMP, 0);
        store64(stst + _SKST_AMP + 8, 1);
        store64(stst + _SKST_AMP + 16, 0);
        store64(stst + _SKST_AMP + 24, 1);
        store64(stst + _SKST_WIDTH_PREV, 0);
        store64(stst + _SKST_SMTH_WIDTH, 16384);
        memcpy(rs1, rs, _SKRS_SIZE);
    }
    var transition = 0;
    if (ms != load64(st + _SKE_PACKET_MS) || cur != nch) { transition = 1; }
    store64(e + _SKX_CUR_CH_INT, nch);
    # silk_control_encoder, once a packet and channel: the side at the mid's rate
    store64(e + _SKX_MAX_BITS_OUT, maxBits);
    var n = 0;
    var i = 0;
    while (n < nch) {
        var sc = st;
        var rsc = rs;
        var force = 0;
        if (n == 1) { sc = st1; rsc = rs1; force = load64(st + _SKE_FS_KHZ); }
        _sk_control_encoder(e, sc, rsc, force);
        if (load64(sc + _SKE_FIRST) == 1 || transition == 1) {
            i = 0;
            while (i < load64(st + _SKE_NFRAMES_PP)) { store64(sc + _SKE_LBRR_FLAGS + i * 8, 0); i = i + 1; }
        }
        store64(sc + _SKE_INDTX, load64(sc + _SKE_USE_DTX));
        n = n + 1;
    }
    maxBits = load64(e + _SKX_MAX_BITS_OUT);
    var fl = load64(st + _SKE_FRAME_LEN);
    var nb = load64(st + _SKE_NB_SUBFR);
    var fs = load64(st + _SKE_FS_KHZ);
    var nfr = load64(st + _SKE_NFRAMES_PP);
    store64(e + _SKX_NFRAMES, nfr);
    if (nfr == 2) { store64(e + _SKX_LBRR_ICDF, load64(e + _SKX_LBRR_ICDF2)); }
    if (nfr == 3) { store64(e + _SKX_LBRR_ICDF, load64(e + _SKX_LBRR_ICDF3)); }
    var fla = fl / fs * api_k;
    var ns = fla * nfr;
    if (cha == 1) {
        i = 0;
        while (i < ns) { store64(x16 + i * 8, _sk_float2int16(load64(pcm + i * 8))); i = i + 1; }
    } else {
        if (nch == 2) {
            i = 0;
            while (i < ns) {
                store64(x16 + i * 8, _sk_float2int16(load64(pcm + 2 * i * 8)));
                store64(x16b + i * 8, _sk_float2int16(load64(pcm + (2 * i + 1) * 8)));
                i = i + 1;
            }
        } else {
            # the channels summed as floats, then halved
            i = 0;
            while (i < ns) {
                var sum = _sk_float2int16(f64_add(_sk_f32(load64(pcm + 2 * i * 8)), _sk_f32(load64(pcm + (2 * i + 1) * 8))));
                store64(x16 + i * 8, _i16(silk_rshift_round(sum, 1)));
                i = i + 1;
            }
        }
    }
    var prevch = load64(e + _SKX_PREV_CH_INT);
    var tot_blocks = 1;
    if (ms / 10 > 1) { tot_blocks = (ms / 10) >> 1; }
    var nBytes = 0;
    var f = 0;
    while (f < nfr) {
        if (nch == 2) {
            if (prevch == 1 && f == 0) { memcpy(rs1, rs, _SKRS_SIZE); }
            silk_enc_resample(rs, inb + 16, x16 + f * fla * 8, fla);
            silk_enc_resample(rs1, inb1 + 16, x16b + f * fla * 8, fla);
        } else {
            silk_enc_resample(rs, inb + 16, x16 + f * fla * 8, fla);
            # the first mono frame after stereo: the average of both resamplers
            if (prevch == 2 && f == 0) {
                silk_enc_resample(rs1, inb1 + 16, x16 + f * fla * 8, fla);
                i = 0;
                while (i < fl) {
                    store64(inb + (i + 2) * 8, sar(load64(inb + (i + 2) * 8) + load64(inb1 + (i + 2) * 8), 1));
                    i = i + 1;
                }
            }
        }
        store64(e + _SKX_ALLOW_SWITCH, 0);
        var lbrr_bits = 0;
        if (f == 0) {
            var icdf = load64(e + _SKX_ICDF);
            store8(icdf, 256 - (256 >> ((nfr + 1) * nch)));
            ec_enc_icdf(ec, 0, icdf, 8);
            var t0 = ec_tell(ec);
            # the previous packet's LBRR frames: each channel's flags, then
            # frame by frame each channel's
            n = 0;
            while (n < nch) {
                var sl = st;
                if (n == 1) { sl = st1; }
                var sym = 0;
                i = 0;
                while (i < nfr) { sym = sym | (load64(sl + _SKE_LBRR_FLAGS + i * 8) << i); i = i + 1; }
                var lf = 0;
                if (sym > 0) { lf = 1; }
                store64(sl + _SKE_LBRR_FLAG, lf);
                if (sym > 0 && nfr > 1) { ec_enc_icdf(ec, sym - 1, load64(e + _SKX_LBRR_ICDF), 8); }
                n = n + 1;
            }
            i = 0;
            while (i < nfr) {
                n = 0;
                while (n < nch) {
                    var sb = st;
                    if (n == 1) { sb = st1; }
                    if (load64(sb + _SKE_LBRR_FLAGS + i * 8) == 1) {
                        if (nch == 2 && n == 0) {
                            silk_stereo_encode_pred(ec, stst + _SKST_PREDIX + i * 48);
                            if (load64(st1 + _SKE_LBRR_FLAGS + i * 8) == 0) {
                                silk_stereo_encode_mid_only(ec, load64(stst + _SKST_MID_ONLY + i * 8));
                            }
                        }
                        var lc = 0;
                        if (i > 0) { if (load64(sb + _SKE_LBRR_FLAGS + (i - 1) * 8) == 1) { lc = 2; } }
                        var li = load64(sb + _SKE_LBRR_IDX) + i * 64 * 8;
                        silk_encode_indices_ec(ec, fs, li, nb, lc, sb + _SKE_ECPREV);
                        silk_encode_pulses(ec, load64(li + _SKI_SIGNAL_TYPE * 8), load64(li + _SKI_QUANT_OFFSET * 8),
                          load64(sb + _SKE_LBRR_PULSES) + i * 320 * 8, fl);
                    }
                    n = n + 1;
                }
                i = i + 1;
            }
            n = 0;
            while (n < nch) {
                var sz = st;
                if (n == 1) { sz = st1; }
                i = 0;
                while (i < 3) { store64(sz + _SKE_LBRR_FLAGS + i * 8, 0); i = i + 1; }
                n = n + 1;
            }
            lbrr_bits = ec_tell(ec) - t0;
        }
        silk_hp_variable_cutoff(st);
        # the frame's bit target: its share of the packet less the LBRR frames'
        # bits (a running average; libopus counts a packet's LBRR bits for its
        # first frame only, the rest see them as overshoot), less a fiftieth
        # of a second's worth of the reservoir's excess and of this packet's
        # overshoot so far, between 5 kbit/s and the bit rate
        var nBits = (rate * ms) / 1000;
        var avg = load64(e + _SKX_NBITS_LBRR);
        if (lbrr_bits < 10) { avg = 0; }
        else {
            if (avg < 10) { avg = lbrr_bits; } else { avg = (avg + lbrr_bits) / 2; }
        }
        store64(e + _SKX_NBITS_LBRR, avg);
        nBits = silk_div_trunc(nBits - avg, nfr);
        var target = silk_smulbb(nBits, 50);
        if (ms == 10) { target = silk_smulbb(nBits, 100); }
        target = target - (load64(e + _SKX_EXCEEDED) * 1000) / 500;
        if (f > 0) {
            var bal = ec_tell(ec) - avg - nBits * f;
            target = target - silk_div_trunc(bal * 1000, 500);
        }
        var lo = 5000;
        var hi = rate;
        if (lo > hi) { lo = rate; hi = 5000; }
        if (target > hi) { target = hi; }
        if (target < lo) { target = lo; }
        if (nch == 2) {
            # left/right to mid/side, the predictors and the flag ahead of the mid
            var pix = stst + _SKST_PREDIX + f * 48;
            var mo = stst + _SKST_MID_ONLY + f * 8;
            silk_stereo_lr_to_ms(stst, e + _SKX_SMID, inb + 16, inb1 + 16, pix, mo, e + _SKX_RATES, target,
              load64(st + _SKE_SPEECH_Q8), load64(e + _SKX_TO_MONO), fs, fl);
            if (load64(mo) == 0) {
                if (load64(e + _SKX_PREV_MID_ONLY) == 1) { _sk_side_reset(st1); }
                store64(st1 + _SKE_NFRAMES_ENC, f);
                silk_encode_do_vad(st1, inb1 + 8, load64(e + _SKX_ACTIVITY));
            } else {
                store64(st1 + _SKE_VAD_FLAGS + f * 8, 0);
            }
            silk_stereo_encode_pred(ec, pix);
            if (load64(st1 + _SKE_VAD_FLAGS + f * 8) == 0) { silk_stereo_encode_mid_only(ec, load64(mo)); }
        } else {
            # mono buffering: the frame starts one sample back
            store64(inb, load64(e + _SKX_SMID));
            store64(inb + 8, load64(e + _SKX_SMID + 8));
            store64(e + _SKX_SMID, load64(inb + fl * 8));
            store64(e + _SKX_SMID + 8, load64(inb + (fl + 1) * 8));
        }
        store64(st + _SKE_NFRAMES_ENC, f);
        silk_encode_do_vad(st, inb + 8, load64(e + _SKX_ACTIVITY));
        n = 0;
        while (n < nch) {
            var se = st;
            var xe = inb;
            if (n == 1) { se = st1; xe = inb1; }
            var mb = maxBits;
            if (tot_blocks == 2 && f == 0) { mb = mb * 3 / 5; }
            if (tot_blocks == 3) {
                if (f == 0) { mb = mb * 2 / 5; }
                if (f == 1) { mb = mb * 3 / 4; }
            }
            var useCBR = 0;
            if (load64(e + _SKX_CBR) == 1 && f == tot_blocks - 1) { useCBR = 1; }
            var crate = target;
            if (nch == 2) {
                crate = load64(e + _SKX_RATES + n * 8);
                # the mid gets up to half the frame's bits
                if (n == 0 && load64(e + _SKX_RATES + 8) > 0) {
                    useCBR = 0;
                    mb = mb - maxBits / (tot_blocks * 2);
                }
            }
            if (crate > 0) {
                silk_control_snr(se, crate);
                # a side frame after mid-only ones needs no LTP scaling
                var cond = 2;
                if (f == 0) { cond = 0; }
                else { if (n > 0 && load64(e + _SKX_PREV_MID_ONLY) == 1) { cond = 1; } }
                _sk_zero(ctrl, _SKC_SIZE);
                store64(se + _SKE_NFRAMES_ENC, f);
                nBytes = silk_encode_frame_flp(se, ctrl, ec, xe + 8, cond, mb, useCBR);
            }
            n = n + 1;
        }
        var pmo = 0;
        if (stst != 0) { pmo = load64(stst + _SKST_MID_ONLY + f * 8); }
        store64(e + _SKX_PREV_MID_ONLY, pmo);
        f = f + 1;
    }
    store64(st + _SKE_NFRAMES_ENC, nfr);
    if (nch == 2) { store64(st1 + _SKE_NFRAMES_ENC, nfr); }
    if (nBytes > 0) {
        var flags = 0;
        n = 0;
        while (n < nch) {
            var sf = st;
            if (n == 1) { sf = st1; }
            i = 0;
            while (i < nfr) { flags = (flags << 1) | load64(sf + _SKE_VAD_FLAGS + i * 8); i = i + 1; }
            flags = (flags << 1) | load64(sf + _SKE_LBRR_FLAG);
            n = n + 1;
        }
        ec_enc_patch_initial_bits(ec, flags, (nfr + 1) * nch);
        if (load64(st + _SKE_INDTX) == 1) {
            if (nch == 1) { nBytes = 0; }
            else { if (load64(st1 + _SKE_INDTX) == 1) { nBytes = 0; } }
        }
        var ex = load64(e + _SKX_EXCEEDED) + nBytes * 8 - (rate * ms) / 1000;
        if (ex < 0) { ex = 0; }
        if (ex > 10000) { ex = 10000; }
        store64(e + _SKX_EXCEEDED, ex);
        # a bandwidth switch is allowed while speech activity stays low, the
        # more readily the longer since the last one could be (to 5 s)
        var thr = silk_smlawb(13, 3188, load64(e + _SKX_TIME_SINCE_SWITCH));   # 0.05 Q8; 0.95 / 5000 Q24
        if (load64(st + _SKE_SPEECH_Q8) < thr) {
            store64(e + _SKX_ALLOW_SWITCH, 1);
            store64(e + _SKX_TIME_SINCE_SWITCH, 0);
        } else {
            store64(e + _SKX_ALLOW_SWITCH, 0);
            store64(e + _SKX_TIME_SINCE_SWITCH, load64(e + _SKX_TIME_SINCE_SWITCH) + ms);
        }
    }
    store64(e + _SKX_PREV_CH_INT, nch);
    return nBytes;
}

# The scratch of one packet comes from the Opus arena, reset per packet, so a
# long encode allocates nothing per frame; nested in a caller's frame, it
# shares that one.
fn _silk_encode_coded(e, pcm, buf, storage, maxBits, rate) {
    var outer = _opus_in_frame;
    if (outer == 0) { _opus_frame_begin(); }
    var ec = ec_enc_init(load64(e + _SKX_EC), buf, storage);
    var n = _silk_encode_packet(e, pcm, ec, maxBits, rate);
    ec_enc_done(ec);
    var bad = 0;
    if (load64(ec + 88) != 0) { bad = 1; }
    if (ec_tell(ec) > storage * 8) { bad = 1; }
    if (outer == 0) { _opus_frame_end(); }
    if (bad == 1) { return err(ERR_ENCODE); }
    return n;
}

# silk_encode: one packet of pcm (silk_encoder_samples f64 samples, -1..1) as a
# SILK payload into out (what silk_Encode and ec_enc_done write, no TOC).
# Budget: under CBR the bit rate's share of the packet, otherwise the buffer
# (to 1275 bytes). The rate loop can still bust it, as libopus's can. Returns
# the payload's length, or ERR_ENCODE when it does not fit in cap (nothing is
# written past cap; the encoder has moved on, and the next packet can follow).
fn silk_encode(e, pcm, out, cap) {
    var storage = cap;
    if (storage > 1275) { storage = 1275; }
    if (storage < 1) { return err(ERR_ENCODE); }
    var maxBits = storage * 8;
    if (load64(e + _SKX_CBR) == 1) {
        maxBits = (load64(e + _SKX_BITRATE) * load64(e + _SKX_MS)) / 1000;
        if (maxBits > storage * 8) { maxBits = storage * 8; }
    }
    return _silk_encode_coded(e, pcm, out, storage, maxBits, load64(e + _SKX_BITRATE));
}

# The Opus TOC of a SILK-only frame (RFC 6716 3.1): configurations 0-3
# narrowband, 4-7 mediumband, 8-11 wideband, by 10, 20, 40, 60 ms; the stereo
# bit when the packet codes two channels; one frame (code 0).
fn _silk_toc(e) {
    var fs = load64(e + _SKX_FS_HZ);
    var cur = load64(load64(e + _SKX_ST) + _SKE_FS_KHZ);
    if (cur != 0) { fs = cur * 1000; }
    var ms = load64(e + _SKX_MS);
    var cfg = 8;
    if (fs == 8000) { cfg = 0; }
    if (fs == 12000) { cfg = 4; }
    var d = 1;
    if (ms == 10) { d = 0; }
    if (ms == 40) { d = 2; }
    if (ms == 60) { d = 3; }
    var s = 0;
    if (load64(e + _SKX_CH_INT) == 2) { s = 4; }
    return ((cfg + d) << 3) | s;
}

# opus_packet_pad for one frame (out + 1, fr bytes) to size bytes: code 3, the
# count byte (one frame, the padding flag when there is padding), the padding
# length (255s, then the rest), the frame, then zeros. The frame only moves
# right, so it is copied from its end, in place.
fn _silk_opus_pad(out, toc, fr, size) {
    var pad = size - (fr + 2);
    var p = 2;
    var n255 = 0;
    if (pad > 0) {
        n255 = (pad - 1) / 255;
        p = 3 + n255;
    }
    var i = fr - 1;
    while (i >= 0) { store8(out + p + i, load8(out + 1 + i)); i = i - 1; }
    store8(out, toc | 3);
    store8(out + 1, 1);
    if (pad > 0) {
        store8(out + 1, 1 | 64);
        i = 0;
        while (i < n255) { store8(out + 2 + i, 255); i = i + 1; }
        store8(out + 2 + n255, pad - 255 * n255 - 1);
    }
    i = p + fr;
    while (i < size) { store8(out + i, 0); i = i + 1; }
    return size;
}

# silk_encode_opus: one packet of pcm as an Opus packet, as libopus's encoder
# makes a SILK-only one. The bit rate counts the whole packet, so the payload
# gets a byte a packet less (bits_target); under CBR the packet is
# (bits + 4) / 8 bytes and the payload gets all of it but the TOC. VBR: the
# TOC, the payload, trailing zero bytes dropped (the range decoder reads them
# back as zeros), at most cap bytes. CBR: padded to its size as
# opus_packet_pad does. Where there is no room for a frame (under 3 bytes,
# under 24 bits a frame, or, for 40 and 60 ms, under 300 bytes or 2.4 kbit/s a
# second) libopus sends the TOC alone and does not run the encoder; a payload
# that busts its budget becomes a single zero byte. Decoders conceal both as
# lost frames (libopus's "PLC" frames). A packet DTX leaves out is the TOC
# alone, under CBR too. Returns the packet's length, or ERR_ENCODE for a cap of
# 0.
fn silk_encode_opus(e, pcm, out, cap) {
    if (cap < 1) { return err(ERR_ENCODE); }
    var size = cap;
    if (size > 1276) { size = 1276; }
    var cbr = load64(e + _SKX_CBR);
    var ms = load64(e + _SKX_MS);
    # bitrate_to_bits / bits_to_bitrate at 6 x the packet rate
    var f6 = 6000 / ms;
    var br = load64(e + _SKX_BITRATE);
    var bits = br * 6 / f6;
    if (cbr == 1) {
        var cb = (bits + 4) / 8;
        if (cb < size) { size = cb; }
        if (size < 1) { size = 1; }
        bits = size * 8;
        br = bits * f6 / 6;
    }
    var toc = _silk_toc(e);
    var fr = 1000 / ms;
    if (size < 3 || br < 24 * fr || (fr < 50 && (size * fr < 300 || br < 2400))) {
        store8(out, toc);
        if (cbr == 1 && size > 1) { return _silk_opus_pad(out, toc, 0, size); }
        return 1;
    }
    if (bits > size * 8) { bits = size * 8; }
    var n = _silk_encode_coded(e, pcm, out + 1, size - 1, (size - 1) * 8, (bits - 8) * f6 / 6);
    store8(out, toc);
    # DTX: the TOC alone, unpadded even under CBR (opus_encode returns early)
    if (n == 0) { return 1; }
    if (is_err(n) == 1) {
        store8(out + 1, 0);
        n = 1;
    }
    while (n > 2 && load8(out + n) == 0) { n = n - 1; }
    if (cbr == 0 || n + 1 == size) { return n + 1; }
    return _silk_opus_pad(out, toc, n, size);
}
