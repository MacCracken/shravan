# ================================================================
# Benchmark: aac_encode_1sec_stereo / aac_decode_1sec_stereo
# ================================================================
# AAC encode is the heaviest path in the library and had no coverage. It matters
# from 2.7.2 on, when per-band M/S, intensity and PNS each added a pass over the
# spectrum before quantization — this is what says whether those decisions cost
# anything measurable.

fn _bench_aac_signal() {
    var samples = vec_new();
    var two_pi = f64_mul(F64_TWO, f64_mul(f64_from(3), f64_add(F64_ONE, f64_div(f64_from(47197), f64_from(100000)))));
    var F64_44100 = f64_from(44100);
    for (var i = 0; i < 44100; i = i + 1) {
        var ph = f64_div(f64_mul(two_pi, f64_from(i)), F64_44100);
        # Low tone shared by both channels, high tone scaled in the right: gives
        # the M/S, intensity and PNS decisions something real to chew on.
        var lo = f64_mul(f64_sin(f64_mul(ph, f64_from(440))), f64_div(F64_ONE, F64_TWO));
        var hi = f64_mul(f64_sin(f64_mul(ph, f64_from(9000))), f64_div(F64_ONE, f64_from(5)));
        vec_push(samples, f64_add(lo, hi));
        vec_push(samples, f64_add(lo, f64_mul(hi, F64_HALF)));
    }
    return samples;
}

fn bench_aac_encode_1sec() {
    var samples = _bench_aac_signal();
    var buf = alloc(1048576);
    aac_encode(samples, 44100, 2, 128000, buf);   # warm the tables

    var iters = 3;
    bench("aac_encode_1sec_stereo", iters);
    var t0 = time_now_ns();
    for (var it = 0; it < iters; it = it + 1) {
        aac_encode(samples, 44100, 2, 128000, buf);
    }
    var t1 = time_now_ns();
    return bench_report(t1 - t0, iters);
}

fn bench_aac_decode_1sec() {
    var samples = _bench_aac_signal();
    var buf = alloc(1048576);
    var asize = aac_encode(samples, 44100, 2, 128000, buf);

    var iters = 3;
    bench("aac_decode_1sec_stereo", iters);
    var t0 = time_now_ns();
    for (var it = 0; it < iters; it = it + 1) { aac_decode(buf, asize); }
    var t1 = time_now_ns();
    return bench_report(t1 - t0, iters);
}

# ================================================================
# Benchmark: opus_celt_decode_20ms
# ================================================================
# The Opus decode path had no benchmark, and 2.7.3 added a per-packet framing
# pre-scan plus a frame loop around the dispatch. This measures the CELT-only
# fullband 20 ms decode, the hot path for CELT and hybrid alike.

fn bench_opus_celt_decode() {
    var N = 960;
    var pcmin = alloc(N * 8);
    var two_pi = f64_mul(F64_TWO, f64_mul(f64_from(3), f64_add(F64_ONE, f64_div(f64_from(47197), f64_from(100000)))));
    for (var i = 0; i < N; i = i + 1) {
        var ph = f64_div(f64_mul(two_pi, f64_from(i)), f64_from(48000));
        var v = f64_add(f64_mul(f64_sin(f64_mul(ph, f64_from(440))), f64_div(F64_ONE, F64_TWO)),
          f64_mul(f64_sin(f64_mul(ph, f64_from(3300))), f64_div(F64_ONE, f64_from(5))));
        store64(pcmin + i * 8, v);
    }
    # celt_encode wants the frame plus 120 samples of lookahead.
    var pcmw = alloc((N + 120) * 8);
    for (var k = 0; k < N + 120; k = k + 1) {
        store64(pcmw + k * 8, load64(pcmin + (k % N) * 8));
    }
    var pkt = alloc(4096);
    var plen = 160;
    var enc = ec_enc_new(pkt, plen);
    var est = celt_dec_state_new();   # the encoder shares the CELT state layout
    var mem = alloc(8); store64(mem, 0);
    celt_encode(est, enc, pcmw, 1, 3, 0, 0, mem);
    ec_enc_done(enc);

    var out = alloc(2 * N * 8);
    var st = celt_dec_state_new();
    celt_decode_frame(st, pkt, plen, 1, out);      # warm the tables

    var iters = 200;
    bench("opus_celt_decode_20ms", iters);
    var t0 = time_now_ns();
    for (var it = 0; it < iters; it = it + 1) {
        celt_decode_frame(st, pkt, plen, 1, out);
    }
    var t1 = time_now_ns();
    return bench_report(t1 - t0, iters);
}

# The CELT encoder on the same 20 ms mono frame: its forward MDCT runs on the
# FFT the decoder's inverse does (2.10.4).
fn bench_opus_celt_encode() {
    var N = 960;
    var pcmw = alloc((N + 120) * 8);
    var two_pi = f64_mul(F64_TWO, f64_mul(f64_from(3), f64_add(F64_ONE, f64_div(f64_from(47197), f64_from(100000)))));
    for (var k = 0; k < N + 120; k = k + 1) {
        var ph = f64_div(f64_mul(two_pi, f64_from(k % N)), f64_from(48000));
        var v = f64_add(f64_mul(f64_sin(f64_mul(ph, f64_from(440))), f64_div(F64_ONE, F64_TWO)),
          f64_mul(f64_sin(f64_mul(ph, f64_from(3300))), f64_div(F64_ONE, f64_from(5))));
        store64(pcmw + k * 8, v);
    }
    var pkt = alloc(4096);
    var est = celt_dec_state_new();   # the encoder shares the CELT state layout
    var mem = alloc(8); store64(mem, 0);
    var enc = ec_enc_new(pkt, 160);
    celt_encode(est, enc, pcmw, 1, 3, 0, 0, mem);     # warm the tables
    ec_enc_done(enc);

    var iters = 50;
    bench("opus_celt_encode_20ms", iters);
    var t0 = time_now_ns();
    for (var it = 0; it < iters; it = it + 1) {
        var e = ec_enc_new(pkt, 160);
        celt_encode(est, e, pcmw, 1, 3, 0, 0, mem);
        ec_enc_done(e);
    }
    var t1 = time_now_ns();
    return bench_report(t1 - t0, iters);
}

# SILK encoder LPC analysis (2.11.0): the unvoiced find_pred_coefs (Burg, NLSF
# interpolation search, NLSF quantisation, residual energies) on a 20 ms
# wideband frame of the reference vectors, at complexity 5 (frame 6: interpolation on).
fn _bench_skv_frame(k, hdr, x, gains, cq, prev) {
    _bench_skv_ints(_SKV_HDR, k, hdr);
    _bench_skv_ints(_SKV_X, k, x);
    _bench_skv_ints(_SKV_GAINS, k, gains);
    _bench_skv_ints(_SKV_CQ, k, cq);
    _bench_skv_ints(_SKV_PREV, k, prev);
    return 0;
}

# Frame k of a vector field (src/silk_enc_vectors.cyr: one zlib stream in
# base64 of the segment count, the segments' lengths and the segments, one a
# frame) into i64 words, ints sign-extended. Each field is inflated once.
var _bench_skv_cs = 0;
var _bench_skv_cb = 0;
var _bench_skv_cn = 0;
fn _bench_skv_ints(s, k, out) {
    if (_bench_skv_cs == 0) { _bench_skv_cs = alloc(64 * 8); _bench_skv_cb = alloc(64 * 8); }
    var z = 0;
    var c = 0;
    while (c < _bench_skv_cn) {
        if (load64(_bench_skv_cs + c * 8) == s) { z = load64(_bench_skv_cb + c * 8); }
        c = c + 1;
    }
    if (z == 0) {
        var t = alloc(strlen(s) + 8);
        var nb = _mp3_b64_decode(s, t);
        z = alloc(1 << 20);
        if (zlib_decompress_capped(t, nb, z, 1 << 20, 1 << 20) < 4) { return 0; }
        if (_bench_skv_cn < 64) {
            store64(_bench_skv_cs + _bench_skv_cn * 8, s);
            store64(_bench_skv_cb + _bench_skv_cn * 8, z);
            _bench_skv_cn = _bench_skv_cn + 1;
        }
    }
    var off = 4 + 4 * read_u32_le(z, 0);
    var j = 0;
    while (j < k) { off = off + read_u32_le(z, 4 + 4 * j); j = j + 1; }
    var n = read_u32_le(z, 4 + 4 * k) / 4;
    var i = 0;
    while (i < n) { store64(out + i * 8, silk_sx32(read_u32_le(z, off + i * 4))); i = i + 1; }
    return n;
}

fn bench_silk_lpc_analysis() {
    var hdr = alloc(16 * 8);
    var x = alloc(512 * 8);
    var gains = alloc(8 * 8);
    var cq = alloc(8);
    var prev = alloc(32 * 8);
    # the first complexity-5 wideband frame that interpolates
    var k = 0;
    var found = 0 - 1;
    while (k < _SKV_N && found < 0) {
        _bench_skv_ints(_SKV_HDR, k, hdr);
        if (load64(hdr + 56) == 16 && load64(hdr + 8) == 4 && load64(hdr + 72) < 4) { found = k; }
        k = k + 1;
    }
    _bench_skv_frame(found, hdr, x, gains, cq, prev);
    var n = 4 * 80 + 16;
    var i = 0;
    while (i < n) { store64(x + i * 8, f32_to(load64(x + i * 8) & 0xFFFFFFFF)); i = i + 1; }
    i = 0;
    while (i < 4) { store64(gains + i * 8, f32_to(load64(gains + i * 8) & 0xFFFFFFFF)); i = i + 1; }
    var iters = 50;
    bench("silk_lpc_analysis_20ms_wb", iters);
    var t0 = time_now_ns();
    for (var it = 0; it < iters; it = it + 1) {
        var st = silk_enc_state_new(16, 4);
        store64(st + _SKE_USE_INTERP, 1);
        store64(st + _SKE_FIRST, 0);
        store64(st + _SKE_SURVIVORS, load64(hdr + 48));
        store64(st + _SKE_SPEECH_Q8, load64(hdr + 64));
        var j = 0;
        while (j < 16) { store64(st + _SKE_PREV_NLSF + j * 8, load64(prev + j * 8)); j = j + 1; }
        var c = silk_enc_ctrl_new();
        j = 0;
        while (j < 4) { store64(c + _SKC_GAINS + j * 8, load64(gains + j * 8)); j = j + 1; }
        store64(c + _SKC_CODING_QUALITY, f32_to(load64(cq) & 0xFFFFFFFF));
        _opus_frame_begin();
        silk_find_pred_coefs_flp(st, c, 0, x + 16 * 8, 0);
        _opus_frame_end();
    }
    var t1 = time_now_ns();
    return bench_report(t1 - t0, iters);
}

# 2.11.1: the VAD on a 20 ms wideband frame, and noise shaping analysis (16th
# order filters over 4 windowed subframes) on one, from the reference vectors.
fn bench_silk_vad() {
    var seq = alloc(16 * 8);
    _bench_skv_ints(_SKA_SEQ, 0, seq);
    var x = alloc(1024 * 8);
    _bench_skv_ints(_SKA_IN, 5, x);
    var st = silk_enc_state_new(load64(seq + 8), 4);
    var iters = 200;
    bench("silk_vad_20ms_wb", iters);
    var t0 = time_now_ns();
    for (var it = 0; it < iters; it = it + 1) {
        store64(st + _SKE_NFRAMES_ENC, 0);
        _opus_frame_begin();
        silk_encode_do_vad(st, x, 0 - 1);
        _opus_frame_end();
    }
    var t1 = time_now_ns();
    return bench_report(t1 - t0, iters);
}

fn bench_silk_noise_shape() {
    var h = alloc(64 * 8);
    var k = 0;
    var found = 0 - 1;
    while (k < _SKS_N && found < 0) {
        _bench_skv_ints(_SKS_NSA_HDR, k, h);
        if (load64(h + 32) == 16 && load64(h + 40) == 4) { found = k; }
        k = k + 1;
    }
    _bench_skv_ints(_SKS_NSA_HDR, found, h);
    var x = alloc(1024 * 8);
    var r = alloc(1024 * 8);
    var v = alloc(64 * 8);
    var nx = _bench_skv_ints(_SKS_NSA_X, found, x);
    var nr = _bench_skv_ints(_SKS_NSA_RES, found, r);
    _bench_skv_ints(_SKS_NSA_IN, found, v);
    var i = 0;
    while (i < nx) { store64(x + i * 8, f32_to(load64(x + i * 8) & 0xFFFFFFFF)); i = i + 1; }
    i = 0;
    while (i < nr) { store64(r + i * 8, f32_to(load64(r + i * 8) & 0xFFFFFFFF)); i = i + 1; }
    var st = silk_enc_state_new(16, 4);
    store64(st + _SKE_SNR_Q7, load64(h)); store64(st + _SKE_SPEECH_Q8, load64(h + 8));
    _ske_set_idx(st, _SKI_SIGNAL_TYPE, load64(h + 24));
    store64(st + _SKE_SHAPE_WIN, load64(h + 56)); store64(st + _SKE_SHAPE_ORDER, load64(h + 64));
    store64(st + _SKE_LA_SHAPE, load64(h + 72)); store64(st + _SKE_WARPING_Q16, load64(h + 80));
    i = 0;
    while (i < 4) { store64(st + _SKE_QUALITY + i * 8, load64(h + (11 + i) * 8)); i = i + 1; }
    var la = load64(h + 72);
    var c = silk_enc_ctrl_new();
    store64(c + _SKC_PRED_GAIN, f32_to(load64(v) & 0xFFFFFFFF));
    var iters = 100;
    bench("silk_noise_shape_20ms_wb", iters);
    var t0 = time_now_ns();
    for (var it = 0; it < iters; it = it + 1) {
        _opus_frame_begin();
        silk_noise_shape_analysis_flp(st, c, r, x + la * 8);
        _opus_frame_end();
    }
    var t1 = time_now_ns();
    return bench_report(t1 - t0, iters);
}

# 2.11.2: the noise shaping quantiser on a voiced 20 ms wideband frame (LTP,
# re-whitening) from the reference vectors.
fn bench_silk_nsq() {
    var h = alloc(16 * 8);
    var k = 0;
    var found = 0 - 1;
    while (k < _SKQ_N && found < 0) {
        _bench_skv_ints(_SKQ_HDR, k, h);
        if (load64(h + 8) == 320 && load64(h + 56) == 2) { found = k; }
        k = k + 1;
    }
    _bench_skv_ints(_SKQ_HDR, found, h);
    var nb = load64(h + 24);
    var so = load64(h + 32);
    var st = silk_enc_state_new(16, nb);
    store64(st + _SKE_SHAPE_ORDER, so);
    _ske_set_idx(st, _SKI_SEED, load64(h + 48));
    _ske_set_idx(st, _SKI_SIGNAL_TYPE, 2);
    _ske_set_idx(st, _SKI_QUANT_OFFSET, load64(h + 64));
    _ske_set_idx(st, _SKI_NLSF_INTERP, load64(h + 72));
    var x = alloc(320 * 8);
    var par = alloc(128 * 8);
    var arc = alloc(96 * 8);
    var ar = alloc(96 * 8);
    _bench_skv_ints(_SKQ_X16, found, x);
    _bench_skv_ints(_SKQ_PAR, found, par);
    _bench_skv_ints(_SKQ_AR, found, arc);
    var i = 0;
    while (i < 96) { store64(ar + i * 8, 0); i = i + 1; }
    i = 0;
    while (i < nb) {
        var j = 0;
        while (j < so) { store64(ar + (i * 24 + j) * 8, load64(arc + (i * so + j) * 8)); j = j + 1; }
        i = i + 1;
    }
    var pulses = alloc(320 * 8);
    var nsq = load64(st + _SKE_NSQ);
    var o = 32 + nb * 5;
    var iters = 100;
    bench("silk_nsq_20ms_wb", iters);
    var t0 = time_now_ns();
    for (var it = 0; it < iters; it = it + 1) {
        _opus_frame_begin();
        silk_nsq(st, nsq, x, pulses, par, par + 32 * 8, ar, par + o * 8, par + (o + nb) * 8, par + (o + 2 * nb) * 8,
          par + (o + 3 * nb) * 8, par + (o + 4 * nb) * 8, load64(h + 80), load64(h + 88));
        _opus_frame_end();
    }
    var t1 = time_now_ns();
    return bench_report(t1 - t0, iters);
}

