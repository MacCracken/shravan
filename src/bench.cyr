    var t0 = time_now_ns();
    for (var it = 0; it < iters; it = it + 1) { wav_encode(samples, 44100, 1, PCM_I16, buf); }
    var t1 = time_now_ns();
    return bench_report(t1 - t0, iters);
}

# ================================================================
# Benchmark: pcm_i24_packed_4096
# ================================================================

fn bench_pcm_i24_4096() {
    var buf = alloc(12288);
    for (var i = 0; i < 4096; i = i + 1) {
        var off = i * 3;
        var val = (i * 100) & 0xFFFFFF;
        store8(buf + off, val & 0xFF);
        store8(buf + off + 1, (val >> 8) & 0xFF);
        store8(buf + off + 2, (val >> 16) & 0xFF);
    }

    for (var w = 0; w < 100; w = w + 1) { i24_packed_to_f64(buf, 4096); }

    var iters = 10000;
    bench("pcm_i24_packed_4096", iters);
    var t0 = time_now_ns();
    for (var it = 0; it < iters; it = it + 1) { i24_packed_to_f64(buf, 4096); }
    var t1 = time_now_ns();
    return bench_report(t1 - t0, iters);
}

