# ================================================================
# Benchmark: aac_encode_1sec_stereo / aac_decode_1sec_stereo
# ================================================================
# AAC encode is the heaviest path in the library and had no coverage. It matters
# from 2.7.2 on, when per-band M/S, intensity and PNS each added a pass over the
# spectrum before quantization — this is what says whether those decisions cost
# anything measurable.

fn _bench_aac_signal() {
    var samples = vec_new();
    var two_pi = f64_mul(F64_TWO, f64_mul(f64_from(3), f64_add(F64_ONE, f64_div(f64_from(47197), f64_from(100000)))));
    var F64_44100 = f64_from(44100);
    for (var i = 0; i < 44100; i = i + 1) {
        var ph = f64_div(f64_mul(two_pi, f64_from(i)), F64_44100);
        # Low tone shared by both channels, high tone scaled in the right: gives
        # the M/S, intensity and PNS decisions something real to chew on.
        var lo = f64_mul(f64_sin(f64_mul(ph, f64_from(440))), f64_div(F64_ONE, F64_TWO));
        var hi = f64_mul(f64_sin(f64_mul(ph, f64_from(9000))), f64_div(F64_ONE, f64_from(5)));
        vec_push(samples, f64_add(lo, hi));
        vec_push(samples, f64_add(lo, f64_mul(hi, F64_HALF)));
    }
    return samples;
}

fn bench_aac_encode_1sec() {
    var samples = _bench_aac_signal();
    var buf = alloc(1048576);
    aac_encode(samples, 44100, 2, 128000, buf);   # warm the tables

    var iters = 3;
    bench("aac_encode_1sec_stereo", iters);
    var t0 = time_now_ns();
    for (var it = 0; it < iters; it = it + 1) {
        aac_encode(samples, 44100, 2, 128000, buf);
    }
    var t1 = time_now_ns();
    return bench_report(t1 - t0, iters);
}

fn bench_aac_decode_1sec() {
    var samples = _bench_aac_signal();
    var buf = alloc(1048576);
    var asize = aac_encode(samples, 44100, 2, 128000, buf);

    var iters = 3;
    bench("aac_decode_1sec_stereo", iters);
    var t0 = time_now_ns();
    for (var it = 0; it < iters; it = it + 1) { aac_decode(buf, asize); }
    var t1 = time_now_ns();
    return bench_report(t1 - t0, iters);
}

# ================================================================
# Benchmark: opus_celt_decode_20ms
# ================================================================
# The Opus decode path had no benchmark, and 2.7.3 added a per-packet framing
# pre-scan plus a frame loop around the dispatch. This measures the CELT-only
# fullband 20 ms decode, the hot path for CELT and hybrid alike.

fn bench_opus_celt_decode() {
    var N = 960;
    var pcmin = alloc(N * 8);
    var two_pi = f64_mul(F64_TWO, f64_mul(f64_from(3), f64_add(F64_ONE, f64_div(f64_from(47197), f64_from(100000)))));
    for (var i = 0; i < N; i = i + 1) {
        var ph = f64_div(f64_mul(two_pi, f64_from(i)), f64_from(48000));
        var v = f64_add(f64_mul(f64_sin(f64_mul(ph, f64_from(440))), f64_div(F64_ONE, F64_TWO)),
          f64_mul(f64_sin(f64_mul(ph, f64_from(3300))), f64_div(F64_ONE, f64_from(5))));
        store64(pcmin + i * 8, v);
    }
    # celt_encode wants the frame plus 120 samples of lookahead.
    var pcmw = alloc((N + 120) * 8);
    for (var k = 0; k < N + 120; k = k + 1) {
        store64(pcmw + k * 8, load64(pcmin + (k % N) * 8));
    }
    var pkt = alloc(4096);
    var plen = 160;
    var enc = ec_enc_new(pkt, plen);
    var est = celt_dec_state_new();   # the encoder shares the CELT state layout
    var mem = alloc(8); store64(mem, 0);
    celt_encode(est, enc, pcmw, 1, 3, 0, 0, mem);
    ec_enc_done(enc);

    var out = alloc(2 * N * 8);
    var st = celt_dec_state_new();
    celt_decode_frame(st, pkt, plen, 1, out);      # warm the tables

    var iters = 200;
    bench("opus_celt_decode_20ms", iters);
    var t0 = time_now_ns();
    for (var it = 0; it < iters; it = it + 1) {
        celt_decode_frame(st, pkt, plen, 1, out);
    }
    var t1 = time_now_ns();
    return bench_report(t1 - t0, iters);
}

# ================================================================
# Benchmark: fft_1024
# ================================================================

fn bench_fft_1024() {
    var re = alloc(1024 * 8);
    var im = alloc(1024 * 8);
    for (var i = 0; i < 1024; i = i + 1) {
        store64(re + i * 8, f64_from(i % 100));
        store64(im + i * 8, F64_ZERO);
    }

    for (var w = 0; w < 10; w = w + 1) { fft_compute(re, im, 1024, 0); }

    var iters = 500;
    bench("fft_forward_1024", iters);
    var t0 = time_now_ns();
    for (var it = 0; it < iters; it = it + 1) { fft_compute(re, im, 1024, 0); }
    var t1 = time_now_ns();
    return bench_report(t1 - t0, iters);
}

# ================================================================
# Benchmark: mdct_2048
# ================================================================

fn bench_mdct_2048() {
    var input = alloc(2048 * 8);
    var output = alloc(1024 * 8);
    for (var i = 0; i < 2048; i = i + 1) {
        store64(input + i * 8, f64_from(i % 200));
    }

    for (var w = 0; w < 5; w = w + 1) { fft_mdct(input, 2048, output); }

    var iters = 100;
    bench("mdct_forward_2048", iters);
    var t0 = time_now_ns();
    for (var it = 0; it < iters; it = it + 1) { fft_mdct(input, 2048, output); }
    var t1 = time_now_ns();
    return bench_report(t1 - t0, iters);
}

# ================================================================
# Benchmark: pcm_f32_to_f64_4096 (float WAV / AIFF-C fl32 decode)
# ================================================================

fn bench_pcm_f32_4096() {
    var buf = alloc(16384);
    for (var i = 0; i < 4096; i = i + 1) {
        # normal floats in (-1, 1): exponents 0x70..0x7E, sign alternating
        var w = ((i * 2654435761) & 0x007FFFFF) | ((0x70 + i % 15) << 23) | ((i & 1) << 31);
        write_u32_le(buf, i * 4, w);
    }
    for (var w2 = 0; w2 < 100; w2 = w2 + 1) { f32_to_f64_vec(buf, 4096); }
    var iters = 10000;
    bench("pcm_f32_to_f64_4096", iters);
    var t0 = time_now_ns();
    for (var it = 0; it < iters; it = it + 1) { f32_to_f64_vec(buf, 4096); }
    var t1 = time_now_ns();
    return bench_report(t1 - t0, iters);
}

# ================================================================
# Benchmark: imdct_2048 (the AAC long-block synthesis transform)
# ================================================================

fn bench_imdct_2048() {
    var input = alloc(1024 * 8);
    var output = alloc(2048 * 8);
    for (var i = 0; i < 1024; i = i + 1) { store64(input + i * 8, f64_from(i % 200)); }
    for (var w = 0; w < 5; w = w + 1) { fft_imdct(input, 2048, output); }
    var iters = 1000;
    bench("imdct_inverse_2048", iters);
    var t0 = time_now_ns();
    for (var it = 0; it < iters; it = it + 1) { fft_imdct(input, 2048, output); }
    var t1 = time_now_ns();
    return bench_report(t1 - t0, iters);
}

# ================================================================
# Benchmark: wav_stream_1sec / flac_stream_1sec (streaming decode, 4 KiB feeds)
# ================================================================

fn _bench_sine_1sec() {
    var samples = vec_new();
    var two_pi = f64_mul(F64_TWO, f64_mul(f64_from(3), f64_add(F64_ONE, f64_div(f64_from(47197), f64_from(100000)))));
    for (var i = 0; i < 44100; i = i + 1) {
        vec_push(samples, f64_sin(f64_div(f64_mul(f64_mul(two_pi, f64_from(440)), f64_from(i)), f64_from(44100))));
    }
    return samples;
}

fn _bench_stream_once(kind, data, len) {
    var dec = 0;
    if (kind == 1) { dec = wav_stream_new(4096); } else { dec = flac_stream_new(); }
    var pos = 0;
    while (pos < len) {
        var take = 4096;
        if (take > len - pos) { take = len - pos; }
        if (kind == 1) { wav_stream_feed(dec, data + pos, take); } else { flac_stream_feed(dec, data + pos, take); }
        pos = pos + take;
    }
    if (kind == 1) { wav_stream_flush(dec); } else { flac_stream_flush(dec); }
    return 0;
}

fn bench_wav_stream_1sec() {
    var samples = _bench_sine_1sec();
    var buf = alloc(200000);
    var n = wav_encode(samples, 44100, 1, PCM_I16, buf);
    for (var w = 0; w < 10; w = w + 1) { _bench_stream_once(1, buf, n); }
    var iters = 200;
    bench("wav_stream_1sec_i16", iters);
    var t0 = time_now_ns();
    for (var it = 0; it < iters; it = it + 1) { _bench_stream_once(1, buf, n); }
    var t1 = time_now_ns();
    return bench_report(t1 - t0, iters);
}

fn bench_flac_stream_1sec() {
    var samples = _bench_sine_1sec();
    var buf = alloc(500000);
    var n = flac_encode(samples, 44100, 1, 16, buf);
    for (var w = 0; w < 3; w = w + 1) { _bench_stream_once(2, buf, n); }
    var iters = 20;
    bench("flac_stream_1sec_i16", iters);
    var t0 = time_now_ns();
    for (var it = 0; it < iters; it = it + 1) { _bench_stream_once(2, buf, n); }
    var t1 = time_now_ns();
    return bench_report(t1 - t0, iters);
}

# ================================================================
# Entry point
# ================================================================

# Only what the consumer contract requires: every codec initialises its own tables,
# and each benchmark warms up before it is timed.
alloc_init();
shravan_init_constants();

syscall(1, 1, "shravan v2.9.3 benchmarks\n", 26);
syscall(1, 1, "========================================\n\n", 42);

var wav_dec_ns = bench_wav_decode_1sec();
var wav_enc_ns = bench_wav_encode_1sec();
var wav_st_ns  = bench_wav_stream_1sec();
var pcm16_ns   = bench_pcm_i16_to_f64_4096();
var pcm24_ns   = bench_pcm_i24_4096();
var pcmu8_ns   = bench_pcm_u8_4096();
var pcmf32_ns  = bench_pcm_f32_4096();
var fft_ns     = bench_fft_1024();
var mdct_ns    = bench_mdct_2048();
var imdct_ns   = bench_imdct_2048();
var flac_enc_ns = bench_flac_encode_1sec();
var flac_dec_ns = bench_flac_decode_1sec();
var flac_st_ns  = bench_flac_stream_1sec();
var aac_enc_ns  = bench_aac_encode_1sec();
var aac_dec_ns  = bench_aac_decode_1sec();
var opus_dec_ns = bench_opus_celt_decode();

syscall(1, 1, "\ndone.\n", 7);
syscall(60, 0);
