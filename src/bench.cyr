# ================================================================
# Benchmark: flac_encode_1sec
# ================================================================

fn bench_flac_encode_1sec() {
    # Build samples once, save mark, reset between iterations
    var samples = vec_new();
    var two_pi = f64_mul(F64_TWO, f64_mul(f64_from(3), f64_add(F64_ONE, f64_div(f64_from(47197), f64_from(100000)))));
    var F64_440 = f64_from(440);
    var F64_44100 = f64_from(44100);
    for (var i = 0; i < 44100; i = i + 1) {
        vec_push(samples, f64_sin(f64_div(f64_mul(f64_mul(two_pi, F64_440), f64_from(i)), F64_44100)));
    }
    var mark = alloc_used();
    var buf = alloc(500000);

    var iters = 20;
    bench("flac_encode_1sec_i16", iters);
    var t0 = time_now_ns();
    for (var it = 0; it < iters; it = it + 1) {
        flac_encode(samples, 44100, 1, 16, buf);
    }
    var t1 = time_now_ns();
    return bench_report(t1 - t0, iters);
}

# ================================================================
# Benchmark: flac_encode_stereo_l{0,5,8} -- one second of 44.1 kHz stereo,
# a tone in each channel plus quiet noise, so every predictor has work to do
# ================================================================

fn _bench_flac_stereo_signal() {
    var v = vec_new();
    var wl = f64_div(f64_mul(F64_TWO, F64_PI), f64_from(100));
    var wr = f64_div(f64_mul(F64_TWO, F64_PI), f64_from(67));
    var amp = f64_div(f64_from(6), f64_from(10));
    var seed = 12345;
    for (var i = 0; i < 44100; i = i + 1) {
        seed = seed * 6364136223846793005 + 1442695040888963407;
        var nz = f64_div(f64_from(((seed >> 20) & 1023) - 512), f64_from(65536));
        vec_push(v, f64_add(f64_mul(amp, f64_sin(f64_mul(wl, f64_from(i)))), nz));
        vec_push(v, f64_add(f64_mul(amp, f64_sin(f64_mul(wr, f64_from(i)))), nz));
    }
    return v;
}

fn bench_flac_encode_stereo(name, level, iters) {
    var samples = _bench_flac_stereo_signal();
    var buf = alloc(flac_encode_bound(44100, 2, 16));
    flac_encode_level(samples, 44100, 2, 16, level, buf);
    bench(name, iters);
    var t0 = time_now_ns();
    for (var it = 0; it < iters; it = it + 1) {
        flac_encode_level(samples, 44100, 2, 16, level, buf);
    }
    var t1 = time_now_ns();
    return bench_report(t1 - t0, iters);
}

