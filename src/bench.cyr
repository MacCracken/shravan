# SILK pitch estimation (2.12.0): silk_pitch_analysis_core_FLP on libopus's
# residual of a voiced 20 ms wideband frame, at the estimator's complexity 1
# (the reference vectors' first such frame).
fn bench_silk_pitch() {
    var h = alloc(16 * 8);
    var k = 0;
    var found = 0 - 1;
    while (k < _SKT_N && found < 0) {
        _bench_skv_ints(_SKT_HDR, k, h);
        if (load64(h + 8) == 16 && load64(h + 24) == 4 && load64(h + 16) == 1 && load64(h) > 0) { found = k; }
        k = k + 1;
    }
    _bench_skv_ints(_SKT_HDR, found, h);
    var fin = alloc(4 * 8);
    var res = alloc(800 * 8);
    _bench_skv_ints(_SKT_IN, found, fin);
    var n = _bench_skv_ints(_SKT_RES, found, res);
    var i = 0;
    while (i < 3) { store64(fin + i * 8, f32_to(load64(fin + i * 8) & 0xFFFFFFFF)); i = i + 1; }
    i = 0;
    while (i < n) { store64(res + i * 8, f32_to(load64(res + i * 8) & 0xFFFFFFFF)); i = i + 1; }
    var po = alloc(4 * 8);
    var li = alloc(2 * 8);
    var lc = alloc(8);
    var thr1 = f64_div(f64_from(load64(h + 72)), f64_from(65536));
    var iters = 200;
    bench("silk_pitch_analysis_20ms_wb", iters);
    var t0 = time_now_ns();
    for (var it = 0; it < iters; it = it + 1) {
        _opus_frame_begin();
        store64(lc, load64(fin + 8));
        silk_pitch_analysis_core_flp(res, po, li, lc, load64(h), thr1, load64(fin), 16, 1, 4);
        _opus_frame_end();
    }
    var t1 = time_now_ns();
    return bench_report(t1 - t0, iters);
}

# The long-term predictor (2.12.0): correlations, gain quantisation, scaling
# and the LTP residual of a voiced 20 ms wideband frame of the reference vectors.
fn bench_silk_ltp() {
    var h = alloc(32 * 8);
    var k = 0;
    var found = 0 - 1;
    while (k < _SKL_N && found < 0) {
        _bench_skv_ints(_SKL_HDR, k, h);
        if (load64(h) == 4 && load64(h + 200) == 16) { found = k; }
        k = k + 1;
    }
    _bench_skv_ints(_SKL_HDR, found, h);
    var fv = alloc(16 * 8);
    var res = alloc(800 * 8);
    var x = alloc(800 * 8);
    var nf = _bench_skv_ints(_SKL_F, found, fv);
    var nr = _bench_skv_ints(_SKL_RES, found, res);
    var nx = _bench_skv_ints(_SKL_X, found, x);
    var i = 0;
    while (i < nf) { store64(fv + i * 8, f32_to(load64(fv + i * 8) & 0xFFFFFFFF)); i = i + 1; }
    i = 0;
    while (i < nr) { store64(res + i * 8, f32_to(load64(res + i * 8) & 0xFFFFFFFF)); i = i + 1; }
    i = 0;
    while (i < nx) { store64(x + i * 8, f32_to(load64(x + i * 8) & 0xFFFFFFFF)); i = i + 1; }
    var st = silk_enc_state_new(16, 4);
    store64(st + _SKE_SNR_Q7, load64(h + 64));
    var ctrl = silk_enc_ctrl_new();
    var inv = alloc(4 * 8);
    i = 0;
    while (i < 4) {
        store64(ctrl + _SKC_PITCHL + i * 8, load64(h + 80 + i * 8));
        store64(inv + i * 8, f64_div(F64_ONE, load64(fv + (4 + i) * 8)));
        i = i + 1;
    }
    var XX = alloc(100 * 8);
    var xX = alloc(20 * 8);
    var pre = alloc(400 * 8);
    var lm = load64(h + 72);
    var iters = 200;
    bench("silk_ltp_analysis_20ms_wb", iters);
    var t0 = time_now_ns();
    for (var it = 0; it < iters; it = it + 1) {
        _opus_frame_begin();
        store64(st + _SKE_SUM_LOG_GAIN, load64(h + 32));
        silk_find_ltp_flp(XX, xX, res + lm * 8, ctrl + _SKC_PITCHL, 80, 4);
        silk_quant_ltp_gains_flp(ctrl + _SKC_LTPCOEF, st + _SKE_IDX + 35 * 8, st + _SKE_IDX + _SKI_PER * 8,
          st + _SKE_SUM_LOG_GAIN, ctrl + _SKC_LTPRED_GAIN, XX, xX, 80, 4);
        silk_ltp_scale_ctrl_flp(st, ctrl, 0);
        silk_ltp_analysis_filter_flp(pre, x + (lm - 16) * 8, ctrl + _SKC_LTPCOEF, ctrl + _SKC_PITCHL, inv, 80, 4, 16);
        _opus_frame_end();
    }
    var t1 = time_now_ns();
    return bench_report(t1 - t0, iters);
}

# ================================================================
# Benchmark: the SILK encoder, a second of audio a run (2.11.3)
# ================================================================
# The suite's coloured-noise input (src/silk_tests.cyr _skk_signal, kind 0):
# unvoiced to libopus, so these are the packets libopus's silk_Encode writes.
fn _bench_silk_input(fs, n, x) {
    var s = 1;
    var y1 = 0;
    var y2 = 0;
    var P = fs * 10 / 13;
    for (var i = 0; i < n; i = i + 1) {
        var w = 0;
        for (var d = 0; d < 4; d = d + 1) {
            s = (s * 1664525 + 1013904223) & 0xFFFFFFFF;
            w = w + (s >> 16) - 32768;
        }
        var y = w + sar(19661 * y1 - 8192 * y2, 14);
        y2 = y1;
        y1 = y;
        var ph = i % P;
        var tri = ph;
        if (ph >= P / 2) { tri = P - ph; }
        var v = sar(y * (19661 + 45875 * 2 * tri / P), 20);
        if (v < 0 - 32768) { v = 0 - 32768; }
        if (v > 32767) { v = 32767; }
        store64(x + i * 8, f64_div(f64_from(v), f64_from(32768)));
    }
    return 0;
}

# The suite's voiced input (_skk_signal kind 6 at its defaults, 2.12.0): white
# noise through a comb at a gliding pitch, which libopus codes voiced on nearly
# every frame.
fn _bench_silk_voiced(fs, n, x) {
    var s = 1;
    var H = fs / 25;
    var hist = alloc(H * 8);
    memset(hist, 0, H * 8);
    for (var i = 0; i < n; i = i + 1) {
        var w = 0;
        for (var d = 0; d < 4; d = d + 1) {
            s = (s * 1664525 + 1013904223) & 0xFFFFFFFF;
            w = w + (s >> 16) - 32768;
        }
        var t = i % (2 * fs);
        var tri = t;
        if (t >= fs) { tri = 2 * fs - t; }
        var T = fs / (100 + 80 * tri / fs);
        var y = w + sar(14000 * load64(hist + ((i - T + H) % H) * 8), 14);
        store64(hist + (i % H) * 8, y);
        var v = sar(y, 3);
        if (v < 0 - 32768) { v = 0 - 32768; }
        if (v > 32767) { v = 32767; }
        store64(x + i * 8, f64_div(f64_from(v), f64_from(32768)));
    }
    return 0;
}

# name: the bench; a second of wideband at 20 ms packets, VBR or CBR; voiced:
# the comb input instead of the noise.
fn bench_silk_encode(name, br, cbr, iters) { return _bench_silk_encode(name, br, cbr, iters, 0); }
fn _bench_silk_encode(name, br, cbr, iters, voiced) {
    var x = alloc(16000 * 8);
    if (voiced == 1) { _bench_silk_voiced(16000, 16000, x); }
    else { _bench_silk_input(16000, 16000, x); }
    var buf = alloc(1280);
    var e = silk_encoder_new(16000, 20, br, 1, cbr);
    for (var p = 0; p < 50; p = p + 1) { silk_encode(e, x + p * 320 * 8, buf, 1275); }
    bench(name, iters);
    var t0 = time_now_ns();
    for (var it = 0; it < iters; it = it + 1) {
        for (var q = 0; q < 50; q = q + 1) { silk_encode(e, x + q * 320 * 8, buf, 1275); }
    }
    var t1 = time_now_ns();
    return bench_report(t1 - t0, iters);
}

# 2.12.1: a second of the voiced input at 48 kHz, resampled to wideband, with
# in-band FEC for 10% loss: every frame quantised twice, the LBRR copy carried.
fn bench_silk_encode_48k_fec(name, iters) {
    var x = alloc(48000 * 8);
    _bench_silk_voiced(48000, 48000, x);
    var buf = alloc(1280);
    var e = silk_encoder_new_api(48000, 16000, 20, 20000, 1, 0);
    silk_encoder_set_fec(e, 1);
    silk_encoder_set_packet_loss(e, 10);
    for (var p = 0; p < 50; p = p + 1) { silk_encode(e, x + p * 960 * 8, buf, 1275); }
    bench(name, iters);
    var t0 = time_now_ns();
    for (var it = 0; it < iters; it = it + 1) {
        for (var q = 0; q < 50; q = q + 1) { silk_encode(e, x + q * 960 * 8, buf, 1275); }
    }
    var t1 = time_now_ns();
    return bench_report(t1 - t0, iters);
}

# 2.12.2: a second of wideband stereo at 32 kbit/s, 20 ms packets: the left
# the voiced input, the right half of it and half the noise input (a partly
# correlated image, coded mid and side at full width).
fn bench_silk_encode_stereo(name, iters) {
    var xl = alloc(16000 * 8);
    var xn = alloc(16000 * 8);
    _bench_silk_voiced(16000, 16000, xl);
    _bench_silk_input(16000, 16000, xn);
    var x = alloc(2 * 16000 * 8);
    for (var i = 0; i < 16000; i = i + 1) {
        store64(x + 2 * i * 8, load64(xl + i * 8));
        store64(x + (2 * i + 1) * 8, f64_mul(f64_add(load64(xl + i * 8), load64(xn + i * 8)), F64_HALF));
    }
    var buf = alloc(1280);
    var e = silk_encoder_new_channels(16000, 16000, 2, 20, 32000, 1, 0);
    for (var p = 0; p < 50; p = p + 1) { silk_encode(e, x + p * 640 * 8, buf, 1275); }
    bench(name, iters);
    var t0 = time_now_ns();
    for (var it = 0; it < iters; it = it + 1) {
        for (var q = 0; q < 50; q = q + 1) { silk_encode(e, x + q * 640 * 8, buf, 1275); }
    }
    var t1 = time_now_ns();
    return bench_report(t1 - t0, iters);
}

# 2.12.2: silk_stereo_lr_to_ms alone on a wideband 20 ms frame: the mid/side
# conversion, both band splits, the two predictor searches and quantisers,
# and the side's prediction.
fn bench_silk_stereo_lr_to_ms() {
    var x1 = alloc(330 * 8);
    var x2 = alloc(330 * 8);
    var s1 = alloc(330 * 8);
    var s2 = alloc(330 * 8);
    var xl = alloc(16000 * 8);
    var xn = alloc(16000 * 8);
    _bench_silk_voiced(16000, 16000, xl);
    _bench_silk_input(16000, 16000, xn);
    for (var i = 0; i < 322; i = i + 1) {
        var l = _sk_float2int16(load64(xl + (1000 + i) * 8));
        store64(s1 + i * 8, l);
        store64(s2 + i * 8, sar(l + _sk_float2int16(load64(xn + (1000 + i) * 8)), 1));
    }
    var stst = silk_stereo_enc_state_new();
    store64(stst + _SKST_AMP + 8, 1);
    store64(stst + _SKST_AMP + 24, 1);
    store64(stst + _SKST_SMTH_WIDTH, 16384);
    var smid = alloc(16);
    memset(smid, 0, 16);
    var ix = alloc(6 * 8);
    var mo = alloc(8);
    var rates = alloc(16);
    var iters = 2000;
    for (var w = 0; w < 20; w = w + 1) {
        memcpy(x1, s1, 322 * 8);
        memcpy(x2, s2, 322 * 8);
        silk_stereo_lr_to_ms(stst, smid, x1 + 16, x2 + 16, ix, mo, rates, 32000, 200, 0, 16, 320);
    }
    bench("silk_stereo_lr_to_ms_20ms_wb", iters);
    var t0 = time_now_ns();
    for (var it = 0; it < iters; it = it + 1) {
        memcpy(x1, s1, 322 * 8);
        memcpy(x2, s2, 322 * 8);
        _opus_frame_begin();
        silk_stereo_lr_to_ms(stst, smid, x1 + 16, x2 + 16, ix, mo, rates, 32000, 200, 0, 16, 320);
        _opus_frame_end();
    }
    var t1 = time_now_ns();
    return bench_report(t1 - t0, iters);
}

# 2.12.3: opus_encode (OPUS_APPLICATION_RESTRICTED_SILK), a second of the
# voiced input at 48 kHz in 20 ms packets: complexity 9 (libopus's default:
# four delayed-decision states, warped shaping, the full pitch search) or 1;
# stereo, the right channel half the left and half the noise input.
fn bench_opus_encode(name, ch, br, cx, iters) {
    var xl = alloc(48000 * 8);
    _bench_silk_voiced(48000, 48000, xl);
    var x = xl;
    if (ch == 2) {
        var xn = alloc(48000 * 8);
        _bench_silk_input(48000, 48000, xn);
        x = alloc(2 * 48000 * 8);
        for (var i = 0; i < 48000; i = i + 1) {
            store64(x + 2 * i * 8, load64(xl + i * 8));
            store64(x + (2 * i + 1) * 8, f64_mul(f64_add(load64(xl + i * 8), load64(xn + i * 8)), F64_HALF));
        }
    }
    var buf = alloc(1500);
    var e = opus_encoder_new(48000, ch, OPUS_APPLICATION_RESTRICTED_SILK);
    opus_encoder_set_bitrate(e, br);
    opus_encoder_set_complexity(e, cx);
    for (var p = 0; p < 50; p = p + 1) { opus_encode(e, x + p * 960 * ch * 8, 960, buf, 1500); }
    bench(name, iters);
    var t0 = time_now_ns();
    for (var it = 0; it < iters; it = it + 1) {
        for (var q = 0; q < 50; q = q + 1) { opus_encode(e, x + q * 960 * ch * 8, 960, buf, 1500); }
    }
    var t1 = time_now_ns();
    return bench_report(t1 - t0, iters);
}

# ================================================================
# Benchmark: celt_encoder_encode (2.12.4, libopus's CELT encoder): one second
# at 48 kHz of the voiced input (the right channel the voiced and the coloured
# noise mixed), VBR, frames of n samples.
# ================================================================

fn bench_celt_encode(name, ch, n, br, cx, iters) {
    var xl = alloc(48000 * 8);
    _bench_silk_voiced(48000, 48000, xl);
    var x = xl;
    if (ch == 2) {
        var xn = alloc(48000 * 8);
        _bench_silk_input(48000, 48000, xn);
        x = alloc(2 * 48000 * 8);
        for (var i = 0; i < 48000; i = i + 1) {
            store64(x + 2 * i * 8, load64(xl + i * 8));
            store64(x + (2 * i + 1) * 8, f64_mul(f64_add(load64(xl + i * 8), load64(xn + i * 8)), F64_HALF));
        }
    }
    var buf = alloc(1280);
    var e = celt_encoder_new(48000, ch);
    celt_encoder_set_complexity(e, cx);
    celt_encoder_set_vbr(e, 1);
    celt_encoder_set_bitrate(e, br);
    var frames = 48000 / n;
    for (var p = 0; p < frames; p = p + 1) { celt_encoder_encode(e, x + p * n * ch * 8, n, buf, 1275); }
    bench(name, iters);
    var t0 = time_now_ns();
    for (var it = 0; it < iters; it = it + 1) {
        for (var q = 0; q < frames; q = q + 1) { celt_encoder_encode(e, x + q * n * ch * 8, n, buf, 1275); }
    }
    var t1 = time_now_ns();
    return bench_report(t1 - t0, iters);
}

# ================================================================
# Benchmark: fft_1024
# ================================================================

fn bench_fft_1024() {
    var re = alloc(1024 * 8);
    var im = alloc(1024 * 8);
    for (var i = 0; i < 1024; i = i + 1) {
        store64(re + i * 8, f64_from(i % 100));
        store64(im + i * 8, F64_ZERO);
    }

    for (var w = 0; w < 10; w = w + 1) { fft_compute(re, im, 1024, 0); }

    var iters = 500;
    bench("fft_forward_1024", iters);
    var t0 = time_now_ns();
    for (var it = 0; it < iters; it = it + 1) { fft_compute(re, im, 1024, 0); }
    var t1 = time_now_ns();
    return bench_report(t1 - t0, iters);
}

# ================================================================
# Benchmark: mdct_2048
# ================================================================

fn bench_mdct_2048() {
    var input = alloc(2048 * 8);
    var output = alloc(1024 * 8);
    for (var i = 0; i < 2048; i = i + 1) {
        store64(input + i * 8, f64_from(i % 200));
    }

    for (var w = 0; w < 5; w = w + 1) { fft_mdct(input, 2048, output); }

    var iters = 100;
    bench("mdct_forward_2048", iters);
    var t0 = time_now_ns();
    for (var it = 0; it < iters; it = it + 1) { fft_mdct(input, 2048, output); }
    var t1 = time_now_ns();
    return bench_report(t1 - t0, iters);
}

# ================================================================
# Benchmark: pcm_f32_to_f64_4096 (float WAV / AIFF-C fl32 decode)
# ================================================================

fn bench_pcm_f32_4096() {
    var buf = alloc(16384);
    for (var i = 0; i < 4096; i = i + 1) {
        # normal floats in (-1, 1): exponents 0x70..0x7E, sign alternating
        var w = ((i * 2654435761) & 0x007FFFFF) | ((0x70 + i % 15) << 23) | ((i & 1) << 31);
        write_u32_le(buf, i * 4, w);
    }
    for (var w2 = 0; w2 < 100; w2 = w2 + 1) { f32_to_f64_vec(buf, 4096); }
    var iters = 10000;
    bench("pcm_f32_to_f64_4096", iters);
    var t0 = time_now_ns();
    for (var it = 0; it < iters; it = it + 1) { f32_to_f64_vec(buf, 4096); }
    var t1 = time_now_ns();
    return bench_report(t1 - t0, iters);
}

# ================================================================
# Benchmark: imdct_2048 (the AAC long-block synthesis transform)
# ================================================================

fn bench_imdct_2048() {
    var input = alloc(1024 * 8);
    var output = alloc(2048 * 8);
    for (var i = 0; i < 1024; i = i + 1) { store64(input + i * 8, f64_from(i % 200)); }
    for (var w = 0; w < 5; w = w + 1) { fft_imdct(input, 2048, output); }
    var iters = 1000;
    bench("imdct_inverse_2048", iters);
    var t0 = time_now_ns();
    for (var it = 0; it < iters; it = it + 1) { fft_imdct(input, 2048, output); }
    var t1 = time_now_ns();
    return bench_report(t1 - t0, iters);
}

# ================================================================
# Benchmark: wav_stream_1sec / flac_stream_1sec (streaming decode, 4 KiB feeds)
# ================================================================

fn _bench_sine_1sec() {
    var samples = vec_new();
    var two_pi = f64_mul(F64_TWO, f64_mul(f64_from(3), f64_add(F64_ONE, f64_div(f64_from(47197), f64_from(100000)))));
    for (var i = 0; i < 44100; i = i + 1) {
        vec_push(samples, f64_sin(f64_div(f64_mul(f64_mul(two_pi, f64_from(440)), f64_from(i)), f64_from(44100))));
    }
    return samples;
}

fn _bench_stream_once(kind, data, len) {
    var dec = 0;
    if (kind == 1) { dec = wav_stream_new(4096); } else { dec = flac_stream_new(); }
    var pos = 0;
    while (pos < len) {
        var take = 4096;
        if (take > len - pos) { take = len - pos; }
        if (kind == 1) { wav_stream_feed(dec, data + pos, take); } else { flac_stream_feed(dec, data + pos, take); }
        pos = pos + take;
    }
    if (kind == 1) { wav_stream_flush(dec); } else { flac_stream_flush(dec); }
    return 0;
}

fn bench_wav_stream_1sec() {
    var samples = _bench_sine_1sec();
    var buf = alloc(200000);
    var n = wav_encode(samples, 44100, 1, PCM_I16, buf);
    for (var w = 0; w < 10; w = w + 1) { _bench_stream_once(1, buf, n); }
    var iters = 200;
    bench("wav_stream_1sec_i16", iters);
    var t0 = time_now_ns();
    for (var it = 0; it < iters; it = it + 1) { _bench_stream_once(1, buf, n); }
    var t1 = time_now_ns();
    return bench_report(t1 - t0, iters);
}

fn bench_flac_stream_1sec() {
    var samples = _bench_sine_1sec();
    var buf = alloc(500000);
    var n = flac_encode(samples, 44100, 1, 16, buf);
    for (var w = 0; w < 3; w = w + 1) { _bench_stream_once(2, buf, n); }
    var iters = 20;
    bench("flac_stream_1sec_i16", iters);
    var t0 = time_now_ns();
    for (var it = 0; it < iters; it = it + 1) { _bench_stream_once(2, buf, n); }
    var t1 = time_now_ns();
    return bench_report(t1 - t0, iters);
}

# ================================================================
# Benchmark: mp4_decode_1sec_stereo / mp3_decode_lame_stereo
# ================================================================
# MP4 is the AAC decode behind the demux, the track walk and the gapless trim
# (2.10.2): shravan's own 1 s of AAC, each access unit taken out of its ADTS frame
# and put in an MP4. MP3 is a LAME-tagged file from libmp3lame (the MP3INFO
# fixture, 0.3 s of 44.1 kHz stereo), decoded and trimmed by its tag.

fn bench_mp4_decode_1sec() {
    var samples = _bench_aac_signal();
    var buf = alloc(1048576);
    var asize = aac_encode(samples, 44100, 2, 128000, buf);
    var aus = alloc(64 * 8);
    var sizes = alloc(64 * 8);
    var n = 0;
    var pos = 0;
    while (pos + 7 <= asize && n < 64) {
        var flen = ((load8(buf + pos + 3) & 3) << 11) | (load8(buf + pos + 4) << 3) | (load8(buf + pos + 5) >> 5);
        store64(aus + n * 8, buf + pos + 7);
        store64(sizes + n * 8, flen - 7);
        n = n + 1;
        pos = pos + flen;
    }
    var mp4 = alloc(asize + 8192);
    var mlen = _mp4_test_build(2, 44100, aus, sizes, n, mp4);
    mp4_decode(mp4, mlen);

    var iters = 3;
    bench("mp4_decode_1sec_stereo", iters);
    var t0 = time_now_ns();
    for (var it = 0; it < iters; it = it + 1) { mp4_decode(mp4, mlen); }
    var t1 = time_now_ns();
    return bench_report(t1 - t0, iters);
}

fn bench_mp3_decode_lame() {
    var buf = alloc(strlen(_FX_MP3INFO_B64) + 16);
    var n = _mp3_b64_decode(_FX_MP3INFO_B64, buf);
    mp3_decode_pcm(buf, n);

    var iters = 5;
    bench("mp3_decode_lame_stereo", iters);
    var t0 = time_now_ns();
    for (var it = 0; it < iters; it = it + 1) { mp3_decode_pcm(buf, n); }
    var t1 = time_now_ns();
    return bench_report(t1 - t0, iters);
}

# 2.10.3: more than two channels. AAC 5.1 as ffmpeg's encoder writes it (ADTS,
# channel configuration 6), and 5.1 Ogg Opus: four streams a packet, two coupled.
fn bench_aac_decode_51() {
    var buf = alloc(strlen(_FX_AACMC51_B64) + 16);
    var n = _mp3_b64_decode(_FX_AACMC51_B64, buf);
    aac_decode(buf, n);

    var iters = 10;
    bench("aac_decode_51_adts", iters);
    var t0 = time_now_ns();
    for (var it = 0; it < iters; it = it + 1) { aac_decode(buf, n); }
    var t1 = time_now_ns();
    return bench_report(t1 - t0, iters);
}

fn bench_opus_decode_51() {
    var buf = alloc(strlen(_FX_OPMS51_B64) + 16);
    var n = _mp3_b64_decode(_FX_OPMS51_B64, buf);
    codec_open(buf, n);

    var iters = 5;
    bench("opus_decode_51_multistream", iters);
    var t0 = time_now_ns();
    for (var it = 0; it < iters; it = it + 1) { codec_open(buf, n); }
    var t1 = time_now_ns();
    return bench_report(t1 - t0, iters);
}

