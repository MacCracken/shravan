fn bench_wav_encode_1sec() {
    var samples = vec_new();
    var two_pi = f64_mul(F64_TWO, f64_mul(f64_from(3), f64_add(F64_ONE, f64_div(f64_from(47197), f64_from(100000)))));
    var F64_440 = f64_from(440);
    var F64_44100 = f64_from(44100);
    for (var i = 0; i < 44100; i = i + 1) {
        vec_push(samples, f64_sin(f64_div(f64_mul(f64_mul(two_pi, F64_440), f64_from(i)), F64_44100)));
    }
    var buf = alloc(200000);

    for (var w = 0; w < 10; w = w + 1) { wav_encode(samples, 44100, 1, PCM_I16, buf); }

    var iters = 1000;
