# shravan — audio codecs for AGNOS (Cyrius port)
# Ported from ~10K lines of Rust to Cyrius.
#
# Phase 1: error, format, pcm, codec, wav
#
# Design decisions:
#   - All audio samples are f64 internally (Cyrius native, more precision than f32)
#   - Packed Result: Ok returns value >= 0, Err sets bit 63 (value < 0)
#   - Buffers are raw byte pointers + length
#   - Vec used for dynamic sample arrays (stores f64 bit patterns as i64)
#   - Error codes are integer enums, error messages via helper functions

# Stdlib modules resolved via cyrius.toml [deps] stdlib.

# ================================================================
# Constants — f64 bit patterns for common values
# ================================================================

# f64 constants — initialized at startup via shravan_init_constants()
var F64_ZERO       = 0;
var F64_NEG_HALF   = 0;
var F64_NEG_ONE    = 0;
# F64_ONE, F64_TWO, and F64_HALF are provided by math.cyr (stdlib)

# PCM normalization constants (divisors and reciprocals)
var F64_128        = 0;
var F64_255        = 0;
var F64_32768      = 0;
var F64_32767      = 0;
var F64_8388608    = 0;
var F64_8388607    = 0;
var F64_2147483648 = 0;
var F64_2147483647 = 0;

# Pre-computed reciprocals for PCM conversion (mul instead of div)
var F64_RCP_128        = 0;
var F64_RCP_32768      = 0;
var F64_RCP_8388608    = 0;
var F64_RCP_2147483648 = 0;

# Pre-computed power for f32 denormal conversion
var F64_2_NEG_149  = 0;
var F64_2_NEG_150  = 0;

fn shravan_init_constants() {
    F64_ZERO       = f64_from(0);
    F64_NEG_HALF   = f64_neg(F64_HALF);  # F64_HALF from math.cyr
    F64_NEG_ONE    = f64_neg(F64_ONE);
    F64_128        = f64_from(128);
    F64_255        = f64_from(255);
    F64_32768      = f64_from(32768);
    F64_32767      = f64_from(32767);
    F64_8388608    = f64_from(8388608);
    F64_8388607    = f64_from(8388607);
    F64_2147483648 = f64_mul(f64_from(32768), f64_from(65536));
    F64_2147483647 = f64_sub(F64_2147483648, F64_ONE);

    # Reciprocals for PCM hot paths (mul is ~3x faster than div)
    F64_RCP_128        = f64_div(F64_ONE, F64_128);
    F64_RCP_32768      = f64_div(F64_ONE, F64_32768);
    F64_RCP_8388608    = f64_div(F64_ONE, F64_8388608);
    F64_RCP_2147483648 = f64_div(F64_ONE, F64_2147483648);

    # f32 denormal: 2^-149 and 2^-150
    F64_2_NEG_149 = f64_pow(F64_TWO, f64_from(0 - 149));
    F64_2_NEG_150 = f64_pow(F64_TWO, f64_from(0 - 150));
    return 0;
}

# ================================================================
# Error module
# ================================================================

enum ShravanErr {
    ERR_NONE              = 0;
    ERR_UNSUPPORTED_FMT   = 1;
    ERR_INVALID_HEADER    = 2;
    ERR_DECODE            = 3;
    ERR_ENCODE            = 4;
    ERR_END_OF_STREAM     = 5;
    ERR_INVALID_RATE      = 6;
    ERR_INVALID_CHANNELS  = 7;
    ERR_TOO_LARGE         = 8;    # over the one-shot sample ceiling (shravan_set_max_samples)
}

# Pack an error code into a negative result (bit 63 set)
fn err(code) {
    return 0 - code;
}

# is_err(r) and err_code(r) come from the stdlib (syscalls, pulled via io):
# they are byte-identical to shravan's packed-Result convention
# (is_err = r < 0, err_code = 0 - r). Only res_ok is shravan's own — the
# stdlib's res_ok (result.cyr) operates on tagged Result structs, not the
# packed >=0/<0 integer results the codecs use.
fn res_ok(r) {
    if (r >= 0) { return 1; }
    return 0;
}

# Print error message to stderr
fn err_print(code) {
    if (code == ERR_UNSUPPORTED_FMT)  { syscall(1, 2, "unsupported format\n", 19); }
    if (code == ERR_INVALID_HEADER)   { syscall(1, 2, "invalid header\n", 15); }
    if (code == ERR_DECODE)           { syscall(1, 2, "decode error\n", 13); }
    if (code == ERR_ENCODE)           { syscall(1, 2, "encode error\n", 13); }
    if (code == ERR_END_OF_STREAM)    { syscall(1, 2, "end of stream\n", 14); }
    if (code == ERR_INVALID_RATE)     { syscall(1, 2, "invalid sample rate\n", 20); }
    if (code == ERR_INVALID_CHANNELS) { syscall(1, 2, "invalid channel count\n", 22); }
    if (code == ERR_TOO_LARGE)        { syscall(1, 2, "too long for a one-shot decode\n", 31); }
    return 0;
}

# ---- the one-shot sample ceiling ---------------------------------------------
# A whole-file decode returns every sample at once, and alloc() never frees, so
# without a ceiling a few KB of crafted FLAC or AAC can mint gigabytes (SEC-023,
# 027, 029). Every one-shot decoder sizes its output once, from the declared
# length or a cheap header count, and returns ERR_TOO_LARGE rather than allocate
# past the ceiling. The default, 2^26 interleaved samples (512 MB of f64), is
# about 12.7 minutes of 44.1 kHz stereo. Until 2.9.3 it was 2^25 (6.3 minutes),
# fixed, and reported as ERR_DECODE; outputs grew by doubling, so peak memory ran
# two to four times the payload.
var _shravan_max_samples = 67108864;

# Set the ceiling on interleaved samples a one-shot decode may return
# (codec_open, decode_file and each codec's _decode). Returns the previous value.
# n is clamped to [1, 2^28], the stdlib vector limit. A consumer that trusts its
# input, or decodes long files, raises it; streaming avoids it.
fn shravan_set_max_samples(n) {
    var prev = _shravan_max_samples;
    if (n < 1) { n = 1; }
    if (n > 268435456) { n = 268435456; }
    _shravan_max_samples = n;
    return prev;
}

fn shravan_max_samples() { return _shravan_max_samples; }

# ================================================================
# Format module
# ================================================================

enum AudioFormat {
    FMT_WAV    = 0;
    FMT_FLAC   = 1;
    FMT_RAW    = 2;
    FMT_OGG    = 3;
    FMT_AIFF   = 4;
    FMT_MP3    = 5;
    FMT_OPUS   = 6;
    FMT_AAC    = 7;
    FMT_ALAC   = 8;
    FMT_MP4    = 9;
}

fn format_name(fmt) {
    if (fmt == FMT_WAV)  { return "WAV"; }
    if (fmt == FMT_FLAC) { return "FLAC"; }
    if (fmt == FMT_RAW)  { return "Raw PCM"; }
    if (fmt == FMT_OGG)  { return "Ogg"; }
    if (fmt == FMT_AIFF) { return "AIFF"; }
    if (fmt == FMT_MP3)  { return "MP3"; }
    if (fmt == FMT_OPUS) { return "Opus"; }
    if (fmt == FMT_AAC)  { return "AAC"; }
    if (fmt == FMT_ALAC) { return "ALAC"; }
    if (fmt == FMT_MP4)  { return "MP4/M4A"; }
    return "Unknown";
}

# Struct size constants
var FMTINFO_SIZE       = 48;
var DECODE_RESULT_SIZE = 16;
var BITREADER_SIZE     = 32;

# FormatInfo — heap-allocated struct
# Layout (48 bytes):
#   +0:  format        (i64, AudioFormat enum)
#   +8:  sample_rate   (i64, Hz)
#   +16: channels      (i64)
#   +24: bit_depth     (i64)
#   +32: duration_secs (f64 bit pattern)
#   +40: total_samples (i64)

fn fmtinfo_new(format, sample_rate, channels, bit_depth, duration_secs, total_samples) {
    var fi = alloc(48);
    store64(fi,      format);
    store64(fi + 8,  sample_rate);
    store64(fi + 16, channels);
    store64(fi + 24, bit_depth);
    store64(fi + 32, duration_secs);
    store64(fi + 40, total_samples);
    return fi;
}

fn fmtinfo_format(fi)       { return load64(fi); }
fn fmtinfo_sample_rate(fi)  { return load64(fi + 8); }
fn fmtinfo_channels(fi)     { return load64(fi + 16); }
fn fmtinfo_bit_depth(fi)    { return load64(fi + 24); }
fn fmtinfo_duration(fi)     { return load64(fi + 32); }
fn fmtinfo_total_samples(fi){ return load64(fi + 40); }

# Detect audio format from header bytes.
# data: pointer to byte buffer, len: buffer length
# Returns AudioFormat enum value on success, negative error on failure.
fn shravan_detect_format(data, len) {
    if (len < 4) { return err(ERR_INVALID_HEADER); }

    # WAV: "RIFF"
    if (load8(data) == 0x52) {
        if (load8(data+1) == 0x49) {
            if (load8(data+2) == 0x46) {
                if (load8(data+3) == 0x46) {
                    return FMT_WAV;
                }
            }
        }
    }

    # FLAC: "fLaC"
    if (load8(data) == 0x66) {
        if (load8(data+1) == 0x4C) {
            if (load8(data+2) == 0x61) {
                if (load8(data+3) == 0x43) {
                    return FMT_FLAC;
                }
            }
        }
    }

    # Ogg: "OggS"
    if (load8(data) == 0x4F) {
        if (load8(data+1) == 0x67) {
            if (load8(data+2) == 0x67) {
                if (load8(data+3) == 0x53) {
                    return FMT_OGG;
                }
            }
        }
    }

    # AIFF/AIFC: "FORM" + offset 8 = "AIFF" or "AIFC"
    if (load8(data) == 0x46) {
        if (load8(data+1) == 0x4F) {
            if (load8(data+2) == 0x52) {
                if (load8(data+3) == 0x4D) {
                    if (len >= 12) {
                        # Check for "AIFF" at offset 8
                        if (load8(data+8) == 0x41) {
                            if (load8(data+9) == 0x49) {
                                if (load8(data+10) == 0x46) {
                                    if (load8(data+11) == 0x46) { return FMT_AIFF; }
                                    if (load8(data+11) == 0x43) { return FMT_AIFF; }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    # MP3: ID3v2 tag "ID3"
    if (load8(data) == 0x49) {
        if (load8(data+1) == 0x44) {
            if (load8(data+2) == 0x33) {
                return FMT_MP3;
            }
        }
    }

    # MPEG sync: 0xFF 0xE0 mask
    if (load8(data) == 0xFF) {
        var b1 = load8(data + 1);
        if ((b1 & 0xE0) == 0xE0) {
            # Distinguish ADTS (AAC) from MP3
            # ADTS: 0xFFF sync + layer=0 → (b1 & 0xF6) == 0xF0
            if ((b1 & 0xF6) == 0xF0) {
                return FMT_AAC;
            }
            return FMT_MP3;
        }
    }

    # MP4/M4A: "ftyp" box at offset 4 (ISO base media file format)
    if (len >= 8) {
        if (load8(data+4) == 0x66) {
            if (load8(data+5) == 0x74) {
                if (load8(data+6) == 0x79) {
                    if (load8(data+7) == 0x70) {
                        return FMT_MP4;
                    }
                }
            }
        }
    }

    # MPEG audio after leading junk or silence padding (the ISO sin1k0db stream
    # opens with 215 bytes before its first frame; ffmpeg and mpg123 scan for it).
    # Two consecutive valid headers with matching version, layer and rate are
    # required, so a stray 0xFFE sync in another format is not taken for MP3.
    if (_mp3_find_stream(data, len) >= 0) { return FMT_MP3; }

    return err(ERR_UNSUPPORTED_FMT);
}

# Offset of the first MPEG audio frame that is followed by a second matching one,
# within the first 64 KiB, or -1.
fn _mp3_find_stream(data, len) {
    if (mp3_bitrate_v1_l3 == 0) { mp3_init(); }
    var lim = len - 4;
    if (lim > 65536) { lim = 65536; }
    var p = 0;
    while (p < lim) {
        if (load8(data + p) == 0xFF) {
            if ((load8(data + p + 1) & 0xE0) == 0xE0) {
                var h = mp3_parse_frame_header(data, p);
                if (res_ok(h) == 1) {
                    var fs = mp3_frame_size(h);
                    if (fs > 0) {
                        if (p + fs + 4 <= len) {
                            var h2 = mp3_parse_frame_header(data, p + fs);
                            if (res_ok(h2) == 1) {
                                if ((mp3_frame_version(h2) == mp3_frame_version(h)) & (mp3_frame_layer(h2) == mp3_frame_layer(h)) & (mp3_frame_sample_rate(h2) == mp3_frame_sample_rate(h))) {
                                    return p;
                                }
                            }
                        }
                    }
                }
            }
        }
        p = p + 1;
    }
    return 0 - 1;
}

# sankoch also defines detect_format(src, src_len), for compression formats, and
# both bundles land in one namespace where the last definition wins. Everything
# in shravan calls shravan_detect_format so that order cannot reroute codec_open
# into sankoch's version. This name stays for compatibility until 3.0.
fn detect_format(data, len) {
    return shravan_detect_format(data, len);
}

# ================================================================
# PCM module — sample format conversions
# ================================================================

enum PcmFormat {
    PCM_I8  = 0;
    PCM_I16 = 1;
    PCM_I24 = 2;
    PCM_I32 = 3;
    PCM_F32 = 4;
    PCM_F64 = 5;
}

fn pcm_bytes_per_sample(fmt) {
    if (fmt == PCM_I8)  { return 1; }
    if (fmt == PCM_I16) { return 2; }
    if (fmt == PCM_I24) { return 3; }
    if (fmt == PCM_I32) { return 4; }
    if (fmt == PCM_F32) { return 4; }
    if (fmt == PCM_F64) { return 8; }
    return 0;
}

fn pcm_bit_depth(fmt) {
    if (fmt == PCM_I8)  { return 8; }
    if (fmt == PCM_I16) { return 16; }
    if (fmt == PCM_I24) { return 24; }
    if (fmt == PCM_I32) { return 32; }
    if (fmt == PCM_F32) { return 32; }
    if (fmt == PCM_F64) { return 64; }
    return 0;
}

# Read a little-endian u16 from buffer at offset
fn read_u16_le(data, off) {
    return load8(data + off) | (load8(data + off + 1) << 8);
}

# Read a little-endian u32 from buffer at offset
fn read_u32_le(data, off) {
    return load8(data + off) | (load8(data + off + 1) << 8) | (load8(data + off + 2) << 16) | (load8(data + off + 3) << 24);
}

# Write a little-endian u16 to buffer at offset
fn write_u16_le(buf, off, val) {
    store8(buf + off, val & 0xFF);
    store8(buf + off + 1, (val >> 8) & 0xFF);
    return 0;
}

# Write a little-endian u32 to buffer at offset
fn write_u32_le(buf, off, val) {
    store8(buf + off, val & 0xFF);
    store8(buf + off + 1, (val >> 8) & 0xFF);
    store8(buf + off + 2, (val >> 16) & 0xFF);
    store8(buf + off + 3, (val >> 24) & 0xFF);
    return 0;
}

# Sign-extend a value from N bits to 64 bits
# Uses conditional subtraction since >> is logical (unsigned) in Cyrius
fn sign_extend(val, bits) {
    var half = 1 << (bits - 1);
    if (val >= half) {
        return val - (1 << bits);
    }
    return val;
}

# Clamp an f64 to [-1.0, 1.0]
fn f64_clamp_sample(x) {
    return f64_clamp(x, F64_NEG_ONE, F64_ONE);
}

# SEC-017: Overflow-checked allocation for a*b bytes.
# Returns pointer on success, or negative error if a*b would overflow
# or exceed 256MB safety cap.
var _ALLOC_MAX = 268435456;  # 256MB

fn _safe_alloc_mul(a, b) {
    if (a <= 0) { return err(ERR_DECODE); }
    if (b <= 0) { return err(ERR_DECODE); }
    if (a > _ALLOC_MAX / b) { return err(ERR_DECODE); }
    return alloc(a * b);
}

# Allocate a vec with pre-set capacity (avoids growth in hot loops)
#
# SEC-025: alloc() returns 0 — not a negative error — when a request is
# oversized or mmap fails. This published that 0 as the vec's data pointer
# alongside a non-zero capacity, so the first vec_push wrote through NULL.
# Verified: a 300 MiB WAV drove count to 157,286,400, alloc(1,258,291,200)
# returned 0, and the decode SIGSEGV'd (exit 139). n * 8 could overflow too.
# Now every failure path returns a packed error for the caller to propagate.
fn _vec_new_cap(n) {
    if (n < 0) { return err(ERR_DECODE); }
    if (n > _shravan_max_samples) { return err(ERR_TOO_LARGE); }
    return _vec_alloc(n);
}

# A vec with room for exactly n samples, outside the one-shot ceiling: the
# streaming decoders' output, whose size the decoder bounds (one chunk or frame).
fn _vec_alloc(n) {
    if (n < 0) { return err(ERR_DECODE); }
    # A zero-length conversion is legitimate (empty audio) — hand back a normal
    # growable vec rather than a zero-capacity one with a NULL buffer.
    if (n == 0) { return vec_new(); }
    if (n > 268435456) { return err(ERR_TOO_LARGE); }   # the stdlib's VEC_CAP_MAX

    var v = alloc(24);
    if (v == 0) { return err(ERR_DECODE); }
    var data = alloc(n * 8);
    if (data == 0) { return err(ERR_DECODE); }

    store64(v, data);
    store64(v + 8, 0);
    store64(v + 16, n);
    return v;
}

# ---- PCM sample layouts ----
# Every integer and float layout the WAV and AIFF decoders read. _pcm_into does
# the conversion for all of them; the public converters below wrap it with a
# ceiling-checked vec, the streaming decoders with an unbounded one.
var _PL_U8    = 1;     # WAV 8-bit: unsigned, centre 128
var _PL_S8    = 2;     # AIFF 8-bit: signed
var _PL_S16LE = 3;
var _PL_S16BE = 4;
var _PL_S24LE = 5;
var _PL_S24BE = 6;
var _PL_S32LE = 7;
var _PL_S32BE = 8;
var _PL_F32LE = 9;
var _PL_F32BE = 10;
var _PL_F64LE = 11;
var _PL_F64BE = 12;

fn _pl_bytes(pl) {
    if (pl <= _PL_S8) { return 1; }
    if (pl <= _PL_S16BE) { return 2; }
    if (pl <= _PL_S24BE) { return 3; }
    if (pl <= _PL_F32BE) { return 4; }
    return 8;
}

# An IEEE single as the double of the same value. A normal number moves its
# exponent from bias 127 to bias 1023 and its 23-bit fraction to the top of the
# 52-bit one, which is exact; a subnormal is fraction * 2^-149. Infinity and NaN
# decode as zero. This replaced an f64_pow per sample.
fn _f32_bits_to_f64(bits) {
    var exp = (bits >> 23) & 0xFF;
    var mant = bits & 0x7FFFFF;
    var f = F64_ZERO;
    if (exp == 0) {
        if (mant != 0) { f = f64_mul(f64_from(mant), F64_2_NEG_149); }
    } else {
        if (exp != 0xFF) { f = ((exp + 896) << 52) | (mant << 29); }
    }
    if (((bits >> 31) & 1) == 1) { f = f64_neg(f); }
    return f;
}

# Append count samples of layout pl, read from src, to v, which must have room
# for them. Integers scale by 1 / 2^(bits-1) (a power of two, so exact); doubles
# are stored as they are. Writes the vec's buffer directly: vec_push per sample
# cost a capacity check and a call each.
fn _pcm_into(v, pl, src, count) {
    var n0 = load64(v + 8);
    var out = load64(v) + n0 * 8;
    var i = 0;
    if (pl == _PL_U8) {
        while (i < count) {
            store64(out + i * 8, f64_mul(f64_from(load8(src + i) - 128), F64_RCP_128));
            i = i + 1;
        }
    }
    if (pl == _PL_S8) {
        while (i < count) {
            var b = load8(src + i);
            if (b >= 128) { b = b - 256; }
            store64(out + i * 8, f64_mul(f64_from(b), F64_RCP_128));
            i = i + 1;
        }
    }
    if (pl == _PL_S16LE) {
        while (i < count) {
            var p = src + i * 2;
            var x = load8(p) | (load8(p + 1) << 8);
            if (x >= 32768) { x = x - 65536; }
            store64(out + i * 8, f64_mul(f64_from(x), F64_RCP_32768));
            i = i + 1;
        }
    }
    if (pl == _PL_S16BE) {
        while (i < count) {
            var p = src + i * 2;
            var x = (load8(p) << 8) | load8(p + 1);
            if (x >= 32768) { x = x - 65536; }
            store64(out + i * 8, f64_mul(f64_from(x), F64_RCP_32768));
            i = i + 1;
        }
    }
    if (pl == _PL_S24LE) {
        while (i < count) {
            var p = src + i * 3;
            var x = load8(p) | (load8(p + 1) << 8) | (load8(p + 2) << 16);
            if (x >= 8388608) { x = x - 16777216; }
            store64(out + i * 8, f64_mul(f64_from(x), F64_RCP_8388608));
            i = i + 1;
        }
    }
    if (pl == _PL_S24BE) {
        while (i < count) {
            var p = src + i * 3;
            var x = (load8(p) << 16) | (load8(p + 1) << 8) | load8(p + 2);
            if (x >= 8388608) { x = x - 16777216; }
            store64(out + i * 8, f64_mul(f64_from(x), F64_RCP_8388608));
            i = i + 1;
        }
    }
    if (pl == _PL_S32LE) {
        while (i < count) {
            var p = src + i * 4;
            var x = load8(p) | (load8(p + 1) << 8) | (load8(p + 2) << 16) | (load8(p + 3) << 24);
            if (x >= 2147483648) { x = x - 4294967296; }
            store64(out + i * 8, f64_mul(f64_from(x), F64_RCP_2147483648));
            i = i + 1;
        }
    }
    if (pl == _PL_S32BE) {
        while (i < count) {
            var p = src + i * 4;
            var x = (load8(p) << 24) | (load8(p + 1) << 16) | (load8(p + 2) << 8) | load8(p + 3);
            if (x >= 2147483648) { x = x - 4294967296; }
            store64(out + i * 8, f64_mul(f64_from(x), F64_RCP_2147483648));
            i = i + 1;
        }
    }
    if (pl == _PL_F32LE) {
        while (i < count) {
            var p = src + i * 4;
            store64(out + i * 8, _f32_bits_to_f64(load8(p) | (load8(p + 1) << 8) | (load8(p + 2) << 16) | (load8(p + 3) << 24)));
            i = i + 1;
        }
    }
    if (pl == _PL_F32BE) {
        while (i < count) {
            var p = src + i * 4;
            store64(out + i * 8, _f32_bits_to_f64((load8(p) << 24) | (load8(p + 1) << 16) | (load8(p + 2) << 8) | load8(p + 3)));
            i = i + 1;
        }
    }
    if (pl == _PL_F64LE) {
        while (i < count) {
            store64(out + i * 8, load64(src + i * 8));
            i = i + 1;
        }
    }
    if (pl == _PL_F64BE) {
        while (i < count) {
            var p = src + i * 8;
            var hi = (load8(p) << 24) | (load8(p + 1) << 16) | (load8(p + 2) << 8) | load8(p + 3);
            var lo = (load8(p + 4) << 24) | (load8(p + 5) << 16) | (load8(p + 6) << 8) | load8(p + 7);
            store64(out + i * 8, (hi << 32) | lo);
            i = i + 1;
        }
    }
    store64(v + 8, n0 + count);
    return v;
}

# count samples of layout pl as a new vec, under the one-shot ceiling.
fn _pcm_conv(pl, src, count) {
    var v = _vec_new_cap(count);
    if (is_err(v) == 1) { return v; }
    return _pcm_into(v, pl, src, count);
}

# Convert signed 16-bit samples to f64 vec.
# src: pointer to i16 LE samples, count: number of samples
# Returns: vec of f64 bit patterns
fn i16_to_f64(src, count) { return _pcm_conv(_PL_S16LE, src, count); }

# The PCM quantiser every integer encoder uses: clamp to [-1, 1], scale by
# 2^(bits-1), round half to even (lrint, as ffmpeg does), clamp to the type's
# range. It is the exact inverse of the decoders' division by 2^(bits-1), so a
# decode then re-encode hands every sample back. Until 2.9.3 the encoders scaled
# by 2^(bits-1) - 1 and truncated, which moved most samples of a "lossless"
# transcode by one LSB.
fn _pcm_quant(x, scale, lo, hi) {
    var v = f64_to(f64_round(f64_mul(f64_clamp_sample(x), scale)));
    if (v > hi) { v = hi; }
    if (v < lo) { v = lo; }
    return v;
}

# Convert f64 vec to signed 16-bit samples.
# samples: vec of f64, out: buffer to write i16 LE
# Returns: number of bytes written
fn f64_to_i16(samples, out) {
    var len = vec_len(samples);
    var sd = load64(samples);
    for (var i = 0; i < len; i = i + 1) {
        var val = _pcm_quant(load64(sd + i * 8), F64_32768, 0 - 32768, 32767);
        write_u16_le(out, i * 2, val & 0xFFFF);
    }
    return len * 2;
}

# Convert signed 32-bit samples to f64 vec.
fn i32_to_f64(src, count) { return _pcm_conv(_PL_S32LE, src, count); }

# Convert f64 vec to signed 32-bit samples.
fn f64_to_i32(samples, out) {
    var len = vec_len(samples);
    var sd = load64(samples);
    for (var i = 0; i < len; i = i + 1) {
        var val = _pcm_quant(load64(sd + i * 8), F64_2147483648, 0 - 2147483648, 2147483647);
        write_u32_le(out, i * 4, val);
    }
    return len * 4;
}

# Convert 24-bit packed LE samples (3 bytes each) to f64 vec.
fn i24_packed_to_f64(src, count) { return _pcm_conv(_PL_S24LE, src, count); }

# Convert f64 vec to 24-bit packed LE samples.
fn f64_to_i24_packed(samples, out) {
    var len = vec_len(samples);
    var sd = load64(samples);
    for (var i = 0; i < len; i = i + 1) {
        var val = _pcm_quant(load64(sd + i * 8), F64_8388608, 0 - 8388608, 8388607);
        var off = i * 3;
        store8(out + off, val & 0xFF);
        store8(out + off + 1, (val >> 8) & 0xFF);
        store8(out + off + 2, (val >> 16) & 0xFF);
    }
    return len * 3;
}

# Convert signed 24-bit integers (stored as i64, lower 24 bits) to f64 vec.
# src: pointer to i64 values, count: number of samples
# Returns: vec of f64 bit patterns
fn i24_to_f64(src, count) {
    var v = _vec_new_cap(count);
    if (is_err(v) == 1) { return v; }
    var scale = F64_RCP_8388608;
    for (var i = 0; i < count; i = i + 1) {
        var raw = load64(src + i * 8) & 0xFFFFFF;
        var signed = sign_extend(raw, 24);
        vec_push(v, f64_mul(f64_from(signed), scale));
    }
    return v;
}

# Convert f64 vec to signed 24-bit integers (stored as i64).
# samples: vec of f64, out: pointer to i64 buffer
# Returns: number of samples written
fn f64_to_i24(samples, out) {
    var len = vec_len(samples);
    var sd = load64(samples);
    for (var i = 0; i < len; i = i + 1) {
        var val = _pcm_quant(load64(sd + i * 8), F64_8388608, 0 - 8388608, 8388607);
        store64(out + i * 8, val & 0xFFFFFF);
    }
    return len;
}

# Convert unsigned 8-bit PCM (center=128) to f64 vec.
fn u8_to_f64(src, count) { return _pcm_conv(_PL_U8, src, count); }

# Convert f64 vec to unsigned 8-bit PCM.
fn f64_to_u8(samples, out) {
    var len = vec_len(samples);
    var sd = load64(samples);
    for (var i = 0; i < len; i = i + 1) {
        var val = _pcm_quant(load64(sd + i * 8), F64_128, 0 - 128, 127) + 128;
        store8(out + i, val);
    }
    return len;
}

# Read little-endian IEEE 754 doubles into a vec: the samples are stored as-is.
fn f64le_to_f64_vec(src, count) { return _pcm_conv(_PL_F64LE, src, count); }

# Big-endian IEEE 754 doubles (AIFF-C fl64), stored as-is.
fn f64be_to_f64_vec(src, count) { return _pcm_conv(_PL_F64BE, src, count); }


# Little-endian IEEE singles (WAV format 3) to f64.
fn f32_to_f64_vec(src, count) { return _pcm_conv(_PL_F32LE, src, count); }

# Big-endian IEEE singles (AIFF-C fl32) to f64.
fn f32be_to_f64_vec(src, count) { return _pcm_conv(_PL_F32BE, src, count); }

# Interleave channel buffers into a single vec.
# channels: vec of vecs (each is a channel), ch_count: number of channels
# Returns: interleaved vec
fn interleave(channels, ch_count) {
    if (ch_count == 0) { return vec_new(); }
    var ch0 = vec_get(channels, 0);
    var frames = vec_len(ch0);
    var out = vec_new();
    for (var fr = 0; fr < frames; fr = fr + 1) {
        for (var c = 0; c < ch_count; c = c + 1) {
            var ch = vec_get(channels, c);
            if (fr < vec_len(ch)) {
                vec_push(out, vec_get(ch, fr));
            }
        }
    }
    return out;
}

# Deinterleave into separate channel vecs.
# samples: interleaved vec, ch_count: number of channels
# Returns: vec of vecs
fn deinterleave(samples, ch_count) {
    if (ch_count == 0) { return vec_new(); }
    var total = vec_len(samples);
    var frames = total / ch_count;
    var out = vec_new();
    for (var c = 0; c < ch_count; c = c + 1) {
        var ch = vec_new();
        for (var fr = 0; fr < frames; fr = fr + 1) {
            vec_push(ch, vec_get(samples, fr * ch_count + c));
        }
        vec_push(out, ch);
    }
    return out;
}

# ================================================================
# WAV module — RIFF WAVE encode/decode
# ================================================================

# WAV format codes
enum WavFmt {
    WAV_FMT_PCM        = 1;
    WAV_FMT_IEEE_FLOAT = 3;
    WAV_FMT_EXTENSIBLE = 65534;
}

# Decode result — returned as a tagged pair: {fmtinfo_ptr, samples_vec}
# Layout (16 bytes):
#   +0: fmtinfo pointer
#   +8: samples vec pointer
fn decode_result_new(fi, samples) {
    var dr = alloc(16);
    store64(dr, fi);
    store64(dr + 8, samples);
    return dr;
}
fn decode_result_info(dr)    { return load64(dr); }
fn decode_result_samples(dr) { return load64(dr + 8); }

# What a WAV header says, as _wav_header fills it (7 slots of 8 bytes):
#   +0  format code (an EXTENSIBLE header's subformat)   +8  channels
#   +16 sample rate          +24 container bits (wBitsPerSample)
#   +32 valid bits (EXTENSIBLE wValidBitsPerSample; 0 = not stated)
#   +40 offset of the audio  +48 declared audio bytes (0xFFFFFFFF from a pipe)
#
# Returns 1 once `fmt ` and `data` have both been read, 0 when the buffer ends
# before they have, or an error. A one-shot decode treats 0 as a bad header; the
# streaming decoder waits for more bytes.
fn _wav_header(data, len, h) {
    if (len < 12) { return 0; }

    # Validate RIFF magic ("RIFF" = 0x46464952 LE)
    if (read_u32_le(data, 0) != 0x46464952) { return err(ERR_INVALID_HEADER); }

    # Validate WAVE identifier ("WAVE" = 0x45564157 LE)
    if (read_u32_le(data, 8) != 0x45564157) { return err(ERR_INVALID_HEADER); }

    # Scan for fmt and data chunks
    var pos = 12;
    var fmt_code = 0;
    var fmt_ch = 0;
    var fmt_rate = 0;
    var fmt_bps = 0;
    var fmt_valid_bits = 0;   # EXTENSIBLE wValidBitsPerSample (0 = not present)
    var fmt_found = 0;
    var dat_start = 0;
    var dat_size = 0;
    var dat_found = 0;

    while (pos + 8 <= len) {
        var chunk_id = read_u32_le(data, pos);
        var ck_size = read_u32_le(data, pos + 4);

        # "fmt " = 0x20746D66 LE
        if (chunk_id == 0x20746D66) {
            if (ck_size < 16) { return err(ERR_INVALID_HEADER); }
            # SEC-022: the loop guard only proves the 8-byte chunk HEADER is in
            # the buffer (pos + 8 <= len). The reads below reach pos + 23, so a
            # `fmt ` header sitting at the very end of the buffer read up to 16
            # bytes past it. ck_size is the DECLARED size and proves nothing
            # about what is actually present. Demonstrated: a 44-byte WAV whose
            # `fmt ` header ends at byte 44 decoded successfully, reporting
            # rate/channels/depth taken entirely from beyond the buffer.
            if (pos + 24 > len) { return 0; }
            fmt_code = read_u16_le(data, pos + 8);
            fmt_ch   = read_u16_le(data, pos + 10);
            fmt_rate = read_u32_le(data, pos + 12);
            # skip byte_rate(4) + block_align(2)
            fmt_bps  = read_u16_le(data, pos + 22);

            # WAVE_FORMAT_EXTENSIBLE
            if (fmt_code == WAV_FMT_EXTENSIBLE) {
                if (ck_size >= 40) {
                    if (pos + 34 > len) { return 0; }
                    # wValidBitsPerSample says how many bits carry signal;
                    # wBitsPerSample (read above into fmt_bps) is the
                    # CONTAINER size and is what strides the sample data.
                    # Overwriting fmt_bps with valid_bits mis-strode every
                    # 24-in-32 file — the common "24-bit in a 32-bit
                    # container" layout — reading 3-byte samples out of a
                    # 4-byte grid and desynchronising after the first one.
                    # (This is the roadmap's "wav WAVE_FORMAT_EXTENSIBLE
                    # 24-in-32" item.) Keep them separate: stride by the
                    # container, report the valid bits.
                    var valid_bits = read_u16_le(data, pos + 26);
                    if (valid_bits > 0) {
                        if (valid_bits <= fmt_bps) { fmt_valid_bits = valid_bits; }
                    }
                    fmt_code = read_u16_le(data, pos + 32);
                }
            }
            fmt_found = 1;
        }

        # "data" = 0x61746164 LE
        if (chunk_id == 0x61746164) {
            dat_start = pos + 8;
            dat_size = ck_size;
            dat_found = 1;
        }

        # Advance to next chunk (pad to even), with overflow guard
        if (ck_size > len - pos - 8) { pos = len + 1; }
        else {
            var padded = ck_size + (ck_size & 1);
            pos = pos + padded + 8;
        }

        if (fmt_found == 1) {
            if (dat_found == 1) {
                # Break: we use a high pos to exit
                pos = len + 1;
            }
        }
    }

    if (fmt_found == 0) { return 0; }
    if (dat_found == 0) { return 0; }
    if (fmt_ch == 0)    { return err(ERR_INVALID_CHANNELS); }
    if (fmt_rate == 0)  { return err(ERR_INVALID_RATE); }

    store64(h, fmt_code);
    store64(h + 8, fmt_ch);
    store64(h + 16, fmt_rate);
    store64(h + 24, fmt_bps);
    store64(h + 32, fmt_valid_bits);
    store64(h + 40, dat_start);
    store64(h + 48, dat_size);
    return 1;
}

# The sample layout of a WAV format shravan decodes, or 0 for one it does not.
# Integer PCM rounds the declared depth up to whole bytes, as ffmpeg does: the
# samples are left-justified in that container, so a 12-bit file decodes as
# 16-bit.
fn _wav_layout(code, bps) {
    if (code == WAV_FMT_PCM) {
        if (bps >= 1) {
            if (bps <= 8)  { return _PL_U8; }
            if (bps <= 16) { return _PL_S16LE; }
            if (bps <= 24) { return _PL_S24LE; }
            if (bps <= 32) { return _PL_S32LE; }
        }
    }
    if (code == WAV_FMT_IEEE_FLOAT) {
        if (bps == 32) { return _PL_F32LE; }
        if (bps == 64) { return _PL_F64LE; }
    }
    return 0;
}


var _wav_h = 0;

# Decode WAV data from a byte buffer.
# data: pointer to WAV bytes, len: total byte length
# Returns: decode_result pointer on success, negative error on failure
fn wav_decode(data, len) {
    if (len < 44) { return err(ERR_INVALID_HEADER); }
    if (_wav_h == 0) { _wav_h = alloc(56); }
    var h = _wav_h;
    var r = _wav_header(data, len, h);
    if (is_err(r) == 1) { return r; }
    if (r == 0) { return err(ERR_INVALID_HEADER); }

    var fmt_code = load64(h);
    var fmt_ch = load64(h + 8);
    var fmt_rate = load64(h + 16);
    var fmt_bps = load64(h + 24);
    var fmt_valid_bits = load64(h + 32);
    var dat_start = load64(h + 40);
    var dat_size = load64(h + 48);

    # Clamp data_size to available bytes
    var avail = len - dat_start;
    if (dat_size > avail) { dat_size = avail; }

    var samples = vec_new();
    var pl = _wav_layout(fmt_code, fmt_bps);
    if (pl != 0) { samples = _pcm_conv(pl, data + dat_start, dat_size / _pl_bytes(pl)); }

    # SEC-025: the converters can now return a packed error (oversized or
    # failed allocation). vec_len() on a negative pointer segfaults, so the
    # error has to be caught before it is treated as a vec — this is exactly
    # how a 300 MiB WAV reached exit 139.
    if (is_err(samples) == 1) { return samples; }

    var sample_count = vec_len(samples);
    if (sample_count == 0) {
        if (dat_size > 0) {
            return err(ERR_DECODE);
        }
    }

    var total_frames = sample_count / fmt_ch;
    var dur = f64_div(f64_from(total_frames), f64_from(fmt_rate));

    # Report the meaningful bit depth (valid bits when EXTENSIBLE declared them,
    # otherwise the container size) — decoding above already strode by the
    # container.
    var report_bps = fmt_bps;
    if (fmt_valid_bits > 0) { report_bps = fmt_valid_bits; }

    var fi = fmtinfo_new(FMT_WAV, fmt_rate, fmt_ch, report_bps, dur, total_frames);
    return decode_result_new(fi, samples);
}

# Encode interleaved f64 samples as WAV byte stream.
# samples: vec of f64 bit patterns
# sample_rate, channels: integers
# pcm_fmt: PcmFormat enum
# out: buffer to write WAV data into (must be large enough)
# Returns: total bytes written, or negative error
fn wav_encode(samples, sample_rate, channels, pcm_fmt, out) {
    if (channels == 0)    { return err(ERR_INVALID_CHANNELS); }
    if (sample_rate == 0) { return err(ERR_INVALID_RATE); }

    var fmt_code = WAV_FMT_PCM;
    if (pcm_fmt == PCM_F32) { fmt_code = WAV_FMT_IEEE_FLOAT; }
    if (pcm_fmt == PCM_F64) { fmt_code = WAV_FMT_IEEE_FLOAT; }

    var bps = pcm_bit_depth(pcm_fmt);
    var bytes_ps = pcm_bytes_per_sample(pcm_fmt);
    var block_align = channels * bytes_ps;
    var byte_rate = block_align * sample_rate;

    var sample_count = vec_len(samples);

    # Encode raw sample data into a temp buffer after the header
    var header_size = 44;
    var raw_data = out + header_size;
    var raw_size = 0;

    if (pcm_fmt == PCM_I8) {
        raw_size = f64_to_u8(samples, raw_data);
    }
    if (pcm_fmt == PCM_I16) {
        raw_size = f64_to_i16(samples, raw_data);
    }
    if (pcm_fmt == PCM_I24) {
        raw_size = f64_to_i24_packed(samples, raw_data);
    }
    if (pcm_fmt == PCM_I32) {
        raw_size = f64_to_i32(samples, raw_data);
    }
    if (pcm_fmt == PCM_F32) {
        # Convert f64 back to f32 IEEE 754 LE
        raw_size = f64_to_f32_bytes(samples, raw_data);
    }
    if (pcm_fmt == PCM_F64) {
        # f64 samples are already IEEE 754 doubles, so this is a straight copy.
        var f64_count = vec_len(samples);
        for (var fi = 0; fi < f64_count; fi = fi + 1) {
            store64(raw_data + fi * 8, vec_get(samples, fi));
        }
        raw_size = f64_count * 8;
    }

    var data_size = raw_size;
    var file_size = 4 + 24 + 8 + data_size;

    # RIFF header
    store8(out, 0x52); store8(out+1, 0x49); store8(out+2, 0x46); store8(out+3, 0x46);
    write_u32_le(out, 4, file_size);
    store8(out+8, 0x57); store8(out+9, 0x41); store8(out+10, 0x56); store8(out+11, 0x45);

    # fmt chunk
    store8(out+12, 0x66); store8(out+13, 0x6D); store8(out+14, 0x74); store8(out+15, 0x20);
    write_u32_le(out, 16, 16);
    write_u16_le(out, 20, fmt_code);
    write_u16_le(out, 22, channels);
    write_u32_le(out, 24, sample_rate);
    write_u32_le(out, 28, byte_rate);
    write_u16_le(out, 32, block_align);
    write_u16_le(out, 34, bps);

    # data chunk header
    store8(out+36, 0x64); store8(out+37, 0x61); store8(out+38, 0x74); store8(out+39, 0x61);
    write_u32_le(out, 40, data_size);

    # raw_data is already written at out + 44
    return header_size + data_size;
}

# Convert f64 vec to IEEE 754 float32 LE bytes
fn f64_to_f32_bytes(samples, out) {
    var len = vec_len(samples);
    var sd = load64(samples);
    for (var i = 0; i < len; i = i + 1) {
        var bits = f64_to_f32_bits(load64(sd + i * 8));
        var p = out + i * 4;
        store8(p, bits & 0xFF);
        store8(p + 1, (bits >> 8) & 0xFF);
        store8(p + 2, (bits >> 16) & 0xFF);
        store8(p + 3, (bits >> 24) & 0xFF);
    }
    return len * 4;
}

# An f64 bit pattern as the nearest f32 (round half to even), as C's (float) and
# ffmpeg's float conversion give it: subnormal results kept, overflow to infinity,
# NaN quiet. Until 2.9.3 this truncated the fraction, pulling every sample that is
# not already a float toward zero by up to one f32 step, and flushed f32
# subnormals to zero.
fn f64_to_f32_bits(f) {
    # f64: sign(1) | exp(11) | mantissa(52)
    # f32: sign(1) | exp(8)  | mantissa(23)
    var f32_sign = ((f >> 63) & 1) << 31;
    var exp = (f >> 52) & 0x7FF;
    var mant = f & 0xFFFFFFFFFFFFF;

    if (exp == 0x7FF) {
        if (mant == 0) { return f32_sign | 0x7F800000; }    # infinity
        return f32_sign | 0x7FC00000;                       # NaN
    }
    if (exp == 0) { return f32_sign; }      # zero, or an f64 subnormal (far below f32's range)

    var unbiased = exp - 1023;
    if (unbiased > 127) { return f32_sign | 0x7F800000; }
    if (unbiased < (0 - 150)) { return f32_sign; }

    # Keep `keep` bits of the 53-bit significand and round on the rest. A normal
    # f32 keeps 24 (the leading one implicit); a subnormal f32, whose unit is
    # 2^-149, keeps fewer.
    var sig = mant | (1 << 52);
    var drop = 29;
    if (unbiased < (0 - 126)) { drop = 29 + ((0 - 126) - unbiased); }   # 30..53
    var q = sig >> drop;
    var rem = sig & ((1 << drop) - 1);
    var half = 1 << (drop - 1);
    if (rem > half) { q = q + 1; }
    if (rem == half) { q = q + (q & 1); }

    if (unbiased < (0 - 126)) {
        # Subnormal: q is the fraction field; rounding up to 2^23 is exactly the
        # smallest normal, whose encoding is the same bits.
        return f32_sign | q;
    }
    var e32 = unbiased + 127;
    if (q == 16777216) { q = 8388608; e32 = e32 + 1; }      # rounded up to the next power of two
    if (e32 >= 255) { return f32_sign | 0x7F800000; }
    return f32_sign | (e32 << 23) | (q & 0x7FFFFF);
}

# ================================================================
# AIFF module — Audio Interchange File Format encode/decode
# ================================================================

# Big-endian read helpers
fn read_u16_be(data, off) {
    return (load8(data + off) << 8) | load8(data + off + 1);
}

fn read_u32_be(data, off) {
    return (load8(data+off) << 24) | (load8(data+off+1) << 16) | (load8(data+off+2) << 8) | load8(data+off+3);
}

fn write_u16_be(buf, off, val) {
    store8(buf + off, (val >> 8) & 0xFF);
    store8(buf + off + 1, val & 0xFF);
    return 0;
}

fn write_u32_be(buf, off, val) {
    store8(buf+off, (val >> 24) & 0xFF);
    store8(buf+off+1, (val >> 16) & 0xFF);
    store8(buf+off+2, (val >> 8) & 0xFF);
    store8(buf+off+3, val & 0xFF);
    return 0;
}

# Convert 80-bit IEEE 754 extended float to integer (for sample rate)
# ext: pointer to 10 bytes
# Returns the integer value (sufficient for sample rates)
fn extended_to_f64(ext) {
    var b0 = load8(ext);
    var exponent = ((b0 & 0x7F) << 8) | load8(ext + 1);

    # Read 64-bit mantissa (big-endian) — but we only need top bits for integer rates
    # mantissa has explicit integer bit at position 63
    # value = mantissa >> (63 - (exponent - 16383))
    var unbiased = exponent - 16383;

    # Read mantissa as integer, handling potential overflow by reading in parts
    # For sample rates up to ~192000, we only need the top ~18 bits of mantissa
    # Read top 4 bytes (32 bits) — sufficient for all practical sample rates
    var mant_hi = (load8(ext+2) << 24) | (load8(ext+3) << 16) | (load8(ext+4) << 8) | load8(ext+5);

    # mantissa_hi represents bits 63..32 of the mantissa
    # value = mant_hi >> (31 - unbiased) when unbiased <= 31
    # value = mant_hi << (unbiased - 31) when unbiased > 31
    # SEC-028: bound every shift count to 0..31 before shifting.
    #
    # `exponent` is a 15-bit field, so `unbiased` spans -16383..+16384 and both
    # branches below computed shift counts far outside the 0..63 a shift may
    # legally take. Two reachable cases, both from AIFF COMM bytes:
    #   * exponent 0x403F -> unbiased 64 -> shift 33 -> `32 - shift` = -1,
    #     a NEGATIVE shift count;
    #   * a small exponent -> `31 - unbiased` in the thousands.
    # A sample rate is a positive integer, so anything outside that is a
    # malformed rate: return 0, which every caller already rejects.
    if (unbiased < 0)  { return F64_ZERO; }   # value < 1 Hz
    if (unbiased > 62) { return F64_ZERO; }   # far past any real sample rate

    var result = 0;
    if (unbiased <= 31) {
        result = mant_hi >> (31 - unbiased);       # shift 0..31
    } else {
        # Need lower mantissa bits too
        var mant_lo = (load8(ext+6) << 24) | (load8(ext+7) << 16) | (load8(ext+8) << 8) | load8(ext+9);
        var shift = unbiased - 31;                 # 1..31
        result = (mant_hi << shift) | (mant_lo >> (32 - shift));
    }

    # Return as f64 for consistency with FormatInfo duration calculations
    return f64_from(result);
}

# Convert a positive integer to 80-bit IEEE 754 extended float
# For sample rates (always positive integers like 44100, 48000)
# val: integer value, ext: pointer to 10-byte output buffer
fn f64_to_extended(val, ext) {
    if (val == 0) {
        for (var i = 0; i < 10; i = i + 1) { store8(ext + i, 0); }
        return 0;
    }

    # Find highest set bit position (0-based from LSB)
    var n = val;
    var p = 0;
    while (n > 1) { n = n >> 1; p = p + 1; }

    var biased = p + 16383;
    # mantissa = val << (63 - p), with explicit integer bit
    var mantissa = val << (63 - p);

    store8(ext, (biased >> 8) & 0x7F);
    store8(ext + 1, biased & 0xFF);
    for (var i = 0; i < 8; i = i + 1) {
        store8(ext + 2 + i, (mantissa >> (56 - i * 8)) & 0xFF);
    }
    return 0;
}

# Endianness constants
enum Endian { ENDIAN_BIG = 0; ENDIAN_LITTLE = 1; }

# Decode signed big-endian 16-bit samples to f64 vec
fn i16be_to_f64(src, count) { return _pcm_conv(_PL_S16BE, src, count); }

# Decode signed big-endian 24-bit samples to f64 vec
fn i24be_to_f64(src, count) { return _pcm_conv(_PL_S24BE, src, count); }

# Decode signed big-endian 32-bit samples to f64 vec
fn i32be_to_f64(src, count) { return _pcm_conv(_PL_S32BE, src, count); }

# Decode signed 8-bit AIFF samples (signed, not unsigned like WAV)
fn i8_to_f64(src, count) { return _pcm_conv(_PL_S8, src, count); }

# Integer AIFF audio to f64. sampleSize may be any depth from 1 to 32 bits: the
# samples sit left-justified in whole bytes, so they decode at the container size,
# as ffmpeg decodes them (until 2.9.3 anything but 8/16/24/32 came back empty).
fn aiff_decode_pcm(audio, audio_len, bits, endian) {
    var pl = _aiff_int_layout(bits, endian);
    if (pl == 0) { return vec_new(); }
    return _pcm_conv(pl, audio, audio_len / _pl_bytes(pl));
}

# The layout of integer AIFF samples of the given depth: 1 to 32 bits, held
# left-justified in whole bytes, so they decode at the container size. 0 = none.
fn _aiff_int_layout(bits, endian) {
    if (bits < 1) { return 0; }
    if (bits > 32) { return 0; }
    var w = (bits + 7) / 8;
    if (w == 1) { return _PL_S8; }
    if (endian == ENDIAN_BIG) {
        if (w == 2) { return _PL_S16BE; }
        if (w == 3) { return _PL_S24BE; }
        return _PL_S32BE;
    }
    if (w == 2) { return _PL_S16LE; }
    if (w == 3) { return _PL_S24LE; }
    return _PL_S32LE;
}

# What an AIFF / AIFF-C header says, as _aiff_header fills it (7 slots):
#   +0  channels   +8  sample size in bits (32 or 64 for float)   +16 sample rate
#   +24 endian (ENDIAN_BIG, or ENDIAN_LITTLE for sowt)
#   +32 float width (32 = fl32, 64 = fl64, 0 = integer PCM)
#   +40 offset of the audio   +48 declared audio bytes
#
# Returns 1 once COMM and SSND have both been read, 0 when the buffer ends
# before they have, or an error (a one-shot decode treats 0 as a bad header; the
# streaming decoder waits for more bytes).
fn _aiff_header(data, len, h) {
    if (len < 12) { return 0; }

    # Check "FORM" magic
    if (load8(data) != 0x46)   { return err(ERR_INVALID_HEADER); }
    if (load8(data+1) != 0x4F) { return err(ERR_INVALID_HEADER); }
    if (load8(data+2) != 0x52) { return err(ERR_INVALID_HEADER); }
    if (load8(data+3) != 0x4D) { return err(ERR_INVALID_HEADER); }

    # Check AIFF or AIFC at offset 8
    var is_aifc = 0;
    if (load8(data+8)==0x41) {
        if (load8(data+9)==0x49) {
            if (load8(data+10)==0x46) {
                if (load8(data+11)==0x46) { is_aifc = 0; }
                if (load8(data+11)==0x43) { is_aifc = 1; }
            }
        }
    }

    var pos = 12;
    var channels = 0;
    var sample_size = 0;
    var sample_rate_f = F64_ZERO;
    var comm_found = 0;
    var ssnd_start = 0;
    var ssnd_len = 0;
    var ssnd_found = 0;
    var endian = ENDIAN_BIG;
    var aifc_float = 0;     # AIFF-C fl32 (32) or fl64 (64): big-endian IEEE float

    while (pos + 8 <= len) {
        var ck0 = load8(data+pos);
        var ck1 = load8(data+pos+1);
        var ck2 = load8(data+pos+2);
        var ck3 = load8(data+pos+3);
        var ck_size = read_u32_be(data, pos + 4);

        # "COMM" = 0x43 0x4F 0x4D 0x4D
        if (ck0==0x43) { if (ck1==0x4F) { if (ck2==0x4D) { if (ck3==0x4D) {
                        var base = pos + 8;
                        # SEC-022: the loop only proves the 8-byte chunk header is present
                        # (pos + 8 <= len). The COMM body is 18 bytes — 2 channels,
                        # 4 numSampleFrames, 2 sampleSize, 10 extended sampleRate — so the
                        # reads below reach pos + 25. Unlike WAV this path did not even
                        # check the declared ck_size, so a COMM header at the end of the
                        # buffer read 18 bytes past it, including the 10-byte extended
                        # float handed to extended_to_f64.
                        if (ck_size < 18)     { return err(ERR_INVALID_HEADER); }
                        if (pos + 26 > len)   { return 0; }
                        channels = read_u16_be(data, base);
                        # num_sample_frames at base+2 (4 bytes), skip
                        sample_size = read_u16_be(data, base + 6);

                        # 10-byte extended float sample rate at base+8
                        sample_rate_f = extended_to_f64(data + base + 8);

                        if (is_aifc == 1) {
                            # Compression type at base+18 (4 bytes)
                            if (base + 22 > len) { return 0; }
                            var c0 = load8(data+base+18);
                            var c1 = load8(data+base+19);
                            var c2 = load8(data+base+20);
                            var c3 = load8(data+base+21);
                            # Only uncompressed PCM is decodable: NONE and twos (big-endian
                            # integers), sowt (little-endian), fl32/FL32 and fl64/FL64
                            # (big-endian IEEE float). Anything else -- alaw, ulaw, ima4 --
                            # used to be read as PCM and came out as noise.
                            var ctype = (c0 << 24) | (c1 << 16) | (c2 << 8) | c3;
                            var known = 0;
                            if ((ctype == 0x4E4F4E45) | (ctype == 0x74776F73)) { endian = ENDIAN_BIG; known = 1; }
                            if (ctype == 0x736F7774) { endian = ENDIAN_LITTLE; known = 1; }
                            if ((ctype == 0x666C3332) | (ctype == 0x464C3332)) { aifc_float = 32; known = 1; }
                            if ((ctype == 0x666C3634) | (ctype == 0x464C3634)) { aifc_float = 64; known = 1; }
                            if (known == 0) { return err(ERR_UNSUPPORTED_FMT); }
                        }
                        comm_found = 1;
                    }}}}

        # "SSND" = 0x53 0x53 0x4E 0x44
        if (ck0==0x53) { if (ck1==0x53) { if (ck2==0x4E) { if (ck3==0x44) {
                        if (ck_size >= 8) {
                            # SEC-022: ck_size is the DECLARED size; the 4-byte offset
                            # field at pos+8..pos+11 still has to be inside the buffer.
                            if (pos + 12 > len) { return 0; }
                            var ssnd_offset = read_u32_be(data, pos + 8);
                            # Guard against underflow: ssnd_offset must fit within chunk
                            if (ssnd_offset <= ck_size - 8) {
                                var pcm_start = pos + 8 + 8 + ssnd_offset;
                                if (pcm_start > len) { return 0; }
                                ssnd_len = ck_size - 8 - ssnd_offset;
                                ssnd_start = pcm_start;
                                ssnd_found = 1;
                            }
                        }
                    }}}}

        # Advance to next chunk with overflow guard
        if (ck_size > len - pos - 8) { pos = len + 1; }
        else { pos = pos + 8 + ck_size + (ck_size & 1); }
        if (comm_found == 1) { if (ssnd_found == 1) { pos = len + 1; } }
    }

    if (comm_found == 0) { return 0; }
    if (ssnd_found == 0) { return 0; }
    if (channels == 0)   { return err(ERR_INVALID_CHANNELS); }

    # SEC-028: validate the COMM fields as ranges, not just against zero.
    # channels and sampleSize are 16-bit fields, and only `== 0` was rejected,
    # so 65535 channels or a 65535-bit sample depth reached the PCM converters
    # and the frame-count division below.
    if (channels > 256)     { return err(ERR_INVALID_CHANNELS); }
    if (aifc_float != 0) { sample_size = aifc_float; }
    if (sample_size <= 0)   { return err(ERR_INVALID_HEADER); }
    if ((sample_size > 32) & (aifc_float != 64)) { return err(ERR_INVALID_HEADER); }

    var sample_rate = f64_to(sample_rate_f);
    if (sample_rate <= 0)       { return err(ERR_INVALID_RATE); }
    if (sample_rate > 4000000)  { return err(ERR_INVALID_RATE); }

    store64(h, channels);
    store64(h + 8, sample_size);
    store64(h + 16, sample_rate);
    store64(h + 24, endian);
    store64(h + 32, aifc_float);
    store64(h + 40, ssnd_start);
    store64(h + 48, ssnd_len);
    return 1;
}

# The sample layout of the format _aiff_header found (never 0: the header
# parser has already refused depths outside 1..32 and 64-bit float).
fn _aiff_layout(h) {
    var fl = load64(h + 32);
    if (fl == 32) { return _PL_F32BE; }
    if (fl == 64) { return _PL_F64BE; }
    return _aiff_int_layout(load64(h + 8), load64(h + 24));
}


var _aiff_h = 0;

# Decode AIFF/AIFF-C data
# data: pointer to AIFF bytes, len: total byte length
# Returns: decode_result pointer, or negative error
fn aiff_decode(data, len) {
    if (len < 12) { return err(ERR_INVALID_HEADER); }
    if (_aiff_h == 0) { _aiff_h = alloc(56); }
    var h = _aiff_h;
    var r = _aiff_header(data, len, h);
    if (is_err(r) == 1) { return r; }
    if (r == 0) { return err(ERR_INVALID_HEADER); }

    var channels = load64(h);
    var sample_rate = load64(h + 16);
    var ssnd_start = load64(h + 40);
    var ssnd_len = load64(h + 48);
    var avail = len - ssnd_start;
    if (ssnd_len > avail) { ssnd_len = avail; }

    var pl = _aiff_layout(h);
    var samples = _pcm_conv(pl, data + ssnd_start, ssnd_len / _pl_bytes(pl));
    # SEC-025: same as wav_decode — the converters can return a packed error,
    # and vec_len() on it would segfault.
    if (is_err(samples) == 1) { return samples; }
    var sc = vec_len(samples);
    var tf = sc / channels;
    var dur = f64_div(f64_from(tf), f64_from(sample_rate));

    return decode_result_new(
      fmtinfo_new(FMT_AIFF, sample_rate, channels, load64(h + 8), dur, tf),
      samples
      );
}

# Encode f64 samples to big-endian PCM bytes
fn f64_to_i16_be(samples, out) {
    var len = vec_len(samples);
    var sd = load64(samples);
    for (var i = 0; i < len; i = i + 1) {
        var val = _pcm_quant(load64(sd + i * 8), F64_32768, 0 - 32768, 32767);
        write_u16_be(out, i * 2, val & 0xFFFF);
    }
    return len * 2;
}

fn f64_to_i24_be(samples, out) {
    var len = vec_len(samples);
    var sd = load64(samples);
    for (var i = 0; i < len; i = i + 1) {
        var val = _pcm_quant(load64(sd + i * 8), F64_8388608, 0 - 8388608, 8388607);
        var off = i * 3;
        store8(out+off, (val >> 16) & 0xFF);
        store8(out+off+1, (val >> 8) & 0xFF);
        store8(out+off+2, val & 0xFF);
    }
    return len * 3;
}

fn f64_to_i32_be(samples, out) {
    var len = vec_len(samples);
    var sd = load64(samples);
    for (var i = 0; i < len; i = i + 1) {
        var val = _pcm_quant(load64(sd + i * 8), F64_2147483648, 0 - 2147483648, 2147483647);
        write_u32_be(out, i * 4, val);
    }
    return len * 4;
}

fn f64_to_i8_signed(samples, out) {
    var len = vec_len(samples);
    var sd = load64(samples);
    for (var i = 0; i < len; i = i + 1) {
        var val = _pcm_quant(load64(sd + i * 8), F64_128, 0 - 128, 127);
        store8(out + i, val & 0xFF);
    }
    return len;
}

# Encode interleaved f64 samples as AIFF byte stream (big-endian PCM)
# samples: vec, sample_rate: Hz, channels: count, bits: 8/16/24/32
# out: buffer to write AIFF data into
# Returns: total bytes written, or negative error
fn aiff_encode(samples, sample_rate, channels, bits, out) {
    if (channels == 0)    { return err(ERR_INVALID_CHANNELS); }
    if (sample_rate == 0) { return err(ERR_INVALID_RATE); }
    if (bits != 8) { if (bits != 16) { if (bits != 24) { if (bits != 32) {
                    return err(ERR_ENCODE);
                }}}}

    var num_frames = vec_len(samples) / channels;

    # Encode raw PCM to temp area after header space
    # Header: FORM(12) + COMM(8+18) + SSND(8+8) = 54 bytes
    var header_size = 54;
    var raw_data = out + header_size;
    var raw_size = 0;

    if (bits == 8)  { raw_size = f64_to_i8_signed(samples, raw_data); }
    if (bits == 16) { raw_size = f64_to_i16_be(samples, raw_data); }
    if (bits == 24) { raw_size = f64_to_i24_be(samples, raw_data); }
    if (bits == 32) { raw_size = f64_to_i32_be(samples, raw_data); }

    var ssnd_data_size = 8 + raw_size;
    var comm_size = 18;
    var form_payload = 4 + 8 + comm_size + 8 + ssnd_data_size;

    # FORM header
    store8(out, 0x46); store8(out+1, 0x4F); store8(out+2, 0x52); store8(out+3, 0x4D);
    write_u32_be(out, 4, form_payload);
    store8(out+8, 0x41); store8(out+9, 0x49); store8(out+10, 0x46); store8(out+11, 0x46);

    # COMM chunk
    store8(out+12, 0x43); store8(out+13, 0x4F); store8(out+14, 0x4D); store8(out+15, 0x4D);
    write_u32_be(out, 16, comm_size);
    write_u16_be(out, 20, channels);
    write_u32_be(out, 22, num_frames);
    write_u16_be(out, 26, bits);
    # 10-byte extended float sample rate at offset 28
    f64_to_extended(sample_rate, out + 28);

    # SSND chunk
    store8(out+38, 0x53); store8(out+39, 0x53); store8(out+40, 0x4E); store8(out+41, 0x44);
    write_u32_be(out, 42, ssnd_data_size);
    write_u32_be(out, 46, 0);  # offset
    write_u32_be(out, 50, 0);  # blockSize

    return header_size + raw_size;
}

# ================================================================
# ALAC module — Apple Lossless Audio Codec decoder
# ================================================================

# ALAC constants
var ALAC_MAX_COEFS = 32;
var ALAC_MAX_FRAME = 16384;

# ALAC element tags
enum AlacTag { ID_SCE = 0; ID_CPE = 1; ID_LFE = 3; ID_END = 7; }

# ALACSpecificConfig — parsed from 24 bytes
# Layout (80 bytes):
#   +0:  frame_length (i64)
#   +8:  bit_depth (i64)
#   +16: pb (i64)
#   +24: mb (i64)
#   +32: kb (i64)
#   +40: num_channels (i64)
#   +48: max_run (i64)
#   +56: max_frame_bytes (i64)
#   +64: avg_bit_rate (i64)
#   +72: sample_rate (i64)
fn alac_config_new() {
    return alloc(80);
}
fn alac_config_set(cfg, idx, val) { store64(cfg + idx * 8, val); return 0; }
fn alac_config_get(cfg, idx) { return load64(cfg + idx * 8); }

fn alac_parse_config(data, len) {
    if (len < 24) { return err(ERR_INVALID_HEADER); }

    var frame_length = read_u32_be(data, 0);
    var version = load8(data + 4);
    if (version != 0) { return err(ERR_INVALID_HEADER); }

    var bit_depth = load8(data + 5);
    if (bit_depth != 16) { if (bit_depth != 20) { if (bit_depth != 24) { if (bit_depth != 32) {
                    return err(ERR_INVALID_HEADER);
                }}}}

    var pb = load8(data + 6);
    var mb = load8(data + 7);
    var kb = load8(data + 8);
    var num_ch = load8(data + 9);
    if (num_ch == 0) { return err(ERR_INVALID_CHANNELS); }
    if (num_ch > 8)  { return err(ERR_INVALID_CHANNELS); }

    var max_run = read_u16_be(data, 10);
    var max_frame_bytes = read_u32_be(data, 12);
    var avg_bit_rate = read_u32_be(data, 16);
    var sample_rate = read_u32_be(data, 20);
    if (sample_rate == 0) { return err(ERR_INVALID_RATE); }

    var cfg = alac_config_new();
    alac_config_set(cfg, 0, frame_length);
    alac_config_set(cfg, 1, bit_depth);
    alac_config_set(cfg, 2, pb);
    alac_config_set(cfg, 3, mb);
    alac_config_set(cfg, 4, kb);
    alac_config_set(cfg, 5, num_ch);
    alac_config_set(cfg, 6, max_run);
    alac_config_set(cfg, 7, max_frame_bytes);
    alac_config_set(cfg, 8, avg_bit_rate);
    alac_config_set(cfg, 9, sample_rate);
    return cfg;
}

# MSB-first bit reader for ALAC
# Layout (24 bytes): +0: data_ptr, +8: byte_pos, +16: bit_pos
fn bitreader_new(data, len) {
    var br = alloc(32);
    store64(br, data);
    store64(br + 8, 0);
    store64(br + 16, 0);
    store64(br + 24, len);
    return br;
}

fn bitreader_read(br, bits) {
    if (bits == 0) { return 0; }
    # SEC-016: reject negative or oversized bit requests
    if (bits < 0) { return err(ERR_DECODE); }
    if (bits > 64) { return err(ERR_DECODE); }
    var data = load64(br);
    var bpos = load64(br + 8);
    var bbit = load64(br + 16);
    var dlen = load64(br + 24);
    var result = 0;
    var remaining = bits;

    while (remaining > 0) {
        if (bpos >= dlen) { return err(ERR_END_OF_STREAM); }
        var avail = 8 - bbit;
        var take = remaining;
        if (take > avail) { take = avail; }
        var shift = avail - take;
        # take is at most 8 (capped by avail), so 1 << take is safe
        var mask = ((1 << take) - 1) << shift;
        var val = (load8(data + bpos) & mask) >> shift;
        result = (result << take) | val;
        remaining = remaining - take;
        bbit = bbit + take;
        if (bbit >= 8) { bbit = 0; bpos = bpos + 1; }
    }

    store64(br + 8, bpos);
    store64(br + 16, bbit);
    return result;
}

fn bitreader_read_bit(br) {
    return bitreader_read(br, 1);
}

# floor(log2(x)), and 0 for x <= 1: the format relies on log2(0) being 0.
fn _alac_log2(x) {
    var r = 0;
    while (x > 1) { x = x >> 1; r = r + 1; }
    return r;
}

# Wrap to a signed `bits`-wide value. ALAC's arithmetic is 32-bit and wraps.
fn _alac_wrap(v, bits) {
    var u = v & ((1 << bits) - 1);
    if (u >= (1 << (bits - 1))) { return u - (1 << bits); }
    return u;
}

# Sign of a value: -1, 0 or 1.
fn _alac_sign(v) {
    if (v > 0) { return 1; }
    if (v < 0) { return 0 - 1; }
    return 0;
}

# Read one adaptive Golomb-Rice value. Leading ones give the prefix; nine of them
# mean the value follows raw in `bps` bits. The prefix counts in units of 2^k - 1,
# and the k-bit suffix is one bit shorter when its top k-1 bits are all zero.
fn alac_rice_scalar(br, k, bps) {
    var x = 0;
    var more = 1;
    while (more == 1) {
        var b = bitreader_read_bit(br);
        if (is_err(b) == 1) { return b; }
        if (b == 0) {
            more = 0;
        } else {
            x = x + 1;
            if (x == 9) { more = 0; }
        }
    }
    if (x == 9) { return bitreader_read(br, bps); }
    if (k <= 1) { return x; }

    var hi = bitreader_read(br, k - 1);
    if (is_err(hi) == 1) { return hi; }
    var val = (x << k) - x;
    if (hi == 0) { return val; }
    var lo = bitreader_read_bit(br);
    if (is_err(lo) == 1) { return lo; }
    return val + ((hi << 1) | lo) - 1;
}

# Decode a block of Rice-coded residuals. The parameter k follows a running
# history of the signal's magnitude, and when the history falls low enough the
# stream carries a run of zeros instead. `mult` is the channel's history rate.
fn alac_rice_decode_block(br, output, num_samples, bps, mult, mb, kb) {
    var history = mb;
    var sign_mod = 0;
    var i = 0;

    while (i < num_samples) {
        var k = _alac_log2((history >> 9) + 3);
        if (k > kb) { k = kb; }
        var x = alac_rice_scalar(br, k, bps);
        if (is_err(x) == 1) { return x; }
        x = x + sign_mod;
        sign_mod = 0;

        # Unsigned to signed: 0,1,2,3,4 -> 0,-1,1,-2,2
        store64(output + i * 8, (x >> 1) ^ (0 - (x & 1)));

        if (x > 0xFFFF) {
            history = 0xFFFF;
        } else {
            history = history + x * mult - ((history * mult) >> 9);
        }

        if (history < 128) {
            if (i + 1 < num_samples) {
                k = 7 - _alac_log2(history) + ((history + 16) >> 6);
                if (k > kb) { k = kb; }
                var run = alac_rice_scalar(br, k, 16);
                if (is_err(run) == 1) { return run; }
                if (run > 0) {
                    if (run >= num_samples - i) { run = num_samples - i - 1; }
                    var z = 1;
                    while (z <= run) {
                        store64(output + (i + z) * 8, 0);
                        z = z + 1;
                    }
                    i = i + run;
                }
                if (run <= 0xFFFF) { sign_mod = 1; }
                history = 0;
            }
        }
        i = i + 1;
    }
    return 0;
}

# Inverse adaptive LPC. Each sample is predicted from the previous `order` samples
# relative to an older base sample, oldest sample first, and the coefficients are
# nudged after every sample by the sign of the error, so `coefs` is updated in
# place. Order 31 is the special first-order case, which can run with
# err_buf == out.
fn _alac_lpc(err_buf, out, n, bps, coefs, order, quant) {
    if (n <= 0) { return 0; }
    store64(out, load64(err_buf));
    if (n == 1) { return 0; }

    var i = 1;
    if (order == 0) {
        while (i < n) {
            store64(out + i * 8, load64(err_buf + i * 8));
            i = i + 1;
        }
        return 0;
    }
    if (order == 31) {
        while (i < n) {
            store64(out + i * 8, _alac_wrap(load64(out + (i - 1) * 8) + load64(err_buf + i * 8), bps));
            i = i + 1;
        }
        return 0;
    }

    # Warm-up: the first `order` samples are first-order.
    while (i <= order && i < n) {
        store64(out + i * 8, _alac_wrap(load64(out + (i - 1) * 8) + load64(err_buf + i * 8), bps));
        i = i + 1;
    }

    var half = 1 << (quant - 1);
    while (i < n) {
        var d = load64(out + (i - order - 1) * 8);
        var val = 0;
        var j = 0;
        while (j < order) {
            val = val + (load64(out + (i - order + j) * 8) - d) * load64(coefs + j * 8);
            j = j + 1;
        }
        val = sar(_alac_wrap(val, 32) + half, quant);
        var error_val = load64(err_buf + i * 8);
        store64(out + i * 8, _alac_wrap(val + d + error_val, bps));

        var error_sign = _alac_sign(error_val);
        if (error_sign != 0) {
            j = 0;
            while (j < order && _alac_wrap(error_val * error_sign, 32) > 0) {
                var v = d - load64(out + (i - order + j) * 8);
                var sn = _alac_sign(v) * error_sign;
                store64(coefs + j * 8, _alac_wrap(load64(coefs + j * 8) - sn, 16));
                error_val = error_val - sar(v * sn, quant) * (j + 1);
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

# Stereo de-matrixing (unmix)
fn alac_unmix_stereo(u_buf, v_buf, out_l, out_r, num_samples, mix_bits, mix_res) {
    for (var i = 0; i < num_samples; i = i + 1) {
        var u = load64(u_buf + i * 8);
        var v = load64(v_buf + i * 8);
        if (mix_res != 0) {
            var left = u + v - sar(mix_res * v, mix_bits);
            var right = left - v;
            store64(out_l + i * 8, left);
            store64(out_r + i * 8, right);
        } else {
            store64(out_l + i * 8, u);
            store64(out_r + i * 8, v);
        }
    }
    return 0;
}

# Scratch for one decode. The allocator never frees, so these are made once and
# reused: a fresh set per frame would cost about 200 KB a frame, or 380 MB for a
# three-minute stereo track.
#   +0:  residuals, per channel of an element (2 ptrs)
#   +16: samples, per channel of an element (2 ptrs)
#   +32: shifted-out low bits, per channel of an element (2 ptrs)
#   +48: LPC coefficients, per channel of an element (2 ptrs)
#   +64: one frame of samples across all channels, interleaved (ptr)
#   +72: 1 / 2^(bit_depth - 1)
fn _alac_state_new(cfg) {
    var n = alac_config_get(cfg, 0);
    if (n <= 0) { return err(ERR_DECODE); }
    if (n > ALAC_MAX_FRAME) { return err(ERR_DECODE); }
    var st = alloc(80);
    if (st == 0) { return err(ERR_DECODE); }
    var i = 0;
    while (i < 6) {
        var buf = alloc(n * 8);
        if (buf == 0) { return err(ERR_DECODE); }
        store64(st + i * 8, buf);
        i = i + 1;
    }
    var c0 = alloc(ALAC_MAX_COEFS * 8);
    var c1 = alloc(ALAC_MAX_COEFS * 8);
    var fb = alloc(n * alac_config_get(cfg, 5) * 8);
    if (c0 == 0 || c1 == 0 || fb == 0) { return err(ERR_DECODE); }
    store64(st + 48, c0);
    store64(st + 56, c1);
    store64(st + 64, fb);
    store64(st + 72, f64_div(F64_ONE, f64_from(1 << (alac_config_get(cfg, 1) - 1))));
    return st;
}

# Decode a single element (mono or stereo) into the state's sample buffers.
# Returns its sample count.
fn alac_decode_element(br, cfg, st, channels, max_bits) {
    var unused = bitreader_read(br, 12);
    if (is_err(unused) == 1) { return unused; }
    var partial = bitreader_read_bit(br);
    var bytes_shifted = bitreader_read(br, 2);
    var escape_flag = bitreader_read_bit(br);
    if (is_err(escape_flag) == 1) { return escape_flag; }

    # Low bytes are stored raw, so what remains is narrower. A stereo pair needs
    # one bit more, because its mid channel holds a sum.
    var shifted_bits = bytes_shifted * 8;
    var bps = max_bits - shifted_bits + channels - 1;
    if (bps < 1) { return err(ERR_DECODE); }
    if (bps > 32) { return err(ERR_DECODE); }

    var frame_length = alac_config_get(cfg, 0);
    var num_samples = frame_length;
    if (partial == 1) {
        var hi = bitreader_read(br, 16);
        var lo = bitreader_read(br, 16);
        if (is_err(lo) == 1) { return lo; }
        num_samples = (hi << 16) | lo;
    }
    if (num_samples == 0) { return 0; }
    if (num_samples > frame_length) { return err(ERR_DECODE); }

    if (escape_flag == 1) {
        # Uncompressed: raw samples, interleaved within the element.
        for (var i = 0; i < num_samples; i = i + 1) {
            for (var ch = 0; ch < channels; ch = ch + 1) {
                var raw = bitreader_read(br, max_bits);
                if (is_err(raw) == 1) { return raw; }
                store64(load64(st + 16 + ch * 8) + i * 8, sign_extend(raw, max_bits));
            }
        }
        return num_samples;
    }

    var kb = alac_config_get(cfg, 4);
    if (kb == 0) { return err(ERR_DECODE); }
    var mix_bits = bitreader_read(br, 8);
    var mix_res = bitreader_read(br, 8);
    if (is_err(mix_res) == 1) { return mix_res; }
    mix_res = sign_extend(mix_res, 8);
    if (channels == 2 && mix_res != 0 && mix_bits > 31) { return err(ERR_DECODE); }

    # Predictor header per channel. The coefficients are stored last to first.
    var mode0 = 0; var mode1 = 0;
    var quant0 = 0; var quant1 = 0;
    var pbf0 = 0; var pbf1 = 0;
    var order0 = 0; var order1 = 0;
    for (var ch = 0; ch < channels; ch = ch + 1) {
        var mode = bitreader_read(br, 4);
        var quant = bitreader_read(br, 4);
        var pbf = bitreader_read(br, 3);
        var order = bitreader_read(br, 5);
        if (is_err(order) == 1) { return order; }
        if (order >= frame_length) { return err(ERR_DECODE); }
        if (quant == 0) { return err(ERR_DECODE); }
        var coefs = load64(st + 48 + ch * 8);
        var c = order - 1;
        while (c >= 0) {
            var rc = bitreader_read(br, 16);
            if (is_err(rc) == 1) { return rc; }
            store64(coefs + c * 8, sign_extend(rc, 16));
            c = c - 1;
        }
        if (ch == 0) { mode0 = mode; quant0 = quant; pbf0 = pbf; order0 = order; }
        else         { mode1 = mode; quant1 = quant; pbf1 = pbf; order1 = order; }
    }

    # The shifted-out low bits sit raw between the headers and the residuals.
    if (shifted_bits > 0) {
        for (var i = 0; i < num_samples; i = i + 1) {
            for (var ch = 0; ch < channels; ch = ch + 1) {
                var low = bitreader_read(br, shifted_bits);
                if (is_err(low) == 1) { return low; }
                store64(load64(st + 32 + ch * 8) + i * 8, low);
            }
        }
    }

    var pb = alac_config_get(cfg, 2);
    var mb = alac_config_get(cfg, 3);
    for (var ch = 0; ch < channels; ch = ch + 1) {
        var mode = mode0; var quant = quant0; var pbf = pbf0; var order = order0;
        if (ch == 1) { mode = mode1; quant = quant1; pbf = pbf1; order = order1; }
        var res = load64(st + ch * 8);
        var out = load64(st + 16 + ch * 8);
        var coefs = load64(st + 48 + ch * 8);
        var rc = alac_rice_decode_block(br, res, num_samples, bps, (pb * pbf) / 4, mb, kb);
        if (is_err(rc) == 1) { return rc; }
        # A non-zero mode runs a first-order pass before the coded predictor.
        if (mode != 0) { _alac_lpc(res, res, num_samples, bps, coefs, 31, 0); }
        _alac_lpc(res, out, num_samples, bps, coefs, order, quant);
    }

    if (channels == 2) {
        if (mix_res != 0) {
            var u_buf = load64(st + 16);
            var v_buf = load64(st + 24);
            alac_unmix_stereo(u_buf, v_buf, u_buf, v_buf, num_samples, mix_bits, mix_res);
        }
    }

    # The low bits rejoin after the stereo step.
    if (shifted_bits > 0) {
        for (var ch = 0; ch < channels; ch = ch + 1) {
            var out = load64(st + 16 + ch * 8);
            var ext = load64(st + 32 + ch * 8);
            for (var i = 0; i < num_samples; i = i + 1) {
                store64(out + i * 8, (load64(out + i * 8) << shifted_bits) | load64(ext + i * 8));
            }
        }
    }
    return num_samples;
}

# Where the i-th channel of the stream goes in the output. ALAC stores surround
# with centre first; output follows the usual L R C order. Each nibble is a slot.
fn _alac_channel_slot(num_ch, i) {
    var t = 0x76543210;
    if (num_ch == 3) { t = 0x102; }
    if (num_ch == 4) { t = 0x3102; }
    if (num_ch == 5) { t = 0x43102; }
    if (num_ch == 6) { t = 0x354102; }
    if (num_ch == 7) { t = 0x3654102; }
    if (num_ch == 8) { t = 0x35410762; }
    return (t >> (i * 4)) & 15;
}

# Decode one frame's elements, up to ID_END, and append its samples to `out`
# interleaved. Returns the frame's sample count per channel.
fn _alac_decode_frame(br, cfg, st, out) {
    var num_ch = alac_config_get(cfg, 5);
    var max_bits = alac_config_get(cfg, 1);
    var fb = load64(st + 64);
    var scale = load64(st + 72);
    var slot = 0;
    var nframes = 0 - 1;
    var done = 0;

    while (done == 0) {
        var tag = bitreader_read(br, 3);
        if (is_err(tag) == 1) { done = 1; }
        else {
            if (tag == ID_END) { done = 1; }
            else {
                var channels = 1;
                if (tag == ID_CPE) { channels = 2; }
                if (tag != ID_SCE && tag != ID_CPE && tag != ID_LFE) { return err(ERR_DECODE); }
                var inst = bitreader_read(br, 4);
                if (is_err(inst) == 1) { return inst; }
                if (slot + channels > num_ch) { return err(ERR_DECODE); }
                var n = alac_decode_element(br, cfg, st, channels, max_bits);
                if (is_err(n) == 1) { return n; }
                if (nframes < 0) { nframes = n; }
                if (n != nframes) { return err(ERR_DECODE); }
                for (var c = 0; c < channels; c = c + 1) {
                    var dest = _alac_channel_slot(num_ch, slot + c);
                    var src = load64(st + 16 + c * 8);
                    for (var i = 0; i < n; i = i + 1) {
                        store64(fb + (i * num_ch + dest) * 8, load64(src + i * 8));
                    }
                }
                slot = slot + channels;
            }
        }
    }

    if (nframes <= 0) { return 0; }
    if (slot != num_ch) { return err(ERR_DECODE); }

    # SEC-029: bound cumulative decoded samples. An element mints a full frame
    # from a few bytes, and alloc() never reclaims. Same one-shot ceiling (_shravan_max_samples) as
    # FLAC (SEC-023) and AAC (SEC-027).
    var total = nframes * num_ch;
    if (vec_len(out) + total > _shravan_max_samples) { return err(ERR_TOO_LARGE); }
    for (var i = 0; i < total; i = i + 1) {
        vec_push(out, f64_mul(f64_from(load64(fb + i * 8)), scale));
    }
    return nframes;
}

fn _alac_result(cfg, out) {
    var num_ch = alac_config_get(cfg, 5);
    var bit_depth = alac_config_get(cfg, 1);
    var sample_rate = alac_config_get(cfg, 9);
    var total_frames = vec_len(out) / num_ch;
    var dur = f64_div(f64_from(total_frames), f64_from(sample_rate));
    return decode_result_new(
      fmtinfo_new(FMT_ALAC, sample_rate, num_ch, bit_depth, dur, total_frames),
      out
      );
}

# Decode a 24-byte ALACSpecificConfig followed by one frame.
fn alac_decode(data, len) {
    if (len < 24) { return err(ERR_INVALID_HEADER); }
    var cfg = alac_parse_config(data, 24);
    if (is_err(cfg) == 1) { return cfg; }
    var st = _alac_state_new(cfg);
    if (is_err(st) == 1) { return st; }
    var out = vec_new();
    var rc = _alac_decode_frame(bitreader_new(data + 24, len - 24), cfg, st, out);
    if (is_err(rc) == 1) { return rc; }
    return _alac_result(cfg, out);
}

# Decode `count` frames, each at its own offset and size within data. This is how
# a container holds ALAC: every frame is a separate, byte-aligned sample. `cookie`
# is the 24-byte ALACSpecificConfig.
fn alac_decode_frames(cookie, data, len, offsets, sizes, count) {
    var cfg = alac_parse_config(cookie, 24);
    if (is_err(cfg) == 1) { return cfg; }
    var st = _alac_state_new(cfg);
    if (is_err(st) == 1) { return st; }
    # Sized once: every frame holds at most frame_length samples per channel.
    var out = _vec_new_cap(count * alac_config_get(cfg, 0) * alac_config_get(cfg, 5));
    if (is_err(out) == 1) { return out; }
    var br = bitreader_new(data, 0);
    var i = 0;
    while (i < count) {
        var off = load64(offsets + i * 8);
        var sz = load64(sizes + i * 8);
        # Untrusted offset and size: off > len, then sz > len - off, to avoid
        # overflowing off + sz.
        if (off < 0 || sz < 0) { return err(ERR_DECODE); }
        if (off > len) { return err(ERR_DECODE); }
        if (sz > len - off) { return err(ERR_DECODE); }
        store64(br, data + off);
        store64(br + 8, 0);
        store64(br + 16, 0);
        store64(br + 24, sz);
        var rc = _alac_decode_frame(br, cfg, st, out);
        if (is_err(rc) == 1) { return rc; }
        i = i + 1;
    }
    return _alac_result(cfg, out);
}


# ================================================================
# Codec module — auto-detect and dispatch
# ================================================================

# Auto-detect format and decode.
# data: pointer to audio bytes, len: total length
# Returns: decode_result pointer, or negative error
fn codec_open(data, len) {
    var fmt = shravan_detect_format(data, len);
    if (is_err(fmt) == 1) { return fmt; }

    if (fmt == FMT_WAV)  { return wav_decode(data, len); }
    if (fmt == FMT_AIFF) { return aiff_decode(data, len); }
    if (fmt == FMT_FLAC) { return flac_decode(data, len); }
    if (fmt == FMT_OGG)  { return ogg_decode(data, len); }
    if (fmt == FMT_MP3)  { return mp3_decode(data, len); }
    if (fmt == FMT_AAC)  { return aac_decode(data, len); }
    if (fmt == FMT_ALAC) { return alac_decode(data, len); }
    if (fmt == FMT_OPUS) { return ogg_decode(data, len); }
    if (fmt == FMT_MP4)  { return mp4_decode(data, len); }

    return err(ERR_UNSUPPORTED_FMT);
}

# ================================================================
# Convenience helpers: decode_file / decode_reader
# ================================================================

# Decode an audio file from a filesystem path.
# path: null-terminated C string path
# Returns: decode_result pointer, or negative error
fn decode_file(path) {
    var fd = file_open(path, 0, 0);  # O_RDONLY = 0, mode unused (6.x file_open(path, flags, mode))
    if (fd < 0) { return err(ERR_DECODE); }

    # Read entire file into buffer
    var buf_cap = 1048576;  # 1MB initial
    var buf = alloc(buf_cap);
    var total = 0;

    var reading = 1;
    while (reading == 1) {
        var avail = buf_cap - total;
        if (avail <= 0) {
            # Grow buffer (double, cap at 256MB)
            if (buf_cap >= 268435456) {
                file_close(fd);
                return err(ERR_DECODE);
            }
            var new_cap = buf_cap * 2;
            var new_buf = alloc(new_cap);
            memcpy(new_buf, buf, total);
            buf = new_buf;
            buf_cap = new_cap;
            avail = buf_cap - total;
        }
        var n = file_read(fd, buf + total, avail);
        if (n <= 0) { reading = 0; }
        else { total = total + n; }
    }

    file_close(fd);

    if (total == 0) { return err(ERR_DECODE); }

    return codec_open(buf, total);
}

# Streaming decode: feed chunks of data, receive events (see stream.cyr).
# Returns a stream decoder; wav/flac/aiff is detected from the first 12 bytes,
# however they are split across feeds. Any other format gets one ERROR event.
# chunk_frames: frames per SAMPLES event for WAV/AIFF (0 = 4096); FLAC emits one
# SAMPLES event per FLAC frame.
fn decode_reader(chunk_frames) {
    # Layout (40 bytes):
    #   +0:  state (0=detecting, 1=wav, 2=flac, 3=aiff, 4=refused)
    #   +8:  inner stream handle
    #   +16: chunk_frames
    #   +24: detection buffer (the stream's first bytes, until 12 have arrived)
    #   +32: bytes held in the detection buffer
    var dr = alloc(40);
    store64(dr, 0);
    store64(dr + 8, 0);
    store64(dr + 16, chunk_frames);
    store64(dr + 24, alloc(16));
    store64(dr + 32, 0);
    return dr;
}

fn _decode_reader_inner(state, inner, data, len) {
    if (state == 1) { return wav_stream_feed(inner, data, len); }
    if (state == 2) { return flac_stream_feed(inner, data, len); }
    if (state == 3) { return aiff_stream_feed(inner, data, len); }
    return vec_new();
}

fn decode_reader_feed(dr, data, len) {
    var state = load64(dr);
    if (state == 0) {
        var hb = load64(dr + 24);
        var hl = load64(dr + 32);
        if (len <= 0) { return vec_new(); }
        if (hl + len < 12) {
            # Not enough to detect yet: hold the bytes (until 2.9.3 they were dropped).
            memcpy(hb + hl, data, len);
            store64(dr + 32, hl + len);
            return vec_new();
        }
        var take = 12 - hl;
        memcpy(hb + hl, data, take);
        var fmt = shravan_detect_format(hb, 12);
        var chunk_frames = load64(dr + 16);
        if (chunk_frames == 0) { chunk_frames = 4096; }
        var s = 0;
        if (fmt == FMT_WAV)  { s = wav_stream_new(chunk_frames); state = 1; }
        if (fmt == FMT_FLAC) { s = flac_stream_new(); state = 2; }
        if (fmt == FMT_AIFF) { s = aiff_stream_new(chunk_frames); state = 3; }
        if (state == 0) {
            store64(dr, 4);
            var refused = vec_new();
            var e = err(ERR_UNSUPPORTED_FMT);
            if (is_err(fmt) == 1) { e = fmt; }
            vec_push(refused, stream_evt_error(e));
            return refused;
        }
        store64(dr, state);
        store64(dr + 8, s);
        # The held-back bytes first, then this call's.
        var events = vec_new();
        if (hl > 0) { events = _decode_reader_inner(state, s, hb, hl); }
        var more = _decode_reader_inner(state, s, data, len);
        var n = vec_len(more);
        for (var i = 0; i < n; i = i + 1) { vec_push(events, vec_get(more, i)); }
        return events;
    }
    return _decode_reader_inner(state, load64(dr + 8), data, len);
}

fn decode_reader_flush(dr) {
    var state = load64(dr);
    var inner = load64(dr + 8);
    if (state == 1) { return wav_stream_flush(inner); }
    if (state == 2) { return flac_stream_flush(inner); }
    if (state == 3) { return aiff_stream_flush(inner); }
    var events = vec_new();
    if (state == 0) {
        # Fewer than 12 bytes ever arrived: too short to be any of the formats.
        if (load64(dr + 32) > 0) { vec_push(events, stream_evt_error(err(ERR_INVALID_HEADER))); }
    }
    store64(dr, 4);
    vec_push(events, stream_evt_end());
    return events;
}
