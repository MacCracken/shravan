# ================================================================
# silk_tests.cyr — SILK decode golden-vector conformance tests (the large
# libopus-generated NLSF/resampler vectors). Split out of opus_rfc_tests.cyr
# so no single build overflows the code buffer. Built via src/main_silk.cyr.
# NOT part of the [lib] distlib bundle. Requires src/opus_test_helpers.cyr.
# ================================================================

fn test_silk_indices_rfc() {
    test_group("opus: SILK decode_indices bit-exact vs libopus");
    var lg = alloc(8);
    var out = alloc(40 * 8);
    # sw0
    store64(lg, 0);
    var sw0_p = alloc(29);
    store8(sw0_p + 0, 129); store8(sw0_p + 1, 23); store8(sw0_p + 2, 177); store8(sw0_p + 3, 248); store8(sw0_p + 4, 92); store8(sw0_p + 5, 123); store8(sw0_p + 6, 184); store8(sw0_p + 7, 64); store8(sw0_p + 8, 62); store8(sw0_p + 9, 2); store8(sw0_p + 10, 172); store8(sw0_p + 11, 194); store8(sw0_p + 12, 182); store8(sw0_p + 13, 50);
    store8(sw0_p + 14, 216); store8(sw0_p + 15, 140); store8(sw0_p + 16, 54); store8(sw0_p + 17, 182); store8(sw0_p + 18, 247); store8(sw0_p + 19, 108); store8(sw0_p + 20, 54); store8(sw0_p + 21, 251); store8(sw0_p + 22, 199); store8(sw0_p + 23, 173); store8(sw0_p + 24, 157); store8(sw0_p + 25, 239); store8(sw0_p + 26, 213); store8(sw0_p + 27, 3);
    store8(sw0_p + 28, 144);
    var ec_sw0 = silk_decode_indices(sw0_p, 29, 16, lg, out);
    assert_eq(load64(out + 0 * 8), 1, "sw0 sig");
    assert_eq(load64(out + 1 * 8), 0, "sw0 qoff");
    assert_eq(load64(out + 2 * 8), 20, "sw0 GI0");
    assert_eq(load64(out + 3 * 8), 17, "sw0 GI1");
    assert_eq(load64(out + 4 * 8), 6, "sw0 GI2");
    assert_eq(load64(out + 5 * 8), 5, "sw0 GI3");
    assert_eq(load64(out + 11 * 8), 4, "sw0 NInterp");
    assert_eq(load64(out + 12 * 8), 0, "sw0 lag");
    assert_eq(load64(out + 13 * 8), 0, "sw0 cont");
    assert_eq(load64(out + 14 * 8), 0, "sw0 PER");
    assert_eq(load64(out + 15 * 8), 0, "sw0 LTPsc");
    assert_eq(load64(out + 16 * 8), 2, "sw0 seed");
    assert_eq(load64(out + 17 * 8), 48, "sw0 ec_tell");
    assert_eq(load64(out + 18 * 8), 15, "sw0 NLSF0");
    assert_eq(load64(out + 19 * 8), 0 - 1, "sw0 NLSF1");
    assert_eq(load64(out + 20 * 8), 0, "sw0 NLSF2");
    assert_eq(load64(out + 21 * 8), 0, "sw0 NLSF3");
    assert_eq(load64(out + 22 * 8), 0, "sw0 NLSF4");
    assert_eq(load64(out + 23 * 8), 0, "sw0 NLSF5");
    assert_eq(load64(out + 24 * 8), 0, "sw0 NLSF6");
    assert_eq(load64(out + 25 * 8), 0, "sw0 NLSF7");
    assert_eq(load64(out + 26 * 8), 0, "sw0 NLSF8");
    assert_eq(load64(out + 27 * 8), 1, "sw0 NLSF9");
    assert_eq(load64(out + 28 * 8), 0, "sw0 NLSF10");
    assert_eq(load64(out + 29 * 8), 0, "sw0 NLSF11");
    assert_eq(load64(out + 30 * 8), 0, "sw0 NLSF12");
    assert_eq(load64(out + 31 * 8), 0, "sw0 NLSF13");
    assert_eq(load64(out + 32 * 8), 0, "sw0 NLSF14");
    assert_eq(load64(out + 33 * 8), 0, "sw0 NLSF15");
    assert_eq(load64(out + 34 * 8), 0, "sw0 NLSF16");
    assert_eq(load64(out + 35 * 8), 0, "sw0 LTPI0");
    assert_eq(load64(out + 36 * 8), 0, "sw0 LTPI1");
    assert_eq(load64(out + 37 * 8), 0, "sw0 LTPI2");
    assert_eq(load64(out + 38 * 8), 0, "sw0 LTPI3");
    # sw0 NLSF -> pNLSF_Q15 (bit-exact vs libopus silk_NLSF_decode)
    var pn = alloc(16 * 8);
    silk_nlsf_decode(out + 18 * 8, 16, pn);
    assert_eq(load64(pn + 0 * 8), 598, "sw0 pNLSF0");
    assert_eq(load64(pn + 1 * 8), 2048, "sw0 pNLSF1");
    assert_eq(load64(pn + 2 * 8), 3716, "sw0 pNLSF2");
    assert_eq(load64(pn + 3 * 8), 5151, "sw0 pNLSF3");
    assert_eq(load64(pn + 4 * 8), 7319, "sw0 pNLSF4");
    assert_eq(load64(pn + 5 * 8), 9309, "sw0 pNLSF5");
    assert_eq(load64(pn + 6 * 8), 11598, "sw0 pNLSF6");
    assert_eq(load64(pn + 7 * 8), 13676, "sw0 pNLSF7");
    assert_eq(load64(pn + 8 * 8), 16041, "sw0 pNLSF8");
    assert_eq(load64(pn + 9 * 8), 17536, "sw0 pNLSF9");
    assert_eq(load64(pn + 10 * 8), 19712, "sw0 pNLSF10");
    assert_eq(load64(pn + 11 * 8), 21888, "sw0 pNLSF11");
    assert_eq(load64(pn + 12 * 8), 24192, "sw0 pNLSF12");
    assert_eq(load64(pn + 13 * 8), 26240, "sw0 pNLSF13");
    assert_eq(load64(pn + 14 * 8), 28416, "sw0 pNLSF14");
    assert_eq(load64(pn + 15 * 8), 30336, "sw0 pNLSF15");
    # sw0 NLSF2A -> a_Q12 (bit-exact vs libopus PredCoef_Q12, first frame no interp)
    var aq = alloc(16 * 8);
    silk_nlsf2a(aq, pn, 16);
    assert_eq(load64(aq + 0 * 8), 6616, "sw0 LPC0");
    assert_eq(load64(aq + 1 * 8), 0 - 2821, "sw0 LPC1");
    assert_eq(load64(aq + 2 * 8), 638, "sw0 LPC2");
    assert_eq(load64(aq + 3 * 8), 0 - 386, "sw0 LPC3");
    assert_eq(load64(aq + 4 * 8), 0 - 140, "sw0 LPC4");
    assert_eq(load64(aq + 5 * 8), 0 - 335, "sw0 LPC5");
    assert_eq(load64(aq + 6 * 8), 813, "sw0 LPC6");
    assert_eq(load64(aq + 7 * 8), 0 - 473, "sw0 LPC7");
    assert_eq(load64(aq + 8 * 8), 85, "sw0 LPC8");
    assert_eq(load64(aq + 9 * 8), 0 - 152, "sw0 LPC9");
    assert_eq(load64(aq + 10 * 8), 449, "sw0 LPC10");
    assert_eq(load64(aq + 11 * 8), 0 - 318, "sw0 LPC11");
    assert_eq(load64(aq + 12 * 8), 86, "sw0 LPC12");
    assert_eq(load64(aq + 13 * 8), 0 - 180, "sw0 LPC13");
    assert_eq(load64(aq + 14 * 8), 490, "sw0 LPC14");
    assert_eq(load64(aq + 15 * 8), 0 - 336, "sw0 LPC15");
    # sw0 excitation (bit-exact vs libopus silk_decode_pulses)
    var sw0_ex = alloc(320 * 8);
    silk_decode_pulses(ec_sw0, sw0_ex, load64(out + 0 * 8), load64(out + 1 * 8), 320);
    var sw0_ee = alloc(320 * 8);
    var sw0_zi = 0; while (sw0_zi < 320) { store64(sw0_ee + sw0_zi * 8, 0); sw0_zi = sw0_zi + 1; }
    store64(sw0_ee + 92 * 8, 0 - 1);
    store64(sw0_ee + 93 * 8, 0 - 1);
    store64(sw0_ee + 127 * 8, 1);
    store64(sw0_ee + 130 * 8, 0 - 1);
    store64(sw0_ee + 133 * 8, 1);
    store64(sw0_ee + 135 * 8, 1);
    store64(sw0_ee + 155 * 8, 0 - 1);
    store64(sw0_ee + 171 * 8, 0 - 1);
    store64(sw0_ee + 175 * 8, 1);
    store64(sw0_ee + 178 * 8, 0 - 1);
    store64(sw0_ee + 181 * 8, 0 - 1);
    store64(sw0_ee + 190 * 8, 1);
    store64(sw0_ee + 192 * 8, 0 - 1);
    store64(sw0_ee + 194 * 8, 0 - 1);
    store64(sw0_ee + 197 * 8, 0 - 1);
    store64(sw0_ee + 203 * 8, 0 - 1);
    store64(sw0_ee + 232 * 8, 0 - 1);
    store64(sw0_ee + 236 * 8, 1);
    store64(sw0_ee + 238 * 8, 0 - 1);
    store64(sw0_ee + 240 * 8, 0 - 1);
    store64(sw0_ee + 275 * 8, 0 - 1);
    store64(sw0_ee + 277 * 8, 0 - 1);
    store64(sw0_ee + 279 * 8, 0 - 1);
    store64(sw0_ee + 281 * 8, 0 - 1);
    store64(sw0_ee + 282 * 8, 0 - 1);
    store64(sw0_ee + 284 * 8, 0 - 1);
    store64(sw0_ee + 293 * 8, 0 - 1);
    store64(sw0_ee + 296 * 8, 1);
    store64(sw0_ee + 299 * 8, 1);
    store64(sw0_ee + 302 * 8, 0 - 1);
    store64(sw0_ee + 317 * 8, 0 - 1);
    sw0_zi = 0; while (sw0_zi < 320) { assert_eq(load64(sw0_ex + sw0_zi * 8), load64(sw0_ee + sw0_zi * 8), "sw0 exc"); sw0_zi = sw0_zi + 1; }
    # sw0 decode_core (unvoiced frame 0, clean state) -> xq bit-exact vs libopus
    assert_eq(load64(out + 6 * 8), 1925120, "sw0 Gain0");
    assert_eq(load64(out + 7 * 8), 14876672, "sw0 Gain1");
    assert_eq(load64(out + 8 * 8), 20316160, "sw0 Gain2");
    assert_eq(load64(out + 9 * 8), 23855104, "sw0 Gain3");
    var sw0_st = alloc(13 * 8);
    store64(sw0_st + 0 * 8, 16); store64(sw0_st + 1 * 8, 16); store64(sw0_st + 2 * 8, 320); store64(sw0_st + 3 * 8, 80); store64(sw0_st + 4 * 8, 320); store64(sw0_st + 5 * 8, 4);
    store64(sw0_st + 6 * 8, 65536); store64(sw0_st + 7 * 8, 0); store64(sw0_st + 8 * 8, 0); store64(sw0_st + 9 * 8, 0);
    store64(sw0_st + 10 * 8, alloc(320 * 8));
    var sw0_sl = alloc(16 * 8); var sw0_zz = 0; while (sw0_zz < 16) { store64(sw0_sl + sw0_zz * 8, 0); sw0_zz = sw0_zz + 1; } store64(sw0_st + 11 * 8, sw0_sl);
    var sw0_ob = alloc(640 * 8); sw0_zz = 0; while (sw0_zz < 640) { store64(sw0_ob + sw0_zz * 8, 0); sw0_zz = sw0_zz + 1; } store64(sw0_st + 12 * 8, sw0_ob);
    var sw0_ct = alloc(10 * 8);
    store64(sw0_ct + 0 * 8, aq); store64(sw0_ct + 1 * 8, aq);
    var sw0_gb = alloc(4 * 8); sw0_zz = 0; while (sw0_zz < 4) { store64(sw0_gb + sw0_zz * 8, load64(out + (6 + sw0_zz) * 8)); sw0_zz = sw0_zz + 1; }
    var sw0_pit = alloc(4 * 8); var sw0_ltp = alloc(20 * 8); sw0_zz = 0; while (sw0_zz < 20) { store64(sw0_ltp + sw0_zz * 8, 0); sw0_zz = sw0_zz + 1; } sw0_zz = 0; while (sw0_zz < 4) { store64(sw0_pit + sw0_zz * 8, 0); sw0_zz = sw0_zz + 1; }
    store64(sw0_ct + 2 * 8, sw0_gb); store64(sw0_ct + 3 * 8, sw0_pit); store64(sw0_ct + 4 * 8, sw0_ltp); store64(sw0_ct + 5 * 8, 0);
    store64(sw0_ct + 6 * 8, load64(out + 0 * 8)); store64(sw0_ct + 7 * 8, load64(out + 1 * 8)); store64(sw0_ct + 8 * 8, load64(out + 16 * 8)); store64(sw0_ct + 9 * 8, load64(out + 11 * 8));
    var sw0_xq = alloc(320 * 8);
    silk_decode_core(sw0_st, sw0_ct, sw0_xq, sw0_ex);
    var sw0_xe = alloc(320 * 8); sw0_zz = 0; while (sw0_zz < 320) { store64(sw0_xe + sw0_zz * 8, 0); sw0_zz = sw0_zz + 1; }
    store64(sw0_xe + 0 * 8, 3);
    store64(sw0_xe + 1 * 8, 8);
    store64(sw0_xe + 2 * 8, 14);
    store64(sw0_xe + 3 * 8, 15);
    store64(sw0_xe + 4 * 8, 18);
    store64(sw0_xe + 5 * 8, 18);
    store64(sw0_xe + 6 * 8, 20);
    store64(sw0_xe + 7 * 8, 18);
    store64(sw0_xe + 8 * 8, 19);
    store64(sw0_xe + 9 * 8, 23);
    store64(sw0_xe + 10 * 8, 21);
    store64(sw0_xe + 11 * 8, 17);
    store64(sw0_xe + 12 * 8, 17);
    store64(sw0_xe + 13 * 8, 21);
    store64(sw0_xe + 14 * 8, 18);
    store64(sw0_xe + 15 * 8, 14);
    store64(sw0_xe + 16 * 8, 9);
    store64(sw0_xe + 17 * 8, 9);
    store64(sw0_xe + 18 * 8, 12);
    store64(sw0_xe + 19 * 8, 10);
    store64(sw0_xe + 20 * 8, 12);
    store64(sw0_xe + 21 * 8, 17);
    store64(sw0_xe + 22 * 8, 16);
    store64(sw0_xe + 23 * 8, 12);
    store64(sw0_xe + 24 * 8, 8);
    store64(sw0_xe + 25 * 8, 9);
    store64(sw0_xe + 26 * 8, 5);
    store64(sw0_xe + 27 * 8, 4);
    store64(sw0_xe + 28 * 8, 8);
    store64(sw0_xe + 29 * 8, 13);
    store64(sw0_xe + 30 * 8, 18);
    store64(sw0_xe + 31 * 8, 18);
    store64(sw0_xe + 32 * 8, 15);
    store64(sw0_xe + 33 * 8, 11);
