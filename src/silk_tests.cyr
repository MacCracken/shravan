# silk_isort_i16: the NLSF-stabilize insertion-sort fallback. Real bitstreams rarely
# reach it (only when the 20-loop iterative stabilizer fails to converge), so exercise
# it directly on assorted permutations to guarantee it sorts ascending.
fn test_silk_isort_rfc() {
    test_group("opus: SILK insertion-sort fallback (silk_isort_i16)");
    # helper: fill buf from a source array of n values, sort, assert ascending + permutation.
    var buf = alloc(6 * 8);
    # case [1,3,2] -> [1,2,3]
    store64(buf + 0, 1); store64(buf + 8, 3); store64(buf + 16, 2);
    silk_isort_i16(buf, 3);
    assert_eq(load64(buf + 0), 1, "isort a0");
    assert_eq(load64(buf + 8), 2, "isort a1");
    assert_eq(load64(buf + 16), 3, "isort a2");
    # case [3,1,2] -> [1,2,3]
    store64(buf + 0, 3); store64(buf + 8, 1); store64(buf + 16, 2);
    silk_isort_i16(buf, 3);
    assert_eq(load64(buf + 0), 1, "isort b0");
    assert_eq(load64(buf + 8), 2, "isort b1");
    assert_eq(load64(buf + 16), 3, "isort b2");
    # case [5,4,3,2,1,0] (reverse) -> [0,1,2,3,4,5]
    var r = 0; while (r < 6) { store64(buf + r * 8, 5 - r); r = r + 1; }
    silk_isort_i16(buf, 6);
    r = 0; while (r < 6) { assert_eq(load64(buf + r * 8), r, "isort rev"); r = r + 1; }
    # case with negatives + dupes [2,-3,2,-3,0,1] -> [-3,-3,0,1,2,2]
    store64(buf + 0, 2); store64(buf + 8, 0 - 3); store64(buf + 16, 2);
    store64(buf + 24, 0 - 3); store64(buf + 32, 0); store64(buf + 40, 1);
    silk_isort_i16(buf, 6);
    assert_eq(load64(buf + 0), 0 - 3, "isort n0");
    assert_eq(load64(buf + 8), 0 - 3, "isort n1");
    assert_eq(load64(buf + 16), 0, "isort n2");
    assert_eq(load64(buf + 24), 1, "isort n3");
    assert_eq(load64(buf + 32), 2, "isort n4");
    assert_eq(load64(buf + 40), 2, "isort n5");
    # already sorted stays sorted [1,2,3] -> [1,2,3]
    store64(buf + 0, 1); store64(buf + 8, 2); store64(buf + 16, 3);
    silk_isort_i16(buf, 3);
    assert_eq(load64(buf + 0), 1, "isort s0");
    assert_eq(load64(buf + 8), 2, "isort s1");
    assert_eq(load64(buf + 16), 3, "isort s2");
    return 0;
}

