    store64(sw0_xe + 35 * 8, 7);
    store64(sw0_xe + 36 * 8, 2);
    store64(sw0_xe + 37 * 8, 0 - 4);
    store64(sw0_xe + 38 * 8, 0 - 11);
    store64(sw0_xe + 39 * 8, 0 - 13);
    store64(sw0_xe + 40 * 8, 0 - 17);
    store64(sw0_xe + 41 * 8, 0 - 21);
    store64(sw0_xe + 42 * 8, 0 - 21);
