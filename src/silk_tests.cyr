    var oLf = alloc(960 * 8); var oRf = alloc(960 * 8);
    var cf = 0; while (cf < 960) { store64(oLf + cf * 8, f64_from(load64(oL + cf * 8))); store64(oRf + cf * 8, f64_from(load64(oR + cf * 8))); cf = cf + 1; }
    var ccL = _celt_corr(oLf, gL, 960);
    var ccR = _celt_corr(oRf, gR, 960);
    syscall(1, 2, "stereoL_x10000=", 15); fmt_int_fd(2, f64_to(f64_mul(ccL, f64_from(10000)))); syscall(1, 2, " R=", 3); fmt_int_fd(2, f64_to(f64_mul(ccR, f64_from(10000)))); syscall(1, 2, "\n", 1);
    assert(f64_gt(ccL, f64_div(f64_from(999), f64_from(1000))) == 1, "stereo L correlation > 0.999");
    assert(f64_gt(ccR, f64_div(f64_from(999), f64_from(1000))) == 1, "stereo R correlation > 0.999");
    return 0;
}

